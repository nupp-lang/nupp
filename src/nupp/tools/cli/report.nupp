module nupp.tools.cli.report

--[[
Diagnostics as JSON, for the reader that is a program.

The text form lives in `nupp.compiler.diagnostics`, where the build and the
command line share it. This is the other reader: `--json` promises line, column,
and offset for every range, including the ranges inside fixes and related
locations, and a diagnostic carries only a byte offset, so each file it mentions
is read once and walked to turn offsets into positions.

See `docs/reference/diagnostics.md` for what the fields mean.
]]
const json = require("nupp.codec.json")

local fs = require("nupp.compiler.fs")
local explain = require("nupp.tools.explain")
local diagnosticMod = require("nupp.compiler.diagnostics")

local report = {}

--- A source and where each of its lines starts, so that an offset is turned
--- into a line by searching a list rather than by walking the text again for
--- every range.
local type Source = {
    text: string,
    lineStarts: {integer}
}

local function indexed(text: string): Source
    local lineStarts: {integer} = {1}
    local at = text:find("\n", 1, true)
    while at do
        lineStarts[#lineStarts + 1] = at + 1
        at = text:find("\n", at + 1, true)
    end

    return {text = text, lineStarts = lineStarts}
end

--- The line and column an offset falls on. Positions are 1-based byte counts,
--- matching what the text form prints. The line is the last one starting at or
--- before the offset, found by bisection.
local function positionAtByte(source: Source?, offset: number?): any
    if not source or not offset or offset < 1 then
        return {line = 0, column = 0, offset = offset or 0}
    end
    local starts = source.lineStarts
    local low: integer, high: integer = 1, #starts
    while low < high do
        local middle = math.floor((low + high + 1) / 2)
        if starts[middle] <= offset then
            low = middle
        else
            high = middle - 1
        end
    end

    return {line = low, column = offset - starts[low] + 1, offset = offset}
end

--- Reads and indexes each file at most once, even when many diagnostics point
--- into it.
local function sourceReader(): function(string?): Source?
    local sources: {[string]: any} = {}
    return function(path: string?): Source?
        if not path then
            return nil
        end
        if sources[path] == nil then
            local text = fs.readFile(path)
            sources[path] = text and indexed(text) or false
        end

        return sources[path] or nil
    end
end

local function rangeAt(source: Source?, offset: number?, length: number?): any
    local start = positionAtByte(source, offset or 1)
    local span = length or 0
    if source then
        return {start = start, ["end"] = positionAtByte(source, math.min(#source.text + 1, (offset or 1) + span))}
    end

    return {
        start = start,
        ["end"] = {line = start.line, column = start.column + (length or 1), offset = start.offset + (length or 1)}
    }
end

local function withArrayEmpties(value: unknown, seen: {[unknown]: any}?): unknown
    if type(value) ~= "table" then
        return value
    end
    seen = seen or {}
    if seen[value] then
        return seen[value]
    end
    local copied: {[any]: any} = {}
    seen[value] = copied
    for key, item in pairs(value as {[any]: any}) do
        copied[key] = withArrayEmpties(item, seen)
    end
    if next(copied) == nil then
        return json.asArray(copied)
    end

    return copied
end

-- A byte that cannot stand where it is in UTF-8 becomes U+FFFD. JSON text is Unicode,
-- and a diagnostic can quote whatever the source held: a report that raised on a stray
-- byte would lose every diagnostic in the run, including the one about that byte.
local REPLACEMENT = "\239\191\189"

local function validUtf8(text: string): string
    if not text:find("[\128-\255]") then
        return text
    end
    local out: {string} = {}
    local index: integer = 1
    local length = #text
    while index <= length do
        local first = text:byte(index)
        local width: integer = 0
        local low, high = 0x80, 0xBF
        if first < 0x80 then
            width = 1
        elseif first >= 0xC2 and first <= 0xDF then
            width = 2
        elseif first >= 0xE0 and first <= 0xEF then
            width = 3
            low = first == 0xE0 and 0xA0 or 0x80
            high = first == 0xED and 0x9F or 0xBF
        elseif first >= 0xF0 and first <= 0xF4 then
            width = 4
            low = first == 0xF0 and 0x90 or 0x80
            high = first == 0xF4 and 0x8F or 0xBF
        end
        local valid = width > 0 and index + width - 1 <= length
        for offset = 1, width - 1 do
            local byte = text:byte(index + offset)
            local lower, upper = 0x80, 0xBF
            if offset == 1 then
                lower, upper = low, high
            end
            if not byte or byte < lower or byte > upper then
                valid = false
                break
            end
        end
        if valid then
            out[#out + 1] = text:sub(index, index + width - 1)
            index = index + width
        else
            out[#out + 1] = REPLACEMENT
            index = index + 1
        end
    end

    return table.concat(out)
end

local function stableEncode(value: unknown, visiting: {[unknown]: boolean}?): string
    if type(value) == "string" then
        return json.encode(validUtf8(value))
    end
    if type(value) ~= "table" then
        return json.encode(value)
    end
    visiting = visiting or {}
    if visiting[value] then
        error("cannot serialize a cyclic Lua table", 0)
    end
    visiting[value] = true
    local parts: {string} = {}
    if json.isArray(value) then
        for index, item in ipairs(value as {unknown}) do
            parts[index] = stableEncode(item, visiting)
        end
        visiting[value] = nil

        return "[" .. table.concat(parts, ",") .. "]"
    end
    local keys: {string} = {}
    for key in pairs(value as {[any]: any}) do
        if type(key) ~= "string" then
            error("JSON object keys must be strings", 0)
        end
        keys[#keys + 1] = key
    end
    table.sort(keys)
    for index, key in ipairs(keys) do
        parts[index] = json.encode(validUtf8(key)) .. ":" .. stableEncode((value as {[string]: unknown})[key], visiting)
    end
    visiting[value] = nil

    return "{" .. table.concat(parts, ",") .. "}"
end

--- Encodes a value the way every `--json` command encodes one. Every empty
--- field in this reporting model is a list, so the copy marks those lists
--- explicitly without mutating the compiler data it was handed. Object keys
--- are sorted so the same report has the same bytes in separate processes.
function report.encode(value: unknown): string
    return stableEncode(withArrayEmpties(value))
end

--- Lays compact JSON out over lines, two spaces per level of nesting.
---
--- The document is walked rather than re-encoded, so the indented form is the
--- compact form with whitespace in it and the two can never describe different
--- values. Only structural punctuation outside a string is touched; the scan
--- skips over strings whole, escapes included, so a brace or comma inside one
--- is left alone.
local function indented(compact: string): string
    local out: {string} = {}
    local depth = 0
    local index = 1
    while index <= #compact do
        local at = compact:find("[%[%]{},:\"]", index)
        if not at then
            out[#out + 1] = compact:sub(index)
            break
        end
        if at > index then
            out[#out + 1] = compact:sub(index, at - 1)
        end
        local char = compact:sub(at, at)
        index = at + 1
        if char == "\"" then
            local stop = index
            while stop <= #compact do
                local inner = compact:sub(stop, stop)
                if inner == "\\" then
                    stop = stop + 2
                elseif inner == "\"" then
                    break
                else
                    stop = stop + 1
                end
            end
            out[#out + 1] = compact:sub(at, stop)
            index = stop + 1
        elseif char == "{" or char == "[" then
            -- An empty container stays on one line; there is nothing to indent inside
            -- it, and `{\n}` reads as though something went missing.
            local closing = compact:sub(index, index)
            if closing == "}" or closing == "]" then
                out[#out + 1] = char .. closing
                index = index + 1
            else
                depth = depth + 1
                out[#out + 1] = char .. "\n" .. string.rep("  ", depth)
            end
        elseif char == "}" or char == "]" then
            depth = depth - 1
            out[#out + 1] = "\n" .. string.rep("  ", depth) .. char
        elseif char == "," then
            out[#out + 1] = ",\n" .. string.rep("  ", depth)
        else
            out[#out + 1] = ": "
        end
    end

    return table.concat(out)
end

--- The same value `report.encode` produces, laid out over lines for a person
--- reading it. Commands offer this behind a flag of its own: the default stays
--- one line, because the default reader is a program.
function report.encodePretty(value: unknown): string
    return indented(report.encode(value))
end

--- Writes a line of JSON to stdout. Never colored: the reader is a program,
--- and an escape code in a JSON string is a bug in whatever printed it.
function report.write(value: unknown): nil
    io.write(report.encode(value) .. "\n")
end

--- Where a diagnostic is, or nil for one about something with no place in source: a
--- file that could not be read, a manifest that could not be used, a tool that failed.
--- Leaving the range out says that; a range at line 0 would be a position the schema
--- calls 1-based and a reader would have to know to discard.
local function diagnosticRange(source: Source?, e: any): any
    if type(e.offset) == "number" and e.offset >= 1 then
        return rangeAt(source, e.offset, e.length)
    end
    if type(e.line) == "number" and e.line >= 1 then
        local column: integer = type(e.col) == "number" and e.col >= 1 and e.col or 1
        local offset: integer = 0
        if source and source.lineStarts[e.line] then
            offset = source.lineStarts[e.line] + column - 1
        end
        local start = {line = e.line, column = column, offset = offset}
        local width: integer = type(e.length) == "number" and e.length or 0

        return {start = start, ["end"] = {line = e.line, column = column + width, offset = offset + width}}
    end

    return nil
end

--- The diagnostics as `--json` promises them: every range resolved to line,
--- column and offset, including the ranges inside fixes and related locations.
function report.diagnosticValues(diagnostics: {any}): {any}
    local read = sourceReader()
    local values: {any} = {}
    for _, e in ipairs(diagnostics) do
        local source = read(e.filename)
        local fixes: {any} = {}
        for _, fix in ipairs(e.fixes or {}) do
            local edits: {any} = {}
            for _, edit in ipairs(fix.edits or {}) do
                edits[
                    #edits + 1
                ] = {
                    file = e.filename,
                    range = {
                        start = positionAtByte(source, edit.offset),
                        ["end"] = positionAtByte(source, edit.offset + edit.length)
                    },
                    newText = edit.newText,
                }
            end
            fixes[#fixes + 1] = {title = fix.title, edits = edits}
        end
        local related: {any} = {}
        for _, item in ipairs(e.related or {}) do
            local relatedFile = item.filename or e.filename
            related[
                #related + 1
            ] = {
                file = relatedFile,
                message = item.message or item.msg or "related location",
                range = rangeAt(read(relatedFile), item.offset, item.length)
            }
        end
        values[#values + 1] = {
            file = e.filename,
            severity = diagnosticMod.severityOf(e),
            code = e.code,
            status = e.status,
            hotness = e.hotness,
            hotnessSamples = e.hotnessSamples,
            hotnessRange = e.hotnessRange,
            lint = e.lint,
            -- Derived from the code rather than carried on every diagnostic: one code
            -- always means one section, so storing it at each of the hundreds of places
            -- a diagnostic is raised would only be a way for them to disagree.
            docs = explain.anchor(e.code),
            message = e.msg,
            range = diagnosticRange(source, e),
            fixes = fixes,
            help = e.help,
            notes = e.notes or {},
            related = related,
        }
    end

    return values
end

--- A diagnostic about a file rather than a place in it: a path that could not be read
--- or written has no position, so it carries none, and the code is the one every
--- command reports for a file the run never got inside.
function report.fileDiagnostic(path: string, msg: string?, help: string): {[string]: any}
    return {filename = path, code = report.UNREADABLE, msg = msg or "cannot access " .. path, help = help,}
end

--- The codes for a failure outside source, which is everything a run can refuse before
--- it has a file and a position to point at. Each has its own `nupp explain` entry.
report.UNREADABLE = "NUPP0001"

report.MANIFEST = "NUPP0002"
report.UNKNOWN_NAME = "NUPP0003"
report.TOOL_FAILED = "NUPP0004"

--- A diagnostic about the run rather than a place in source, carrying one of the codes
--- above and, where there is one, the file it concerns. A message that arrives already
--- spelled for the terminal loses its `nupp:`: in a document the code says who is
--- speaking.
function report.runDiagnostic(code: string, msg: string, help: string?, file: string?): {[string]: any}
    local text = tostring(msg):gsub("^nupp: ", "")
    return {filename = file, code = code, msg = text, help = help}
end

--- Says that a file could not be read or written, the way every command says it: as a
--- diagnostic appended to `collected` when the run is gathering them for `--json`, and
--- as one line on stderr when it is not. Returns the diagnostic either way.
function report.fileFailure(path: string, err: string?, help: string, collected: {any}?): {[string]: any}
    local diagnostic = report.fileDiagnostic(path, err, help)
    if collected then
        collected[#collected + 1] = diagnostic
    else
        io.stderr:write("nupp: " .. diagnostic.msg .. "\n")
    end

    return diagnostic
end

-- The schema of what the writers above produce, kept beside them for the same reason
-- help is kept beside the option grammar: two descriptions of one thing, in two places,
-- is how they come to disagree. `--schema` prints this, and a test parses real output
-- back against it.
local POSITION = {
    type = "object",
    description = "A 1-based byte position.",
    properties = {line = {type = "integer"}, column = {type = "integer"}, offset = {type = "integer"},},
    required = {"line", "column", "offset"},
}

local RANGE = {type = "object", properties = {start = POSITION, ["end"] = POSITION}, required = {"start", "end"},}

--- A 1-based byte position, and a span of them. Shared so that everything which reports
--- a source location reports it in the same shape.
report.RANGE = RANGE

--- A range in a named file, which is what the semantic operations return.
report.LOCATION = {
    type = "object",
    properties = {file = {type = "string"}, range = RANGE},
    required = {"file", "range"},
}

local EDIT = {
    type = "object",
    properties = {file = {type = "string"}, range = RANGE, newText = {type = "string"},},
    required = {"file", "range", "newText"},
}

--- A diagnostic, as `--json` reports it.
report.DIAGNOSTIC = {
    type = "object",
    properties = {
        file = {type = "string"},
        severity = {type = "string", enum = {"error", "warning", "note"}},
        code = {
            type = "string",
            description = "A stable code such as NUPP2004, or OPT-n for an " .. "optimizer remark."
        },
        lint = {
            type = "string",
            description = "The lint name, when the diagnostic came from one. "
            .. "This is what an @allow suppression writes."
        },
        docs = {
            type = "string",
            description = "The reference section covering this code, as a path "
            .. "and anchor. 'nupp explain <code>' says more."
        },
        message = {type = "string"},
        status = {type = "string", enum = {"fired", "declined", "unavailable"}},
        hotness = {type = "string", enum = {"unknown", "sampled"}},
        hotnessSamples = {type = "integer"},
        hotnessRange = {
            type = "object",
            properties = {startLine = {type = "integer"}, endLine = {type = "integer"}},
            required = {"startLine", "endLine"}
        },
        range = {
            type = "object",
            description = "Where the diagnostic is. Absent for one about something "
            .. "with no place in source, such as a file that could not be read or a "
            .. "manifest that could not be used.",
            properties = {start = POSITION, ["end"] = POSITION},
            required = {"start", "end"},
        },
        help = {type = "string", description = "A concrete repair direction."},
        notes = {type = "array", items = {type = "string"}},
        related = {
            type = "array",
            items = {
                type = "object",
                properties = {file = {type = "string"}, message = {type = "string"}, range = RANGE},
                required = {"file", "message", "range"},
            },
        },
        fixes = {
            type = "array",
            description = "Machine-applicable repairs. A fix is all-or-nothing: " .. "apply every edit in it or none.",
            items = {
                type = "object",
                properties = {title = {type = "string"}, edits = {type = "array", items = EDIT}},
                required = {"title", "edits"},
            },
        },
    },
    required = {"severity", "message", "fixes", "notes", "related"},
}

--- The array-of-diagnostics property every command that reports them carries, under
--- that name, so one reader handles all of them.
report.DIAGNOSTICS = {type = "array", items = report.DIAGNOSTIC}

--- `timing.parallel` in `check --json` and `build --json`.
report.PARALLEL = {
    type = "object",
    description = "How a cold whole-project check or build used its workers. Absent when "
    .. "they were not considered: a warm run, a run over named files.",
    properties = {
        mode = {type = "string", enum = {"parallel", "serial", "serial-fallback"},},
        workers = {type = "integer"},
        retries = {type = "integer"},
        batches = {type = "integer"},
        rechecked = {
            type = "integer",
            description = "Worker-produced modules done again in the coordinating process "
            .. "because their records did not validate. Present only in parallel mode.",
        },
        reason = {type = "string", description = "Why the run selected or returned to a single process.",},
    },
    required = {"mode", "workers", "retries", "batches"},
}

--- The field every `--json` document carries, and requires. It equals `status == 0`,
--- and false always comes with at least one error diagnostic that has a code.
report.OK = {
    type = "boolean",
    description = "Whether the command did what it was asked; the same answer as "
    .. "exit status 0. False always comes with at least one error in "
    .. "`diagnostics` that carries a code.",
}

--- The document a command whose schema is a choice of shapes writes when it fails:
--- one more branch of its `oneOf`, which no successful document matches.
report.FAILURE = {
    type = "object",
    description = "The command failed; `diagnostics` says why.",
    properties = {ok = {type = "boolean", enum = {false}}, diagnostics = report.DIAGNOSTICS},
    required = {"ok", "diagnostics"},
}

local function emptyValue(schema: any): unknown
    local kind = schema and schema.type
    if kind == "array" then
        return {}
    elseif kind == "object" then
        local value: {[string]: unknown} = {}
        for _, name in ipairs(schema.required or {}) do
            value[name] = emptyValue(schema.properties and schema.properties[name])
        end
        return value
    elseif kind == "string" then
        return ""
    elseif kind == "integer" or kind == "number" then
        return 0
    elseif kind == "boolean" then
        return false
    end

    return json.NULL
end

-- The branch of a `oneOf` that a failure is: the one whose `ok` can only be false.
local function failureShape(schema: any): any
    if not schema or not schema.oneOf then
        return schema
    end
    for _, branch in ipairs(schema.oneOf) do
        local ok = branch.properties and branch.properties.ok
        if ok and ok.enum and #ok.enum == 1 and ok.enum[1] == false then
            return branch
        end
    end

    return schema.oneOf[1]
end

--- Writes the document a failed `--json` run owes its reader and returns status 1: `ok`
--- false, the diagnostics that say why, whatever `fields` the command already has, and
--- every other field the schema requires at its empty value, so the one document is
--- valid against `--schema` whichever step failed. Nothing goes to stderr: the reason
--- is in the document.
function report.failure(schema: any, diagnostics: {any}, fields: {[string]: any}?): integer
    local document: {[string]: any} = fields or {}
    document.ok = false
    document.diagnostics = report.diagnosticValues(diagnostics)
    local shape = failureShape(schema)
    for _, name in ipairs(shape and shape.required or {}) do
        if document[name] == nil then
            document[name] = emptyValue(shape.properties and shape.properties[name])
        end
    end
    report.write(document)

    return 1
end

export = report
