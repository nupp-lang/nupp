module nupp.tools.cli.schema

-- Detect report-schema requests using the command's derived grammar.
local cliModule = require("io.cli")

export function requests(subject: any, argv: {string}): boolean
    if subject == nil then
        return false
    end
    local grammar = cliModule.schema(subject)
    if grammar == nil then
        return false
    end
    local arity: {[string]: cliModule.ValueArity} = {}
    local fields: {[string]: any} = {}
    local patterns: {cliModule.Pattern} = {}
    for _, field in ipairs(grammar.fields) do
        if field.role == "option" then
            for _, name in ipairs(field.names) do
                fields[name] = field
                arity[name] = field.constants[name] ~= nil and cliModule.none or field.arity
            end
            if field.pattern ~= nil then
                patterns[#patterns + 1] = {pattern = field.pattern, key = field.matchKey}
            end
        end
    end
    local stream = cliModule.optparser(argv, {
        arity = arity,
        patterns = patterns,
        stopatfirstargument = grammar.stopatfirstargument,
    })
    while true do
        local kind = stream:next()
        if kind == nil then
            return false
        end
        local option = kind == cliModule.shortoption or kind == cliModule.longoption
        local field = option and not stream:pattern() and fields[stream:key()] or nil
        if field ~= nil and field.field == "schema" and stream:value() == nil then
            return true
        end
    end
end
