module nupp.tools.cli.ast

--[[
`nupp ast`: the parse, as the parser saw it.

The tree is lossless, so what is printed is not a summary of the file but the
file itself in another shape, with every token, every piece of trivia, every
position. A parse that failed still prints, since a recovered tree is what
explains the failure.

It prints as JSON, because a tree this literal is read by a program far more
often than by a person; `--json-pretty` indents the same document for the
times it is a person.
]]

local usageError = require("nupp.tools.cli.error").forCommand("ast")
local cliModule = require("nupp.cli")
local report = require("nupp.tools.cli.report")

local REPORT_SCHEMA = {
    type = "object",
    properties = {
        file = {type = "string"},
        root = {["$ref"] = "#/definitions/node"},
        errors = {
            type = "array",
            items = {
                type = "object",
                properties = {
                    code = {type = "string"},
                    message = {type = "string"},
                    offset = {type = "integer"},
                    length = {type = "integer"},
                    line = {type = "integer"},
                    col = {type = "integer"},
                    help = {type = "string"}
                },
            },
        },
    },
    required = {"file", "root", "errors"},
    definitions = {
        node = {
            description = "A structural node, or a token with the trivia "
            .. "attached to it. The tree is lossless: every byte of the "
            .. "source is in exactly one token or one piece of trivia.",
            type = "object",
            properties = {
                tag = {type = "string", enum = {"node", "token"}},
                kind = {type = "string"},
                children = {type = "array", items = {["$ref"] = "#/definitions/node"}},
                text = {type = "string"},
                offset = {type = "integer"},
                line = {type = "integer"},
                col = {type = "integer"},
                missing = {type = "boolean", description = "Inserted by error recovery; not in the " .. "source."},
                trivia = {
                    type = "array",
                    items = {
                        type = "object",
                        properties = {
                            kind = {type = "string"},
                            text = {type = "string"},
                            offset = {type = "integer"},
                            line = {type = "integer"},
                            col = {type = "integer"}
                        }
                    },
                },
            },
            required = {"tag", "kind"},
        },
    },
}

--- One node or token as plain data. Recursive, because the tree is.
local function syntaxTreeValue(cst: any, value: any): any
    if cst.isToken(value) then
        local trivia: {any} = {}
        for index = 1, value.triviaCount do
            trivia[#trivia + 1] = require("nupp.compiler.lexer").triviaRecord(value, index)
        end
        return {
            tag = "token",
            kind = value.kind,
            text = value.text,
            offset = value.offset,
            line = value.line,
            col = value.col,
            missing = value.missing and true or nil,
            trivia = trivia,
        }
    end
    local children: {any} = {}
    for _, child in ipairs(value) do
        children[#children + 1] = syntaxTreeValue(cst, child)
    end

    return {tag = "node", kind = value.kind, children = children}
end

local function run(options: any): integer
    local positional: {string} = {options.file}
    local paths: {string} = positional
    if #paths ~= 1 then
        return usageError("exactly one source file is required")
    end
    local path = paths[1]
    local fs = require("nupp.compiler.fs")
    local source, readErr = fs.readFile(path)
    if not source then
        io.stderr:write("nupp: " .. tostring(readErr) .. "\n")
        return 1
    end
    local parser = require("nupp.compiler.parser")
    local cst = require("nupp.compiler.cst")
    local result = parser.parse(source, path)
    local errors: {any} = {}
    for _, err in ipairs(result.errors) do
        errors[
            #errors + 1
        ] = {
            code = err.code,
            message = err.msg,
            offset = err.offset,
            length = err.length,
            line = err.line,
            col = err.col,
            help = err.help
        }
    end
    local value = {file = path, root = syntaxTreeValue(cst, result.root), errors = errors}
    io.write((options.jsonPretty and report.encodePretty(value) or report.encode(value)) .. "\n")

    return require("nupp.compiler.diagnostics").report(result.errors) and 1 or 0
end

--- Dump a Nupp file's parsed syntax tree as JSON.
---
--- The lossless tree includes structural children, tokens, trivia, locations,
--- and parse errors.
---
--- Examples:
---
---     nupp ast src/main.nupp
---     nupp ast --json-pretty src/main.nupp
@cli("ast")
@derive(cliModule.Command)
local record Ast
    --- Indent the JSON instead of printing it on one line.
    jsonPretty: boolean = false

    --- Print the JSON Schema of JSON output and exit.
    schema: boolean = false

    --- Source file to parse.
    @cli(positional = "FILE")
    file: string

    function run(self): integer
        return run(self)
    end
end

function Ast.reportSchema(): any
    return REPORT_SCHEMA
end

export = {commandType = Ast}
