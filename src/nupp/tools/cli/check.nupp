module nupp.tools.cli.check

--[[
`nupp check`: type-check without emitting anything.

With no files, the project is the subject and the manifest decides what that
means. With files named, each is checked as the project's own module where it is
one, so it is judged by the manifest a build would judge it by and reuses what
the last check worked out about it; a file the project does not reach -- a
declaration file, a `.lua`, a file from outside, or anything at all when there is
no manifest here -- is parsed and checked on its own. Either way what is reported
is the named files, not their dependencies.

`--json` reports the same diagnostics in the form meant for a program; see
`docs/reference/diagnostics.md`.

A check run from a terminal says which module it is on and how far through the
source set it is, on one line it rewrites in place. Nothing is written anywhere
else, which is what keeps a scripted check as quiet as it has always been.
]]

local usageError = require("nupp.tools.cli.error").forCommand("check")
local cliModule = require("nupp.cli")

local REPORT_SCHEMA = {
    type = "object",
    properties = {
        ok = {
            type = "boolean",
            description = "Whether the check ran and found nothing wrong. False "
            .. "both for a project that reported an error and for a run that never "
            .. "got as far as checking, such as one whose manifest could not be "
            .. "used -- an empty `diagnostics` cannot tell those apart on its own.",
        },
        diagnostics = require("nupp.tools.cli.report").DIAGNOSTICS,
        compat = {type = "string", enum = {"lua51"}, description = "The enforced source compatibility profile."},
        dialect = {
            type = "string",
            enum = require("nupp.compiler.dialects").names(),
            description = "The resolved source-lowering dialect."
        },
        platform = {type = "string"},
        platforms = {type = "array", items = {type = "object"}},
        timing = {
            type = "object",
            description = "Where the check's wall-clock time went, and how many "
            .. "of the project's modules were reused from the cache versus "
            .. "rechecked this run, including explicitly named files. `compiledModules = 0` is the authoritative answer that "
            .. "nothing was redone; `slowest` ranks modules by time actually "
            .. "spent regardless of that answer, since confirming a module's "
            .. "cache entry is still valid costs time too, only less of it.",
            properties = {
                totalMs = {type = "number", description = "Wall-clock milliseconds for the whole check."},
                compiledModules = {type = "integer"},
                reusedModules = {type = "integer"},
                specializedBodies = {type = "integer"},
                phases = {
                    type = "array",
                    description = "Every activity that took measurable time, longest "
                    .. "first. One activity is current at a time, so these sum to the whole.",
                    items = {
                        type = "object",
                        properties = {name = {type = "string"}, durationMs = {type = "number"}},
                        required = {"name", "durationMs"},
                    },
                },
                slowest = {
                    type = "array",
                    description = "The costliest modules, longest first, each charged "
                    .. "for its own checking and not for its dependencies'. A module "
                    .. "reused from the cache still spends time being confirmed valid, "
                    .. "so it can appear here even when `compiledModules` is 0.",
                    items = {
                        type = "object",
                        properties = {module = {type = "string"}, durationMs = {type = "number"}},
                        required = {"module", "durationMs"},
                    },
                },
            },
            required = {"totalMs", "compiledModules", "reusedModules", "specializedBodies", "phases", "slowest",},
        },
    },
    required = {"ok", "diagnostics", "dialect"},
}

local function run(options: any): integer
    local positional: {string} = options.files
    local paths: {string} = positional
    local values = options
    -- An absent flag leaves the decision to the file's extension. False is an
    -- explicit request for gradual checking in the checker API.
    local strict = values.strict and true or nil
    local _, compatError = require("nupp.compiler.compat").resolve(values.compat, nil, values.dialect)
    if compatError then
        return usageError(compatError)
    end
    local target = values.target
    if (target or values.platform) and #paths > 0 then
        return usageError("--target and --platform cannot be combined with source files")
    end
    local asJson = values.format == "json"
    -- Nothing is narrated at a program: it gets `timing` in the document it asked for.
    -- Naming --progress explicitly overrules that, which is how somebody watching a
    -- --json check sees it move.
    local progressMode = values.progress or (asJson and "never" or nil)
    local reportMod = require("nupp.tools.cli.report")
    local diagnostics: {any} = {}
    local effectiveDialect = assert(require("nupp.compiler.dialects").resolve(values.dialect))

    local progress = require("nupp.tools.build.progress")
    local started = progress.now()
    local timing = {compiledModules = 0, reusedModules = 0, specializedBodies = 0, phases = {}, slowest = {}}

    local effectiveCompat = values.compat

    local function writeJson(ok: boolean): nil
        local total = progress.now() - started
        timing.totalMs = total
        timing.phases = {{name = "check", durationMs = total}}
        reportMod.write({
            ok = ok,
            diagnostics = reportMod.diagnosticValues(diagnostics),
            dialect = effectiveDialect,
            compat = effectiveCompat,
            timing = timing
        })
    end

    if #paths == 0 then
        local project = require("nupp.tools.build.project")
        local produced: {[string]: any} = {}
        local code = project.check(".", {
            strict = strict,
            dialect = values.dialect,
            compat = values.compat,
            target = target,
            platform = values.platform,
            diagnostics = asJson and diagnostics or nil,
            produced = asJson and produced or nil,
            progress = progressMode
        })
        effectiveDialect = produced.dialect or effectiveDialect
        if not produced.timing then
            local total = progress.now() - started
            timing.totalMs = total
            timing.phases = {{name = "check", durationMs = total}}
            produced.timing = timing
        end
        effectiveCompat = produced.compat or effectiveCompat
        if asJson then
            reportMod.write({
                ok = code == 0,
                diagnostics = reportMod.diagnosticValues(diagnostics),
                dialect = effectiveDialect,
                compat = effectiveCompat,
                platform = produced.platform,
                platforms = produced.platforms,
                timing = produced.timing,
            })
        end
        return code
    end
    local fs = require("nupp.compiler.fs")
    local parser = require("nupp.compiler.parser")
    local check = require("nupp.compiler.check")
    local diagnosticMod = require("nupp.compiler.diagnostics")
    local failed = false

    -- A file that cannot be read is answered here, before anything else is asked to
    -- account for it. Below, an unreadable path would reach the project walk as a
    -- module with no source, which is indistinguishable from a module that is simply
    -- fine.
    local readable: {string}, sources = {}, {}
    for _, path in ipairs(paths) do
        local source, err = fs.readFile(path)
        if source then
            readable[#readable + 1] = path
            sources[path] = source
        else
            reportMod.fileFailure(
                path,
                err,
                "check that the path exists and is readable",
                asJson and diagnostics or nil
            )
            failed = true
        end
    end

    -- A named file is checked through the project when it is one of the project's own
    -- modules, which is what gives it the reuse a whole-project check has: unchanged
    -- source, unchanged dependencies, and the file's diagnostics are replayed from the
    -- last run rather than worked out again. It also means the file is checked the way
    -- the project checks it -- same manifest, same strictness, same dependencies -- and
    -- not the way a file that happens to be lying there would be.
    --
    -- What is left over is a declaration file, a `.lua`, a file from outside the
    -- project, or every file when there is no project here at all. Those are parsed and
    -- checked on their own below, which is what every named file used to get.
    local remaining = readable
    -- A directory with no `nupp.lua` is a supported configuration: every file is
    -- checked on its own. A manifest that exists and cannot be loaded is not, since a
    -- file checked without it would be checked the wrong way and say it was fine.
    local config: any = nil
    if #readable > 0 and fs.exists("nupp.lua") then
        local loaded, loadErr = require("nupp.tools.build.manifest").load(".")
        if not loaded then
            if asJson then
                diagnostics[
                    #diagnostics + 1
                ] = reportMod.fileDiagnostic(
                    "nupp.lua",
                    (tostring(loadErr):gsub("^nupp: ", "")),
                    "fix the manifest, or check the file from a directory without one"
                )
                writeJson(false)
            else
                io.stderr:write(tostring(loadErr) .. "\n")
            end

            return 1
        end
        config = loaded
    end
    if config then
        local envMod = require("nupp.compiler.env")
        local roots = envMod.projectRoots(".", config as {[string]: any})
        local mine: {string} = {}
        for _, path in ipairs(readable) do
            if envMod.moduleNameInRoots(roots, path) then
                mine[#mine + 1] = path
            end
        end
        -- Nothing here belongs to the project, so there is nothing to ask the project
        -- about. Asking anyway would resolve the project's dependencies and walk its
        -- source set to answer a question about a file somewhere else entirely.
        if #mine > 0 then
            local project = require("nupp.tools.build.project")
            local unchecked: {string} = {}
            local produced: {[string]: any} = {}
            local code = project.check(".", {
                strict = strict,
                dialect = values.dialect,
                compat = values.compat,
                paths = mine,
                unchecked = unchecked,
                diagnostics = asJson and diagnostics or nil,
                produced = produced,
                progress = progressMode,
            })
            if produced.timing then
                timing = produced.timing
            end
            effectiveDialect = produced.dialect or effectiveDialect
            effectiveCompat = produced.compat or effectiveCompat
            if code ~= 0 then
                failed = true
            end
            remaining = {}
            local handled = {}
            for _, path in ipairs(mine) do
                handled[path] = true
            end
            for _, path in ipairs(unchecked) do
                handled[path] = nil
            end
            for _, path in ipairs(readable) do
                if not handled[path] then
                    remaining[#remaining + 1] = path
                end
            end
        end
    end
    if #remaining == 0 then
        if asJson then
            writeJson(not failed)
        end

        return failed and 1 or 0
    end

    local env = require("nupp.compiler.env").new(".", {compat = values.compat})
    effectiveCompat = env.compat or effectiveCompat
    for _, path in ipairs(remaining) do
        timing.compiledModules = timing.compiledModules + 1
        local fileStarted = progress.now()
        local result = parser.parse(sources[path] as string, path)
        if #result.errors > 0 then
            if asJson then
                for _, diagnostic in ipairs(result.errors) do
                    diagnostics[#diagnostics + 1] = diagnostic
                end
            else
                diagnosticMod.report(result.errors)
            end
            failed = true
        else
            local diags = check.check(result, path, env as {[string]: any}, {
                strict = strict,
                dialect = effectiveDialect,
                compat = values.compat,
            })
            if asJson then
                for _, diagnostic in ipairs(diags) do
                    diagnostics[#diagnostics + 1] = diagnostic
                    if diagnosticMod.isFatal(diagnostic) then
                        failed = true
                    end
                end
            elseif diagnosticMod.report(diags) then
                failed = true
            end
        end
        timing.slowest[#timing.slowest + 1] = {module = path, durationMs = progress.now() - fileStarted}
    end
    table.sort(timing.slowest, function(a, b)
        return a.durationMs > b.durationMs
    end)
    while #timing.slowest > progress.SLOWEST do
        table.remove(timing.slowest)
    end
    -- Checking one named file still needs the project's declaration index, which is a
    -- header for every file in the project. Whatever this run had to work out for
    -- itself, the next one should not.
    require("nupp.compiler.env").persist(env)
    if asJson then
        writeJson(not failed)
    end

    return failed and 1 or 0
end

--- Type-check source without emitting Lua.
---
--- With no files, checks the configured project target. Named files are
--- checked with project context when available.
---
--- Examples:
---
---     nupp check
---     nupp check src/main.nupp
---     nupp check --strict --json
---     nupp check --target app
@cli("check")
@derive(cliModule.Command)
local record Check
    --- Treat strict checker rules as errors.
    strict: boolean = false

    --- Source-lowering dialect.
    @cli(value = "DIALECT", choices = {"luajit"})
    dialect: string?

    --- Enforce the stock Lua 5.1 source subset without compatibility lowering.
    @cli(value = "PROFILE", choices = {"lua51"})
    compat: string?

    --- Check a named manifest target.
    @cli(value = "NAME")
    target: string?

    --- Check one configured binary platform, or all.
    @cli(value = "NAME")
    platform: string?

    --- When to report progress and timing.
    @cli(
        arity = "optionalAttached",
        constant = "always",
        constantAliases = {q = "never", quiet = "never"},
        choices = {"always", "never", "auto"},
        value = "WHEN"
    )
    progress: string?

    --- Select the report representation.
    @cli(value = "FORMAT", constantAliases = {json = "json", text = "text"})
    format: "text" | "json" = "text"

    --- Print the JSON Schema of JSON output and exit.
    schema: boolean = false

    --- Source files to check.
    @cli(positional = "FILE")
    files: {string} = {}

    function run(self): integer
        return run(self)
    end
end

function Check.reportSchema(): any
    return REPORT_SCHEMA
end

export = {commandType = Check}
