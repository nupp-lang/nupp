module nupp.tools.cli.fixpoint

--[[
`nupp fixpoint`: the claim that the compiler reproduces itself.

Two claims, really. The default one is about the compiler: starting from the
stage zero a checkout is pinned to, it compiles itself three times and the last
two results must agree. `--binary` is about packaging: the stamped binary must
stamp another identical to itself, which is what the payload format's
determinism rests on.
]]

local usageError = require("nupp.tools.cli.error").forCommand("fixpoint")
local cliModule = require("nupp.cli")

local REPORT_SCHEMA = {
    type = "object",
    properties = {
        ok = require("nupp.tools.cli.report").OK,
        diagnostics = require("nupp.tools.cli.report").DIAGNOSTICS,
        kind = {
            type = "string",
            enum = {"compiler", "binary"},
            description = "Which claim was checked: the compiler compiling "
            .. "itself from stage zero, or the packaged binary stamping another."
        },
        target = {type = "string", description = "The manifest target that was verified."},
        emittedStage0 = {type = "string", description = "Where the stage-zero image was written, if anywhere."},
        bytes = {type = "integer", description = "The size of the verified binary, for --binary."},
        reason = {type = "string", description = "Why it failed, in one phrase. Absent when ok is true."},
    },
    required = {"ok", "kind", "diagnostics"},
}

-- Says why the run stopped, on stderr unless the report carries it.
local function report(asJson: boolean, code: string, message: string): any
    if not asJson then
        io.stderr:write(message, "\n")
    end

    return require("nupp.tools.cli.report").runDiagnostic(code, message)
end

local function run(options: any): integer
    local positional: {string} = {}
    if #positional > 0 then
        return usageError("unexpected argument " .. positional[1])
    end
    local values = options
    if values.binary and values.emitStage0 then
        return usageError("--binary verifies the packaged binary and composes no stage zero")
    end
    local asJson = values.format == "json"
    local project = require("nupp.tools.build.project")
    -- The collector doubles as the request to stay quiet: what it fills is what gets
    -- said, so the human line does not land in front of the document.
    local result: {[string]: any} = {}
    local diagnostics: {any} = {}
    local collected = asJson and diagnostics or nil
    local code: integer
    local config: any, manifestErr: string? = nil, nil
    if not values.binary then
        config, manifestErr = project.loadManifest(".")
    end
    if values.binary then
        code = project.binaryFixpoint(".", {result = asJson and result or nil, diagnostics = collected})
    elseif config == nil then
        diagnostics[#diagnostics + 1] = report(asJson, "NUPP0002", tostring(manifestErr))
        code = 1
    elseif config.selfHost == nil then
        diagnostics[#diagnostics + 1] = report(asJson, "NUPP0003", "nupp: this project declares no selfHost compiler")
        code = 1
    elseif not rawget(_G, "__nupp_load_image") then
        diagnostics[#diagnostics + 1] = report(asJson, "NUPP0004", "nupp: the fixpoint runs on the VM compiler")
        code = 1
    else
        -- The claim is about the root image, which the compiler emits itself,
        -- starting from the stage zero `selfHost.bootstrap` names.
        local found = require("nupp.tools.vm.fixpoint").run(
            require("nupp.compiler.fs").absolute("."),
            "build/vm-fixpoint",
            function(line: string): nil
                if not asJson then
                    io.stderr:write(line, "\n")
                end
            end,
            config.selfHost.bootstrap
        )
        code = found.ok and 0 or 1
        -- A stage zero is the verified root image itself: a platform-free
        -- graph image a cold checkout runs on a runtime built from its sources.
        if found.ok and values.emitStage0 then
            local fs = require("nupp.compiler.fs")
            local written, writeErr = fs.writeFile(values.emitStage0, assert(fs.readFile(found.image as string)))
            if not written then
                io.stderr:write("nupp: ", tostring(writeErr), "\n")
                code = 1
            elseif not asJson then
                io.write(("wrote the stage-zero image to %s\n"):format(values.emitStage0))
            end
            result.emittedStage0 = values.emitStage0
        end
        if asJson then
            result.target = "vm"
            result.reason = found.reason
        elseif found.ok then
            io.write(
                (
                    "fixpoint ok: the VM compiler image emits itself byte-identically (%s, %s)\n"
                ):format(tostring(found.image), tostring(found.digest))
            )
        else
            io.stderr:write("nupp: VM fixpoint failed: ", tostring(found.reason), "\n")
        end
        if asJson and not found.ok then
            diagnostics[
                #diagnostics + 1
            ] = require(
                "nupp.tools.cli.report"
            ).runDiagnostic("NUPP0004", "nupp: VM fixpoint failed: " .. tostring(found.reason))
        end
    end
    if asJson then
        local report = require("nupp.tools.cli.report")
        result.ok = code == 0
        result.kind = values.binary and "binary" or "compiler"
        result.diagnostics = report.diagnosticValues(diagnostics)
        report.write(result)
    end

    return code
end

--- Verify a byte-identical self-hosting rebuild.
---
--- Examples:
---
---     nupp fixpoint
---     nupp fixpoint --binary
---     nupp fixpoint --emit-stage0 build/stage0/nupp.image
@cli("fixpoint")
@derive(cliModule.Command)
local record Fixpoint
    --- Write the verified stage-zero image here.
    @cli(value = "PATH")
    emitStage0: string?

    --- Verify the packaged binary instead of the compiler.
    binary: boolean = false

    --- Select the report representation.
    @cli(value = "FORMAT", constantAliases = {json = "json", text = "text"})
    format: "text" | "json" = "text"

    --- Print the JSON Schema of JSON output and exit.
    schema: boolean = false

    function run(self): integer
        return run(self)
    end
end

function Fixpoint.reportSchema(): any
    return REPORT_SCHEMA
end

export = {commandType = Fixpoint}
