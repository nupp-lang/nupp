module nupp.tools.cli.doc

--[[
`nupp doc`: the API documentation, generated from what the source already says.

What is produced is `--kind`, the same word `lsp artifact` uses, rather than a
leading positional that a source path could be mistaken for. Everything else the
manifest already configured; the options here override it for one run.
]]
const {type Config} = require("nupp.tools.build.manifest")
const {type Target} = require("nupp.tools.build.manifest")

local cliModule = require("nupp.cli")

local REPORT_SCHEMA = {
    type = "object",
    properties = {
        ok = {type = "boolean"},
        format = {type = "string", description = "The resolved format: site, markdown, json, or both."},
        output = {type = "string", description = "The file or directory the run was pointed at."},
        files = {
            type = "array",
            items = {type = "string"},
            description = "Every path written. A file whose contents did "
            .. "not change is not rewritten and is not listed."
        },
    },
    required = {"ok", "format", "output", "files"},
}

local function run(options: any): integer
    local values = options
    local asJson = values.format == "json"
    local settings: any = nil

    local function fail(problem: any): integer
        io.stderr:write("nupp: " .. tostring(problem) .. "\n")
        if asJson then
            require("nupp.tools.cli.report").write({
                ok = false,
                files = {},
                output = values.output or settings and settings.outDir or "",
                format = values.kind or settings and settings.format or "",
            })
        end

        return 1
    end

    local doc = require("nupp.tools.doc")
    -- A directory with no `nupp.lua` documents with the defaults. One that has a
    -- manifest that does not load is an error, as it is for every other command,
    -- rather than a manifest nobody wrote.
    local config: any = {}
    if require("nupp.compiler.fs").exists("nupp.lua") then
        local loaded, configErr = require("nupp.tools.build.manifest").load(".")
        if not loaded then
            return fail((tostring(configErr):gsub("^nupp: ", "")))
        end
        config = loaded
    end
    local settingsErr: any = nil
    settings, settingsErr = doc.manifestSettings(config, values.target)
    if not settings then
        return fail(settingsErr)
    end
    -- What the docs target depends on is what the renderer loads. A project that names
    -- lunamark as a rock gets it installed here, so `nupp doc` on a fresh checkout
    -- renders rather than reporting a library nobody was told to install.
    local deps = require("nupp.tools.build.deps")
    local installed, depErr = deps.build(".", settings.outDir or "build", config as Config, {}, settings as Target)
    if not installed then
        return fail(depErr)
    end
    local opts: {[string]: any} = {output = values.output, title = values.title}
    opts.format = values.kind
    if #values.paths > 0 then
        -- A path that names nothing documented nothing and said so with a clean exit,
        -- which is also what became of a format word written where a path goes.
        for _, path in ipairs(values.paths) do
            if not require("nupp.compiler.fs").exists(path) then
                return fail("no source file or directory named " .. path)
            end
        end
        opts.sources = values.paths
    end
    if values.includePrivate then
        settings.includePrivate = true
    end
    local written: {string} = {}
    if asJson then
        opts.written = written
    end
    local code, output, resolved = doc.build(".", config as Config, settings as Target, opts)
    if asJson then
        require("nupp.tools.cli.report").write({
            ok = code == 0,
            files = written,
            output = output or "",
            format = resolved or ""
        })
    end

    return code
end

--- Generate API documentation from source comments.
---
--- `--kind` names what to produce. Arguments are source paths; with none, the
--- manifest's configured sources are used.
---
--- Examples:
---
---     nupp doc
---     nupp doc --kind markdown -o docs/api.md
---     nupp doc --kind site --target library --output build/site
@cli("doc")
@derive(cliModule.Command)
local record Doc
    --- What to produce: site, markdown, json, or both.
    @cli(value = "KIND", choices = {"site", "markdown", "json", "both"})
    kind: string?

    --- Output file or directory.
    @cli(short = "o", value = "PATH")
    output: string?

    --- Document a named manifest target.
    @cli(value = "NAME")
    target: string?

    --- Documentation title.
    @cli(value = "TITLE")
    title: string?

    --- Include unexported, internal and private declarations.
    includePrivate: boolean = false

    --- Select this command's report representation.
    @cli(value = "FORMAT", constantAliases = {json = "json", text = "text"})
    format: "text" | "json" = "text"

    --- Print the JSON Schema of JSON output and exit.
    schema: boolean = false

    --- Source paths to document.
    @cli(positional = "PATH")
    paths: {string} = {}

    function run(self): integer
        return run(self)
    end
end

function Doc.reportSchema(): any
    return REPORT_SCHEMA
end

export = {commandType = Doc}
