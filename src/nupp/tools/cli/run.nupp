module nupp.tools.cli.run

--[[
`nupp run`: compile a program and run it.

The one command whose argument list has two halves. Everything up to the file
name is the compiler's; everything after it belongs to the program, which is why
this grammar stops at the first argument that is not an option. `--remarks-out`
carries its value attached rather than in the next argument for the same reason:
bare, it must not swallow the file name behind it.
]]
const {type Session} = require("nupp.tools.cli.watch")

local errors = require("nupp.tools.cli.error")
local usageError = errors.forCommand("run")
local cliModule = require("nupp.cli")

local function configureGpuCosts(path: string?): (boolean, string?)
    local loaded, provider = pcall(require, "nupp.runtime.provider.nativegpu")
    if not loaded then
        -- A host with no GPU provider runs no GPU operation, so the record of
        -- them is the empty one a CPU-only program writes anywhere else.
        if path == nil then
            return true, nil
        end
        local written, writeErr = require("nupp.compiler.fs").writeFile(path, "")
        return written ~= nil, written == nil and tostring(writeErr) or nil
    end
    local ok, problem = pcall((provider as any).costsOutput, path)

    return ok, not ok and tostring(problem) or nil
end

local function run(options: any): integer
    local positional: {string} = {options.file}
    for _, value in ipairs(options.arguments) do
        positional[#positional + 1] = value
    end
    local values = options
    if values.gpuCosts == "" then
        return usageError("--gpu-costs needs an output path")
    end
    if values.remarksOut == "" then
        return usageError("--remarks-out= requires a file name")
    end
    local path = positional[1]
    if not path then
        return usageError("a program file is required")
    end
    local watching = values.watch == true
    if watching and not path:find("%.nupp$") then
        return usageError("--watch requires a .nupp program")
    end
    if watching and values.optLevel and values.optLevel ~= "0" then
        return usageError("--watch supports -O0 only; run a normal optimized build before release")
    end
    local programArgs: {string} = {}
    for index = 2, #positional do
        programArgs[#programArgs + 1] = positional[index]
    end

    local compile = require("nupp.tools.cli.compile")
    local settings = compile.settings(values)
    local projectEnv = require("nupp.compiler.project.env").new(".")
    local loadImage: (function(image: string): (any, string?))? = rawget(_G, "__nupp_load_image")
    local chunk, err
    local watch: Session? = nil
    if watching and not loadImage then
        -- Hot reload patches function bodies in the VM's code; there is no other
        -- target.
        return usageError("--watch runs on the VM; install a VM CLI with scripts/vm-cli")
    elseif watching then
        local session, diagnostics = require("nupp.tools.cli.watch").open(path)
        if not session then
            require("nupp.compiler.diagnostics").report(diagnostics or {})
            return 1
        end
        watch = session
        chunk, err = (loadImage as function(image: string): (any, string?))(session.entryCode)
    elseif path:find("%.nupp$") and loadImage then
        -- The VM runs what its own lowering compiled, never generated Lua.
        local image = compile.image(path, projectEnv, nil)
        if not image then
            return 1
        end
        chunk, err = loadImage(image)
    elseif path:find("%.nupp$") then
        return usageError("running a .nupp program needs the VM; install a VM CLI with scripts/vm-cli")
    else
        chunk, err = loadfile(path)
    end
    if not chunk then
        io.stderr:write(errors.message(err) .. "\n")
        return 1
    end

    -- Written before the program starts, because the program is what reads it: a
    -- benchmark reports the optimization level and declined passes it was compiled
    -- under alongside what it measured. At this point it accounts for the entry alone;
    -- it is written again below, once every module the program required has been
    -- compiled, which is the complete account a reader of the file gets.
    compile.writeRemarks(settings)
    -- What checking the entry worked out about the project, its index above all,
    -- kept for the next run before this one starts: a program may never return.
    -- Without it every run read and parsed every file under the include roots
    -- again, which on the VM is most of starting a benchmark child.
    require("nupp.compiler.project.env").persist(projectEnv)

    local runtime = require("nupp.compiler.runtime")
    local compileLoaded: function(modulePath: string, env: any, name: string): (string?, string?)
    local loaded
    if watch then
        compileLoaded, loaded = watch.compileLoaded, watch.loaded
    else
        compileLoaded = function(modulePath: string, env: any, name: string): string?, string?
            if not loadImage then
                return nil, "loading a .nupp module needs the VM"
            end
            local image = compile.image(modulePath, env, name)

            return image, image == nil and "type errors" or nil
        end
    end
    local checkPlain = function(modulePath: string, env: any): boolean
        return compile.check(modulePath, env, {}) ~= nil
    end
    -- The program's `arg` is its own, as it is for a script `luajit` runs: `arg[0]` the
    -- program and `arg[1]` onwards what followed it. The compiler's command line is
    -- still what compiling reads, and a module the program requires is compiled while
    -- it runs, so each compile puts the compiler's back for its duration: the comptime
    -- worker and compiler packs find the executable through it.
    local toolArg: any = rawget(_G, "arg")
    local programArg: {[integer]: string} = {[0] = path}
    for index, value in ipairs(programArgs) do
        programArg[index] = value
    end
    local compileProgram, checkProgram = compileLoaded, checkPlain
    compileLoaded = function(modulePath: string, env: any, name: string): string?, string?
        local current: any = rawget(_G, "arg")
        rawset(_G, "arg", toolArg)
        local ok, code, problem = pcall(compileProgram, modulePath, env, name)
        rawset(_G, "arg", current)
        if not ok then
            error(code, 0)
        end

        return code, problem
    end
    checkPlain = function(modulePath: string, env: any): boolean
        local current: any = rawget(_G, "arg")
        rawset(_G, "arg", toolArg)
        local ok, clean = pcall(checkProgram, modulePath, env)
        rawset(_G, "arg", current)
        if not ok then
            error(clean, 0)
        end

        return clean
    end
    if values.gpuCosts ~= nil then
        local directory = require("nupp.compiler.fs").dirname(values.gpuCosts)
        local made, makeErr = require("nupp.io.files").createDirectory(directory)
        if not made then
            io.stderr:write(errors.message(makeErr) .. "\n")
            return 1
        end
        local configured, configureErr = configureGpuCosts(values.gpuCosts)
        if not configured then
            io.stderr:write(errors.message(configureErr) .. "\n")
            return 1
        end
    end
    local loadCompiled = loadImage and function(code: string, _: string): (any, string?)
        return (loadImage as function(image: string): (any, string?))(code)
    end or nil
    local removeLoader = runtime.install(projectEnv, compileLoaded, loaded, checkPlain, loadCompiled)
    -- An artifact left by an earlier run may still be present. Tell a library in this
    -- run where this invocation writes one, if it does, without making the path
    -- another piece of program configuration.
    local previousRemarksOut = _G.__nuppRemarksOut
    _G.__nuppRemarksOut = settings.remarksOut
    rawset(_G, "arg", programArg)
    local ok, runErr = pcall(chunk, unpack(programArgs))
    rawset(_G, "arg", toolArg)
    local gpuCostsError: string? = nil
    if values.gpuCosts ~= nil then
        local closed, closeErr = configureGpuCosts(nil)
        if not closed then
            gpuCostsError = closeErr
        end
    end
    _G.__nuppRemarksOut = previousRemarksOut
    removeLoader()
    if watch then
        watch.finish(ok)
    end

    -- Complete after lazy loading, so the artifact covers every module the program
    -- required.
    compile.writeRemarks(settings)
    if gpuCostsError ~= nil then
        io.stderr:write(errors.message(gpuCostsError) .. "\n")
    end
    if not ok then
        io.stderr:write(errors.message(runErr) .. "\n")
        return 1
    end

    return gpuCostsError ~= nil and 1 or 0
end

--- Compile and run a Nupp or Lua program.
---
--- The program path divides compiler options from arguments passed to the
--- loaded chunk. Use `--` before a program path beginning with a dash.
--- `--watch` is development-only, uses `-O0`, and applies valid changed-body
--- patches at cooperative poll boundaries.
---
--- Examples:
---
---     nupp run src/main.nupp
---     nupp run src/main.nupp first second
@cli(name = "run", stopAtFirstArgument = true)
@derive(cliModule.Command)
local record Run
    --- Optimization level.
    @cli(
        name = "O",
        long = false,
        pattern = "^%-O([0-2])$",
        choices = {"0", "1", "2"},
        display = "-O0, -O1, -O2",
        value = "LEVEL"
    )
    optLevel: string?

    --- Report what the optimizer did and what it declined to do.
    remarks: boolean = false

    --- Only report optimizer decisions for this source file.
    @cli(value = "FILE")
    remarksFor: string?

    --- Write the optimizer's account to a file, build/remarks.json by default.
    @cli(arity = "optionalAttached", constant = "build/remarks.json", value = "PATH")
    remarksOut: string?

    --- Turn off one optimizer pass by stable code.
    @cli(short = "Zno-opt", long = false, arity = "attachedOnly", value = "CODE")
    disabled: {[string]: boolean} = {}

    --- Keep named function identities patchable at poll points.
    watch: boolean = false

    --- Write GPU operation costs and device timestamps to this JSONL file.
    @cli(value = "PATH")
    gpuCosts: string?

    --- Program to compile and run.
    @cli(positional = "FILE")
    file: string

    --- Arguments passed to the program.
    @cli(remainder = true, value = "ARG")
    arguments: {string} = {}

    function run(self): integer
        return run(self)
    end
end

export = {commandType = Run}
