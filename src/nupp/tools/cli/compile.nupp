module nupp.tools.cli.compile

--[[
Parse, check, lower: the sequence `build` and `run` both need.
]]

local diagnosticMod = require("nupp.compiler.diagnostics")
local fs = require("nupp.compiler.fs")

local compile = {}

--- Reads, parses and checks a file, reporting every diagnostic the way the text
--- form reports them. Returns the parse and the source it came from, or nil once
--- what stopped it has been said: a command that inspects a checked tree rather than
--- compiling it starts here, so that it sees the same tree a build would.
---
--- @param collected where a `--json` run gathers the diagnostics instead, the
---   unreadable file included, so nothing is written to stderr
---
--- @param source the file's text, when the caller has already read it
function compile.check(
    path: string,
    env: table,
    opts: {[string]: any}?,
    collected: {any}?,
    source: string?
): (any?, string?)
    local function report(diagnostics: {any}): boolean
        if not collected then
            return diagnosticMod.report(diagnostics)
        end
        local failed = false
        for _, diagnostic in ipairs(diagnostics) do
            collected[#collected + 1] = diagnostic
            failed = failed or diagnosticMod.severityOf(diagnostic) == "error"
        end

        return failed
    end

    local readErr: string? = nil
    if source == nil then
        source, readErr = fs.readFile(path)
    end
    if not source then
        local cliReport = require("nupp.tools.cli.report")
        cliReport.fileFailure(path, readErr, "check that the path exists and is readable", collected)
        return nil
    end
    local result = require("nupp.compiler.syntax.parser").parse(source, path)
    if #result.errors > 0 then
        report(result.errors)
        return nil
    end
    local diags = require("nupp.compiler.check").check(result, path, env, opts)
    if report(diags) then
        return nil
    end

    return result, source
end

--- Compiles a file to a VM image holding its one module. Its imports are left
--- to the runtime loader, which
--- compiles each the same way. Returns nil after the diagnostics that stopped it
--- have been reported.
---
--- An image an earlier process compiled from the same inputs is answered from
--- `nupp.compiler.vm.imagecache` instead, which is what keeps a program that
--- requires a large standard module from checking it again in every run.
---
--- `NUPP_COVERAGE=1` instruments the module, filing its hits under `path`. Such
--- an image is never kept: the cache's key does not
--- distinguish it from an ordinary one.
function compile.image(path: string, env: table, moduleName: string?, collected: {any}?): string?
    local source = fs.readFile(path)
    local covering = os.getenv("NUPP_COVERAGE") == "1"
    local cached = source
        and not covering
        and require("nupp.compiler.vm.imagecache").open(env, path, moduleName, source, {"nupp.tools.cli.compile"})
        or nil
    if cached then
        local image = cached.lookup()
        if image then
            return image
        end
    end
    -- Gathered here when keeping the result, so that whether the check said anything
    -- is known; said afterwards exactly as the check would have said it.
    local diagnostics = collected
    if cached and diagnostics == nil then
        diagnostics = {}
    end
    local before = diagnostics and #diagnostics or 0
    local result = compile.check(path, env, {moduleName = moduleName}, diagnostics, source)
    if diagnostics and collected == nil then
        diagnosticMod.report(diagnostics)
    end
    if result == nil then
        return nil
    end
    local name = moduleName or "main"
    local tree = (result as any).root as table
    -- What the module publishes decides which records its witnesses link.
    tree.vmModuleExports = (result as any).moduleExports

    local image = require("nupp.compiler.vm.lower").emit(
        name,
        {},
        function(candidate: string): string?
            return candidate == name and path or nil
        end,
        function(_: string, _: string): table
            return tree
        end,
        nil,
        nil,
        (env as any).layoutTarget or require("nupp.compiler.targetlayout").hostKey(),
        covering and {
            path = function(candidate: string, _: string): string?
                return candidate == name and path or nil
            end,
            manifests = {},
        } or nil
    )
    if cached and #(diagnostics as {any}) == before then
        cached.store(image)
    end

    return image
end

export = compile
