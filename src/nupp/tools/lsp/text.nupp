module nupp.tools.lsp.text

--[[
Positions, ranges, and edits over a document's bytes.

The protocol counts UTF-16 code units and the lexer counts UTF-8 bytes, so every
position crossing the wire is converted here rather than wherever it happened to
be needed. Incremental edits arrive as replaced ranges, and a reply that says
what changed needs the smallest run of lines that differ.
]]

-- A type and nothing else, so this module loads without the lexer and the
-- command line can convert positions and URIs without paying for the compiler.
const {type Token} = require("nupp.compiler.syntax.lexer")

local text = {}

--- A position as the protocol counts it: zero-based lines, and a character
--- offset in UTF-16 code units rather than the bytes the lexer works in.
type text.Position = {
    line: integer,
    character: integer
}

--- A half-open span between two protocol positions. The end key is quoted
--- because the protocol named it after a Lua keyword.
type text.Range = {
    start: text.Position,
    ["end"]: text.Position
}

--- A run of lines replaced wholesale, where `from`..`to` is a half-open span
--- of the original's 1-based line numbers and `lines` is what takes its place.
type text.Hunk = {
    from: integer,
    to: integer,
    lines: {string}
}

--- The filesystem path a `file:` URI names.
---
--- RFC 8089 spells a local file three ways: with an empty authority
--- (`file:///p`), with `localhost` (`file://localhost/p`), and with no authority
--- at all (`file:/p`). All three name the same path. Any other authority is a
--- host, which a path can only name as a UNC share, `//host/p`. A Windows drive
--- path carries a leading slash in the URI that is not part of the path.
--- Anything that is not a `file:` URI is returned percent-decoded, as the name a
--- client gave a buffer with no file behind it.
function text.uriToPath(uri: string): string
    local rest = uri:match("^[Ff][Ii][Ll][Ee]:(.*)$")
    local path = rest or uri
    if rest then
        local authority, after = rest:match("^//([^/]*)(.*)$")
        if authority then
            local host = authority:lower()
            path = (host == "" or host == "localhost") and after or "//" .. authority .. after
        end
    end
    path = path:gsub("%%(%x%x)", function(hex)
        return string.char(tonumber(hex, 16) or 0)
    end)
    if path:match("^/[A-Za-z]:[/\\]") or path:match("^/[A-Za-z]:$") then
        path = path:sub(2)
    end

    return path
end

--- The `file:` URI for a path, with an empty authority, or the share's host for a
--- UNC path. A Windows path's backslashes are separators; anywhere else a
--- backslash is part of a name and is escaped.
---
--- A relative path has no URI of its own, and a session started against a
--- relative root still names files by one. It is written with no authority,
--- `file:src/main.nupp`, which `uriToPath` reads back unchanged: behind `//` its
--- first segment would read as a host.
function text.pathToUri(path: string): string
    if path:match("^[A-Za-z]:[/\\]") or path:match("^\\\\") then
        path = path:gsub("\\", "/")
    end
    local prefix = path:match("^[A-Za-z]:/") and "/" or ""
    local host, rest = path:match("^//([^/]+)(/.*)$")
    if host then
        prefix, path = "//" .. host, rest
    end
    local encoded = path:gsub("[^%w%-%._~/:]", function(ch)
        return ("%%%02X"):format(ch:byte())
    end)

    local absolute = host or path:sub(1, 1) == "/" or prefix ~= ""

    return (absolute and not host and "file://" or "file:") .. prefix .. encoded
end

function text.readFile(path: string): string?
    local f = io.open(path, "rb")
    if not f then
        return nil
    end
    local source = f:read("*a")
    f:close()

    return source
end

-- LSP positions count UTF-16 code units; lexer offsets count UTF-8 bytes.
function text.utf8Char(source: string, offset: number): integer, integer
    local first = source:byte(offset)
    if not first or first < 0x80 then
        return 1, 1
    end
    local len = first < 0xE0 and 2 or first < 0xF0 and 3 or 4

    return len, len == 4 and 2 or 1
end

-- The line starts of the source most recently asked about. A request such as
-- semantic tokens asks for thousands of positions in one text, and scanning
-- from the first byte each time made that quadratic. One text at a time is
-- enough because a request works over one document.
local cachedSource: string? = nil
local cachedStarts: {integer} = {}

local function startsOf(source: string): {integer}
    if source ~= cachedSource then
        cachedSource, cachedStarts = source, text.lineStarts(source)
    end

    return cachedStarts
end

--- The zero-based line `offset` stands on, and the byte that line starts at.
local function lineOf(starts: {integer}, offset: number): integer, integer
    local low: integer, high: integer = 1, #starts
    while low < high do
        local middle: integer = (low + high + 1) // 2
        if starts[middle] <= offset then
            low = middle
        else
            high = middle - 1
        end
    end

    return low - 1, starts[low]
end

function text.positionAtOffset(source: string, offset: number): text.Position
    local line, pos = lineOf(startsOf(source), offset)
    local character: integer = 0
    while pos < offset and pos <= #source do
        local bytes, units = text.utf8Char(source, pos)
        character, pos = character + units, pos + bytes
    end

    return {line = line, character = character}
end

function text.offsetAtPosition(source: string, target: text.Position): integer?
    local pos = startsOf(source)[target.line + 1]
    if not pos then
        return nil
    end
    local character: integer = 0
    while pos <= #source and source:byte(pos) ~= 10 and source:byte(pos) ~= 13 and character < target.character do
        local bytes, units = text.utf8Char(source, pos)
        character, pos = character + units, pos + bytes
    end

    return pos
end

--- The protocol range covering bytes `from` up to `to` of `source`.
function text.spanRange(source: string, from: number, to: number): text.Range
    return {start = text.positionAtOffset(source, from), ["end"] = text.positionAtOffset(source, to)}
end

function text.tokenRange(source: string, tok: Token): text.Range
    return text.spanRange(source, tok.offset, tok.offset + #tok.text)
end

--- The lines of `text`, each keeping its own line break, so concatenating them
--- reproduces the text exactly, including a final line with no break at all.
---
--- A break is `\n`, `\r\n`, or a lone `\r`: the three the protocol names, and so
--- the three an editor splits a line at.
function text.splitLines(source: string): {string}
    local lines = {}
    local starts = text.lineStarts(source)
    for index = 1, #starts - 1 do
        lines[#lines + 1] = source:sub(starts[index], starts[index + 1] - 1)
    end
    if starts[#starts] <= #source then
        lines[#lines + 1] = source:sub(starts[#starts])
    end

    return lines
end

--- The byte offset each line of `text` starts at, plus one past the end, so a
--- run of lines converts to a span without counting anything twice. Lines end
--- where `splitLines` ends them.
function text.lineStarts(source: string): {integer}
    local starts: {integer} = {1}
    local pos: integer = 1
    while pos <= #source do
        local byte = source:byte(pos)
        if byte == 10 then
            starts[#starts + 1] = pos + 1
        elseif byte == 13 then
            if source:byte(pos + 1) == 10 then
                pos = pos + 1
            end
            starts[#starts + 1] = pos + 1
        end
        pos = pos + 1
    end

    return starts
end

-- How far ahead a resynchronization is looked for before the rest of the file
-- is called one changed run. A formatter's edits are local; a gap wider than
-- this is a rewrite, and describing a rewrite in pieces saves nobody anything.
local RESYNC: integer = 64

--- The runs of lines turning `before` into `after`, as {from, to, lines} where
--- `from`..`to` is a half-open span of `before`'s line numbers.
function text.lineHunks(before: {string}, after: {string}): {text.Hunk}
    local hunks = {}
    local i: integer, j: integer = 1, 1
    while i <= #before or j <= #after do
        if before[i] ~= nil and before[i] == after[j] then
            i, j = i + 1, j + 1
        else
            local skipBefore: integer?, skipAfter: integer? = nil, nil
            for distance = 1, RESYNC do
                for di = 0, distance do
                    local dj = distance - di
                    if before[i + di] ~= nil and before[i + di] == after[j + dj] then
                        skipBefore, skipAfter = di, dj
                        break
                    end
                end
                if skipBefore then
                    break
                end
            end
            if not skipBefore then
                skipBefore, skipAfter = #before - i + 1, #after - j + 1
            end
            local lines = {}
            -- Both skips are set together, so narrowing the first settles the second;
            -- the cast says so where the checker cannot follow the assignment.
            for index = j, j + (skipAfter as integer) - 1 do
                lines[#lines + 1] = after[index]
            end
            hunks[#hunks + 1] = {from = i, to = i + skipBefore, lines = lines}
            i, j = i + skipBefore, j + (skipAfter as integer)
        end
    end

    return hunks
end

export = text
