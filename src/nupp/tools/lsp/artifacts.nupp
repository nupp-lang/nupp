module nupp.tools.lsp.artifacts

--[[
What a source file compiles to, answered for the buffer rather than the file.

Every `.nupp` file is lowered to a VM image, and the instructions in it are
reachable from the command line through `nupp bc`, but only for a file that has
been saved, and only into a terminal that cannot be clicked.

Two requests, for the two costs. `nupp/artifacts` asks what is available at a
position and is answered from the check the session has already done, so a
client may ask it per function on every viewport. `nupp/artifact` resolves one
and lowers the buffer to do it, so a client asks it when somebody opened
something.

Two kinds. `bytecode` is the instructions laid out against the source, line N
holding what line N compiled to. `image` is the module's own text in the image
the VM loads: every function's header, constants, line table and code. Both
carry their correspondence to the source as entries, read from the line table
the lowering records for every instruction.

Only the VM-hosted compiler answers either: the image is what that compiler
produces, so a LuaJIT-hosted session says so rather than guessing.
]]

local text = require("nupp.tools.lsp.text")
local tree = require("nupp.tools.lsp.tree")
local wire = require("nupp.tools.lsp.wire")

local uriToPath = text.uriToPath
local offsetAtPosition = text.offsetAtPosition
local spanRange = text.spanRange

local artifacts = {}

--- What resolution reads of a session: the open documents, and which project root
--- owns the file being asked about.
type artifacts.Session = {
    documents: {[string]: any},
    useRoot: function(path: string?): string,
    currentRoot: string?
}

type artifacts.Api = {
    discover: function(params: any): any,
    resolve: function(params: any): any,
    lenses: function(params: any): any,

    --- Names the client command a lens should carry, or nothing to offer none.
    useInspectCommand: function(command: string?): nil
}

--- The kinds this server can produce. Advertised through experimental capabilities
--- so a client can tell what it may ask for without asking for it.
artifacts.KINDS = {"bytecode", "image"}

const LABELS: {[string]: string} = {bytecode = "Bytecode", image = "VM image",}
const LANGUAGES: {[string]: string} = {bytecode = "nupp-bytecode", image = "nupp-image",}

--- A kind's scope: `module` artifacts are the whole file however the request was
--- positioned, and `function` artifacts are a body.
const SCOPES: {[string]: string} = {bytecode = "module", image = "module",}

--- An artifact that could not be produced, said the same way whatever refused it.
---
--- Every kind has one of these, because every kind can fail for a reason that is
--- not a bug: a file that checks can still fail to lower, and a GPU body can be
--- outside the profile a browser artifact is written for. A client that has to
--- guess from an empty document shows an empty document.
local function unavailable(kind: string, reason: string, detail: string?): any
    return {
        kind = kind,
        available = false,
        label = LABELS[kind] or kind,
        unavailable = {reason = reason, detail = detail},
    }
end

function artifacts.install(s: artifacts.Session): artifacts.Api
    -- The command a lens runs belongs to the client, not to this server: it is
    -- whatever the client registered and told us about at `initialize`. Nothing
    -- is offered until one is named.
    local inspectCommand: string? = nil

    --- The document a request names, with the offset its position falls on.
    local function documentFor(params: any): (string?, any, integer?)
        local uri = params and params.textDocument and params.textDocument.uri
        local doc = uri and s.documents[uri] or nil
        if not doc then
            return uri, nil, nil
        end
        local offset = params.position and offsetAtPosition(doc.text, params.position) or nil

        return uri, doc, offset
    end

    --- Lowers the buffer to a VM image: the entry module's functions, with each
    --- instruction's source line, and the image text they occupy.
    ---
    --- The lowering is given the buffer's text rather than the path, so what opens
    --- is what the editor shows. A fresh environment per resolution is the only
    --- thing that stays correct when a dependency changed under a session that
    --- has been open for a day.
    local function inspect(kind: string, doc: any, path: string): ({any}?, string?, any?)
        if not rawget(_G, "__nupp_load_image") then
            return nil, nil, unavailable(kind, "unsupported-host", "the VM image needs the VM-hosted compiler")
        end
        local ok, functions, image = pcall(
            require("nupp.tools.vm.project").inspect,
            s.currentRoot or ".",
            path,
            doc.text
        )
        if not ok then
            return nil, nil, unavailable(kind, "not-lowered", tostring(functions))
        end

        return functions as {any}, image as string, nil
    end

    local function bytecodeArtifact(doc: any, path: string): any
        local functions, _, refused = inspect("bytecode", doc, path)
        if refused ~= nil then
            return refused
        end
        local count = 0
        for _, fn in ipairs(functions as {any}) do
            count = count + #fn.instructions
        end
        -- Laid out against the source, not beside it: the editor already has the
        -- file in the pane next to this one.
        local rendered, mappings = require("nupp.tools.bytecodelisting").aligned(functions as {any}, doc.text)
        local entries = wire.array({})
        for _, mapping in ipairs(mappings) do
            entries[#entries + 1] = mapping
        end

        return {
            kind = "bytecode",
            available = true,
            label = LABELS.bytecode,
            languageId = LANGUAGES.bytecode,
            text = rendered,
            -- Collapsible rather than plain lines: a source line that compiled
            -- to several instructions keeps the first on its own row and indents
            -- the rest, so the two panes line up once those rows are folded.
            mapping = {kind = "lines-collapsible", entries = entries},
            metadata = {backend = "vm"},
            summary = {functions = #(functions as {any}), instructions = count},
        }
    end

    local function imageArtifact(doc: any, path: string): any
        local functions, image, refused = inspect("image", doc, path)
        if refused ~= nil then
            return refused
        end
        -- Each instruction row of a function's text stands for the line its
        -- line table names; a header stands for where the function starts.
        local entries = wire.array({})
        local fnIndex: integer, pc: integer, generated: integer = 0, 0, 0
        local current: any = nil
        for row in (image as string):gmatch("([^\n]*)\n") do
            generated = generated + 1
            if row:sub(1, 9) == "function " then
                fnIndex = fnIndex + 1
                current = (functions as {any})[fnIndex]
                pc = 0
                local first = current and current.instructions[1]
                if first and (first.line or 0) >= 1 then
                    entries[#entries + 1] = {generatedLine = generated, sourceLine = first.line, role = "derived"}
                end
            elseif current and row:match("^  %u") then
                pc = pc + 1
                local ins = current.instructions[pc]
                if ins and (ins.line or 0) >= 1 then
                    entries[#entries + 1] = {generatedLine = generated, sourceLine = ins.line, role = "exact"}
                end
            end
        end

        return {
            kind = "image",
            available = true,
            label = LABELS.image,
            languageId = LANGUAGES.image,
            text = image,
            mapping = {kind = "lines", entries = entries},
            metadata = {backend = "vm"},
            summary = {functions = #(functions as {any}), lines = generated},
        }
    end

    const BUILDERS: {[string]: function(any, string): any} = {bytecode = bytecodeArtifact, image = imageArtifact,}

    --- Cheap discovery: what a client may ask for here, and what it would be about.
    ---
    --- Nothing is lowered. The function a lens would sit on comes from the function
    --- analysis the ordinary check already produced, which is what makes this
    --- affordable once per function per viewport.
    local function discover(params: any): any
        local uri, doc, offset = documentFor(params)
        if not doc then
            return {artifacts = wire.array({})}
        end
        local functions = doc.result and doc.result.inspectedFunctions or nil
        local selected, from, to = tree.functionAt(functions, offset)
        local aotSymbol: string? = nil
        local aotSource: string? = nil
        if selected ~= nil and selected.body ~= nil and selected.body.aotRequired == true then
            local fs = require("nupp.compiler.fs")
            local path = uriToPath(uri as string)
            local root = fs.absolute(s.useRoot(path))
            local absolute = fs.absolute(path)
            aotSource = absolute:sub(1, #root + 1) == root .. "/" and absolute:sub(#root + 2) or absolute
            local name = selected.node and selected.node.name and selected.node.name.text or selected.inspectName
            local symbol = require("nupp.compiler.aot.scalar").privateSymbol(name)
            aotSymbol = symbol
        end
        local out = wire.array({})
        for _, kind in ipairs(artifacts.KINDS) do
            out[#out + 1] = {kind = kind, label = LABELS[kind], languageId = LANGUAGES[kind], scope = SCOPES[kind],}
        end

        return {
            artifacts = out,
            ["function"] = selected
            and {
                name = selected.inspectName,
                aotSymbol = aotSymbol,
                aotSource = aotSource,
                range = from and to and spanRange(doc.text, from, to as integer) or nil,
            }
            or nil,
        }
    end

    local function resolve(params: any): any
        local uri, doc = documentFor(params)
        local kind = params and params.kind
        if type(kind) ~= "string" or not BUILDERS[kind] then
            return unavailable(tostring(kind), "unknown-kind", "this server produces bytecode and image")
        end
        if not doc then
            return unavailable(kind, "no-document", "the document is not open on this server")
        end
        local path = uriToPath(uri as string)
        s.useRoot(path)
        -- The VM has one lowering, so a client's `optLevel`, which named the Lua
        -- generator's passes, no longer selects anything and is not read.
        local built = assert(BUILDERS[kind])(doc, path)
        built.uri = uri
        built.version = doc.version
        built.id = ("%s|%s"):format(uri, kind)

        return built
    end

    --- One lens per analysed function: `Inspect`, rather than a button per kind.
    ---
    --- A row of buttons would have to be right about which kinds apply before the
    --- work that knows is done, and most of them do not apply to most functions.
    --- A lens that opens what is actually available is O(1) to render and never
    --- offers a dead link.
    local function lenses(params: any): any
        local uri, doc = documentFor(params)
        local out = wire.array({})
        if not doc or inspectCommand == nil then
            return out
        end
        for _, info in ipairs(doc.result and doc.result.inspectedFunctions or {}) do
            local from, to = tree.nodeBounds(info.node)
            if from and to then
                local range = spanRange(doc.text, from, to as integer)
                out[
                    #out + 1
                ] = {
                    range = {start = range.start, ["end"] = range.start},
                    command = {
                        title = "Inspect",
                        command = inspectCommand,
                        arguments = wire.array({
                            {uri = uri, name = info.inspectName, position = range.start, range = range,},
                        }),
                    },
                }
            end
        end

        return out
    end

    local function useInspectCommand(command: string?): nil
        inspectCommand = command
    end

    return {discover = discover, resolve = resolve, lenses = lenses, useInspectCommand = useInspectCommand,}
end

export = artifacts
