module nupp.tools.hotsession

--[[
Persistent compiler-side state for development hot reload.

The session deliberately owns the incremental query graph and advances its
baseline only after the host acknowledges a runtime commit. Modules join that
baseline lazily after their initial chunk has completed successfully.

What it compiles is a VM image per module. A reload lowers a changed module
again and matches its functions to the running ones by identity: lexical
parent, name, and position among same-named siblings. The patch it prepares is
that image behind a map the runtime's `vm.hotPatch` reads, so a matched
function keeps its id and every closure, method and direct call takes the new
body on its next call (`native/crates/vm/src/hotpatch.rs`).
]]

local incremental = require("nupp.compiler.project.incremental")
local diagnostics = require("nupp.compiler.diagnostics")
local buildModules = require("nupp.tools.build.modules")
local hash = require("nupp.compiler.hash")
local cst = require("nupp.compiler.syntax.cst")
local envMod = require("nupp.compiler.project.env")
local lower = require("nupp.compiler.vm.lower")
local fs = require("nupp.compiler.fs")
local cheader = require("nupp.compiler.cinterop.cheader")

local hotSession = {}
local Session = {}
Session.__index = Session

----------------------------------------------------------------------------
-- What a reload decides
----------------------------------------------------------------------------

--- A complete, loadable patch. Nothing in the running process has changed yet.
record hotSession.Prepared
    kind: "prepared"

    --- One patch per changed module, ready for the runtime's `vm.hotPatch`.
    patches: {string}

    --- The generation this was prepared against, and the one committing it produces.
    --- A host that has moved on since must prepare again.
    baseGeneration: integer

    generation: integer
end

--- The candidate did not check. The running generation remains valid.
record hotSession.Rejected
    kind: "diagnostics"
    diagnostics: {any}
end

--- The change is well-typed but outside what a live process can take.
record hotSession.Restart
    kind: "restart-required"
    diagnostics: {any}

    --- Which boundary refused it, where one can be named.
    reason: any
end

--- Nothing an implementation depends on changed, so there is nothing to publish.
record hotSession.Unchanged
    kind: "no-change"
    generation: integer
end

--- What `prepare` returns, discriminated by `kind`.
type hotSession.Result = hotSession.Prepared | hotSession.Rejected | hotSession.Restart | hotSession.Unchanged

--- The entry's image and the manifest describing what it holds.
record hotSession.InitialBuild
    kind: "initial"
    generation: integer

    --- The entry module's VM image, for `__nupp_load_image`.
    entryCode: string

    --- Plain data built from the image and read back by `loaded`. It is not the
    --- compiler's own structures, and typing it here would be claiming a shape the
    --- lowering alone decides.
    entryManifest: any
end

--- A file the session wants to be told about, and why it is watching it.
---
--- `kind` separates project source from the headers and native artifacts a loaded
--- module pulled in, which is what lets a host watch a header without guessing.
type hotSession.WatchedInput = {
    path: string,
    kind: string
}

--- Loader names whose binary identity the session could not pin, reported once each.
type hotSession.Notices = {unverifiedLibraries: {string}}

--- A compiler-side hot reload session, owning one incremental query graph.
---
--- The baseline only advances when the host says a commit landed, so a session and a
--- running process cannot disagree about which generation is live.
record hotSession.Session
    --- The query graph this session owns.
    inc: any

    --- The generation the running process is on.
    generation: integer

    --- Manifests of the modules that have executed and registered, by module name. It
    --- grows as modules load; it is not a claim that every reachable module is
    --- resident.
    running: {[string]: any}

    prepared: {[integer]: any}
    noticedLibraries: {[string]: boolean}
    observedInputs: {[string]: any}
    libraryPaths: {[string]: string}
    libraryConfiguredPaths: {[string]: string}

    --- Forwards a file-watcher event to the query graph. `changeType` is the LSP
    --- code, where 3 means the file was deleted.
    diskChanged: function(self: hotSession.Session, path: string, changeType: integer)

    --- Builds the entry watch artifact, or returns why it could not be built.
    initial: function(self: hotSession.Session, entries: {string}): hotSession.InitialBuild
        | hotSession.Rejected
        | hotSession.Restart

    --- Checks the affected source closure against the running generation.
    prepare: function(self: hotSession.Session, paths: {string}): hotSession.Result

    --- Records that a module executed and registered its slots.
    loaded: function(self: hotSession.Session, module: string, generation: integer, manifest: any): hotSession.Notices

    --- Advances the baseline after the host reports a commit landed.
    committed: function(self: hotSession.Session, generation: integer): hotSession.Notices

    --- Every file this session wants events for.
    watchedInputs: function(self: hotSession.Session): {hotSession.WatchedInput}

    persist: function(self: hotSession.Session): nil
end

----------------------------------------------------------------------------
-- Manifests
----------------------------------------------------------------------------

local function fatalIn(values)
    for _, value in ipairs(values or {}) do
        if diagnostics.isFatal(value) then
            return true
        end
    end

    return false
end

-- Operands that name a function of the same image, by opcode: the position of
-- the function id among the line's words.
local functionOperands = {Call = 2, CallT = 2, CallK = 2, NewClosure = 3}

--- Each function's text in an image, in the image's order, which is the order
--- the lowering numbered them and the runtime loaded them.
local function functionBlocks(image: string): {{string}}
    local blocks: {{string}} = {}
    local current: {string}? = nil
    for line in image:gmatch("[^\n]+") do
        if line:sub(1, 9) == "function " then
            local block: {string} = {line}
            blocks[#blocks + 1] = block
            current = block
        elseif current then
            if line == "end" then
                current = nil
            else
                current[#current + 1] = line
            end
        end
    end

    return blocks
end

local function words(line: string): {string}
    local out: {string} = {}
    for word in line:gmatch("%S+") do
        out[#out + 1] = word
    end

    return out
end

--- A body as the runtime would compare it, with every reference to a function
--- of the same image spelled by identity rather than by id: adding a closure
--- renumbers the functions after it without changing what they do. Source lines
--- are left out; a body that only moved is not a change.
local function implementation(block: {string}, keys: {string}): string
    local parts: {string} = {}
    for index = 2, #block do
        local line = block[index]:gsub("^%s+", "")
        local op = line:match("^%S+")
        if op ~= "lines" and op ~= "source" then
            local position = functionOperands[op]
            if op == "const" and line:match("^const %d+ func ") then
                position = 4
            end
            if position then
                local split = words(line)
                local number = tonumber(split[position])
                local id = number and math.floor(number) or nil
                split[position] = id and keys[id + 1] or split[position]
                line = table.concat(split, " ")
            end
            parts[#parts + 1] = line
        end
    end

    return hash.digest(table.concat(parts, "\n"))
end

--- The manifest of a module's image: every function by identity, with what a
--- live replacement has to keep (signature, captures) and what it may change
--- (implementation), the record layouts it uses, and its top-level chunk.
local function imageManifest(image: string, functions: {any}, module: string, path: string, abi: any): any
    local blocks = functionBlocks(image)
    local keys: {string} = {}
    local seen: {[string]: integer} = {}
    for index, fn in ipairs(functions) do
        local anonymous = tostring(fn.name):match("%.fn%d+$") ~= nil
        local parent: integer? = fn.parent
        local parentKey = parent and keys[parent + 1] or ""
        local prefix = parentKey .. "/" .. (anonymous and "fn" or tostring(fn.name))
        local ordinal = (seen[prefix] or 0) + 1
        seen[prefix] = ordinal
        keys[index] = prefix .. "#" .. ordinal
    end
    local chunk = tonumber(image:match("\nmodule %S+ (%d+)")) or 0
    local entries = {}
    for index, fn in ipairs(functions) do
        local header = words(blocks[index] and blocks[index][1] or "")
        local captures = {}
        for position, name in pairs(fn.captures or {}) do
            captures[position] = name
        end
        entries[index] = {
            index = index - 1,
            key = keys[index],
            name = tostring(fn.name),
            chunk = index - 1 == chunk,
            -- A function declared by the module's top level, as opposed to one a body
            -- declares: adding or removing one of these changes the module's shape.
            declaration = index - 1 == chunk or fn.parent == nil or fn.parent == chunk,
            signature = table.concat({header[4] or "", header[7] or "", header[8] or ""}, " "),
            captures = captures,
            implementation = blocks[index] and implementation(blocks[index], keys) or "",
        }
    end
    local shapes = {}
    for line in image:gmatch("[^\n]+") do
        if line:sub(1, 6) == "shape " then
            shapes[#shapes + 1] = line
        end
    end

    return {
        schema = 2,
        module = module,
        path = path,
        functions = entries,
        shapes = table.concat(shapes, "\n"),
        abi = abi,
        unverifiedLibraries = abi.unverifiedLibraries or {},
    }
end

local function sameCaptures(left, right)
    if #left ~= #right then
        return false
    end
    for index, capture in ipairs(left) do
        if capture ~= right[index] then
            return false
        end
    end

    return true
end

local function indexed(manifest)
    local byKey = {}
    for _, fn in ipairs(manifest.functions or {}) do
        byKey[fn.key] = fn
    end

    return byKey
end

local function restart(path, message, reason)
    local help = "restart the program to apply this structural change"
    if reason and reason.kind == "native-artifact" then
        help = "restart the process; loaded cdata, callbacks, function pointers, and native state cannot be rebound"
    end

    return new hotSession.Restart(
        kind = "restart-required",
        reason = reason,
        diagnostics = {
            {filename = path, line = 1, col = 1, offset = 0, length = 0, code = "NUPP5001", msg = message, help = help,}
        }
    )
end

local function diagnosticsFailure(values)
    return new hotSession.Rejected(kind = "diagnostics", diagnostics = values)
end

----------------------------------------------------------------------------
-- Fingerprints
----------------------------------------------------------------------------

--- C declarations are runtime ABI, including layout, symbol name, and library.
--- Fingerprint their token stream rather than the whole file so an ordinary body edit
--- remains patchable while every declaration change is conservatively restart-only.
local function cdefFingerprint(parsed)
    local parts = {}

    local function wrapsCdef(node)
        while type(node) == "table" and node.kind == "pragmaStmt" do
            node = node.stat
        end
        return type(node) == "table" and (node.kind == "cdefStruct" or node.kind == "cdefFunc")
    end

    local function beginsCdef(node)
        return node.kind == "cdefStruct"
            or node.kind == "cdefFunc"
            or node.cdefDeclarationBlock
            or node.cheaderCdef
            or node.kind == "pragmaStmt" and wrapsCdef(node)
    end

    local function visit(node, inside)
        if type(node) ~= "table" then
            return
        end
        if cst.isToken(node) then
            if inside then
                parts[#parts + 1] = tostring(node.kind) .. ":" .. tostring(node.text)
            end
            return
        end
        local begins = beginsCdef(node)
        local active = inside or begins
        if begins then
            parts[#parts + 1] = "begin:" .. node.kind
            if node.cheaderCdef then
                parts[#parts + 1] = "cheader:" .. tostring(node.cheaderCdef)
            end
        end
        for _, child in ipairs(node) do
            visit(child, active)
        end
        if begins then
            parts[#parts + 1] = "end:" .. node.kind
        end
    end

    visit(parsed and parsed.root, false)

    return table.concat(parts, "\0")
end

--- Checked C declarations keyed independently of source order. Declarations that can
--- execute while the module initializes are retained runtime bindings. Nested ones
--- become relevant only when a retained implementation uses them; an unclassified
--- operation falls back to the old module digest.
local function cDeclarations(parsed)
    local declarations = {}

    local function visit(node, functionDepth)
        if type(node) ~= "table" or cst.isToken(node) then
            return
        end
        local isFunction = node.kind == "localFuncStmt"
            or node.kind == "funcStmt"
            or node.kind == "inlineMethod"
            or node.kind == "funcExpr"
            or node.kind == "shortfn"
        local depth = functionDepth + (isFunction and 1 or 0)
        if (node.kind == "cdefStruct" or node.kind == "cdefFunc") and node.cdefIdentity then
            local prior = declarations[node.cdefIdentity]
            local semantic = node.cdefSemantic or cst.textOf(node):gsub("%s+", "")
            if prior and prior.semantic ~= semantic then
                semantic = prior.semantic .. "\0duplicate\0" .. semantic
            end
            declarations[
                node.cdefIdentity
            ] = {
                identity = node.cdefIdentity,
                semantic = semantic,
                name = node.name and node.name.text or node.cdefIdentity,
                kind = node.kind == "cdefStruct" and "aggregate" or "function",
                runtimeBinding = depth == 0 or prior and prior.runtimeBinding or false,
            }
        end
        for _, child in ipairs(node) do
            visit(child, depth)
        end
    end

    visit(parsed and parsed.root, 0)

    return declarations
end

-- The build's own interface digest, so a change the build would recompile a
-- reader for is one the session restarts for, and nothing less.
local function interfaceFingerprint(moduleType, exports)
    return buildModules.interfaceHash(moduleType, exports, nil)
end

--- The C declarations a module's code refers to, keyed the way `cDeclarations`
--- keys them. A foreign operation the checker could not join to one selects the
--- module-wide comparison instead.
local function applyCUses(snapshot, module: string, parsed: any): nil
    local current = snapshot.modules[module]
    if not current then
        return
    end
    local uses: {[string]: boolean} = {}
    local unknown = false

    local function walk(node)
        if type(node) ~= "table" or cst.isToken(node) then
            return
        end
        if node.cdefIdentity then
            uses[node.cdefIdentity] = true
        elseif node.kind == "name" and node.token and node.token.definition and node.token.definition.cdefIdentity then
            uses[node.token.definition.cdefIdentity] = true
        elseif node.cdefCall or node.cdefDeclarationBlock or node.cheaderCdef then
            unknown = true
        end
        for _, child in ipairs(node) do
            walk(child)
        end
    end

    walk(parsed and parsed.root)
    current.cUses = uses
    current.cUnknown = unknown
end

local function carryCMetadata(previous, candidate)
    for identity, current in pairs(candidate.modules or {}) do
        local old = previous.modules and previous.modules[identity]
        if old then
            current.cUses = current.cUses or old.cUses
            if current.cUnknown == nil then
                current.cUnknown = old.cUnknown
            end
        end
    end
end

----------------------------------------------------------------------------
-- What a change means for a consumer
----------------------------------------------------------------------------

local function cDeclarationChange(old, current)
    local oldDeclarations = old.cDeclarations or {}
    local nextDeclarations = current.cDeclarations or {}
    local oldUses = old.cUses or {}
    local nextUses = current.cUses or oldUses
    -- Identities are strings: a C aggregate's name, or a library and symbol.
    local identities: {[string]: boolean} = {}
    for identity in pairs(oldDeclarations) do
        identities[identity] = true
    end
    for identity in pairs(nextDeclarations) do
        identities[identity] = true
    end
    for identity in pairs(nextUses) do
        local declaration = nextDeclarations[identity] or oldDeclarations[identity]
        if not oldUses[identity] and declaration and not declaration.runtimeBinding then
            return declaration, "new-use"
        end
    end
    local ordered: {string} = {}
    for identity in pairs(identities) do
        ordered[#ordered + 1] = identity
    end
    table.sort(ordered)
    for _, identity in ipairs(ordered) do
        local before, after = oldDeclarations[identity], nextDeclarations[identity]
        local changed = not before or not after or before.semantic ~= after.semantic
        local relevant = before and before.runtimeBinding
            or after and after.runtimeBinding
            or oldUses[identity]
            or nextUses[identity]
        if changed and relevant then
            return before or after, not before and "added" or not after and "removed" or "changed"
        end
    end
    if old.cFingerprint ~= current.cFingerprint and (old.cUnknown or current.cUnknown) then
        return {name = old.label or current.label, identity = "<module-wide C fallback>"}, "fallback"
    end

    return nil
end

local function snapshotChanged(previous, candidate, consumer)
    local function keys(values)
        local out = {}
        for identity in pairs(values or {}) do
            out[#out + 1] = identity
        end
        table.sort(out)

        return out
    end

    local moduleKeys = keys(previous.modules)
    for _, identity in ipairs(keys(previous.inputs)) do
        local old = previous.inputs[identity]
        local current = candidate.inputs[identity]
        if not current or current.fingerprint ~= old.fingerprint then
            local kind = old.binary and "native-artifact"
                or old.kind == "header" and "header-abi"
                or old.kind == "provider-file" and "provider-input"
                or "semantic-input"
            return {
                kind = kind,
                dependencyKind = old.kind,
                dependency = old.display,
                identity = identity,
                path = old.paths and old.paths[1] or nil,
                paths = old.paths,
                consumer = old.consumer,
                binary = old.binary,
            }
        end
    end
    for _, identity in ipairs(moduleKeys) do
        local old = previous.modules[identity]
        local current = candidate.modules[identity]
        local declaration, disposition = current and cDeclarationChange(old, current) or nil
        if declaration then
            return {
                kind = "c-declaration",
                dependencyKind = "C declarations",
                dependency = declaration.name or old.label,
                identity = declaration.identity or identity,
                path = old.path,
                disposition = disposition,
            }
        end
    end
    for _, identity in ipairs(keys(previous.declarations)) do
        local old = previous.declarations[identity]
        local current = candidate.declarations[identity]
        if current and current.fingerprint ~= old.fingerprint then
            return {
                kind = "project-declaration",
                dependencyKind = old.query,
                dependency = old.label,
                identity = identity,
                path = old.paths and old.paths[1] or nil,
                paths = old.paths,
            }
        end
    end

    -- A dependency's changed interface can change the loaded root's inferred
    -- interface too. Name the dependency first; use the root only when it is the
    -- declaration that actually changed.
    for _, identity in ipairs(moduleKeys) do
        local old = previous.modules[identity]
        local current = candidate.modules[identity]
        if identity ~= consumer and current and current.fingerprint ~= old.fingerprint then
            return {
                kind = "module-interface",
                dependencyKind = "module",
                dependency = old.label,
                identity = identity,
                path = old.path,
            }
        end
    end
    local old = previous.modules and previous.modules[consumer]
    local current = candidate.modules and candidate.modules[consumer]
    if old and current and current.fingerprint ~= old.fingerprint then
        return {
            kind = "module-interface",
            dependencyKind = "module",
            dependency = old.label,
            identity = consumer,
            path = old.path,
        }
    end

    return nil
end

local function dependencyChangeMessage(change, consumer, consumerPath)
    local subject
    if change.kind == "c-declaration" then
        subject = "C declarations in module " .. change.dependency
    elseif change.kind == "header-abi" then
        subject = "header " .. change.dependency
    elseif change.kind == "native-artifact" then
        subject = "native artifact for " .. change.dependency
    elseif change.kind == "provider-input" then
        subject = "provider input " .. change.dependency
    elseif change.kind == "module-interface" then
        subject = "module interface " .. change.dependency
    else
        local labels = {
            projectEntries = "project declaration",
            projectPathEntries = "project path declaration",
            projectModulePath = "module resolution",
            projectModuleBasenames = "module basename resolution",
            projectAnnotations = "project annotation",
        }
        subject = (labels[change.dependencyKind] or "semantic dependency") .. " " .. change.dependency
    end
    if change.path then
        subject = subject .. " at " .. change.path
    end
    local required = "required by " .. consumer
    if consumerPath then
        required = required .. " at " .. consumerPath
    end

    return subject .. " changed (" .. required .. ")"
end

----------------------------------------------------------------------------
-- Opening a session
----------------------------------------------------------------------------

--- The native libraries a project pins for reload, canonical and as configured.
---
--- Read here rather than in the session alone, because a component built for reload
--- is generated with the same map: the code a session recompiles has to be the code
--- the component is running, and a pinned library is part of what the generator
--- writes into it.
---
--- @param config the project manifest's table
--- @param rootDir the directory configured paths are relative to
--- @return canonical paths by loader name, and the configured spellings by name
--- @raises string when the `hotreload` section is not the shape it must be
function hotSession.libraries(config: any, rootDir: string): {[string]: string}, {[string]: string}
    local configured = config and config.hotreload
    if configured ~= nil and type(configured) ~= "table" then
        error("hotreload must be a table", 2)
    end
    local libraries = configured and configured.libraries or nil
    if libraries ~= nil and type(libraries) ~= "table" then
        error("hotreload.libraries must be a table of loader names to paths", 2)
    end
    local canonical: {[string]: string} = {}
    local spelled: {[string]: string} = {}
    for name, path in pairs(libraries or {}) do
        if type(name) ~= "string" or name == "" or type(path) ~= "string" or path == "" then
            error("hotreload.libraries must map non-empty string names to non-empty paths", 2)
        end
        local configuredPath = fs.absolute(fs.join(rootDir, path))
        spelled[name] = configuredPath
        canonical[name] = fs.canonical(configuredPath)
    end

    return canonical, spelled
end

function hotSession.new(root: string?, opts: table?): hotSession.Session
    -- `Session` is a plain table of methods used as a metatable, so the claim that
    -- this is a session is made here, once, where the fields below fill it in.
    local self = setmetatable({}, Session) as hotSession.Session
    self.inc = incremental.new(root or ".", opts or {})
    self.generation = 1
    self.running = {}
    self.prepared = {}
    self.noticedLibraries = {}
    self.observedInputs = {}
    self.libraryPaths = {}
    self.libraryConfiguredPaths = {}
    self.libraryPaths, self.libraryConfiguredPaths = hotSession.libraries(self.inc.env.config, self.inc.env.rootDir)

    return self
end

local function stringLiteral(text)
    if type(text) ~= "string" then
        return nil
    end
    return text:match('^"(.*)"$') or text:match("^'(.*)'$") or text:match("^%[=+%[(.*)%]=+%]$")
end

local function nativeUses(parsed)
    local uses = {}

    local function add(name, dynamic, node)
        local first = node and node[1]
        local line = first and cst.isToken(first) and first.line or 1
        uses[#uses + 1] = {name = name, dynamic = dynamic, line = line}
    end

    local function visit(node)
        if type(node) ~= "table" or cst.isToken(node) then
            return
        end
        if (node.kind == "cdefFunc" or node.kind == "cdefStruct") and node.fromLib then
            add(stringLiteral(node.fromLib.text), false, node)
        elseif node.cheaderLib then
            add(node.cheaderLib, false, node)
        elseif node.ffiLoadLib then
            add(node.ffiLoadLib, false, node)
        elseif node.ffiLoadDynamic then
            add(nil, true, node)
        end
        for _, child in ipairs(node) do
            visit(child)
        end
    end

    visit(parsed and parsed.root)

    return uses
end

local function addInput(snapshot, input, module)
    local identity = input.identity .. "\0consumer=" .. module .. "\0" .. tostring(input.consumer or "")
    snapshot.inputs[identity] = input
end

----------------------------------------------------------------------------
-- Compiling one file
----------------------------------------------------------------------------

function Session:diskChanged(path, changeType)
    self.inc.diskChanged(path, changeType)
end

--- Capture every semantic boundary the loaded module was checked against. New
--- dependencies and dependencies removed by a body edit do not invalidate the
--- generation; a retained dependency changing its meaning does.
function Session:semanticSnapshot(path, checked, module)
    local snapshot = {modules = {}, declarations = {}, inputs = {}, unverifiedLibraries = {}}
    local visited = {}

    local function visit(currentPath, currentChecked, currentModule)
        if visited[currentPath] then
            return true
        end
        visited[currentPath] = true

        local result = currentChecked or self.inc.checkFile(currentPath)
        if fatalIn(result.diags) then
            return nil, diagnosticsFailure(result.diags)
        end
        local cFingerprint = cdefFingerprint(result.result)
        local declarations = cDeclarations(result.result)
        snapshot.modules[
            currentModule
        ] = {
            fingerprint = interfaceFingerprint(result.moduleType, result.exports),
            label = currentModule,
            path = currentPath,
            cFingerprint = cFingerprint,
            cDeclarations = declarations,
        }
        for _, input in ipairs(result.result and result.result.externalInputs or {}) do
            addInput(snapshot, input, currentModule)
        end
        for _, use in ipairs(nativeUses(result.result)) do
            local name = use.name
            local mapped = name and self.libraryPaths[name] or nil
            if mapped then
                local configuredPath = self.libraryConfiguredPaths[name]
                local resolved = fs.canonical(configuredPath)
                local bytes = self.inc.externalFile(configuredPath)
                if resolved ~= configuredPath then
                    self.inc.externalFile(resolved)
                end
                if mapped ~= configuredPath and mapped ~= resolved then
                    self.inc.externalFile(mapped)
                end
                local paths = {configuredPath}
                if resolved ~= configuredPath then
                    paths[#paths + 1] = resolved
                end
                if mapped ~= configuredPath and mapped ~= resolved then
                    paths[#paths + 1] = mapped
                end
                addInput(
                    snapshot,
                    {
                        identity = "native-artifact\0" .. name,
                        kind = "native-artifact",
                        display = name,
                        paths = paths,
                        fingerprint = hash.digest(
                            table.concat(
                                {
                                    "native-artifact-v1",
                                    configuredPath,
                                    mapped,
                                    resolved,
                                    tostring(require("nupp.compiler.targetlayout").hostKey()),
                                    bytes and ("present\0" .. bytes) or "missing",
                                },
                                "\0"
                            )
                        ),
                        consumer = currentModule .. ":" .. tostring(use.line),
                        binary = true,
                    },
                    currentModule
                )
            else
                local label = use.dynamic and "<dynamic ffi.load>" or tostring(name)
                snapshot.unverifiedLibraries[label] = true
            end
        end
        for _, dependency in ipairs(self.inc.projectDependencies(currentPath)) do
            -- Inferred callable facts trigger checking, but are not runtime ABI.
            -- A changed body remains patchable when the rechecked callers accept it.
            local implementation = dependency.name == "moduleCallGuarantees"
                or dependency.name == "moduleCallGuarantee"
                or dependency.name == "moduleCallableFact"
            if not implementation then
                local identity = dependency.name .. "\0" .. tostring(dependency.key)
                snapshot.declarations[
                    identity
                ] = {
                    fingerprint = dependency.fingerprint,
                    label = tostring(dependency.key),
                    query = dependency.name,
                    paths = self.inc.projectDependencyPaths(dependency.name, dependency.key),
                }
            end
        end
        for _, dependency in ipairs(self.inc.moduleDependencies(currentPath)) do
            local dependencyPath = self.inc.modulePath(dependency)
            if dependencyPath then
                local ok, failure = visit(dependencyPath, nil, dependency)
                if not ok then
                    return nil, failure
                end
            else
                local bundled = self.inc.env.bundled and self.inc.env.bundled[dependency]
                if bundled then
                    snapshot.modules[
                        dependency
                    ] = {fingerprint = interfaceFingerprint(bundled.type, bundled.exports), label = dependency,}
                end
            end
        end

        return true
    end

    local ok, failure = visit(path, checked, module)
    if not ok then
        return nil, failure
    end

    for identity, input in pairs(snapshot.inputs) do
        self.observedInputs[identity] = input
    end

    return snapshot
end

--- Checks and lowers one module to its VM image, with the manifest a later
--- reload compares against.
function Session:compile(path, module)
    local checked = self.inc.checkFile(path)
    if fatalIn(checked.diags) then
        return nil, diagnosticsFailure(checked.diags)
    end
    -- A file the checker could not read leaves no tree and says nothing, because
    -- nothing reached the point where a diagnostic has a source to point into. The
    -- session has to answer anyway, and a host driving it has only what it answers.
    if not checked.result then
        return nil, diagnosticsFailure({
            {
                filename = path,
                line = 1,
                col = 1,
                offset = 0,
                length = 0,
                code = "NUPP0001",
                msg = "cannot read " .. path,
                help = "check the path, and that the file is readable from the project root",
            }
        })
    end
    local abi, abiFailure = self:semanticSnapshot(path, checked, module)
    if not abi then
        return nil, abiFailure
    end
    applyCUses(abi, module, checked.result)
    local tree = checked.result.root
    -- A pinned loader name loads the exact file the session observes. The tree is
    -- the query graph's, so the library operands are swapped for this lowering only.
    local pinned: {any} = {}

    local function pin(node)
        if type(node) ~= "table" or cst.isToken(node) then
            return
        end
        if node.kind == "cdefFunc" or node.kind == "cdefStruct" then
            local name = node.fromLib and stringLiteral(node.fromLib.text)
            local path = name and self.libraryPaths[name]
            if path then
                pinned[#pinned + 1] = {node = node, token = node.fromLib}
                local token = {}
                for key, value in pairs(node.fromLib) do
                    token[key] = value
                end
                token.value = path
                node.fromLib = token
            end
        end
        for _, child in ipairs(node) do
            pin(child)
        end
    end

    pin(tree)
    -- What the module publishes decides which records its witnesses link.
    tree.vmModuleExports = checked.result.moduleExports
    local functions = {}
    local lowered, image = pcall(
        lower.emit,
        module,
        {},
        function(candidate: string): string?
            return candidate == module and path or nil
        end,
        function(_: string, _: string): table
            return tree
        end,
        nil,
        nil,
        self.inc.env.layoutTarget or require("nupp.compiler.targetlayout").hostKey(),
        nil,
        nil,
        functions
    )
    for _, swapped in ipairs(pinned) do
        swapped.node.fromLib = swapped.token
    end
    if not lowered then
        return nil, diagnosticsFailure({
            {
                filename = path,
                line = 1,
                col = 1,
                offset = 0,
                length = 0,
                code = "NUPP0001",
                msg = "cannot lower " .. module .. " for the VM: " .. tostring(image),
                help = "this is a compiler defect; the running generation is unchanged",
            }
        })
    end

    return {code = image, manifest = imageManifest(image, functions, module, path, abi)}
end

function Session:initial(entries)
    local path = entries and entries[1]
    if not path then
        error("hot reload initial build needs one entry", 2)
    end
    local module = envMod.moduleNameForPath(self.inc.env, path) or path
    local built, failure = self:compile(path, module)
    if not built then
        return failure
    end

    return {kind = "initial", generation = self.generation, entryCode = built.code, entryManifest = built.manifest,}
end

function Session:loaded(module, generation, manifest)
    if generation ~= self.generation then
        error("hot reload loaded acknowledgement names an unknown generation", 2)
    end
    if self.running[module] then
        error("hot reload module " .. module .. " was acknowledged twice", 2)
    end
    if type(manifest) ~= "table" or manifest.schema ~= 2 or manifest.module ~= module then
        error("hot reload loaded acknowledgement has a mismatched manifest", 2)
    end
    self.running[module] = manifest
    self.observedInputs = {}

    return self:unverifiedNotices({[module] = manifest})
end

function Session:unverifiedNotices(manifests)
    local notices = {}
    for _, manifest in pairs(manifests or {}) do
        for name in pairs(manifest.unverifiedLibraries or {}) do
            if not self.noticedLibraries[name] then
                self.noticedLibraries[name] = true
                notices[#notices + 1] = name
            end
        end
    end
    table.sort(notices)

    return {unverifiedLibraries = notices}
end

function Session:watchedInputs()
    local byPath: {[string]: hotSession.WatchedInput} = {}
    for _, path in ipairs(envMod.listProjectFiles(self.inc.env)) do
        byPath[path] = {path = path, kind = "source"}
    end
    for _, manifest in pairs(self.running) do
        for _, input in pairs(manifest.abi and manifest.abi.inputs or {}) do
            for _, path in ipairs(input.paths or {}) do
                local prior = byPath[path]
                if not prior or input.binary then
                    byPath[path] = {path = path, kind = tostring(input.kind)}
                end
            end
        end
    end
    for _, input in pairs(self.observedInputs) do
        for _, path in ipairs(input.paths or {}) do
            local prior = byPath[path]
            if not prior or input.binary then
                byPath[path] = {path = path, kind = tostring(input.kind)}
            end
        end
    end
    local out = {}
    for _, input in pairs(byPath) do
        out[#out + 1] = input
    end
    table.sort(out, function(left, right)
        return left.path < right.path
    end)

    return out
end

----------------------------------------------------------------------------
-- Preparing a generation
----------------------------------------------------------------------------

function Session:prepare(paths)
    self.observedInputs = {}
    local patches, candidate = {}, {}
    for module, manifest in pairs(self.running) do
        candidate[module] = manifest
    end
    -- Revalidate every loaded root. Query validation follows cached dependency edges;
    -- only invalidated dependants run their type checks again.
    local loaded: {string} = {}
    for module in pairs(self.running) do
        loaded[#loaded + 1] = module
    end
    table.sort(loaded)
    -- A changed declaration cannot safely be fed back into the process-global C
    -- registry merely to discover that it differs. Fingerprint retained headers first;
    -- comments fall through to the checker, while ABI drift stops before redeclaration.
    for _, module in ipairs(loaded) do
        local live = self.running[module]
        for _, input in pairs(live.abi and live.abi.inputs or {}) do
            if input.kind == "header" then
                local observed = cheader.provenance(input.sourcePath or input.paths[1], {preprocess = input.preprocess})
                if observed and observed.semanticFingerprint ~= input.fingerprint then
                    local change = {
                        kind = "header-abi",
                        dependencyKind = "header",
                        dependency = input.display,
                        identity = input.identity,
                        path = input.paths[1],
                        paths = input.paths,
                        consumer = input.consumer or module,
                    }
                    return restart(live.path, dependencyChangeMessage(change, module, live.path), change)
                end
            end
        end
    end
    for _, module in ipairs(loaded) do
        local live = self.running[module]
        local checked = self.inc.checkFile(live.path)
        if fatalIn(checked.diags) then
            return diagnosticsFailure(checked.diags)
        end
        local abi, failure = self:semanticSnapshot(live.path, checked, module)
        if not abi then
            return failure
        end
        local change = snapshotChanged(live.abi or {}, abi, module)
        if change then
            change.consumer = module
            change.consumerPath = live.path
            return restart(live.path, dependencyChangeMessage(change, module, live.path), change)
        end
        carryCMetadata(live.abi or {}, abi)
        local refreshed = {}
        for key, value in pairs(live) do
            refreshed[key] = value
        end
        refreshed.abi = abi
        refreshed.unverifiedLibraries = abi.unverifiedLibraries or {}
        candidate[module] = refreshed
    end
    local changedCount = 0
    for _, path in ipairs(paths or {}) do
        local module = envMod.moduleNameForPath(self.inc.env, path) or path
        local live = self.running[module]
        if live then
            local compiled, failure = self:compile(path, module)
            if not compiled then
                return failure
            end
            local nextManifest = compiled.manifest
            local abiChange = snapshotChanged(live.abi or {}, nextManifest.abi or {}, module)
            if abiChange then
                abiChange.consumer = module
                abiChange.consumerPath = path
                return restart(path, dependencyChangeMessage(abiChange, module, path), abiChange)
            end

            local function refuse(message: string, kind: string, dependency: string): hotSession.Restart
                return restart(path, message, {kind = kind, dependency = dependency, path = path, consumer = module})
            end

            if live.shapes ~= nextManifest.shapes then
                return refuse("record layout changed in " .. module, "record-layout", module)
            end
            local oldByKey, nextByKey = indexed(live), indexed(nextManifest)
            -- The runtime's map: each new function's position in the running list.
            local map: {string} = {}
            local changed = 0
            -- A declaration added or removed is named before the top level it changes.
            for _, fn in ipairs(nextManifest.functions) do
                if fn.declaration and not fn.chunk and not oldByKey[fn.key] then
                    return refuse("reloadable declaration was added: " .. fn.name, "reloadable-declaration", fn.name)
                end
            end
            for _, old in ipairs(live.functions or {}) do
                if old.declaration and not old.chunk and not nextByKey[old.key] then
                    return refuse("reloadable declaration changed: " .. old.name, "reloadable-declaration", old.name)
                end
            end
            for index, fn in ipairs(nextManifest.functions) do
                local old = oldByKey[fn.key]
                map[index] = old and tostring(old.index) or "-"
                if not old then
                    if fn.chunk then
                        return refuse("top-level structure changed in " .. module, "source-structure", module)
                    end
                elseif fn.chunk ~= old.chunk or old.chunk and fn.implementation ~= old.implementation then
                    return refuse("top-level structure changed in " .. module, "source-structure", module)
                elseif fn.signature ~= old.signature then
                    return refuse("callable signature changed: " .. fn.name, "callable-abi", fn.name)
                elseif not sameCaptures(old.captures, fn.captures) then
                    return refuse("captured bindings changed: " .. fn.name, "capture-set", fn.name)
                elseif fn.implementation ~= old.implementation then
                    changed = changed + 1
                end
            end
            if changed > 0 then
                patches[
                    #patches + 1
                ] = "patch " .. module .. "\nmap " .. table.concat(map, " ") .. "\n" .. compiled.code
                changedCount = changedCount + changed
            end
            if changed > 0 then
                candidate[module] = nextManifest
            end
        end
    end
    if changedCount == 0 then
        self.running = candidate
        self.observedInputs = {}
        return new hotSession.Unchanged(kind = "no-change", generation = self.generation)
    end
    -- Integer arithmetic widens, so the sum is narrowed back where it is bound
    -- rather than at each of the two places the record wants an integer.
    local generation = (self.generation + 1) as integer
    local result = new hotSession.Prepared(
        kind = "prepared",
        patches = patches,
        baseGeneration = self.generation,
        generation = generation
    )
    self.prepared[generation] = {result = result, manifests = candidate}

    return result
end

function Session:committed(generation)
    local pending = self.prepared[generation]
    if not pending or generation ~= self.generation + 1 then
        error("hot reload commit acknowledgement is unknown or stale", 2)
    end
    self.generation = generation
    self.running = pending.manifests
    self.prepared = {}
    self.observedInputs = {}

    return self:unverifiedNotices(self.running)
end

function Session:persist()
    self.inc.persist()
end

export = hotSession
