module nupp.tools.vm.root

export function main(argv: {string}): integer
    require("nupp.compiler.syntax.triviaarena").install(require("nupp.compiler.syntax.triviaarena.table"))
    require("nupp.compiler.vm.chunks").install()
    -- The VM's carried resources; a host without them, as the native core is,
    -- reads the checkout's (`nupp.compiler.bundled`).
    package.preload["nupp.embedded"] = function(): any
        -- Required by its literal name, which is how the VM finds them.
        local found, resources = pcall(function(): any
            return require("nupp.vm.cliResources")
        end)
        return found and resources or nil
    end

    return require("nupp.tools.cli").main(argv)
end
