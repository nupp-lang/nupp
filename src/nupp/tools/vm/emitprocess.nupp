module nupp.tools.vm.emitprocess

local host = require("nupp.vm.process")
local emitprocess = {}

const READ_BYTES = 65536
const WAIT_MS = 5

function emitprocess.start(args: {string}, options: any): (any, any)
    local handle, input, output, errors, _, failure = host.spawn({
        args = args,
        cwd = options.cwd,
        env = options.env,
        stdin = "null",
        stdout = "pipe",
        stderr = "pipe",
    })
    if handle == nil then
        return nil, failure
    end
    local child: any = {}
    local exit: integer? = nil
    local closed = false

    local function reader(stream: any): any
        return {
            poll = function(_: any, count: integer?, milliseconds: number?): string?
                if milliseconds and milliseconds > 0 then
                    host.waitReady({child = handle, read = {stream}, write = {}} as any, milliseconds)
                end
                local text = host.read(stream, count or READ_BYTES)

                return text ~= "" and text or nil
            end
        }
    end

    child.stdout, child.stderr = reader(output), reader(errors)

    function child:isrunning(): boolean
        if exit == nil then
            exit = host.poll(handle)
        end

        return exit == nil
    end

    function child:wait(): any
        while child:isrunning() do
            host.waitReady({child = handle, read = {}, write = {}} as any, WAIT_MS)
        end

        return {exitcode = exit}
    end

    function child:kill(force: boolean?): nil
        host.kill(handle, force == true)
    end

    function child:close(): nil
        if closed then
            return
        end
        if input then
            host.closeStream(input)
        end
        host.closeStream(output)
        host.closeStream(errors)
        if child:isrunning() then
            child:kill(true)
            child:wait()
        end
        local released, problem = host.reap(handle)
        assert(released, problem)
        closed = true
    end

    return child
end

export = emitprocess
