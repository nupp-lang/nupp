module nupp.tools.vm.emitparallel

local fs = require("nupp.compiler.fs")
local fingerprint = require("nupp.compiler.project.fingerprint")
local process = require("nupp.tools.vm.emitprocess")

local emitparallel = {}

const MAX_JOBS = 4
const READ_BYTES = 65536
const WAIT_MS = 5
const TIMEOUT_SECONDS = 120
const PROFILE_VARIABLE = "NUPP_VM_EMIT_PROFILE"
const GROUPS = {
    {"nupp.compiler.clif.lower", "nupp.compiler.clif.guest"},
    {"nupp.tools.lsp"},
    {"nupp.tools.build.project"},
    {"nupp.tools.doc"},
}

function emitparallel.jobs(requested: number?): integer
    return math.max(1, math.min(MAX_JOBS, math.floor(requested or 1))) as integer
end

function emitparallel.prepare(root: string, cache: string, count: integer, common: function(string): nil): {string}
    local selected = fs.readFile(root .. "/.nupp/vm-cli/current")
    local identity = rawget(_G, "__nupp_image_identity")
    if selected == nil or identity == nil or os.getenv("NO_AOT") ~= nil then
        return {}
    end
    local generation = selected:match("^(%x+)%s*$")
    if generation == nil or #generation ~= 64 then
        return {}
    end
    local package = root .. "/.nupp/vm-cli/" .. generation
    local image = fs.readFile(package .. "/compiler.image")
    if image == nil or fingerprint.contentDigest()(image) ~= identity() then
        return {}
    end
    local profiling = os.getenv(PROFILE_VARIABLE) ~= nil
    local shared = cache .. "/shards/common"
    local commonStarted = os.time()
    common(shared)
    if profiling then
        io.stderr:write(("parallel emit: common phase %ds wall\n"):format(os.time() - commonStarted))
    end
    collectgarbage()
    local imports = {shared}
    local children: {any} = {}
    local opened: {number} = {}
    local started = os.time()

    local function finish(force: boolean?): nil
        local failure: any = nil
        for _, child in ipairs(children) do
            local stopped, problem = pcall(function(): nil
                if force and child:isrunning() then
                    child:kill(true)
                end
            end)
            local closed, closeProblem = pcall(function(): nil
                child:close()
            end)
            if failure == nil then
                failure = not stopped and problem or not closed and closeProblem or nil
            end
        end
        if failure ~= nil then
            error(failure, 0)
        end
    end

    local ok, problem = pcall(function()
        for index = 1, count do
            local modules: {string} = {}
            for group = index, #GROUPS, count do
                for _, name in ipairs(GROUPS[group]) do
                    modules[#modules + 1] = name
                end
            end
            local dir = cache .. "/shards/" .. tostring(index)
            assert(fs.mkdir(dir))
            imports[#imports + 1] = dir
            local entry = assert(table.remove(modules, 1))
            local child, failure = process.start(
                {
                    package .. "/runtime",
                    "run",
                    package .. "/compiler.image",
                    "nupp.tools.vm.project",
                    "emit",
                    root,
                    entry,
                    table.concat(modules, ","),
                    "--output",
                    dir .. "/output.image",
                },
                {
                    cwd = root,
                    env = {
                        NUPP_VM_EMIT_JOBS = "1",
                        NUPP_VM_EMIT_CACHE = dir,
                        NUPP_VM_EMIT_IMPORTS = shared,
                        NUPP_COMPILER_ROOT = root,
                    }
                }
            )
            if child == nil then
                error(tostring(failure), 0)
            end
            children[#children + 1] = child
            opened[#children] = os.time()
        end
        local pending = #children
        local done: {[integer]: boolean} = {}
        while pending > 0 do
            for index, child in ipairs(children) do
                for _, stream in ipairs({child.stdout, child.stderr}) do
                    while true do
                        local chunk = stream:poll(READ_BYTES)
                        if chunk == nil then
                            break
                        end
                        io.stderr:write(chunk)
                    end
                end
                if not done[index] and not child:isrunning() then
                    local exit = child:wait()
                    if exit.exitcode ~= 0 then
                        error("parallel emit worker " .. tostring(index) .. " exited " .. tostring(exit.exitcode), 0)
                    end
                    done[index] = true
                    pending = pending - 1
                    if profiling then
                        io.stderr:write(
                            ("parallel emit: worker %d %ds wall\n"):format(index, os.time() - opened[index])
                        )
                    end
                elseif not done[index] then
                    local chunk = child.stderr:poll(READ_BYTES, WAIT_MS)
                    if chunk ~= nil then
                        io.stderr:write(chunk)
                    end
                end
            end
            if os.time() - started > TIMEOUT_SECONDS then
                error("parallel emit workers exceeded the development-loop limit", 0)
            end
        end
    end)
    local closed, closeProblem = pcall(finish, not ok)
    if not ok then
        error(problem, 0)
    end
    if not closed then
        error(closeProblem, 0)
    end

    return imports
end

export = emitparallel
