module nupp.tools.vm.project

local parser = require("nupp.compiler.syntax.parser")
local checkMod = require("nupp.compiler.check")
local envMod = require("nupp.compiler.project.env")
local fs = require("nupp.compiler.fs")
local triviaarena = require("nupp.compiler.syntax.triviaarena")
local tableProvider = require("nupp.compiler.syntax.triviaarena.table")
local lower = require("nupp.compiler.vm.lower")
local chunks = require("nupp.compiler.vm.chunks")

local project = {}

local function names(csv: string?): {string}
    local out: {string} = {}
    for name in (csv or ""):gmatch("[^,]+") do
        out[#out + 1] = name
    end

    return out
end

-- Modules the VM itself supplies at run time, which an image never carries.
local HOST_MODULES: {
    [string]: boolean
} = {
    ["nupp.vm.tasks"] = true,
    ["nupp.simd"] = true,
    ["nupp.runtime.provider.nativestorage"] = true,
    ["nupp.runtime.provider.nativeuuid"] = true,
    ["nupp.runtime.provider.nativecrypto"] = true,
    ["nupp.vm.clock"] = true,
    ["nupp.vm.crc"] = true,
    ["nupp.vm.coroutine"] = true,
    ["nupp.cli.internal.terminalhost"] = true,
    ["nupp.tools.build.clockhost"] = true,
    ["nupp.compiler.hostpid"] = true,
    ["nupp.compiler.nativehash"] = true,
    ["nupp.compiler.nativecdecl"] = true,
    ["nupp.vm.files"] = true,
    ["nupp.vm.compression"] = true,
    ["nupp.vm.net"] = true,
    ["nupp.vm.http"] = true,
    ["nupp.vm.uri"] = true,
    ["nupp.vm.regex"] = true,
    ["nupp.vm.markdown"] = true,
    ["nupp.digest.internal.sha256"] = true,
}

-- The runtime facility each VM-supplied module needs linked in. A program's
-- runtime links only the ones its image asks for.
local FACILITIES: {
    [string]: string
} = {
    ["nupp.vm.compression"] = "compression",
    ["nupp.vm.net"] = "net",
    ["nupp.vm.http"] = "http",
    ["nupp.vm.uri"] = "http",
    ["nupp.vm.regex"] = "regex",
    ["nupp.vm.markdown"] = "markdown",
    ["nupp.compiler.nativecdecl"] = "c-headers",
}

-- Providers the source tree spells once for both runtimes: they reach the
-- native library only through modules the VM replaces beneath them, so the
-- VM takes them where it would otherwise take only its own.
local PORTABLE_PROVIDERS: {[string]: boolean} = {["nupp.runtime.provider.nativehttp"] = true}

--- Where an image finds `name`, the rule every VM image builder shares: the
--- VM's own implementations first, the modules the VM supplies left to run
--- time, the browser runtime never. A soft dependency (a provider chosen at run
--- time) is taken only where the VM supplies its own implementation of it.
function project.resolve(env: table, compilerRoot: string, name: string, soft: boolean?): string?
    if soft then
        local path = envMod.findRuntimeModulePath(env as any, name)
        local vmLib = compilerRoot .. "/native/crates/vm/lib/"
        if PORTABLE_PROVIDERS[name] then
            return path
        end
        return path ~= nil and path:sub(1, #vmLib) == vmLib and path or nil
    end
    if name == "nupp.vm.taskScope" then
        -- Reuse the public implementation under a private link name.
        -- Its source identity remains nupp.tasks for checker call rules.
        return compilerRoot .. "/src/nupp/tasks.nupp"
    elseif name == "nupp.generator" then
        return compilerRoot .. "/native/crates/vm/lib/nupp/generator.nupp"
    elseif name == "nupp.tasks" then
        return compilerRoot .. "/native/crates/vm/lib/nupp/tasks.nupp"
    elseif name == "nupp.tools.bytecodecache" then
        return compilerRoot .. "/native/crates/vm/lib/nupp/tools/bytecodecache.nupp"
    end
    if HOST_MODULES[name] or name:find("^nupp%.runtime%.browser%.") then
        return nil
    end

    return envMod.findRuntimeModulePath(env as any, name)
end

--- An image's quoted text: every byte outside printable ASCII, a quote and a
--- backslash as a three-digit decimal escape, which the runtime's loader reads.
local function quoted(text: string): string
    local escaped = text:gsub('[%c"\\\128-\255]', function(c: string): string
        return ("\\%03d"):format(c:byte())
    end)

    return '"' .. escaped .. '"'
end

--- The declaration of `name` when it is a native extension's: a `.d.nupp`
--- with no implementation beside it whose text names its library with
--- `@extension`. The image carries it, so the runtime can check the library
--- against what the program was checked with before loading it.
local function extensionDeclaration(env: table, name: string): string?
    local path = envMod.findModulePath(env as any, name)
    if path == nil or path:sub(-7) ~= ".d.nupp" then
        return nil
    end
    local text = fs.readFile(path)
    if text == nil or not text:find("@extension%s") then
        return nil
    end

    return text
end

--- Check and lower `entry` and what it reaches under `config`, the manifest
--- the project's modules resolve through. `carried` names modules whose
--- source is generated data rather than a file: parsed, never checked.
--- `sources` names the files a build compiled for modules, its generated
--- ones among them, which resolve as those files.
--- `cacheDir`, when given, is where per-module lowering is kept for the next
--- emit and found from the last (`nupp.tools.vm.emitcache`).
--- @raises string when a source cannot be read, checked or lowered.
local function emitProject(
    root: string,
    config: table,
    entry: string,
    extras: {string},
    hostBootstrap: boolean?,
    carried: {[string]: string}?,
    reached: {[string]: boolean}?,
    coverage: lower.CoverageRequest?,
    cacheDir: string?,
    sources: {[string]: string}?
): string
    if not hostBootstrap then
        triviaarena.installDefault(tableProvider)
    end
    chunks.install()
    local env = envMod.new(root, {
        cache = false,
        nativeCompilerServices = false,
        compilerServices = not hostBootstrap and require("nupp.compiler.hostservices") or nil,
        config = config,
    })

    -- These declarations describe the modules this VM host supplies, rather
    -- than the LuaJIT-backed library implementations in the source checkout.
    local compilerRoot = assert(envMod.compilerRoot(), "compiler source root unavailable")
    table.insert(assert(env.roots), 1, compilerRoot .. "/native/crates/vm/lib")
    table.insert(assert(env.roots), 1, compilerRoot .. "/native/crates/vm/decls")
    -- A separate project still executes the compiler-carried library sources.
    -- Keep project roots first so an explicitly supplied module wins. They are
    -- the library a LuaJIT build finds by name, not the project's own files, so
    -- the project index is made before they join: indexing them read the whole
    -- compiler checkout, eleven seconds of a hello world's build.
    envMod.ensureProjectIndex(env)
    -- A module a build generated (a C binding, the SPI index) lives under the
    -- build's output rather than an include root; its root joins the project's.
    for name, path in pairs(sources or {}) do
        local stem = (path:match("^(.*)%.[^./]+$") or path):gsub("/init$", "")
        local relative = "/" .. name:gsub("%.", "/")
        local base = stem:sub(-#relative) == relative and stem:sub(1, #stem - #relative) or nil
        local known = false
        for _, existing in ipairs(assert(env.roots)) do
            known = known or existing == base
        end
        if base and not known then
            table.insert(assert(env.roots), 3, base)
        end
    end
    table.insert(assert(env.roots), compilerRoot .. "/src")
    env.managedCoroutines = true
    -- The VM coroutine surface participates in ordinary affine cleanup.
    env.globals["coroutine"].t = assert(envMod.resolveModule(env, "nupp.vm.ownedCoroutine"))

    -- What an earlier emit lowered and nothing it read has changed since is
    -- replayed rather than checked and lowered again (`nupp.tools.vm.emitcache`).
    local started = os.time()
    local cache: any = cacheDir and require("nupp.tools.vm.emitcache").open(cacheDir as string, env, config, carried)
        or nil

    local extensions: {[string]: string} = {}
    local looked: {[string]: boolean} = {}

    local function checked(name: string, path: string): table
        local data = carried and carried[name]
        if data then
            local parsed = parser.parse(data, path)
            assert(#parsed.errors == 0, "carried module " .. name .. " did not parse")
            return parsed.root
        end
        local source = assert(fs.readFile(path), "cannot read " .. path)
        local parsed = parser.parse(source, path)
        assert(#parsed.errors == 0, "parse failed: " .. path)
        local ok, diagnostics = pcall(checkMod.check, parsed, path, env as any, {})
        if not ok then
            error("check failed: " .. name .. " (" .. path .. "): " .. tostring(diagnostics), 0)
        end
        for _, d in ipairs(diagnostics) do
            if d.severity == "error" or not d.severity then
                error(
                    name .. ":" .. tostring(
                        d.line
                    ) .. ":" .. tostring(d.col) .. ": " .. tostring(d.code) .. " " .. tostring(d.msg)
                )
            end
        end
        -- What the module publishes decides which records its witnesses link.
        (parsed.root as any).vmModuleExports = (parsed as any).moduleExports

        return parsed.root
    end

    local ok, image = pcall(
        lower.emit,
        entry,
        extras,
        function(name: string, soft: boolean?): string?
            if carried and carried[name] and not soft then
                return "=(" .. name .. ")"
            end
            local facility = FACILITIES[name]
            if reached and facility and not soft then
                reached[facility] = true
            end
            -- What the project's roots resolve wins, so the VM's own spelling of a
            -- standard module stays the one carried; a build's generated module is
            -- found through the path the build recorded.
            local found = project.resolve(env, compilerRoot, name, soft)
            if found == nil and sources and sources[name] then
                return sources[name]
            end
            if found == nil and not soft and not HOST_MODULES[name] and not looked[name] then
                looked[name] = true
                local declaration = extensionDeclaration(env, name)
                if declaration ~= nil then
                    extensions[name] = declaration
                end
            end

            return found
        end,
        function(name: string, path: string): table
            if cache then
                return cache.lowering(name, function(): any
                    return checked(name, path)
                end)
            end

            return checked(name, path)
        end,
        nil,
        nil,
        env.layoutTarget,
        coverage,
        cache and cache.reuse or nil
    )
    if not ok then
        if cache then
            cache.abandon()
        end
        error(image, 0)
    end
    local declared: {string} = {}
    for name in pairs(extensions) do
        declared[#declared + 1] = name
    end
    table.sort(declared)
    if #declared > 0 then
        local lines: {string} = {image as string}
        if (image as string):sub(-1) ~= "\n" then
            lines[#lines + 1] = "\n"
        end
        for _, name in ipairs(declared) do
            lines[#lines + 1] = "extension " .. name .. " " .. quoted(extensions[name] as string) .. "\n"
        end
        image = table.concat(lines)
    end
    if cache then
        cache.close(cache.reuse.stats)
        local stats = cache.stats
        io.stderr:write(
            (
                "vm emit: %d %s lowered, %d replayed (%d refused); %d checked, %d restored; %ds\n"
            ):format(
                stats.lowered,
                stats.lowered == 1 and "module" or "modules",
                stats.replayed,
                stats.rejected,
                stats.checked,
                stats.restored,
                os.time() - started
            )
        )
    end

    return image as string
end

local function emitFrom(
    root: string,
    entry: string,
    extras: string?,
    includes: string?,
    hostBootstrap: boolean?,
    cacheDir: string?
): string
    if not hostBootstrap then
        triviaarena.installDefault(tableProvider)
    end
    chunks.install()
    local config: table = {include = names(includes or "src")}
    if not includes and fs.exists(root .. "/nupp.lua") then
        local loader = assert(rawget(_G, "loadfile"), "source loader unavailable")
        local chunk, problem = loader(root .. "/nupp.lua")
        assert(chunk, problem)
        config = chunk()
        assert(type(config) == "table", "manifest must return a table")
    end
    local carried = entry == "nupp.tools.vm.root"
        and {["nupp.vm.cliResources"] = require("nupp.compiler.vm.resources").source(root, config)}
        or nil

    return emitProject(root, config, entry, names(extras), hostBootstrap, carried, nil, nil, cacheDir)
end

--- Read, check and lower a project using the compiler's module resolver.
--- Explicit include roots allow bootstrapping before manifest execution.
--- `NUPP_VM_EMIT_CACHE`, when set, names where the emit keeps what it lowered
--- and finds what an earlier one kept (`project.emitCached`).
--- @raises string when a source cannot be read, checked or lowered.
function project.emit(root: string, entry: string, extras: string?, includes: string?, hostBootstrap: boolean?): string
    local cacheDir = os.getenv("NUPP_VM_EMIT_CACHE")

    return emitFrom(root, entry, extras, includes, hostBootstrap, cacheDir ~= "" and cacheDir or nil)
end

--- `project.emit`, keeping per-module lowering under `cacheDir` and replaying
--- what an earlier emit kept there whose inputs are unchanged. The image is the
--- one an emit without the cache writes, byte for byte.
--- @raises string when a source cannot be read, checked or lowered.
function project.emitCached(root: string, entry: string, extras: string?, includes: string?, cacheDir: string): string
    return emitFrom(root, entry, extras, includes, nil, cacheDir)
end

--- `path` as a program image names it: relative to the project, or to the
--- compiler checkout for the library it carries, so where either sat on the
--- building machine is not part of the binary.
local function programPath(root: string, compilerRoot: string, path: string): string
    for _, base in ipairs({root, compilerRoot}) do
        local prefix = fs.normalize(base) .. "/"
        if path:sub(1, #prefix) == prefix then
            return "@" .. path:sub(#prefix + 1)
        end
    end

    return path
end

--- The image instructions only compiled code runs, as the runtime's
--- `native_simd::required` lists them.
const NATIVE_OPS = {
    "Simd",
    "SpanLen",
    "SpanBounds",
    "SpanLoad",
    "SpanStore",
    "VOp",
    "VSplatN",
    "VExtractN",
    "VAny",
    "VPrefix",
    "Raise",
}

--- The image of a program: `entry` and every module it reaches under the
--- project's manifest `config`, and the runtime facilities that image needs
--- linked, sorted. `embedded` is the source of the program's `nupp.embedded`
--- resource table, when it carries resources. `coverage` instruments the modules
--- it names and collects their sites.
--- @raises string when a source cannot be read, checked or lowered.
--- `modules`, when a build gives them, are the target's compiled source set:
--- a program carries every one of them, as a LuaJIT build carried its whole
--- output tree, so a module named only by a computed `require` is found.
function project.program(
    root: string,
    config: table,
    entry: string,
    embedded: string?,
    coverage: lower.CoverageRequest?,
    modules: {[string]: any}?
): (string, {string})
    local reached: {[string]: boolean} = {}
    local extras: {string} = embedded and {"nupp.embedded"} or {}
    local sources: {[string]: string} = {}
    local names: {string} = {}
    -- The project's own modules and what its build generated: the standard
    -- library a build compiled beside them is reached by name as usual.
    local prefix = root:gsub("/$", "") .. "/"
    for name, record in pairs(modules or {}) do
        local path = type(record) == "table" and (record as any).sourcePath or nil
        local own = type(path) == "string"
            and (
                (record as any).rock == true
                or (path as string):sub(1, #prefix) == prefix
                or (path as string):sub(1, 1) ~= "/"
            )
        if own and name ~= entry then
            names[#names + 1] = name
            sources[name] = path as string
        end
    end
    table.sort(names)
    -- After the entry's own graph, so a module it reaches is checked as it
    -- reached it rather than first on its own.
    local carried: any = extras
    carried.after = names
    local compilerRoot = assert(envMod.compilerRoot(), "compiler source root unavailable")
    -- A function with vector instructions runs only compiled (`native_simd`'s
    -- `required`), so a program holding one has its image compiled ahead of
    -- time and linked into its runtime (`scripts/toolchain vm-program`): the
    -- binary carries no code generator. The rest stay interpreter-only.
    local native: {[string]: boolean} = {}
    for _, op in ipairs(NATIVE_OPS) do
        native[op] = true
    end
    lower.pathMapper = function(path: string): string?
        return programPath(root, compilerRoot, path)
    end
    lower.graphSink = function(_: string, functions: {any}, _: table): nil
        for _, f in ipairs(functions) do
            for _, ins in ipairs(f.code) do
                if native[ins[1]] then
                    reached["vector"] = true
                    return
                end
            end
        end
    end
    local image = emitProject(
        root,
        config,
        entry,
        extras,
        nil,
        embedded and {["nupp.embedded"] = embedded} or nil,
        reached,
        coverage,
        nil,
        sources
    )
    lower.pathMapper = nil
    lower.graphSink = nil
    local facilities: {string} = {}
    for facility in pairs(reached) do
        facilities[#facilities + 1] = facility
    end
    table.sort(facilities)

    return image, facilities
end

--- Inspect the VM instructions emitted for one checked source file: its
--- functions with each instruction's source line, and the image text those
--- functions occupy. `text`, when given, is lowered in place of the file's
--- saved contents.
---
--- The file is lowered as `nupp run` lowers it on the VM: checked in the
--- project's environment, whose stores answer for what it requires, and
--- lowered alone, its requires left to the loader. Lowering the whole graph
--- produced the same instructions for the file and cost a check of everything
--- it reaches on every call (half a minute for a benchmark that requires
--- `nupp.bench`).
--- @raises string when the source or its dependencies cannot be compiled.
function project.inspect(root: string, path: string, text: string?): ({any}, string)
    triviaarena.installDefault(tableProvider)
    chunks.install()
    local env = envMod.new(root)
    local name = envMod.moduleNameForPath(env as any, path) or "vm.inspection"
    local source = text or assert(fs.readFile(path), "cannot read " .. path)
    local parsed = parser.parse(source as string, path)
    assert(#parsed.errors == 0, "parse failed: " .. path)
    local diagnostics = checkMod.check(parsed, path, env as any, {})
    for _, d in ipairs(diagnostics) do
        if d.severity == "error" or not d.severity then
            error(
                path .. ":" .. tostring(
                    d.line
                ) .. ":" .. tostring(d.col) .. ": " .. tostring(d.code) .. " " .. tostring(d.msg),
                0
            )
        end
    end
    -- What the module publishes decides which records its witnesses link.
    (parsed.root as any).vmModuleExports = (parsed as any).moduleExports
    envMod.persist(env as any)
    local functions: {any} = {}
    lower.emit(
        name,
        {},
        function(candidate: string): string?
            return candidate == name and path or nil
        end,
        function(_: string, _: string): table
            return parsed.root
        end,
        nil,
        functions,
        (env as any).layoutTarget or require("nupp.compiler.targetlayout").hostKey()
    )
    local image: {string} = {}
    for _, fn in ipairs(functions) do
        image[#image + 1] = fn.image
        fn.image = nil
    end

    return functions, table.concat(image, "\n") .. (#image > 0 and "\n" or "")
end

--- What the root CLI image carries beside what its entry requires: modules
--- the compiler reaches by computed name.
project.ROOT_EXTRAS = "nupp.compiler.hostservices,nupp.compiler.fs,nupp.compiler.project.projectconfig,"
    .. "nupp.compiler.project.store,nupp.compiler.project.fingerprint,nupp.compiler.hash,"
    .. "nupp.compiler.project.preludecache,nupp.runtime.provider.nativeprocess"

--- Rebuild the compiler image, including its computed module dependencies.
--- @raises string when the compiler sources fail to compile.
function project.rebuild(root: string, hostBootstrap: boolean?): string
    return project.emit(
        root,
        "nupp.tools.vm.project",
        "nupp.compiler.fs,nupp.compiler.project.projectconfig,nupp.compiler.project.store,nupp.compiler.project.fingerprint,nupp.compiler.hash,nupp.compiler.project.preludecache",
        nil,
        hostBootstrap
    )
end

--- Evaluate a manifest through the installed source loader.
--- @raises string when a manifest cannot be loaded or does not return a table.
function project.manifest(path: string): table
    triviaarena.install(tableProvider)
    chunks.install()
    local chunk, problem = assert(rawget(_G, "loadfile"))(path)
    assert(chunk, problem)
    local config = chunk()
    assert(type(config) == "table", "manifest must return a table")

    return config
end

export = project
