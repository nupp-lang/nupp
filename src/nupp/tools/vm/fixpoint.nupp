module nupp.tools.vm.fixpoint

--[[
The self-hosting claim for the VM-hosted compiler: the root CLI image, emitted
from these sources, emits itself byte for byte.

Three stages. Stage one is these sources lowered by the pinned stage zero that
`selfHost.bootstrap` names, or by the default execution seed when the project
names none, so it says nothing yet; stage two is the first image
lowered by the code these sources describe, and stage three is stage two doing
it again. Two and three must be identical. Starting from the pin is what proves
a cold checkout, which has nothing else, can build these sources.

Each stage runs on the verified seed runtime, with matching-image AOT disabled.
The machine-only build tool never executes a compiler image.
]]

local fs = require("nupp.compiler.fs")
local hash = require("nupp.compiler.hash")
local process = require("nupp.compiler.process")
local vmProject = require("nupp.tools.vm.project")

local fixpoint = {}

--- What a run found.
type fixpoint.Result = {
    --- Whether stages two and three agree.
    ok: boolean,

    --- The verified image, kept when they do.
    image: string?,

    --- Its digest.
    digest: string?,

    --- Why it failed, in one phrase.
    reason: string?
}

local function failed(reason: string): fixpoint.Result
    return {ok = false, reason = reason}
end

--- The runtime/image pair `bootstrap` prints the path of on its last line.
---
--- @param root where the command runs
--- @param bootstrap the command, split on spaces
--- @return the pair's directory, or nil and why there is none
function fixpoint.stageZero(root: string, bootstrap: string): string?, string?
    local command: {string} = {}
    for word in bootstrap:gmatch("%S+") do
        command[#command + 1] = word
    end
    if #command == 0 then
        return nil, "selfHost.bootstrap names no command to find the execution seed with"
    end
    local status, output = process.capture(command, {cwd = root})
    if status ~= 0 then
        return nil, table.concat(command, " ") .. " failed: " .. tostring(output)
    end
    local path: string? = nil
    for line in tostring(output):gmatch("[^\r\n]+") do
        path = line
    end
    if path == nil or path == "" then
        return nil, table.concat(command, " ") .. " named no execution seed"
    end
    if not fs.exists(path as string) then
        return nil, "the execution seed is not at " .. tostring(path)
    end

    return path, nil
end

--- Verifies the VM compiler from `root`'s sources, keeping the stages under
--- `outDir`. `say` reports progress.
---
--- @param root the checkout
--- @param outDir where the stages are written
--- @param say receives one line per stage
--- @param bootstrap the manifest's `selfHost.bootstrap`, which names the seed
--- @return what the run found
function fixpoint.run(
    root: string,
    outDir: string,
    say: function(line: string): nil,
    bootstrap: string?
): fixpoint.Result
    local pair, problem = fixpoint.stageZero(root, bootstrap or "sh scripts/toolchain stage0-seed")
    if pair == nil then
        return failed(tostring(problem))
    end
    local checked = process.capture({"python3", fs.join(root, "scripts/bootstrap-seed"), "verify", pair as string})
    if checked ~= 0 then
        return failed("the bootstrap execution seed failed verification")
    end
    local seed = fs.join(pair as string, "compiler.image")
    fs.mkdir(outDir)
    local previous = seed as string
    local stages: {string} = {}
    for index = 1, 3 do
        local stage = fs.join(outDir, "stage" .. index .. ".image")
        os.remove(stage)
        -- The seed by its whole path, since which image started is the claim.
        say(("stage %d: %s lowers %s"):format(index, index == 1 and previous or fs.basename(previous), root))
        local status = process.run(
            {
                "python3",
                fs.join(root, "scripts/bootstrap-seed"),
                "run",
                pair as string,
                "run",
                previous,
                "nupp.tools.vm.project",
                "emit",
                root,
                "nupp.tools.vm.root",
                vmProject.ROOT_EXTRAS,
                "--output",
                stage
            },
            -- From the sources alone: no stage replays what an earlier emit kept.
            {
                cwd = root,
                env = {
                    NUPP_COMPILER_ROOT = root,
                    NUPP_VM_EMIT_CACHE = "",
                    NO_JIT = "1",
                    NO_AOT = "1",
                    SIMD_INTERPRET = "1"
                }
            }
        )
        if status ~= 0 or not fs.exists(stage) then
            return failed(("stage %d did not build"):format(index))
        end
        stages[index] = stage
        previous = stage
    end
    local second = fs.readFile(stages[2])
    local third = fs.readFile(stages[3])
    if second == nil or third == nil or second ~= third then
        return failed("stages two and three differ")
    end
    local image = fs.join(outDir, "root.image")
    local written = fs.writeFile(image, third as string)
    if not written then
        return failed("cannot write " .. image)
    end
    for _, stage in ipairs(stages) do
        os.remove(stage)
    end

    return {ok = true, image = image, digest = hash.digest(third as string)}
end

export = fixpoint
