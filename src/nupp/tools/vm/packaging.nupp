-- Executed by Nupp, using one immutable installed compiler/runtime pair.
-- Keep the previous linked generation selected until every new artifact passes.
module nupp.tools.vm.packaging

local fs = require("nupp.compiler.fs")
local process = require("nupp.compiler.process")
local hash = require("nupp.compiler.hash")
local json = require("serde.json")
local aot = require("nupp.tools.vm.aotparts")
local steps = require("nupp.tools.vm.buildsteps")
const GENERATION_LENGTH = 64

export function available(): integer
    local root = assert(os.getenv("NUPP_COMPILER_ROOT"))
    local generation = assert(assert(fs.readFile(root .. "/.nupp/vm-cli/current")):match("^(%S+)"))
    local receipt = json.decodevalue(assert(fs.readFile(root .. "/.nupp/vm-cli/" .. generation .. "/receipt.json")))
    assert(receipt.linked, "a linked compiler is required")

    return 1
end

export function compilerSelection(): integer
    return 1
end

local function run(arg: {string}, private: any?): integer
    local ROOT = assert(arg[1], "compiler root required")
    local WINDOWS = package.config:sub(1, 1) == "\\"
    local SUFFIX = WINDOWS and ".exe" or ""
    local FORMAT = "nupp-vm-cli-1"
    local OUT = private and private.outDir or ROOT .. "/build/vm-cli"
    local TARGET = private and OUT .. "/target" or ROOT .. "/build/rust/target"
    local COMPILERS = ROOT .. "/.nupp/vm-cli"
    local PACKAGES = private and private.packages or COMPILERS
    local PYTHON = os.getenv("PYTHON") or "python3"
    local started = os.monotonic()

    local function read(path)
        return assert(fs.readFile(path))
    end

    local function write(path, text)
        assert(fs.writeFile(path, text))
    end

    -- What a staged generation holds, and a fresh directory to stage it in.
    -- os.mktempdir would make one, but the pinned stage-zero release does not
    -- know it, and src/ is built by that release first (AGENTS.md).
    local STAGED = {"runtime", "compiler.image", "format", "runtime-identity", "receipt.json"}

    local function stagingDirectory(): string
        local path = PACKAGES .. "/.install-" .. fs.stagingSuffix()
        while fs.exists(path) do
            path = PACKAGES .. "/.install-" .. fs.stagingSuffix()
        end
        assert(fs.mkdir(path), "cannot create staging directory " .. path)

        return path
    end

    local function discardStaging(path: string): nil
        for _, name in ipairs(STAGED) do
            os.remove(path .. "/" .. name)
        end
        os.remove(path)
    end

    local function digest(path)
        return hash.sha256(read(path))
    end

    local function capture(command, env)
        local code, output = process.capture(command, {cwd = ROOT, env = env})
        assert(code == 0, output)
        return output
    end

    local function run(command, env, name)
        local before = os.monotonic()
        assert(process.run(command, {cwd = ROOT, env = env}) == 0, (name or command[1]) .. " failed")
        io.stderr:write(("vm-build: %s took %.3fs\n"):format(name or command[1], (os.monotonic() - before) / 1000))
    end

    local function source()
        if private then
            return private.snapshot()
        end
        return json.decodevalue(capture({PYTHON, ROOT .. "/scripts/vm-cli", "status"})).sourceNow
    end

    local function copy(from, to, executable)
        assert(fs.copyFile(from, to))
        if executable and not WINDOWS then
            run({"chmod", "755", to})
        end
    end

    local function toolchain(...)
        local command = {WINDOWS and "sh.exe" or "sh", ROOT .. "/scripts/toolchain", ...}
        return capture(command):match("([^\r\n]+)[\r\n]*$")
    end

    local function cargo(features, extra, defaults)
        local command = {"cargo", "build", "--locked", "--release", "-p", "nupp-vm"}
        if os.getenv("NUPP_HOST_OFFLINE") then
            command[#command + 1] = "--offline"
        end
        if defaults == false then
            command[#command + 1] = "--no-default-features"
        end
        command[#command + 1], command[#command + 2] = "--features", features
        local env = {CARGO_TARGET_DIR = TARGET}
        for name, value in pairs(extra or {}) do
            env[name] = value
        end
        -- Keep the same optional compiler cache as the serial build driver.
        if not os.getenv("RUSTC_WRAPPER") then
            local found = process.run({"sccache", "--version"}) == 0
            if found then
                env.RUSTC_WRAPPER = WINDOWS and "sccache" or ROOT .. "/scripts/sccache-wrapper"
            end
        end
        run(command, env, "cargo " .. features)

        return TARGET .. "/release/nupp-vm" .. SUFFIX
    end

    assert(
        arg[2] == "build",
        "usage: scripts/vm-build build [--seed vm] [--cache PATH] [--jobs N] [--compiler-generation SHA256]"
    )
    local cache, jobs = OUT .. "/emit-cache", assert(tonumber(os.getenv("NUPP_VM_AOT_JOBS") or "4"))
    local compilerGeneration: string? = nil
    local index: integer = 3
    while arg[index] do
        local option, value = arg[index], assert(arg[index + 1], "missing build option value")
        if option == "--cache" then
            cache = fs.absolute(value)
        elseif option == "--jobs" then
            jobs = assert(tonumber(value))
        elseif option == "--compiler-generation" then
            compilerGeneration = value
        else
            assert(option == "--seed" and value == "vm", "unknown build option: " .. option)
        end
        index = index + 2
    end
    assert(jobs >= 1 and jobs <= 4 and jobs % 1 == 0, "jobs must be an integer from 1 to 4")
    assert(fs.mkdir(OUT))
    local before = source()
    local selectedGeneration = read(COMPILERS .. "/current"):match("^([a-f0-9]+)%s*$")
    assert(selectedGeneration and #selectedGeneration == GENERATION_LENGTH, "invalid installed compiler generation")
    local generation = compilerGeneration or selectedGeneration
    assert(#generation == GENERATION_LENGTH and generation:match("^[a-f0-9]+$"), "invalid build compiler generation")
    local pair = COMPILERS .. "/" .. generation
    local oldreceipt = json.decodevalue(read(pair .. "/receipt.json"))
    assert(
        oldreceipt.format == FORMAT
        and oldreceipt.linked
        and digest(pair .. "/runtime") == oldreceipt.runtimeSha256
        and digest(pair .. "/compiler.image") == oldreceipt.imageSha256,
        "verified linked build compiler required"
    )
    local identity = fs.readFile(pair .. "/runtime-identity") or oldreceipt.runtimeSha256
    identity = identity:match("^(%S+)")
    local text = read(ROOT .. "/src/nupp/tools/vm/project.nupp")
    local block = assert(text:match("project%.ROOT_EXTRAS = (.-)\n\n"), "missing root dependency list")
    local extras = {}
    for chunk in block:gmatch('"([^"]*)"') do
        extras[#extras + 1] = chunk
    end
    if private then
        extras[#extras + 1] = "," .. private.extras
    end
    local image = OUT .. "/compiler.image"
    local emitEnv = {NO_JIT = "1", NUPP_COMPILER_ROOT = ROOT, NUPP_VM_EMIT_CACHE = cache, NUPP_VM_RUNTIME_ID = identity}
    local emission = {
        pair .. "/runtime",
        "run",
        pair .. "/compiler.image",
        "nupp.tools.vm.project",
        "emit",
        private and private.emitRoot or ROOT,
        "nupp.tools.vm.root",
        table.concat(extras)
    }
    if private and private.includes then
        emission[#emission + 1] = private.includes
    end
    emission[#emission + 1], emission[#emission + 2] = "--output", image
    run(emission, emitEnv, "VM-hosted root emit")

    local seed = private and pair or toolchain("stage0-seed")
    local plain = cargo("aot")
    local objecttool = OUT .. "/object-tool" .. SUFFIX
    copy(plain, objecttool, true)
    local staging = OUT .. "/native-new"
    assert(fs.mkdir(staging))
    run({objecttool, "native", "layouts", staging .. "/layouts.json"}, nil, "native layouts")
    -- The lowering reads the code the image carries for it, the runtime sources,
    -- the layouts and the interpreter running it: with all of them as a build
    -- before had them, that build's lowering is reused (`nupp.tools.vm.buildsteps`).
    local loweringEnv = {NO_JIT = "1", NO_AOT = "1", NUPP_COMPILER_ROOT = ROOT, NUPP_VM_EMIT_CACHE = ""}
    local loweringInputs = {
        "seed " .. digest(seed .. "/runtime"),
        "layouts " .. digest(staging .. "/layouts.json"),
        "lowering " .. assert(
            capture({seed .. "/runtime", "run", image, "nupp.tools.vm.buildsteps", "loweringInputs", ROOT}, loweringEnv)
                :match("(%x+)%s*$"),
            "native core lowering inputs unavailable"
        ),
    }
    local loweringKept = steps.kept("native core lowering", loweringInputs)
    local loweringReused = false
    if loweringKept and loweringKept["runtime.clif"] then
        write(staging .. "/runtime.clif", loweringKept["runtime.clif"] as string)
        io.stderr:write("vm-build: native core lowering reused\n")
        loweringReused = true
    else
        run(
            {
                seed .. "/runtime",
                "run",
                image,
                "nupp.compiler.clif.lower",
                "compileRuntime",
                ROOT,
                staging .. "/layouts.json",
                "--output",
                staging .. "/runtime.clif"
            },
            loweringEnv,
            "native core lowering"
        )
        steps.keep("native core lowering", loweringInputs, {["runtime.clif"] = read(staging .. "/runtime.clif")})
    end
    run(
        {objecttool, "native", "object", staging .. "/runtime.clif", staging .. "/runtime.o"},
        nil,
        "native core object"
    )
    -- Preserve unchanged artifacts and their times, so Cargo sees an actual change.
    local native = OUT .. "/native"
    assert(fs.mkdir(native))
    for _, name in ipairs({"runtime.clif", "runtime.o", "runtime.o.rs"}) do
        local content = read(staging .. "/" .. name)
        if fs.readFile(native .. "/" .. name) ~= content then
            write(native .. "/" .. name, content)
        end
    end
    local core = native .. "/runtime.o"
    local built = cargo("aot,native-runtime", {NUPP_NATIVE_RUNTIME_OBJECT = core})
    local tool = OUT .. "/aot-tool" .. SUFFIX
    copy(built, tool, true)
    local aotstarted = os.monotonic()
    local fresh = OUT .. "/compiler-next.o"
    -- The AOT reads the image and the tool, and its sidecar names the maps file:
    -- with all of them as a build before had them, that build's objects are reused.
    local suffixes = {"", ".rs", ".maps", ".manifest"}
    local aotInputs = {
        "image " .. digest(image),
        "tool " .. digest(tool),
        "jobs " .. tostring(jobs),
        "maps " .. fs.absolute(OUT .. "/compiler.o.maps"),
    }
    local aotKept = steps.kept("parallel AOT", aotInputs)
    for _, suffix in ipairs(suffixes) do
        if aotKept and aotKept["compiler.o" .. suffix] == nil then
            aotKept = nil
        end
    end
    local receipt: any = nil
    if aotKept and aotKept["receipt.json"] then
        for _, suffix in ipairs(suffixes) do
            write(fresh .. suffix, aotKept["compiler.o" .. suffix] as string)
        end
        receipt = json.decodevalue(aotKept["receipt.json"] as string)
        receipt.reused = true
    else
        receipt = aot.compile(tool, image, fresh, {jobs = jobs, maps = OUT .. "/compiler.o.maps"})
        local made: {[string]: string} = {["receipt.json"] = json.encodevalue(receipt)}
        for _, suffix in ipairs(suffixes) do
            made["compiler.o" .. suffix] = read(fresh .. suffix)
        end
        steps.keep("parallel AOT", aotInputs, made)
    end
    receipt.seconds = (os.monotonic() - aotstarted) / 1000
    write(OUT .. "/parallel-aot.json", json.encodevalue(receipt))
    io.stderr:write(("vm-build: parallel AOT took %.3fs\n"):format(receipt.seconds))
    for _, suffix in ipairs({"", ".rs", ".maps", ".manifest"}) do
        local content = read(fresh .. suffix)
        local destination = OUT .. "/compiler.o" .. suffix
        if fs.readFile(destination) ~= content then
            write(destination, content)
        end
    end
    local runtime = cargo(
        "aot-linked,c-headers,native-ffi,net,http,native-runtime",
        {NUPP_AOT_OBJECT = OUT .. "/compiler.o", NUPP_NATIVE_RUNTIME_OBJECT = core},
        false
    )

    local after = source()
    assert(
        before.fingerprint == after.fingerprint and before.revision == after.revision,
        "compiler sources changed during build; previous generation retained"
    )
    assert(
        read(COMPILERS .. "/current"):match("^(%S+)") == selectedGeneration,
        "another build selected a generation; refusing to replace it"
    )
    local runtimehash, imagehash = digest(runtime), digest(image)
    local key = '{"format":"'
        .. FORMAT
        .. '","imageSha256":"'
        .. imagehash
        .. '","runtimeSha256":"'
        .. runtimehash
        .. '"}'
    local selected = hash.sha256(key)
    local stage = stagingDirectory()
    copy(runtime, stage .. "/runtime", true)
    copy(image, stage .. "/compiler.image")
    local validation = {
        NO_JIT = "1",
        NUPP_COMPILER_ROOT = ROOT,
        NUPP_VM_BINARY = stage .. "/runtime",
        NUPP_VM_CLI_IMAGE = stage .. "/compiler.image"
    }
    run({stage .. "/runtime", "verify", stage .. "/compiler.image"}, validation, "verify linked image")
    local help = capture(
        {stage .. "/runtime", "exec", stage .. "/compiler.image", "nupp.tools.vm.root", "--help"},
        validation
    )
    assert(help:find("Usage:", 1, true), "linked compiler did not produce CLI help")
    assert(
        digest(stage .. "/runtime") == runtimehash and digest(stage .. "/compiler.image") == imagehash,
        "staged compiler artifacts changed"
    )
    local confirmed = source()
    assert(
        before.fingerprint == confirmed.fingerprint and before.revision == confirmed.revision,
        "compiler sources changed during validation; previous generation retained"
    )
    assert(
        read(COMPILERS .. "/current"):match("^(%S+)") == selectedGeneration,
        "another build selected a generation during validation"
    )
    local installed = {
        format = FORMAT,
        runtimeSha256 = runtimehash,
        imageSha256 = imagehash,
        runtimeIdentity = runtimehash,
        installedFrom = {runtime = runtime, image = image},
        sourceAtInstall = before,
        sourceRead = "build-start",
        sourceProvenance = "Source state when the build that made these artifacts began reading its sources.",
        execution = "JIT disabled during validation; supplied matching-image AOT remains enabled",
        linked = true,
        validation = {"image verifier", "full root CLI --help"},
        parallelAot = {jobs = jobs, functions = receipt.functions, reused = receipt.reused == true},
        nativeCoreLowering = {reused = loweringReused},
        buildCompiler = {
            generation = generation,
            runtimeSha256 = oldreceipt.runtimeSha256,
            imageSha256 = oldreceipt.imageSha256,
        },
        privateProducer = private and private.identity or nil,
    }
    write(stage .. "/format", FORMAT .. "\n")
    write(stage .. "/runtime-identity", runtimehash .. "\n")
    write(stage .. "/receipt.json", json.encodevalue(installed))
    local destination = PACKAGES .. "/" .. selected
    if fs.exists(destination) then
        assert(
            digest(destination .. "/runtime") == runtimehash and digest(destination .. "/compiler.image") == imagehash,
            "existing generation artifacts differ"
        )
        write(destination .. "/receipt.json", json.encodevalue(installed))
        discardStaging(stage)
    else
        assert(os.rename(stage, destination))
    end
    -- fs.writeFile stages and renames, as os.writeatomic does; the pinned
    -- stage-zero release knows only the former.
    write(PACKAGES .. "/current", selected .. "\n")
    -- A content check establishes freshness. Keep no end-of-build timestamp that
    -- could hide an edit; the launcher's next current check refreshes its own stamp.
    if not private then
        run({PYTHON, ROOT .. "/scripts/vm-cli", "current", "--refresh-stamp"}, nil, "compiler freshness")
    end
    os.remove(PACKAGES .. "/failed")
    write(
        OUT .. "/build-speed.json",
        json.encodevalue({
            source = before,
            generation = selected,
            compilerGeneration = generation,
            usableSeconds = (os.monotonic() - started) / 1000,
            aot = receipt.seconds,
            jobs = jobs
        })
    )
    print(destination)
    if private then
        private.destination = destination
    end

    return 0
end

--- What a packaged core seed is.
export type CoreSeed = {
    --- The archive.
    archive: string,

    --- Its SHA-256 digest, which a pin names.
    sha256: string,

    --- The host it runs on.
    host: string,

    --- The digest of the runtime inside it.
    runtimeSha256: string,

    --- The digest of the compiler inside it.
    compilerSha256: string
}

-- The manifest a core seed carries, one key to a line so scripts/toolchain
-- reads it without a JSON parser (`core_seed_verify`).
const CORE_SEED_FORMAT = "nupp-core-seed-1"
-- Where a core compiler keeps what it loads relative to itself, which its
-- seed carries beside it (scripts/toolchain's `core_seed_library`).
const CORE_SEED_LIBRARIES = "lib"

local function coreSeedManifest(host: string, revision: string, files: {[string]: string}): string
    local names: {string} = {}
    for name in pairs(files) do
        names[#names + 1] = name
    end
    table.sort(names)
    local entries: {string} = {}
    for index, name in ipairs(names) do
        entries[#entries + 1] = ('    "%s": "%s"%s'):format(name, files[name], index < #names and "," or "")
    end

    return table.concat(
        {
            "{",
            ('  "compilerSha256": "%s",'):format(files["compiler.bundle"]),
            '  "execution": "core",',
            '  "files": {',
            table.concat(entries, "\n"),
            "  },",
            ('  "format": "%s",'):format(CORE_SEED_FORMAT),
            ('  "host": "%s",'):format(host),
            ('  "runtimeSha256": "%s",'):format(files.runtime),
            ('  "sourceRevision": "%s"'):format(revision),
            "}",
            ""
        },
        "\n"
    )
end

--- Packages a core compiler and the C bridge it runs on as a release-ready seed
--- archive: `nupp-core-seed-HOST-REVISION.tar.gz` in `directory`, with the
--- archive's digest beside it in `.sha256`. Nothing is published or pinned.
---
--- @param root the checkout, whose NOTICE.md travels with the pair
--- @param runtime the core runtime, which must be the C bridge
--- @param compiler the core compiler bundle
--- @param revision the source revision the pair was built from
--- @param directory where the archive is written; an archive already there is
---     never replaced
--- @return the seed, or nil and why it was not packaged
export function coreSeed(
    root: string,
    runtime: string,
    compiler: string,
    revision: string,
    directory: string
): (CoreSeed?, string?)
    local fixpoint = require("nupp.tools.vm.fixpoint")
    if not revision:match("^[%w._-]+$") then
        return nil, "the source revision must be a plain name: " .. revision
    end
    if not fixpoint.coreRuntime(runtime) then
        return nil, runtime .. " is not the core's C bridge"
    end
    if not fixpoint.coreBundle(compiler) then
        return nil, compiler .. " is not a core compiler"
    end
    local hostStatus, hostOutput = process.capture({"sh", fs.join(root, "scripts/stage0-runtime"), "--host"})
    local host = hostStatus == 0 and tostring(hostOutput):match("^(%S+)") or nil
    if host == nil or host == "unsupported" then
        return nil, "the core runs on no host this machine is"
    end
    local archive = fs.join(fs.absolute(directory), ("nupp-core-seed-%s-%s.tar.gz"):format(host, revision))
    if fs.exists(archive) then
        return nil, "refusing to replace the seed archive " .. archive
    end
    fs.mkdir(fs.absolute(directory))
    local staging = archive .. ".staging-" .. fs.stagingSuffix()
    fs.mkdir(staging)

    local function discard(): nil
        process.run({"rm", "-rf", staging})
    end

    local copies: {
        [string]: string
    } = {runtime = runtime, ["compiler.bundle"] = compiler, ["NOTICE.md"] = fs.join(root, "NOTICE.md")}
    -- The libraries the compiler loads relative to itself travel beside it.
    local libraries = fs.join(fs.dirname(compiler), CORE_SEED_LIBRARIES)
    if fs.exists(libraries) then
        fs.mkdir(fs.join(staging, CORE_SEED_LIBRARIES))
        for name, kind in fs.children(libraries) do
            if kind == "file" then
                copies[CORE_SEED_LIBRARIES .. "/" .. name] = fs.join(libraries, name)
            end
        end
    end
    local transport = fs.dirname(runtime)
    local runtimeLibraries = fs.join(transport, "lib")
    local runtimeNotices = fs.join(transport, "notices")
    local macos = host:match("%-apple%-darwin$") ~= nil
    if fs.exists(runtimeLibraries) then
        if not fs.exists(fs.join(staging, "lib")) then
            fs.mkdir(fs.join(staging, "lib"))
        end
        for name, kind in fs.children(runtimeLibraries) do
            -- dylib IDs name the actual file. ELF SONAMEs may be symlinks,
            -- which the seed records as ordinary files under the SONAME.
            if (macos and kind == "file" and name:match("%.dylib$")) or (not macos and name:match("%.so%.%d+$")) then
                copies["lib/" .. name] = fs.join(runtimeLibraries, name)
            end
        end
    end
    if fs.exists(runtimeNotices) then
        fs.mkdir(fs.join(staging, "notices"))
        for name, kind in fs.children(runtimeNotices) do
            if kind == "file" and name:match("%.txt$") then
                copies["notices/" .. name] = fs.join(runtimeNotices, name)
            end
        end
    end
    local files: {[string]: string} = {}
    for name, source in pairs(copies) do
        local bytes = fs.readFile(source)
        if bytes == nil or not fs.writeFile(fs.join(staging, name), bytes as string) then
            discard()
            return nil, "cannot stage " .. source
        end
        files[name] = hash.sha256(bytes as string)
    end
    process.run({"chmod", "755", fs.join(staging, "runtime")})
    if not fs.writeFile(fs.join(staging, "manifest.json"), coreSeedManifest(host as string, revision, files)) then
        discard()
        return nil, "cannot write the seed manifest"
    end
    local status, output = process.capture({"sh", fs.join(root, "scripts/toolchain"), "archive", staging, archive})
    discard()
    if status ~= 0 then
        os.remove(archive)
        return nil, "cannot archive the seed: " .. tostring(output)
    end
    local digest = hash.sha256((assert(fs.readFile(archive))))
    assert(fs.writeFile(archive .. ".sha256", ("%s  %s\n"):format(digest, fs.basename(archive))))

    return {
        archive = archive,
        sha256 = digest,
        host = host as string,
        runtimeSha256 = files.runtime as string,
        compilerSha256 = files["compiler.bundle"] as string
    }, nil
end

-- Packages a development producer without changing the shipping selection.
export function producer(root: string, settings: table): string
    local options: any = settings
    run({root, "build", "--compiler-generation", options.generation}, options)

    return assert(options.destination)
end

export function main(arg: {string}): integer
    local ok, result = pcall(run, arg)
    if not ok then
        io.stderr:write("vm-build: " .. tostring(result) .. "\n")
        return 1
    end

    return result
end
