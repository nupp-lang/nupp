@!internal
module nupp.tools.profilemetadata

-- CLI and editor metadata retain their existing wire keys. Inputs come from
-- the public trace profile or the separate private static compiler catalog.
local function held(value: any, current: string, preceding: string): any
    local result = value[current]
    if result == nil then
        result = value[preceding]
    end

    return result
end

export function capture(value: any): any
    if type(value) ~= "table" then
        return value
    end
    return {
        id = value.id,
        architecture = value.arch,
        supported = value.supported,
        luajitRevision = held(value, "revision", "luajitRevision"),
        luajitVersion = held(value, "version", "luajitVersion"),
        operatingSystem = held(value, "os", "operatingSystem"),
        enabledRecorderFeatures = held(value, "features", "enabledRecorderFeatures"),
        bytecodeSchema = held(value, "schema", "bytecodeSchema"),
    }
end
