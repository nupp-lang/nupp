module nupp.tools.build.package

--[[
One file that is the whole program.

A bundle is every module a target reaches, concatenated into one Lua file with
each registered in `package.preload`, so the result runs anywhere LuaJIT does
with nothing beside it. A binary goes one step further: the bundle becomes a
payload appended to a prebuilt host stub, found at run time by a magic trailer
rather than by anything the filesystem has to be asked.
]]
const {type ModuleRecord as ModuleRecord2} = require("nupp.tools.build.cache")
const {type Resource} = require("nupp.tools.build.manifest")

local hash = require("nupp.compiler.hash")
local process = require("nupp.compiler.process")
local fs = require("nupp.compiler.fs")
local deps = require("nupp.tools.build.deps")
local modulesMod = require("nupp.tools.build.modules")

local normalize, join = fs.normalize, fs.join
local dirname, basename = fs.dirname, fs.basename
local readFile, writeFile = fs.readFile, fs.writeFile
local expandGlob = deps.expandGlob
local resourceOutput = modulesMod.resourceOutput

local package_ = {}

-- Component source assembly deliberately uses a runtime format string. The
-- arguments are compiler metadata rather than a user-facing typed format, so
-- routing these calls through the compile-time format contract adds no safety.
local function interpolate(format: string, ...: any): string
    return string.format(format, ...)
end

--- Runtime contract between a compiler-owned payload and host. Container format
--- compatibility remains `PAYLOAD_VERSION`; target C layout has its own ABI.

-- Named by module path rather than required: nothing of these is wanted at run time.
const {type Config} = require("nupp.tools.build.manifest")
const {type Target} = require("nupp.tools.build.manifest")
const {type ModuleRecord} = require("nupp.tools.build.cache")

--- The Lua module name a target's entry compiles to, and where its `.lua` lands.
local function entryModule(root: string, outDir: string, target: Target): string, string
    local mainName = "nupp.tools.main"
    local entries = target.entries or {}
    if entries[1] and not entries[1]:match("%.nupp$") then
        mainName = entries[1]
    end

    return mainName, join(root, join(outDir, mainName:gsub("%.", "/") .. ".lua"))
end

--- The resources a target carries, keyed as a running program asks for them,
--- sorted by key, and the staged files no key could reach.
local function carriedResources(
    root: string,
    config: Config,
    target: Target,
    mainName: string,
    mainPath: string,
    outDir: string
): ({{
    name: string,
    text: string
}}?, {string}?, string?)
    local moduleDirPath = normalize(dirname(mainPath))
    -- The directory of the entry's top-level namespace: `build/nupp` for
    -- `nupp.tools.main`. The entry's own directory for an entry with no namespace.
    local namespaceRoot = mainName:find(".", 1, true)
        and normalize(join(root, join(outDir, (mainName:match("^[^.]+") as string))))
        or moduleDirPath
    local resources: {{
        name: string,
        text: string
    }} = {}
    local unreachable = {}
    local keyed: {[string]: string} = {}
    for _, resource in ipairs(target.resources or {}) do
        local pattern: string
        if type(resource) == "table" then
            pattern = (resource as Resource).source
        else
            pattern = resource as string
        end
        for _, source in ipairs(expandGlob(root, pattern)) do
            local staged = normalize(join(root, join(outDir, resourceOutput(config, resource, source, root))))
            -- Beside the entry, a resource is keyed from the entry's directory, which
            -- is what a program asks for. Elsewhere in the entry's namespace it is
            -- keyed from that namespace's directory, which is how a library the entry
            -- uses carries files for itself: the compiler reads its declarations as
            -- `/compiler/decls/...` when the program it is part of starts in
            -- `nupp.tools`. Anything else has no name a running program could know.
            local key = nil
            if staged:sub(1, #moduleDirPath + 1) == moduleDirPath .. "/" then
                key = staged:sub(#moduleDirPath + 1)
            elseif staged:sub(1, #namespaceRoot + 1) == namespaceRoot .. "/" then
                key = staged:sub(#namespaceRoot + 1)
            end
            if key then
                -- Read from the source the staged copy is made from: a VM program's
                -- build stages nothing.
                local text, readErr = readFile(source)
                if not text then
                    return nil, nil, readErr
                end
                if keyed[key] and keyed[key] ~= staged then
                    return nil, nil, ("resources %s and %s would both be carried as %s"):format(keyed[key], staged, key)
                end
                keyed[key] = staged
                resources[#resources + 1] = {name = key, text = text}
            else
                -- A resource staged beside the entry's directory rather than under it
                -- has no key a running program could ask for, since a program asks
                -- relative to where its own modules are. Left out and said out loud: a
                -- bundle that quietly dropped files would be discovered by whatever
                -- stopped working.
                unreachable[#unreachable + 1] = staged
            end
        end
    end
    table.sort(resources, function(a, b)
        return a.name < b.name
    end)

    return resources, unreachable
end

--- The payload a VM program binary carries: the entry module's name on the
--- first line, then the image of everything it reaches, its resources among
--- them as the `nupp.embedded` table a bundle preloads.
---
--- The image is lowered from source by the VM's own lowering, not assembled
--- from the generated Lua the modules build wrote, which the VM never runs.
---
--- @return the payload, or nil when the program did not compile
--- @return why not
--- @return the resources that had no key a running program could ask for
--- @return the runtime facilities the program reaches
--- What a VM program image is reused under: everything its emission reads that
--- can differ between two builds of the same target. The modules' sources, the
--- VM's own library and declarations that replace some of them, the resources
--- carried as `nupp.embedded`, and the compiler doing the lowering, since a new
--- compiler may lower the same source differently. Nil when any of those cannot
--- be named, which is a build that emits afresh.
---
--- The compiler is named the way every store names it, by
--- `fingerprint.graphFingerprint`: on the VM the digest of the image the running
--- compiler started from, which the runtime answers without reading the image
--- file again, and which is the compiler that actually lowers here even when
--- `NUPP_VM_CLI_IMAGE` names another or nothing.
local function programKey(mainName: string, embedded: string?, modules: {[string]: any}?, coverage: boolean): string?
    local compilerRoot = require("nupp.compiler.project.env").compilerRoot()
    if modules == nil or compilerRoot == nil then
        return nil
    end
    local fingerprint = require("nupp.compiler.project.fingerprint")
    local digest = fingerprint.contentDigest(true)
    local parts: {string} = {"vm-program/3", mainName, digest(embedded or ""), fingerprint.graphFingerprint(digest)}
    -- An instrumented image is a different program; an ordinary key is unchanged.
    if coverage then
        parts[#parts + 1] = "coverage"
    end
    local names: {string} = {}
    for name in pairs(modules) do
        names[#names + 1] = name
    end
    table.sort(names)
    for _, name in ipairs(names) do
        parts[#parts + 1] = name .. "=" .. tostring((modules[name] as any).sourceHash)
    end
    for _, directory in ipairs({"lib", "decls"}) do
        local files = fs.listFiles(compilerRoot .. "/native/crates/vm/" .. directory)
        table.sort(files)
        for _, path in ipairs(files) do
            parts[#parts + 1] = path .. "=" .. digest(fs.readFile(path) or "")
        end
    end

    return digest(table.concat(parts, "\n"))
end

local function programPayload(
    root: string,
    config: Config,
    target: Target,
    builtOutDir: string?,
    modules: {[string]: any}?
): string?, string?, {string}?, {string}?
    local outDir = builtOutDir or target.outDir or "build"
    local mainName, mainPath = entryModule(root, outDir, target)
    local resources, unreachable, resourceErr = carriedResources(root, config, target, mainName, mainPath, outDir)
    if not resources then
        return nil, resourceErr
    end
    -- The rock modules the target names ride along as a bundle's do, so the
    -- same `require` resolves in a stamped binary. A project module of one
    -- name stays the one the program runs.
    local rocks = deps.rockModules(root, config, target)
    if #rocks > 0 then
        local digest = require("nupp.compiler.project.fingerprint").contentDigest(true)
        local carried: {[string]: any} = {}
        for name, record in pairs(modules or {}) do
            carried[name] = record
        end
        for _, rock in ipairs(rocks) do
            if carried[rock.name] == nil then
                local text, readErr = fs.readFile(rock.path)
                if text == nil then
                    return nil, readErr
                end
                carried[rock.name] = {sourcePath = rock.path, sourceHash = digest(text as string), rock = true}
            end
        end
        modules = carried
    end
    local embedded: string? = nil
    if #resources > 0 then
        local fields = {"return {\n"}
        for _, resource in ipairs(resources) do
            fields[#fields + 1] = interpolate("[%q] = %q,\n", resource.name, resource.text)
        end
        fields[#fields + 1] = "}\n"
        embedded = table.concat(fields)
    end
    -- A coverage build instruments each module whose sites the build recorded,
    -- where the image lowers it from the same file, and then records the sites the
    -- lowering numbered: those are what the image's counters are filed against.
    local coverage: any = nil
    const recorded: {[string]: any} = modules or {}
    if (config as any)._coverage == true and modules ~= nil then
        local function absolute(path: string): string
            return fs.canonical(join(root, path))
        end

        coverage = {
            path = function(name: string, source: string): string?
                local record = recorded[name]
                local manifest = record and record.coverage
                if manifest
                and manifest.path
                and record.sourcePath
                and absolute(source) == absolute(record.sourcePath)
                then
                    return manifest.path
                end

                return nil
            end,
            manifests = {},
        }
    end
    -- Lowering a program is the expensive half of a VM binary build -- minutes for
    -- one that carries the compiler -- and an unchanged target lowers to the same
    -- image, so the last one is kept beside the output under the key it was
    -- emitted for.
    local key = programKey(mainName, embedded, modules, coverage ~= nil)
    local cached = join(root, join(outDir, ".nupp-vm-program"))
    if key ~= nil and fs.readFile(cached .. ".key") == key then
        local kept = fs.readFile(cached .. ".image")
        local keptFacilities = fs.readFile(cached .. ".facilities")
        if kept ~= nil and keptFacilities ~= nil then
            local facilities: {string} = {}
            for facility in keptFacilities:gmatch("[^\n]+") do
                facilities[#facilities + 1] = facility
            end

            return kept, nil, unreachable, facilities
        end
    end
    local ok, image, facilities = pcall(
        require("nupp.tools.vm.project").program,
        root,
        config as table,
        mainName,
        embedded,
        coverage,
        modules
    )
    if not ok then
        return nil, tostring(image)
    end
    if coverage ~= nil then
        for name, manifest in pairs(coverage.manifests as {[string]: any}) do
            recorded[name].coverage = {path = manifest.path, sites = manifest.sites}
        end
    end
    local payload = mainName .. "\n" .. (image as string)
    if key ~= nil then
        -- The key goes last, so an interrupted write is a miss rather than a
        -- stale image served under a current key.
        fs.writeFile(cached .. ".image", payload)
        fs.writeFile(cached .. ".facilities", table.concat(facilities as {string}, "\n") .. "\n")
        fs.writeFile(cached .. ".key", key as string)
    end

    return payload, nil, unreachable, facilities as {string}
end

--- Where a
local function binaryOutput(
    root: string,
    target: Target,
    name: string,
    outDir: string,
    selectedPlatform: string?,
    outDirOverridden: boolean?
): string
    if selectedPlatform then
        local suffix = require("nupp.tools.build.platform").executableSuffix(selectedPlatform)
        if outDirOverridden then
            return join(root, join(outDir, join(name, join(selectedPlatform, name .. suffix))))
        end
        local configured = target.platformOutputs and target.platformOutputs[selectedPlatform]
        return join(root, configured or join(outDir, join(name, join(selectedPlatform, name .. suffix))))
    end

    local hostKey = require("nupp.tools.build.platform").hostKey()
    local hostSuffix = hostKey and require("nupp.tools.build.platform").executableSuffix(hostKey) or ""

    -- A build for this machine gets this machine's suffix. Only the explicitly
    -- selected platform above used to, so building a binary on Windows wrote
    -- `app` where Windows will only run `app.exe` -- the stamp was correct and
    -- what it was called was not.
    --
    -- An `output` the project spelled out named the file it wanted and keeps
    -- it, unless it named one this platform cannot run at all. A name with no
    -- extension is that: `cmd` resolves a command by trying the extensions in
    -- `PATHEXT`, so it finds `app.exe` whether it was asked for `app` or for
    -- `app.exe`, and finds nothing for an extensionless file that is genuinely
    -- there. That is how the manifest's `build/nupp-test` built on Windows and
    -- then answered "is not recognized" when the suite ran it.
    if target.output then
        local spelled = tostring(target.output)
        local named = spelled:match("[^/\\]*$") or spelled
        if hostSuffix ~= "" and not named:find(".", 1, true) then
            spelled = spelled .. hostSuffix
        end
        if outDirOverridden then
            spelled = join(outDir, basename(spelled))
        end

        return join(root, spelled)
    end

    return join(root, join(outDir, name .. hostSuffix))
end

-- The trailer a stub reads to find its payload. Specified in
-- docs/reference/distribution.md; the two implementations are this one and the host's,
-- and they are meant to be read side by side.
local PAYLOAD_MAGIC = "NUPPLOAD"
local PAYLOAD_VERSION = 1
local TRAILER_LENGTH = 48

-- The payload is a VM program: an entry module's name and an image, which the
-- VM runtime it is appended to loads in place of a LuaJIT chunk.
local PAYLOAD_FLAG_VM_PROGRAM: integer = 2

--- `value` as `width` little-endian bytes.
local function littleEndian(value, width)
    local bytes = {}
    for index = 1, width do
        bytes[index] = string.char(value % 256)
        value = math.floor(value / 256)
    end

    return table.concat(bytes)
end

local function integerAt(text: string, offset: number, width: integer): number?
    if offset < 0 or offset + width > #text then
        return nil
    end
    local value = 0
    for index = width - 1, 0, -1 do
        value = value * 256 + text:byte(offset + index + 1)
    end

    return value
end

local function replaceAt(text: string, offset: number, replacement: string): string
    return text:sub(1, offset) .. replacement .. text:sub(offset + #replacement + 1)
end

--- Updates the file-backed size of Mach-O's __LINKEDIT segment. Code signing
--- requires every byte before its signature to belong to a segment; the payload is
--- deliberately part of __LINKEDIT even though the loader itself reads the trailer.
local function sizeMachOLinkedit(text: string): string?, string?
    if text:sub(1, 4) ~= "\207\250\237\254" then
        return text
    end
    local commands = integerAt(text, 16, 4)
    local commandBytes = integerAt(text, 20, 4)
    if not commands or not commandBytes or 32 + commandBytes > #text then
        return nil, "cannot stamp malformed arm64 Mach-O load commands"
    end
    local cursor: number = 32
    for _ = 1, commands do
        local kind = integerAt(text, cursor, 4)
        local length = integerAt(text, cursor + 4, 4)
        if not kind or not length or length < 8 or cursor + length > 32 + commandBytes then
            return nil, "cannot stamp malformed arm64 Mach-O load command"
        end
        if kind == 0x19 and text:sub(cursor + 9, cursor + 24):match("^__LINKEDIT") then
            local fileOffset = integerAt(text, cursor + 40, 8)
            local vmSize = integerAt(text, cursor + 32, 8)
            if not fileOffset or not vmSize or fileOffset > #text then
                return nil, "cannot stamp malformed arm64 Mach-O __LINKEDIT segment"
            end
            -- The segment must map at least what the file holds. A linker that
            -- sized it tightly (lld does) leaves no room for the payload.
            local fileSize = #text - fileOffset
            const PAGE = 16384
            local mapped = math.max(vmSize, math.ceil(fileSize / PAGE) * PAGE)
            text = replaceAt(text, cursor + 32, littleEndian(mapped, 8))

            return replaceAt(text, cursor + 48, littleEndian(fileSize, 8))
        end
        cursor = cursor + length
    end

    return text
end

--- Removes an existing Mach-O signature before stamping. Leaving it in place creates
--- trailing bytes which Apple's signer refuses; removing its load command and blob
--- lets a native release signer cover the complete payload afterwards.
local function unsignedMachOStub(text: string): string?, string?
    if text:sub(1, 4) ~= "\207\250\237\254" then
        return text
    end
    local commands = integerAt(text, 16, 4)
    local commandBytes = integerAt(text, 20, 4)
    if not commands or not commandBytes or 32 + commandBytes > #text then
        return nil, "cannot stamp malformed arm64 Mach-O load commands"
    end
    local cursor: number = 32
    local signatureAt: number?
    local signatureSize: number?
    local signatureCommand: number?
    local signatureCommandSize: number?
    for _ = 1, commands do
        local kind = integerAt(text, cursor, 4)
        local length = integerAt(text, cursor + 4, 4)
        if not kind or not length or length < 8 or cursor + length > 32 + commandBytes then
            return nil, "cannot stamp malformed arm64 Mach-O load command"
        end
        if kind == 0x1d then
            signatureAt = integerAt(text, cursor + 8, 4)
            signatureSize = integerAt(text, cursor + 12, 4)
            signatureCommand, signatureCommandSize = cursor, length
            break
        end
        cursor = cursor + length
    end
    if not signatureCommand then
        return text
    end
    if not signatureAt or not signatureSize or signatureAt + signatureSize ~= #text then
        return nil, "cannot stamp a Mach-O whose code signature is not its final blob"
    end
    local foundCommand = assert(signatureCommand)
    local foundCommandSize = assert(signatureCommandSize)
    local loadCommands = text:sub(33, 32 + commandBytes)
    local relative = foundCommand - 32
    loadCommands = loadCommands:sub(
        1,
        relative
    ) .. loadCommands:sub(relative + foundCommandSize + 1) .. ("\0"):rep(foundCommandSize)
    text = replaceAt(text, 16, littleEndian(commands - 1, 4))
    text = replaceAt(text, 20, littleEndian(commandBytes - foundCommandSize, 4))
    text = replaceAt(text, 32, loadCommands)
    text = text:sub(1, signatureAt)

    return sizeMachOLinkedit(text)
end

--- A stub with `payload` appended and a trailer saying where it starts. A signed
--- Mach-O is first made unsigned and its __LINKEDIT segment grows over the appended
--- bytes, so Apple's native signer can put a new signature after the trailer.
local function stampBinary(stubText: string, payload: string, flags: integer?, macTarget: boolean?): string?, string?
    if macTarget then
        local unsigned, unsignedErr = unsignedMachOStub(stubText)
        if not unsigned then
            return nil, unsignedErr
        end
        stubText = unsigned
    end
    local offset = #stubText
    local trailer = PAYLOAD_MAGIC .. littleEndian(
        PAYLOAD_VERSION,
        4
    ) .. littleEndian(
        flags or 0,
        4
    ) .. littleEndian(
        offset,
        8
    ) .. littleEndian(#payload, 8) .. hash.trailerDigest(payload) .. littleEndian(TRAILER_LENGTH, 8)
    assert(#trailer == TRAILER_LENGTH, "the trailer is a fixed size")

    local stamped = stubText .. payload .. trailer
    if macTarget then
        return sizeMachOLinkedit(stamped)
    end

    return stamped
end

--- Writes `payload` into a copy of the stub at `output`, executable and, on a
--- Mac, ad-hoc signed so it runs where it was built. Release automation signs
--- with a Developer ID and notarizes the archive. See
--- [distribution.md](docs/reference/distribution.md).
local function stampFile(output: string, stubText: string, payload: string, flags: integer?): boolean?, string?
    local macTarget = require("nupp.tools.build.platform").hostSystem() == "darwin"
        and stubText:sub(1, 4) == "\207\250\237\254"
    local stampedText, stampErr = stampBinary(stubText, payload, flags, macTarget)
    if not stampedText then
        return nil, stampErr
    end
    local written, writeErr = writeFile(output, stampedText)
    if not written then
        return nil, tostring(writeErr)
    end
    if require("nupp.tools.build.platform").hostSystem() ~= "windows" then
        local code, chmodErr = process.capture({"chmod", "+x", output})
        if code ~= 0 then
            return nil, "cannot make " .. output .. " executable: " .. tostring(chmodErr)
        end
    end

    -- A build must be immediately runnable. Ad-hoc signing has no timestamp and
    -- a fixed identifier, so it preserves the packaging fixpoint.
    if require("nupp.tools.build.platform").hostSystem() == "darwin" and stubText:sub(1, 4) == "\207\250\237\254" then
        local code, signErr = process.capture({
            "codesign",
            "--force",
            "--sign",
            "-",
            "--identifier",
            "org.nupp.binary",
            output
        })
        if code ~= 0 then
            return nil, "cannot ad-hoc sign " .. output .. ": " .. tostring(signErr)
        end
    end

    return true
end

package_.entryModule = entryModule
package_.carriedResources = carriedResources
package_.binaryOutput = binaryOutput
package_.stampFile = stampFile
package_.stampBinary = stampBinary
package_.payloadFlagVmProgram = PAYLOAD_FLAG_VM_PROGRAM
package_.programPayload = programPayload

export = package_
