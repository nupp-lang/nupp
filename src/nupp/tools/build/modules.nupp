module nupp.tools.build.modules

--[[
Compiling the modules a target reaches, and writing them out.

The entry points name a graph; this walks it, checks and generates each module
that is not already current, and copies the resources the target declared. What
"already current" means is the fingerprint of everything the module saw -- its
own text, the interfaces it imported, the compiler that would compile it -- so a
change anywhere in that set rebuilds it and a change anywhere else does not.
]]
const files = require("nupp.io.files")
const {type Target as Target2} = require("nupp.tools.build.manifest")
const {type Inc} = require("nupp.compiler.project.incremental")
const {type ConstTerm} = require("nupp.compiler.types")
const {type Type} = require("nupp.compiler.types")
const {type Pack} = require("nupp.compiler.types")
const {type Resource} = require("nupp.tools.build.manifest")
const {type DependencyRecord} = require("nupp.tools.build.cache")
const {type Reporter} = require("nupp.tools.build.progress")
const {type Observer} = require("nupp.compiler.project.incremental")
const {type Value} = require("nupp.compiler.project.store")

local aotcheck = require("nupp.tools.build.aotcheck")
local envMod = require("nupp.compiler.project.env")
local gen = require("nupp.compiler.lua.gen")
local optimize = require("nupp.compiler.lua.optimize")
local hash = require("nupp.compiler.hash")
local incremental = require("nupp.compiler.project.incremental")
local diagnosticMod = require("nupp.compiler.diagnostics")
local fs = require("nupp.compiler.fs")
local cache = require("nupp.tools.build.cache")
local fingerprint = require("nupp.compiler.project.fingerprint")
local deps = require("nupp.tools.build.deps")
local materializeObserve = require("nupp.compiler.comptime.materialize.observe")
local progress = require("nupp.tools.build.progress")
local constspecialize = require("nupp.compiler.lua.constspecialize")
local native = require("nupp.compiler.native")
local moduleTargets = require("nupp.compiler.standardsurface")

local normalize, join = fs.normalize, fs.join
local readFile, writeFile = fs.readFile, fs.writeFile
local stable = require("nupp.compiler.stable")
local hashFile, jsonArray = fingerprint.hashFile, cache.jsonArray
local expandGlob = deps.expandGlob
local isFatal, printErrors = diagnosticMod.isFatal, diagnosticMod.report

local modules = {}
local parallelWorkerContext: any? = nil
local parallelWorkerInitialized = false

local function hiddenDirectory(name: string): boolean
    return name:sub(1, 1) == "."
end

--- The source set one explicitly scoped target owns.
---
--- `sources` has always meant project-relative files or directories to the docs
--- target. Module targets use the same source form and recursion here; the only
--- difference is the file kinds they can compile. A glob may select files, while a
--- directory selected without a glob is walked recursively. Every selection has to
--- name something so a misspelling cannot quietly produce a smaller artifact.
local function selectedSourceFiles(root: string, target: Target): ({string}?, string?)
    if target.sources == nil then
        return nil
    end

    local selected, seen = {}, {}
    for _, source in ipairs(target.sources) do
        local normalized = normalize(source)
        if normalized == ""
            or normalized:sub(1, 1) == "/"
            or normalized:match("^[A-Za-z]:/")
            or ("/" .. normalized .. "/"):find("/../", 1, true)
        then
            return nil, "build.sources must stay inside the project: " .. source
        end
        local matches = expandGlob(root, normalized)
        if #matches == 0 then
            return nil, "build.sources matched nothing: " .. source
        end
        local candidates: {string} = {}
        for _, matched in ipairs(matches) do
            local info = files.info(matched)
            if info and info.kind == "directory" then
                for _, path in ipairs(fs.listFiles(matched, hiddenDirectory)) do
                    candidates[#candidates + 1] = path
                end
            else
                candidates[#candidates + 1] = matched
            end
        end
        local accepted = 0
        for _, path in ipairs(candidates) do
            path = normalize(path)
            if (path:match("%.nupp$") and not path:match("%.d%.nupp$")) or path:match("%.lua$") then
                accepted = accepted + 1
                if not seen[path] then
                    seen[path] = true
                    selected[#selected + 1] = path
                end
            end
        end
        if accepted == 0 then
            return nil, "build.sources selected no compilable source: " .. source
        end
    end
    table.sort(selected)

    return selected
end

local function exportDefinitionFingerprint(exports: any): string
    local items = {}
    for _, field in ipairs({"typeDefs", "valueDefs"}) do
        for name, definition in pairs(exports and exports[field] or {}) do
            local deprecated = definition.deprecated
            if deprecated then
                items[
                    #items + 1
                ] = field .. ":" .. name .. ":" .. stable(deprecated.reason) .. ":" .. stable(deprecated.replacement)
            end
            if definition.comptimeOnly then
                items[#items + 1] = field .. ":" .. name .. ":comptime"
            end
        end
    end
    table.sort(items)

    return table.concat(items, "\0")
end

-- Named by module path rather than required: what these say is wanted at compile time
-- and nothing of them is at run time.
const {type Config} = require("nupp.tools.build.manifest")
local type Target = Target2
const {type State} = require("nupp.tools.build.cache")

--- What a build did, for a caller that would otherwise only be able to observe that
--- something got faster.
---
--- The three are set before anything is compiled, so a caller passes an empty table and
--- reads it back filled in. A check counts the same way a build does, which is what
--- lets a test say "this edit rechecked one module".
type modules.Stats = {
    checkedModules: number,
    generatedModules: number,
    reusedModules: number,
    specializedBodies: number,
    [string]: any
}

--- What a modules build wrote, as a set of paths.
---
--- A check produces none of them and says so with an empty one, which is what lets the
--- caller treat both the same way.
type modules.Result = {
    outputs: {[string]: boolean},

    materializations: {any},
    derives: {any},
    optimizationRemarks: {any},
    allocationSites: {any},
    accountedModules: integer,

    --- Every native feature the built modules asked for, merged.
    effects: {[string]: any}?

}

--- A check asked about named files rather than about the project.
---
--- `paths` is what it was asked about, and `unchecked` is filled in with the ones this
--- walk cannot reach: a declaration file, a `.lua`, a file from outside the project.
--- Those are still worth checking and the caller still has to, so they are handed back
--- rather than refused. It is filled in as they are found, not on the way out, because
--- a run whose named files have errors returns early and the caller needs the list
--- either way.
type modules.Narrow = {
    paths: {string},
    unchecked: {string}
}

--- The query graph one build checks through, and what checking charged where.
---
--- One per build rather than one per phase. The ahead-of-time policy checks the
--- sources it lowers before the module build checks the project, and those
--- sources import most of what the project imports; a second graph would answer
--- every one of those imports again and answer it the same way.
record modules.Session
    --- The graph.
    inc: Inc

    --- What each file's own check cost, by path, with the dependencies it pulled
    --- in charged to themselves. A module's check reaches its imports through
    --- the query graph, so the inclusive time of the first module compiled is
    --- most of the build and naming it the slowest would be true of whichever
    --- module happened to go first. Subtracting what the nested checks announced
    --- is what makes the number the module's own.
    checkMs: {[string]: number}

    --- Materializes one compiler-carried module into this build's staging tree and
    --- answers where it landed, or nil when the compiler carries no such module. A
    --- module the project can already reach answers its own path and stages nothing.
    ---
    --- Shared by metadata checking, AOT, and module compilation.
    stageBundled: function(string, boolean?): string?

    --- Stages the compiler-carried native GPU runtime -- the layout, the native
    --- binding, its provider and the `nupp.gpu` facade -- for a source that
    --- declares a GPU target under `aot = "require"`.
    stageGpuRuntime: function(): nil
end

--- Canonical binder numbering for one fingerprint: the number each binder was given,
--- and how many have been handed out. Numbering by first encounter rather than by
--- name is what makes two binders that shadow each other compare unequal, and what
--- keeps renaming one from reading as a changed interface.
local type Binders = {
    order: {[any]: integer},
    count: integer
}

local function binderFingerprint(binder: any, binders: Binders, prefix: string): string
    local at = binders.order[binder]
    if not at then
        at = binders.count + 1
        binders.count = at
        binders.order[binder] = at
    end

    return prefix .. "#" .. at
end

local function constFingerprint(term: ConstTerm?, binders: Binders): string
    if not term then
        return "nil"
    end
    if term.tag == "constLiteral" then
        return "const(" .. term.domain .. ":" .. stable(term.value) .. ")"
    elseif term.tag == "constVar" then
        return binderFingerprint(term, binders, "constvar") .. ":" .. term.domain
    end
    local operands = {}
    for j, operand in ipairs(term.operands) do
        operands[j] = constFingerprint(operand, binders)
    end

    return "constop(" .. term.operation .. ":" .. table.concat(operands, ",") .. ")"
end

local typeFingerprint: function(Type?, {[Type]: boolean}?, Binders?): string

local function packFingerprint(pack: Pack, active: {[Type]: boolean}, binders: Binders): string
    if pack.alternatives then
        local alternatives = {}
        for j, alternative in ipairs(pack.alternatives) do
            alternatives[j] = packFingerprint(alternative, active, binders)
        end
        return "packunion(" .. table.concat(alternatives, "|") .. ")"
    end
    local head = {}
    for j, member in ipairs(pack.head) do
        head[j] = (pack.modes[j] or "plain") .. ":" .. typeFingerprint(member, active, binders)
    end
    local tail = pack.tail
    local tailFingerprint = "-"
    if tail and tail.kind == "generic" then
        tailFingerprint = "generic:" .. binderFingerprint(tail.var, binders, "packvar")
    elseif tail and tail.type then
        tailFingerprint = tail.kind .. ":" .. (
            tail.mode or "plain"
        ) .. ":" .. typeFingerprint(tail.type, active, binders)
    end

    return "pack(" .. table.concat(head, ",") .. ";" .. tailFingerprint .. ")"
end

typeFingerprint = function(t: Type?, active: {[Type]: boolean}?, binders: Binders?): string
    if not t then
        return "nil"
    end
    active = active or {}
    binders = binders or {order = {}, count = 0}
    if active[t] then
        -- Only some tags carry a name. One that does not is identified by its tag,
        -- which every type has, and asking is what the cast is for.
        local named = t as {name: string?}
        return "@" .. (named.name or t.tag)
    end
    active[t] = true
    local tag, value = t.tag, nil
    if tag == "nominal" then
        -- A nominal is its declaration: one identity per declaration, never shared with
        -- another of the same shape. So naming the declaration identifies it
        -- completely, and its members are deliberately not expanded here.
        --
        -- Expanding them is not merely redundant, it does not terminate usefully: a
        -- member's type reaches other nominals, whose members reach further, and
        -- fingerprinting this compiler that way runs out of memory. A changed record
        -- is caught by the keyed project-index dependency of each module that read it.
        --
        -- This loop used to read `t.fields`, which nominals stopped having when the
        -- member map was renamed to `byname`, so it had been contributing nothing for
        -- some time. Saying so is the fix; putting the members back in is not.
        local arguments = {}
        for _, argument in ipairs(t.typeArgs or {}) do
            arguments[#arguments + 1] = typeFingerprint(argument, active, binders)
        end
        for _, argument in ipairs(t.packArgs or {}) do
            arguments[#arguments + 1] = packFingerprint(argument, active, binders)
        end
        for _, argument in ipairs(t.constArgs or {}) do
            arguments[#arguments + 1] = constFingerprint(argument, binders)
        end
        value = "nominal(" .. tostring(
            t.declKind
        ) .. ":" .. tostring(t.name) .. (#arguments > 0 and "<" .. table.concat(arguments, ",") .. ">" or "") .. ")"
    elseif tag == "shape" then
        local fields = {}
        for _, field in ipairs(t.fields or {}) do
            fields[
                #fields + 1
            ] = field.name .. ":r=" .. typeFingerprint(
                field.read,
                active,
                binders
            ) .. ":w=" .. typeFingerprint(field.write, active, binders)
        end
        fields[
            #fields + 1
        ] = "index:r=" .. typeFingerprint(
            t.indexReadKey,
            active,
            binders
        ) .. ":" .. typeFingerprint(
            t.indexReadValue,
            active,
            binders
        ) .. ":w=" .. typeFingerprint(
            t.indexWriteKey,
            active,
            binders
        ) .. ":" .. typeFingerprint(t.indexWriteValue, active, binders)
        value = "shape(" .. table.concat(fields, ",") .. ")"
    elseif tag == "func" then
        local params, returns = {}, {}
        local typeAt: integer, packAt: integer, constAt: integer = 1, 1, 1
        for _, kind in ipairs(t.paramKinds or {}) do
            if kind == "type" then
                binderFingerprint((t.typeParams or {})[typeAt], binders, "typevar")
                typeAt = typeAt + 1
            elseif kind == "pack" then
                binderFingerprint((t.packParams or {})[packAt], binders, "packvar")
                packAt = packAt + 1
            elseif kind == "const" then
                binderFingerprint((t.constParams or {})[constAt], binders, "constvar")
                constAt = constAt + 1
            end
        end
        for index, item in ipairs(t.params or {}) do
            params[
                #params + 1
            ] = tostring(
                t.paramNames and t.paramNames[index] or ""
            ) .. "=" .. tostring(
                t.paramModes and t.paramModes[index] or "plain"
            ) .. ":" .. typeFingerprint(item, active, binders)
        end
        for _, item in ipairs(t.rets or {}) do
            returns[#returns + 1] = typeFingerprint(item, active, binders)
        end
        -- The suspension guarantee is part of the boundary a dependent compiled
        -- against, so a body that starts yielding has to invalidate a reuse of it. The
        -- interning key carries the same qualifier for the in-memory cutoff; these are
        -- two identity mechanisms and both need telling.
        local partitions = {}
        for result, fields in pairs(t.partitionResults or {}) do
            for name, region in pairs(fields) do
                partitions[#partitions + 1] = tostring(result) .. ":" .. name .. "=" .. region
            end
        end
        table.sort(partitions)
        value = "fn(" .. table.concat(
            params,
            ","
        ) .. (
            t.vararg and ",..." or ""
        ) .. ")->(" .. table.concat(
            returns,
            ","
        ) .. ")" .. (
            #partitions > 0 and "!partition(" .. table.concat(partitions, ",") .. ")" or ""
        ) .. (t.noYield and "!noyield" or "") .. (t.comptimeOnly and "!comptime" or "")
    elseif tag == "array" or tag == "ptr" then
        value = tag .. "(" .. typeFingerprint(t.elem, active, binders) .. ")"
    elseif tag == "carray" then
        value = "carray(" .. typeFingerprint(
            t.elem,
            active,
            binders
        ) .. ":" .. constFingerprint(t.countTerm, binders) .. ")"
    elseif tag == "affine" then
        local cleanupIds = {}
        for j, cleanup in ipairs(t.cleanups or {}) do
            cleanupIds[j] = cleanup.id
        end
        value = tag .. "(" .. table.concat(
            cleanupIds,
            ","
        ) .. (t.transferOnly and ":transfer" or "") .. "," .. typeFingerprint(t.inner, active, binders) .. ")"
    elseif tag == "borrowed" or tag == "pinned" then
        value = tag .. "(" .. typeFingerprint(t.inner, active, binders) .. ")"
    elseif tag == "map" then
        value = "map(r=" .. (
            t.readable and typeFingerprint(t.key, active, binders) or "nil"
        ) .. ":" .. (
            t.readable and typeFingerprint(t.value, active, binders) or "nil"
        ) .. ",w=" .. typeFingerprint(
            t.writeKey,
            active,
            binders
        ) .. ":" .. typeFingerprint(t.writeValue, active, binders) .. ")"
    elseif tag == "tuple" then
        local items = {}
        for _, item in ipairs(t.elems or {}) do
            items[#items + 1] = typeFingerprint(item, active, binders)
        end
        value = "tuple(" .. table.concat(items, ",") .. ")"
    elseif tag == "union" or tag == "intersection" then
        local items = {}
        for _, item in ipairs(t.members or {}) do
            items[#items + 1] = typeFingerprint(item, active, binders)
        end
        table.sort(items);
        value = tag .. "(" .. table.concat(items, tag == "union" and "|" or "&") .. ")"
    elseif tag == "projection" then
        -- Through the canonical head, so two projections off binders that share a name
        -- are two boundaries. Without a case here a projection renders as its bare tag
        -- and every one of them compares equal, which is the collision the binder
        -- numbering above exists to prevent.
        value = "proj(" .. typeFingerprint(t.of, active, binders) .. "," .. t.name .. ")"
    elseif tag == "typeHandle" then
        value = "typeHandle(" .. typeFingerprint(t.bound, active, binders) .. ")"
    elseif tag == "packResult" then
        value = "packResult(" .. packFingerprint(t.pack, active, binders) .. ")"
    elseif tag == "literal" then
        value = "literal(" .. stable(t.constant) .. ":" .. typeFingerprint(t.base, active, binders) .. ")"
    elseif tag == "neutral" then
        local templates, comptimeArguments = {}, {}
        for _, part in ipairs(t.templateParts or {}) do
            templates[#templates + 1] = type(part) == "string" and "text(" .. stable(part) .. ")"
                or typeFingerprint(part as Type, active, binders)
        end
        for _, argument in ipairs(t.comptimeArguments or {}) do
            if argument.kind == "type" then
                comptimeArguments[#comptimeArguments + 1] = "type=" .. typeFingerprint(argument.value, active, binders)
            elseif argument.kind == "typepack" then
                comptimeArguments[#comptimeArguments + 1] = "pack=" .. packFingerprint(argument.value, active, binders)
            else
                comptimeArguments[#comptimeArguments + 1] = "const=" .. constFingerprint(argument.value, binders)
            end
        end
        value = "neutral#1(" .. t.op .. ":" .. tostring(
            t.capability or "-"
        ) .. ":subject=" .. typeFingerprint(
            t.subject,
            active,
            binders
        ) .. ":key=" .. typeFingerprint(
            t.key,
            active,
            binders
        ) .. ":binder=" .. typeFingerprint(
            t.binder,
            active,
            binders
        ) .. ":keys=" .. typeFingerprint(
            t.keys,
            active,
            binders
        ) .. ":value=" .. typeFingerprint(
            t.value,
            active,
            binders
        ) .. ":remap=" .. typeFingerprint(
            t.remap,
            active,
            binders
        ) .. ":const=" .. constFingerprint(
            t.constTerm,
            binders
        ) .. ":template=" .. table.concat(
            templates,
            ","
        ) .. ":comptime=" .. tostring(
            t.comptimeIdentity or "-"
        ) .. "(" .. table.concat(comptimeArguments, ",") .. "):" .. (t.comptimeResultPack and "pack" or "type") .. ")"
    elseif tag == "genericAlias" then
        local parameters = {}
        for _, parameter in ipairs(t.typeParams or {}) do
            parameters[#parameters + 1] = typeFingerprint(parameter, active, binders)
        end
        for _, parameter in ipairs(t.packParams or {}) do
            parameters[#parameters + 1] = binderFingerprint(parameter, binders, "packvar")
        end
        for _, parameter in ipairs(t.constParams or {}) do
            parameters[#parameters + 1] = binderFingerprint(parameter, binders, "constvar") .. ":" .. parameter.domain
        end
        value = "alias(" .. table.concat(parameters, ",") .. ":" .. typeFingerprint(t.body, active, binders) .. ")"
    elseif tag == "typevar" then
        -- By position rather than by name. A binder's name is not its identity: two
        -- that shadow each other are two types and have to compare unequal, or an
        -- interface that changed compares unchanged and nothing downstream rebuilds.
        -- Numbering in first-encounter order also means renaming one is not a change,
        -- and neither is moving the declaration, which the interned identity records
        -- by source position.
        value = binderFingerprint(t, binders, "typevar")
    else
        value = tag or tostring(t)
    end
    active[t] = nil

    return value
end

--- What a module's readers depend on, as one digest: its type, the definition
--- metadata that changes how an export may be used (deprecations, comptime-only
--- aliases), the nominal, derive and comptime-function fingerprints the checker
--- publishes beside it. An external
--- module adds its source hash, since nothing else of a declaration file is
--- recorded.
---
--- The one function for it, so the build's records and the hot session's
--- snapshots cannot disagree about what an interface change is.
function modules.interfaceHash(
    moduleType: Type?,
    exports: any,
    externalSourceHash: string?,
    digest: (function(string): string)?
): string
    exports = exports or {}

    return (
        digest or hash.digest
    )(
        typeFingerprint(
            moduleType
        ) .. "\0definitions\0" .. exportDefinitionFingerprint(
            exports
        ) .. "\0nominal-callables:" .. (
            exports.nominalEffectFingerprint or ""
        ) .. "\0derives:" .. (
            exports.deriveInterfaceFingerprint or ""
        ) .. "\0comptime-functions:" .. (
            exports.comptimeFunctionFingerprint or ""
        ) .. (externalSourceHash and ("\0" .. externalSourceHash) or "")
    )
end

--- A path as a progress line should say it: relative to the project root, so a
--- step reads the same wherever the project was checked out.
local function shortPath(root: string, path: string): string
    local rootPrefix = normalize(root)
    if rootPrefix ~= "." and path:sub(1, #rootPrefix + 1) == rootPrefix .. "/" then
        return path:sub(#rootPrefix + 2)
    end

    return path
end

local function resourceRelative(config: Config, path: string, root: string): string
    local normalized = normalize(path)
    local rootPrefix = normalize(root)
    if rootPrefix ~= "." and normalized:sub(1, #rootPrefix + 1) == rootPrefix .. "/" then
        normalized = normalized:sub(#rootPrefix + 2)
    end
    local best = normalized
    for _, include in ipairs(config.include or {}) do
        include = normalize(include)
        if normalized:sub(1, #include + 1) == include .. "/" then
            local relative = normalized:sub(#include + 2)
            if #relative < #best then
                best = relative
            end
        end
    end

    return best
end

local function resourceOutput(config: Config, resource: string | Resource, source: string, root: string): string
    if type(resource) == "table" then
        return normalize((resource as Resource).output)
    end

    return resourceRelative(config, source, root)
end

local function copyModuleRecord(record)
    local dependencies = jsonArray({} as {string})
    for _, name in ipairs(record.dependencies or {}) do
        dependencies[#dependencies + 1] = name
    end
    local runtimeModules = jsonArray({} as {string})
    for _, name in ipairs(record.runtimeModules or {}) do
        runtimeModules[#runtimeModules + 1] = name
    end
    local externalInputs = jsonArray({} as {any})
    for _, input in ipairs(record.externalInputs or {}) do
        externalInputs[#externalInputs + 1] = {path = input.path, fingerprint = input.fingerprint}
    end
    local effects = jsonArray({} as {string})
    for _, effect in ipairs(record.effects or {}) do
        effects[#effects + 1] = effect
    end
    local projectDependencies = jsonArray({} as {DependencyRecord})
    for _, dependency in ipairs(record.projectDependencies or {}) do
        projectDependencies[
            #projectDependencies + 1
        ] = {name = dependency.name, key = dependency.key, fingerprint = dependency.fingerprint,}
    end

    return {
        sourcePath = record.sourcePath,
        sourceHash = record.sourceHash,
        interfaceHash = record.interfaceHash,
        artifactHash = record.artifactHash,
        dependencies = dependencies,
        runtimeModules = runtimeModules,
        compilerRuntime = record.compilerRuntime,
        projectDependencies = projectDependencies,
        externalInputs = externalInputs,
        effects = effects,
        output = record.output,
        external = record.external,
        diags = record.diags,
        aotRefusals = record.aotRefusals,
        aotKey = record.aotKey,
        aotFamilies = record.aotFamilies,
        aotGraphRefusals = record.aotGraphRefusals,
        aotGraphKey = record.aotGraphKey,
        coverage = record.coverage,
        materializations = record.materializations,
        derives = record.derives,
        optimizationRemarks = record.optimizationRemarks,
        allocationSites = record.allocationSites,
        optimizationAccounted = record.optimizationAccounted,
        specializationHash = record.specializationHash,
    }
end

--- Opens the query graph a build checks through.
---
--- Separate from the build so the phases that run before it can check through the
--- same graph. `strict` holds every file to the strict floor whatever it is named;
--- nil lets each file's extension decide.
local function openSession(
    root: string,
    outDir: string,
    config: Config,
    target: Target,
    dependencies: {[string]: DependencyRecord},
    strict: boolean?,
    reporter: Reporter?,
    projectNominals: {[string]: any}?,
    isolated: boolean?,
    checkGuard: (function(string): nil)?
): modules.Session
    local report = reporter or progress.new("never")
    local envConfig = {}
    for key, value in pairs(config) do
        envConfig[key] = value
    end
    envConfig.include = {}
    for _, include in ipairs(config.include or {}) do
        envConfig.include[#envConfig.include + 1] = include
    end
    envConfig.include[#envConfig.include + 1] = join(outDir, "generated")
    local generatorNames: {string} = {}
    for name in pairs(config.generators or {}) do
        generatorNames[#generatorNames + 1] = name
    end
    table.sort(generatorNames)
    for _, name in ipairs(generatorNames) do
        envConfig.include[#envConfig.include + 1] = join(outDir, "generated/" .. name)
    end
    local rocks = deps.rockPaths(root, config, target, dependencies)
    local ambientTypeRoots = deps.typeRoots(root, config, dependencies)
    local checkMs: {[string]: number} = {}
    local stagedRoot = join(root, join(outDir, "cache/runtime-source"))
    local stagedReady = false
    local open: {{
        startedAt: number,
        children: number
    }} = {}
    -- What the build was doing when the outermost check began, to go back to when it
    -- ends.
    local resumeActivity = "scan"
    local observer: Observer = {
        checking = function(path: string): nil
            if checkGuard then
                checkGuard(path)
            end
            -- Checking is charged wherever it happens rather than only where this file
            -- calls for it. Deciding a module can be reused reaches the checker too, so
            -- a build that compiles nothing at all would otherwise report its whole
            -- runtime as bookkeeping.
            if #open == 0 then
                resumeActivity = report.activity
                report:at(report.checking)
            end
            open[#open + 1] = {startedAt = progress.now(), children = 0}
            report:step("checking " .. shortPath(root, path))
        end,
        checked = function(path: string): nil
            local frame = open[#open]
            if not frame then
                return
            end
            open[#open] = nil
            local spent = progress.now() - frame.startedAt
            local parent = open[#open]
            if parent then
                parent.children = parent.children + spent
            end
            checkMs[path] = (checkMs[path] or 0) + spent - frame.children
            if #open == 0 then
                report:at(resumeActivity)
            end
        end,
    }

    local inc = incremental.new(root, {
        config = envConfig,
        strict = strict,
        nativeCompilerServices = true,
        typeRoots = rocks and rocks.typeRoots or {},
        ambientTypeRoots = ambientTypeRoots,
        runtimeSourceRoots = {stagedRoot},
        observe = observer,
        projectNominals = projectNominals,
        -- Workers may load compiler products prepared by the coordinator, but never
        -- publish to those stores. Their project semantics arrive in requests.
        cacheReadOnly = isolated or nil,
    })

    local stageBundled: function(string, boolean?): string?
    stageBundled = function(name: string, replaceTypeOnly: boolean?): string?
        local existing = inc.modulePath(name)
        if existing ~= nil and not (replaceTypeOnly and envMod.isDependencyTypePath(inc.env, existing)) then
            return existing
        end
        local carried = require("nupp.compiler.bundled")
        local source: string? = nil
        local resource = ""
        -- `.lua` last and included at all because a checked provider may be the layer
        -- over a vendored library, and that library is plain Lua the compiler carries
        -- rather than Nupp it compiles. Staging it is what puts it on the ordinary
        -- path: linked like any dependency, carried into the artifact like any module.
        for _, suffix in ipairs({".nupp", ".g.nupp", "/init.nupp", "/init.g.nupp", ".d.nupp", ".lua"}) do
            resource = "/" .. name:gsub("%.", "/") .. suffix
            source = carried.source(resource)
            if source ~= nil then
                break
            end
        end
        if source == nil then
            return nil
        end
        if not stagedReady then
            if not isolated then
                files.remove(stagedRoot, true)
                assert(fs.mkdir(stagedRoot), "cannot create runtime source staging tree")
            end
            inc.env.roots[#inc.env.roots + 1] = stagedRoot
            stagedReady = true
        end
        local suffix = resource:match("/init%.g%.nupp$") and "/init.g.nupp"
            or resource:match("/init%.nupp$") and "/init.nupp"
            or resource:match("%.g%.nupp$") and ".g.nupp"
            or resource:match("%.d%.nupp$") and ".d.nupp"
            or resource:match("%.lua$") and ".lua"
            or ".nupp"
        local path = join(stagedRoot, name:gsub("%.", "/") .. suffix)
        if not isolated then
            local wrote, problem = writeFile(path, source)
            assert(wrote, problem)
        end
        inc.openDocument(path, source)
        local header = inc.projectHeader(path)
        for _, dependency in ipairs(header and header.dependencies or {}) do
            stageBundled(dependency, replaceTypeOnly)
        end

        return path
    end

    local function stageGpuRuntime(): nil
        stageBundled("nupp.gpu.internal")
        stageBundled("nupp.gpu.layout")
        if target.host ~= "browser" then
            stageBundled("nupp.runtime.native")
        end
        stageBundled("nupp.gpu")
    end

    return new modules.Session(
        inc = inc,
        checkMs = checkMs,
        stageBundled = stageBundled,
        stageGpuRuntime = stageGpuRuntime
    )
end

--- The sidecar queries whose answer is a module's own body rather than its
--- interface, keyed the way a recorded project dependency names them.
---
--- Confirming one by asking costs a full check of the module the key names, and a
--- fresh process has no memo to answer from: a project where nothing changed spent
--- all of its time checking a hundred and eighty modules to be told each of their
--- cache entries was good. So a reuse decision skips them and the invalidation
--- fixpoint settles them instead, where a module that is itself still reused has
--- already said its body did not move.
local GUARANTEE_QUERY = {moduleCallGuarantees = true, moduleCallGuarantee = true}

local function buildModules(root: string, outDir: string, config: Config, target: Target, oldState: State, newState: State, checkOnly: boolean?, strict: boolean?, stats: modules.Stats?, diagnostics: {
    any
}?, checkState: Value?,

    --- Set when a check was asked about named files rather than about the project. Only
    --- a check narrows: a build compiles the whole source set, because a module nobody
    --- requires is still part of the program.
    narrow: modules.Narrow?,

    --- Where what this is doing, and what it costs, is said. A run given none still
    --- measures itself into a reporter that shows nothing, so there is one code path
    --- rather than a nil test at every step.
    reporter: Reporter?,

    --- Source path -> the text to compile instead of what is on disk. How the
    --- ahead-of-time policy puts a wrapper in front of an `@aot` function: the
    --- substitute is checked and hashed exactly like a file, so nothing
    --- downstream has to know one happened.
    overlays: {[string]: string}?,

    --- Source path -> what reading that path as written said about bindings
    --- nothing uses. One thing downstream does have to know a substitution
    --- happened: a wrapper replaces the body, so the rewritten source cannot see
    --- the readers that body was, and its answer to that lint is about a file
    --- nobody wrote. These are reported in its place.
    authoredUnused: {[string]: {any}}?,

    --- The graph to check through, when an earlier phase already opened one. A
    --- build given none opens its own, so there is one way a session is built
    --- rather than two that could drift.
    session: modules.Session?,

    --- The paths an isolated semantic worker owns. Dependencies outside this set
    --- arrive as checked interfaces and must not enter its build queue.
    assignedPaths: {[string]: boolean}?): modules.Result?, string?
    local report = reporter or progress.new("never")
    local opened = session or openSession(root, outDir, config, target, newState.dependencies, strict, reporter)
    local inc = opened.inc
    local checkMs = opened.checkMs

    -- One digest for every cache key this build writes. A native host has a compiled
    -- XXH64 that answers exactly what the portable implementation answers, so which one
    -- ran is never visible in a record -- only in how long the run took. The wrapper
    -- shadows the module-level `hashFile` so every site below reaches it without
    -- carrying the digest through its own signature.
    local contentDigest = fingerprint.contentDigest(true)

    local function hashFile(path: string): string?
        return fingerprint.hashFile(path, contentDigest)
    end

    local substituted: {[string]: string} = {}
    for path, text in pairs(overlays or {}) do
        local at = normalize(path)
        substituted[at] = text
        inc.openGeneratedDocument(at, text)
    end
    -- Keyed the way the substitutions are, since the two are looked up together
    -- and the policy spells a path however it walked to it.
    local authoredLints: {[string]: {any}} = {}
    for path, diagnostics in pairs(authoredUnused or {}) do
        authoredLints[normalize(path)] = diagnostics
    end

    -- A declaration file a type dependency carries that the importer could not take.
    -- Reported once, as a warning against the file itself, because that is where the
    -- reader can see what was skipped; the API the rest of the tree declares is
    -- checked either way.
    for _, problem in ipairs(inc.env.ambientTypeProblems or {}) do
        local diagnostic = {
            filename = problem.path,
            line = problem.line,
            col = problem.col,
            offset = 0,
            length = 1,
            severity = "warning",
            code = "NUPP0005",
            msg = "type dependency declaration not imported: " .. problem.msg,
            help = "the declarations beside it were imported; pin a revision this "
            .. "compiler can read, or report the construct",
            docs = "docs/learn/projects/integrations/luacats.md",
        }
        if diagnostics ~= nil then
            diagnostics[#diagnostics + 1] = diagnostic
        else
            require("nupp.compiler.diagnostics").report({diagnostic})
        end
    end

    local linkedModules: {[string]: boolean} = {}
    local stageBundled = opened.stageBundled

    local linkingRuntimeSource: {[string]: boolean} = {}
    local linkedRuntimeSource: {[string]: boolean} = {}
    local packagedRuntimeModules: {[string]: boolean} = {}
    local packagedCheckSources: {[string]: boolean} = {}
    local stagingPackagedChecks: {[string]: boolean} = {}
    -- A check reuses on the same terms a build does. It used to be excluded, and had to
    -- be: reuse produced no diagnostics, so the second `nupp check` over a project with
    -- an error would have said nothing was wrong. Now a record carries what the file
    -- had to say, so replaying it says the same thing the check would have.
    local cacheCompatible = oldState.moduleCompilerHash == newState.moduleCompilerHash
        and oldState.configHash == newState.configHash

    --- What a module's record is keyed on: its substitute when it has one, and the
    --- text this build checked otherwise. Hashing the file while compiling something
    --- else would make a rebuild reuse an artifact built from different source.
    ---
    --- The text the check saw rather than the file as it now stands, because a build
    --- reads a module twice: the checker takes its tree when whatever requires it is
    --- checked, and the scan reaches it later on its own turn. A source edited between
    --- the two was recorded at content this build never compiled -- and since the
    --- artifact beside it then matched what the record said it wrote, every later build
    --- reused it and the edit was never compiled at all. `fileText` is memoized for the
    --- life of the build, so both reads answer with whichever content got there first
    --- and the record describes the artifact it is stored next to.
    local function sourceContentHash(path: string): string?
        local text = substituted[path]
        if text ~= nil then
            -- Generated replacements may import implementation modules. Copying
            -- those bytes into authored source must force an ordinary check.
            return contentDigest("compiler-generated\0" .. text as string)
        end
        local checked = inc.fileText(path)
        if checked ~= nil then
            return contentDigest(checked as string)
        end

        -- Not a file the checker reads through this query: a dependency's declarations
        -- are answered by another one, and a missing file has no text at all.

        return hashFile(path)
    end

    -- Runtime linking needs the source closure before any newly checked module can
    -- resolve it. An unchanged module already recorded that closure, so asking the
    -- fresh query graph to rediscover it would check the module solely to confirm a
    -- cache entry that is about to be reused.
    local function moduleDependencies(name: string, path: string): {string}
        local previous = oldState.modules[name]
        if cacheCompatible
            and previous
            and previous.sourcePath == path
            and previous.sourceHash == sourceContentHash(path)
            and type(previous.dependencies) == "table"
        then
            return previous.dependencies as {string}
        end

        return inc.moduleDependencies(path)
    end

    -- Browser artifacts stage the carried modules because they run in a different
    -- host from the compiler itself.
    local browserTarget = target.host == "browser"
    -- A directory of modules must carry its emitted stdlib dependencies too:
    -- moving the directory away from the compiler must not lose its runtime.
    local selfContainedTarget = target.kind == nil
        or target.kind == "modules"
        or target.kind == "bundle"
        or target.kind == "binary"
        or target.kind == "component"

    local enqueueLinked: function(string): nil

    local function compatibleModule(name: string): boolean
        return moduleTargets.supports(name, target.host)
    end

    local function runtimeImports(name: string, code: string): any
        local required = gen.runtimeModules(code)
        -- Watch generation reaches its registry through a global rather than a
        -- require, so nothing in the generated code says the module it needs is
        -- there. Naming it here is what packages it.
        if config._reload then
            required[#required + 1] = "nupp.runtime.hotreload"
        end
        if name == "nupp.spi" then
            required[#required + 1] = "nupp.spi.index"
        elseif name == "nupp.spi.index" then
            for _, provider in ipairs(config._spiEntries or {}) do
                required[#required + 1] = provider.implementation
            end
        end
        local unique, seen = {}, {}
        for _, dependency in ipairs(required) do
            if not seen[dependency] and compatibleModule(dependency) then
                seen[dependency] = true
                unique[#unique + 1] = dependency
            end
        end
        table.sort(unique)

        return jsonArray(unique)
    end

    local linkRuntimeSource: function(name: string): nil
    linkRuntimeSource = function(name: string): nil
        if linkedRuntimeSource[name] or linkingRuntimeSource[name] or not compatibleModule(name) then
            return
        end
        linkingRuntimeSource[name] = true
        local path = inc.modulePath(name) or stageBundled(name)
        if path ~= nil and not path:match("%.d%.nupp$") then
            linkedModules[name] = true
            if enqueueLinked ~= nil then
                enqueueLinked(name)
            end
            for _, dependency in ipairs(moduleDependencies(name, path)) do
                linkRuntimeSource(dependency)
            end
        end
        linkingRuntimeSource[name] = nil
        linkedRuntimeSource[name] = true
    end

    -- Make a compiler-carried implementation available to the checker without yet
    -- selecting it for the payload. The source closure must be present before any of
    -- it is checked: mixing a declaration's sealed types with the implementation's
    -- copy later in one session would give one nominal type two identities.
    local function stagePackagedChecks(name: string): string?
        if packagedCheckSources[name] or stagingPackagedChecks[name] then
            return inc.modulePath(name)
        end
        local existing = inc.modulePath(name)
        if existing ~= nil and not envMod.isDependencyTypePath(inc.env, existing) then
            return nil
        end
        stagingPackagedChecks[name] = true
        local path = stageBundled(name, true)
        if path ~= nil and not path:match("%.d%.nupp$") then
            packagedCheckSources[name] = true
            for _, dependency in ipairs(moduleDependencies(name, path)) do
                stagePackagedChecks(dependency)
            end
        end
        stagingPackagedChecks[name] = nil

        return path
    end

    -- A one-payload target carries the compiler-owned modules its generated Lua
    -- actually requires. Select one source at a time: generation provides the runtime
    -- closure, while `moduleDependencies` also contains erased type-only imports and
    -- would make those imports executable by accident.
    local function linkPackagedRuntime(name: string): nil
        local existing = inc.modulePath(name)
        if not selfContainedTarget
            or (
                existing ~= nil
                and not envMod.isDependencyTypePath(inc.env, existing)
                and not packagedCheckSources[name]
            )
        then
            return
        end
        local path = packagedCheckSources[name] and existing or stagePackagedChecks(name)
        if path ~= nil and not path:match("%.d%.nupp$") then
            linkedModules[name] = true
            packagedRuntimeModules[name] = true
        end
    end

    -- Compiler-provided feature runtimes are not reached by a source `require`:
    -- generation emits those imports after the dependency walk. Reading recorded
    -- effects puts their checked runtime source on the work queue explicitly.

    local function linkFeatureRuntime(effects: any): nil
        if assignedPaths or not browserTarget and not selfContainedTarget then
            return
        end
        local named: {[string]: boolean} = {}
        for _, effect in ipairs(effects) do
            named[effect] = true
        end
        for effect in pairs(native.expand(named)) do
            local feature = native.feature(effect)
            if feature ~= nil and feature.runtimeModule ~= nil and (feature.portableRuntime or not browserTarget) then
                local runtimeModule = feature.runtimeModule as string
                linkRuntimeSource(runtimeModule)
                if linkedModules[runtimeModule] and enqueueLinked ~= nil then
                    enqueueLinked(runtimeModule)
                end
            end
        end
    end

    local function linkSelectedDependencies(name: string, names: any, effects: any): nil
        linkFeatureRuntime(effects)
        local selected = name == "nupp.spi" or (linkedModules[name] == true and not packagedRuntimeModules[name])
        if not selected then
            return
        end
        for _, dependency in ipairs(names) do
            linkRuntimeSource(dependency)
        end
    end

    -- Everything the project is written in, not the closure of its entries.
    --
    -- A compiler compiles its source set. Deciding what to compile by walking require
    -- edges out from an entry answers three questions with one walk, what to compile,
    -- what to check, and what a bundle carries, and gets two of them wrong. A module
    -- nothing requires goes unchecked, so `nupp check` stops meaning "this project is
    -- well typed" and starts meaning "the part I could reach is". And a module reached
    -- only by `require(name)`, where the name is computed, is absent from the build and
    -- therefore from the binary, which fails at run time in front of a user with a
    -- filesystem search path that means nothing inside one file.
    --
    -- Eliminating dead code is a linker's job and should be invisible when it happens.
    -- Measured on this compiler, the walk was removing one module out of seventy-one.
    --
    -- Deliverable entries still say where execution starts, and for a bundle which
    -- chunk becomes the body. A modules build executes nothing and therefore needs no
    -- entry. Entries never say what exists.
    local queue, queuedPaths = {}, {}

    local function seed(name, path)
        path = normalize(path)
        if queuedPaths[path] then
            return
        end
        queuedPaths[path] = true
        queue[#queue + 1] = {name = name, path = path}
    end

    -- A check of named files is that same walk started somewhere smaller. What it
    -- reaches from there -- what the file requires, and what those require -- is
    -- checked
    -- and recorded the way a whole-project run would, because the named file's answer
    -- depends on them. What it never reaches is left alone: unmentioned, unreported,
    -- and
    -- still in the stored state, which is what `asked` carries down to the two places
    -- that would otherwise treat "not visited" as "not there".
    local asked = nil
    if checkOnly and narrow and #narrow.paths > 0 then
        asked = {}
        for _, path in ipairs(narrow.paths) do
            local file = normalize(path)
            local name = envMod.moduleNameForPath(inc.env, file)
            if name then
                asked[name] = true
                seed(name, file)
            else
                narrow.unchecked[#narrow.unchecked + 1] = path
            end
        end
    else
        for _, entry in ipairs(target.entries or {}) do
            local path, name
            if entry:match("%.nupp$") or entry:find("[/\\]") then
                path = join(root, entry)
                name = envMod.moduleNameForPath(inc.env, path)
            else
                name = entry
                path = inc.modulePath(entry)
            end
            if not path then
                return nil, "entry not found: " .. entry
            end
            if not name then
                return nil, "cannot determine module name for " .. path
            end
            seed(name, path)
        end
        if #queue == 0 and (target.kind or "modules") ~= "modules" then
            return nil, "build.entries must contain at least one entry"
        end

        -- An entry may live outside the include roots, as a file named on the command
        -- line does, so it is seeded first and the source set is added around it. A
        -- target that names `sources` owns exactly that selected set plus dependencies
        -- discovered below; an ordinary target retains the whole-project contract.
        local sourceSet, sourceSetErr = selectedSourceFiles(root, target)
        if sourceSetErr then
            return nil, sourceSetErr
        end
        for _, path in ipairs(sourceSet or envMod.listSourceFiles(inc.env, false)) do
            local name = envMod.moduleNameForPath(inc.env, path)
            if name then
                seed(name, path)
            elseif sourceSet then
                return nil, "cannot determine module name for selected source " .. path
            end
        end
        for name in pairs(linkedModules) do
            local path = inc.modulePath(name)
            if path ~= nil then
                seed(name, path)
            end
        end
    end

    local parallelChecked: {[string]: boolean} = {}

    --- Checks a cold project in dependency-ready batches and installs the resulting
    --- records as the cache candidate the ordinary validator below consumes.
    local function precheckColdProject(): nil
        if not checkOnly
            or narrow ~= nil
            or #queue < 32
            or next(oldState.modules or {}) ~= nil
            or next(overlays or {}) ~= nil
            or os.getenv("NUPP_SERIAL_CHECK") ~= nil
            or os.getenv("NUPP_EXPERIMENTAL_PARALLEL_CHECK") ~= "1"
            or aotcheck.applies(target.aot)
        then
            return
        end
        local system = require("nupp.system")
        local requested = tonumber(os.getenv("NUPP_CHECK_JOBS") or "")
        local automatic = math.min(system.availableParallelism(), 4)
        local jobCount = math.max(1, math.min(math.floor(requested or automatic), 8, #queue))
        local moduleobject = require("nupp.tools.build.moduleobject")
        local declaredModules: {[string]: boolean} = {}
        local supportedModules: {[string]: boolean} = {}
        local projectPaths: {string} = {}
        local sourceBytes: {[string]: integer} = {}
        for _, item in ipairs(queue) do
            declaredModules[item.name] = true
            supportedModules[item.name] = moduleTargets.supports(item.name, target.host)
            projectPaths[#projectPaths + 1] = item.path
        end
        local objects: {any} = {}
        for _, item in ipairs(queue) do
            local text = inc.fileText(item.path)
            local header = inc.projectHeader(item.path)
            if text == nil or header == nil then
                return
            end
            sourceBytes[item.path] = #(text as string)
            objects[#objects + 1] = moduleobject.emit(item.path, inc.parseResult(item.path), header, {
                declaredModules = declaredModules,
                supportedModules = supportedModules,
            })
        end
        local linked = moduleobject.link(objects)
        local components = linked.components as {{string}}
        local byPath: {[string]: any} = {}
        local componentOf: {[string]: integer} = {}
        local componentByName: {[string]: integer} = {}
        for _, object in ipairs(objects) do
            byPath[object.path] = object
        end
        for index, component in ipairs(components) do
            for _, path in ipairs(component) do
                componentOf[path] = index
                local object = byPath[path]
                if object and object.moduleName then
                    componentByName[object.moduleName] = index
                end
            end
        end
        local dependencies: {[integer]: {[integer]: boolean}} = {}
        local allDependencies: {[integer]: {[integer]: boolean}} = {}
        local dependents: {[integer]: {[integer]: boolean}} = {}
        for index = 1, #components do
            dependencies[index], allDependencies[index], dependents[index] = {}, {}, {}
        end
        for path, targets in pairs(linked.edges) do
            local owner = componentOf[path] as integer
            local ownerDependencies = dependencies[owner] as {[integer]: boolean}
            local ownerAllDependencies = allDependencies[owner] as {[integer]: boolean}
            for _, target in ipairs(targets) do
                local dependency = componentOf[target] as integer
                if owner ~= dependency then
                    ownerDependencies[dependency] = true
                    ownerAllDependencies[dependency] = true
                    local dependencyDependents = dependents[dependency] as {[integer]: boolean}
                    dependencyDependents[owner] = true
                end
            end
        end
        local componentWeights: {[integer]: integer} = {}
        for index, component in ipairs(components) do
            local componentIndex = math.floor(index) as integer
            local weight: integer = 0
            for _, path in ipairs(component) do
                weight = weight + ((sourceBytes[path] or 1) as integer)
            end
            componentWeights[componentIndex] = weight
        end
        local partition = moduleobject.partition(linked, jobCount, sourceBytes)
        local plannedWorkers = partition.assignments as {[integer]: integer}
        local crossExport: {[string]: boolean} = {}
        -- A lane follows its static partition while work is available there, but may
        -- steal from another lane rather than sit behind a cross-partition critical
        -- path. Retain every completed interface so a steal always has its inputs.
        if jobCount > 1 then
            for _, item in ipairs(queue) do
                crossExport[item.path] = true
            end
        end
        local interfaces: {[string]: any} = {}
        local interfaceOrder: {any} = {}
        local bundleByFingerprint: {[string]: any} = {}
        local checked: {[string]: any} = {}
        local complete: {[integer]: boolean} = {}
        local remaining = #components
        local sessionKey = table.concat(
            {root, tostring(newState.moduleCompilerHash), tostring(newState.configHash)},
            "\0"
        )
        local taskState = {
            dependencies = newState.dependencies,
            moduleCompilerHash = newState.moduleCompilerHash,
            configHash = newState.configHash,
            modules = {},
        }
        local tasks = require("nupp.tasks")
        local suspension = require("nupp.suspension")
        local process = require("nupp.compiler.process")
        local protocol = require("nupp.tools.build.parallelcheckprotocol")
        local clock = require("nupp.time")
        local compilerRoot = envMod.compilerRoot()
        local hosted: any = rawget(_G, "__NUPP_EXECUTABLE")
        local executable = compilerRoot and join(compilerRoot, "bin/nupp")
            or type(hosted) == "string" and hosted
            or tostring(arg and arg[0] or "nupp")
        local children: {any} = {}
        local buffers: {string} = {}
        local workerSaid: {string} = {}
        local sentInterfaces: {{[string]: boolean}} = {}
        local sentArenas: {{[string]: boolean}} = {}
        local requestBytes: integer = 0
        local responseBytes: integer = 0
        local workerStats: {
            [string]: number
        } = {
            batches = 0,
            importedModules = 0,
            interfaceNodes = 0,
            setupMs = 0,
            decodeMs = 0,
            checkMs = 0,
            semanticMs = 0,
            recordMs = 0,
            interfaceMs = 0,
            encodeMs = 0,
            totalMs = 0,
        }
        local initializedWorkers: {[integer]: boolean} = {}
        local nextRequestIds: {integer} = {}
        local laneStats: {{[string]: number}} = {}
        local interfaceStore: string? = nil
        local workerRetries: integer = 0

        local function closeChildren(force: boolean?): nil
            for _, child in ipairs(children) do
                pcall(function(): nil
                    if force and child:isRunning() then
                        child:kill(true)
                    end
                    child:close()
                end)
            end
            children = {}
            if interfaceStore ~= nil then
                files.remove(interfaceStore as string, true)
                interfaceStore = nil
            end
        end

        local function abandon(reason: any): nil
            closeChildren(true)
            if os.getenv("NUPP_PARALLEL_CHECK_TRACE") then
                io.stderr:write("parallel cold check fell back: " .. tostring(reason) .. "\n")
            end
        end

        local function startChild(index: integer): nil
            local child, problem = process.startIsolated({executable, "__parallel-check-service"})
            if child == nil or child.stdin == nil or child.stdout == nil then
                if child ~= nil then
                    child:close()
                end
                error(problem or "parallel check worker has no protocol streams", 0)
            end
            children[index] = @unsafe nupp.release(child)
            buffers[index] = ""
            workerSaid[index] = ""
            sentInterfaces[index] = {}
            sentArenas[index] = {}
            initializedWorkers[index] = nil
            nextRequestIds[index] = nextRequestIds[index] or 0
        end

        local function restartChild(index: integer): nil
            local child = children[index]
            if child ~= nil then
                pcall(function(): nil
                    if child:isRunning() then
                        child:kill(true)
                    end
                    child:close()
                end)
            end
            startChild(index)
        end

        if jobCount > 1 then
            local storeNonce = tostring(fs.processId() or 0) .. "-" .. tostring(math.floor(clock.now() * 1000))
            interfaceStore = join(root, "build/cache/parallel-check-" .. storeNonce)
            if not fs.mkdir(interfaceStore as string) then
                abandon("cannot create the parallel interface store")
                return
            end
        end

        local started, startProblem = pcall(function(): nil
            for index = 1, jobCount > 1 and jobCount or 0 do
                startChild(index)
            end
        end)
        if not started then
            abandon(startProblem)
            return
        end
        if jobCount == 1 then
            sentInterfaces[1] = {}
            sentArenas[1] = {}
            nextRequestIds[1] = 0
        end

        local function drainWorkerStderr(index: integer): nil
            local reader = children[index].stderr
            if reader == nil then
                return
            end
            while true do
                local chunk = reader:poll()
                if chunk == nil then
                    return
                end
                if #workerSaid[index] < 8192 then
                    workerSaid[index] = (workerSaid[index] .. chunk):sub(1, 8192)
                end
            end
        end

        local function requestWorker(index: integer, request: any): any
            if jobCount == 1 then
                local answer = modules.parallelCheckWorker(request)
                answer.schema = 1
                answer.requestId = request.requestId
                answer.requestFingerprint = request.fingerprint

                return answer
            end
            local child = children[index]
            local frame = protocol.frame(request)
            requestBytes = requestBytes + #frame
            local deadline = clock.now() + 600000
            if child.stdin:send(frame, deadline) ~= #frame then
                error("parallel check worker stopped accepting requests", 0)
            end
            while true do
                local newline = buffers[index]:find("\n", 1, true)
                if newline ~= nil then
                    local length = tonumber(buffers[index]:sub(1, newline - 1))
                    if length == nil or length < 0 or length > protocol.MAX_FRAME then
                        error("parallel check worker returned an invalid frame length", 0)
                    end
                    local available = #buffers[index] - newline
                    if available >= length then
                        local encoded = buffers[index]:sub(newline + 1, newline + length)
                        buffers[index] = buffers[index]:sub(newline + length + 1)
                        responseBytes = responseBytes + #encoded
                        local answer, problem = protocol.decode(encoded)
                        if answer == nil then
                            error(
                                "parallel check worker returned an invalid response: " .. tostring(
                                    problem
                                ) .. " (" .. tostring(#encoded) .. " bytes; worker said " .. workerSaid[index] .. ")",
                                0
                            )
                        end
                        if answer.schema ~= 1
                            or answer.requestId ~= request.requestId
                            or answer.requestFingerprint ~= request.fingerprint
                        then
                            error("parallel check worker returned a stale or mismatched response", 0)
                        end

                        drainWorkerStderr(index)
                        return answer
                    end
                end
                drainWorkerStderr(index)
                local chunk, readProblem = child.stdout:read(65536)
                if chunk ~= nil and chunk ~= "" then
                    buffers[index] = buffers[index] .. chunk
                else
                    drainWorkerStderr(index)
                    local said = workerSaid[index]
                    error(
                        "parallel check worker stopped before answering" .. (
                            readProblem ~= nil and (": " .. tostring(readProblem)) or ""
                        ) .. (said ~= "" and (": " .. said) or ""),
                        0
                    )
                end
            end
        end

        local ready: {integer} = {}
        local queued: {[integer]: boolean} = {}
        local assigned: {[integer]: integer} = {}
        local queueWaiters: {function(boolean)} = {}
        local randomState = tonumber(os.getenv("NUPP_PARALLEL_CHECK_RANDOM_SEED") or "")
        local affinityScheduling = os.getenv("NUPP_PARALLEL_CHECK_AFFINITY") ~= "0"

        local function randomReadyPosition(count: integer): integer
            randomState = ((randomState as number) * 48271) % 2147483647

            return math.floor((randomState as number) % count) + 1
        end

        local function queueComponent(component: integer): nil
            if queued[component] or assigned[component] or complete[component] then
                return
            end
            queued[component] = true
            ready[#ready + 1] = component
        end

        for index = 1, #components do
            if next(dependencies[index] as {[integer]: boolean}) == nil then
                queueComponent(index)
            end
        end
        if #ready == 0 and remaining > 0 then
            abandon("parallel component graph has no dependency-ready root")
            return
        end

        local function wakeQueue(): nil
            local waking = queueWaiters
            queueWaiters = {}
            for _, wake in ipairs(waking) do
                wake(true)
            end
        end

        local function waitForQueue(): nil
            if #ready > 0 or remaining == 0 then
                return
            end
            suspension.suspend("parallel check ready queue", function(resume: function(boolean)): function()
                if #ready > 0 or remaining == 0 then
                    resume(true)

                    return function(): nil
                    end
                end
                queueWaiters[#queueWaiters + 1] = resume

                return function(): nil
                    for index = #queueWaiters, 1, -1 do
                        if queueWaiters[index] == resume then
                            table.remove(queueWaiters, index)
                            break
                        end
                    end
                end
            end)
        end

        local function takeComponents(worker: integer): {integer}?
            while #ready == 0 and remaining > 0 do
                waitForQueue()
            end
            if remaining == 0 then
                return nil
            end
            local selectedComponents: {integer} = {}
            while #ready > 0 and #selectedComponents < 1 do
                local selected: integer = randomState and randomReadyPosition(#ready) or 1
                local selectedLocal: boolean = false
                local selectedResident: integer = -1
                local selectedMissing: integer = 2147483647
                local selectedWeight: number = -1
                for position, component in ipairs(randomState and {} or ready) do
                    local weight = componentWeights[component] or 1
                    local chosen = ready[selected]
                    local localPlan = plannedWorkers[component] == worker
                    local resident: integer = 0
                    local missing: integer = 0
                    if affinityScheduling then
                        for dependency in pairs(allDependencies[component] as {[integer]: boolean}) do
                            for _, path in ipairs(components[dependency]) do
                                local object = byPath[path]
                                local dependencyWeight = sourceBytes[path] or 1
                                if object and object.moduleName and sentInterfaces[worker][object.moduleName] then
                                    resident = resident + dependencyWeight
                                else
                                    missing = missing + dependencyWeight
                                end
                            end
                        end
                    end
                    local better = false
                    if affinityScheduling and resident ~= selectedResident then
                        better = resident > selectedResident
                    elseif affinityScheduling and missing ~= selectedMissing then
                        better = missing < selectedMissing
                    elseif localPlan ~= selectedLocal then
                        better = localPlan
                    elseif weight ~= selectedWeight then
                        better = weight > selectedWeight
                    else
                        better = component < chosen
                    end
                    if better then
                        selected = position
                        selectedLocal = localPlan
                        selectedResident = resident
                        selectedMissing = missing
                        selectedWeight = weight
                    end
                end
                local component = table.remove(ready, selected)
                queued[component] = nil
                assigned[component] = worker
                selectedComponents[#selectedComponents + 1] = component
            end

            return selectedComponents
        end

        local function requestFor(worker: integer, selectedComponents: {integer}): (any, {string})
            local paths: {string} = {}
            local exportPaths: {string} = {}
            local sources: {any} = {}
            local imports: {any} = {}
            local includedBundles: {[any]: boolean} = {}
            local names: {string} = {}
            local neededNames: {[string]: boolean} = {}
            local visitedDependencies: {[integer]: boolean} = {}

            local includeBundle
            includeBundle = function(completedBundle: any): nil
                local image = completedBundle.image
                local fingerprint = image and image.fingerprint
                if fingerprint == nil or sentArenas[worker][fingerprint] or includedBundles[image] then
                    return
                end
                includedBundles[image] = true
                local prerequisites: {string} = image.prerequisites or {}
                if image.descriptor ~= nil then
                    prerequisites = {}
                    for _, node in ipairs(image.descriptor.types or {}) do
                        if node.kind == "external" then
                            prerequisites[#prerequisites + 1] = node.arena
                        end
                    end
                end
                for _, arena in ipairs(prerequisites) do
                    local prerequisite = bundleByFingerprint[arena]
                    if prerequisite == nil and not sentArenas[worker][arena] then
                        error("parallel interface prerequisite is unavailable: " .. tostring(arena), 0)
                    end
                    if prerequisite ~= nil then
                        includeBundle(prerequisite)
                    end
                end
                if image.path ~= nil then
                    imports[#imports + 1] = {path = image.path, fingerprint = image.fingerprint,}
                else
                    imports[#imports + 1] = image
                end
                for _, name in ipairs(completedBundle.names) do
                    if not sentInterfaces[worker][name] then
                        names[#names + 1] = name
                    end
                end
            end

            local function needDependencies(current: integer): nil
                if visitedDependencies[current] then
                    return
                end
                visitedDependencies[current] = true
                for dependency in pairs(allDependencies[current] as {[integer]: boolean}) do
                    for _, path in ipairs(components[dependency]) do
                        local name = byPath[path] and byPath[path].moduleName
                        if name then
                            neededNames[name] = true
                        end
                    end
                    needDependencies(dependency)
                end
            end

            for _, component in ipairs(selectedComponents) do
                needDependencies(component)
                for _, path in ipairs(components[component]) do
                    paths[#paths + 1] = path
                    local text = inc.fileText(path)
                    if text == nil then
                        error("parallel check source disappeared: " .. path, 0)
                    end
                    sources[#sources + 1] = {path = path, hash = contentDigest(text as string),}
                    if crossExport[path] then
                        exportPaths[#exportPaths + 1] = path
                    end
                end
            end
            -- A cyclic bundle can contain several modules. Expand dependencies from
            -- dependents toward roots before delivering the images root-first.
            for position = #interfaceOrder, 1, -1 do
                local completedBundle = interfaceOrder[position]
                local needed = false
                for _, name in ipairs(completedBundle.names) do
                    needed = needed or neededNames[name] == true
                end
                if needed then
                    for _, name in ipairs(completedBundle.names) do
                        neededNames[name] = true
                        local dependency = componentByName[name]
                        if dependency then
                            needDependencies(dependency)
                        end
                    end
                end
            end
            for _, completedBundle in ipairs(interfaceOrder) do
                local needed = false
                for _, name in ipairs(completedBundle.names) do
                    if neededNames[name] and not sentInterfaces[worker][name] then
                        needed = true
                    end
                end
                if needed then
                    includeBundle(completedBundle)
                end
            end

            nextRequestIds[worker] = (nextRequestIds[worker] or 0) + 1
            local request = {
                schema = 1,
                requestId = nextRequestIds[worker],
                paths = paths,
                exportPaths = exportPaths,
                sources = sources,
                imports = imports,
                initializer = worker,
                interfaceStore = interfaceStore,
                sessionKey = sessionKey,
            }
            request.fingerprint = protocol.requestFingerprint(request)
            if not initializedWorkers[worker] then
                initializedWorkers[worker] = true
                request.root = root
                request.outDir = outDir
                request.config = config
                request.target = target
                request.state = taskState
                request.projectPaths = projectPaths
                request.strict = strict
            end

            return request, names
        end

        local function accept(
            worker: integer,
            selectedComponents: {integer},
            request: any,
            delivered: {string},
            answer: any
        ): nil
            if not answer.ok or #(answer.unchecked or {}) > 0 then
                local reason = tostring(answer.problem or "incomplete batch")
                local diagnostic = answer.diagnostics and answer.diagnostics[1]
                if diagnostic ~= nil then
                    reason = reason .. ": " .. tostring(
                        diagnostic.filename or ""
                    ) .. ":" .. tostring(
                        diagnostic.line or 0
                    ) .. " " .. tostring(diagnostic.code or "") .. " " .. tostring(diagnostic.msg or "")
                end
                error(
                    reason .. " [paths " .. table.concat(
                        request.paths or {},
                        ", "
                    ) .. "; delivered " .. table.concat(
                        delivered,
                        ", "
                    ) .. "; worker said " .. workerSaid[worker] .. "]",
                    0
                )
            end
            for _, name in ipairs(delivered) do
                sentInterfaces[worker][name] = true
            end
            for _, image in ipairs(request.imports or {}) do
                if image.fingerprint then
                    sentArenas[worker][image.fingerprint] = true
                end
            end
            local batchStats = answer.stats or {}
            local lane = laneStats[worker] or {batches = 0, totalMs = 0, semanticMs = 0, decodeMs = 0}
            laneStats[worker] = lane
            lane.batches = assert(lane.batches) + 1
            for _, name in ipairs({"totalMs", "semanticMs", "decodeMs"}) do
                lane[name] = assert(lane[name]) + (batchStats[name] or 0)
            end
            workerStats.batches = assert(workerStats.batches) + 1
            for _, name in ipairs({
                "importedModules",
                "interfaceNodes",
                "setupMs",
                "decodeMs",
                "checkMs",
                "semanticMs",
                "recordMs",
                "interfaceMs",
                "encodeMs",
                "totalMs"
            }) do
                workerStats[name] = assert(workerStats[name]) + (batchStats[name] or 0)
            end
            for name, record in pairs(answer.modules or {}) do
                checked[name] = record
                parallelChecked[name] = true
            end
            local producedInterface = answer.interfaceRef or answer.interfaceBundle
            if producedInterface ~= nil then
                local completedBundle = {
                    image = producedInterface,
                    names = answer.interfaceNames or {},
                    worker = worker,
                }
                interfaceOrder[#interfaceOrder + 1] = completedBundle
                bundleByFingerprint[producedInterface.fingerprint] = completedBundle
                sentArenas[worker][producedInterface.fingerprint] = true
                for _, name in ipairs(answer.interfaceNames or {}) do
                    interfaces[name] = answer.interfaceBundle
                    sentInterfaces[worker][name] = true
                end
            end
            for _, component in ipairs(selectedComponents) do
                complete[component] = true
                remaining = remaining - 1
            end
            for _, component in ipairs(selectedComponents) do
                for dependent in pairs(dependents[component] as {[integer]: boolean}) do
                    local dependentDependencies = dependencies[dependent] as {[integer]: boolean}
                    dependentDependencies[component] = nil
                    if next(dependentDependencies) == nil then
                        queueComponent(dependent)
                    end
                end
            end
            wakeQueue()
        end

        local function runWorker(worker: integer): nil
            while true do
                local selectedComponents = takeComponents(worker)
                if selectedComponents == nil then
                    return
                end
                local request, delivered = requestFor(worker, selectedComponents)
                local answered, answer = pcall(requestWorker, worker, request)
                if not answered and jobCount > 1 then
                    workerRetries = workerRetries + 1
                    restartChild(worker)
                    request, delivered = requestFor(worker, selectedComponents)
                    answered, answer = pcall(requestWorker, worker, request)
                end
                if not answered then
                    error(answer, 0)
                end
                accept(worker, selectedComponents, request, delivered, answer)
            end
        end

        local ran, problem = pcall(function(): nil
            with scope = tasks.open(jobCount) do
                for worker = 1, jobCount do
                    scope:spawn(worker, runWorker)
                end
            end
        end)
        if not ran then
            abandon(problem)
            return
        end
        if os.getenv("NUPP_PARALLEL_CHECK_TRACE") then
            local lanes: {string} = {}
            for worker = 1, jobCount do
                local lane = laneStats[worker] or {}
                lanes[
                    #lanes + 1
                ] = (
                    "%d:%d/%.0f/%.0f/%.0f"
                ):format(worker, lane.batches or 0, lane.totalMs or 0, lane.semanticMs or 0, lane.decodeMs or 0)
            end
            io.stderr:write(
                (
                    "parallel cold check: batches=%d interfaces=%d imports=%d "
                    .. "setup=%.0fms decode=%.0fms semantic=%.0fms record=%.0fms "
                    .. "interface=%.0fms encode=%.0fms worker=%.0fms "
                    .. "sent=%d received=%d retries=%d lanes=%s\n"
                ):format(
                    workerStats.batches,
                    workerStats.interfaceNodes,
                    workerStats.importedModules,
                    workerStats.setupMs,
                    workerStats.decodeMs,
                    workerStats.semanticMs,
                    workerStats.recordMs,
                    workerStats.interfaceMs,
                    workerStats.encodeMs,
                    workerStats.totalMs,
                    requestBytes,
                    responseBytes,
                    workerRetries,
                    table.concat(lanes, ",")
                )
            )
        end

        for _, item in ipairs(queue) do
            if checked[item.name] == nil then
                abandon("parallel check did not return every module")
                return
            end
        end
        closeChildren()
        oldState.modules = checked
        oldState.moduleCompilerHash = newState.moduleCompilerHash
        oldState.configHash = newState.configHash
        cacheCompatible = true
    end

    precheckColdProject()

    local suppliedConstSelection = (target as any)._constSelection
    local constEnabled = not checkOnly and (config._optLevel or 0) >= 1 and not (config._disabledPasses or {})["OPT-8"]
    local specializationPlans: {any} = {}
    local acceptedSpecializations: {any} = {}
    local declinedSpecializations: {any} = {}
    if constEnabled then
        -- Check the deliverable once before emission so incoming calls can request a
        -- body from the module that declares it.  This is emission dependency
        -- discovery, not a reverse type dependency: the incremental checker memoizes
        -- these answers and a caller tuple enters only the declaring module's
        -- specialization hash below.
        local checkedForSpecialization: {any} = {}
        local specializationCursor = 1
        while specializationCursor <= #queue do
            local item = queue[specializationCursor]
            specializationCursor = specializationCursor + 1
            local checked = inc.checkFile(item.path)
            if checked.result ~= nil and checked.missing ~= true and checked.syntax ~= true then
                checkedForSpecialization[
                    #checkedForSpecialization + 1
                ] = {filename = item.path, module = item.name, result = checked.result,}
            end
            for _, dependency in ipairs(inc.moduleDependencies(item.path)) do
                local dependencyPath = inc.modulePath(dependency)
                if dependencyPath ~= nil and not packagedCheckSources[dependency] then
                    seed(dependency, dependencyPath)
                end
            end
        end
        if suppliedConstSelection ~= nil then
            specializationPlans = suppliedConstSelection.plans
            acceptedSpecializations = suppliedConstSelection.accepted
            declinedSpecializations = suppliedConstSelection.declined
        else
            specializationPlans = constspecialize.collectGraph(checkedForSpecialization)
            acceptedSpecializations, declinedSpecializations = constspecialize.selectGraph(specializationPlans)
        end
    end
    -- Only a computed selection is handed down. An empty one would still be a
    -- selection, and the pass would read it as "this deliverable demands nothing"
    -- rather than "nobody looked" -- the two are the same silence at the call site
    -- but not the same answer, and OPT-8's own level and `-Zno-opt` gates already
    -- decide whether it runs.
    local constSelection: any? = constEnabled
        and {accepted = acceptedSpecializations, declined = declinedSpecializations,}
        or nil
    local acceptedBodies = 0
    for _, specialization in ipairs(acceptedSpecializations) do
        if specialization.physical == specialization
            and not (suppliedConstSelection ~= nil and specialization.requiredAot)
        then
            acceptedBodies = acceptedBodies + 1
        end
    end
    local specializationKeys: {[string]: {string}} = {}
    for _, plan in ipairs(specializationPlans) do
        local keys = specializationKeys[normalize(plan.filename)]
        if keys == nil then
            keys = {}
            specializationKeys[normalize(plan.filename)] = keys
        end
        for _, specialization in ipairs(plan.specializations) do
            keys[#keys + 1] = specialization.key
        end
    end
    local specializationHashes: {[string]: string} = {}
    for path, keys in pairs(specializationKeys) do
        table.sort(keys)
        specializationHashes[path] = contentDigest(table.concat(keys, "\0"))
    end
    local emptySpecializationHash = contentDigest("")

    local records, reused, codeFor, paths = {}, {}, {}, {}
    local order: {string} = {}
    local queued, cursor = {}, 1
    -- What the queue holds now is the whole source set; dependencies discovered later
    -- can still add to it, which the step line accounts for by never counting past the
    -- total it is showing.
    report:expect(#queue)
    -- Generation, by module name. Kept apart from the check times until the end because
    -- one is keyed by path and the other by name, and the summary wants them added
    -- together under the name.
    local generateMs: {[string]: number} = {}
    stats = (stats or {}) as modules.Stats
    stats.checkedModules, stats.generatedModules, stats.reusedModules = 0, 0, 0
    stats.specializedBodies = acceptedBodies
    report:addSpecialized(acceptedBodies)

    -- Everything one module had to say, by module name, rather than one list everything
    -- is appended to. A module reused early can be invalidated and recompiled later,
    -- and what it says the second time replaces what it said the first rather than
    -- joining it.
    local said = {}

    -- A native one-payload target runs on the same LuaJIT VM as the compiler's
    -- own modules. Reuse those byte-for-byte artifacts instead of rechecking their
    -- source against the application's declaration graph. Besides being needless,
    -- that would mix two copies of nominal standard-library types in one checker
    -- session. Portable targets still compile the carried source below.
    local addingCarriedRuntime: {[string]: boolean} = {}
    local carriedRuntime: {[string]: boolean} = {}
    local runtimeSourceRoot = join(root, join(outDir, "cache/runtime-source"))

    local function addCarriedRuntime(name: string): boolean
        if browserTarget then
            return false
        end
        -- The worker lane bridge is supplied by the selected host stub. The compiler
        -- build carries a failure stub only so its own non-worker process can name
        -- the module; embedding that stub would shadow the host implementation.
        if name == "nupp.workers.native" then
            return false
        end
        if records[name] ~= nil then
            return records[name].compilerRuntime == true
        end
        local existing = inc.modulePath(name)
        if existing ~= nil
            and not envMod.isDependencyTypePath(inc.env, existing)
            and existing:sub(1, #runtimeSourceRoot + 1) ~= runtimeSourceRoot .. "/"
        then
            return false
        end
        local bundled = require("nupp.compiler.bundled")
        local modulePath = name:gsub("^nupp%.", ""):gsub("%.", "/") .. ".lua"
        local text = readFile(join(bundled.moduleDir(), "../" .. modulePath))
            or bundled.source("/" .. name:gsub("%.", "/") .. ".lua")
        local carried = rawget(_G, "__nuppCompilerModuleArtifacts")
        local carriedRecord = carried and carried[name]
        if text == nil and carriedRecord and type(carriedRecord.source) == "string" then
            text = carriedRecord.source
        end
        if text == nil then
            return false
        end
        if addingCarriedRuntime[name] then
            return true
        end
        addingCarriedRuntime[name] = true
        local required = runtimeImports(name, text)
        local carriedEffects = jsonArray({} as {string})
        if carriedRecord then
            for _, effect in ipairs(carriedRecord.effects or {}) do
                carriedEffects[#carriedEffects + 1] = effect
            end
        end
        local moduleEffect = native.forModule(name)
        if moduleEffect ~= nil then
            local found = false
            for _, effect in ipairs(carriedEffects) do
                found = found or effect == moduleEffect
            end
            if not found then
                carriedEffects[#carriedEffects + 1] = moduleEffect
            end
        end
        local output = join(root, join(outDir, name:gsub("%.", "/") .. ".lua"))
        local artifactHash = contentDigest(text)
        records[
            name
        ] = {
            sourceHash = artifactHash,
            interfaceHash = contentDigest("compiler-runtime\0" .. text),
            artifactHash = artifactHash,
            dependencies = required,
            runtimeModules = required,
            compilerRuntime = true,
            projectDependencies = jsonArray({} as {DependencyRecord}),
            externalInputs = jsonArray({} as {any}),
            effects = carriedEffects,
            output = output,
            diags = jsonArray({} as {any}),
            materializations = jsonArray({} as {any}),
            derives = jsonArray({} as {any}),
            optimizationRemarks = jsonArray({} as {any}),
            allocationSites = jsonArray({} as {any}),
            optimizationAccounted = false,
            specializationHash = emptySpecializationHash,
        }
        codeFor[name] = text
        carriedRuntime[name] = true
        paths[name] = output
        local previous = oldState.modules[name]
        if cacheCompatible
            and previous
            and previous.compilerRuntime
            and previous.artifactHash == artifactHash
            and (checkOnly or hashFile(output) == artifactHash)
        then
            reused[name] = true
        end
        order[#order + 1] = name
        for _, dependency in ipairs(required) do
            if not addCarriedRuntime(dependency) then
                linkPackagedRuntime(dependency)
                if enqueueLinked ~= nil then
                    enqueueLinked(dependency)
                end
            end
        end
        addingCarriedRuntime[name] = nil

        return true
    end

    local function enqueue(name, path)
        if queued[name] or records[name] or not compatibleModule(name) then
            return
        end
        path = path or inc.modulePath(name)
        if path and assignedPaths and not assignedPaths[normalize(path)] then
            return
        end
        if path then
            queued[name] = true
            queue[#queue + 1] = {name = name, path = normalize(path)}
        end
    end

    enqueueLinked = function(name: string): nil
        if not addCarriedRuntime(name) then
            enqueue(name)
        end
    end

    local configuredEffects = {}
    if not assignedPaths then
        for effect in pairs(native.resolve(nil, target.nativeFeatures)) do
            configuredEffects[#configuredEffects + 1] = effect
        end
        linkFeatureRuntime(configuredEffects)
    end

    if not assignedPaths and #(config._spiEntries or {}) > 0 then
        linkRuntimeSource("nupp.spi")
        linkRuntimeSource("nupp.spi.index")
        for _, provider in ipairs(config._spiEntries) do
            linkRuntimeSource(provider.implementation)
        end
    end

    -- A note or a warning is said and stepped over. Only an error stops the build, and
    -- only an error withholds the file's generated Lua: advice about a program is not a
    -- reason to refuse to compile it.
    local function isFatalIn(diags)
        for _, diag in ipairs(diags or {}) do
            if isFatal(diag) then
                return true
            end
        end

        return false
    end

    local aotApplies = checkOnly and aotcheck.applies(target.aot)

    -- The code that lowered a verdict, asked once a run and only when one is made
    -- or reused. The module-compiler digest above does not cover the AOT backend,
    -- so that an edit to lowering discards only the records of modules it lowered.
    local aotBackendKey: string? = nil

    local function currentAotKey(): string
        if aotBackendKey == nil then
            aotBackendKey = aotcheck.backendKey(
                fingerprint.sharedCacheDir(join(root, join(outDir, "cache"))),
                contentDigest
            )
        end

        return aotBackendKey as string
    end

    --- What a build of this target would refuse about one checked module's `@aot`
    --- functions, and whether it was lowered to find out. Asked only by a check, and
    --- only of a module it checked this run: a reused record carries the answer it
    --- was given, keyed like the rest of the record on the source, its dependencies'
    --- interfaces and the manifest, and on the backend that lowered it.
    local function aotRefusals(name: string, path: string, checked: any): ({any}, boolean)
        if not aotApplies
            or checked == nil
            or linkedModules[name]
            or packagedRuntimeModules[name]
            or not aotcheck.projectSource(root, config.include, outDir, path)
        then
            return {}, false
        end
        local text = substituted[normalize(path)] or inc.fileText(path)
        if text == nil or (text as string):find("@aot", 1, true) == nil then
            return {}, false
        end

        return aotcheck.refusals(text as string, path, checked, target as any), true
    end

    --- The names of the `@aot` const-generic families a lowered module declares.
    local function aotFamilies(path: string, checked: any): {string}?
        local candidates, plans = {}, {}
        constspecialize.collectCandidates(checked, path, candidates, plans)
        local names: {string} = {}
        for _, plan in ipairs(plans) do
            if plan.requiredAot then
                names[#names + 1] = plan.name
            end
        end
        if #names == 0 then
            return nil
        end
        table.sort(names)

        return jsonArray(names)
    end

    local function compile(name, path, sourceHash)
        local external = path:match("%.d%.nupp$") ~= nil
            or envMod.isDependencyTypePath(inc.env, path) and not linkedModules[name]
        local result = inc.checkFile(path)
        stats.checkedModules = stats.checkedModules + 1
        -- What checking found, once the substitution below is accounted for. The
        -- record keeps this list rather than the checker's own, because a reused
        -- record replays its diagnostics and the checker's list describes the
        -- rewritten text: replaying it would report the `unused-binding` the first
        -- build had already answered from the file as written.
        local checkedDiags: {any} = {}
        -- An `@aot` policy that links hands the checker this source with each
        -- compiled declaration replaced by the wrapper that calls it, body and
        -- all. A binding the removed body was the only reader of then has no
        -- reader in the text being checked, and `unused-binding` says so against
        -- a line the author would find still using the name.
        --
        -- That lint describes the shape of a file somebody wrote, and a rewritten
        -- one is not that file, so its answer is dropped and the one the policy
        -- took from the file as written is reported instead. The lint is not
        -- lost, and it is not answered twice.
        local rewritten = substituted[normalize(path)] ~= nil
        for _, diag in ipairs(result.diags or {}) do
            if not (rewritten and diag.code == "NUPP2507") then
                checkedDiags[#checkedDiags + 1] = diag
            end
        end
        if rewritten then
            for _, diag in ipairs(authoredLints[normalize(path)] or {}) do
                checkedDiags[#checkedDiags + 1] = diag
            end
        end
        local mine = {}
        for _, diag in ipairs(checkedDiags) do
            mine[#mine + 1] = diag
        end
        local fatal = isFatalIn(mine)
        -- Lowered only once the checker is satisfied, as a build lowers only a source
        -- that checks: a refusal about a program already refused says nothing new.
        local refusals = jsonArray({} as {any})
        local aotKey: string? = nil
        local families: {string}? = nil
        if not fatal and not external then
            local found, lowered = aotRefusals(name, path, result.result)
            for _, diag in ipairs(found) do
                refusals[#refusals + 1] = diag
            end
            aotKey = lowered and currentAotKey() or nil
            families = lowered and aotFamilies(path, result.result) or nil
        end
        local depNames = inc.moduleDependencies(path)
        local effectNames: {string} = {}
        if fatal or checkOnly or external then
            for effect in pairs(result.result and result.result.effects or {}) do
                effectNames[#effectNames + 1] = effect
            end
            table.sort(effectNames)
        end
        local output: string? = nil
        if not external then
            output = join(root, join(outDir, name:gsub("%.", "/") .. ".lua"))
        end
        local artifactHash, code, coverage
        local optimizationRemarks = jsonArray({} as {any})
        local allocationSites = jsonArray({} as {any})
        local optimizationAccounted = false
        local runtimeModules = jsonArray({} as {string})
        if not external and not fatal and not checkOnly then
            report:at("generate")
            report:step("generating " .. name)
            local startedGenerating = progress.now()
            local genDiags
            local remarks = optimize.run(result.result, {
                level = config._optLevel or 0,
                filename = path,
                disabled = config._disabledPasses,
                constSelection = constSelection,
            })
            optimizationAccounted = true
            for _, note in ipairs(remarks) do
                optimizationRemarks[#optimizationRemarks + 1] = note
            end
            for _, site in ipairs(optimize.allocationSites(result.result)) do
                allocationSites[
                    #allocationSites + 1
                ] = {file = path, kind = site.kind, line = site.line, col = site.col,}
            end
            local emittedEffects
            -- A reload component is generated the way `nupp run --watch` generates:
            -- one slot array per module, every named function dispatching through
            -- it, and the same registration calls. What makes it a component rather
            -- than a watch run is who seals it and who holds the compiler session,
            -- both of which packaging and the host settle later.
            local hotRequest: any = config._reload
                and {mode = "initial", module = name, libraries = config._reloadLibraries or {}}
                or nil
            code, genDiags, coverage, emittedEffects = gen.generate(
                result.result,
                path,
                config._coverage and {path = path} or nil,
                hotRequest,
                nil,
                ((target as any)._aotGpuSources or {})[normalize(path)] and {["runtime.gpu"] = true} or nil
            )
            -- Generation is the last word on runtime reachability: it has now seen
            -- which checked nodes survived folding, comptime erasure, materialization,
            -- and lowering. Persist the same set that selected the generated prologue
            -- so packaging carries only features the generated Lua uses.
            result.result.effects = emittedEffects
            runtimeModules = runtimeImports(name, code)
            for effect in pairs(emittedEffects) do
                effectNames[#effectNames + 1] = effect
            end
            table.sort(effectNames)
            stats.generatedModules = stats.generatedModules + 1
            for _, diag in ipairs(genDiags) do
                mine[#mine + 1] = diag
            end
            if #genDiags == 0 then
                artifactHash = contentDigest(code)
            end
            generateMs[name] = (generateMs[name] or 0) + (progress.now() - startedGenerating)
        end
        local moduleEffect = native.forModule(name)
        if moduleEffect ~= nil then
            local found = false
            for _, effect in ipairs(effectNames) do
                found = found or effect == moduleEffect
            end
            if not found then
                effectNames[#effectNames + 1] = moduleEffect;
                table.sort(effectNames)
            end
        end
        said[name] = mine
        local materializations = materializeObserve.collect(result.result and result.result.root, path)
        local derives = result.result and result.result.deriveObservations or {}
        local projectDependencies = inc.projectDependencies(path)
        local checkedExports = result.exports or {}
        records[name] = {
            sourcePath = path,
            sourceHash = sourceHash,
            interfaceHash = modules.interfaceHash(
                result.moduleType,
                checkedExports,
                external and sourceHash or nil,
                contentDigest
            ),
            artifactHash = artifactHash,
            dependencies = jsonArray(depNames),
            runtimeModules = runtimeModules,
            compilerRuntime = packagedRuntimeModules[name] or nil,
            projectDependencies = jsonArray(projectDependencies),
            externalInputs = jsonArray(inc.externalInputs(path)),
            effects = jsonArray(effectNames),
            output = output,
            external = external or nil,
            -- Only what checking found. Generation runs once per artifact and a reused
            -- module does not run it again, so its remarks belong to the run that
            -- produced them and not to the record.
            diags = jsonArray(checkedDiags),
            aotRefusals = refusals,
            aotKey = aotKey,
            aotFamilies = families,
            coverage = coverage,
            materializations = jsonArray(materializations),
            derives = jsonArray(derives),
            optimizationRemarks = optimizationRemarks,
            allocationSites = allocationSites,
            optimizationAccounted = optimizationAccounted,
            specializationHash = specializationHashes[normalize(path)] or emptySpecializationHash,
        }
        codeFor[name] = code
        reused[name] = nil
        linkSelectedDependencies(name, depNames, effectNames)
        for _, runtimeModule in ipairs(runtimeModules) do
            if not addCarriedRuntime(runtimeModule) then
                linkPackagedRuntime(runtimeModule)
                enqueue(runtimeModule)
            end
        end
        for _, depName in ipairs(depNames) do
            if linkedModules[name] and not packagedRuntimeModules[name] then
                linkRuntimeSource(depName)
            elseif browserTarget and inc.modulePath(depName) == nil then
                -- Browser targets need the source selected for that host rather
                -- than a carried artifact built for the compiler's native host.
                linkRuntimeSource(depName)
            end
            if not packagedCheckSources[depName] or packagedRuntimeModules[depName] then
                enqueue(depName)
            end
        end
    end

    local function processQueue()
        while cursor <= #queue do
            local item = queue[cursor]
            cursor = cursor + 1
            queued[item.name] = nil
            if not records[item.name] then
                local path = item.path
                paths[item.name] = path
                order[#order + 1] = item.name
                -- Deciding whether a module can be reused is reading and hashing files,
                -- which on a build that reuses everything is the whole of the run. It
                -- is its own activity so a warm build can say so.
                report:at("scan")
                report:step(item.name)
                local sourceHash = sourceContentHash(path)
                local previous = oldState.modules[item.name]
                local external = path:match("%.d%.nupp$") ~= nil
                    or envMod.isDependencyTypePath(inc.env, path) and not linkedModules[item.name]
                local output: string? = nil
                if not external then
                    output = join(root, join(outDir, item.name:gsub("%.", "/") .. ".lua"))
                end
                -- A build has to find the artifact it would have written still sitting
                -- there and still what it wrote; a check writes no artifact and so has
                -- nothing to confirm but the record.
                local usable = cacheCompatible
                    and previous
                    and previous.sourcePath == path
                    and previous.sourceHash == sourceHash
                    and previous.specializationHash == (
                        specializationHashes[normalize(path)] or emptySpecializationHash
                    )
                    and previous.interfaceHash
                    and type(previous.dependencies) == "table"
                    and type(previous.projectDependencies) == "table"
                    and type(previous.externalInputs) == "table"
                    and type(previous.effects) == "table"
                    and type(previous.runtimeModules) == "table"
                    and type(previous.diags) == "table"
                    and type(previous.aotRefusals) == "table"
                    and (previous.aotKey == nil or previous.aotKey == currentAotKey())
                    and type(previous.materializations) == "table"
                    and type(previous.derives) == "table"
                    and type(previous.optimizationRemarks) == "table"
                    and type(previous.allocationSites) == "table"
                    and type(previous.optimizationAccounted) == "boolean"
                if usable and previous then
                    for _, dependency in ipairs(previous.projectDependencies or {}) do
                        if type(dependency) ~= "table" then
                            usable = false
                            break
                        end
                        local dependencyName = dependency.name
                        local dependencyKey = dependency.key
                        local dependencyFingerprint = dependency.fingerprint
                        if type(dependencyName) ~= "string"
                            or type(dependencyKey) ~= "string"
                            or type(dependencyFingerprint) ~= "string"
                        then
                            usable = false
                            break
                        end
                        if not GUARANTEE_QUERY[dependencyName]
                            and inc.projectDependencyFingerprint(
                                dependencyName as string,
                                dependencyKey as string
                            ) ~= dependencyFingerprint
                        then
                            usable = false
                            break
                        end
                    end
                end
                if usable and previous then
                    -- A header `cheader` read, or anything else the checker took from
                    -- outside the project's modules. Its bytes are not the source's,
                    -- so an edit to only the header moves nothing else checked here.
                    for _, input in ipairs(previous.externalInputs or {}) do
                        if type(input) ~= "table"
                            or type(input.path) ~= "string"
                            or type(input.fingerprint) ~= "string"
                            or inc.externalInputFingerprint(input.path as string) ~= input.fingerprint
                        then
                            usable = false
                            break
                        end
                    end
                end
                if usable and previous and not checkOnly and not external then
                    usable = previous.artifactHash ~= nil and hashFile(output as string) == previous.artifactHash
                end
                if usable and previous then
                    records[item.name] = copyModuleRecord(previous)
                    records[item.name].output = output
                    records[item.name].external = external or nil
                    reused[item.name] = true
                    -- A file that is still exactly as it was still has whatever it had
                    -- to say about itself. Silent reuse would make `nupp check` mean
                    -- "nothing changed" rather than "nothing is wrong", and the second
                    -- run over a project with an error in it would pass.
                    said[item.name] = previous.diags
                    linkSelectedDependencies(item.name, previous.dependencies or {}, previous.effects or {})
                    for _, runtimeModule in ipairs(previous.runtimeModules or {}) do
                        if not addCarriedRuntime(runtimeModule) then
                            linkPackagedRuntime(runtimeModule)
                            enqueue(runtimeModule)
                        end
                    end
                    for _, depName in ipairs(previous.dependencies or {}) do
                        if not packagedCheckSources[depName] or packagedRuntimeModules[depName] then
                            enqueue(depName)
                        end
                    end
                else
                    compile(item.name, path, sourceHash)
                end
                report:resolved()
            end
        end
    end

    --- The modules a build of this target would lower, by name, or nil for every one.
    ---
    --- A build lowers what its deliverable reaches, not everything under the include
    --- roots: two targets can build one source tree at different feature tiers, and
    --- the scalar one must not be refused over a SIMD module it never bundles. The
    --- same closure is read here off the records' dependency lists, which a check has
    --- either just written or reused, so nothing is checked to answer it. It is asked
    --- when the diagnostics are reported rather than stored with a record, because
    --- whether a module is reached is a fact about the modules that require it.
    ---
    --- A module with no record at all -- a narrow check of a project never checked
    --- whole -- leaves the closure unknown, and every refusal is reported rather
    --- than one being missed.
    local function refusalScope(): {[string]: boolean}?
        local pending: {string} = {}
        local seeds = false
        for _, entry in ipairs(target.entries or {}) do
            seeds = true
            local name: string? = entry
            if entry:match("%.nupp$") or entry:find("[/\\]") then
                name = envMod.moduleNameForPath(inc.env, join(root, entry))
            end
            if name == nil then
                return nil
            end
            pending[#pending + 1] = name as string
        end
        if target.sources ~= nil then
            seeds = true
            for _, path in ipairs(selectedSourceFiles(root, target) or {}) do
                local name = envMod.moduleNameForPath(inc.env, path)
                if name == nil then
                    return nil
                end
                pending[#pending + 1] = name as string
            end
        end
        if not seeds then
            return nil
        end
        for _, provider in ipairs(config._spiEntries or {}) do
            pending[#pending + 1] = provider.implementation
        end
        local reached: {[string]: boolean} = {}
        while #pending > 0 do
            local name = table.remove(pending) as string
            if not reached[name] then
                reached[name] = true
                local record = records[name] or oldState.modules[name]
                if record == nil then
                    if inc.modulePath(name) ~= nil then
                        return nil
                    end
                else
                    for _, dependency in ipairs(record.dependencies or {}) do
                        pending[#pending + 1] = dependency
                    end
                end
            end
        end

        return reached
    end

    processQueue()
    local invalidated = true
    while invalidated do
        invalidated = false
        for _, name in ipairs(order) do
            local record = records[name]
            if reused[name] and record and not carriedRuntime[name] then
                local dependencyChanged = false
                for _, depName in ipairs(record.dependencies or {}) do
                    local depPath = inc.modulePath(depName)
                    if depPath then
                        local current = records[depName]
                        local previous = oldState.modules[depName]
                        if not current or not previous or current.interfaceHash ~= previous.interfaceHash then
                            dependencyChanged = true
                            break
                        end
                    end
                end
                if not dependencyChanged then
                    for _, dependency in ipairs(record.projectDependencies or {}) do
                        if type(dependency) == "table" and GUARANTEE_QUERY[dependency.name] then
                            -- The module the key names. A module still reused here has
                            -- the body it was recorded against -- the loop above has
                            -- already settled anything whose dependencies moved -- so
                            -- the answer it gave then still stands and nothing is
                            -- asked. Only one that was recompiled has to be, and by
                            -- now it is checked, so asking is a memo hit.
                            local named = tostring(dependency.key):match("^([^%z]+)")
                            if not (named ~= nil and reused[named as string] and records[named as string]) then
                                if inc.projectDependencyFingerprint(
                                    dependency.name as string,
                                    dependency.key as string
                                ) ~= dependency.fingerprint then
                                    dependencyChanged = true
                                    break
                                end
                            end
                        end
                    end
                end
                if dependencyChanged then
                    compile(name, paths[name], record.sourceHash)
                    invalidated = true
                end
            end
        end
        processQueue()
    end

    -- A const-generic `@aot` family is specialized for every call the deliverable
    -- makes into it, and a build refuses what those calls demand: a tenth body over
    -- the cap, or a constant the body cannot lower with. Lowering a module alone
    -- sees only its own calls, so a family that only its callers close checked clean
    -- and then failed the build. Its verdict is settled again here, once every
    -- module has a record, from the calls of the modules that require it.
    --
    -- Only a module that names a family can call it, so a caller is a module that
    -- depends on the family's, directly or not, and mentions one of its names. The
    -- verdict is kept under those callers' sources, so an unchanged project lowers
    -- nothing again, and only an edit among them checks the rest to collect calls.
    if aotApplies then
        local dependents: {[string]: {string}} = {}
        for _, name in ipairs(order) do
            local record = records[name]
            if record and not carriedRuntime[name] then
                for _, dependency in ipairs(record.dependencies or {}) do
                    local list = dependents[dependency] or {}
                    list[#list + 1] = name
                    dependents[dependency] = list
                end
            end
        end
        for _, name in ipairs(order) do
            local record = records[name]
            local families = record and record.aotFamilies or nil
            if record and families and #families > 0 and not carriedRuntime[name] then
                local callers: {string} = {}
                local seen: {[string]: boolean} = {[name] = true}
                local pending: {string} = {name}
                while #pending > 0 do
                    for _, dependent in ipairs(dependents[table.remove(pending) as string] or {}) do
                        if not seen[dependent] then
                            seen[dependent] = true
                            pending[#pending + 1] = dependent
                            local path = paths[dependent]
                            local text = path and (substituted[normalize(path)] or inc.fileText(path)) or nil
                            local mentions = false
                            for _, family in ipairs(families) do
                                mentions = mentions or (text ~= nil and (text as string):find(family, 1, true) ~= nil)
                            end
                            if mentions
                                and not linkedModules[dependent]
                                and aotcheck.projectSource(root, config.include, outDir, path as string)
                            then
                                callers[#callers + 1] = dependent
                            end
                        end
                    end
                end
                table.sort(callers)
                if #callers == 0 then
                    -- A check of named files reaches what they require, not what
                    -- requires them, so it keeps what the last whole check said.
                    if not asked then
                        record.aotGraphRefusals, record.aotGraphKey = nil, nil
                    end
                else
                    local keyed: {string} = {currentAotKey(), name, record.sourceHash or ""}
                    for _, caller in ipairs(callers) do
                        keyed[#keyed + 1] = caller .. "=" .. tostring(records[caller].sourceHash)
                    end
                    local key = hash.digest(table.concat(keyed, "\0"))
                    if record.aotGraphKey ~= key or type(record.aotGraphRefusals) ~= "table" then
                        local path = paths[name]
                        local text = substituted[normalize(path)] or inc.fileText(path)
                        local own = inc.checkFile(path)
                        local graph: {any} = {{filename = path, module = name, result = own.result}}
                        local complete = own.result ~= nil and not isFatalIn(own.diags) and text ~= nil
                        for _, caller in ipairs(callers) do
                            local checked = inc.checkFile(paths[caller])
                            complete = complete and checked.result ~= nil and not isFatalIn(checked.diags)
                            graph[#graph + 1] = {filename = paths[caller], module = caller, result = checked.result}
                        end
                        -- A caller that does not check is refused for that, and the
                        -- build it would fail stops there too, so the module's own
                        -- verdict is what is left to say.
                        if complete then
                            local found = jsonArray({} as {any})
                            local plans = constspecialize.collectGraph(graph)
                            for _, diag in ipairs(
                                aotcheck.refusals(text as string, path, own.result, target as any, plans)
                            ) do
                                found[#found + 1] = diag
                            end
                            record.aotGraphRefusals, record.aotGraphKey = found, key
                        else
                            record.aotGraphRefusals, record.aotGraphKey = nil, nil
                        end
                    end
                end
            end
        end
    end

    -- Counted here rather than where reuse is decided, because a module reused early
    -- can be invalidated by a dependency later and recompiled; only once the loop above
    -- settles is `reused` the answer. A check counts the same way a build does, which
    -- is what lets a test say "this edit rechecked one module" instead of timing it.
    local compiledModules = 0
    for _, name in ipairs(order) do
        if not carriedRuntime[name] then
            if reused[name] and not parallelChecked[name] then
                stats.reusedModules = stats.reusedModules + 1
            else
                compiledModules = compiledModules + 1
            end
        end
    end
    -- Compiler-carried artifacts are copied, not checked or generated by this build.
    report:counted(compiledModules, stats.reusedModules)
    for _, name in ipairs(order) do
        local spent = (checkMs[paths[name] or ""] or 0) + (generateMs[name] or 0)
        if spent > 0 then
            report:spent(name, spent)
        end
    end

    -- Everything this run learned is written here, which is before the diagnostics are
    -- judged rather than after. A run that ends in errors learned exactly as much as
    -- one that did not -- what every file declares, what each module's interface is,
    -- and what each had to say -- and a project with an error in it is precisely the
    -- one somebody is about to check again.
    report:at("persist")
    report:step("saving what this run worked out")
    inc.persist()
    if checkOnly and checkState then
        local checked = {}
        -- A run that looked at the whole source set keeps only what it looked at, which
        -- is how a module that was deleted stops being remembered. A run asked about
        -- named files looked at a corner of the project on purpose, so it carries the
        -- rest of the last run's record forward untouched -- dropping it would make one
        -- narrow check throw away the work of every earlier one, and the next
        -- whole-project check would start cold. A carried record is re-validated
        -- against its source and its dependencies before anything is reused from it.
        --
        -- What that revalidation cannot see is which compiler wrote the record, because
        -- that is asked once of the state as a whole. Carrying records into a state
        -- stamped with this compiler said they were this compiler's, and they were the
        -- last one's: a narrow check run after the checker changed left every module it
        -- did not visit stamped as current, and the next whole-project check reused all
        -- of them -- reporting the messages the previous checker had written until the
        -- store was deleted by hand. Records the running compiler could not reuse
        -- itself are not records to hand on, so a run whose reuse gate is shut carries
        -- nothing forward.
        if asked and cacheCompatible then
            for name, record in pairs(oldState.modules or {}) do
                checked[name] = record
            end
        end
        for _, name in ipairs(order) do
            checked[name] = records[name]
        end
        newState.modules = checked
        checkState.set(newState)
        checkState.save()
    end

    -- Everything gathered is said, in the order the modules were reached, so the report
    -- reads the same whether a module was checked this run or read back from the last
    -- one.
    --
    -- A check of named files says what is wrong with those files. It reached their
    -- dependencies and has opinions about them, and reporting those would answer a
    -- question nobody asked -- name one file, hear about thirty. Whether the project as
    -- a whole is well typed is what `nupp check` with no files means.
    local errors: {any} = {}
    local aotScope = aotApplies and refusalScope() or nil
    for _, name in ipairs(order) do
        if not asked or asked[name] then
            for _, diag in ipairs(said[name] or {}) do
                errors[#errors + 1] = diag
            end
            if aotScope == nil or aotScope[name] then
                local record = records[name]
                local refused = record and (record.aotGraphRefusals or record.aotRefusals) or nil
                for _, diag in ipairs(refused or {}) do
                    errors[#errors + 1] = diag
                end
            end
        end
    end
    local fatal, checkFailed = false, false
    for _, e in ipairs(errors) do
        if isFatal(e) then
            fatal = true
            -- A generation failure is not the project being wrong about itself, and
            -- says so differently.
            if not e.code or e.code:sub(1, 5) ~= "NUPP3" then
                checkFailed = true
            end
        end
    end
    if diagnostics then
        for _, diagnostic in ipairs(errors) do
            diagnostics[#diagnostics + 1] = diagnostic
        end
    elseif #errors > 0 then
        -- A step line is rewritten in place, so anything printed over it would leave
        -- half of it behind and above whatever came next.
        report:clear()
        printErrors(errors)
    end
    if fatal then
        return nil, checkFailed and "project has errors" or "code generation failed"
    end
    local materializations = {}
    local derives = {}
    local optimizationRemarks = {}
    local allocationSites = {}
    local accountedModules: integer = 0
    for _, name in ipairs(order) do
        for _, observation in ipairs(records[name].materializations or {}) do
            materializations[#materializations + 1] = observation
        end
        for _, observation in ipairs(records[name].derives or {}) do
            derives[#derives + 1] = observation
        end
        if records[name].optimizationAccounted then
            accountedModules = (accountedModules + 1) as integer
            for _, remark in ipairs(records[name].optimizationRemarks or {}) do
                optimizationRemarks[#optimizationRemarks + 1] = remark
            end
            for _, site in ipairs(records[name].allocationSites or {}) do
                allocationSites[#allocationSites + 1] = site
            end
        end
    end
    if checkOnly then
        return {
            outputs = {},
            materializations = materializations,
            derives = derives,
            optimizationRemarks = optimizationRemarks,
            allocationSites = allocationSites,
            accountedModules = accountedModules
        }
    end

    -- Every module compiled, with no closure to prune it back to. A stale dependency
    -- list can still enqueue a name, but a name that is not a source file has no path
    -- and never entered the queue, and one that is a source file belongs in the build
    -- regardless of who does or does not require it.
    local pending: {{
        path: string,
        text: string
    }} = {}
    local outputs = {}
    local effects = {}
    newState.modules = {}
    for _, name in ipairs(order) do
        local record = records[name]
        newState.modules[name] = record
        for _, effect in ipairs(record.effects or {}) do
            effects[effect] = true
        end
        if record.output then
            outputs[record.output] = true
        end
        if not record.external and not reused[name] then
            local code = codeFor[name]
            if code and hashFile(record.output) ~= record.artifactHash then
                pending[#pending + 1] = {path = record.output, text = code}
            end
        end
    end

    for _, name in ipairs(order) do
        if not records[name].external and not records[name].artifactHash then
            return nil, "code generation failed"
        end
    end

    for _, resource in ipairs(target.resources or {}) do
        local pattern: string
        if type(resource) == "table" then
            pattern = (resource as Resource).source
        else
            pattern = resource as string
        end
        for _, source in ipairs(expandGlob(root, pattern)) do
            local output = join(root, join(outDir, resourceOutput(config, resource, source, root)))
            local text, err = readFile(source)
            if not text then
                return nil, err
            end
            outputs[output] = true
            if hashFile(output) ~= contentDigest(text) then
                pending[#pending + 1] = {path = output, text = text}
            end
        end
    end
    report:at("write")
    for _, item in ipairs(pending) do
        report:step("writing " .. shortPath(root, item.path))
        local ok, err = writeFile(item.path, item.text)
        if not ok then
            return nil, err
        end
    end

    -- Once the modules on disk are the ones this build decided on, and not
    -- before: the cache is named by what was written, so writing it first would
    -- name something that is not there yet.
    require("nupp.tools.bytecodecache").refresh(join(root, outDir), newState.modules)

    return {
        outputs = outputs,
        effects = effects,
        materializations = materializations,
        derives = derives,
        optimizationRemarks = optimizationRemarks,
        allocationSites = allocationSites,
        accountedModules = accountedModules
    }
end

--- The source files one target reaches, or nothing when it reaches the project.
---
--- A target that names `sources` owns that selection plus whatever its entries
--- and those sources require; a target that names none retains the
--- whole-project contract and is answered with `nil` so a caller keeps whatever
--- it does for a project-wide scope. The closure is the same one the module
--- build seeds with, walked through the same query graph, so a phase that runs
--- before the build cannot decide a different set of modules is in the
--- deliverable than the build then compiles.
---
--- @param session the graph the closure is walked through, shared with the
---   build that follows so each import is answered once
--- @return the reached files as a set of normalized paths, or nothing and why
--- @raises never an entry that resolves to nothing is reported, not thrown
local function targetScope(root: string, target: Target, session: modules.Session): ({[string]: boolean}?, string?)
    if target.sources == nil and #(target.entries or {}) == 0 then
        return nil, nil
    end
    local inc = session.inc
    local reached: {[string]: boolean} = {}
    local queue: {string} = {}

    local function seed(path: string): nil
        local file = normalize(path)
        if not reached[file] then
            reached[file] = true
            queue[#queue + 1] = file
        end
    end

    for _, entry in ipairs(target.entries or {}) do
        local path: string? = nil
        if entry:match("%.nupp$") or entry:find("[/\\]") then
            path = join(root, entry)
        else
            path = inc.modulePath(entry)
        end
        if path == nil then
            return nil, "entry not found: " .. entry
        end
        seed(path as string)
    end
    local selected, selectedErr = selectedSourceFiles(root, target)
    if selectedErr then
        return nil, selectedErr
    end
    for _, path in ipairs(selected or {}) do
        seed(path)
    end
    -- Discovery adds runtime roots that no literal require in the consumer names.
    -- Their ordinary import closure needs the same AOT policy as the entry's.
    for _, implementation in ipairs(inc.env.config._spiEntries or {}) do
        local path = inc.modulePath(implementation.implementation)
            or session.stageBundled(implementation.implementation)
        if path ~= nil then
            seed(path)
        end
    end
    local cursor: integer = 1
    while cursor <= #queue do
        local path = queue[cursor] as string
        cursor = cursor + 1
        for _, dependency in ipairs(inc.moduleDependencies(path)) do
            local dependencyPath = inc.modulePath(dependency)
            if dependencyPath ~= nil then
                seed(dependencyPath as string)
            end
        end
    end

    return reached, nil
end

modules.targetScope = targetScope
modules.typeFingerprint = typeFingerprint
modules.resourceOutput = resourceOutput
modules.build = buildModules

--- Checks one dependency-ready component in an isolated worker session.
---
--- Imported interfaces are installed before any assigned source is checked. The
--- returned module records remain plain data, while semantic interfaces are graph
--- images that another worker can decode into its own checker identity.
function modules.parallelCheckBatch(request: any, context: any?): (any, any)
    local workerClock = require("nupp.time")
    local batchStarted = workerClock.now()
    local assigned: {[string]: boolean} = {}
    for _, path in ipairs(request.paths or {}) do
        assigned[normalize(path)] = true
    end
    if context == nil or context.key ~= request.sessionKey then
        local declared: {[string]: boolean} = {}
        for _, path in ipairs(request.projectPaths or {}) do
            declared[normalize(path)] = true
        end
        context = {
            key = request.sessionKey,
            declared = declared,
            nominals = {},
            interfaceArenas = {},
            interfaceOrigins = {},
            imports = {},
            root = request.root,
            outDir = request.outDir,
            target = request.target,
            projectPaths = request.projectPaths,
        } as any
        context.session = openSession(
            request.root,
            request.outDir,
            request.config,
            request.target,
            request.state.dependencies,
            request.strict,
            nil,
            context.nominals,
            true,
            function(path): nil
                local normalized = normalize(path)
                if context.declared[normalized] and not context.assigned[normalized] then
                    context.checkedOutside = normalized
                    error("parallel worker recursively checked " .. normalized, 0)
                end
            end
        )
    end
    context.assigned = assigned
    context.checkedOutside = nil
    local session = context.session
    local contentDigest = fingerprint.contentDigest(true)
    for _, source in ipairs(request.sources or {}) do
        local text = session.inc.fileText(normalize(source.path))
        if text == nil or contentDigest(text as string) ~= source.hash then
            return {ok = false, problem = "parallel source fingerprint mismatch for " .. tostring(source.path)}, context
        end
    end
    local requestRoot = context.root
    local requestOutDir = context.outDir
    local requestTarget = context.target
    local requestProjectPaths = context.projectPaths
    local interfaceimage = require("nupp.compiler.project.interfaceimage")
    local interfaceProtocol = require("nupp.tools.build.parallelcheckprotocol")
    local newlyImported: {[string]: any} = {}
    local decodeStarted = workerClock.now()
    for _, import in ipairs(request.imports or {}) do
        local image = import
        if import.path ~= nil then
            local encoded, readProblem = readFile(import.path)
            if encoded == nil then
                return {ok = false, problem = "interface store: " .. tostring(readProblem)}, context
            end
            local decoded, decodeProblem = interfaceProtocol.decode(encoded as string)
            if decoded == nil or decoded.fingerprint ~= import.fingerprint then
                return {
                    ok = false,
                    problem = "interface store: " .. tostring(decodeProblem or "fingerprint mismatch"),
                }, context
            end
            image = decoded
        end
        local semantics, _, problem = interfaceimage.decode(
            image,
            context.nominals,
            context.interfaceArenas,
            context.interfaceOrigins
        )
        if semantics == nil then
            return {ok = false, problem = "import bundle: " .. tostring(problem)}, context
        end
        for name, semantic in pairs(semantics) do
            if not context.imports[name] then
                newlyImported[name] = semantic
                context.imports[name] = true
            end
        end
    end
    session.inc.importModules(newlyImported)
    local decodedAt = workerClock.now()

    if aotcheck.applies(requestTarget.aot) then
        return {ok = false, problem = "parallel module records do not lower AOT checks"}, context
    end

    -- The ordinary build driver owns discovery, reuse, linking, generation and
    -- persistence. Re-entering all of it for every dependency wave made a worker do
    -- much more orchestration than checking. A cold worker already receives an exact
    -- dependency-ready source set, so produce the check-only cache records directly.
    local emptySpecializationHash = contentDigest("")
    local records: {[string]: any} = {}
    local diagnostics: {any} = {}
    local unchecked: {string} = {}
    local checkStarted = workerClock.now()
    local semanticMs = 0
    local recordMs = 0
    for _, requestedPath in ipairs(request.paths or {}) do
        local path = normalize(requestedPath)
        local name = envMod.moduleNameForPath(session.inc.env, path)
        local source = session.inc.fileText(path)
        if name == nil or source == nil then
            unchecked[#unchecked + 1] = path
        else
            local semanticStarted = workerClock.now()
            local result = session.inc.checkReadyFile(path)
            semanticMs = semanticMs + workerClock.now() - semanticStarted
            local recordStarted = workerClock.now()
            local checkedDiags = jsonArray({} as {any})
            for _, diagnostic in ipairs(result.diags or {}) do
                checkedDiags[#checkedDiags + 1] = diagnostic
                diagnostics[#diagnostics + 1] = diagnostic
            end
            local dependencyNames = jsonArray(session.inc.moduleDependencies(path))
            local effectNames: {string} = {}
            for effect in pairs(result.result and result.result.effects or {}) do
                effectNames[#effectNames + 1] = effect
            end
            local moduleEffect = native.forModule(name)
            if moduleEffect ~= nil then
                local found = false
                for _, effect in ipairs(effectNames) do
                    found = found or effect == moduleEffect
                end
                if not found then
                    effectNames[#effectNames + 1] = moduleEffect
                end
            end
            table.sort(effectNames)
            local external = path:match("%.d%.nupp$") ~= nil or envMod.isDependencyTypePath(session.inc.env, path)
            local sourceHash = contentDigest(source as string)
            local checkedExports = result.exports or {}
            records[
                name
            ] = {
                sourcePath = path,
                sourceHash = sourceHash,
                interfaceHash = modules.interfaceHash(
                    result.moduleType,
                    checkedExports,
                    external and sourceHash or nil,
                    contentDigest
                ),
                dependencies = dependencyNames,
                runtimeModules = jsonArray({} as {string}),
                projectDependencies = jsonArray(session.inc.projectDependencies(path)),
                externalInputs = jsonArray(session.inc.externalInputs(path)),
                effects = jsonArray(effectNames),
                output = not external and join(requestRoot, join(requestOutDir, name:gsub("%.", "/") .. ".lua")) or nil,
                external = external or nil,
                diags = checkedDiags,
                aotRefusals = jsonArray({} as {any}),
                materializations = jsonArray(materializeObserve.collect(result.result and result.result.root, path)),
                derives = jsonArray(result.result and result.result.deriveObservations or {}),
                optimizationRemarks = jsonArray({} as {any}),
                allocationSites = jsonArray({} as {any}),
                optimizationAccounted = false,
                specializationHash = emptySpecializationHash,
            }
            recordMs = recordMs + workerClock.now() - recordStarted
        end
    end
    if context.checkedOutside ~= nil then
        local checkedOutside = context.checkedOutside as string?
        return {
            ok = false,
            problem = checkedOutside and ("recursive check of " .. checkedOutside),
            diagnostics = diagnostics,
        }, context
    end
    local checkedAt = workerClock.now()

    local interfaceStarted = workerClock.now()
    local interfaces: {[string]: any} = {}
    local interfaceNames: {string} = {}
    for _, path in ipairs(request.exportPaths or request.paths or {}) do
        local name = envMod.moduleNameForPath(session.inc.env, path)
        if name then
            local semantic = session.inc.moduleSemantic(name, path)
            semantic.path = path
            semantic.projectPaths = requestProjectPaths
            interfaces[name] = semantic
            interfaceNames[#interfaceNames + 1] = name
        end
    end
    table.sort(interfaceNames)
    local interfaceAt = workerClock.now()
    local interfaceBundle, imageProblem = nil, nil
    local interfaceRef: any? = nil
    local encodeStarted = workerClock.now()
    if #interfaceNames > 0 then
        interfaceBundle, imageProblem = interfaceimage.encode(
            interfaces,
            context.interfaceOrigins,
            context.interfaceArenas
        )
        if interfaceBundle == nil then
            return {ok = false, problem = "interface bundle: " .. tostring(imageProblem)}, context
        end
        if request.interfaceStore ~= nil then
            local prerequisites: {string} = {}
            local seenPrerequisite: {[string]: boolean} = {}
            for _, node in ipairs(interfaceBundle.descriptor and interfaceBundle.descriptor.types or {}) do
                if node.kind == "external" and not seenPrerequisite[node.arena] then
                    seenPrerequisite[node.arena] = true
                    prerequisites[#prerequisites + 1] = node.arena
                end
            end
            table.sort(prerequisites)
            local interfacePath = join(request.interfaceStore, interfaceBundle.fingerprint .. ".buf")
            local written, writeProblem = writeFile(interfacePath, interfaceProtocol.encode(interfaceBundle))
            if not written then
                return {ok = false, problem = "interface store: " .. tostring(writeProblem)}, context
            end
            interfaceRef = {
                path = interfacePath,
                fingerprint = interfaceBundle.fingerprint,
                prerequisites = prerequisites,
                nodes = #(interfaceBundle.descriptor.types or {}),
            }
        end
    end
    local encodedAt = workerClock.now()

    local importedCount: integer = 0
    for _ in pairs(newlyImported) do
        importedCount = importedCount + 1
    end

    return {
        ok = true,
        modules = records,
        interfaceBundle = interfaceRef == nil and interfaceBundle or nil,
        interfaceRef = interfaceRef,
        interfaceNames = interfaceNames,
        diagnostics = diagnostics,
        stats = {
            checkedModules = #request.paths,
            importedModules = importedCount,
            interfaceNodes = interfaceRef and interfaceRef.nodes
            or interfaceBundle and #(interfaceBundle.descriptor.types or {})
            or 0,
            setupMs = decodeStarted - batchStarted,
            decodeMs = decodedAt - decodeStarted,
            checkMs = checkedAt - checkStarted,
            semanticMs = semanticMs,
            recordMs = recordMs,
            interfaceMs = interfaceAt - interfaceStarted,
            encodeMs = encodedAt - encodeStarted,
            totalMs = encodedAt - batchStarted,
        },
        unchecked = unchecked,
    }, context
end

--- Checks one dependency-ready batch and keeps its lane's query session.
function modules.parallelCheckWorker(request: any): any
    if not parallelWorkerInitialized then
        local types = require("nupp.compiler.types")
        types.setIdentityNamespace("cold", request.initializer)
        parallelWorkerInitialized = true
    end
    local answer
    answer, parallelWorkerContext = modules.parallelCheckBatch(request, parallelWorkerContext)

    return answer
end

modules.session = openSession

export = modules
