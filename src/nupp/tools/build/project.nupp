module nupp.tools.build.project

--[[
Building what the manifest describes.

A project's `nupp.lua` names targets; this resolves each one to the set of
modules it reaches, compiles what has changed, copies the resources it declares,
and writes the result. What counts as changed is answered by the content hashes
in the build cache, not by timestamps.
]]
const {type Stats} = require("nupp.tools.build.modules")

local process = require("nupp.compiler.process")
local fs = require("nupp.compiler.fs")
local cache = require("nupp.tools.build.cache")
local fingerprint = require("nupp.compiler.project.fingerprint")
local manifest = require("nupp.tools.build.manifest")
local tasks = require("nupp.tools.build.tasks")
local deps = require("nupp.tools.build.deps")
local generators = require("nupp.tools.build.generators")
local spi = require("nupp.tools.build.spi")
local modules = require("nupp.tools.build.modules")
local buildPlatform = require("nupp.tools.build.platform")
local storeMod = require("nupp.compiler.project.store")
local native = require("nupp.tools.build.native")
local materializeObserve = require("nupp.compiler.comptime.materialize.observe")
local progressMod = require("nupp.tools.build.progress")

local project = {}

--- What a build was asked for, over and above what the manifest says.
---
--- The last three are collectors rather than settings: a caller that passes one is
--- reporting what it finds itself, so the build fills it in and says nothing.
type project.BuildOptions = {
    --- Which target to build; the manifest's default when absent.
    target: string?,

    --- A configured binary platform, or "all" at the public build boundary.
    platform: string?,

    host: string?,

    --- Where to write, instead of the target's own directory.
    outDir: string?,

    --- Check without generating or writing anything.
    checkOnly: boolean?,

    --- Check these files, and whatever they require, rather than the project. Only a
    --- check narrows: a build compiles the whole source set whatever it was asked
    --- about.
    ---
    --- A named file the project does not reach -- a declaration file, a `.lua`, a file
    --- from outside -- is appended to `unchecked` rather than refused, for the caller
    --- to check on its own.
    paths: {string}?,
    unchecked: {string}?,

    --- Build instrumented for coverage. Folded into the build key, so an ordinary cache
    --- entry can never satisfy a coverage run.
    coverage: boolean?,

    --- How many modules were checked, generated and reused.
    stats: Stats?,

    --- When to say what the run is doing and what it cost: "always", "never", or
    --- "auto", which means only when standard error is a terminal. Absent, the answer
    --- comes from `NUPP_PROGRESS` and failing that from "auto". A check narrates on the
    --- same terms, saying "checked" where a build says "built".
    progress: string?,

    --- Every diagnostic, instead of printing them.
    diagnostics: {any}?,

    --- Which target ran and what it wrote.
    produced: {[string]: any}?
}

--- What `test` was asked for, over and above the manifest's `test` table. The coverage
--- fields are the caller's, not the manifest's: a coverage run is asked for per
--- invocation rather than configured once.
type project.TestOptions = {
    --- Where the built target went, when it is not the target's own directory.
    outDir: string?,

    --- Build instrumented, and let the test command know.
    coverage: boolean?,

    --- Added to the test command's environment, over the manifest's own.
    env: {[string]: string}?,

    --- Where a `--json` run gathers why it stopped before the test command ran,
    --- instead of stderr.
    diagnostics: {any}?
}

--- What `clean` was asked for.
type project.CleanOptions = {
    --- A target's output directory rather than every target's.
    target: string?,

    --- A configured platform or "all". Meaningful only with `target`.
    platform: string?,

    --- Say what would go, and remove nothing.
    dryRun: boolean?,

    --- The paths, instead of writing a line about each.
    removed: {string}?,

    --- Where a `--json` run gathers why it stopped, instead of stderr.
    diagnostics: {any}?
}

--- What a fixpoint run was asked for.
type project.FixpointOptions = {
    --- What happened, instead of the human line saying so.
    result: {[string]: any}?,

    --- Where a `--json` run gathers why it stopped, instead of stderr.
    diagnostics: {any}?
}

-- The check state's own shape. The module compiler that wrote a record is added to
-- this where the store is opened, so each compiler finds its own record; the config
-- still lives inside the record and is compared there, the same way the build state
-- compares it.
local CHECK_STATE_STAMP = "checks/1"

local normalize, join = fs.normalize, fs.join
local dirname, basename = fs.dirname, fs.basename
local readFile, writeFile = fs.readFile, fs.writeFile
local copyFile, listFiles = fs.copyFile, fs.listFiles

local stable = require("nupp.compiler.stable")
local loadState, saveState = cache.loadState, cache.saveState
local toolFingerprint = fingerprint.toolFingerprint
local targetConfig = tasks.targetConfig
local buildDependencies = deps.build
local buildModules = modules.build
-- Optional build tools are loaded only by a target that requests them. Keep
-- their dependencies visible to module fingerprinting.
@allow("unused-binding")
const _DYNAMIC_REQUIRES = [[
@requires-dynamically nupp.tools.hotsession
@requires-dynamically nupp.tools.doc
@requires-dynamically nupp.tools.build.package
]]
local loadBuildTool: function(string): any = require

local function mentionsGpuTarget(path: string): boolean
    local source = fs.readFile(path)
    return source ~= nil
        and (source as string):find("@aot", 1, true) ~= nil
        and (source as string):match("target%s*=%s*[\"']gpu[\"']") ~= nil
end

--- A check does not enter the AOT phase that normally stages this runtime before
--- checking. Look over the files it is about to check so CPU-only projects still
--- neither stage nor inspect the GPU module.
local function checkedTargetNeedsGpu(root: string, config: any, paths: {string}?): boolean
    for _, path in ipairs(paths or {}) do
        if mentionsGpuTarget(path) or mentionsGpuTarget(join(root, path)) then
            return true
        end
    end
    for _, directory in ipairs(config.include or {}) do
        for _, path in ipairs(listFiles(join(root, directory))) do
            if path:match("%.nupp$") ~= nil and mentionsGpuTarget(path) then
                return true
            end
        end
    end

    return false
end

--- Authored files that can change either AOT code or a scoped target's graph.
---
--- Include roots are the files the AOT policy can emit. A path entry or an
--- explicit `build.sources` selection may live elsewhere in the project; even
--- when it emits no unit itself, changing its imports changes which include-
--- root units `targetScope` admits. Hash those selectors without paying for the
--- Reads and validates a project's manifest. See nupp.tools.build.manifest.
project.loadManifest = manifest.load

--- The tasks a manifest defines. See nupp.tools.build.tasks.
project.describeTasks = tasks.describe

project.encode = tasks.encode

--- Says why a build or check stopped: as a coded diagnostic when the caller is
--- gathering them for `--json`, and as the line of text it always was otherwise.
--- The code is one of the failures outside source -- NUPP0001 a file, NUPP0002 the
--- manifest, NUPP0003 a name the project does not define, NUPP0004 a tool that failed
--- -- because a run refused here never got as far as a position to point at.
local function say(opts: {diagnostics: {any}?}?, code: string, text: string): nil
    if opts == nil or opts.diagnostics == nil then
        io.stderr:write(text)
        return
    end
    local message = text:gsub("\n$", "")
    local diagnostics = (opts as {diagnostics: {any}?}).diagnostics as {any}
    diagnostics[
        #diagnostics + 1
    ] = require("nupp.tools.cli.report").runDiagnostic(code, message, nil, code == "NUPP0002" and "nupp.lua" or nil)
end

local function buildOne(root: string?, opts: project.BuildOptions?): integer
    root, opts = root or ".", (opts or {}) as project.BuildOptions
    -- Started before the manifest is read, because a build takes as long as it takes
    -- from where the caller asked for one, and a reader timing it with a wristwatch is
    -- not going to exclude the parts this one thought were setup.
    --
    -- A check narrates on the same terms a build does. Checking a cold project is the
    -- better part of a minute of work that used to look identical to a hang, and the
    -- reason to stay quiet -- scripts read this output -- is already answered by
    -- writing nothing unless the stream is a terminal.
    local report = progressMod.new(opts.progress)
    local config, loadErr = project.loadManifest(root)
    if not config then
        say(opts, "NUPP0002", tostring(loadErr) .. "\n");
        return 1
    end
    local target, targetErr = targetConfig(config, opts.target)
    if not target then
        say(opts, "NUPP0003", "nupp: " .. tostring(targetErr) .. "\n");
        return 1
    end
    target.host = opts.host or target.host or "native"
    if target.host ~= "native" and target.host ~= "browser" then
        say(opts, "NUPP0002", "nupp: host must be native or browser\n")
        return 1
    end
    if target.host == "browser" and target.platforms ~= nil then
        say(
            opts,
            "NUPP0002",
            "nupp: platforms selects native binary hosts and cannot be combined with host = \"browser\" or --host browser\n"
        )
        return 1
    end

    local selectedPlatform = opts.platform
    if target.platforms then
        if selectedPlatform == nil then
            if #target.platforms == 1 then
                selectedPlatform = target.platforms[1]
            else
                say(
                    opts,
                    "NUPP0003",
                    "nupp: binary target " .. tostring(
                        target.name or opts.target or "default"
                    ) .. " configures several platforms; select one with --platform or use --platform all\n"
                )
                return 1
            end
        end
        local configured = false
        for _, name in ipairs(target.platforms) do
            configured = configured or name == selectedPlatform
        end
        if not configured then
            say(
                opts,
                "NUPP0003",
                "nupp: platform " .. tostring(
                    selectedPlatform
                ) .. " is not configured on binary target " .. tostring(target.name or opts.target or "default") .. "\n"
            )
            return 1
        end
        target.layoutTarget = selectedPlatform
        -- A program for another platform carries AOT code compiled for that
        -- platform, unless the target names its AOT platform itself.
        if target.aot ~= nil and target.aotTarget == nil and selectedPlatform ~= buildPlatform.hostKey() then
            target.aotTarget = selectedPlatform
        end
    elseif selectedPlatform ~= nil then
        say(
            opts,
            "NUPP0003",
            "nupp: --platform requires a binary target with a platforms list; target " .. tostring(
                target.name or opts.target or "default"
            ) .. " has none\n"
        )
        return 1
    end
    config._target = target
    config._platform = selectedPlatform
    -- Coverage affects emitted Lua, therefore belongs in the configuration before the
    -- build key is calculated. A normal cache entry can never satisfy a coverage run.
    config._coverage = opts.coverage == true
    if target.kind == "docs" then
        -- A documentation target declares dependencies like any other. They are
        -- installed before the build rather than discovered missing halfway through
        -- a page.
        local installed, depErr = buildDependencies(
            root,
            normalize(opts.outDir or target.outDir or "build"),
            config,
            {},
            target
        )
        if not installed then
            say(opts, "NUPP0004", "nupp: " .. tostring(depErr) .. "\n")
            return 1
        end
        return (loadBuildTool("nupp.tools.doc").build(root, config, target, {
            checkOnly = opts.checkOnly,
            output = opts.outDir,
        }))
    elseif not opts.checkOnly
        and (target.kind == "modules" or target.kind == "bundle" or target.kind == "component")
    then
        -- These produced Lua, and nothing produces Lua any more: a library is its
        -- Nupp source, and a program is a binary on the VM runtime.
        say(
            opts,
            "NUPP0002",
            "nupp: a "
            .. target.kind
            .. " target produced Lua, which Nupp no longer generates; "
            .. "a library needs no build target, and a program is kind = \"binary\" with stub = \"nupp\"\n"
        )
        return 1
    elseif target.kind ~= nil
        and target.kind ~= "binary"
        and target.kind ~= "modules"
        and target.kind ~= "bundle"
        and target.kind ~= "component"
    then
        say(opts, "NUPP0002", "nupp: unsupported build target kind " .. tostring(target.kind) .. "\n")
        return 1
    elseif target.kind == "binary" and not opts.checkOnly then
        -- A binary is a VM program for the machine building it: the image lowered
        -- from its sources, stamped onto the VM runtime.
        local refusal = nil
        if target.stub ~= "nupp" then
            refusal = "a binary target's stub must be \"nupp\": binaries are VM programs on the Nupp runtime"
        elseif selectedPlatform ~= nil then
            refusal = "a binary builds for the machine building it; VM programs for another platform are not available"
        end
        if refusal ~= nil then
            say(opts, "NUPP0002", "nupp: " .. refusal .. "\n")
            return 1
        end
    end
    -- A target without a kind is a library, which is its source: building one
    -- checks its modules and records them, and produces nothing beside them.
    local checkOnly = opts.checkOnly
    local outDir = normalize(opts.outDir or target.outDir or "build")
    local completionPath = join(root, join(outDir, ".nupp-complete"))
    -- The stamp is written when the build starts and renamed into place when it
    -- finishes, because a rename keeps the mtime the write gave it. The launcher
    -- rebuilds whenever a source is newer than this file, and a stamp dated from the
    -- end of a build covers every edit made while it was running: an edit that landed
    -- too late to be compiled was also too old to ask for another build, so the tree
    -- stayed one edit behind until something unrelated happened to move.
    local pendingCompletionPath = completionPath .. ".pending"
    if not checkOnly then
        os.remove(completionPath)
        os.remove(pendingCompletionPath)
    end
    local newState = cache.emptyState()
    -- Every cache key below this line goes through one digest. A native host has a
    -- compiled one that answers identically, so resolve it once here and hand it
    -- down rather than letting each site fall back to the portable implementation.
    local contentDigest = fingerprint.contentDigest(true)
    newState.compilerHash = toolFingerprint(contentDigest)
    -- Dated here, before a single source has been read, and published by the rename
    -- below once they all have been.
    if not checkOnly then
        local stamped, stampErr = writeFile(pendingCompletionPath, newState.compilerHash .. "\n")
        if not stamped then
            say(opts, "NUPP0001", "nupp: " .. tostring(stampErr) .. "\n")
            return 1
        end
    end
    -- What compiling a module reaches, rather than everything the compiler contains. An
    -- edit to a command, to the language server, or to anything else the module build
    -- does not call now leaves the last build's artifacts reusable, where before it
    -- rebuilt the project. The carried declarations are part of it: a module is
    -- checked against `lua.d.nupp` as much as against the checker.
    newState.moduleCompilerHash = cache.moduleCompilerFingerprint(
        fingerprint.sharedCacheDir(join(root, join(outDir, "cache"))),
        contentDigest
    )
    newState.configHash = contentDigest(stable(config))
    -- A check and a build each keep their own record of what they last did. They agree
    -- about what a module is but not about what counts as done: a build's record is
    -- only good while the artifact it names is still on disk and still what it wrote,
    -- and a check writes no artifact at all. One file for both would have each
    -- invalidating the other's work.
    local statePath = join(root, join(outDir, ".nupp-state.json"))
    local checkState = nil
    local oldState
    -- Stamped with the module compiler, so a check by another compiler -- `bin/nupp`
    -- and the binary it builds, each used on one project -- is kept beside this
    -- one's record rather than replacing it, and alternating them no longer
    -- rechecks everything each time.
    if checkOnly then
        checkState = storeMod.openValue(
            join(root, join(outDir, "cache/checks.buf")),
            CHECK_STATE_STAMP .. "\0" .. newState.moduleCompilerHash
        )
        oldState = cache.adoptState(checkState.value)
    else
        oldState = loadState(statePath)
    end
    -- Every other target's record is carried through untouched, so building one does
    -- not make the others look like they produced nothing.
    for name, produced in pairs(oldState.targets) do
        newState.targets[name] = produced
    end
    local targetKey = target.name or opts.target or "default"
    if selectedPlatform then
        targetKey = targetKey .. "@" .. selectedPlatform
    end
    report:at("dependencies")
    report:step("resolving dependencies")
    local dependencies, depErr = buildDependencies(root, outDir, config, oldState.dependencies, target)
    report:clear()
    if not dependencies then
        say(opts, "NUPP0004", "nupp: " .. tostring(depErr) .. "\n");
        return 1
    end
    newState.dependencies = dependencies
    report:at("generate")
    report:step("running generators")
    local generated, generatorErr = generators.run(root, outDir, config, dependencies, oldState.generators)
    report:clear()
    if not generated then
        say(opts, "NUPP0004", "nupp: " .. tostring(generatorErr) .. "\n")
        return 1
    end
    newState.generators = generated
    local spiEntries, spiError = spi.read(root, config, target, dependencies)
    if spiEntries == nil then
        say(opts, "NUPP0002", "nupp: " .. tostring(spiError) .. "\n")
        return 1
    end
    local wroteSpi, writeSpiError = spi.write(root, outDir, spiEntries)
    if not wroteSpi then
        say(opts, "NUPP0001", "nupp: " .. tostring(writeSpiError) .. "\n")
        return 1
    end
    config._spiEntries = spiEntries
    local session = modules.session(root, outDir, config, target, dependencies, report)
    local validSpi, invalidSpi = spi.check(session, spiEntries, root, outDir)
    if not validSpi then
        say(opts, "NUPP0002", "nupp: " .. tostring(invalidSpi) .. "\n")
        return 1
    end
    local writtenSpi, publishSpiError = spi.write(root, outDir, spiEntries)
    if not writtenSpi then
        say(opts, "NUPP0001", "nupp: " .. tostring(publishSpiError) .. "\n")
        return 1
    end
    session.inc.diskChanged(join(root, join(outDir, "generated/nupp/spi/index.nupp")), 2)

    if checkOnly and target.aot == "require" and checkedTargetNeedsGpu(root, config, opts.paths) then
        session.stageGpuRuntime()
    end
    -- Modules are checked and nothing is generated from them: a VM program's
    -- image is lowered from the sources themselves, and a coverage build's sites
    -- are numbered where it is.
    (target as any)._skipConstSpecialization = true
    local result, buildErr = buildModules(
        root,
        outDir,
        config,
        target,
        oldState,
        newState,
        opts.stats,
        opts.diagnostics,
        checkState,
        opts.paths and {paths = opts.paths, unchecked = opts.unchecked or {},} or nil,
        report,
        nil,
        nil,
        session
    )
    -- Everything from here writes to the same stream the step line is on, so it comes
    -- off the screen once rather than before each of a dozen messages.
    report:clear()
    if not result then
        if opts.produced then
            opts.produced.timing = report:timing()
        end
        if buildErr ~= "project has errors" and buildErr ~= "code generation failed" then
            say(opts, "NUPP0004", "nupp: " .. tostring(buildErr) .. "\n")
        end
        return 1
    end
    if checkOnly then
        report:finish("checked", targetKey)
        if opts.produced then
            opts.produced.target = target.name or opts.target or "default"
            opts.produced.platform = selectedPlatform
            opts.produced.outputs = cache.jsonArray({})
            opts.produced.timing = report:timing()
        end
        return 0
    end
    for output in pairs(result.outputs) do
        newState.outputs[output] = true
    end

    -- A binary is its program image stamped onto the VM runtime, which carries
    -- every native facility itself.
    local primaryArtifact: string? = nil
    if target.kind == "binary" then
        report:at("bundle")
        report:step("bundling " .. (target.name or target.kind))
        local package = loadBuildTool("nupp.tools.build.package")
        local text, bundleErr, unreachable, facilities = package.programPayload(
            root,
            config,
            target,
            outDir,
            newState.modules
        )
        if not text then
            say(opts, "NUPP0004", "nupp: " .. tostring(bundleErr) .. "\n")
            return 1
        end
        if unreachable and #unreachable > 0 then
            say(
                opts,
                "NUPP0002",
                (
                    "nupp: %d resource%s could not be bundled, "
                    .. "starting at %s: a bundle can only carry what sits under "
                    .. "the entry module's namespace\n"
                ):format(#unreachable, #unreachable == 1 and "" or "s", unreachable[1])
            )
        end
        local name = target.name or opts.target or target.kind
        local output = package.binaryOutput(root, target, name, outDir, nil, opts.outDir ~= nil)
        if target.payloadOutput ~= nil then
            local payloadOutput = join(root, target.payloadOutput as string)
            if normalize(payloadOutput) == normalize(output) then
                say(opts, "NUPP0002", "nupp: binary payloadOutput must differ from its executable output\n")
                return 1
            end
            local written, writeErr = writeFile(payloadOutput, text)
            if not written then
                say(opts, "NUPP0001", "nupp: " .. tostring(writeErr) .. "\n")
                return 1
            end
            newState.outputs[payloadOutput] = true
        end
        report:step("building the VM program runtime")
        -- A program with vector code gets a runtime with its image compiled in;
        -- any other is stamped onto the shared runtime.
        local named: {string} = {}
        local vector = false
        for _, facility in ipairs(facilities or {}) do
            if facility == "vector" then
                vector = true
            else
                named[#named + 1] = facility
            end
        end
        local stubPath, hostErr
        if vector then
            local payloadPath = join(root, join(outDir, ".nupp-vm-program.payload"))
            local written, writeErr = writeFile(payloadPath, text)
            if not written then
                say(opts, "NUPP0001", "nupp: " .. tostring(writeErr) .. "\n")
                return 1
            end
            stubPath, hostErr = native.vmProgramRuntime(named, payloadPath)
        else
            stubPath, hostErr = native.vmRuntime(named)
        end
        if not stubPath then
            say(opts, "NUPP0004", "nupp: " .. tostring(hostErr) .. "\n")
            return 1
        end
        local stub, stubErr = readFile(stubPath as string)
        if not stub then
            say(opts, "NUPP0001", ("nupp: cannot read the stub %s: %s\n"):format(stubPath, tostring(stubErr)))
            return 1
        end
        local stamped, stampErr = package.stampFile(output, stub, text, package.payloadFlagVmProgram)
        if not stamped then
            say(opts, "NUPP0004", "nupp: " .. tostring(stampErr) .. "\n")
            return 1
        end
        primaryArtifact = output
        newState.outputs[output] = true
        -- A dependency's library has to go with the artifact: its binding names
        -- it relative to whatever loads that binding, and here that is the
        -- artifact. One named for the platform loader instead carries no `@` and
        -- stays where it is, since nothing is looking for it beside anything.
        for _, dep in pairs(dependencies) do
            local relative = dep.usage == "target"
                and dep.reference ~= nil
                and (dep.reference as string):match("^@(.+)$")
                or nil
            local runtimeOutput = dep.usage == "target"
                and (dep.runtimeOutput or (dep.staticOutput == nil and dep.output))
                or nil
            if relative ~= nil and runtimeOutput ~= nil then
                local beside = join(dirname(output), relative as string)
                local copied, copyErr = copyFile(runtimeOutput as string, beside)
                if not copied then
                    say(
                        opts,
                        "NUPP0001",
                        ("nupp: cannot put the compiled library beside %s: %s\n"):format(output, tostring(copyErr))
                    )

                    return 1
                end
                newState.outputs[beside] = true
            end
        end
        report:clear()
    end
    for _, dep in pairs(dependencies) do
        if dep.output then
            newState.outputs[dep.output] = true
        end
        if dep.staticOutput then
            newState.outputs[dep.staticOutput] = true
        end
        if dep.binding then
            newState.outputs[dep.binding] = true
        end
    end
    -- Only what this target produced last time and does not produce now. The old rule
    -- was every output the directory had ever held, which meant a bundle build deleted
    -- the binary stamped from it and a binary build deleted the bundle, quietly, since
    -- removing a file nobody asked about looks exactly like tidying up.
    local mine = {}
    for output in pairs(newState.outputs) do
        mine[#mine + 1] = output
    end
    table.sort(mine)
    for _, output in ipairs(oldState.targets[targetKey] or {}) do
        if not newState.outputs[output] then
            os.remove(output)
        end
    end
    newState.targets[targetKey] = mine
    -- What the build produced, for a caller that has to report it rather than leave it
    -- on disk to be discovered. Same shape of favour as opts.diagnostics.
    if opts.produced then
        opts.produced.target = target.name or opts.target or "default"
        opts.produced.platform = selectedPlatform
        opts.produced.artifact = primaryArtifact
        opts.produced.outputs = mine
        opts.produced.materializations = materializeObserve.public(result.materializations)
        opts.produced.derives = result.derives
        opts.produced.spi = spiEntries
    end
    report:at("write")
    local ok, stateErr = saveState(statePath, newState)
    if not ok then
        say(opts, "NUPP0001", "nupp: " .. tostring(stateErr) .. "\n");
        return 1
    end
    local completed, completionErr = os.rename(pendingCompletionPath, completionPath)
    if not completed then
        -- Nothing to publish, which is a build that took a path around the stamp
        -- rather than a failure. Write one dated now: later than it should be, and
        -- better than a tree that never looks built.
        completed, completionErr = writeFile(completionPath, newState.compilerHash .. "\n")
    end
    if not completed then
        say(opts, "NUPP0001", "nupp: " .. tostring(completionErr) .. "\n")
        return 1
    end
    report:finish("built", targetKey)
    -- Timing is published whether or not anything was printed, because a caller
    -- reporting the build as a document reads it here rather than off the terminal.
    if opts.produced then
        opts.produced.timing = report:timing()
    end

    return 0
end

--- Builds one selected platform or every configured platform. The per-platform loop
--- lives above `buildOne` so each result commits its own state and a later failure does
--- not invalidate an earlier output.
function project.build(root: string?, opts: project.BuildOptions?): integer
    root, opts = root or ".", (opts or {}) as project.BuildOptions
    if opts.platform ~= "all" then
        return buildOne(root, opts)
    end
    local config, loadErr = project.loadManifest(root)
    if not config then
        say(opts, "NUPP0002", tostring(loadErr) .. "\n")
        return 1
    end
    local target, targetErr = targetConfig(config, opts.target)
    if not target then
        say(opts, "NUPP0003", "nupp: " .. tostring(targetErr) .. "\n")
        return 1
    end
    if not target.platforms then
        say(opts, "NUPP0003", "nupp: --platform all requires a binary target with a platforms list\n")
        return 1
    end
    local aggregate = opts.produced
    if aggregate then
        aggregate.target = target.name or opts.target or "default"
        aggregate.outputs = cache.jsonArray({})
        aggregate.platforms = cache.jsonArray({})
    end
    local failed = false
    for _, selected in ipairs(target.platforms) do
        local childOptions: any = {}
        for key, value in pairs(opts) do
            if key ~= "produced" then
                childOptions[key] = value
            end
        end
        childOptions.platform = selected
        local produced: any = aggregate and {} or nil
        childOptions.produced = produced
        local code = buildOne(root, childOptions)
        failed = failed or code ~= 0
        if aggregate then
            local entry = {
                platform = selected,
                status = code == 0 and "built" or "failed",
                outputs = cache.jsonArray(produced.outputs or {}),
                error = code == 0 and nil or "platform build failed; see diagnostics or standard error",
                distributionReady = produced.distributionReady,
                notice = produced.notice,
            }
            aggregate.platforms[#aggregate.platforms + 1] = entry
            for _, output in ipairs(produced.outputs or {}) do
                aggregate.outputs[#aggregate.outputs + 1] = output
            end
        end
    end
    if aggregate then
        table.sort(aggregate.outputs)
    end

    return failed and 1 or 0
end

function project.check(root: string?, opts: project.BuildOptions?): integer
    opts = (opts or {}) as project.BuildOptions;
    opts.checkOnly = true
    return project.build(root, opts)
end

--- @return the test command's exit status, or 1 when it never ran
--- @return what stopped it before it ran: `manifest` or `build`, absent once it did
function project.test(root: string?, args: {string}?, opts: project.TestOptions?): (integer, string?)
    root = root or "."
    local asked: project.TestOptions = opts or {}
    local config, err = project.loadManifest(root)
    if not config then
        say(asked, "NUPP0002", tostring(err) .. "\n")
        return 1, "manifest"
    end
    local test = manifest.testConfig(config)
    local produced: {[string]: any} = {}
    if project.build(root, {
        target = test.build,
        outDir = asked.outDir,
        coverage = asked.coverage,
        produced = produced,
        diagnostics = asked.diagnostics
    }) ~= 0 then
        return 1, "build"
    end
    local argv = {}
    for _, item in ipairs(manifest.testArgv(test)) do
        argv[#argv + 1] = item
    end
    local builtTarget = assert(targetConfig(config, test.build))
    if asked.outDir ~= nil and builtTarget.output ~= nil and produced.artifact then
        for index, item in ipairs(argv) do
            if item == builtTarget.output then
                argv[index] = produced.artifact as string
            end
        end
    end
    for _, item in ipairs(args or {}) do
        argv[#argv + 1] = item
    end
    -- The built-in runner is another compiler command. In a source checkout the
    -- process itself is build/nupp/tools/main.lua, not the launcher a shell can
    -- execute, so resolve the conventional manifest path back to that launcher.
    -- A stamped compiler has no checkout root and is already its own executable.
    if argv[1] == "nupp" and argv[2] == "test" and argv[3] == "--internal-runner" then
        local compilerRoot = os.getenv("NUPP_COMPILER_ROOT")
        argv[1] = compilerRoot and compilerRoot .. "/bin/nupp" or tostring(arg[0] or argv[1])
    end
    local env: {[string]: string} = {}
    for key, value in pairs(test.env or {}) do
        env[key] = value
    end
    for key, value in pairs(asked.env or {}) do
        env[key] = value
    end
    env.NUPP_TEST_BUILD = normalize(asked.outDir or env.NUPP_TEST_BUILD or builtTarget.outDir or "build")
    -- The rocks the tested target depends on were installed into a tree that belongs to
    -- the project, and the test command is a fresh interpreter that has never heard of
    -- it. A trailing empty entry is where Lua substitutes its own path, so the tree is
    -- added to what a test can load rather than put in place of it.
    local rocks = deps.rockPaths(root, config, builtTarget)
    if rocks then
        -- Keep the caller's coverage protocol values while adding the project rock
        -- paths the fresh test process needs.
        env.LUA_PATH = rocks.path .. ";" .. (env.LUA_PATH or os.getenv("LUA_PATH") or "")
        env.LUA_CPATH = rocks.cpath .. ";" .. (env.LUA_CPATH or os.getenv("LUA_CPATH") or "")
    end

    -- The test command learns which process started it, and ends what it started
    -- if that process is killed; a shell left between the two would outlive this
    -- one and hide it. So the shell hands its process over, and the command also
    -- names this one outright.
    local pid = fs.processId()
    if pid ~= nil then
        env.NUPP_TEST_WATCH_PID = tostring(pid)
    end

    return process.run(argv, {cwd = root, env = env, replaceShell = true})
end

--- Runs `tasks.<name>` from the manifest: builds `tasks.<name>.build` first if it names
--- one, then execs `tasks.<name>.argv` from its configured working directory with
--- `args` appended. Unlike `test`, which
--- always builds (there is exactly one test command and it is nothing without the code
--- under test), a custom task only builds when it says to, and most won't name a build
--- target at all.
function project.runTask(root: string?, name: string, args: {string}?): integer
    root = root or "."
    local config, err = project.loadManifest(root)
    if not config then
        io.stderr:write(tostring(err) .. "\n");
        return 1
    end
    local tasks = config.tasks or {}
    -- The guard below is what decides whether there is a task at all; the cast only
    -- says that indexing a map of them yields one.
    local task = tasks[name] as manifest.Task
    if type(task) ~= "table" or type(task.argv) ~= "table" then
        io.stderr:write("nupp: no task named " .. tostring(name) .. "; see `nupp task --list`\n")
        return 1
    end
    if task.build then
        if project.build(root, {target = task.build}) ~= 0 then
            return 1
        end
    end
    local argv = {}
    for _, item in ipairs(task.argv or {}) do
        argv[#argv + 1] = item
    end
    for _, item in ipairs(args or {}) do
        argv[#argv + 1] = item
    end
    local env = task.env
    if task.build then
        -- Same reasoning as test's rock path: the built target's rocks live in this
        -- project's own tree, and a task that names a build target likely wants to run
        -- something that can see it.
        local rocks = deps.rockPaths(root, config, (targetConfig(config, task.build)))
        if rocks then
            env = {}
            for key, value in pairs(task.env or {}) do
                env[key] = value
            end
            env.LUA_PATH = rocks.path .. ";" .. (env.LUA_PATH or os.getenv("LUA_PATH") or "")
            env.LUA_CPATH = rocks.cpath .. ";" .. (env.LUA_CPATH or os.getenv("LUA_CPATH") or "")
        end
    end

    return process.run(argv, {cwd = join(root, task.cwd or ""), env = env})
end

local function removeTree(path)
    if os.remove(path) then
        return 0
    end
    if package.config:sub(1, 1) == "\\" then
        return process.run({"cmd", "/d", "/c", "if", "exist", path, "rmdir", "/s", "/q", path})
    end

    return process.run({"rm", "-rf", path})
end

local function safeCleanPath(path)
    path = normalize(path or "")
    if path == ""
        or path == "."
        or path:sub(1, 1) == "/"
        or path:match("^%a:")
        or path:find("%z")
        or path == ".."
        or path:match("^%.%./")
        or path:match("/%.%./")
        or path:match("/%.%.$")
    then
        return nil, "unsafe build output path " .. tostring(path)
    end

    return path
end

function project.clean(root: string?, opts: project.CleanOptions?): integer
    root, opts = root or ".", (opts or {}) as project.CleanOptions
    if opts.target then
        local config, loadErr = project.loadManifest(root)
        if not config then
            say(opts, "NUPP0002", tostring(loadErr) .. "\n")
            return 1
        end
        local target, targetErr = targetConfig(config, opts.target)
        if not target then
            say(opts, "NUPP0003", "nupp: " .. tostring(targetErr) .. "\n")
            return 1
        end
        if target.platforms then
            local selected: {string} = {}
            if opts.platform == nil or opts.platform == "all" then
                for _, name in ipairs(target.platforms) do
                    selected[#selected + 1] = name
                end
            else
                for _, name in ipairs(target.platforms) do
                    if name == opts.platform then
                        selected[1] = name
                    end
                end
                if #selected == 0 then
                    say(
                        opts,
                        "NUPP0003",
                        "nupp: platform "
                        .. opts.platform
                        .. " is not configured on binary target "
                        .. opts.target
                        .. "\n"
                    )
                    return 1
                end
            end
            local outDir = normalize(target.outDir or "build")
            local candidates: {string} = {}
            for _, selectedPlatform in ipairs(selected) do
                local raw = loadBuildTool(
                    "nupp.tools.build.package"
                ).binaryOutput(".", target, target.name or opts.target, outDir, selectedPlatform)
                candidates[#candidates + 1] = raw
                if require("nupp.tools.build.platform").isPosix(selectedPlatform) then
                    candidates[#candidates + 1] = raw .. ".tar"
                end
            end
            local collected = opts.removed
            for _, candidate in ipairs(candidates) do
                local safe, safeErr = safeCleanPath(candidate)
                if not safe then
                    say(opts, "NUPP0002", "nupp: refusing to clean " .. safeErr .. "\n")
                    return 1
                end
                if not opts.dryRun and removeTree(join(root, safe)) ~= 0 then
                    say(opts, "NUPP0001", "nupp: cannot remove build output " .. safe .. "\n")
                    return 1
                end
                if collected then
                    collected[#collected + 1] = safe
                elseif opts.dryRun then
                    io.write("would remove " .. safe .. "\n")
                else
                    io.write("removed " .. safe .. "\n")
                end
            end
            if not opts.dryRun then
                local statePath = join(root, join(outDir, ".nupp-state.json"))
                if readFile(statePath) then
                    local state = loadState(statePath)
                    for _, selectedPlatform in ipairs(selected) do
                        state.targets[(target.name or opts.target) .. "@" .. selectedPlatform] = nil
                    end
                    local saved, saveErr = saveState(statePath, state)
                    if not saved then
                        say(opts, "NUPP0001", "nupp: " .. tostring(saveErr) .. "\n")
                        return 1
                    end
                end
            end
            return 0
        elseif opts.platform then
            say(opts, "NUPP0003", "nupp: --platform requires a binary target with a platforms list\n")
            return 1
        end
    end
    local described, err = project.describeTasks(root, opts.target, {buildOnly = true})
    if not described then
        say(opts, "NUPP0002", tostring(err) .. "\n");
        return 1
    end
    local tasks = opts.target and {described} or described.tasks
    local candidates: {[string]: boolean} = {}
    for _, task in ipairs(tasks) do
        local path, pathErr = safeCleanPath(task.outDir)
        if not path then
            say(opts, "NUPP0002", "nupp: refusing to clean " .. pathErr .. "\n")
            return 1
        end
        candidates[path] = true
    end
    local paths: {string} = {}
    for path in pairs(candidates) do
        paths[#paths + 1] = path
    end
    table.sort(paths)
    local selected: {string} = {}
    for _, path in ipairs(paths) do
        local covered = false
        for _, parent in ipairs(selected) do
            if path == parent or path:sub(1, #parent + 1) == parent .. "/" then
                covered = true
                break
            end
        end
        if not covered then
            selected[#selected + 1] = path
        end
    end
    -- A caller that collects is reporting the paths itself, so saying them here too
    -- would put prose in front of whatever it is about to write.
    local collected = opts.removed
    for _, path in ipairs(selected) do
        if not opts.dryRun and removeTree(join(root, path)) ~= 0 then
            say(opts, "NUPP0001", "nupp: cannot remove build output " .. path .. "\n")
            return 1
        end
        if collected then
            collected[#collected + 1] = path
        elseif opts.dryRun then
            io.write("would remove " .. path .. "\n")
        else
            io.write("removed " .. path .. "\n")
        end
    end

    return 0
end

--- Verifies that a stamped binary stamps out a binary identical to itself.
---
--- The compiler proves it can compile itself on every change; this is the same claim
--- one level up, and it is what makes the emitter trustworthy rather than plausible. It
--- fails if the payload is not deterministic, if the trailer does not round-trip, or if
--- the emitter's idea of where a payload starts disagrees with the stub's, and it is
--- the gate before anybody outside this project builds a stub against the format,
--- because after that the format cannot move.
---
--- Stage one is stamped by whatever compiler is running now. Stage two is stamped by
--- stage one, from the same sources, which is the part that would catch a payload that
--- quietly depends on the machine that wrote it.
function project.binaryFixpoint(root: string?, opts: project.FixpointOptions?): integer
    root = root or "."
    local config, err = project.loadManifest(root)
    if not config then
        say(opts, "NUPP0002", tostring(err) .. "\n");
        return 1
    end
    local targetName = config.selfHost and config.selfHost.binary or nil
    if not targetName then
        say(opts, "NUPP0002", "nupp: selfHost.binary names no target to stamp\n")
        return 1
    end
    local target, targetErr = targetConfig(config, targetName)
    if not target then
        say(opts, "NUPP0003", "nupp: " .. tostring(targetErr) .. "\n")
        return 1
    end
    if target.kind ~= "binary" then
        say(
            opts,
            "NUPP0002",
            ("nupp: selfHost.binary names %s, which is a %s target\n"):format(targetName, target.kind or "modules")
        )
        return 1
    end

    local built: {[string]: any} = {}
    if project.build(root, {target = targetName, produced = built}) ~= 0 then
        return 1
    end
    local produced = built.artifact
    if type(produced) ~= "string" then
        say(opts, "NUPP0004", "nupp: binary build produced no executable artifact\n")
        return 1
    end
    local first, readErr = readFile(produced)
    if not first then
        say(opts, "NUPP0001", "nupp: " .. tostring(readErr) .. "\n")
        return 1
    end

    -- Kept beside the output rather than replacing it, so stage two writes where stage
    -- one did and the comparison is of two files that were made the same way rather
    -- than of one file and a memory of another.
    local stage1 = produced .. ".stage1"
    local copied, copyErr = writeFile(stage1, first)
    if not copied then
        say(opts, "NUPP0001", "nupp: " .. tostring(copyErr) .. "\n")
        return 1
    end
    process.capture({"chmod", "+x", stage1})

    if process.run({stage1, "build", "--target", targetName}, {cwd = root}) ~= 0 then
        say(opts, "NUPP0004", "nupp: the stamped binary could not stamp one\n")
        return 1
    end
    local second, secondErr = readFile(produced)
    if not second then
        say(opts, "NUPP0004", "nupp: " .. tostring(secondErr) .. "\n")
        return 1
    end

    if first ~= second then
        say(
            opts,
            "NUPP0004",
            (
                "nupp: packaging fixpoint mismatch: %d bytes then %d; " .. "%s kept for inspection\n"
            ):format(#first, #second, stage1)
        )
        if opts and opts.result then
            opts.result.reason = "the stamped binary stamped a different one"
        end
        return 1
    end
    os.remove(stage1)
    if opts and opts.result then
        opts.result.target, opts.result.bytes = targetName, #first
    else
        io.write(
            (
                "packaging fixpoint ok: %s stamps out a binary identical to " .. "itself (%d bytes)\n"
            ):format(targetName, #first)
        )
    end

    return 0
end

export = project
