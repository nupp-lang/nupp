@!internal

--[[
The versioned payload shared by the cold-check coordinator and its workers.

Both ends use the same compiler and its host's plain-data encoding. A host
without that codec selects serial checking. Framing belongs to the worker
channel.
]]
module nupp.tools.build.parallelcheckprotocol

local nativeBuffer: any = rawget(_G, "__nupp_plain_codec")
local hasBuffer = nativeBuffer ~= nil
if not hasBuffer then
    hasBuffer, nativeBuffer = pcall(require, "string.buffer")
end

--- Whether this host can encode a payload at all.
export const available = hasBuffer

--- The longest frame either end accepts.
export const MAX_FRAME = 268435456

export function encode(value: any): string
    return nativeBuffer.encode({schema = 1, value = value})
end

export function decode(text: string): (any?, string?)
    if not hasBuffer then
        return nil, "parallel-check payloads are unavailable on this host"
    end
    local decoded, envelope = pcall(nativeBuffer.decode, text)
    if not decoded or type(envelope) ~= "table" or envelope.schema ~= 1 or type(envelope.value) ~= "table" then
        return nil, "the parallel-check payload is malformed"
    end

    return envelope.value, nil
end
