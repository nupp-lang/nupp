module nupp.tools.build.requires

--[[
The modules a Lua chunk requires, read from its syntax.

A build carries Lua runtime modules beside the Nupp it checks, and what one of
them needs is whatever it names in `require`, `_G.require` or `pcall(require, ...)`
with a literal string.
]]

local lexer = require("nupp.compiler.syntax.lexer")
local parser = require("nupp.compiler.syntax.parser")

local requires = {}

--- Every module `code` requires by a literal name, sorted.
function requires.modules(code: string): {string}
    local parsed = parser.parse(code, "=generated")
    local found: {[string]: boolean} = {}

    local function visit(node: any): nil
        if type(node) ~= "table" then
            return
        end
        if node.kind == "call" and node.obj and node.args then
            local callee = node.obj
            local direct = callee.kind == "name" and callee.token and callee.token.text == "require"
            local global = callee.kind == "dotIndex"
                and callee.obj
                and callee.obj.kind == "name"
                and callee.obj.token
                and callee.obj.token.text == "_G"
                and callee.name
                and callee.name.text == "require"
            local argument = node.args.exprs and node.args.exprs[1]
            if callee.kind == "name"
                and callee.token
                and callee.token.text == "pcall"
                and argument
                and argument.kind == "name"
                and argument.token
                and argument.token.text == "require"
            then
                direct = true
                argument = node.args.exprs[2]
            end
            if (direct or global) and argument and argument.kind == "string" then
                local name = lexer.stringValue(argument.token.text)
                if name ~= nil then
                    found[name] = true
                end
            end
        end
        for _, child in ipairs(node) do
            visit(child)
        end
    end

    visit(parsed.root)
    local modules = {}
    for name in pairs(found) do
        modules[#modules + 1] = name
    end
    table.sort(modules)

    return modules
end

export = requires
