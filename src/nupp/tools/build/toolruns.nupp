module nupp.tools.build.toolruns

--[[
How many external toolchain processes a build started, and how many
compilations it runs at once.

The count backs a claim about process creation: `build --json` publishes it,
and a test asserts a number rather than the absence of something it cannot
see. The code generator runs in process, so an AOT build starts none; the count
stays so that anything which ever does start one is seen.

Width is bounded by the processor count rather than by the job count, because
the constraint is the machine and not the work.
]]

local toolruns = {}

local windows = package.config:sub(1, 1) == "\\"

-- Every external toolchain process this build has started, whatever it was
-- for. Module state because the backend that starts them is reached from
-- several places and a count threaded through all of them would be a
-- parameter nothing else needed.
local counted: integer = 0

--- Forgets the count, for a build about to make its own claim about it.
function toolruns.reset(): nil
    counted = 0
end

--- How many external toolchain processes have been started since the reset.
function toolruns.count(): integer
    return counted
end

local processorMemo: integer? = nil

--- How many compilations this machine should run at once.
---
--- One per processor. Every unit is optimized at `-O3` on its own, so the work
--- is CPU-bound and oversubscribing it only lengthens the wave that everything
--- waits on.
---
--- Asked for only when there is dirty work, because asking runs a program.
function toolruns.processors(): integer
    if processorMemo ~= nil then
        return processorMemo as integer
    end
    local found: integer? = nil
    if windows then
        found = tonumber(os.getenv("NUMBER_OF_PROCESSORS") or "") as integer?
    else
        local handle = io.popen("getconf _NPROCESSORS_ONLN 2>/dev/null")
        if handle ~= nil then
            local line = (handle as LuaFile):read("*l");
            (handle as LuaFile):close()
            found = tonumber(line or "") as integer?
        end
    end
    if found == nil or (found as integer) < 1 then
        found = 4
    end
    processorMemo = math.floor(found as integer) as integer

    return processorMemo as integer
end

--- The width to run `jobs` compilations at.
---
--- `NUPP_AOT_JOBS` overrules it, which is what a machine sharing its processors
--- with something else wants, and what a measurement of the bound needs.
function toolruns.width(jobs: integer): integer
    if windows or jobs <= 1 then
        return 1
    end
    local asked = tonumber(os.getenv("NUPP_AOT_JOBS") or "")
    local bound = asked ~= nil and math.floor(asked as number) or toolruns.processors()
    if bound < 1 then
        bound = 1
    end

    return jobs < bound and jobs or bound as integer
end

export = toolruns
