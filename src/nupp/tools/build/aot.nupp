module nupp.tools.build.aot

--[[
The build's ahead-of-time policy.

A build selects one policy before it looks at any `@aot` body, and an artifact
records the one it was built under.

- `off` does not look for `@aot` at all. It is the default.
- `require` compiles every `@aot(target = "gpu")` kernel to its shader artifact
  and replaces the declaration with the generated binding that dispatches it.
  A CPU `@aot` function is refused: its native code generator was removed with
  LuaJIT, and the VM lowers those bodies itself.

This pass finds its work by reading sources rather than the module build's
bookkeeping, so it cannot be wrong about which source produced which artifact.
What it lowers is the checked tree of each of those sources, taken from the same
query graph the module build then uses: a parse says how a parameter, a call
target or an annotation was spelled, and only a check says what each resolved
to.
]]
const {type Session} = require("nupp.tools.build.modules")
const {type ParseResult} = require("nupp.compiler.syntax.parser")
const {type Reporter} = require("nupp.tools.build.progress")

local gpuBinding = require("nupp.compiler.aot.gpubinding")
local aotcheck = require("nupp.tools.build.aotcheck")
local compile = require("nupp.compiler.aot.compile")
local constspecialize = require("nupp.compiler.constspecialize")
local diagnosticMod = require("nupp.compiler.diagnostics")
local fs = require("nupp.compiler.fs")
local envMod = require("nupp.compiler.project.env")
local compilerFingerprint = require("nupp.compiler.project.fingerprint")
local stable = require("nupp.compiler.stable")
local hash = require("nupp.compiler.hash")
local progress = require("nupp.tools.build.progress")
local scalarIR = require("nupp.compiler.aot.scalar")
local targets = require("nupp.compiler.aot.target")

local isFatal = diagnosticMod.isFatal

local aot = {}

local compilerResourceFingerprintMemo: string? = nil

--- The compiler-carried sources that can affect AOT checking or code generation.
---
--- The compiler code fingerprint covers generated Lua, and the module compiler
--- fingerprint separately covers declarations. Neither covers the standard
--- library sources staged into another project. A pre-emission hit has to cover
--- them before it can skip the checker that would otherwise observe them.
function aot.compilerResourceFingerprint(contentDigest: (function(string): string)?): string
    if compilerResourceFingerprintMemo ~= nil then
        return compilerResourceFingerprintMemo as string
    end
    local digest = contentDigest or hash.digest
    local bundled = require("nupp.compiler.bundled")
    local list = require("nupp.compiler.bundledlist").list
    local paths: {string} = {}
    for _, path in ipairs(list("/nupp")) do
        paths[#paths + 1] = path
    end
    table.sort(paths)
    local parts: {string} = {}
    for _, path in ipairs(paths) do
        parts[#parts + 1] = path .. "\0" .. digest(bundled.source(path) or "missing")
    end
    compilerResourceFingerprintMemo = digest(table.concat(parts, "\0"))

    return compilerResourceFingerprintMemo as string
end

--- The policies a target may select.
const aot.POLICIES = {["off"] = true, ["require"] = true,}

--- The key that can be asked before any source is checked or lowered.
---
--- `semantic` is assembled by the project build beside the inputs it names:
--- the complete config, dependency and generator records, compiler
--- fingerprints, SPI selection and target. This function adds every authored
--- Nupp source the AOT policy can discover and every Lua source that can shape
--- a scoped target's import graph. It deliberately hashes more than a
--- target-scoped build may reach; an unnecessary miss is safe, while an
--- omitted imported body could reuse stale code.
function aot.inputFingerprint(sources: {string}, semantic: any, contentDigest: (function(string): string)?): string
    local digest = contentDigest or hash.digest
    local files: {string} = {}
    local seen: {[string]: boolean} = {}
    for _, path in ipairs(sources) do
        if path:match("%.nupp$") ~= nil or path:match("%.lua$") ~= nil then
            local canonical = fs.canonical(path)
            if not seen[canonical] then
                seen[canonical] = true
                files[#files + 1] = path
            end
        end
    end
    table.sort(files)
    local sources: {any} = {}
    for _, path in ipairs(files) do
        sources[#sources + 1] = {path = fs.normalize(path), digest = compilerFingerprint.hashFile(path, digest),}
    end

    return digest(stable({version = 1, semantic = semantic, sources = sources,}))
end

--- What a completed AOT result depends on beyond its sources: the policy and
--- the target.
function aot.toolchainPolicy(policy: string, targetTriple: string?): any
    return {policy = policy, target = targetTriple,}
end

--- Whether a source is worth parsing for `@aot` at all.
---
--- A substring test rather than a parse. It is allowed to say yes wrongly -- a
--- comment mentioning the annotation costs one parse that finds nothing -- and
--- it must never say no wrongly, which is why it looks for the bare word rather
--- than trying to tell an annotation from prose.
local function mentionsAot(text: string): boolean
    return text:find("@aot", 1, true) ~= nil
end

--- Returns whether source may need the GPU runtime while it is checked.
function aot.mentionsGpuTarget(text: string): boolean
    return aotcheck.mentionsGpuTarget(text)
end

local mentionsGpuTarget = aotcheck.mentionsGpuTarget

--- A source's checked tree, or nothing when there is no sound one to lower.
---
--- The tree the checker produced rather than a fresh parse of the same bytes.
--- What the backend needs from a parameter, a call target or an annotation is
--- what each of those resolved to, and only a checked tree carries that; a parse
--- carries the source form and leaves the backend to guess the rest.
---
--- Nothing, rather than an error, when the source does not check. The module
--- build checks the same file through the same graph a moment later and reports
--- it there, in the one place a source error is reported. Lowering it here would
--- either say the same thing twice or describe a program the checker has already
--- refused.
---
--- The exception is `unused-binding`, which is returned rather than dropped. A
--- linking policy replaces each `@aot` declaration with its wrapper before the
--- module build checks the file, so by then the removed body is not there to be
--- the reader of anything, and that lint would report a binding the author can
--- see being used. This check is the one that read the file as written, so its
--- verdict is the answer, and it is carried to the module build to report in
--- place of the rewritten source's.
---
--- @return the checked tree, and what it said about bindings nothing reads
local function checkedTree(session: Session, source: string): (ParseResult?, {any})
    local checked = session.inc.checkFile(source)
    if checked.missing == true or checked.syntax == true or checked.result == nil then
        return nil, {}
    end
    local authored: {any} = {}
    for _, diagnostic in ipairs(checked.diags or {}) do
        if isFatal(diagnostic) then
            return nil, {}
        end
        if (diagnostic as any).code == "NUPP2507" then
            authored[#authored + 1] = diagnostic
        end
    end

    return checked.result as ParseResult, authored
end

--- The source with every GPU `@aot` declaration replaced by its binding.
---
--- Substitution rather than a companion module, because a companion only
--- reaches callers who know to ask for it. A function replaced where it was
--- written is reached by every call in the file and by every importer, which is
--- what `@aot` says happens.
---
--- Back to front, so replacing one declaration does not move the next one's
--- offsets.
---
--- @param sites where each program was written, in the same order
--- @return the rewritten source
function aot.dispatch(
    source: string,
    programs: {scalarIR.Program},
    sites: {compile.Site},
    gpuArtifacts: {[string]: any}
): string
    local rewritten = source
    local replacements: {any} = {}
    for position = 1, #programs do
        local site = sites[position]
        if site ~= nil then
            local program = programs[position]
            local artifact = gpuArtifacts[program.symbol]
            assert(artifact ~= nil, "GPU program has no emitted shader")
            replacements[#replacements + 1] = {site = site, text = gpuBinding.replacement(program, artifact, false),}
        end
    end
    table.sort(replacements, function(a, b): boolean
        return a.site.from > b.site.from
    end)
    for _, replacement in ipairs(replacements) do
        local site = replacement.site
        rewritten = rewritten:sub(1, site.from - 1) .. replacement.text .. rewritten:sub(site.to + 1)
    end

    return rewritten
end

function aot.emit(
    root: string,
    outDir: string,
    roots: {string},
    session: Session,
    features: any,
    triple: string?,
    reporter: Reporter?,
    scope: {[string]: boolean}?,
    work: any?
): (boolean?, string?, {[string]: compile.Artifacts}, {[string]: {any}}, any?, {string}, compile.Diagnostic?)
    local report = reporter or progress.new("never")
    local counted = work or {}
    counted.checkedSources = 0
    counted.loweredPrograms = 0

    -- Named for the timeline rather than for the function, so `build --json`
    -- reports lowering, optimization and emission as three activities that add
    -- up to what the policy cost rather than as one that does not break down.
    local function at(step: string): nil
        report:at("aot:" .. step)
    end

    local produced: {[string]: compile.Artifacts} = {}
    local gpuSources: {string} = {}
    -- Kept for every source read here, and used only for the ones that end up
    -- rewritten, since only those are checked again as something else.
    local authoredUnused: {[string]: {any}} = {}
    local selected, targetErr = targets.buildTiers(triple, features)
    if selected == nil then
        return nil, tostring(targetErr), produced, authoredUnused, nil, gpuSources
    end

    local seen: {[string]: boolean} = {}
    local sources: {string} = {}
    local sourceText: {[string]: string} = {}
    local sourceDirectory: {[string]: string} = {}
    local sourceListed: {[string]: string} = {}
    local checkedBySource: {[string]: ParseResult} = {}
    local checkedModules: {any} = {}
    local sourceRoots: {string} = {}
    for _, directory in ipairs(roots) do
        sourceRoots[#sourceRoots + 1] = directory
    end
    -- Project source defaults to the project root. Use the environment's
    -- listing rather than a raw recursive walk so build output, dot trees and
    -- declarations are excluded by the same rule as the module build.
    if #sourceRoots == 0 then
        sourceRoots[1] = ""
    end
    for _, listed in ipairs(envMod.listSourceFilesFor(session.inc.env, root, roots, fs.join(root, outDir), false)) do
        local normalized = fs.normalize(listed)
        local directory: string? = nil
        local longest: integer = -1
        for _, candidate in ipairs(sourceRoots) do
            local base = fs.normalize(fs.join(root, candidate))
            if (base == "." or normalized == base or normalized:sub(1, #base + 1) == base .. "/")
                and #base > longest
            then
                directory = candidate
                longest = #base
            end
        end
        if directory ~= nil then
            -- The graph may reach the same file through a relative root. Its
            -- key is also the key the module build uses for replacements.
            local source = listed
            local name = envMod.moduleNameForPath(session.inc.env, listed)
            local resolved = name ~= nil and session.inc.modulePath(name as string) or nil
            if resolved ~= nil and resolved ~= listed and fs.canonical(resolved as string) == fs.canonical(listed) then
                source = resolved as string
            end
            if not seen[source]
                and source:match("%.nupp$") ~= nil
                and (scope == nil or (scope as {[string]: boolean})[fs.normalize(source)] == true)
            then
                seen[source] = true
                local text = fs.readFile(source)
                if text ~= nil then
                    sources[#sources + 1] = source
                    sourceText[source] = text as string
                    sourceDirectory[source] = directory as string
                    sourceListed[source] = listed
                end
            end
        end
    end
    table.sort(sources)
    local selectedPolicy = session.inc.env.config._target and session.inc.env.config._target.aot or nil
    if selectedPolicy == "require" then
        for _, source in ipairs(sources) do
            if mentionsGpuTarget(sourceText[source] as string) then
                session.stageGpuRuntime()
                break
            end
        end
    end
    local checkedSources: {string} = {}
    -- Checking asked for here is the policy's own: it reads every source the
    -- project could build, looking for the ones that carry an `@aot` body, and
    -- a module the build would have checked anyway is answered from the same
    -- graph either way. Charged to the policy while it is what is asking.
    local resumeChecking = report:charging("aot:check")
    report:at("aot:check")
    for _, source in ipairs(sources) do
        local checkedSource, unusedHere = checkedTree(session, source)
        if checkedSource ~= nil then
            counted.checkedSources = counted.checkedSources + 1
            checkedSources[#checkedSources + 1] = source
            checkedBySource[source] = checkedSource as ParseResult
            checkedModules[
                #checkedModules + 1
            ] = {filename = source, module = envMod.moduleNameForPath(session.inc.env, source), result = checkedSource,}
            if mentionsAot(sourceText[source] as string) then
                authoredUnused[source] = unusedHere
            end
        end
    end
    sources = checkedSources
    report:charging(resumeChecking)
    local constPlans = constspecialize.collectGraph(checkedModules)
    local acceptedConst, declinedConst = constspecialize.selectGraph(constPlans)
    local constSelection = {accepted = acceptedConst, declined = declinedConst, plans = constPlans,}
    for _, source in ipairs(sources) do
        local text = sourceText[source] as string
        local tree = checkedBySource[source] as ParseResult
        if mentionsAot(text) then
            -- Shaders do not depend on the CPU feature tier, so the first tier's
            -- lowering is the one a GPU kernel is emitted from.
            local tierTarget = (selected as {targets.Target})[1]
            local artifacts, diagnostics = compile.artifacts(
                text,
                source,
                tree,
                tierTarget,
                tierTarget.tier,
                constPlans,
                true,
                at
            )
            if artifacts == nil then
                -- A file that only mentioned the annotation is not an error.
                local first = diagnostics[1]
                if first ~= nil and first.code ~= compile.NO_AOT_FUNCTION then
                    local rendered = "feature tier " .. tierTarget.tier .. ": " .. compile.renderDiagnostic(first)
                    return nil, rendered, produced, authoredUnused, constSelection, gpuSources, first
                end
            else
                local compiled = artifacts as compile.Artifacts
                for _, program in ipairs(compiled.programs) do
                    if program.executionTarget ~= "gpu" then
                        return nil, (
                            "%s: %s is a CPU @aot function; only @aot(target = \"gpu\") compiles "
                            .. "ahead of time, so build it with aot = \"off\" or run it on the VM"
                        ):format(source, program.name), produced, authoredUnused, constSelection, gpuSources
                    end
                end
                counted.loweredPrograms = counted.loweredPrograms + #compiled.programs
                produced[source] = compiled
                if next(compiled.gpu) ~= nil then
                    gpuSources[#gpuSources + 1] = source
                end
            end
        end
    end

    return true, nil, produced, authoredUnused, constSelection, gpuSources
end

--- What a
record aot.Result
    --- Logical const-specialized families, counted once before target tiers.
    specializedBodies: integer

    --- Source path -> that source with its `@aot` declarations replaced by the
    --- bindings that dispatch their shaders.
    dispatch: {[string]: string}

    remarks: {any}?

    --- Source path -> what reading that source as written said about bindings
    --- nothing uses. The module build reports these instead of what the
    --- rewritten source says, which cannot see the readers the binding replaced.
    authoredUnused: {[string]: {any}}?

    --- Internal whole-deliverable selection reused by ordinary Lua emission.
    constSelection: any?

    --- Whether an authored GPU kernel needs the selected compute backend at runtime.
    gpu: boolean?

    --- Sources with authored GPU kernels, for generated runtime-effect selection.
    gpuSources: {string}?

    --- What this run of the policy did, for `build --json`.
    facts: aot.Facts?
end

--- What a policy run did.
record aot.Facts
    checkedSources: integer
    loweredPrograms: integer
end

local function replayFile(files: {[string]: string}, path: string?): nil
    if path ~= nil then
        files[path as string] = compilerFingerprint.hashFile(path as string) or "missing"
    end
end

--- Captures only plain data needed to replay a completed AOT policy.
---
--- Checked trees and const-specialization plans deliberately stay out because
--- they contain live semantic identities. A result with any such plan is not
--- replayed; reconstructing it after the AOT dispatch overlays are open would
--- select a different graph. The replay is also admitted only while every
--- output of the prior build still exists, so a module that needs regenerating
--- takes the conservative full AOT path as well.
function aot.captureReplay(policy: string, result: aot.Result): any
    local files: {[string]: string} = {}
    for _, source in ipairs(result.gpuSources or {}) do
        replayFile(files, source)
    end
    local selection = result.constSelection
    local hasConstSelection = selection ~= nil
        and type((selection as any).plans) == "table"
        and #((selection as any).plans) > 0
    local payload = {
        version = 2,
        policy = policy,
        hasConstSelection = hasConstSelection,
        files = files,
        specializedBodies = result.specializedBodies,
        dispatch = result.dispatch,
        remarks = result.remarks,
        authoredUnused = result.authoredUnused,
        gpu = result.gpu,
        gpuSources = result.gpuSources,
    }

    return {payload = payload, digest = hash.digest(stable(payload)),}
end

--- Restores a completed policy only while all retained evidence agrees.
--- Any old state, changed source byte or other policy is a miss.
function aot.replay(snapshot: any?): aot.Result?
    if snapshot == nil or type(snapshot.payload) ~= "table" or type(snapshot.digest) ~= "string" then
        return nil
    end
    local payload = snapshot.payload
    if payload.version ~= 2 or payload.hasConstSelection == true or hash.digest(stable(payload)) ~= snapshot.digest then
        return nil
    end
    for path, digest in pairs(payload.files or {}) do
        if compilerFingerprint.hashFile(path) ~= digest then
            return nil
        end
    end

    return new aot.Result(
        specializedBodies = payload.specializedBodies or 0,
        dispatch = payload.dispatch or {},
        remarks = payload.remarks,
        authoredUnused = payload.authoredUnused,
        gpu = payload.gpu,
        gpuSources = payload.gpuSources,
        facts = new aot.Facts(checkedSources = 0, loweredPrograms = 0)
    )
end

function aot.apply(
    policy: string,
    root: string,
    outDir: string,
    roots: {string},
    session: Session,
    features: any,
    triple: string?,
    reporter: Reporter?,
    scope: {[string]: boolean}?
): (aot.Result?, string?, compile.Diagnostic?)
    local report = reporter or progress.new("never")
    -- The same selection a check lowers for, so the two cannot disagree about tiers.
    triple, features = aotcheck.selection(policy, triple, features)
    local work = {checkedSources = 0, loweredPrograms = 0,}
    local emitted, emitErr, produced, authoredUnused, constSelection, gpuSources, refusal = aot.emit(
        root,
        outDir,
        roots,
        session,
        features,
        triple,
        report,
        scope,
        work
    )
    if emitted == nil then
        return nil, emitErr, refusal
    end
    report:at("aot")
    local remarks: {any} = {}

    local function appendRemark(filename: string, line: integer, column: integer, code: string, message: string): nil
        local source = fs.readFile(filename) or ""
        local offset = 1
        for _ = 2, line do
            offset = (source:find("\n", offset, true) or (#source + 1)) + 1
        end
        remarks[
            #remarks + 1
        ] = {
            filename = filename,
            line = line,
            col = column,
            offset = offset + column - 1,
            length = 1,
            code = code,
            severity = "note",
            pass = "aot",
            status = "fired",
            hotness = "unknown",
            msg = message,
        }
    end

    for _, sourcePath in ipairs(gpuSources) do
        local artifacts = produced[sourcePath]
        if artifacts ~= nil then
            for _, program in ipairs(artifacts.programs) do
                local gpu = artifacts.gpu[program.symbol]
                if gpu ~= nil then
                    appendRemark(
                        sourcePath,
                        gpu.sourceLine or 1,
                        gpu.sourceColumn or 1,
                        "GPU-DISPATCH",
                        program.name .. ": GPU shader emitted; " .. tostring(
                            gpu.threads
                        ) .. " threads per workgroup; artifact " .. tostring(gpu.artifactId)
                    )
                end
            end
        end
    end
    local specializedBodies: integer = 0
    for _, sourcePath in ipairs(gpuSources) do
        local artifacts = produced[sourcePath]
        if artifacts ~= nil then
            for _, family in ipairs((artifacts as compile.Artifacts).constFamilies or {}) do
                specializedBodies = specializedBodies + #family.programs
            end
        end
    end
    local dispatch: {[string]: string} = {}
    for _, sourcePath in ipairs(gpuSources) do
        local artifacts = produced[sourcePath]
        local source = fs.readFile(sourcePath)
        if artifacts ~= nil and source ~= nil then
            dispatch[
                sourcePath
            ] = aot.dispatch(
                source as string,
                (artifacts as compile.Artifacts).programs,
                (artifacts as compile.Artifacts).sites,
                (artifacts as compile.Artifacts).gpu
            )
        end
    end

    return new aot.Result(
        remarks = remarks,
        dispatch = dispatch,
        authoredUnused = authoredUnused,
        gpu = #gpuSources > 0,
        gpuSources = gpuSources,
        specializedBodies = specializedBodies,
        constSelection = constSelection,
        facts = new aot.Facts(checkedSources = work.checkedSources, loweredPrograms = work.loweredPrograms)
    ), nil
end

export = aot
