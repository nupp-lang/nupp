module nupp.tools.bytecodelisting

--[[
The human listing `nupp bc` prints, and where each of its lines came from.

The listing is a rendering rather than a lowering: one source line appears once
as an echo and then again as however many instructions it produced, and the
generated runtime preamble collapses into a single summary line. So unlike
generated Lua -- which `nupp.compiler.gen` holds to the source's own line
numbering -- a bytecode listing needs its correspondence written down, and this
module is the one place that writes it.

`bc` renders to stdout and an editor renders into a read-only document. Both
ask for the same bytes, so both ask here.
]]

local listing = {}

--- What a listing line stands for, which is what a client synchronizing a cursor
--- across the two views has to know.
---
--- `exact` is one instruction, at the source line it was lowered from. `source`
--- is the echoed source line itself. `derived` is a line about a span rather
--- than a point -- a function header. `synthetic` is the compiler's own, which
--- the preamble summary is the only instance of.
type listing.Role = 'exact' | 'source' | 'derived' | 'synthetic'

--- One listing line, and the source line it speaks for. Lines the listing writes
--- for shape alone -- the blank between functions -- have no entry.
type listing.Mapping = {
    generatedLine: integer,
    sourceLine: integer,
    role: listing.Role
}

--- How a rendering is coloured, for a client that has somewhere to put colour.
---
--- Every entry is a painter over text the listing would otherwise write plain,
--- so a rendering without one is the same rendering: the escapes go inside a
--- line and never change how many there are, which is what keeps the mappings
--- below true of a coloured listing as well.
---
--- `source` is handed the line number as well as the text because a highlighter
--- classifies the whole file at once -- Nupp needs the context -- and then
--- answers per line. It is handed the column it has to fit in as well, and
--- returns text occupying no more than that: a painted line is shorter than it
--- looks, so only whatever painted it can cut one without cutting an escape in
--- half.
type listing.Palette = {
    source: function(integer, string, integer): string,
    gutter: function(string): string,
    instruction: function(string): string,
    note: function(string, boolean): string,
    header: function(string): string
}

--- What the renderer needs beyond the analysis and the source.
---
--- `boundaryFunction` and `boundaryPc` name the instrumentation `bc` compiles in
--- to find where generated preamble stops and authored code starts; without them
--- nothing is folded, which is what `--prologue` asks for. `check` adds the
--- trace verdict against the instructions carrying one. `palette` colours the
--- result for a terminal; without it nothing is coloured.
type listing.Options = {
    check: boolean?,
    boundaryFunction: any?,
    boundaryPc: integer?,
    palette: listing.Palette?,
    width: integer?
}

--- The instrumentation literal a compile is asked to plant so that a listing can
--- tell generated preamble from authored code. Nothing but a listing asks for it,
--- and a build never carries it.
listing.BOUNDARY = "__nupp_bc_preamble_boundary_v1__"

local function asis(text: string): string
    return text
end

-- LuaJIT marks a hint it had to cut with a trailing `~`, so a listing that has
-- to cut a source line marks it the same way rather than introducing a second
-- spelling of the same fact.
listing.TRUNCATED = "~"

local function fit(text: string, column: integer): string
    local measure: any = require("nupp.tools.fmt.displaywidth")
    local kept = measure.clip(text, column)
    if kept == text then
        return text
    end

    return measure.clip(text, column - #listing.TRUNCATED) .. listing.TRUNCATED
end

local PLAIN: listing.Palette = {
    source = function(_: integer, text: string, column: integer): string
        return fit(text, column)
    end,
    gutter = asis,
    instruction = asis,
    note = function(text: string, _: boolean): string
        return text
    end,
    header = asis,
}

--- Where the generated preamble stops, as the planted marker reports it.
---
--- A declared module puts its preamble inside the loader's protected wrapper and a
--- legacy module leaves it at depth zero, so the marker names its own function as
--- well as its own instruction.
---
--- @param functions the analysis' functions
--- @return the function holding the marker and the marker's pc, or nothing
--- @raises never
function listing.boundary(functions: {any}): (any?, integer?)
    for _, fn in ipairs(functions) do
        for _, ins in ipairs(fn.instructions) do
            if ins.text:find(listing.BOUNDARY, 1, true) then
                return fn, ins.pc
            end
        end
    end

    return nil, nil
end

-- Printed between the line number and the file, and between the file and what
-- it compiled to.
local DIVIDER = " | "

-- Narrow enough to still recognize a line by, wide enough that recognizing it is
-- possible. A terminal that cannot give this much gets it anyway and wraps;
-- the alternative is a source column nobody can read anything in.
local MIN_SOURCE = 24

-- What a listing assumes when nothing says: wide enough for both halves of an
-- ordinary file, and fixed, so redirected output does not depend on the window
-- that happened to produce it.
local DEFAULT_WIDTH = 100

-- The widest an instruction is allowed to argue for when the two halves divide
-- the row: a program counter, an opcode, three operands and a short hint.
local CODE_RESERVE = 44

local function split(source: string): {string}
    local lines: {string} = {}
    for line in (source .. "\n"):gmatch("(.-)\n") do
        lines[#lines + 1] = line
    end

    return lines
end

--- A function's instructions keep their own order; two functions contributing to
--- one source line are laid out in the order the analysis walked them.
local function earlier(left: any, right: any): boolean
    if left.order ~= right.order then
        return left.order < right.order
    end

    return (left.ins.pc or 0) < (right.ins.pc or 0)
end

--- Every instruction sorted into the source line it came from, with the ones
--- that came from no line of the file kept aside.
---
--- The preamble is the runtime the compiler generates ahead of what was written,
--- and the functions that preamble built are preamble too: without that second
--- part the runtime's own helpers arrive as ordinary nested functions on line 1,
--- above everything the reader wrote.
---
--- @param functions the analysis' functions, outermost first
--- @param boundaryFunction the function holding the preamble marker, if any
--- @param boundaryPc the marker's pc, if any
--- @return instructions by source line, the preamble's, and how many functions it built
--- @raises never
function listing.group(
    functions: {any},
    boundaryFunction: any?,
    boundaryPc: integer?
): {[integer]: {any}}, {any}, integer
    local hidden: {[integer]: boolean} = {}
    if boundaryFunction ~= nil and boundaryPc ~= nil then
        for _, ins in ipairs(boundaryFunction.instructions) do
            if ins.pc < (boundaryPc as integer) and ins.op == "FNEW" then
                local slot = tonumber(ins.text:match("FNEW%s+%d+%s+(%d+)"))
                if slot then
                    hidden[math.floor(slot)] = true
                end
            end
        end
    end

    local byLine: {[integer]: {any}} = {}
    local preamble: {any} = {}
    local built: integer = 0
    local order = 0
    for _, fn in ipairs(functions) do
        order = order + 1
        local generated = hidden[math.floor(tonumber(fn.slot) or -1)] == true
        if generated then
            built = built + 1
        end
        for _, ins in ipairs(fn.instructions) do
            local isBoundary = fn == boundaryFunction and boundaryPc ~= nil and ins.pc == boundaryPc
            local isPreamble = fn == boundaryFunction and boundaryPc ~= nil and ins.pc < (boundaryPc as integer)
            if isBoundary then
                -- Structural instrumentation for this listing, not an instruction.
            elseif isPreamble or generated then
                preamble[#preamble + 1] = ins
            else
                local at = math.floor(tonumber(ins.line) or 0)
                if at >= 1 then
                    local bucket = byLine[at] or {}
                    bucket[#bucket + 1] = {ins = ins, order = order}
                    byLine[at] = bucket
                end
            end
        end
    end

    return byLine, preamble, built
end

--- Renders one analysed chunk, and says where every line of it came from.
---
--- The file runs down the left, one row per line, and what each line compiled to
--- runs down the right. That is the shape of the question `bc` is asked -- what
--- did this line cost -- and it answers it for the lines that cost nothing too:
--- a type annotation, a comment, a blank, all of them rows with an empty right
--- half. A line that compiled to several instructions keeps the first beside it
--- and the rest on the rows below, where the left half is blank.
---
--- Laying the file out once is also what removes the duplication the older
--- function-by-function listing had, where a line declaring a nested function
--- was echoed twice: once under the chunk that built the closure and again under
--- the function it opened. Here both instructions land beside the one line that
--- wrote them.
---
--- Takes the source rather than its lines, because a caller that split them
--- itself could split them differently: one that kept the newline on each line
--- produced mappings that named the line above the one they meant. There is one
--- split, and it is here.
---
--- @param functions the analysis' functions, outermost first
--- @param source the `.nupp` source the chunk was compiled from
--- @param opts folding, verdict, width and colour settings
--- @return the listing, and one mapping per line that stands for source
--- @raises never
function listing.render(functions: {any}, source: string, opts: listing.Options?): string, {listing.Mapping}
    local settings = opts or {}
    local palette = settings.palette or PLAIN
    local sourceLines = split(source)
    local byLine, preamble, built = listing.group(functions, settings.boundaryFunction, settings.boundaryPc)

    local out: {string} = {}
    local mappings: {listing.Mapping} = {}

    local function write(text: string, from: integer?, role: listing.Role?): nil
        out[#out + 1] = text
        if from ~= nil and role ~= nil and from >= 1 then
            mappings[#mappings + 1] = {generatedLine = #out, sourceLine = from, role = role}
        end
    end

    local last = #sourceLines
    for at in pairs(byLine) do
        if at > last then
            last = at
        end
    end
    -- A file ending in a newline splits into a last line that is empty and
    -- compiled to nothing. It is a line of the file, but it is not a row anyone
    -- reads a listing for.
    while last > 1 and #(byLine[last] or {}) == 0 and not (sourceLines[last] or ""):match("%S") do
        last = last - 1
    end

    -- What the two halves need, before deciding what they get. The verdicts
    -- `--check` appends are left out of the instruction measurement: they are
    -- sentences, and sizing a column so a sentence fits would leave the source
    -- nothing.
    local width = require("nupp.tools.fmt.displaywidth").displayWidth
    local numbers = math.max(#tostring(last), 3)
    local widest, widestCode = 0, 0
    for at = 1, last do
        local text = sourceLines[at]
        if text ~= nil then
            widest = math.max(widest, math.floor(width(text)))
        end
        for _, held in ipairs(byLine[at] or {}) do
            widestCode = math.max(widestCode, math.floor(width(held.ins.text)))
        end
    end
    -- The source column is as wide as the file needs, unless the terminal cannot
    -- give it that much beside the instructions, in which case the file is the
    -- half that gets cut: a source line cut is one the reader can still
    -- recognize and go read in full, where an instruction cut is one they cannot
    -- identify at all.
    --
    -- What the instructions reserve is capped, because one long line of them
    -- should not narrow the whole file: LuaJIT prints a hint as wide as the
    -- constant it names, and a single long string would otherwise leave every
    -- source line beside it truncated. Past the cap an instruction overruns the
    -- row it is on instead, which costs that row and no other.
    local reserve = math.min(widestCode, CODE_RESERVE)
    local available = (settings.width or DEFAULT_WIDTH) - numbers - 2 * #DIVIDER - reserve
    local column = math.floor(math.min(widest, math.max(MIN_SOURCE, available)))

    local function gutter(at: integer?, trailing: boolean): string
        local label = at ~= nil and ("%" .. tostring(numbers) .. "d"):format(at) or (" "):rep(numbers)

        return palette.gutter(label .. (trailing and DIVIDER or (DIVIDER:gsub("%s+$", ""))))
    end

    local function code(ins: any?): string
        if ins == nil then
            return ""
        end
        -- LuaJIT pads an instruction out to its own column widths, and the last
        -- of those columns is often empty. Trailing space is invisible until it
        -- is selected, copied or diffed.
        local text = palette.instruction((ins.text:gsub("%s+$", "")))
        if ins.traceReason and settings.check then
            if ins.unrecordable then
                local note = "  <-- this loop never compiles: " .. ins.unrecordable
                text = text .. palette.note(note .. (" [%s, must-reach]"):format(ins.traceReason), true)
            else
                text = text .. palette.note(
                    (
                        "  <-- %s: %s [may-reach]"
                    ):format(
                        ins.traceClass == "risk" and "recording risk" or "this path aborts recording",
                        ins.traceReason
                    ),
                    false
                )
            end
        end

        return text
    end

    --- One row: a line of the file on the left, one instruction on the right.
    ---
    --- The source is fitted by the palette rather than here, because a coloured
    --- line is not as long as it looks -- the escapes in it occupy no columns --
    --- and only whatever painted it can cut it without cutting one in half.
    local function row(at: integer?, text: string?, ins: any?): string
        local shown = text or ""
        local right = code(ins)
        -- A row with nothing on either side of it stops at the line number, and
        -- a row with nothing on the right stops at the source: the padding
        -- between the two halves is there to line the second one up, so where
        -- there is no second half there is nothing to line up.
        if shown == "" and right == "" then
            return gutter(at, false)
        end
        local fitted = palette.source(at or 0, shown, column)
        if right == "" then
            return gutter(at, true) .. fitted
        end
        local occupied = math.min(math.floor(width(shown)), column)

        return gutter(at, true) .. fitted .. (" "):rep(column - occupied) .. palette.gutter(DIVIDER) .. right
    end

    for at = 1, last do
        local bucket = byLine[at] or {}
        table.sort(bucket, earlier)
        write(row(at, sourceLines[at], bucket[1] and bucket[1].ins or nil), at, "source")
        for index = 2, #bucket do
            write(row(nil, nil, bucket[index].ins), at, "exact")
        end
    end

    -- The preamble is generated code attributed to line 1 because it has nowhere
    -- else to go. It goes after the file instead of on that line, where it would
    -- bury whatever the reader wrote there under the runtime.
    if #preamble > 0 then
        local summary = ("-- %d instructions of runtime preamble"):format(#preamble)
        if built > 0 then
            summary = summary .. (", in %d function%s"):format(built, built == 1 and "" or "s")
        end
        write("")
        write(palette.header(summary), 1, "synthetic")
    end

    return table.concat(out, "\n") .. "\n", mappings
end

--- The same instructions, laid out against the source rather than beside it.
---
--- `render` echoes each source line because a terminal has nothing else to show
--- it against. An editor does: the source is in the pane next to this one, so
--- repeating it wastes half the width and puts the reader's eye in two places.
---
--- Here the document *is* the source's shape. Line N holds what line N of the
--- file compiled to, and a line that compiled to nothing is blank. A line that
--- compiled to several instructions keeps the first on its own row and indents
--- the rest beneath it, which is a folding region: collapsed, every source line
--- occupies exactly one row again and the two panes scroll together.
---
--- The generated preamble is one such region on line 1, so the runtime never
--- costs the reader more than a row until they ask for it.
---
--- @param functions the analysis' functions, outermost first
--- @param source the `.nupp` source the chunk was compiled from
--- @param opts folding and verdict settings
--- @return the listing, and one mapping per line that stands for source
--- @raises never
function listing.aligned(functions: {any}, source: string, opts: listing.Options?): string, {listing.Mapping}
    local settings = opts or {}
    local sourceLines = split(source)
    local byLine, preamble = listing.group(functions, settings.boundaryFunction, settings.boundaryPc)

    local out: {string} = {}
    local mappings: {listing.Mapping} = {}

    local function write(text: string, from: integer?, role: listing.Role?): nil
        out[#out + 1] = text
        if from ~= nil and role ~= nil and from >= 1 then
            mappings[#mappings + 1] = {generatedLine = #out, sourceLine = from, role = role}
        end
    end

    local function textOf(ins: any): string
        local text = ins.text
        if ins.traceReason and settings.check then
            if ins.unrecordable then
                text = text .. "   <-- this loop never compiles: " .. ins.unrecordable
                text = text .. (" [%s, must-reach]"):format(ins.traceReason)
            else
                text = text .. (
                    "   <-- %s: %s [may-reach]"
                ):format(ins.traceClass == "risk" and "recording risk" or "this path aborts recording", ins.traceReason)
            end
        end

        return text
    end

    local last = #sourceLines
    for at in pairs(byLine) do
        if at > last then
            last = at
        end
    end

    for at = 1, last do
        local bucket = byLine[at] or {}
        table.sort(bucket, earlier)
        if #bucket == 0 then
            write("")
        elseif #bucket == 1 then
            write(textOf(bucket[1].ins), at, "exact")
        else
            write(textOf(bucket[1].ins) .. ("   -- +%d more"):format(#bucket - 1), at, "exact")
            for index = 2, #bucket do
                write("  " .. textOf(bucket[index].ins), at, "exact")
            end
        end
    end

    -- The preamble goes after the file rather than on line 1. It is generated
    -- code attributed to line 1 because it has nowhere else to go, and putting
    -- it there would either bury whatever the reader wrote on that line or push
    -- every following line out of step with the source.
    if #preamble > 0 then
        write("")
        write(("-- %d instructions of runtime preamble"):format(#preamble), 1, "synthetic")
        for _, ins in ipairs(preamble) do
            write("  " .. textOf(ins), 1, "synthetic")
        end
    end

    return table.concat(out, "\n") .. "\n", mappings
end

export = listing
