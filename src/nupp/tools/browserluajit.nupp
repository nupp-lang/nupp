module nupp.tools.browserluajit

local Browser = require("nupp.tools.browser")
local cheader = require("nupp.compiler.cinterop.cheader")

local function unavailable(): (nil, string)
    return nil, "the browser compiler cannot read C headers or invoke a preprocessor; declare C types inline"
end

export function new(): any
    -- The retained compiler shares a fixed guest budget with its temporary graphs.
    -- Start collection before those temporaries double the live compiler heap.
    collectgarbage("setpause", 100)
    -- Finish incremental cycles while checking an imported module graph, before
    -- its temporary allocations exhaust the compiler guest's fixed memory.
    collectgarbage("setstepmul", 400)
    return Browser.new({
        layoutTarget = "i686-unknown-linux-gnu",
        compilerServices = {
            cheader = {
                declare = cheader.declare,
                typeFromString = cheader.typeFromString,
                declaredFunctions = cheader.declaredFunctions,
                provenance = unavailable,
                load = unavailable,
            }
        },
    })
end
