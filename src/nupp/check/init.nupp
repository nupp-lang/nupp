--[[
The checker: the walk, and the run it happens in.

A gradual type checker over the CST. Anything unannotated or unresolvable is
`any` and checks silently, so an untyped LuaJIT program is a valid Nupp program
that reports nothing; annotations are what turn checking on, one declaration at
a time.

This module holds the run — the scopes, the diagnostics, the per-file state — and
the statement walk that drives everything else. The questions the walk asks are
answered next door: what an expression's type is by `expr`, what a call means by
`calls`, what a declaration introduces by `declare`, what a condition proves by
`narrow`, what an annotation says by `annotate`, and what has happened to an
owned value by `ownership`. Each of those is installed on the checker and reaches
the run through it.

Diagnostics carry stable `NUPP2xxx` codes; `docs/diagnostics.md` is the
reference for their shape and their families.
]]

local T = require("nupp.types")
local lints = require("nupp.lints")
local fixits = require("nupp.check.fixits")
local annotate = require("nupp.check.annotate")
local ownership = require("nupp.check.ownership")
local loopclosure = require("nupp.check.loopclosure")
local undocumentedraise = require("nupp.check.undocumentedraise")
local unused = require("nupp.check.unused")
local discard = require("nupp.check.discard")
local analysis = require("nupp.analysis")
local narrow = require("nupp.check.narrow")
local calls = require("nupp.check.calls")
local expr = require("nupp.check.expr")
local declare = require("nupp.check.declare")
local resolve = require("nupp.check.resolve")
local bindings = require("nupp.check.bindings")
local control = require("nupp.check.control")
local functions = require("nupp.check.functions")
local cdef = require("nupp.check.cdef")
local pragma = require("nupp.check.pragma")
local metatable = require("nupp.check.metatable")
local cst = require("nupp.cst")
local annotationMod = require("nupp.annotations")
local lexer = require("nupp.lexer")

local checkMod = {}

--- A type, as nupp.types builds them.
local type Type = T.Type

--- A node of the tree being checked.
local type Node = cst.Node

--- A node or a token: what a diagnostic can be pointed at.
local type Child = cst.Child

--- One thing to report about a file.
type checkMod.Diagnostic = {
    --- The stable NUPP code, which is what an @allow names.
    code: string,

    --- What to tell the reader.
    msg: string,
    filename: string?,

    --- "error" stops the build; "warning" is advice and does not.
    severity: string,
    line: integer,
    col: integer,
    offset: integer,
    length: integer,
    help: string?,
    notes: {string}?,
    related: {any}?,
    lint: string?,
    fixes: {any}?,
}

--- What a condition proves, on each side of it. `t` holds for the branch where the
--- condition is true and `f` where it is false, each keyed by the reference it speaks
--- about. `exhausted` names a subject a comparison chain has now covered completely.
type checkMod.Facts = {
    t: {[string]: Type},
    f: {[string]: Type},
    exhausted: string?,
}

--- Everything one run of the checker carries: what it is checking, what it has found,
--- and where it currently is. Declaring it is what lets the walk be split across
--- modules — a pass reaches the run through this rather than through a closure it has
--- to be lexically inside of.
record checkMod.Checker
    -- What is being checked. Fixed for the whole run.

    --- The parse, which also collects the symbols and side effects the run records.
    result: any

    --- What to call this file in a diagnostic.
    filename: string?

    --- The project environment: other modules, globals, the string library.
    env: any

    --- The caller's options: strict, moduleName, seeded exports, and the rest.
    opts: any

    --- Whether this file describes an interface it does not own, so its bare
    --- declarations are that interface rather than a file's private ones.
    declarationFile: boolean

    --- The table qualified declarations attach to, so `record M.Point` in a file that
    --- returns M exports Point while `record Other.Point` does not.
    moduleLocal: string?

    --- Where annotation definitions are registered and looked up.
    annotationRegistry: any

    --- The definitions this file itself declared, by name.
    annotationDefinitions: any

    --- A project's `lints` table, so a level resolves the same way wherever a lint is
    --- raised.
    lintConfig: any

    --- The edits this run's diagnostics can offer. See nupp.check.fixits.
    edits: any

    -- What has been found.

    --- The diagnostics, in the order they were raised.
    diags: {checkMod.Diagnostic}

    --- The type of the file's top-level return, plus its runtime declarations.
    moduleType: Type?

    --- The types and values this file publishes to the project.
    moduleExports: any

    --- Declaration sites already recorded, so one is not published twice.
    seenDefinitions: any

    -- Where the walk currently is. All of this changes as it runs.

    --- The innermost scope, and the file's outermost one.
    scope: any

    rootScope: any

    --- Return-type annotations of the enclosing functions, or false for one that was
    --- not annotated and is therefore not checked.
    retStack: {any}

    retPackStack: {any}

    --- Raw first-return types for functions whose public result is wrapped by `@owned`.
    --- The body may return a newly produced raw value or transfer an existing owner;
    --- the annotation establishes the public obligation.
    ownReturnStack: {any}

    --- Set while checking a function whose return is declared `borrows p`, so that
    --- returning a borrow is permitted there and only there.
    borrowReturnStack: {any}

    varargPackStack: {any}

    yieldPackStack: {any}

    resumePackStack: {any}
    protocolStack: {any}

    --- The owned fields a `@dispose` body still has to discharge.
    disposerFieldStack: {any}

    --- Cleanup contracts already validated, so one is not re-reported.
    validatedCleanupContracts: any

    --- How deep inside `unsafe do` the walk is; raw pointer use needs it above zero.
    unsafeDepth: integer

    --- How deep inside function bodies it is, which is how a capture is recognized.
    functionDepth: integer

    --- Whether a `with` body has reached out of its own scope, per open scope.
    captureWatches: {any}

    --- Whether a function written inside a loop had to be written there. See
    --- nupp.check.loopclosure.
    loops: any

    --- Whether a function that raises on purpose said so. See
    --- nupp.check.undocumentedraise.
    raises: any

    --- Whether anything reads the locals this file introduces. See nupp.check.unused.
    unused: any

    --- Whether a call written as a statement had a reason to be. See
    --- nupp.check.discard.
    discard: any

    --- The definitions something has read, so an unread binding can be told from a used
    --- one. Written by `lookupEntry`; owned by nupp.check.unused.
    reads: any

    --- The lint codes surrounding `@allow` pragmas have asked not to hear about.
    allowed: {any}

    --- Set while the hoisting pre-pass runs. It resolves annotations early to publish
    --- signatures, and anything wrong with them is reported when the declaration itself
    --- is checked, so saying it twice helps nobody.
    hoisting: boolean

    --- Aliases currently being resolved, so one that names itself is caught rather than
    --- recurring forever.
    resolvingAlias: any

    --- Every value the last call returned, so a multi-value expansion can reach past
    --- the first.
    lastCallRets: {Type}?

    --- The complete pack produced by the last expanding expression.
    lastCallPack: any

    -- The operations a pass reaches the run through. They are fields rather than locals
    -- so that a pass can live in its own module and still call them.

    --- Reports one diagnostic, unless a surrounding `@allow` or a project's lint levels
    --- asked not to hear it.
    diag: function(code: string, at: any, msg: string, fixes: any?, details: any?)

    --- Makes a labeled secondary source location for a diagnostic.
    related: function(at: any, message: string, filename: string?): any?

    --- Whether a surrounding `@allow` has asked not to hear a lint. A lint reported
    --- somewhere other than where the walk is asks this where the walk is, because the
    --- stack that carries an `@allow` only exists while its statement is being checked.
    suppressed: function(code: string): boolean

    --- The scope entry a name resolves to, narrowing included, or nil.
    lookupEntry: function(name: string): any

    --- The type a name resolves to, or nil.
    lookupType: function(name: string): Type?

    lookupPack: function(name: string): any

    --- Records what a token means, for the editor and for go-to-definition.
    markToken: function(tok: any, def: any, t: Type?, kind: string?)

    --- The type an expression has, with what narrowing knows applied.
    infer: function(node: Node): Type

    --- The type a plain name currently holds, narrowing included.
    lookupVar: function(name: string): Type?

    --- Opens and closes a scope. Narrowing lives in the scope it was proved in, so
    --- leaving one forgets what it knew.
    pushScope: function()

    popScope: function()

    --- The type an annotation names.
    resolveType: function(node: Node?): Type

    resolvePack: function(node: Node?): any

    --- The type a reference currently holds: what narrowing knows, else the declared or
    --- inferred type reached through its base.
    refType: function(node: Node?): Type?

    --- The type of a member, reached through whatever the receiver is.
    fieldType: function(t: Type?, name: string): (Type?, any)

    --- The type a member accepts when assigned, and its write declaration.
    fieldWriteType: function(t: Type?, name: string): (Type?, any)

    --- Member names safely available on a type, for spelling fixes.
    fieldNames: function(t: Type?, writing: boolean?): {[string]: boolean}

    --- Splits `function a.b:m` into the key naming its owner and the member token.
    funcOwner: function(fname: any): (string?, any)

    --- Which ownership qualifier a type carries, if any.
    ownershipKind: function(t: Type?): string?

    --- The entry an ownership fact is recorded on, following a narrowed copy back to
    --- the binding it came from.
    ownershipState: function(entry: any): any

    --- Whether values of this type are pointers at run time.
    pointerShaped: function(t: Type): boolean

    --- Records that an expression's owner has been handed over.
    moveExpression: function(node: any, t: Type?, why: string, kind: string?)

    --- The binding an expression's ownership is recorded on, and the owner a borrow
    --- ultimately came from.
    ownershipEntry: function(node: any): (any, any)

    borrowRoot: function(entry: any): any

    --- The key narrowing tracks a reference under, or nil when it has none.
    pathKey: function(node: Node): string?

    --- Applies a narrowing map inside the current scope.
    applyFacts: function(facts: {[string]: Type})

    --- Checks a generic application's arguments against the bounds declared for them.
    validateTypeBounds: function(params: any, bounds: any, map: any, node: any)

    --- Binds a name in the current scope.
    bindVar: function(name: string, t: Type?, ann: boolean?, tok: any?,
        kind: string?, constant: boolean?)

    --- Checks a block, and a function body.
    checkBlock: function(block: Node?, scopeManaged: boolean?)

    checkFuncbody: function(body: any, selfType: Type?): Type

    --- The `ffi.C` namespace as the program has declared it.
    cNamespaceType: function(): Type

    --- `t` without nil, which is what a truthiness test leaves.
    minusNil: function(t: Type): Type

    --- What a condition proves, on each side of it.
    analyzeCond: function(cond: Node): any

    --- What narrowing currently knows about a reference.
    lookupNarrowed: function(key: string): Type?

    --- The obligation a coroutine suspension would strand, if any.
    liveSuspensionObligation: function(): string?

    --- Checks that a value's declared cleanups exist and take it.
    validateCleanups: function(valueT: Type?, cleanups: any, at: any,
        code: string?, allowUnknown: boolean?)

    --- Checks that a value's cleanups can be called from where it is being discharged,
    --- so the checker only accepts what the generator can emit.
    requireReachableCleanups: function(valueT: Type?, cleanups: any, at: any)

    --- Advice for an unknown name a project module is named after.
    missingRequire: function(name: string): (string?, boolean, any)

    --- Whether an operand is numeric, reporting when it is not.
    numericOperand: function(t: Type, node: any, op: string): boolean

    --- What has been put on the table this file returns, by name. A module is written
    --- `local M = {}` and filled in one statement at a time, so what it exports is what
    --- was added to it rather than what the constructor said.
    moduleFields: {[string]: Type}

    --- Where each `moduleFields` entry was written. A field's export diagnostic points
    --- here rather than at the module's `return`, which is often lines away from the
    --- declaration a fix actually touches.
    moduleFieldTokens: {[string]: lexer.Token}

    --- Which direct module exports were established with `const M.field`.
    moduleFieldConst: {[string]: boolean}

    --- Every immutable path rooted at the returned module table. This includes nested
    --- `const` fields in a fresh exported table constructor.
    constModulePaths: {[string]: boolean}

    --- Whether that table was annotated. An annotated binding keeps the type it was
    --- given, which is how a module says its surface is wider than what can be seen —
    --- `local M: {[string]: any} = {}`.
    moduleLocalAnnotated: boolean

    -- Binding names, and the declarations that introduce them.

    --- Binds a type name, and a declaration's name in both namespaces.
    bindType: function(name: string, t: Type?, tok: any?)

    bindPack: function(name: string, p: any, tok: any?)

    bindDeclaredType: function(stat: any, t: Type?)

    bindDeclaredVar: function(stat: any, t: Type?)

    --- Binds a generics clause's parameters, returning them and their bounds.
    bindGenerics: function(generics: any, role: string): (any, any, any)

    --- A fresh type parameter for one binder.
    typevarAt: function(tok: any, role: string): Type

    packvarAt: function(tok: any, role: string): any

    --- The key a qualified declaration binds under, and the table it attaches to.
    declKey: function(stat: any): string

    qualifierOf: function(stat: any): string?

    --- The effective visibility of a declaration.
    visibilityOf: function(stat: any): string

    --- Records where a name was declared, for the editor.
    definition: function(tok: any, kind: string?): any

    --- Resolves an alias hoisted to the top of its block, the first time anything names
    --- it.
    resolvePendingAlias: function(name: string, pending: any, owner: any): Type?

    --- A function's type as its annotations give it, without checking the body.
    signatureOf: function(body: any, selfType: Type?): Type

    --- The nominal a declaration statement introduces, and the project entry it was
    --- published under.
    declaredNominal: function(stat: any, kind: string): (any, any)

    --- Publishes a declaration to the module and the project.
    publishType: function(stat: any, t: Type?, projectEntry: any?)

    --- Checks a record, interface, struct or alias declaration.
    checkTypedecl: function(stat: any)

    -- The installed passes, as they returned themselves. A statement family reaches the
    -- operations of another pass through these rather than through a local it would
    -- have to be lexically inside `check` to see.

    --- Ownership: see nupp.check.ownership.
    own: any

    --- Narrowing: see nupp.check.narrow.
    facts: any

    --- Calls and members: see nupp.check.calls.
    apply: any

    --- Annotations: see nupp.check.annotate.
    marks: any

    -- The walk itself, for the families that recur into it.

    --- Checks one statement, dispatching on its kind.
    checkStat: function(stat: Node)

    --- The types of an expression list, expanding a trailing call's extra results.
    inferList: function(exprs: any, count: integer): {Type}

    inferListPack: function(exprs: any): any
    checkPackDiscard: function(pack: any, first: integer, at: any): boolean

    --- Records a `function m.f` or `m.x = v` as a member of the returned module.
    recordModuleField: function(target: Node, t: Type?, constant: boolean?,
        value: Node?)
    constModuleField: function(target: Node): boolean

    --- Whether every path out of a block leaves it, and whether every path raises.
    alwaysExits: function(block: Node?): boolean

    alwaysRaises: function(block: Node?): boolean

    --- Whether a node returns a value anywhere inside it.
    returnsSomewhere: function(x: Node): boolean

    --- The ownership modes a body's parameters are used with, when it declared none.
    inferredParameterModes: function(body: any): any
end

-- The type algebra and the generic machinery moved out of this file; the names the
-- checker calls them by are kept, since they read as vocabulary here.

-- The lint registry lives in nupp.lints, which `nupp lints` reads too. The checker
-- keeps the re-exports so a caller that already had them still works.
checkMod.lints = lints.all
checkMod.lintCategories = lints.categories
checkMod.lintLevels = lints.levels
checkMod.lintOptIn = lints.optIn
checkMod.lintLevel = lints.level
checkMod.lintFor = lints.get

-- The closed reifiable field set: numerics, bool, structs by value, pointers, nullable
-- pointers. Everything GC-managed is out.
local REIFIABLE_PRIM = {
    number = true, float = true, boolean = true, integer = true,
    int8 = true, int16 = true, int32 = true, int64 = true,
    uint8 = true, uint16 = true, uint32 = true, uint64 = true,
}

--- Whether a field of this type can live in reified C memory.
local function reifiableField(t: Type, isCdef: boolean?): boolean
    if REIFIABLE_PRIM[t.tag] then
        return true
    end
    -- cstring/voidptr are legal in C-declared structs only: in a GC-managed struct a
    -- "const char *" field would dangle (no anchor)
    if isCdef and (t.tag == "cstring" or t.tag == "voidptr") then
        return true
    end
    if t.tag == "nominal" and t.declKind == "struct" then
        return true
    end
    if t.tag == "ptr" then
        return true
    end
    if t.tag == "union" and #t.members == 2 and t.hasNil then
        local other = t.members[1] == T.nil_ and t.members[2] or t.members[1]
        -- any pointer-shaped type may be NULL, which is what the nullable spelling
        -- records
        if other.tag == "ptr" then
            return true
        end
        if isCdef and (other == T.voidptr or other == T.cstring) then
            return true
        end
        return false
    end
    return false
end

-- Checker state per run.
--
-- env (optional): { globals = {name -> entry}, globalTypes = {name -> type}, stringLib
-- = shape type for string-method calls, resolveModule = function(env, modname) -> type?
-- } — shared across files. opts may provide declareGlobals (prelude/declaration files),
-- moduleName, an annotation registry, and a seeded module export interface for
-- recursive project declarations.
--
-- Returns diags, moduleType (top-level return plus runtime declaration exports), and
-- the module's exported type/value interface.
function checkMod.check(result, filename, env, opts)
    opts = opts or {}
    if opts.strict == nil and env and env.config then
        opts.strict = env.config.strict == true
    end
    result.symbols = {}
    result.implicitSideEffects = {}
    result.moduleName = opts and opts.moduleName
        or env and env.moduleNameForPath
        and env.moduleNameForPath(env, filename) or nil
    local registry = opts and opts.annotations
        or env and env.annotations or annotationMod.default()
    registry:removeSource(filename)

    -- One run's whole state, so the passes below reach it through `c` rather than by
    -- being lexically inside one function. See checkMod.Checker.
    local c = new checkMod.Checker {
        result = result, filename = filename, env = env, opts = opts,
        -- A declaration file describes an interface it does not own, so its bare
        -- declarations are that interface and have no table of the file's own to attach
        -- to. Bundled declarations are checked under their module name rather than a
        -- path, so they say so directly.
        declarationFile = (opts and (opts.declarationFile
        or opts.declareGlobals)) and true
        or (filename and filename:match("%.d%.nupp$")) and true or false,
        -- The table qualified declarations attach to, so `record M.Point` in a file
        -- that returns M exports Point while `record Other.Point` does not.
        moduleLocal = cst.returnedLocal(result.root),
        annotationRegistry = registry,
        annotationDefinitions = {},
        lintConfig = opts and opts.lints
        or env and env.config and env.config.lints or nil,
        -- Fixes and the missing-require advice read the parse and the project index
        -- rather than anything the walk builds, so they are made once here and asked.
        -- See nupp.check.fixits.
        edits = fixits.new(result, env),
        diags = {},
        moduleType = nil,
        moduleExports = opts and opts.initialExports
        or {types = {}, typeDefs = {}, values = {}},
        seenDefinitions = {},
        scope = {vars = {}, types = {}, packTypes = {}, typeDefs = {},
        pending = {}, parent = nil},
        retStack = {}, retPackStack = {}, ownReturnStack = {},
        borrowReturnStack = {},
        varargPackStack = {}, yieldPackStack = {}, resumePackStack = {},
        protocolStack = {},
        disposerFieldStack = {}, validatedCleanupContracts = {},
        unsafeDepth = 0, functionDepth = 0,
        captureWatches = {}, allowed = {}, hoisting = false,
        resolvingAlias = {}, lastCallRets = nil, lastCallPack = nil,
        moduleFields = {}, moduleFieldTokens = {}, moduleFieldConst = {},
        constModulePaths = {},
        moduleLocalAnnotated = false,
    }
    c.rootScope = c.scope
    -- Published alongside the module name because the pair is what says a `function
    -- m.f` in this file is a member of this module. Nothing typed needs it; an editor
    -- asked where such a member was written does.
    result.moduleLocal = c.moduleLocal

    c.visibilityOf = function(stat): string
        return cst.declVisibility(stat, c.moduleLocal)
    end

    local fix = c.edits.fix
    local insertBefore = c.edits.insertBefore
    c.missingRequire = c.edits.missingRequire

    -- Owners, borrows and pins are tracked on their own; the walk asks where a value
    -- came from and hands over what it consumes. See nupp.check.ownership.
    local own = ownership.install(c)
    c.own = own
    -- Whether a function written inside a loop had to be written there is its own
    -- question, asked at the three places a function body is checked. See
    -- nupp.check.loopclosure.
    c.loops = loopclosure.install(c)
    c.raises = undocumentedraise.install(c)
    -- Two judgements that need the whole file: whether anything read a binding, and
    -- whether a discarded call had a reason to be made. Both register candidates as the
    -- walk passes and sweep at the end. See nupp.check.unused and nupp.check.discard.
    c.unused = unused.install(c)
    c.discard = discard.install(c)
    resolve.install(c)
    local ownershipKind = own.ownershipKind

    --- Whether a surrounding @allow asked not to hear this lint. A lint is a judgement,
    --- so a statement may disagree with it at any level; a type error is not a
    --- judgement, and no annotation reaches one.
    local function isAllowed(lint, code: string): boolean
        if not lint then
            return false
        end
        for j = #c.allowed, 1, -1 do
            local set = c.allowed[j]
            if set[lint.name] or set[code] or set["*"] then
                return true
            end
        end
        return false
    end

    --- Whether a surrounding `@allow` has asked not to hear a lint, by name or code. A
    --- lint whose judgement needs the whole file asks this at the statement it is
    --- about, because `c.allowed` is unwound by the time such a lint reports.
    ---
    --- @param code the lint's name or its code
    c.suppressed = function(code: string): boolean
        -- `isAllowed` matches the lint's name and whichever spelling it is handed, so
        -- asking with the registry's own code is what makes an `@allow` written either
        -- way reach a lint raised by either.
        local lint = lints.get(code)
        return isAllowed(lint, lint and lint.code or code)
    end

    c.related = function(nodeOrTok, message, relatedFilename)
        local value = nodeOrTok
        local atFilename = relatedFilename
        if value and value.token then
            atFilename = atFilename or value.filename
            value = value.token
        end
        local at = cst.firstToken(value)
        if not at then
            return nil
        end
        return {message = message, filename = atFilename or filename,
            line = at.line, col = at.col, offset = at.offset,
            length = #at.text}
    end

    c.diag = function(code, nodeOrTok, msg, fixes, details)
        local lint = lints.get(code)
        local severity = "error"
        if lint then
            severity = lints.level(lint, c.lintConfig)
            if severity == "off" then
                return
            end
        end
        if c.hoisting or isAllowed(lint, code) then
            return
        end
        local at = cst.firstToken(nodeOrTok)
        c.diags[#c.diags + 1] = {
            code = lint and lint.code or code, lint = lint and lint.name or nil,
            msg = msg, filename = filename, severity = severity,
            line = at and at.line or 0, col = at and at.col or 0,
            offset = at and at.offset or 0,
            length = at and #at.text or 0,
            fixes = fixes and #fixes > 0 and fixes or nil,
            help = details and details.help or nil,
            notes = details and details.notes or nil,
            related = details and details.related or nil,
        }
    end

    -- A `with` body that resolves a name declared outside itself makes the generated
    -- region a closure over that binding, and a region with upvalues cannot be shared
    -- across executions. Every name resolution goes through lookupEntry, so watching it
    -- there is enough; the stack keeps nested scopes independent, and an inner capture
    -- is recorded for every enclosing scope it also escapes.
    c.pushScope = function()
        c.scope = {vars = {}, types = {}, packTypes = {}, typeDefs = {},
            pending = {}, parent = c.scope,
            depth = (c.scope and c.scope.depth or 0) + 1}
    end

    local function auditScope(s)
        for name, entry in pairs(s.vars or {}) do
            local state = entry.ownershipOrigin or entry
            if not entry.ownershipOrigin
                and ownershipKind and ownershipKind(state.t) == "owned"
                and not state.moved then
                c.diag("NUPP2603", entry.definition and entry.definition.token,
                    ("owned value %q leaves scope without being consumed, "
                    .. "disposed, returned, or converted with intoRaw")
                    :format(name))
            elseif not entry.ownershipOrigin
                and state.retained and not state.moved then
                c.diag("NUPP2603", entry.definition and entry.definition.token,
                    ("pinned handle %q is still retained by C; pass it to a "
                    .. "declared releases parameter before it leaves scope")
                    :format(name))
            end
        end
    end
    c.popScope = function()
        auditScope(c.scope)
        for _, entry in pairs(c.scope.vars or {}) do
            if entry.borrowOwner then
                entry.borrowOwner.activeBorrows = math.max(0,
                    (entry.borrowOwner.activeBorrows or 1) - 1)
            end
            for _, owner in ipairs(entry.borrowOwners or {}) do
                owner.activeBorrows = math.max(0,
                    (owner.activeBorrows or 1) - 1)
            end
        end
        c.scope = c.scope.parent
    end
    -- Var entries: { t = type, ann = boolean, constant = boolean }. Assignment
    -- compatibility is enforced only for annotated bindings; inferred bindings stay
    -- flexible (e.g. "increment_indent = nil" to disable an inferred local function).
    c.lookupEntry = function(name)
        local s = c.scope
        while s do
            local v = s.vars[name]
            if v then
                -- Every name resolution arrives here, which makes this the one place a
                -- read has to be recorded from. See nupp.check.unused.
                if v.definition then
                    c.reads[v.definition] = true
                end
                for i = #c.captureWatches, 1, -1 do
                    -- A watch asks about the scopes between its floor and itself.
                    -- `with` sets no floor and so hears about every outward resolution;
                    -- a closure being judged for hoisting sets the floor at its loop,
                    -- because a name that was already bound before the loop is the same
                    -- name on every iteration.
                    local watch = c.captureWatches[i]
                    local at = s.depth or 0
                    if at < watch.depth and at >= (watch.floor or 0) then
                        watch.captured = true
                    end
                end
                return v
            end
            s = s.parent
        end
        if env and env.globals then
            return env.globals[name]
        end
        return nil
    end

    --- The type a name currently holds.
    c.lookupVar = function(name: string): Type?
        local e = c.lookupEntry(name)
        return e and e.t or nil
    end

    -- Set while a hoisted alias is being resolved, so an alias that names itself
    -- reports rather than recurses forever.

    c.lookupType = function(name)
        local s = c.scope
        while s do
            local t = s.types[name]
            if t then
                return t, s.typeDefs[name]
            end
            local waiting = s.pending and s.pending[name]
            if waiting then
                local resolved = c.resolvePendingAlias(name, waiting, s)
                if resolved then
                    return resolved, s.typeDefs[name]
                end
            end
            s = s.parent
        end
        if env and env.globalTypes then
            local t = env.globalTypes[name]
            if t then
                return t, env.globalTypeDefs and env.globalTypeDefs[name] or nil
            end
        end
        if env and env.resolveProjectType then
            return env.resolveProjectType(env, filename, name)
        end
        return nil
    end
    c.lookupPack = function(name)
        local s = c.scope
        while s do
            local p = s.packTypes and s.packTypes[name]
            if p then
                return p, s.typeDefs[name]
            end
            s = s.parent
        end
        return nil
    end
    c.definition = function(tok, kind)
        if not tok then
            return nil
        end
        local def = tok.definition
        if not def or def.filename ~= filename or def.token ~= tok then
            def = {filename = filename, token = tok, name = tok.text}
        end
        if not c.seenDefinitions[def] then
            result.symbols[#result.symbols + 1] = def
            c.seenDefinitions[def] = true
        end
        if kind and (not def.kind or def.kind == "variable") then
            def.kind = kind
        end
        tok.definition = def
        return def
    end
    c.markToken = function(tok, def, t, kind)
        if not tok then
            return
        end
        tok.definition = def
        tok.inferredType = t
        tok.semanticKind = kind or def and def.kind or "variable"
    end
    c.bindVar = function(name, t, annotated, tok, kind, constant)
        local old = c.scope.vars[name]
        if tok then
            local s = c.scope
            while s do
                local existing = s.vars[name]
                if existing and existing.constant then
                    c.diag("NUPP2008", tok,
                        ("cannot re-declare const variable %s"):format(name))
                    break
                end
                s = s.parent
            end
        end
        kind = kind or (t and t.tag == "func" and "function" or "variable")
        local def = tok and c.definition(tok, kind) or old and old.definition or nil
        if def then
            def.type = t
            def.constant = constant == true
                or (tok == nil and old and old.constant) or false
            if not def.kind or def.kind == "variable" then
                def.kind = kind
            end
        end
        c.scope.vars[name] = {
            t = t,
            ann = annotated ~= nil and annotated or old and old.ann or false,
            constant = constant == true
            or (tok == nil and old and old.constant) or false,
            definition = def,
            ownership = t and (t.tag == "owned" or t.tag == "borrowed"
            or t.tag == "pinned") and t.tag or nil,
            moved = false,
            functionDepth = c.functionDepth,
        }
        c.markToken(tok, def, t, def and def.kind or kind)
    end
    c.bindType = function(name, t, tok)
        c.scope.types[name] = t
        local kind = t and t.tag == "nominal" and t.declKind or "type"
        if kind == "record" then
            kind = "type"
        end
        if t and t.tag == "typevar" then
            kind = "typeParameter"
        end
        local def = tok and c.definition(tok, kind) or c.scope.typeDefs[name]
        if def then
            def.type, def.kind = t, kind
        end
        c.scope.typeDefs[name] = def
        c.markToken(tok, def, t, kind)
    end
    c.bindPack = function(name, p, tok)
        c.scope.packTypes[name] = p
        local def = tok and c.definition(tok, "typeParameter")
            or c.scope.typeDefs[name]
        if def then
            def.type, def.kind = p, "typeParameter"
        end
        c.scope.typeDefs[name] = def
        c.markToken(tok, def, nil, "typeParameter")
    end

    --- The single table a qualified declaration attaches to, or nil when the name is
    --- unqualified.
    c.qualifierOf = function(stat): string?
        local qualifiers = stat.qualifiers
        local only = qualifiers and #qualifiers == 1 and qualifiers[1] or nil
        return only and only.text or nil
    end

    --- The scope key a declaration binds under. A qualified name binds under its whole
    --- path, so `record M.Point` is reached as `M.Point` and declares no bare `Point` —
    --- the same rule `function M.f` follows. The dot keeps the key clear of any
    --- identifier.
    c.declKey = function(stat): string
        local qualifier = c.qualifierOf(stat)
        if not qualifier then
            return stat.name.text
        end
        return qualifier .. "." .. stat.name.text
    end

    --- Binds a declaration's type where its name puts it, recording the runtime path a
    --- qualified declaration lives at.
    c.bindDeclaredType = function(stat, t)
        local key = c.declKey(stat)
        -- The runtime table lives at M.Point, which is what `is` compares and
        -- construction stamps for references from inside this file.
        if t and t.tag == "nominal" and c.qualifierOf(stat) then
            t.runtimePath = key
        end
        -- The table a declaration attaches to reads as a namespace, the same as any
        -- other reference to the module it stands for.
        for _, qualifier in ipairs(stat.qualifiers or {}) do
            c.markToken(qualifier, nil, nil, "namespace")
        end
        c.bindType(key, t, stat.name)
        -- The name a reader writes is the whole path, which is what an editor should be
        -- offering and listing rather than the last segment alone.
        if c.qualifierOf(stat) and stat.name.definition then
            stat.name.definition.qualifiedName = key
        end
    end

    --- Binds the value a declaration also introduces — a record's runtime table, a
    --- struct's ctype constructor — under the same key as its type, so `M.Point{...}`
    --- is recognized as a construction.
    c.bindDeclaredVar = function(stat, t)
        c.bindVar(c.declKey(stat), t, false, stat.name)
    end

    ---------------------------------------------------------------------
    -- Type annotation resolution
    ---------------------------------------------------------------------

    c.typevarAt = function(tok, role)
        return T.typevar(tok.text, filename .. ":" .. tostring(tok.offset)
            .. ":" .. (role or "generic"))
    end
    c.packvarAt = function(tok, role)
        return T.packvar(tok.text, filename .. ":" .. tostring(tok.offset)
            .. ":" .. (role or "generic-pack"))
    end

    -- Binds a generic clause in its surrounding scope and resolves aligned upper bounds
    -- after each binder is visible.
    c.bindGenerics = function(generics, role)
        local params, bounds, packParams = {}, {}, {}
        local sawPack = false
        for j, nameTok in ipairs(generics and generics.names or {}) do
            local isPack = generics.packs and generics.packs[j]
            if isPack then
                sawPack = true
                local pv = c.packvarAt(nameTok, role)
                packParams[#packParams + 1] = pv
                c.bindPack(nameTok.text, pv, nameTok)
            else
                if sawPack then
                    c.diag("NUPP2121", nameTok,
                        "an ordinary type parameter cannot follow a pack parameter")
                end
                local tv = c.typevarAt(nameTok, role)
                params[#params + 1] = tv
                c.bindType(nameTok.text, tv, nameTok)
            end
            local boundNode = generics.bounds and generics.bounds[j]
            if boundNode then
                if isPack then
                    c.diag("NUPP2121", boundNode,
                        "generic pack bounds are not supported")
                else
                    bounds[#params] = c.resolveType(boundNode)
                    params[#params].bound = bounds[#params]
                end
            end
        end
        return params, bounds, packParams
    end

    ---------------------------------------------------------------------
    -- Narrowing: facts extracted from conditions
    ---------------------------------------------------------------------

    -- The C namespace: a shape of everything the program has declared to the FFI, so
    -- ffi.C and ffi.load both carry real signatures.

    --- The type of `ffi.C`: every symbol the program has cdef'd.
    c.cNamespaceType = function(): Type
        local decls = require("nupp.cheader").declaredFunctions(function(tag)
            local found = c.lookupType(tag)
            if found and found.tag == "nominal" then
                return found
            end
            return nil
        end)
        local fields = {}
        for name, t in pairs(decls) do
            fields[#fields + 1] = {name = name, type = t}
        end
        if #fields == 0 then
            return T.any
        end
        return T.shape(fields)
    end

    -- Types an expression list against `count` targets, expanding the last expression's
    -- extra return values. Only a call expands: `local a, b = f()` takes both of f's
    -- results, while `local a, b = g` takes g and nothing. Inferring anything else may
    -- still have left a call's results behind — a function expression whose body calls
    -- something does — so the expansion asks what the expression is rather than
    -- trusting what the last call reported.
    local EXPANDS = {call = true, methodCall = true, safeCall = true,
        vararg = true}

    local function affineType(t)
        if not t then
            return false
        end
        if t.tag == "owned" or t.tag == "pinned" then
            return true
        end
        if t.tag == "union" then
            for _, member in ipairs(t.members) do
                if affineType(member) then
                    return true
                end
            end
        end
        return false
    end

    local function valueMode(t)
        if not t then
            return "plain"
        end
        if t.tag == "owned" or t.tag == "pinned" then
            return "takes"
        end
        if t.tag == "borrowed" then
            return "borrows"
        end
        return "plain"
    end

    local function checkPackDiscard(pack, first, at)
        if not pack then
            return false
        end
        local discarded = false
        if pack.alternatives then
            for _, arm in ipairs(pack.alternatives) do
                discarded = checkPackDiscard(arm, first, at) or discarded
            end
            return discarded
        end
        for j = first, #pack.head do
            if affineType(pack.head[j]) then
                discarded = true
            end
        end
        if pack.tail and (pack.tail.kind == "generic"
            or affineType(pack.tail.type)) then
            discarded = true
        end
        if discarded then
            c.diag("NUPP2605", at,
                "an affine value in this result pack would be discarded")
        end
        return discarded
    end

    local function inferListPack(exprs)
        local head, modes, tail = {}, {}, nil
        exprs = exprs or {}
        for j, e in ipairs(exprs) do
            c.lastCallRets, c.lastCallPack = nil, nil
            local valueT = c.infer(e)
            local produced = e.valuePack or c.lastCallPack
            local pack = j == #exprs and EXPANDS[e.kind] and produced or nil
            if pack then
                if pack.alternatives then
                    local alternatives = {}
                    for armIndex, arm in ipairs(pack.alternatives) do
                        local armHead, armModes = {}, {}
                        for k, value in ipairs(head) do
                            armHead[k], armModes[k] = value, modes[k]
                        end
                        for k, resultT in ipairs(arm.head) do
                            armHead[#armHead + 1] = resultT
                            local mode = arm.modes[k]
                            armModes[#armModes + 1] = mode
                                and mode ~= "plain" and mode or valueMode(resultT)
                        end
                        alternatives[armIndex] = T.pack(armHead, arm.tail,
                            armModes)
                    end
                    return T.packUnion(alternatives)
                end
                for k, resultT in ipairs(pack.head) do
                    head[#head + 1] = resultT
                    local mode = pack.modes[k]
                    modes[#modes + 1] = mode and mode ~= "plain" and mode
                        or valueMode(resultT)
                end
                tail = pack.tail
            else
                head[#head + 1] = valueT
                modes[#modes + 1] = valueMode(valueT)
                if produced then
                    checkPackDiscard(produced, 2, e)
                end
            end
        end
        return T.pack(head, tail, modes)
    end

    local function inferList(exprs, count)
        local pack = inferListPack(exprs)
        local out = {}
        local hasExpressions = exprs and #exprs > 0
        local limit = count and hasExpressions and count
            or math.min(count or #pack.head, #pack.head)
        for j = 1, limit do
            out[j] = T.packAt(pack, j) or T.nil_
        end
        if count then
            checkPackDiscard(pack, count + 1,
                exprs and exprs[#exprs] or nil)
        end
        return out
    end

    -- Removes members of union `t` that fit `rem`; a full wipe-out keeps `t`.

    --- `t` with everything that fits `rem` removed. Subtracting one of boolean's two
    --- values leaves the other; a type parameter is left alone, since while
    --- unsubstituted it fits everything.

    -- What a condition proves, and where it holds, is its own concern; the walk applies
    -- what it is told. See nupp.check.narrow.
    local facts = narrow.install(c)
    c.facts = facts
    local pathKey = facts.pathKey

    --- Whether calling this expression never comes back. `error` is recognized by name
    --- so that untyped code keeps the behaviour it always had; anything else has to say
    --- so, through a declared `never` result or through a body that only ever raises.
    ---
    --- @param call the called expression, if the statement had one
    local function neverReturns(call: Node?): boolean
        if not call then
            return false
        end
        local kind = call.kind
        if kind ~= "call" and kind ~= "methodCall" then
            return false
        end
        local signature = call.signatureType as Type?
        if signature and signature.tag == "func" and signature.noreturn then
            return true
        end
        if kind == "call" then
            local callee = call.obj
            if callee and callee.kind == "name" then
                local tok = callee.token
                if tok and tok.text == "error" then
                    return true
                end
            end
        end
        return false
    end

    -- True if a block unconditionally leaves the enclosing scope.

    --- Whether control always leaves this block, so it never reaches what follows.
    local function alwaysExits(block: Node?): boolean
        local stats = block and block.kind == "block" and block.stats or {}
        local last = stats[#stats]
        if not last then
            return false
        end
        local kind = last.kind
        if kind == "returnStmt" or kind == "breakStmt"
            or kind == "continueStmt" then
            return true
        end
        if kind == "callStmt" then
            return neverReturns(last.expr)
        end
        return false
    end

    --- Whether every path out of this block raises rather than returning: the last
    --- statement is a call that never comes back, or a `do` block or a complete `if`
    --- chain of which the same is true. This is what makes a helper that only ever
    --- throws behave as if it were declared to return `never`, without being told.
    ---
    --- @param block the body to judge
    local function alwaysRaises(block: Node?): boolean
        local stats = block and block.kind == "block" and block.stats or {}
        local last = stats[#stats]
        if not last then
            return false
        end
        local kind = last.kind
        if kind == "callStmt" then
            return neverReturns(last.expr)
        end
        if kind == "doStmt" then
            return alwaysRaises(last.body)
        end
        if kind == "ifStmt" then
            local otherwise = last.elseClause
            if not otherwise then
                return false
            end
            for _, clause in ipairs(last.clauses) do
                if clause.kind ~= "ifClause" and clause.kind ~= "elseifClause" then
                    return false
                end
                if not alwaysRaises(clause.body) then
                    return false
                end
            end
            if otherwise.kind ~= "elseClause" then
                return false
            end
            return alwaysRaises(otherwise.body)
        end
        return false
    end

    --- Whether anything in this function's own body returns. A nested function's
    --- returns belong to it, so the walk stops where a new body begins.
    ---
    --- @param x the node to search
    local function returnsSomewhere(x: Node): boolean
        if x.kind == "returnStmt" then
            return true
        end
        if x.kind == "funcbody" or x.kind == "shortfn" then
            return false
        end
        for _, child in ipairs(x) do
            if not cst.isToken(child) and returnsSomewhere(child as Node) then
                return true
            end
        end
        return false
    end

    -- Reaching a member and checking a call against it, construction included. See
    -- nupp.check.calls.
    local apply = calls.install(c)
    c.apply = apply

    -- A metatable literal is where a declared contract is fulfilled, so what it puts
    -- under each key is checked wherever one is written. See nupp.check.metatable.
    metatable.install(c)

    -- The type an expression has. See nupp.check.expr.
    expr.install(c)

    ---------------------------------------------------------------------
    -- Statements
    ---------------------------------------------------------------------

    -- Whether an annotation is well formed, and what one defines, is its own job; the
    -- walk only asks. See nupp.check.annotate.
    local marks = annotate.install(c)
    c.marks = marks
    local validateAnnotation = marks.validateAnnotation

    -- Checking a declaration and publishing what it declares. See nupp.check.declare.
    declare.install(c, reifiableField, fix, insertBefore, validateAnnotation)

    --- Checks one statement, in the scope it stands in.
    ---
    --- @param stat the statement node
    -- A module is written `local M = {}` and filled in one statement at a time, so the
    -- constructor says nothing about what it exports. What is put on it does, and
    -- remembering that is what lets a caller reach an exported function's type rather
    -- than an open table's.
    local function modulePath(target: Node): string?
        local key = pathKey(target)
        if not key or not c.moduleLocal then
            return nil
        end
        if key:sub(1, #c.moduleLocal + 1) ~= c.moduleLocal .. "." then
            return nil
        end
        return key
    end

    local function recordConstTableFields(path: string, value: Node?)
        if not value or value.kind ~= "tableExpr" then
            return
        end
        for _, field in ipairs(value.fields or {}) do
            if field.kind == "fieldNamed" and field.isConst and field.name then
                local fieldPath = path .. "." .. field.name.text
                c.constModulePaths[fieldPath] = true
                recordConstTableFields(fieldPath, field.value)
            end
        end
    end

    local function recordModuleField(target: Node, t: Type?, constant: boolean?,
        value: Node?)
        if not c.moduleLocal or target.kind ~= "dotIndex" then
            return
        end
        local base, member = target.obj, target.name
        if not base or not member or base.kind ~= "name" then
            return
        end
        local baseTok = base.token
        if not baseTok or baseTok.text ~= c.moduleLocal then
            return
        end
        c.moduleFields[member.text] = t or T.any
        c.moduleFieldTokens[member.text] = member
        if constant then
            c.moduleFieldConst[member.text] = true
            local path = modulePath(target)
            if path then
                c.constModulePaths[path] = true
                recordConstTableFields(path, value)
            end
        end
    end

    local function constModuleField(target: Node): boolean
        local path = modulePath(target)
        return path ~= nil and c.constModulePaths[path] == true
    end

    -- Promoted onto the run so that the statement families below, each in its own
    -- module, can reach them without being lexically inside this function.
    c.inferList = inferList
    c.inferListPack = inferListPack
    c.checkPackDiscard = checkPackDiscard
    c.recordModuleField = recordModuleField
    c.constModuleField = constModuleField
    c.alwaysExits = alwaysExits
    c.alwaysRaises = alwaysRaises
    c.returnsSomewhere = returnsSomewhere

    -- Each statement family is its own module, installed here and reached through one
    -- table. A kind with no handler is a statement with nothing to check: empty, break,
    -- goto, label, and the error nodes recovery leaves behind.
    local statHandlers = {}
    for _, installed in ipairs({
        bindings.install(c), control.install(c), functions.install(c),
        cdef.install(c, reifiableField), pragma.install(c),
    }) do
        for kind, handle in pairs(installed) do statHandlers[kind] = handle end
    end
    statHandlers.recordDecl = c.checkTypedecl
    statHandlers.typeAlias = c.checkTypedecl

    local function checkStat(stat: Node)
        local handle = statHandlers[stat.kind]
        if handle then
            handle(stat)
        end
    end

    c.checkStat = checkStat

    -- Binds every type a block declares before any body is checked, so declarations in
    -- one block may name each other whatever the order. A nominal is created and bound
    -- here and filled in when its statement is reached; an alias's value waits until
    -- something names it.
    local function hoistDeclarations(block)
        for _, stat in ipairs(block.stats or {}) do
            local decl = stat
            while decl and decl.kind == "pragmaStmt" do decl = decl.stat end
            local k = decl and decl.kind
            if k == "recordDecl" and decl.name then
                local n, entry = c.declaredNominal(decl, decl.declKind)
                decl.hoistedType, decl.hoistedEntry = n, entry
                n.byname = n.byname or {}
                n.writeByname = n.writeByname or {}
                local key = c.declKey(decl)
                if c.qualifierOf(decl) then
                    n.runtimePath = key
                end
                c.bindType(key, n, nil)
            elseif k == "typeAlias" and decl.name and decl.value then
                local waiting = {node = decl.value, tok = decl.name, decl = decl}
                decl.hoistedAlias = waiting
                c.scope.pending[c.declKey(decl)] = waiting
            end
        end
        -- Methods, once the types they name are bound: publishing each signature now is
        -- what lets two methods call each other.
        local wasHoisting = c.hoisting
        c.hoisting = true
        for _, stat in ipairs(block.stats or {}) do
            local decl = stat
            while decl and decl.kind == "pragmaStmt" do decl = decl.stat end
            local fname = decl and decl.kind == "funcStmt" and decl.name
            local ownerKey, memberTok = nil, nil
            if fname then
                ownerKey, memberTok = c.funcOwner(fname)
            end
            if ownerKey then
                local owner = c.lookupType(ownerKey)
                local member = memberTok and memberTok.text
                if owner and owner.tag == "nominal" and owner.byname
                    and member and not owner.byname[member] then
                    local signature = c.signatureOf(decl.body,
                        fname.method and owner or nil)
                    owner.byname[member] = signature
                    owner.writeByname[member] = signature
                end
            end
        end
        c.hoisting = wasHoisting
    end

    --- Checks every statement of a block, hoisting the declarations in it first so they
    --- may name one another whatever the order.
    ---
    --- @param block the block node
    --- @param scopeManaged whether the caller has already pushed the scope
    c.checkBlock = function(block: Node?, scopeManaged: boolean?)
        if not scopeManaged then
            c.pushScope()
        end
        hoistDeclarations(block)
        local stats = block and block.kind == "block" and block.stats or {}
        for _, stat in ipairs(stats) do
            checkStat(stat)
        end
        if not scopeManaged then
            c.popScope()
        end
    end

    -- A goto may leave a resource scope (the lowering cleans before re-dispatch), but
    -- it may not enter one and bypass acquisition.
    local function auditWithGotos(block)
        local labels, gotos = {}, {}
        local function walk(node, regions)
            if not node or cst.isToken(node) then
                return
            end
            if node.kind == "funcbody" then
                if node.body then
                    auditWithGotos(node.body)
                end
                return
            end
            if node.kind == "shortfn" then
                if node.body then
                    auditWithGotos(node.body)
                end
                return
            end
            local active = regions
            if node.kind == "withStmt" then
                active = {}
                for region in pairs(regions) do active[region] = true end
                active[node] = true
            elseif node.kind == "labelStmt" and node.name then
                labels[node.name.text] = labels[node.name.text] or {}
                labels[node.name.text][#labels[node.name.text] + 1] = {
                    node = node,
                    regions = active,
                }
            elseif node.kind == "gotoStmt" and node.name then
                gotos[#gotos + 1] = {node = node, regions = active}
            end
            for _, child in ipairs(node) do walk(child, active) end
        end
        walk(block, {})
        for _, jump in ipairs(gotos) do
            local targets = labels[jump.node.name.text]
            local target = targets and targets[1]
            if target then
                for region in pairs(target.regions) do
                    if not jump.regions[region] then
                        c.diag("NUPP2617", jump.node,
                            "goto cannot enter a 'with' resource scope")
                        break
                    end
                end
            end
        end
    end

    -- Top-level statements bind into the root scope directly so that declaration files
    -- can export them and module return types resolve.
    for _, block in ipairs(result.root.blocks) do
        c.checkBlock(block, true)
        auditWithGotos(block)
    end
    auditScope(c.rootScope)

    -- A module's type is what it returned. Declarations that carry a runtime value put
    -- it on that table themselves, so there is nothing to merge in afterwards and
    -- nothing that could collide with a field already there.

    if opts and opts.declareGlobals and env then
        env.globals = env.globals or {}
        env.globalTypes = env.globalTypes or {}
        for name, entry in pairs(c.rootScope.vars) do
            env.globals[name] = entry
        end
        for name, t in pairs(c.rootScope.types) do
            env.globalTypes[name] = t
        end
        env.globalTypeDefs = env.globalTypeDefs or {}
        for name, def in pairs(c.rootScope.typeDefs) do
            env.globalTypeDefs[name] = def
        end
    end

    local facts = analysis.run(result, c)
    -- Both of these needed the whole file before they could answer, so they answer here
    -- and their diagnostics are put back in source order with everything else.
    c.unused.sweep()
    c.discard.sweep(facts and facts.byDefinition or nil)
    table.sort(c.diags, function(a, b) return a.offset < b.offset end)
    result.moduleExports = c.moduleExports
    return c.diags, c.moduleType, c.moduleExports
end

return checkMod
