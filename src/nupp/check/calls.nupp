--[[
Reaching a member, and checking a call against it.

Everything about applying something to arguments: what a member of a type is,
what a metamethod contract says an operator does, and how a call's arguments are
checked, its generics instantiated, and its ownership transferred.

Construction goes through here too, because `R{...}` is written as a call and
the difference is only what the callee turns out to be.
]]

local T = require("nupp.types")
local relations = require("nupp.relations")
local generics = require("nupp.generics")
local cst = require("nupp.cst")

local calls = {}

local isA = relations.isA
local rawType = T.unwrapOwnership
local substType = generics.subst
local substPack = generics.substPack
local unify = generics.unify
local unifyPack = generics.unifyPack
local instantiateNominal = generics.instantiate
local specializeSelf = generics.specializeSelf
local dropSelf = generics.dropSelf

--- A type, as nupp.types builds them.
local type Type = T.Type

local function callableMembers(t: Type): {T.Func}?
    if t.tag ~= "intersection" then return nil end
    local members: {T.Func} = {}
    for _, member in ipairs(t.members) do
        if member.tag ~= "func" then return nil end
        members[#members + 1] = member
    end
    return members
end

local function probeArm(ft: T.Func, argPack: T.Pack,
    cdefCall: boolean?): T.Func?, string?
    local map = {}
    if T.hasTypevar(ft) and (#(ft.typeParams or {}) > 0
        or #(ft.packParams or {}) > 0) then
        unifyPack(ft.paramPack, argPack, map)
        for j, tv in ipairs(ft.typeParams or {}) do
            local bound = ft.typeBounds and ft.typeBounds[j]
            local actual = map[tv]
            if bound and actual then
                local expected = substType(bound, map)
                local ok, why = isA(actual, expected)
                if not ok then
                    return nil, ("generic bound for %s: %s"):format(tv.name,
                        why or "not satisfied")
                end
            end
        end
    end
    local specialized = (#(ft.typeParams or {}) > 0 or #(ft.packParams or {}) > 0)
        and generics.instantiateFunction(ft, map) or ft
    local params = specialized.paramPack
    local actualCount = #argPack.head
    if not argPack.tail and actualCount > #params.head and not params.tail then
        return nil, ("too many arguments (expected %d, got %d)")
            :format(#params.head, actualCount)
    end
    for j = 1, math.min(actualCount, #params.head) do
        local actual = argPack.head[j]
        if cdefCall and actual.tag == "pinned" then
            actual = rawType(actual)
        end
        local ok, why = isA(actual, params.head[j])
        if not ok then return nil, ("argument %d: %s"):format(j, why or "mismatch") end
    end
    if not argPack.tail and actualCount < #params.head then
        for j = actualCount + 1, #params.head do
            local ok = isA(T.nil_, params.head[j])
            if not ok then
                return nil, ("omitted argument %d supplies nil, not %s")
                    :format(j, T.tostring(params.head[j]))
            end
        end
    end
    local tail = params.tail
    if tail and tail.kind == "homogeneous" then
        for j = #params.head + 1, actualCount do
            local ok, why = isA(argPack.head[j], tail.type)
            if not ok then
                return nil, ("argument %d in pack tail: %s")
                    :format(j, why or "mismatch")
            end
        end
        if argPack.tail and argPack.tail.kind == "homogeneous" then
            local ok, why = isA(argPack.tail.type, tail.type)
            if not ok then return nil, "pack tail: " .. (why or "mismatch") end
        end
    elseif not tail and argPack.tail and argPack.tail.kind == "homogeneous" then
        return nil, "an expanding argument tail may supply surplus values"
    end
    return specialized
end

local function probeSignature(ft: T.Func, argPack: T.Pack,
    cdefCall: boolean?): T.Func?, string?
    if not argPack.alternatives then return probeArm(ft, argPack, cdefCall) end
    local selected: T.Func? = nil
    for armIndex, arm in ipairs(argPack.alternatives) do
        local specialized, why = probeArm(ft, arm, cdefCall)
        if not specialized then
            return nil, ("argument-pack alternative %d: %s")
                :format(armIndex, why or "mismatch")
        end
        if selected and selected.id ~= specialized.id then
            return nil, "argument-pack alternatives require different generic specializations"
        end
        selected = specialized
    end
    return selected or ft
end

local function signaturesText(signatures: {T.Func}): string
    local parts = {}
    for j, signature in ipairs(signatures) do parts[j] = T.tostring(signature) end
    return table.concat(parts, "; ")
end

--- Installs the call machinery on one run.
---
--- @param c the run's state
--- @return the operations the walk calls
function calls.install(c: any): any
    local ops = {}

    local function callDetails(node)
        local callee = node and node.obj
        local token = callee and (callee.token or callee.name)
        local definition = token and token.definition
        local related = definition and c.related(definition,
            "called function is declared here") or nil
        return {related = related and {related} or nil,
            help = "compare the call with the declared parameter list"}
    end

    c.fieldType = function(t, name)
        t = rawType(t)
        if t.tag == "ptr" then
            return c.fieldType(t.elem, name)
        end
        -- A record's runtime table holds its methods, its statics and its nested
        -- declarations, so reaching a member through `metatable<R>` reaches R's.
        if t.tag == "metatable" then
            return c.fieldType(t.of, name)
        end
        -- A literal is one value of its base type and carries the same members, which
        -- is what lets `("%s"):format(x)` reach the string library.
        if t.tag == "literal" then
            return c.fieldType(t.base, name)
        end
        if t.tag == "typevar" and t.bound then
            local bound = t.bound as Type
            local ft, fieldDef = c.fieldType(bound, name)
            if ft and bound.tag == "nominal" then
                ft = specializeSelf(bound, ft, t)
            end
            return ft, fieldDef
        end
        if t.tag == "union" then
            local parts = {}
            for _, m in ipairs(t.members) do
                local ft = c.fieldType(m, name)
                if not ft then
                    return nil
                end
                parts[#parts + 1] = ft
            end
            if #parts > 0 then
                return T.union(parts)
            end
            return nil
        end
        if t.tag == "intersection" then
            local parts, definitions = {}, {}
            for _, m in ipairs(t.members) do
                local ft, definition = c.fieldType(m, name)
                if ft then
                    parts[#parts + 1] = ft
                    if definition then definitions[#definitions + 1] = definition end
                end
            end
            if #parts > 0 then
                return T.intersection(parts), definitions[1], definitions
            end
            return nil
        end
        if t.tag == "shape" then
            local named = t.byname[name]
            if named then
                return named
            end
            local indexKey, indexValue = t.indexReadKey, t.indexReadValue
            if indexKey and indexValue and isA(T.string, indexKey) then
                return T.optional(indexValue)
            end
        elseif t.tag == "nominal" and t.byname then
            local ft = t.byname[name]
            local indexKey, indexValue = t.indexReadKey, t.indexReadValue
            if not ft and indexKey and indexValue
                and isA(T.string, indexKey) then
                return T.optional(indexValue)
            end
            return ft and specializeSelf(t, ft, t) or nil,
                t.fieldDefs and t.fieldDefs[name] or nil
        elseif t.tag == "map" then
            if not t.readable or not isA(T.string, t.key) then
                return nil
            end
            return T.optional(t.value)
        elseif t == T.string and c.env and c.env.stringLib
            and c.env.stringLib.tag == "shape" then
            -- string values carry the string library as methods
            return c.env.stringLib.byname[name]
        end
        return nil
    end

    c.fieldWriteType = function(t, name)
        t = rawType(t)
        if t.tag == "ptr" then
            return c.fieldWriteType(t.elem, name)
        end
        if t.tag == "metatable" then
            return c.fieldWriteType(t.of, name)
        end
        if t.tag == "typevar" and t.bound then
            local bound = t.bound as Type
            local ft, fieldDef = c.fieldWriteType(bound, name)
            if ft and bound.tag == "nominal" then
                ft = specializeSelf(bound, ft, t)
            end
            return ft, fieldDef
        end
        if t.tag == "union" then
            local accepted = nil
            for _, m in ipairs(t.members) do
                local ft = c.fieldWriteType(m, name)
                if not ft then
                    return nil
                end
                if not accepted or isA(ft, accepted) then
                    accepted = ft
                elseif not isA(accepted, ft) then
                    return T.never
                end
            end
            return accepted
        end
        if t.tag == "intersection" then
            local accepted, definitions = {}, {}
            for _, m in ipairs(t.members) do
                local ft, definition = c.fieldWriteType(m, name)
                if ft then
                    accepted[#accepted + 1] = ft
                    if definition then definitions[#definitions + 1] = definition end
                end
            end
            if #accepted > 0 then
                return T.union(accepted), definitions[1], definitions
            end
            return nil
        end
        if t.tag == "shape" then
            local named = t.writeByname[name]
            if named then
                return named
            end
            if t.indexWriteKey and isA(T.string, t.indexWriteKey) then
                return t.indexWriteValue
            end
        elseif t.tag == "nominal" and t.writeByname then
            local ft = t.writeByname[name]
            if not ft and t.indexWriteKey
                and isA(T.string, t.indexWriteKey) then
                return t.indexWriteValue
            end
            return ft and specializeSelf(t, ft, t) or nil,
                t.writeFieldDefs and t.writeFieldDefs[name] or nil
        elseif t.tag == "map" then
            if not t.writeKey or not isA(T.string, t.writeKey) then
                return nil
            end
            return t.writeValue
        end
        return nil
    end

    c.fieldNames = function(t, writing)
        t = rawType(t)
        if t.tag == "ptr" then
            return c.fieldNames(t.elem, writing)
        end
        if t.tag == "metatable" then
            return c.fieldNames(t.of, writing)
        end
        if t.tag == "typevar" and t.bound then
            return c.fieldNames(t.bound, writing)
        end
        if t.tag == "union" then
            local shared = nil
            for _, member in ipairs(t.members) do
                local names = c.fieldNames(member, writing)
                if not shared then
                    shared = names
                else
                    for name in pairs(shared) do
                        if not names[name] then
                            shared[name] = nil
                        end
                    end
                end
            end
            return shared or {}
        end
        if t.tag == "intersection" then
            local names = {}
            for _, member in ipairs(t.members) do
                for name in pairs(c.fieldNames(member, writing)) do names[name] = true end
            end
            return names
        end
        local names = {}
        if (t.tag == "shape" or t.tag == "nominal") and t.byname then
            local members = writing and t.writeByname or t.byname
            for name in pairs(members or {}) do names[name] = true end
        elseif t == T.string and c.env and c.env.stringLib
            and c.env.stringLib.tag == "shape" then
            for name in pairs(c.env.stringLib.byname) do names[name] = true end
        end
        return names
    end

    -- The names a receiver contracts for, so a misspelled installation on its own table
    -- can be told from a field that is simply not there.
    c.metamethodNames = function(t)
        t = rawType(t)
        if t.tag == "ptr" then
            return c.metamethodNames(t.elem)
        end
        if t.tag == "typevar" and t.bound then
            return c.metamethodNames(t.bound)
        end
        if t.tag == "metatable" then
            return c.metamethodNames(t.of)
        end
        if t.tag == "intersection" then
            local names = {}
            for _, member in ipairs(t.members) do
                for name in pairs(c.metamethodNames(member)) do names[name] = true end
            end
            return names
        end
        local names = {}
        if t.tag == "nominal" then
            for name in pairs(t.metamethods or {}) do names[name] = true end
        end
        return names
    end

    function ops.metamethodOf(t, name)
        t = rawType(t)
        -- The contracts a metatable carries are the ones its receiver declared; that is
        -- what makes it that receiver's metatable rather than a table.
        if t.tag == "metatable" then
            return ops.metamethodOf(t.of, name)
        end
        if t.tag == "typevar" and t.bound then
            local bound = t.bound as Type
            local ft = ops.metamethodOf(bound, name)
            if ft and bound.tag == "nominal" then
                return specializeSelf(bound, ft, t)
            end
            return ft
        end
        if t.tag == "intersection" then
            local contracts = {}
            for _, member in ipairs(t.members) do
                local ft = ops.metamethodOf(member, name)
                if ft then contracts[#contracts + 1] = ft end
            end
            return #contracts > 0 and T.intersection(contracts) or nil
        end
        if t.tag == "nominal" and t.metamethods then
            local ft = t.metamethods[name]
            return ft and specializeSelf(t, ft, t) or nil
        end
        return nil
    end

    -- Method-call receivers are passed implicitly: adapt "function(self, ...)" by
    -- dropping the first parameter.

    --- A method's type as a plain function, receiver removed.

    ---------------------------------------------------------------------
    -- Generic instantiation
    ---------------------------------------------------------------------

    -- Rebuilds `t` with typevars replaced per `map` (unresolved -> any).

    function ops.validateTypeBounds(params, bounds, map, node)
        for j, tv in ipairs(params or {}) do
            local bound = bounds and bounds[j]
            local actual = map[tv]
            if bound and actual and actual ~= T.any then
                local ok, why = isA(actual, substType(bound, map))
                if not ok then
                    c.diag("NUPP2116", node,
                        ("type argument %s for %s: %s")
                        :format(T.tostring(actual), tv.name, why))
                end
            end
        end
    end

    -- Checks one declared operation contract against already-inferred arguments. Unlike
    -- inferCall this never evaluates expressions again.
    function ops.applyContract(ft, ats, argNodes, site, operation)
        local overloads = ft and callableMembers(ft) or nil
        if overloads then
            local survivors, rejections = {}, {}
            local argPack = T.pack(ats)
            for _, candidate in ipairs(overloads) do
                local specialized, why = probeSignature(candidate, argPack)
                if specialized then
                    survivors[#survivors + 1] = specialized
                else
                    rejections[#rejections + 1] = T.tostring(candidate) .. ": "
                        .. (why or "rejected")
                end
            end
            if #survivors == 0 then
                c.diag("NUPP2125", site,
                    ("no %s overload accepts this call: %s")
                    :format(operation, table.concat(rejections, "; ")))
                return T.any
            elseif #survivors > 1 then
                c.diag("NUPP2126", site,
                    ("several %s overloads accept this call: %s")
                    :format(operation, signaturesText(survivors)))
                return T.any
            end
            ft = survivors[1]
        end
        if not ft or ft.tag ~= "func" then
            c.diag("NUPP2003", site, operation .. " contract is not a function")
            return T.any
        end
        local params, rets = ft.params, ft.rets
        local varargType = ft.varargType
        if T.hasTypevar(ft) then
            local map = {}
            for j = 1, math.min(#ats, #params) do unify(params[j], ats[j], map) end
            if varargType then
                for j = #params + 1, #ats do unify(varargType, ats[j], map) end
            end
            for j, tv in ipairs(ft.typeParams or {}) do
                local bound = ft.typeBounds and ft.typeBounds[j]
                local actual = map[tv]
                if bound and actual then
                    local ok, why = isA(actual, substType(bound, map))
                    if not ok then
                        c.diag("NUPP2116", site,
                            ("type argument %s for %s: %s")
                            :format(T.tostring(actual), tv.name, why))
                    end
                end
            end
            local p2, r2 = {}, {}
            for j, p in ipairs(params) do p2[j] = substType(p, map) end
            for j, r in ipairs(rets) do r2[j] = substType(r, map) end
            params, rets = p2, r2
            if varargType then
                varargType = substType(varargType, map)
            end
        end
        if varargType then
            for j = #params + 1, #ats do
                local ok, why = isA(ats[j], varargType)
                if not ok then
                    c.diag("NUPP2006", argNodes[j] or site,
                        ("%s argument %d: %s"):format(operation, j, why))
                end
            end
        end
        if #ats > #params and not ft.vararg then
            c.diag("NUPP2007", site,
                ("%s takes %d arguments, got %d"):format(operation,
                #params, #ats))
        end
        for j = 1, math.min(#ats, #params) do
            local ok, why = isA(ats[j], params[j])
            if not ok then
                c.diag("NUPP2006", argNodes[j] or site,
                    ("%s argument %d: %s"):format(operation, j, why))
            end
        end
        return rets[1] or T.nil_
    end

    -- Returns ret1, full ret list.
    function ops.inferCall(node, calleeT, argsNode, knownAts)
        node.signatureType = calleeT
        if calleeT.ffiOut and #calleeT.ffiOut > 0 then
            node.ffiOutContracts = calleeT.ffiOut
        end
        local args = argsNode and argsNode.exprs or {}
        if argsNode and argsNode.table then
            args = {argsNode.table}
        elseif argsNode and argsNode.str then
            args = {argsNode.str}
        end
        -- A record's name holds its runtime table, and building instances is what that
        -- table is for, so the wrapper comes off before asking what is being called.
        -- Reaching a `metatable<R>` any other way -- a hand-built one under an
        -- annotation -- is not a declaration and is left alone.
        if calleeT.tag == "metatable" and calleeT.of.tag == "nominal"
            and calleeT.of.declKind == "record" then
            calleeT = calleeT.of
            node.signatureType = calleeT
        end
        -- struct construction: S{...} named or S(...) positional
        local constructible = calleeT.tag == "nominal"
            and (calleeT.declKind == "struct" or calleeT.declKind == "record")
        -- An operand naming a declared type was already answered as one. What is left
        -- is a value that is not a type at all, and `any` -- an unknown name under
        -- gradual typing -- is deliberately not one of them.
        if node.isNew and not constructible and not node.newReported
            and calleeT ~= T.any then
            local named = node.obj and c.pathKey(node.obj)
            c.diag("NUPP2206", node.obj or node,
                ("%s cannot be constructed"):format(named or T.tostring(calleeT)),
                nil, {help = "`new` builds a record or a struct"})
            node.newReported = true
        end
        -- Calling a declaration is no longer how it is built, so the call belongs to
        -- whatever the program installed: a record's `__call`, a struct's ctype. A
        -- record that declared no contract is the one case worth reporting, since
        -- calling it was until now the way to construct it.
        if constructible and not node.isNew then
            if calleeT.declKind == "record" then
                local callContract = ops.metamethodOf(calleeT, "__call")
                if callContract then
                    return ops.inferCall(node, dropSelf(callContract), argsNode)
                end
            end
            local named = c.pathKey(node.obj) or calleeT.name
            c.diag("NUPP2202", node,
                ("%s is constructed with `new`"):format(named), nil,
                {help = ("write new %s%s"):format(named,
                (argsNode and argsNode.table) and "{...}" or "(...)")})
            for _, arg in ipairs(args) do
                if not cst.isToken(arg) then
                    c.infer(arg)
                end
            end
            return calleeT, {calleeT}
        end
        if constructible then
            local affineValues = {}
            local tbl = nil
            if argsNode and argsNode.table then
                tbl = argsNode.table
            elseif #args == 1 and not cst.isToken(args[1])
                and args[1].kind == "tableExpr" then
                tbl = args[1]
            end
            -- A declaration that states how it is built is built that way and no other.
            -- Leaving the literal open beside a constructor would let every invariant
            -- the constructor establishes be walked around, which is the whole of what
            -- it is for.
            local constructors = calleeT.constructors
            if constructors and #constructors > 0 then
                local named = c.pathKey(node.obj) or calleeT.name
                if tbl then
                    c.diag("NUPP2208", node,
                        ("%s declares a constructor, so it is built by calling "
                        .. "it"):format(named), nil,
                        {help = ("write new %s(...) with the constructor's "
                        .. "arguments"):format(named)})
                    -- The fields were the wrong shape of argument, not a wrong one;
                    -- holding them to the constructor's parameters as well would say
                    -- the same thing twice.
                    c.infer(tbl)
                    return calleeT, {calleeT}
                end
                node.constructorCall = named
                -- The construction is settled here. What follows is an ordinary
                -- application of the constructor's signature, and re-entering with
                -- `new` still set would ask this same node whether it can be
                -- constructed a second time.
                node.isNew = nil
                local builtSignatures, bySignature = {}, {}
                local entries = calleeT.constructorEntries or {}
                for index, signature in ipairs(constructors) do
                    local typeParams, typeBounds, anyBound = {}, {}, false
                    for j, tv in ipairs(signature.typeParams or {}) do
                        typeParams[#typeParams + 1] = tv
                        local bound = signature.typeBounds
                            and signature.typeBounds[j] or nil
                        typeBounds[#typeParams] = bound
                        anyBound = anyBound or bound ~= nil
                    end
                    for j, tv in ipairs(calleeT.typeParams or {}) do
                        typeParams[#typeParams + 1] = tv
                        local bound = calleeT.typeBounds
                            and calleeT.typeBounds[j] or nil
                        typeBounds[#typeParams] = bound
                        anyBound = anyBound or bound ~= nil
                    end
                    local built = T.func(signature.params, {calleeT},
                        signature.vararg, signature.paramModes, nil,
                        #typeParams > 0 and typeParams or nil,
                        anyBound and typeBounds or nil, nil, nil, nil,
                        nil, signature.varargType, nil, signature.paramPack,
                        T.pack({calleeT}), signature.packParams,
                        signature.yieldPack, signature.resumePack)
                    builtSignatures[#builtSignatures + 1] = built
                    bySignature[built] = entries[index] or {index = index,
                        signature = signature}
                end
                local callable = T.intersection(builtSignatures)
                local first, rets, pack = ops.inferCall(node, callable, argsNode)
                local selected = node.overloadWinner or (#builtSignatures == 1
                    and builtSignatures[1] or nil)
                local entry = selected and bySignature[selected] or nil
                if entry then
                    node.constructorIndex = entry.index
                    node.constructorEntry = entry
                end
                if entry and calleeT.typeParams and node.argumentPack then
                    local map = {}
                    unifyPack(entry.signature.paramPack, node.argumentPack, map)
                    ops.validateTypeBounds(calleeT.typeParams, calleeT.typeBounds,
                        map, node)
                    local instance = instantiateNominal(calleeT, map)
                    first, rets, pack = instance, {instance}, T.pack({instance})
                    if node.signatureType and node.signatureType.tag == "func" then
                        local selectedSignature = node.signatureType
                        node.signatureType = T.func(selectedSignature.params,
                            {instance}, selectedSignature.vararg,
                            selectedSignature.paramModes, selectedSignature.predicate,
                            nil, nil, selectedSignature.borrowsParam,
                            selectedSignature.borrowsSelf,
                            selectedSignature.borrowsParams,
                            selectedSignature.ffiOut,
                            selectedSignature.varargType,
                            selectedSignature.noreturn,
                            selectedSignature.paramPack, T.pack({instance}), nil,
                            selectedSignature.yieldPack,
                            selectedSignature.resumePack)
                    end
                    node.valuePack = pack
                    c.lastCallRets = rets
                end
                return first, rets, pack
            end
            local genericMap = calleeT.typeParams and {} or nil
            if tbl and calleeT.declKind == "record" then
                -- tell the generator to stamp the metatable
                node.recordConstruct = c.pathKey(node.obj) or calleeT.name
            elseif calleeT.declKind == "record" then
                c.diag("NUPP2202", node,
                    ("record %s is constructed with named fields: new %s{...}")
                    :format(calleeT.name, calleeT.name))
            end
            if tbl then
                for _, f in ipairs(tbl.fields) do
                    if f.kind == "fieldNamed" then
                        local ft = calleeT.writeByname[f.name.text]
                            or calleeT.byname[f.name.text]
                        local fieldDef = calleeT.writeFieldDefs
                            and calleeT.writeFieldDefs[f.name.text]
                            or (calleeT.fieldDefs
                            and calleeT.fieldDefs[f.name.text] or nil)
                        c.markToken(f.name, fieldDef, ft, "property")
                        if not ft then
                            c.diag("NUPP2202", f, ("no field %q in struct %s")
                                :format(f.name.text, calleeT.name))
                        else
                            local vt = c.infer(f.value)
                            if c.ownershipKind(vt) == "owned"
                                or c.ownershipKind(vt) == "pinned" then
                                affineValues[f.name.text] = vt
                                c.moveExpression(f.value, vt,
                                    "affine record construction", c.ownershipKind(vt))
                            end
                            if genericMap then
                                unify(ft, vt, genericMap)
                            end
                            local ok, why = isA(vt, ft)
                            if not ok then
                                c.diag("NUPP2202", f, ("field %q: %s")
                                    :format(f.name.text, why))
                            end
                        end
                    else
                        c.diag("NUPP2202", f,
                            "struct construction takes named fields only")
                        if f.value then
                            c.infer(f.value)
                        end
                    end
                end
            else
                -- positional: values fill fields in declaration order
                local order = calleeT.fieldOrder or {}
                if #args > #order then
                    c.diag("NUPP2202", node, ("too many values (struct %s has %d fields)")
                        :format(calleeT.name, #order))
                end
                for j, arg in ipairs(args) do
                    if not cst.isToken(arg) then
                        local at = c.infer(arg)
                        local fname = order[j]
                        local ft = fname and (calleeT.writeByname[fname]
                            or calleeT.byname[fname])
                        if fname and (c.ownershipKind(at) == "owned"
                            or c.ownershipKind(at) == "pinned") then
                            affineValues[fname] = at
                            c.moveExpression(arg, at, "affine record construction",
                                c.ownershipKind(at))
                        end
                        if ft then
                            local ok, why = isA(at, ft)
                            if not ok then
                                c.diag("NUPP2202", arg, ("value %d (field %q): %s")
                                    :format(j, fname, why))
                            end
                        end
                    end
                end
            end
            if genericMap then
                -- the type arguments follow from the values supplied
                ops.validateTypeBounds(calleeT.typeParams, calleeT.typeBounds,
                    genericMap, node)
                local inst = instantiateNominal(calleeT, genericMap)
                return inst, {inst}
            end
            if calleeT.affineFields and #calleeT.affineFields > 0 then
                local cleanups, opaque = {}, false
                if calleeT.defaultDisposers
                    and #calleeT.defaultDisposers == 1 then
                    cleanups[1] = calleeT.defaultDisposers[1]
                else
                    for j = #calleeT.affineFields, 1, -1 do
                        local name = calleeT.affineFields[j]
                        local valueT = affineValues[name]
                        if c.ownershipKind(valueT) == "owned" then
                            if #(valueT.cleanups or {}) == 0 then
                                opaque = true
                            else
                                for _, cleanup in ipairs(valueT.cleanups) do
                                    cleanups[#cleanups + 1] =
                                        "@field|" .. name .. "|" .. cleanup
                                end
                            end
                        elseif c.ownershipKind(valueT) == "pinned" then
                            cleanups[#cleanups + 1] = "@dropfield|" .. name
                        end
                    end
                end
                if opaque then
                    cleanups = {}
                end
                local owned = T.owned(calleeT, cleanups)
                return owned, {owned}
            end
            return calleeT, {calleeT}
        end

        -- A bounded receiver reaches `__call` through its bound, and so does a
        -- metatable standing for one: calling a declaration's table is exactly what the
        -- contract on it describes. A concrete record was unwrapped above and answered
        -- as a construction or a call before reaching here.
        local callContract = ops.metamethodOf(calleeT, "__call")
        if callContract then
            return ops.inferCall(node, dropSelf(callContract), argsNode)
        end

        local overloads = callableMembers(calleeT)
        if calleeT == T.any or (calleeT.tag ~= "func" and not overloads) then
            -- A `new` whose operand was already refused is not also a bad call: the
            -- program said what it meant, and one diagnostic says why it cannot be met.
            if calleeT ~= T.any and not node.newReported then
                c.diag("NUPP2005", node,
                    ("%s is not callable"):format(T.tostring(calleeT)))
            end
            -- still check the argument expressions themselves
            for _, arg in ipairs(args) do
                if not cst.isToken(arg) then
                    local argumentType = c.infer(arg)
                    if c.ownershipKind(argumentType) then
                        c.diag("NUPP2603", arg,
                            "an owner or borrow cannot cross an untyped call; "
                            .. "use intoRaw explicitly to abandon tracking")
                    end
                end
            end
            return T.any, nil
        end

        -- Lua expands only the final argument expression. Keep that sequence intact so
        -- a generic tail binds heterogeneous slots instead of a widened element type.
        local ats = knownAts or {}
        local argPack
        if knownAts then
            argPack = T.pack(knownAts)
        elseif #args == 1 and cst.isToken(args[1]) then
            ats[1] = args[1].kind == "string" and T.string or T.any
            argPack = T.pack(ats)
        else
            argPack = c.inferListPack(args)
            ats = argPack.head
        end
        node.argumentPack = argPack
        local selectionPack = argPack
        if argPack.alternatives then
            local maxHead: integer = 0
            for _, arm in ipairs(argPack.alternatives) do
                if #arm.head > maxHead then
                    maxHead = #arm.head
                end
            end
            ats = {}
            for j = 1, maxHead do ats[j] = T.packAt(argPack, j) or T.nil_ end
            argPack = T.pack(ats)
        end
        local argNodes = {}
        for j = 1, #argPack.head do
            argNodes[j] = args[math.min(j, #args)] or node
        end

        if overloads then
            local survivors, originals, rejections = {}, {}, {}
            for _, candidate in ipairs(overloads) do
                local specialized, why = probeSignature(candidate, selectionPack,
                    node.cdefCall)
                if specialized then
                    survivors[#survivors + 1] = specialized
                    originals[#originals + 1] = candidate
                else
                    rejections[#rejections + 1] = T.tostring(candidate) .. ": "
                        .. (why or "rejected")
                end
            end
            node.overloadCandidates = overloads
            if #survivors == 0 then
                c.diag("NUPP2125", node,
                    "no overload accepts this call: "
                    .. table.concat(rejections, "; "), nil, callDetails(node))
                return T.any, nil, T.pack({}, {kind = "unknown", type = T.any})
            elseif #survivors > 1 then
                c.diag("NUPP2126", node,
                    "several overloads accept this call: "
                    .. signaturesText(survivors), nil, callDetails(node))
                return T.any, nil, T.pack({}, {kind = "unknown", type = T.any})
            end
            calleeT = survivors[1]
            node.overloadWinner = originals[1]
            node.signatureType = calleeT
            if calleeT.ffiOut and #calleeT.ffiOut > 0 then
                node.ffiOutContracts = calleeT.ffiOut
            end
        end
        -- Provenance is value-flow metadata rather than part of an interned type. Align
        -- it with the adjusted argument pack so substituting a generic pack can carry a
        -- borrowed slot back out without detaching it from its owner.
        local argumentBorrowOwners = {}
        for j, source in ipairs(argNodes) do
            if not cst.isToken(source) then
                local expandedIndex = 1
                if #args > 0 and source == args[#args] and j >= #args then
                    expandedIndex = j - #args + 1
                end
                local owners = source.returnBorrowOwners
                    and source.returnBorrowOwners[expandedIndex] or nil
                if not owners and source.borrowOwner then
                    owners = {source.borrowOwner}
                elseif not owners and source.borrowOwners then
                    owners = source.borrowOwners
                end
                argumentBorrowOwners[j] = owners
            end
        end

        -- instantiate generics by unifying declared params against arguments
        local params, rets = calleeT.params, calleeT.rets
        local paramPack, retPack = calleeT.paramPack, calleeT.retPack
        local declaredParamPack, declaredRetPack = paramPack, retPack
        local paramModes = calleeT.paramModes or {}
        local varargType = calleeT.varargType
        -- Only bind generics introduced by the callable itself. A callback type such as
        -- `function(A...): R...` inside an outer generic function mentions the outer
        -- binders, but calling that callback must preserve those symbolic packs rather
        -- than treating them as a fresh generic signature and replacing an unbound
        -- result pack with `...any`.
        if T.hasTypevar(calleeT) and (#(calleeT.typeParams or {}) > 0
            or #(calleeT.packParams or {}) > 0) then
            local map = {}
            unifyPack(paramPack, argPack, map)
            -- The extra arguments bind the element type too, which is what makes
            -- `math.min(a, b)` over integers stay an integer.
            if varargType then
                for j = #params + 1, #ats do unify(varargType, ats[j], map) end
            end
            for j, tv in ipairs(calleeT.typeParams or {}) do
                local bound = calleeT.typeBounds and calleeT.typeBounds[j]
                local actual = map[tv]
                if bound and actual then
                    local expected = substType(bound, map)
                    local ok, why = isA(actual, expected)
                    if not ok then
                        c.diag("NUPP2116", node,
                            ("type argument %s for %s: %s")
                            :format(T.tostring(actual), tv.name, why))
                    end
                end
            end
            local p2, r2 = {}, {}
            for j, p in ipairs(params) do p2[j] = substType(p, map) end
            for j, r in ipairs(rets) do r2[j] = substType(r, map) end
            params, rets = p2, r2
            paramPack, retPack = substPack(paramPack, map), substPack(retPack, map)
            params, rets = paramPack.head, retPack.head
            paramModes = paramPack.modes
            if varargType then
                varargType = substType(varargType, map)
            end
        end

        local nparams = #params
        local actualCount = #argPack.head
        if not argPack.tail and actualCount > nparams and not calleeT.vararg then
            c.diag("NUPP2007", node, ("too many arguments (expected %d, got %d)")
                :format(nparams, actualCount), nil, callDetails(node))
            c.checkPackDiscard(argPack, nparams + 1, node)
        end
        -- A declared element type applies to every argument past the last named
        -- parameter; an undeclared `...` still accepts anything.
        if varargType then
            for j = nparams + 1, actualCount do
                local ok, why = isA(ats[j] or T.any, varargType)
                if not ok then
                    c.diag("NUPP2006", cst.isToken(argNodes[j])
                        and node or argNodes[j],
                        ("argument %d: %s"):format(j, why), nil,
                        callDetails(node))
                end
            end
        end
        for j = 1, math.min(actualCount, nparams) do
            local mode = paramModes[j] or "plain"
            local actualForCheck = ats[j]
            if node.cdefCall and c.ownershipKind(actualForCheck) == "pinned" then
                actualForCheck = rawType(actualForCheck)
                if not cst.isToken(argNodes[j]) then
                    argNodes[j].passPinnedPointer = true
                end
            end
            local ok, why = isA(actualForCheck, params[j])
            if not ok then
                c.diag("NUPP2006", cst.isToken(argNodes[j])
                    and node or argNodes[j],
                    ("argument %d: %s"):format(j, why), nil,
                    callDetails(node))
            end
            -- The parameter is fully substituted by now, so a `metatable<T>` says whose
            -- metatable this argument is. That is how `setmetatable` and any registrar
            -- taking one reach the receiver's contracts, a bounded generic's included.
            if not cst.isToken(argNodes[j]) then
                c.checkMetatableLiteral(argNodes[j], ats[j], params[j])
            end
            if mode == "takes" then
                local withBorrow = c.ownershipKind(ats[j]) == "borrowed"
                    and not cst.isToken(argNodes[j]) and argNodes[j].withBinding
                if withBorrow then
                    c.diag("NUPP2614", argNodes[j],
                        "a visible 'with' borrow cannot be consumed")
                end
                if not withBorrow then
                    c.moveExpression(cst.isToken(argNodes[j])
                        and node or argNodes[j],
                        ats[j], ("argument %d"):format(j))
                end
            elseif mode == "exclusive" then
                local entry, nameNode = c.ownershipEntry(argNodes[j])
                entry = c.ownershipState(entry)
                if c.ownershipKind(ats[j]) == "borrowed" then
                    c.diag("NUPP2602", argNodes[j] or node,
                        "an exclusive parameter needs sole access, not a shared borrow")
                elseif entry and (entry.activeBorrows or 0) > 0 then
                    c.diag("NUPP2602", nameNode or argNodes[j],
                        "an exclusive parameter cannot invalidate a value while a "
                        .. "derived borrow is live")
                end
            elseif mode == "borrows" and c.ownershipKind(ats[j]) == "borrowed" then
            -- Reborrowing is valid and does not alter either lifetime.
            elseif mode == "plain" and c.ownershipKind(ats[j]) then
                c.diag("NUPP2603", argNodes[j] or node,
                    "an owner or borrow needs a borrows, exclusive, or takes contract")
            elseif mode == "plain" and node.cdefCall
                and c.pointerShaped(ats[j]) and c.unsafeDepth == 0 then
                c.diag("NUPP2604", argNodes[j] or node,
                    "passing a raw pointer to C requires unsafe do or a "
                    .. "borrows, exclusive, takes, retains, or releases contract")
            elseif mode == "retains" or mode == "releases" then
                local entry, nameNode = c.ownershipEntry(argNodes[j])
                entry = c.ownershipState(entry)
                if not node.cdefCall then
                    c.diag("NUPP2602", argNodes[j] or node,
                        mode .. " is an imported C-function contract")
                elseif c.ownershipKind(ats[j]) ~= "pinned" or not entry then
                    c.diag("NUPP2602", argNodes[j] or node,
                        mode .. " argument requires a named pinned<T> handle")
                elseif entry.moved then
                -- The name expression already emitted the use-after-move.
                elseif mode == "retains" then
                    if entry.retained then
                        c.diag("NUPP2602", nameNode or argNodes[j],
                            "C already retains this pinned handle")
                    else
                        entry.retained = true
                    end
                elseif not entry.retained then
                    c.diag("NUPP2602", nameNode or argNodes[j],
                        "releases argument is not currently retained by C")
                else
                    entry.retained = false
                end
            end
        end
        -- A result declared `borrows p` is tied to whatever was passed for that
        -- parameter, so the call node carries the same borrow link a `borrow(owner)`
        -- expression would. Everything downstream — binding it, blocking a move of the
        -- owner, releasing at scope exit — is the machinery lexical borrows already
        -- use.
        if calleeT and calleeT.tag == "func"
            and (calleeT.borrowsParam or calleeT.borrowsSelf
            or calleeT.borrowsParams) then
            local sources = {}
            if calleeT.borrowsSelf then
                sources[#sources + 1] = node.obj
            end
            if calleeT.borrowsParam then
                sources[#sources + 1] = argNodes[calleeT.borrowsParam]
            end
            for _, at in ipairs(calleeT.borrowsParams or {}) do
                sources[#sources + 1] = argNodes[at]
            end
            local owners = {}
            for _, source in ipairs(sources) do
                local entry = source and c.ownershipEntry(source)
                if entry then
                    owners[#owners + 1] = c.borrowRoot(entry)
                elseif source then
                    c.diag("NUPP2619", source,
                        "a borrowed result needs named arguments to borrow from")
                end
            end
            if #owners == 1 then
                node.borrowOwner = owners[1]
                node.returnBorrowOwners = {[1] = owners}
            elseif #owners > 1 then
                node.borrowOwners = owners
                node.returnBorrowOwners = {[1] = owners}
            end
        end
        -- A pack used in both parameter and result position is a transparent forwarding
        -- channel. Copy the adjusted argument slot's borrow roots to the corresponding
        -- substituted result slot; rebuilding only the borrowed type would otherwise
        -- preserve its qualifier but lose what keeps it alive.
        local resultTail = declaredRetPack.tail
        if resultTail and resultTail.kind == "generic" then
            local inputStart: integer? = nil
            local inputTail = declaredParamPack.tail
            if inputTail and inputTail.kind == "generic"
                and inputTail.var == resultTail.var then
                inputStart = #declaredParamPack.head + 1
            end
            if inputStart then
                for j = #declaredRetPack.head + 1, #retPack.head do
                    local source = inputStart + j - #declaredRetPack.head - 1
                    local owners = argumentBorrowOwners[source]
                    if owners then
                        node.returnBorrowOwners = node.returnBorrowOwners or {}
                        node.returnBorrowOwners[j] = owners
                    end
                end
            end
        end
        for _, output in ipairs(calleeT.ffiOut or {}) do
            if output.kind == "borrowed" then
                local source = argNodes[output.sourceParam]
                local entry = source and c.ownershipEntry(source)
                if entry then
                    node.returnBorrowOwners = node.returnBorrowOwners or {}
                    node.returnBorrowOwners[output.returnIndex] = {
                        c.borrowRoot(entry),
                    }
                elseif source then
                    c.diag("NUPP2619", source,
                        "a borrowed C output needs a named lifetime source")
                end
            end
        end
        node.signatureType = T.func(params, rets, calleeT.vararg,
            paramModes, calleeT.predicate, calleeT.typeParams,
            calleeT.typeBounds, calleeT.borrowsParam, calleeT.borrowsSelf,
            calleeT.borrowsParams, calleeT.ffiOut, varargType,
            calleeT.noreturn, paramPack, retPack, calleeT.packParams,
            calleeT.yieldPack, calleeT.resumePack)
        return T.packAt(retPack, 1) or T.nil_, retPack.head, retPack
    end

    c.metamethodOf = ops.metamethodOf
    c.validateTypeBounds = ops.validateTypeBounds
    c.applyContract = ops.applyContract
    c.inferCall = ops.inferCall
    return ops
end

return calls
