--[[
Which operators are which, and what they dispatch to.

Plain data, shared by the passes that dispatch on an operator token. The families
follow LuaJIT's primitive families rather than the grammar's precedence levels,
because what matters here is which operands an operator accepts, not how tightly
it binds.
]]

local operators = {}

--- A set of operator tokens.
local type Set = {[string]: boolean}

--- FFI operations whose first argument names a type.
operators.ffiTypeFirst = {
    ["new"] = true, ["cast"] = true, ["istype"] = true, ["typeof"] = true,
    ["sizeof"] = true, ["alignof"] = true,
} as Set

--- Arithmetic, which takes numbers or a metamethod contract.
operators.arith = {
    ["+"] = true, ["-"] = true, ["*"] = true, ["/"] = true,
    ["%"] = true, ["^"] = true, ["//"] = true,
} as Set

--- Bitwise, which takes integers and gives one back.
operators.bitops = {
    ["&"] = true, ["|"] = true, ["~"] = true,
    ["<<"] = true, [">>"] = true, ["~>>"] = true,
} as Set

--- Comparison, which gives a boolean whatever it takes.
operators.compare = {
    ["<"] = true, [">"] = true, ["<="] = true, [">="] = true,
    ["=="] = true, ["~="] = true,
} as Set

--- The short-circuiting pair, whose right side is only reached under what the left side
--- proved.
operators.logical = {
    ["and"] = true, ["or"] = true,
} as Set

--- The metamethod an operator consults when its operands are not primitive.
operators.metamethod = {
    ["+"] = "__add", ["-"] = "__sub", ["*"] = "__mul",
    ["/"] = "__div", ["%"] = "__mod", ["^"] = "__pow",
    [".."] = "__concat",
} as {[string]: string}

--- The metamethods a declaration may contract for.
operators.contractMetamethod = {
    __call = true, __index = true, __newindex = true,
    __add = true, __sub = true, __mul = true, __div = true,
    __mod = true, __pow = true, __unm = true, __concat = true,
    __len = true, __eq = true, __lt = true, __le = true,
    __tostring = true,
} as Set

--- Every key LuaJIT itself gives meaning to in a metatable, so a misspelling in a
--- literal one is caught rather than silently ignored.
operators.runtimeMetamethod = {
    __call = true, __index = true, __newindex = true, __mode = true,
    __metatable = true, __tostring = true, __len = true,
    __add = true, __sub = true, __mul = true, __div = true,
    __mod = true, __pow = true, __unm = true, __concat = true,
    __eq = true, __lt = true, __le = true, __gc = true,
    __pairs = true, __ipairs = true,
} as Set

local T = require("nupp.types")
local relations = require("nupp.relations")
local narrowing = require("nupp.narrowing")
local cst = require("nupp.cst")
local lexer = require("nupp.lexer")

local isA = relations.isA
local subtract = narrowing.subtract

--- A type, as nupp.types builds them.
local type Type = T.Type

--- A node of the tree being checked.
local type Node = cst.Node

--- A token, as the lexer produced it.
local type Token = lexer.Token

--- Reports `customary-operator` when an operator was written in its C spelling. The two
--- forms mean exactly the same thing, so this is a house style question and nothing
--- more: a project that prefers `&&` turns the lint off, and a file that wants it once
--- writes `@allow("customary-operator")`.
local function customaryOperator(c: any, opTok: Token)
    -- The lexer folds both spellings into one token kind, so the text is all that is
    -- left to say which one the author chose.
    local classic = lexer.CUSTOMARY[opTok.text]
    if not classic then
        return
    end
    c.diag("NUPP2504", opTok,
        ("%s is the customary spelling of %s"):format(opTok.text, classic),
        {c.edits.fix(("change to `%s`"):format(classic),
        c.edits.replaceToken(opTok, classic))},
        {help = ("write %s"):format(classic)})
end

--- Installs the operator expressions on one run.
---
--- @param c the run's state
function operators.install(c: any): any

    local function orderingFamily(t)
        if t == T.any then
            return "any"
        end
        if isA(t, T.number) then
            return "number"
        end
        if isA(t, T.string) then
            return "string"
        end
        if t.tag == "union" then
            local family = nil
            for _, member in ipairs(t.members) do
                if member ~= T.nil_ then
                    local found = orderingFamily(member)
                    if not found or found == "any" then
                        return found
                    end
                    if family and family ~= found then
                        return nil
                    end
                    family = found
                end
            end
            return family
        end
        return nil
    end

    --- The type a numeric literal has, suffixes and radix included.

    --- `t` without nil, which is what a truthiness test leaves. Defined once here
    --- rather than each time a logical operator is inferred.
    c.minusNil = function(t)
        if t.tag == "union" and t.hasNil then
            local m = {}
            for _, x in ipairs(t.members) do
                if x ~= T.nil_ then
                    m[#m + 1] = x
                end
            end
            return T.union(m)
        end
        return t
    end

    local handlers = {}

    handlers.unop = function(node: cst.Unop): Type
        local operand = node.operand
        local opTok = node.op
        if not operand or not opTok then
            return T.any
        end
        customaryOperator(c, opTok)
        local t = c.infer(operand)
        local op = opTok.kind
        if op == "-" then
            local mm = c.metamethodOf(t, "__unm")
            if mm then
                return c.applyContract(mm, {t}, {operand}, node, "__unm")
            end
            c.numericOperand(t, node, op)
            return t == T.any and T.number or t
        elseif op == "~" then
            c.numericOperand(t, node, op)
            return T.integer
        elseif op == "#" then
            local mm = c.metamethodOf(t, "__len")
            if mm then
                return c.applyContract(mm, {t}, {operand}, node, "__len")
            end
            if not (t == T.any or isA(t, T.string) or isA(t, T.table_)) then
                c.diag("NUPP2003", node,
                    ("cannot apply '#' to %s"):format(T.tostring(t)))
            end
            return T.integer
        else -- not
            return T.boolean
        end
        return T.any
    end

    handlers.binop = function(node: cst.Binop): Type
        local opTok, lhs, rhs = node.op, node.lhs, node.rhs
        if not opTok or not lhs or not rhs then
            return T.any
        end
        customaryOperator(c, opTok)
        local op = opTok.kind
        local lt, rt
        if operators.logical[op] then
            -- the rhs is only evaluated under the lhs outcome: narrow it
            lt = c.infer(lhs)
            local facts = c.analyzeCond(lhs)
            c.pushScope()
            c.applyFacts(op == "and" and facts.t or facts.f)
            rt = c.infer(rhs)
            c.popScope()
        else
            lt, rt = c.infer(lhs), c.infer(rhs)
        end
        if operators.arith[op] then
            local mmName = op ~= "//" and operators.metamethod[op] or nil
            local mm = mmName and (c.metamethodOf(lt, mmName)
                or c.metamethodOf(rt, mmName)) or nil
            if mm then
                return c.applyContract(mm, {lt, rt}, {lhs, rhs},
                    node, mmName)
            end
            c.numericOperand(lt, lhs, op)
            c.numericOperand(rt, rhs, op)
            if op == "/" or op == "^" then
                return T.number
            end
            if isA(lt, T.integer) and isA(rt, T.integer)
                and lt ~= T.any and rt ~= T.any then
                return T.integer
            end
            return T.number
        elseif op == ".." then
            local mm = c.metamethodOf(lt, "__concat")
                or c.metamethodOf(rt, "__concat")
            if mm then
                return c.applyContract(mm, {lt, rt}, {lhs, rhs},
                    node, "__concat")
            end
            for _, pair in ipairs({{lt, lhs}, {rt, rhs}}) do
                local t = pair[1]
                if not (t == T.any or isA(t, T.number) or isA(t, T.string)) then
                    c.diag("NUPP2003", pair[2],
                        ("cannot concatenate %s"):format(T.tostring(t)))
                end
            end
            return T.string
        elseif operators.bitops[op] then
            c.numericOperand(lt, lhs, op)
            c.numericOperand(rt, rhs, op)
            return T.integer
        elseif operators.compare[op] then
            if op ~= "==" and op ~= "~=" then
                local mmName = (op == "<" or op == ">") and "__lt"
                    or "__le"
                local left, right = lt, rt
                local leftNode, rightNode = lhs, rhs
                if op == ">" or op == ">=" then
                    left, right, leftNode, rightNode = rt, lt,
                        rhs, lhs
                end
                local mm = c.metamethodOf(left, mmName)
                    or c.metamethodOf(right, mmName)
                if not mm and (op == "<=" or op == ">=") then
                    mmName = "__lt"
                    left, right, leftNode, rightNode = right, left,
                        rightNode, leftNode
                    mm = c.metamethodOf(left, mmName)
                        or c.metamethodOf(right, mmName)
                end
                if mm then
                    c.applyContract(mm, {left, right}, {leftNode, rightNode},
                        node, mmName)
                else
                    local lf, rf = orderingFamily(lt), orderingFamily(rt)
                    if not (lf == "any" or rf == "any"
                        or (lf and lf == rf)) then
                        c.diag("NUPP2003", node,
                            ("cannot compare %s and %s with '%s'")
                            :format(T.tostring(lt), T.tostring(rt), op))
                    end
                end
            end
            return T.boolean
        elseif op == "??" then
            -- yields the left unless it is nil, so nil drops out of it
            return T.union({subtract(lt, T.nil_), rt})
        elseif operators.logical[op] then
            -- Value-selection semantics. Until literal true/false types land with
            -- narrowing, a boolean lhs of 'and' approximates as contributing nothing
            -- (its false outcome), which types the pervasive 'cond and a or b' idiom
            -- correctly.
            if op == "and" then
                local parts = {rt}
                if lt == T.nil_ or (lt.tag == "union" and lt.hasNil) then
                    parts[#parts + 1] = T.nil_
                end
                return T.union(parts)
            else -- or
                if lt == T.nil_ then
                    return rt
                end
                return T.union({c.minusNil(lt), rt})
            end
        end
        return T.any
    end
    return handlers
end

return operators
