--[[
Whether a call written as a statement had a reason to be written.

A call whose value is thrown away is worth making only for what else it does.
When the callee does nothing else, the statement is dead: the program computes
a value, drops it, and continues. That is nearly always a use that lost its
assignment, or a call to the wrong one of two similarly named functions.

Rust needs `#[must_use]` on each function to say this, because a caller cannot
otherwise know. Nupp does not: effects are inferred for every visible function
already, so a callee that is proved inert and returns a value is nothing but
its result. The lint asks for no annotation.

Two questions have to be answered, and `nupp.analysis` answers one of them.

Whether the callee reaches anything the compiler cannot see is the
inter-procedural question, and the summary is authoritative on it: propagation
is file-local, so a callee that reaches another module widens to `top`, and so
does an unresolved call. Everything reported here is a call the compiler
resolved. What it misses is a call it could not follow, which is the right way
round.

Whether the callee writes is the intra-procedural question, and the summary is
not authoritative on it. A summary tracks writes through parameter-rooted paths
and treats a write through any other local as staying local, which is what
`docs/effects.md` means by scratch. A local that was read out of a parameter —
`local top = self.stack[n]` — is not scratch, and the alias classes only follow
direct name copies, so a write through it is recorded nowhere. Declining to
rest a lint on that, the write check here is syntactic and its own: any
assignment through an index, and any assignment to a name the body did not
declare, is a reason to make the call. It costs one walk of a body the compiler
has already parsed, and it is wrong only in the direction of saying nothing.

Reads and allocation are not reasons to call: reading state and throwing the
answer away is the mistake being described, and an allocation nobody keeps is
not an outcome. Writes, shape and metatable changes, escapes, declared callees,
yielding and raising all are.

Summaries settle only once the file is read, so a statement registers a
candidate where the walk finds it — which is also where its `@allow` is still
in scope — and the sweep runs after the fixpoint. See `docs/lints.md`.
]]

local T = require("nupp.types")
local cst = require("nupp.cst")

local discard = {}

-- Effect lists that give a call a reason to exist. `reads` and the `allocates` flag are
-- deliberately not among them.
local EFFECTFUL = {"writes", "shapes", "metatables", "escapes", "calls"}

local INDEXES = {
    dotIndex = true, bracketIndex = true,
    safeIndex = true, safeBracket = true,
}

-- Whether the body hands anything back. Read from the source rather than from the
-- inferred type, because a body that returns nothing and a body whose result is `any`
-- are the same type and are not the same question. A nested body owns its own returns,
-- so the walk stops where one begins.
local function returnsAValue(body: any): boolean
    if not body or cst.isToken(body) then
        return false
    end
    local kind = body.kind
    if kind == "funcbody" or kind == "shortfn" then
        return false
    end
    if kind == "returnStmt" and #(body.exprs or {}) > 0 then
        return true
    end
    for _, child in ipairs(body) do
        if returnsAValue(child) then
            return true
        end
    end
    return false
end

-- Whether the signature admits a value. `nil` is how a function spells returning
-- nothing, so a declaration of nothing but `nil` is a function called for its effects
-- whatever its body writes. An undeclared one has nothing to say here and defers to the
-- body.
local function signatureAdmitsAValue(ft: any): boolean
    if not ft or ft.tag ~= "func" then
        return true
    end
    for _, ret in ipairs(ft.rets or {}) do
        if ret ~= T.nil_ then
            return true
        end
    end
    return false
end

-- Whether a summary describes a function that reaches nothing the compiler cannot see.
-- Unknown is not inert: `top` means the summary gave up, and `external` means the body
-- is somebody else's.
local function closed(summary: any): boolean
    if not summary or summary.top or summary.external then
        return false
    end
    if summary.yields or summary.raises then
        return false
    end
    for _, list in ipairs(EFFECTFUL) do
        if next(summary[list] or {}) then
            return false
        end
    end
    return true
end

-- Every definition the body binds itself, parameters included. Assigning to one of
-- these writes a slot that dies with the call; assigning to anything else does not.
local function ownBindings(body: any): any
    local own = {}
    local function remember(tok: any)
        if tok and tok.definition then
            own[tok.definition] = true
        end
    end
    local function walk(node: any)
        if not node or cst.isToken(node) then
            return
        end
        local kind = node.kind
        if kind == "funcbody" or kind == "shortfn" then
            for _, param in ipairs(node.params or {}) do
                remember(param.name)
            end
        elseif kind == "localStmt" then
            for _, name in ipairs(node.names or {}) do remember(name) end
        elseif kind == "localFuncStmt" or kind == "fornumStmt" then
            remember(node.name)
        elseif kind == "forinStmt" then
            for _, name in ipairs(node.names or {}) do remember(name) end
        end
        for _, child in ipairs(node) do walk(child) end
    end
    walk(body)
    return own
end

-- Whether anything in the body writes where the caller could see it. A nested body is
-- walked with the rest: it may run before the call returns, and one that does not still
-- only makes this answer more cautious.
local function writesOutward(body: any): boolean
    local own = ownBindings(body)
    local found = false
    local function judge(target: any)
        if not target then
            return
        end
        local base = target
        while base and INDEXES[base.kind] do base = base.obj end
        if base ~= target then
            -- A write through an index reaches whatever the base refers to, and what
            -- that is cannot be settled by looking at the base alone.
            found = true
            return
        end
        if base.kind ~= "name" then
            found = true
            return
        end
        local tok = base.token
        if not tok or not tok.definition or not own[tok.definition] then
            found = true
        end
    end
    local function walk(node: any)
        if found or not node or cst.isToken(node) then
            return
        end
        if node.kind == "assignStmt" then
            for _, target in ipairs(node.targets or {}) do judge(target) end
        elseif node.kind == "compoundAssign" then
            judge(node.target)
        end
        for _, child in ipairs(node) do walk(child) end
    end
    walk(body)
    return found
end

--- Installs the discarded-result judgement on one run.
---
--- @param c the run's state
--- @return the operations the walk calls
function discard.install(c: any): any
    local ops = {}

    -- Call statements to judge once effect inference has settled, in source order.
    local candidates = {}

    --- Registers a call statement to judge at the end of the file.
    ---
    --- @param call the call expression the statement is
    function ops.statement(call: any)
        local callee = call and call.obj
        local tok = callee and (callee.token or callee.name) or nil
        if not tok or not tok.definition then
            return
        end
        candidates[#candidates + 1] = {
            tok = tok,
            -- Settled here because the statement's `@allow` is in scope here and gone
            -- by the time the sweep runs.
            allowed = c.suppressed("discarded-result"),
        }
    end

    --- Reports every registered statement whose callee turned out to have nothing to do
    --- but return a value the statement then dropped.
    ---
    --- @param byDefinition what `nupp.analysis` resolved, definition to summary
    function ops.sweep(byDefinition: any)
        if not byDefinition then
            return
        end
        -- One answer per body, since a helper called ten times is walked once.
        local inert = {}
        for _, candidate in ipairs(candidates) do
            local known = byDefinition[candidate.tok.definition]
            local body = known and known.body or nil
            if not candidate.allowed and body then
                if inert[body] == nil then
                    -- A function that returns nothing discards nothing, whatever else
                    -- is true of it.
                    inert[body] = returnsAValue(body.body)
                        and signatureAdmitsAValue(known.definition
                        and known.definition.type)
                        and closed(known.summary)
                        and not writesOutward(body.body)
                end
                if inert[body] then
                    local at = known.definition and known.definition.token
                    local related = at and c.related(at,
                        "declared here, and does nothing but return") or nil
                    c.diag("discarded-result", candidate.tok,
                        ("%s has no effects, so dropping its result leaves this "
                        .. "statement doing nothing"):format(candidate.tok.text),
                        nil,
                        {help = "use the result, or delete the call",
                        related = related and {related} or nil})
                end
            end
        end
    end

    return ops
end

return discard
