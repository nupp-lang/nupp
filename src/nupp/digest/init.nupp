module nupp.digest

--[[
Cryptographic hashes: SHA-256 and the rest.

One call for a whole string, or a context you feed in pieces and then consume.

```nupp
const digest = nupp.digest

print(digest.hexDigest("sha256", "hello"))

local running = digest.create("sha256")

running:update("hel")
running:update("lo")

print(running:hexDigest())
```

Finalizing consumes the context, so a digest is taken once and the binding is
spent afterwards. `digest()` answers
raw bytes, `digest(destination)` writes them into a writable byte span you
already have, and `hexDigest()` answers lowercase hexadecimal. Dropping a
context that was never finalized closes its provider state.

MD5 and SHA-1 are here for talking to things that already use them, and for
nothing else.

A host may supply its own catalog through [](nupp.digest.spi),
chosen by priority when this module initializes. Its entries override the
built-ins of the same name, the ones it does not name stay available, and a
descriptor whose size disagrees with its algorithm is refused. The catalog is
read once, at load, so no context operation resolves a service.
]]

local spi = require("nupp.spi")

const provider = require("nupp.digest.spi")

const contexts = require("nupp.digest.internal.context")

--- An owned incremental digest, consumed by either finalization overload.
export type Digest = contexts.Digest

--- Immutable algorithm metadata and a factory for independent digest contexts.
export record Algorithm
    --- Canonical service and algorithm name.
    readonly name: string

    --- Number of output bytes, available before creating mutable state.
    readonly digestSize: integer

    private implementation: provider.Algorithm

    --- Creates independent owned state for this algorithm.
    --- @return the unfinished digest context
    function create(self): Digest
        local state = self.implementation:create()
        return contexts.wrap(state, self.name, self.digestSize)
    end
end

local standard = require("nupp.runtime.provider.digest")

local function validate(selected: provider.Provider): nil
    for name, implementation in pairs(selected.algorithms) do
        if type(name) ~= "string"
            or name == ""
            or type(implementation) ~= "table"
            or implementation.name ~= name
            or type(implementation.digestSize) ~= "number"
            or implementation.digestSize <= 0
            or implementation.digestSize % 1 ~= 0
            or type(implementation.create) ~= "function"
        then
            error("invalid digest algorithm descriptor " .. tostring(name), 2)
        end
        local expected = standard.algorithms[name]
        if expected ~= nil and implementation.digestSize ~= expected.digestSize then
            error("digest provider has the wrong digestSize for " .. name, 2)
        end
    end
end

local selected: provider.Provider = do
    local chosen: provider.Provider?
    local tied = false
    for candidate in spi.load(provider.Provider) do
        if chosen == nil or (candidate.priority ?? 0) > (chosen.priority ?? 0) then
            chosen = candidate
            tied = false
        elseif (candidate.priority ?? 0) == (chosen.priority ?? 0) then
            tied = true
        end
    end
    assert(not tied, "nupp.digest: multiple implementations have the highest priority")
    if chosen ~= nil then
        yield chosen
    end
    yield standard
end
validate(selected)
local available: {[string]: Algorithm} = {}
for name, implementation in pairs(standard.algorithms) do
    available[
        name
    ] = new Algorithm(name = name, digestSize = implementation.digestSize, implementation = implementation)
end
for name, implementation in pairs(selected.algorithms) do
    available[
        name
    ] = new Algorithm(name = name, digestSize = implementation.digestSize, implementation = implementation)
end
local names: {string} = {}
for name in pairs(available) do
    names[#names + 1] = name
end
table.sort(names)

--- Looks up an algorithm without constructing mutable provider state.
--- @param name the canonical algorithm name
--- @return the descriptor, or nil when unavailable
export function lookup(name: string): Algorithm?
    return available[name]
end

--- Requires an available algorithm descriptor.
--- @param name the canonical algorithm name
--- @return the selected descriptor
--- @raises string when the algorithm is unavailable or its provider is invalid
export function algorithm(name: string): Algorithm
    local found = lookup(name)
    if found == nil then
        error("unknown digest algorithm " .. name, 2)
    end

    return found
end

--- Creates fresh incremental digest state.
--- @param name the canonical algorithm name
--- @return an owned unfinished digest
--- @raises string when the algorithm is unavailable or cannot be initialized
export function create(name: string): Digest
    return algorithm(name):create()
end

--- Lists canonical available names in ascending order.
--- @return the available canonical names
export function algorithms(): {string}
    local result: {string} = {}
    for index, name in ipairs(names) do
        result[index] = name
    end

    return result
end

--- Computes one raw digest.
--- @param name the canonical algorithm name
--- @param bytes the message bytes
--- @return the raw fixed-size digest bytes
export function digest(name: string, bytes: string): string
    local context = create(name)
    context:update(bytes)
    return context:digest()
end

--- Computes one lowercase hexadecimal digest.
--- @param name the canonical algorithm name
--- @param bytes the message bytes
--- @return the lowercase hexadecimal digest
export function hexDigest(name: string, bytes: string): string
    local context = create(name)
    context:update(bytes)
    return context:hexDigest()
end
