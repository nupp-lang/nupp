@!internal
--[[Built-in incremental digest and keyed-state factories.

The catalog adapter uses lookup and names to publish MD5, SHA-1, SHA-256, and
SHA-512 descriptors. Each factory creates independent state implementing the
canonical digest protocol. Span updates copy at most four KiB at a time into the
fixed word implementations, retain no borrowed views, and keep memory bounded.
HMAC-SHA256 owns its inner hash state and precomputed key pads. The public
facade owns output allocation and consuming cleanup; these states write into
the supplied destination. This module performs no SPI selection during
operations.
]]
module nupp.digest.internal.builtin

const provider = require("nupp.digest.internal.digestprovider")
const streaming = require("nupp.digest.internal.streaming")
const span = require("bytes.span")
const storage = require("nupp.runtime.storage")
const words = require("nupp.digest.internal.words")

local record State is provider.State
    @private value: streaming.Hasher

    function update(exclusive self, borrows bytes: span.Span<uint8>): nil
        -- Bound temporary copies for span-backed portable implementations.
        local offset: integer = 1
        while offset <= #bytes do
            local last: integer = math.min(offset + 4095, #bytes)
            local part = bytes:slice(offset, last)
            local pointer, count = part:ref()
            self.value:update(storage.string(pointer, count))
            offset = last + 1
        end
    end

    function finish(exclusive self, exclusive destination: span.ByteWriteSpan): nil
        self.value:writeDigest(destination)
    end

    function close(takes self): nil
        -- Portable state owns no external resource.
    end
end

local record Algorithm is provider.Algorithm
    @readonly name: string
    @readonly digestsize: integer

    function create(self): provider.State
        if self.name == "sha256" then
            return State(value = streaming.sha256())
        end
        return State(value = words.create(self.name))
    end
end

const ALGORITHMS: {
    [string]: provider.Algorithm
} = {
    md5 = Algorithm(name = "md5", digestsize = 16),
    sha1 = Algorithm(name = "sha1", digestsize = 20),
    sha256 = Algorithm(name = "sha256", digestsize = 32),
    sha512 = Algorithm(name = "sha512", digestsize = 64),
}

export function lookup(name: string): provider.Algorithm?
    return ALGORITHMS[name]
end

export function names(): {string}
    return {"md5", "sha1", "sha256", "sha512"}
end

export function hmacSha256(key: string): provider.State
    return State(value = streaming.hmac(key))
end
