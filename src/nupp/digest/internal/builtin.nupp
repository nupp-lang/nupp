@!internal
module nupp.digest.internal.builtin

--[[Built-in incremental digest and keyed-state factories.

The catalog adapter uses lookup and names to publish MD5, SHA-1, SHA-256, and
SHA-512 descriptors. Each factory creates independent state implementing the
canonical digest protocol. Span updates parse full blocks in place, retain no
borrowed views, and keep only the algorithms' bounded partial-block tails.
HMAC-SHA256 owns its inner hash state and precomputed key pads. The public facade
owns output allocation and consuming cleanup; these states write into the supplied
destination. This module performs no SPI selection during operations.
]]

const provider = require("nupp.digest.spi")
const streaming = require("nupp.digest.internal.streaming")
const span = require("nupp.mem.span")
const words = require("nupp.digest.internal.words")

local record State is provider.State
    @private
    value: streaming.Hasher

    function update(exclusive self, borrows bytes: span.ByteSpan): nil
        self.value:updateSpan(bytes)
    end

    function finish(exclusive self, exclusive destination: span.ByteWriteSpan): nil
        self.value:writeDigest(destination)
    end

    function close(takes self): nil
        -- Portable state owns no external resource.
    end
end

local record Algorithm is provider.Algorithm
    @readonly
    name: string
    @readonly
    digestSize: integer

    function create(self): provider.State
        if self.name == "sha256" then
            return new State(value = streaming.sha256())
        end
        return new State(value = words.create(self.name))
    end
end

const ALGORITHMS: {
    [string]: provider.Algorithm
} = {
    md5 = new Algorithm(name = "md5", digestSize = 16),
    sha1 = new Algorithm(name = "sha1", digestSize = 20),
    sha256 = new Algorithm(name = "sha256", digestSize = 32),
    sha512 = new Algorithm(name = "sha512", digestSize = 64),
}

export function lookup(name: string): provider.Algorithm?
    return ALGORITHMS[name]
end

export function names(): {string}
    return {"md5", "sha1", "sha256", "sha512"}
end

export function hmacSha256(key: string): provider.State
    return new State(value = streaming.hmac(key))
end
