@!internal
module nupp.checksum.internal.builtin

--[[Built-in Adler-32 and crc-fast algorithm descriptors.

Each descriptor creates independent state. CRC updates borrow byte spans through
crc-fast without retaining them; value reads the saved non-consuming snapshot.
]]

const provider = require("nupp.checksum.spi")
const span = require("nupp.mem.span")
const target = require("nupp.runtime.target")
const ffi = require("ffi")

ffi.cdef[[
int32_t nuppCrcUpdate(uint32_t, int32_t, uint64_t *, const uint8_t *, size_t);
const char *nuppCrcLastError(void);
]]

local C: any = do
    if target.host == "native" then
        yield _G.require("nupp.runtime.provider.nativecrc")
    end
    yield _G.require("nupp.runtime.browser.crc")
end

local function crcUpdate(id: integer, reset: integer, words: any, borrows bytes: const uint8[?], count: integer): nil
    local update = C.nuppCrcUpdate as function(integer, integer, any, borrows input: const uint8[?], integer): integer
    if update(id, reset, words, bytes, count) ~= 0 then
        error("nupp: " .. ffi.string(C.nuppCrcLastError()), 2)
    end
end

local record AdlerState is provider.State
    @private high: integer
    @private low: integer

    function update(exclusive self, borrows bytes: span.ByteSpan): nil
        for index = 1, #bytes do
            self.low = (self.low + bytes[index]) % 65521
            self.high = (self.high + self.low) % 65521
        end
    end

    function value(self): uint64
        return 0ULL + self.high * 65536 + self.low
    end

    function close(takes self): nil
    end
end

local record CrcState is provider.State
    @private id: integer
    @private words: any

    function update(exclusive self, borrows bytes: span.ByteSpan): nil
        crcUpdate(self.id, 0, self.words, bytes:ref(), #bytes)
    end

    function value(self): uint64
        return self.words[1] as uint64
    end

    function close(takes self): nil
    end
end

local record Algorithm is provider.Algorithm
    @readonly name: string
    @readonly width: integer
    @private id: integer

    function create(self): provider.State
        if self.id == 0 then
            return new AdlerState(high = 0, low = 1)
        end
        local words = ffi.new("uint64_t[2]")
        const empty = ""
        local bytes = span.fromString(empty)
        crcUpdate(self.id, 1, words, bytes:ref(), 0)

        return new CrcState(id = self.id, words = words)
    end
end

const ALGORITHMS: {
    [string]: provider.Algorithm
} = {
    adler32 = new Algorithm(name = "adler32", width = 32, id = 0),
    crc32 = new Algorithm(name = "crc32", width = 32, id = 1),
    crc32c = new Algorithm(name = "crc32c", width = 32, id = 2),
    ["crc64-ecma"] = new Algorithm(name = "crc64-ecma", width = 64, id = 3),
    crc64nvme = new Algorithm(name = "crc64nvme", width = 64, id = 4),
}

export function lookup(name: string): provider.Algorithm?
    return ALGORITHMS[name]
end

export function names(): {string}
    return {"adler32", "crc32", "crc32c", "crc64-ecma", "crc64nvme"}
end
