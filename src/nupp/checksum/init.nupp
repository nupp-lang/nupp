module nupp.checksum

--[[
Numeric checksums, for noticing that bytes got corrupted.

One call for a whole string, or a context you feed in pieces.

```nupp
const checksum = nupp.checksum

print(checksum.value("crc32c", "hello"))

with running = checksum.newChecksum("crc32-ieee") do
    running:write("hel")
    running:write("lo")
    print(running:value())
end
```

`value` is a snapshot rather than a finish, so a context keeps going after one
is taken. A context is an [`io.Writer`](nupp.io.Writer), so
`reader:transferTo(running)` checksums a whole stream without holding it. These say nothing about whether bytes were changed on purpose: for
that reach for [](nupp.mac).

## Built-in algorithms

| Name | Width | Parameters |
| --- | ---: | --- |
| `adler32` | 32 | Adler-32 |
| `crc32-ieee` | 32 | Reflected IEEE CRC-32 |
| `crc32c` | 32 | Reflected Castagnoli CRC-32C |
| `crc64-ecma` | 64 | ECMA-182, non-reflected, zero initialization and xor |

A snapshot is a number, so whatever writes one to the wire picks its byte order.

A host may supply its own catalog through
[](nupp.checksum.spi), selected during setup before this module
loads. Its entries override the built-ins of the same name and may add others,
and the ones it does not name stay available. The catalog is read once, at load,
so no lookup or update resolves a service.
]]

local spi = require("nupp.spi")

const span = require("nupp.mem.span")
const provider = require("nupp.checksum.spi")
const {type Writer} = require("nupp.io")

--- Owned incremental checksum state with non-consuming numeric reads.
export interface Checksum is Writer
    --- Consumes this context and releases its provider state without suspension.
    close: @nosuspend function(takes self: Checksum): nil

    --- Returns the canonical algorithm name.
    algorithm: function(self: Checksum): string

    --- Returns the number of meaningful bits in each snapshot.
    width: function(self: Checksum): integer

    --- Absorbs raw bytes while retaining no input views.
    --- @return true, since a checksum takes every byte it is given
    write: function(exclusive self: Checksum, bytes: string): (boolean, string?)

    --- Absorbs a borrowed byte view without retaining it.
    --- @return how many bytes it absorbed, which is all of them
    writeSpan: function(exclusive self: Checksum, borrows bytes: span.ByteSpan): (integer?, string?)

    --- Nothing is buffered behind a checksum, so this only answers true.
    flush: function(self: Checksum): (boolean, string?)

    --- Returns an unsigned snapshot without consuming this context.
    value: function(self: Checksum): uint64
end

local record Context is Checksum
    @private
    state: affine(provider.State)
    @private
    name: string
    @private
    bits: integer

    function algorithm(self): string
        return self.name
    end

    function width(self): integer
        return self.bits
    end

    function write(exclusive self, bytes: string): (boolean, string?)
        if type(bytes) ~= "string" then
            error("nupp: Checksum:write bytes must be a string", 2)
        end
        local view = span.fromString(bytes)
        self.state:update(view)

        return true, nil
    end

    function writeSpan(exclusive self, borrows bytes: span.ByteSpan): (integer?, string?)
        self.state:update(bytes)

        return #bytes, nil
    end

    function flush(self): (boolean, string?)
        return true, nil
    end

    function value(self): uint64
        return self.state:value()
    end

    function close(takes self): nil
        self.state:close()
    end
end

--- Checksum metadata and a factory for independent state.
export record Algorithm
    --- Canonical algorithm name.
    @readonly
    name: string

    --- Number of meaningful checksum bits, from one through 64.
    @readonly
    width: integer

    @private
    implementation: provider.Algorithm

    --- Creates independent owned state for incremental writes and snapshots.
    function newChecksum(self): Checksum
        return new Context(state = self.implementation:create(), name = self.name, bits = self.width)
    end
end

local standard = require("nupp.runtime.provider.checksum")

local function validate(selected: provider.Provider): nil
    for name, implementation in pairs(selected.algorithms) do
        if type(name) ~= "string"
            or name == ""
            or type(implementation) ~= "table"
            or implementation.name ~= name
            or type(implementation.width) ~= "number"
            or implementation.width < 1
            or implementation.width > 64
            or implementation.width % 1 ~= 0
            or type(implementation.create) ~= "function"
        then
            error("invalid checksum algorithm descriptor " .. tostring(name), 2)
        end
        local expected = standard.algorithms[name]
        if expected ~= nil and implementation.width ~= expected.width then
            error("checksum provider has the wrong width for " .. name, 2)
        end
    end
end

local selected: provider.Provider = do
    local chosen: provider.Provider?
    local tied = false
    for candidate in spi.load(provider.Provider) do
        if chosen == nil or (candidate.priority ?? 0) > (chosen.priority ?? 0) then
            chosen = candidate
            tied = false
        elseif (candidate.priority ?? 0) == (chosen.priority ?? 0) then
            tied = true
        end
    end
    assert(not tied, "nupp.checksum: multiple implementations have the highest priority")
    if chosen ~= nil then
        yield chosen
    end
    yield standard
end
validate(selected)
local available: {[string]: Algorithm} = {}
for name, implementation in pairs(standard.algorithms) do
    available[name] = new Algorithm(name = name, width = implementation.width, implementation = implementation)
end
for name, implementation in pairs(selected.algorithms) do
    available[name] = new Algorithm(name = name, width = implementation.width, implementation = implementation)
end
local names: {string} = {}
for name in pairs(available) do
    names[#names + 1] = name
end
table.sort(names)

--- Finds a checksum algorithm without creating incremental state.
--- @param name the canonical checksum algorithm name
--- @return the descriptor, or nil when unavailable
export function lookup(name: string): Algorithm?
    return available[name]
end

--- Requires a checksum algorithm descriptor.
--- @param name the canonical checksum algorithm name
--- @return the selected descriptor
--- @raises string when the algorithm is unavailable
export function algorithm(name: string): Algorithm
    local found = lookup(name)
    if found == nil then
        error("unknown checksum algorithm " .. name, 2)
    end

    return found
end

--- Creates independent owned checksum state.
--- @param name the canonical checksum algorithm name
--- @return an unfinished checksum context
export function newChecksum(name: string): Checksum
    return algorithm(name):newChecksum()
end

--- Lists available canonical checksum names in ascending order.
--- @return the available names
export function algorithms(): {string}
    local result: {string} = {}
    for index, name in ipairs(names) do
        result[index] = name
    end

    return result
end

--- Computes a checksum; its bit width belongs to the algorithm descriptor.
--- @param name the canonical checksum algorithm name
--- @param bytes the message bytes
--- @return the unsigned checksum value
export function value(name: string, bytes: string): uint64
    local context = newChecksum(name)
    context:write(bytes)
    return context:value()
end
