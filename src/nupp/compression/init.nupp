module nupp.compression

--[[
Compressing and decompressing a stream of bytes.

Ask for a format, then use its one-shot helpers or wrap a [](nupp.io) reader or
writer:

```nupp
local compression = require("nupp.compression")

const gzip = compression.format("gzip")

const encoded = gzip:newWriter(destination, {
    gzip = {level = 6},
})

encoded:write("hello")

assert(encoded:finish())
```

A factory consumes the reader or writer it wraps. A compression writer has to
end in `finish()`; closing or dropping one unfinished aborts the stream and
raises, because a truncated member is worse than a loud failure.

Adapter policy and format options are separate, which is why the options table
is keyed by format name.

## Built-in formats

| Name | Container | Writer options | Reader options |
| --- | --- | --- | --- |
| `gzip` | RFC 1952 gzip | `gzip = { level = 0..9 }` | `gzip = { concatenatedMembers = boolean }` |
| `zlib` | RFC 1950 zlib | `zlib = { level = 0..9 }` | none |
| `deflate-raw` | RFC 1951 raw DEFLATE | `deflateRaw = { level = 0..9 }` | none |

All three take levels zero through nine. Gzip checks its CRC and size trailers
and reads concatenated members by default, zlib checks its Adler-32 trailer, and
raw DEFLATE has no checksum at all. Trailing bytes are rejected in every case.

A provider-added format keys its options by its own canonical name;
`deflateRaw` above is the built-in ergonomic spelling of `deflate-raw`.
]]

local spi = require("nupp.spi")
local target = require("nupp.runtime.target")

const io = require("nupp.io")
const span = require("nupp.mem.span")
const storage = require("nupp.runtime.storage")
const provider = require("nupp.compression.spi")

local DEFAULT_WORKSPACE: integer = 65536
local DEFAULT_MAX_OUTPUT: integer = 67108864
local RATIO_ALLOWANCE: integer = 1024

--- Options in the `gzip` block passed to a compression writer.
export interface GzipWriterOptions
    --- Compression level from zero through nine; six by default.
    level: integer?
end

--- Options in the `zlib` block passed to a compression writer.
export interface ZlibWriterOptions
    --- Compression level from zero through nine; six by default.
    level: integer?
end

--- Options in the `deflateRaw` block passed to a compression writer.
export interface DeflateRawWriterOptions
    --- Compression level from zero through nine; six by default.
    level: integer?
end

--- Options in the `gzip` block passed to a decompression reader.
export interface GzipReaderOptions
    --- Whether to decode concatenated gzip members; true by default.
    concatenatedMembers: boolean?
end

--- Common compression-writer policy.
export interface WriterOptions
    --- Provider workspace in bytes; 65536 by default.
    workspaceBytes: integer?

    --- Gzip-specific options, accepted only by the gzip descriptor.
    gzip: GzipWriterOptions?

    --- Zlib-specific options, accepted only by the zlib descriptor.
    zlib: ZlibWriterOptions?

    --- Raw-DEFLATE-specific options, accepted only by the deflate-raw descriptor.
    deflateRaw: DeflateRawWriterOptions?
end

--- Common decompression-reader policy.
export interface ReaderOptions
    --- Provider workspace in bytes; 65536 by default.
    workspaceBytes: integer?

    --- Most decompressed bytes to produce; 64 MiB by default.
    maxOutputBytes: integer?

    --- Maximum output-to-input ratio after a 1 KiB input allowance.
    maxExpansionRatio: number?

    --- Explicitly removes the default output cap.
    unbounded: boolean?

    --- Gzip-specific options, accepted only by the gzip descriptor.
    gzip: GzipReaderOptions?
end

local function positive(value: integer?, fallback: integer, what: string): integer
    local answer = value or fallback
    if answer < 1 or answer ~= math.floor(answer) then
        error("nupp: " .. what .. " must be a positive integer", 3)
    end

    return answer
end

local function optionKey(name: string): string
    return name == "deflate-raw" and "deflateRaw" or name
end

local function validateKeys(options: provider.FormatOptions?, allowed: {[string]: boolean}, what: string): nil
    if options == nil then
        return
    end
    for name in pairs(options) do
        if not allowed[name] then
            error("nupp: unknown " .. what .. " option " .. name, 3)
        end
    end
end

local function formatOptions(
    settings: any,
    name: string,
    kind: string,
    common: {[string]: boolean}
): provider.FormatOptions?
    local expected = optionKey(name)
    local selected: any
    for key, value in pairs(settings as {[string]: any}) do
        if not common[key] then
            if key ~= expected then
                error("nupp: " .. key .. " " .. kind .. " options cannot configure " .. name, 3)
            elseif type(value) ~= "table" then
                error("nupp: " .. expected .. " " .. kind .. " options must be a table", 3)
            end
            selected = value
        end
    end

    return selected as provider.FormatOptions?
end

local WRITER_COMMON: {[string]: boolean} = {workspaceBytes = true}
local READER_COMMON: {
    [string]: boolean
} = {workspaceBytes = true, maxOutputBytes = true, maxExpansionRatio = true, unbounded = true,}

local function encoderOptions(settings: WriterOptions, name: string): provider.FormatOptions?
    local options = formatOptions(settings, name, "writer", WRITER_COMMON)
    if name == "gzip" or name == "zlib" or name == "deflate-raw" then
        validateKeys(options, {level = true}, optionKey(name) .. " writer")
        local level = options ~= nil and options.level or 6
        if type(level) ~= "number" or level < 0 or level > 9 or level ~= math.floor(level) then
            error("nupp: compression level must be an integer from zero through nine", 3)
        end
    end

    return options
end

local function decoderOptions(settings: ReaderOptions, name: string): provider.FormatOptions?
    local options = formatOptions(settings, name, "reader", READER_COMMON)
    if name == "gzip" then
        validateKeys(options, {concatenatedMembers = true}, "gzip reader")
        local concatenatedMembers = options ~= nil and options.concatenatedMembers or nil
        if concatenatedMembers ~= nil and type(concatenatedMembers) ~= "boolean" then
            error("nupp: gzip concatenatedMembers must be a boolean", 3)
        end
    elseif name == "zlib" or name == "deflate-raw" then
        validateKeys(options, {}, optionKey(name) .. " reader")
    end

    return options
end

local function readerConfiguration(
    options: ReaderOptions?,
    name: string
): (integer, integer?, number?, provider.FormatOptions?)
    local settings = options or {}
    local capacity = positive(settings.workspaceBytes, DEFAULT_WORKSPACE, "compression workspaceBytes")
    if settings.unbounded and settings.maxOutputBytes ~= nil then
        error("nupp: compression ReaderOptions cannot set both unbounded and maxOutputBytes", 3)
    end
    local maximum: integer? = settings.unbounded and nil
        or positive(settings.maxOutputBytes, DEFAULT_MAX_OUTPUT, "compression maxOutputBytes")
    local ratio = settings.maxExpansionRatio
    if ratio ~= nil and (ratio <= 0 or ratio >= math.huge or ratio ~= ratio) then
        error("nupp: compression maxExpansionRatio must be positive and finite", 3)
    end

    return capacity, maximum, ratio, decoderOptions(settings, name)
end

local interface OwnedPair is nupp.Closeable
    state: affine(provider.Encoder)
    destination: affine(io.Writer)
end

local record PairOwner is OwnedPair
    state: affine(provider.Encoder)
    destination: affine(io.Writer)

    function close(takes self): nil
        self.state:close()
        self.destination:close()
    end
end

--- An ordinary writer whose consuming `finish` emits the final trailer.
export interface CompressionWriter is io.Writer
    --- Aborts an unfinished stream and raises after releasing owned resources.
    --- @raises string whenever the stream was not consumed by `finish`
    close: @nosuspend function(takes self: CompressionWriter): nil

    --- Completes the stream, flushes and closes the owned destination.
    finish: function(takes self: CompressionWriter): (boolean, string?)
end

local record Writer is CompressionWriter
    @private
    state: affine(provider.Encoder)
    @private
    destination: affine(io.Writer)
    @private
    output: uint8[?]
    @private
    capacity: integer

    @private
    drain: function(exclusive self: Writer, count: integer): (boolean, string?)
    @private
    abort: @nosuspend function(takes self: Writer): nil

    function write(exclusive self, bytes: string): (boolean, string?)
        local input = span.fromString(bytes)
        local written, reason = self:writeSpan(input)
        if written == nil or written ~= #bytes then
            return false, reason or "compression writer accepted only part of the input"
        end

        return true, nil
    end

    function writeSpan(exclusive self, borrows input: span.ByteSpan): (integer?, string?)
        local at: integer = 1
        while at <= #input do
            local remaining = input:slice(at, #input)
            local output = span.writeCarray(self.output, self.capacity)
            local consumed, written, status, reason = self.state:write(remaining, output)
            nupp.drop(output)
            if consumed == nil or written == nil or status == nil then
                return nil, reason
            end
            if consumed < 0 or consumed > #remaining or written < 0 or written > self.capacity then
                return nil, "compression provider reported invalid progress"
            end
            local ok, why = self:drain(written)
            if not ok then
                return nil, why
            end
            if consumed == 0 and written == 0 then
                return nil, "compression provider made no progress"
            end
            at = at + consumed
        end

        return #input, nil
    end

    function flush(self): (boolean, string?)
        while true do
            local output = span.writeCarray(self.output, self.capacity)
            local written, status, reason = self.state:flush(output)
            nupp.drop(output)
            if written == nil or status == nil then
                return false, reason
            end
            if written < 0 or written > self.capacity then
                return false, "compression provider reported invalid progress"
            end
            local ok, why = self:drain(written)
            if not ok then
                return false, why
            end
            if status == provider.NEED_INPUT then
                return self.destination:flush()
            end
            if written == 0 then
                return false, "compression provider made no flush progress"
            end
        end
    end

    function finish(takes self): (boolean, string?)
        local output, capacity = self.output, self.capacity
        with owner = new PairOwner(state = self.state, destination = self.destination) do
            while true do
                local writable = span.writeCarray(output, capacity)
                local written, status, reason = owner.state:finish(writable)
                nupp.drop(writable)
                if written == nil or status == nil then
                    return false, reason
                end
                if written < 0 or written > capacity then
                    return false, "compression provider reported invalid progress"
                end
                if written > 0 then
                    local bytes = span.fromCarray(output, written)
                    local at: integer = 1
                    while at <= written do
                        local remaining = bytes:slice(at, written)
                        local moved, why = owner.destination:writeSpan(remaining)
                        if moved == nil then
                            return false, why
                        end
                        if moved < 1 or moved > #remaining then
                            return false, "destination writer made invalid progress"
                        end
                        at = at + moved
                    end
                end
                if status == provider.FINISHED then
                    local ok, why = owner.destination:flush()
                    return ok, why
                end
                if written == 0 then
                    return false, "compression provider made no finish progress"
                end
            end
        end
    end

    function close(takes self): nil
        self.state:close()
        self.destination:close()
        error("nupp: compression writer was closed without finish", 2)
    end

end

function Writer.drain(exclusive self: Writer, count: integer): (boolean, string?)
    if count == 0 then
        return true, nil
    end
    local bytes = span.fromCarray(self.output, count)
    local at: integer = 1
    while at <= count do
        local remaining = bytes:slice(at, count)
        local written, reason = self.destination:writeSpan(remaining)
        if written == nil then
            return false, reason
        end
        if written < 1 or written > #remaining then
            return false, "destination writer made invalid progress"
        end
        at = at + written
    end

    return true, nil
end

function Writer.abort(takes self: Writer): nil
    self.state:close()
    self.destination:close()
end

local function makeWriter(
    implementation: provider.Format,
    name: string,
    takes destination: io.Writer,
    options: WriterOptions?
): Writer
    local settings = options or {}
    local capacity = positive(settings.workspaceBytes, DEFAULT_WORKSPACE, "compression workspaceBytes")
    local formatSettings = encoderOptions(settings, name)
    return new Writer(
        state = implementation:createEncoder(formatSettings),
        destination = destination,
        output = storage.allocateBytes(capacity),
        capacity = capacity
    )
end

local record Reader is io.Reader
    @private
    state: affine(provider.Decoder)
    @private
    source: affine(io.Reader)
    @private
    input: uint8[?]
    @private
    capacity: integer
    @private
    inputAt: integer
    @private
    inputLength: integer
    @private
    inputTotal: integer
    @private
    outputTotal: integer
    @private
    maxOutputBytes: integer?
    @private
    maxExpansionRatio: number?
    @private
    streamFinished: boolean
    @private
    ended: boolean

    function close(takes self): nil
        self.state:close()
        self.source:close()
    end

    @private
    refill: function(self: Reader): (boolean?, string?)
    @private
    account: function(self: Reader, consumed: integer, written: integer): string?

    function readSpan(self, exclusive destination: span.Writable<uint8>): (integer?, string?)
        local destinationLength: integer
        do
            local output = destination as span.ByteWriteSpan
            destinationLength = #output
        end
        if destinationLength < 1 then
            error("nupp: compression Reader:readSpan destination must be positive", 2)
        end
        if self.ended then
            return 0, nil
        end
        while true do
            if self.streamFinished then
                local hasInput, why = self:refill()
                if hasInput == nil then
                    return nil, why
                elseif hasInput then
                    return nil, "compressed stream has trailing bytes"
                end
                self.ended = true
                return 0, nil
            end

            if self.inputAt > self.inputLength then
                local hasInput, why = self:refill()
                if hasInput == nil then
                    return nil, why
                end
                if not hasInput then
                    local written, status, reason = self.state:finishInput(destination)
                    if written == nil or status == nil then
                        return nil, reason
                    end
                    local limitFailure = self:account(0, written)
                    if limitFailure ~= nil then
                        return nil, limitFailure
                    end
                    if status ~= provider.FINISHED then
                        return nil, "compressed stream ended before its trailer"
                    end
                    self.streamFinished = true
                    if written > 0 then
                        return written, nil
                    end
                    self.ended = true
                    return 0, nil
                end
            end

            local all = span.fromCarray(self.input, self.inputLength)
            local input = all:slice(self.inputAt, self.inputLength)
            local consumed, written, status, reason = self.state:read(input, destination)
            if consumed == nil or written == nil or status == nil then
                return nil, reason
            end
            if consumed < 0 or consumed > #input or written < 0 or written > destinationLength then
                return nil, "compression provider reported invalid progress"
            end
            self.inputAt = self.inputAt + consumed
            local limitFailure = self:account(consumed, written)
            if limitFailure ~= nil then
                return nil, limitFailure
            end
            if status == provider.FINISHED then
                if self.inputAt <= self.inputLength then
                    return nil, "compressed stream has trailing bytes"
                end
                self.streamFinished = true
            end
            if written > 0 then
                return written, nil
            end
            if consumed == 0 then
                return nil, "compression provider made no progress"
            end
        end
    end

    function read(self, count: integer): (string?, string?)
        local wanted = positive(count, count, "compression Reader:read count")
        local output = storage.allocateBytes(wanted)
        local writable = span.writeCarray(output, wanted)
        local written, reason = self:readSpan(writable)
        nupp.drop(writable)
        if written == nil then
            return nil, reason
        end

        return storage.string(output, written), nil
    end

    function readInto(self, exclusive destination: io.Buffer, offset: integer?, count: integer?): (integer?, string?)
        local from = offset or 0
        if from < 0 or from ~= math.floor(from) then
            error("nupp: compression Reader:readInto offset must be a non-negative integer", 2)
        end
        local wanted = positive(count, DEFAULT_WORKSPACE, "compression Reader:readInto count")
        local lease = destination:reserveWrite(from, wanted)
        local written: integer?
        local reason: string?
        do
            local output = lease:span()
            written, reason = self:readSpan(output)
            nupp.drop(output)
        end
        if written == nil then
            nupp.drop(lease)
            return nil, reason
        end
        lease:commit(written)

        return written, nil
    end

    function transferTo(self, exclusive destination: io.Writer): (integer?, string?)
        local output = storage.allocateBytes(self.capacity)
        local total: integer = 0
        while true do
            local writable = span.writeCarray(output, self.capacity)
            local read, reason = self:readSpan(writable)
            nupp.drop(writable)
            if read == nil then
                return nil, reason
            elseif read == 0 then
                return total, nil
            end
            local bytes = span.fromCarray(output, read)
            local at: integer = 1
            while at <= read do
                local remaining = bytes:slice(at, read)
                local written, why = destination:writeSpan(remaining)
                if written == nil then
                    return nil, why
                end
                if written < 1 or written > #remaining then
                    return nil, "destination writer made invalid progress"
                end
                at = at + written
            end
            total = total + read
        end
    end
end

function Reader.refill(self: Reader): (boolean?, string?)
    local writable = span.writeCarray(self.input, self.capacity)
    local count, reason = self.source:readSpan(writable)
    nupp.drop(writable)
    if count == nil then
        return nil, reason
    end
    self.inputAt = 1
    self.inputLength = count

    return count > 0, nil
end

function Reader.account(self: Reader, consumed: integer, written: integer): string?
    self.inputTotal = self.inputTotal + consumed
    self.outputTotal = self.outputTotal + written
    if self.maxOutputBytes ~= nil and self.outputTotal > self.maxOutputBytes then
        return "decompressed output exceeds maxOutputBytes"
    end
    local ratioInput = math.max(self.inputTotal, RATIO_ALLOWANCE)
    if self.maxExpansionRatio ~= nil and self.outputTotal > ratioInput * self.maxExpansionRatio then
        return "decompressed output exceeds maxExpansionRatio"
    end

    return nil
end

--- Retained compression format descriptor.
export record Format
    --- Canonical format name.
    @readonly
    name: string

    @private
    implementation: provider.Format

    --- Wraps and owns a reader, validating the stream before EOF.
    --- @raises string when options are invalid or a format block does not match
    function newReader(self, takes source: io.Reader, options: ReaderOptions?): io.Reader
        local capacity, maximum, ratio, formatSettings = readerConfiguration(options, self.name)

        return new Reader(
            state = self.implementation:createDecoder(formatSettings),
            source = source,
            input = storage.allocateBytes(capacity),
            capacity = capacity,
            inputAt = 1,
            inputLength = 0,
            inputTotal = 0,
            outputTotal = 0,
            maxOutputBytes = maximum,
            maxExpansionRatio = ratio,
            streamFinished = false,
            ended = false
        )
    end

    --- Wraps and owns a writer. Consume the result with `finish()`.
    --- @raises string when options are invalid or a format block does not match
    function newWriter(self, takes destination: io.Writer, options: WriterOptions?): CompressionWriter
        return makeWriter(self.implementation, self.name, destination, options)
    end

    --- Compresses a borrowed span into a destination buffer.
    --- @raises string when options are invalid or compression fails
    function compress(
        self,
        borrows bytes: span.ByteSpan,
        exclusive destination: io.Buffer,
        options: WriterOptions?
    ): nil
        local sink = destination:newWriter()
        local compressed = makeWriter(self.implementation, self.name, sink, options)
        local written, reason = compressed:writeSpan(bytes)
        if written == nil then
            compressed:abort()
            error(reason or "compression failed", 2)
        end
        local ok
        ok, reason = compressed:finish()
        if not ok then
            error(reason or "compression failed", 2)
        end
    end

    --- Compresses a string into a destination buffer.
    --- @raises string when options are invalid or compression fails
    function compress(self, bytes: string, exclusive destination: io.Buffer, options: WriterOptions?): nil
        local input = span.fromString(bytes)
        self:compress(input, destination, options)
    end

    --- Compresses a borrowed span into a new string.
    --- @raises string when options are invalid or compression fails
    function compress(self, borrows bytes: span.ByteSpan, options: WriterOptions?): string
        local destination = io.newBuffer()
        self:compress(bytes, destination, options)
        local answer = destination:getString()
        destination:close()

        return answer
    end

    --- Compresses a string into a new string.
    --- @raises string when options are invalid or compression fails
    function compress(self, bytes: string, options: WriterOptions?): string
        local input = span.fromString(bytes)
        return self:compress(input, options)
    end

    --- Decompresses a borrowed span into a destination buffer.
    --- @raises string when options are invalid, the stream is invalid or a limit is
    ---     exceeded
    function decompress(
        self,
        borrows bytes: span.ByteSpan,
        exclusive destination: io.Buffer,
        options: ReaderOptions?
    ): nil
        local capacity, maximum, ratio, formatSettings = readerConfiguration(options, self.name)
        with state = self.implementation:createDecoder(formatSettings) do
            destination:clear()
            local inputAt: integer = 1
            local inputTotal: integer = 0
            local outputTotal: integer = 0
            local finished = false
            while not finished do
                local lease = destination:reserveWrite(outputTotal, capacity)
                local consumed: integer = 0
                local consumedResult: integer?
                local available: integer = 0
                local endingInput = inputAt > #bytes
                local written: integer?
                local status: integer?
                local reason: string?
                do
                    local output = lease:span()
                    if not endingInput then
                        local input = bytes:slice(inputAt, #bytes)
                        available = #input
                        consumedResult, written, status, reason = state:read(input, output)
                    else
                        written, status, reason = state:finishInput(output)
                    end
                    nupp.drop(output)
                end
                if (not endingInput and consumedResult == nil) or written == nil or status == nil then
                    nupp.drop(lease)
                    error(reason or "compression failed", 2)
                end
                consumed = consumedResult or 0
                if consumed < 0 or consumed > available then
                    nupp.drop(lease)
                    error("compression provider reported invalid progress", 2)
                end
                if written < 0 or written > capacity then
                    nupp.drop(lease)
                    error("compression provider reported invalid progress", 2)
                end
                if endingInput and status ~= provider.FINISHED then
                    nupp.drop(lease)
                    error("compressed stream ended before its trailer", 2)
                end

                inputAt = inputAt + consumed
                inputTotal = inputTotal + consumed
                local nextOutput = outputTotal + written
                if maximum ~= nil and nextOutput > maximum then
                    nupp.drop(lease)
                    error("decompressed output exceeds maxOutputBytes", 2)
                end
                local ratioInput = math.max(inputTotal, RATIO_ALLOWANCE)
                if ratio ~= nil and nextOutput > ratioInput * ratio then
                    nupp.drop(lease)
                    error("decompressed output exceeds maxExpansionRatio", 2)
                end
                if status == provider.FINISHED and inputAt <= #bytes then
                    nupp.drop(lease)
                    error("compressed stream has trailing bytes", 2)
                end
                if consumed == 0 and written == 0 and status ~= provider.FINISHED then
                    nupp.drop(lease)
                    error("compression provider made no progress", 2)
                end

                lease:commit(written)
                outputTotal = nextOutput
                finished = status == provider.FINISHED
            end
        end
    end

    --- Decompresses a string into a destination buffer.
    --- @raises string when options are invalid, the stream is invalid or a limit is
    ---     exceeded
    function decompress(self, bytes: string, exclusive destination: io.Buffer, options: ReaderOptions?): nil
        local input = span.fromString(bytes)
        self:decompress(input, destination, options)
    end

    --- Decompresses a borrowed span into a new string with a 64 MiB default cap.
    --- @raises string when options are invalid, the stream is invalid or a limit is
    ---     exceeded
    function decompress(self, borrows bytes: span.ByteSpan, options: ReaderOptions?): string
        local destination = io.newBuffer()
        self:decompress(bytes, destination, options)
        local answer = destination:getString()
        destination:close()

        return answer
    end

    --- Decompresses a string into a new string with a 64 MiB default cap.
    --- @raises string when options are invalid, the stream is invalid or a limit is
    ---     exceeded
    function decompress(self, bytes: string, options: ReaderOptions?): string
        local input = span.fromString(bytes)
        return self:decompress(input, options)
    end
end

local function validate(selected: provider.Provider): nil
    for name, implementation in pairs(selected.formats) do
        if type(name) ~= "string"
            or name == ""
            or type(implementation) ~= "table"
            or implementation.name ~= name
            or type(implementation.createEncoder) ~= "function"
            or type(implementation.createDecoder) ~= "function"
            or WRITER_COMMON[name]
            or READER_COMMON[name]
        then
            error("invalid compression format descriptor " .. tostring(name), 2)
        end
    end
end

local selected: provider.Provider = do
    local chosen: provider.Provider?
    local tied = false
    for candidate in spi.load(provider.Provider) do
        if chosen == nil or (candidate.priority ?? 0) > (chosen.priority ?? 0) then
            chosen = candidate
            tied = false
        elseif (candidate.priority ?? 0) == (chosen.priority ?? 0) then
            tied = true
        end
    end
    assert(not tied, "nupp.compression: multiple implementations have the highest priority")
    if chosen ~= nil then
        yield chosen
    end
    assert(target.host == "native", "nupp.compression: no implementation is available")
    yield _G.require("nupp.runtime.provider.nativecompression") as provider.Provider
end
validate(selected)
local standard: provider.Provider? = nil
if target.host == "native" then
    standard = _G.require("nupp.runtime.provider.nativecompression") as provider.Provider
end
local available: {[string]: Format} = {}
local names: {string} = {}
if standard ~= nil then
    for name, implementation in pairs(standard.formats) do
        available[name] = new Format(name = name, implementation = implementation)
    end
end
for name, implementation in pairs(selected.formats) do
    available[name] = new Format(name = name, implementation = implementation)
end
for name in pairs(available) do
    names[#names + 1] = name
end
table.sort(names)

--- Acquires a retained format descriptor or raises when unavailable.
export function format(name: string): Format
    local found = available[name]
    if found == nil then
        error("unknown compression format " .. name, 2)
    end

    return found
end

--- Lists available canonical format names in ascending order.
export function formats(): {string}
    local result: {string} = {}
    for index, name in ipairs(names) do
        result[index] = name
    end

    return result
end
