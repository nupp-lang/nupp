module nupp.compression.spi

--[[Implementation interfaces for compression stream catalogs.

Providers expose retained format descriptors. A descriptor creates independent
encoder and decoder state, and every state operation is span based. Step results
are three scalars: input consumed, output written and one of the integer status
constants below. Providers retain neither span and perform no SPI lookup from
a state operation.
]]

local {type ByteSpan, type ByteWriteSpan} = require("nupp.mem.span")

--- The step needs another input chunk.
export const NEED_INPUT = 1

--- The step filled its output and must be called with more space.
export const NEED_OUTPUT = 2

--- The complete stream and its wrapper trailer have been processed.
export const FINISHED = 3

--- The selected format's structural option block.
export type FormatOptions = {readonly [string]: any}

--- Independent incremental compression state.
export interface Encoder is nupp.Closeable
    close: nosuspend function(takes self: Encoder): nil
    write: function(
        exclusive self: Encoder,
        borrows input: ByteSpan,
        exclusive output: ByteWriteSpan
    ): (integer?, integer?, integer?, string?)
    flush: function(exclusive self: Encoder, exclusive output: ByteWriteSpan): (integer?, integer?, string?)
    finish: function(exclusive self: Encoder, exclusive output: ByteWriteSpan): (integer?, integer?, string?)
end

--- Independent incremental decompression state.
export interface Decoder is nupp.Closeable
    close: nosuspend function(takes self: Decoder): nil
    read: function(
        exclusive self: Decoder,
        borrows input: ByteSpan,
        exclusive output: ByteWriteSpan
    ): (integer?, integer?, integer?, string?)
    finishInput: function(exclusive self: Decoder, exclusive output: ByteWriteSpan): (integer?, integer?, string?)
end

--- Immutable format identity and state factories.
export interface Format
    readonly name: string
    createEncoder: function(self: Format, options: FormatOptions?): Encoder
    createDecoder: function(self: Format, options: FormatOptions?): Decoder
end

--- A selectable implementation catalog.
export interface Provider
    readonly priority: integer?

    readonly formats: {[string]: Format}
end
