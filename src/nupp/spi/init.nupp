module nupp.spi

--[[
Discover implementations, then choose with ordinary module initialization code.

`load(Interface)` returns a lazy iterator in dependency order. Iteration order
does not choose a winner: the caller may compare priorities, check capabilities,
or combine implementations. `select` is the common rule, the unique highest
`priority`, with the caller's fallback where nothing is advertised:

```nupp
local spi = require("nupp.spi")
local {type Codec} = require("example.codec.spi")

local impl: Codec = spi.select(spi.load(Codec)) ?? require("example.defaultcodec")
```

Keep the selected functions when the module loads. Packages advertise their
implementation modules in `nupp/spi.json`.
]]

const _DYNAMIC_REQUIRES = "@requires-dynamically nupp.spi.index"

local indexName = "nupp.spi.index"
local indexWasPresent = package.loaded[indexName] ~= nil or package.preload[indexName] ~= nil
local found, loaded = pcall(require, indexName)
local indexWasMissing = not found and tostring(loaded):find("module 'nupp.spi.index' not found:", 1, true) == 1
if not found and (indexWasPresent or not indexWasMissing) then
    error("nupp: cannot read provider index: " .. tostring(loaded), 0)
end
local index: {[string]: {string}} = found and loaded or {}

local type Origin = {
    interface: string,
    modules: {string}
}

--- The interface and modules behind each iterator `load` answered, so `select` can
--- name what tied.
local origins = setmetatable({}, {__mode = "k"}) as {[any]: Origin}

--- Iterates implementations of an exported interface without choosing one.
--- Call as `nupp.spi.load(Interface)`, passing the interface declaration.
--- Each iteration loads one module; ordinary require caching retains its identity.
--- @param interface The exported interface whose implementations to discover.
--- @return A lazy iterator of implementations, returning nil at exhaustion.
--- @raises any whatever an implementation raised while loading, which is that
---     module's business rather than this one's; the next call retries it
export function load<I>(interface: string): function(): I?
    local modules = index[interface] or {}
    local position: integer = 0
    const iterator = function(): I?
        local name = modules[position + 1]
        if name == nil then
            return nil
        end

        local implementation = require(name) as I
        position = position + 1

        return implementation
    end
    origins[iterator] = {interface = interface, modules = modules}

    return iterator
end

--- Chooses the implementation with the unique highest `priority`.
--- Call as `nupp.spi.select(nupp.spi.load(Interface)) ?? fallback`: nil where
--- nothing is advertised, so the fallback is loaded only when it is used.
--- An implementation that states no priority counts as 0, and a higher priority
--- supersedes a tie below it. Discovery order never breaks a tie for the highest.
--- @param candidates The implementations to choose among, usually what `load` answered.
--- @return The implementation with the highest priority, or nil where there is none.
--- @raises string where two implementations share the highest priority
--- @raises any whatever an implementation raised while loading
export function select<I>(candidates: function(): I?): I?
    local chosen: I? = nil
    local best: number = 0
    local chosenAt: integer = 0
    local tiedAt: integer? = nil
    local position: integer = 0
    for candidate in candidates do
        position = position + 1
        const priority = ((candidate as any).priority ?? 0) as number
        if chosen == nil or priority > best then
            chosen = candidate
            best = priority
            chosenAt = position
            tiedAt = nil
        elseif priority == best and tiedAt == nil then
            tiedAt = position
        end
    end
    if tiedAt ~= nil then
        const origin = origins[candidates]
        if origin ~= nil then
            error(
                (
                    "nupp: multiple implementations have the highest priority for %s: %s and %s, at %s"
                ):format(origin.interface, origin.modules[chosenAt], origin.modules[tiedAt], tostring(best)),
                2
            )
        end
        error(
            (
                "nupp: multiple implementations have the highest priority: candidates %d and %d, at %s"
            ):format(chosenAt, tiedAt, tostring(best)),
            2
        )
    end

    return chosen
end
