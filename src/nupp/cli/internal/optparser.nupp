module nupp.cli.internal.optparser

--[[
The syntax-only half of `nupp.cli`.

This parser knows how an argv word is shaped and, when the caller supplies an
arity, whether the following word belongs to an option. It deliberately knows
nothing about commands, field types, help, terminal policy, or process exits.
]]

--- The kind of one classified argv word.
export type TokenKind = "shortOption" | "longOption" | "argument" | "terminator"

export const shortOption: TokenKind = "shortOption"
export const longOption: TokenKind = "longOption"
export const argument: TokenKind = "argument"
export const terminator: TokenKind = "terminator"

--- How an option obtains a value.
export type ValueArity = "none" | "required" | "optionalAttached" | "attachedOnly"

--- One whole-word option form, such as `-O2`.
export type Pattern = {
    --- Lua pattern matched against the complete argv word.
    pattern: string,

    --- The normalized key exposed by the token.
    key: string
}

--- Syntax policy supplied to `optParser`.
export type OptParserConfig = {
    --- Value arity by normalized option name, without leading hyphens.
    arity: {[string]: ValueArity}?,

    --- Whole-word forms tried before ordinary short-option classification.
    patterns: {Pattern}?,

    --- Once the first argument is seen, expose every later word as an argument.
    stopAtFirstArgument: boolean?,

    --- Whether `--` itself is returned before its following arguments.
    exposeTerminator: boolean?
}

--- A syntax failure found while consuming argv.
export record SyntaxError
    kind: "missingValue" | "needsAttachedValue"
    index: integer
    raw: string
    key: string
    message: string
end

--- An incremental command-line option parser.
export record OptParser
    private argv: {string}
    private config: OptParserConfig
    private nextIndex: integer
    private literal: boolean
    private currentKind: TokenKind?
    private currentKey: string?
    private currentValue: string?
    private currentRaw: string?
    private currentIndex: integer
    private currentAttached: boolean
    private currentPattern: boolean

    --- Advances to the next token and returns its kind, or a syntax error.
    ---
    --- Token data remains on this parser until the next call to `next`.
    function next(self): TokenKind?, SyntaxError?
        self.currentKind = nil
        self.currentKey = nil
        self.currentValue = nil
        self.currentRaw = nil
        self.currentIndex = 0
        self.currentAttached = false
        self.currentPattern = false

        if self.nextIndex > #self.argv then
            return nil, nil
        end

        local index = self.nextIndex
        local raw = self.argv[index]
        self.nextIndex = index + 1

        if self.literal then
            self.currentKind = argument
            self.currentRaw = raw
            self.currentIndex = index
            return argument, nil
        end

        if raw == "--" then
            self.literal = true
            if self.config.exposeTerminator == false then
                return self:next()
            end
            self.currentKind = terminator
            self.currentRaw = raw
            self.currentIndex = index
            return terminator, nil
        end

        if raw ~= "-" and raw:sub(1, 1) == "-" then
            local patterns = self.config.patterns or {}
            for _, form in ipairs(patterns) do
                local captured = raw:match(form.pattern)
                if captured ~= nil then
                    local kind = raw:sub(1, 2) == "--" and longOption or shortOption
                    self.currentKind = kind
                    self.currentKey = form.key
                    self.currentValue = captured
                    self.currentRaw = raw
                    self.currentIndex = index
                    self.currentAttached = true
                    self.currentPattern = true
                    return kind, nil
                end
            end

            local long = raw:sub(1, 2) == "--"
            local prefix = long and 3 or 2
            local body = raw:sub(prefix)
            local equals = body:find("=", 1, true)
            local key = equals and body:sub(1, equals - 1) or body
            local value = equals and body:sub(equals + 1) or nil
            local attached = equals ~= nil
            local arity = self.config.arity and self.config.arity[key] or "none"

            if not attached and arity == "required" then
                local following = self.argv[self.nextIndex]
                if following == nil then
                    return nil, new SyntaxError(
                        kind = "missingValue",
                        index = index,
                        raw = raw,
                        key = key,
                        message = "option " .. raw .. " requires a value"
                    )
                end
                self.nextIndex = self.nextIndex + 1
                value = following
            elseif not attached and arity == "attachedOnly" then
                return nil, new SyntaxError(
                    kind = "needsAttachedValue",
                    index = index,
                    raw = raw,
                    key = key,
                    message = "option " .. raw .. " requires an attached value"
                )
            end

            local kind = long and longOption or shortOption
            self.currentKind = kind
            self.currentKey = key
            self.currentValue = value
            self.currentRaw = raw
            self.currentIndex = index
            self.currentAttached = attached
            return kind, nil
        end

        if self.config.stopAtFirstArgument then
            self.literal = true
        end

        self.currentKind = argument
        self.currentRaw = raw
        self.currentIndex = index

        return argument, nil
    end

    --- Returns the current token kind.
    ---
    --- @raises string when the parser has no current token
    function kind(self): TokenKind
        local kind = self.currentKind
        if kind == nil then
            error("OptParser has no current token", 2)
        end

        return kind
    end

    --- Returns the current option's normalized key.
    ---
    --- @raises string when the parser has no current token or it is not an option
    function key(self): string
        local kind = self:kind()
        if kind ~= shortOption and kind ~= longOption then
            error("OptParser key is only available for an option token", 2)
        end

        return assert(self.currentKey)
    end

    --- Returns the current option's value, when it has one.
    ---
    --- @raises string when the parser has no current token or it is not an option
    function value(self): string?
        local kind = self:kind()
        if kind ~= shortOption and kind ~= longOption then
            error("OptParser value is only available for an option token", 2)
        end

        return self.currentValue
    end

    --- Returns the original argv word for the current token.
    ---
    --- @raises string when the parser has no current token
    function raw(self): string
        self:kind()
        return assert(self.currentRaw)
    end

    --- Returns the one-based argv index of the current token.
    ---
    --- @raises string when the parser has no current token
    function index(self): integer
        self:kind()
        return self.currentIndex
    end

    --- Reports whether the current option carried an attached value.
    ---
    --- @raises string when the parser has no current token or it is not an option
    function attached(self): boolean
        local kind = self:kind()
        if kind ~= shortOption and kind ~= longOption then
            error("OptParser attached is only available for an option token", 2)
        end

        return self.currentAttached
    end

    --- Reports whether the current option matched a configured whole-word form.
    ---
    --- @raises string when the parser has no current token or it is not an option
    function pattern(self): boolean
        local kind = self:kind()
        if kind ~= shortOption and kind ~= longOption then
            error("OptParser pattern is only available for an option token", 2)
        end

        return self.currentPattern
    end

    --- Returns the unclassified suffix in its original order.
    function remaining(self): {string}
        local out: {string} = {}
        for index = self.nextIndex, #self.argv do
            out[#out + 1] = self.argv[index]
        end

        return out
    end

    --- Returns the original argv table.
    function original(self): {string}
        return self.argv
    end
end

--- Creates an incremental option parser.
export function optParser(argv: {string}, config: OptParserConfig?): OptParser
    return new OptParser(
        argv = argv,
        config = config or {},
        nextIndex = 1,
        literal = false,
        currentIndex = 0,
        currentAttached = false,
        currentPattern = false
    )
end

--- Iterates classified token kinds and the parser carrying their current state.
---
--- Syntax errors raise. Use `optParser` directly when they need to remain data.
export function getopt(argv: {string}, config: OptParserConfig?): function(): (TokenKind?, OptParser?)
    local stream = optParser(argv, config)
    local done = false
    return function(): (TokenKind?, OptParser?)
        if done then
            return nil, nil
        end
        local kind, problem = stream:next()
        if problem ~= nil then
            done = true
            error(problem.message, 2)
        elseif kind == nil then
            done = true
        end

        return kind, kind and stream or nil
    end
end
