module nupp.cli.internal.table

--[[
Aligned columnar output for commands that print a list of things.

A table is columns and rows of plain text. Width is measured here and styling is
applied after padding, because an escape code is bytes with no width on screen:
padding styled text aligns the escapes rather than the letters. That ordering is
the whole reason this is shared rather than written again at each command.

Nothing here wraps or truncates. A column is as wide as its widest cell, and a
terminal narrower than the total is the terminal's business -- a listing that
silently drops the end of a name is worse than one that wraps.
]]

const {type Style} = require("nupp.cli.internal.terminal")

--- How a cell sits in its column.
export type Alignment = "left" | "right"

--- One cell.
export record Cell
    --- What the cell says.
    text: string

    --- Paints the text, overriding the column's painter for this cell alone. How one
    --- row reports a level in its own severity colour while its neighbours do not.
    paint: (function(string): string)?

    --- An aside after the text, in its own colour: a default a project moved off, a
    --- unit, a "(default)" beside the name it belongs to. Written separately because
    --- it is painted separately, and measured with the text rather than after it, so
    --- a column carrying one still lines up with the column beside it.
    note: string?

    --- Paints the note. Defaults to the style's `faint`, which is what an aside is.
    notePaint: (function(string): string)?
end

--- One column.
export record Column
    --- What prints above it. An empty heading still reserves the column's width.
    heading: string

    --- Which side the padding goes on. Numbers read as a column when they are
    --- right aligned and as noise when they are not.
    align: Alignment?

    --- Paints every cell in this column that does not paint itself.
    paint: (function(string): string)?

    --- A floor on the width, for a column whose contents are shorter than what
    --- they will be once a row appears that fills it.
    minimumWidth: integer?
end

--- What to render.
export record Options
    columns: {Column}

    --- Rows, each as many cells as there are columns. A short row is padded with
    --- blanks rather than refused, so a caller may leave a trailing cell out.
    rows: {{Cell}}

    --- Where the heading colour and any cell colours come from. Supply the style
    --- selected for the stream being written to; omit it and nothing is painted.
    style: Style?

    --- Paints the heading row. Defaults to the style's `heading` role.
    headingPaint: (function(string): string)?

    --- Printed between columns. Two spaces unless a caller says otherwise.
    gap: string?

    --- Printed before every line, heading included.
    indent: string?

    --- Whether to print the heading row at all.
    showHeading: boolean?
end

--- A plain cell.
export function text(value: string): Cell
    return new Cell(text = value)
end

--- A cell that paints itself.
export function painted(value: string, paint: function(string): string): Cell
    return new Cell(text = value, paint = paint)
end

--- A cell carrying an aside.
export function annotated(value: string, note: string, paint: (function(string): string)?): Cell
    return new Cell(text = value, paint = paint, note = note)
end

local function identity(value: string): string
    return value
end

--- Renders the table, newline terminated, or the empty string when there are no rows.
---
--- No rows means no output at all, heading included: a heading standing over nothing
--- says a table is coming and then does not deliver one, and every caller that has
--- nothing to show would otherwise have to suppress it itself.
export function render(options: Options): string
    const columns = options.columns
    const rows = options.rows
    if #rows == 0 then
        return ""
    end
    const gap = options.gap or "  "
    const indent = options.indent or ""
    const showHeading = options.showHeading ~= false
    const styles = options.style
    const headingPaint = options.headingPaint or (styles ~= nil and styles.heading or identity)

    local widths: {integer} = {}
    for index, column in ipairs(columns) do
        local width = column.minimumWidth or 0
        if showHeading and #column.heading > width then
            width = #column.heading
        end
        widths[index] = width
    end
    for _, row in ipairs(rows) do
        for index = 1, #columns do
            const cell = row[index]
            if cell ~= nil then
                const measured = #cell.text + (cell.note ~= nil and #cell.note or 0)
                if measured > widths[index] then
                    widths[index] = measured
                end
            end
        end
    end

    const notePaint = styles ~= nil and styles.faint or identity

    -- Painted after padding, and the note painted apart from the text: an escape is
    -- bytes with no width on screen, so anything measured has to be measured before a
    -- colour is put on it. The last column carries no padding, because a trailing run
    -- of spaces is invisible in a terminal and very visible in a file, a diff, or
    -- anything that trims lines.
    local function laid(cell: Cell?, index: integer, column: Column, paint: function(string): string): string
        const value = cell ~= nil and cell.text or ""
        const note = cell ~= nil and cell.note or nil
        const align = column.align
        local padding = ""
        const missing = widths[index] - #value - (note ~= nil and #note or 0)
        if missing > 0 and (index < #columns or align == "right") then
            padding = (" "):rep(missing)
        end
        local body = paint(value)
        if note ~= nil then
            body = body .. (cell ~= nil and cell.notePaint or notePaint)(note)
        end
        if align == "right" then
            return padding .. body
        end

        return body .. padding
    end

    local lines: {string} = {}
    if showHeading then
        local parts: {string} = {}
        for index, column in ipairs(columns) do
            parts[index] = laid(new Cell(text = column.heading), index, column, headingPaint)
        end
        lines[#lines + 1] = indent .. table.concat(parts, gap)
    end
    for _, row in ipairs(rows) do
        local parts: {string} = {}
        for index, column in ipairs(columns) do
            const cell = row[index]
            parts[index] = laid(cell, index, column, cell ~= nil and cell.paint or column.paint or identity)
        end
        lines[#lines + 1] = indent .. table.concat(parts, gap)
    end
    if #lines == 0 then
        return ""
    end

    return table.concat(lines, "\n") .. "\n"
end

--- Renders the table straight to a stream.
export function write(stream: LuaFile, options: Options): nil
    const rendered = render(options)
    if rendered ~= "" then
        stream:write(rendered)
    end
end
