--[[
`nupp fmt`: formatting, as a filter or as a question.

Naming files makes it a filter: each is formatted to stdout, or rewritten with
--write. Naming none makes the project the subject, and a filter is then the
wrong shape — printing forty files to stdout answers nothing anybody asked — so
what comes back is the list of files that are not formatted, and a non-zero
status a build can gate on.

--check asks that same question of whatever it was given, so a build can gate on
the files a change touched rather than on the whole tree.
]]

local spec = require("nupp.cli.spec")

local command = spec.command{
    name = "fmt",
    summary = "Format Nupp source",
    usage = {"nupp fmt [-w|--write] [--check] [--no-method-parens] "
        .. "[--format text|json] [file...]"},
    intro = [[With files named, each is formatted to stdout, or rewritten with --write.

With none, the project is the subject: every .nupp and .d.nupp under the
manifest's include roots, minus the build output. The files that are not
formatted are listed and the exit status is 1, so a build can gate on it;
--write formats them and lists what it changed.

--check asks that question of whatever it was given, so a build can gate on
the files a change touched. Nothing is written and nothing goes to stdout but
the list; the exit status is 1 if it is not empty.]],
    options = require("nupp.cli.options").join(
        {names = {"-w", "--write"},
            help = "Rewrite files in place instead of writing to stdout"},
        {name = "--check",
            help = "Report which files are not formatted; write nothing"},
        {name = "--no-method-parens",
            help = "Leave obj:m{...} and obj:m\"...\" written without "
                .. "parentheses, instead of adding them"},
        require("nupp.cli.options").format()),
    schema = {
        type = "object",
        description = "Which files are not formatted, and what was done about it.",
        properties = {
            unformatted = {type = "array", items = {type = "string"},
                description = "Files whose formatting differs from the "
                    .. "formatter's. Under --write these are the files that "
                    .. "were rewritten."},
            written = {type = "boolean",
                description = "Whether the files listed were rewritten rather "
                    .. "than merely reported."},
            failed = {
                type = "array",
                description = "Files that could not be formatted at all, which "
                    .. "is a different answer from being unformatted.",
                items = {
                    type = "object",
                    properties = {file = {type = "string"},
                        diagnostics = require("nupp.cli.report").DIAGNOSTICS},
                    required = {"file", "diagnostics"},
                },
            },
            ok = {type = "boolean",
                description = "True when nothing was left unformatted and "
                    .. "nothing failed."},
        },
        required = {"ok", "unformatted", "written", "failed"},
    },
    detail = [[--json always reports the list, whichever form was asked for, and separates a
file that could not be formatted from one that merely is not.

A method call left in its sugar form, obj:m{...} or obj:m"...", is given its
parentheses back, obj:m({...}) and obj:m("..."). --no-method-parens leaves it
as written, and so does a manifest with fmt = { methodParens = false }; the
flag wins if both are given.]],
}

local function run(parsed: any): integer
    local values = parsed.values
    local write, asking = values.write, values.check
    if write and asking then
        return command:usageError(
            "--write and --check ask for opposite things: one fixes the "
            .. "formatting, the other reports it")
    end
    local fs = require("nupp.fs")
    local fmt = require("nupp.fmt")
    local envMod = require("nupp.env")
    local diagnosticMod = require("nupp.diagnostics")
    local reportMod = require("nupp.cli.report")
    local asJson = values.format == "json"
    local env = envMod.new(".")
    -- The manifest's default, unless --no-method-parens overrides it for
    -- this run; there is no flag to force it back on over a manifest that
    -- turned it off, the same one-way shape as --no-color over --color.
    local methodParens = not values.noMethodParens
        and envMod.fmtMethodParensDefault(env)
    local paths: {string} = parsed.positional
    local wholeProject = #paths == 0
    -- The project form and --check both ask rather than transform, so both report a
    -- list; naming files without --check stays the filter it has always been.
    -- Asking for JSON is asking for the answer, so it reports whatever it was given.
    local reporting = asking or wholeProject or asJson
    local failures: {any} = {}
    local function finish(code: integer, unformatted: {string}): integer
        if asJson then
            reportMod.write({ok = code == 0, written = write and true or false,
                unformatted = unformatted, failed = failures})
        end
        return code
    end
    if wholeProject then
        paths = envMod.listSourceFiles(env)
        if #paths == 0 then
            io.stderr:write("nupp: no source files found under the project's "
                .. "include roots\n")
            return finish(1, {})
        end
    end
    -- Whether a file already formats to itself is a pure function of its
    -- bytes, the options, and the annotations the project declares -- so the
    -- answer keeps, and `nupp fmt --check` over an unchanged project is the
    -- gate a build runs on every commit.
    --
    -- Both answers are stored, not just "already formatted". A project that
    -- is largely unformatted is the ordinary case for a gate, and it is
    -- exactly the case where every run would otherwise format every file to
    -- rediscover what the last run discovered.
    --
    -- Only a run that needs no text can act on a stored answer. `--write`
    -- needs the formatted bytes for a file that is not formatted, so a
    -- negative verdict tells it nothing it can use; the filter form needs
    -- them for every file, and is excluded entirely.
    local settled = reporting and envMod.formatStore(env) or nil
    local textNeeded = write and true or false
    local hashMod = require("nupp.build.hash")
    local optionsKey = nil
    local function verdictKey(path: string, source: string): string
        if not optionsKey then
            optionsKey = hashMod.digest(tostring(methodParens) .. "\0"
                .. envMod.annotationKey(env))
        end
        return hashMod.digest(optionsKey .. "\0" .. path .. "\0" .. source)
    end

    local failed = false
    local unformatted: {string} = {}
    for _, path in ipairs(paths) do
        local source, err = fs.readFile(path)
        if not source then
            if asJson then
                failures[#failures + 1] = {file = path, diagnostics =
                    reportMod.diagnosticValues({{filename = path, line = 0,
                    col = 0, offset = 0, length = 0, code = "NUPP0001",
                    msg = err,
                    help = "check that the path exists and is readable"}})}
            else
                io.stderr:write("nupp: " .. tostring(err) .. "\n")
            end
            failed = true
        elseif settled and settled.get(verdictKey(path, source)) == "same" then
            -- Known to format to itself: nothing to report and nothing to
            -- rewrite. Parsing the file and laying it out is the whole cost
            -- of finding that out, which is why it is worth not doing twice.
        elseif not textNeeded and settled
            and settled.get(verdictKey(path, source)) == "differs" then
            unformatted[#unformatted + 1] = path
        else
            local formatted, errors = fmt.format(source, path, {
                annotations = env.annotations,
                resolveAnnotation = function(name: string): any
                    return env.resolveProjectAnnotation(env, path, name)
                end,
                methodParens = methodParens,
            })
            -- A file that could not be formatted at all is not recorded: that
            -- is a diagnostic about the file rather than a verdict on its
            -- layout, and the next run has to say it again.
            if settled and #errors == 0 then
                settled.put(verdictKey(path, source),
                    formatted == source and "same" or "differs")
            end
            if #errors > 0 then
                -- Could not be formatted, which is a different answer from being
                -- unformatted, and the list form cannot tell them apart.
                if asJson then
                    failures[#failures + 1] = {file = path,
                        diagnostics = reportMod.diagnosticValues(errors)}
                else
                    diagnosticMod.report(errors)
                end
                failed = true
            elseif write then
                if formatted ~= source then
                    local out = assert(io.open(path, "wb"))
                    out:write(formatted)
                    out:close()
                    unformatted[#unformatted + 1] = path
                end
            elseif reporting then
                if formatted ~= source then
                    unformatted[#unformatted + 1] = path
                end
            else
                -- A named file is written out whether or not it changed: this is the
                -- filter form, and a filter that sometimes emits nothing is a filter
                -- that sometimes empties a file.
                io.write(formatted)
            end
        end
    end
    envMod.persist(env)
    if reporting then
        if #unformatted > 0 and not asJson then
            io.write(table.concat(unformatted, "\n"), "\n")
        end
        -- Rewriting them answered the question, so only the form that merely asked it
        -- reports a failure.
        if not write and #unformatted > 0 then
            failed = true
        end
    end
    return finish(failed and 1 or 0, unformatted)
end

return spec.Handler{spec = command, run = run}
