module nupp.bench

--[[
Measuring Nupp code from inside an ordinary program.

A benchmark here is a program, not a case a runner discovered. It links this
module, runs under `nupp run`, and reports itself:

```nupp
local bench = nupp.bench

local function sized(b: nupp.bench.Case): nil
    for _ = 1, b.n do
        bench.keep(makePoint())
    end
end

bench.case("presize.sized", sized)
bench.report()
```

The reason it is a library and not a `nupp bench` command is that a command has
to launch what it measures. An application's hot loop lives in the application,
so only something the loop can call reaches it. See
[NEP 32](docs/neps/0032-benchmarks-as-programs.md).

`report` raises rather than returning a status, because a chunk's return value
is discarded and a run that did not raise exits zero. It writes the record
first, so a case that trips the gate is still a case whose record the runner can
merge.
]]

local json = require("nupp.codec.json")
local profile = require("nupp.profile")
local time = require("nupp.time")

local bench = {}

--- The schema version of a written record. Bumped when a reader would otherwise
--- misread an older file.
bench.SCHEMA = 1

--- Rounds timed per case. The median of these is what a record reports, so an odd
--- count has a middle to take.
local ROUNDS: integer = 7

--- Seconds a calibrated round should take. Long enough that the clock's resolution is
--- not the measurement, short enough that seven of them are not a wait.
local TARGET_ROUND_SEC = 0.05

--- Iterations calibration will not exceed, so a body that is somehow free terminates.
local MAX_N = 1 << 30

----------------------------------------------------------------------------
-- The sink
----------------------------------------------------------------------------

--- Where `keep` stores. A field rather than an upvalue so the store crosses the module
--- boundary, which is what makes the value escape; see `keep`.
bench.__nuppSink = nil as any

--- Keeps a value the measured body produced, so the work that produced it survives.
---
--- This is the one rule writing a case requires. LuaJIT removes work whose result does
--- not escape its trace, which is correct and is also the most common way a benchmark
--- comes out impossibly fast: the loop under test is deleted and the measurement is of
--- nothing.
---
--- The store is to a field of this module, which is visible outside any trace and so
--- cannot be sunk. Nothing checks that this stays true of LuaJIT; a collapse in the
--- reported durations is the only signal, which is why it is worth reading them.
---
--- @param value whatever the measured body produced
function bench.keep(value: any): nil
    bench.__nuppSink = value
end

----------------------------------------------------------------------------
-- Records
----------------------------------------------------------------------------

--- One case handed to a measured body.
record bench.Case
    --- The case's name, as `case` was given it.
    name: string

    --- Iterations the body is to run. Fixed before the measured rounds begin, and
    --- carried in the record, so a comparison can re-run the same work.
    n: integer
end

--- What one measured case contributes to a record.
record bench.Measurement
    --- The case's name.
    name: string

    --- `case` or `frames`.
    kind: string

    --- Iterations per round, for a case.
    n: integer?

    --- Rounds timed, for a case.
    rounds: integer?

    --- The median round, in seconds. Recorded, never gated.
    medianSec: number?

    --- The fastest round, in seconds.
    minSec: number?

    --- Kilobytes one round allocated, read with the collector stopped. A size rather
    --- than a count of allocations, and recorded only.
    allocatedKb: number?

    --- Kilobytes still held once the collector has run again, which is what "retained"
    --- has to mean. An earlier spelling of this reported the number above and called it
    --- this one: with collection stopped for the rounds, the heap delta is what they
    --- allocated, not what survived them.
    retainedKb: number?

    --- Frame durations in milliseconds at the named quantiles.
    p50Ms: number?

    p99Ms: number?
    p999Ms: number?

    --- Frames recorded, and how many exceeded the budget.
    frames: integer?

    overBudget: integer?

    --- Abort site identities seen while measuring, each
    --- `severity|reason|location|zone`. Identities rather than counts: a count is
    --- partly a function of how much work ran, and a loop that started aborting is the
    --- finding at any count.
    ---
    --- Nil when no session could be opened, which is not the same as an empty set: one
    --- says nothing aborted and the other says nobody looked.
    abortSites: {string}?

    --- Abort events and blacklistings behind those sites. Recorded, never gated.
    totalAborts: integer?

    blacklisted: integer?
end

local measurements: {bench.Measurement} = {}
local traceProfileSeen: any = nil

--- Whether `report` has already written. A frame session reports itself, so a program
--- with both frames and cases would otherwise write twice and gate twice.
local reported = false

----------------------------------------------------------------------------
-- Program arguments
----------------------------------------------------------------------------

local options = {
    out = "build/bench-record.json",
    baseline = nil as string?,
    json = false,
    accept = false,
    quiet = false,

    --- Run only this case, or every case when nil. The runner names one per child,
    --- because a process is the measurement boundary: two cases sharing one share its
    --- heap, its compiled traces and its blacklist.
    only = nil as string?,

    --- Print the case names and measure nothing. How the runner learns what to spawn.
    list = false,

    --- Where a listing writes JSON strings, one per declared case. Nil keeps the
    --- human-facing `--list-cases` form on stdout.
    casesOut = nil as string?,

    --- Iterations selected by the set runner from this case's merged baseline.
    iterations = nil as integer?,
}

local function readOptions(): nil
    local argv = _G.arg as {string}?
    if not argv then
        return
    end
    local index: integer = 1
    while argv[index] do
        local entry = argv[index]
        local name, value = entry:match("^%-%-([%w%-]+)=(.*)$")
        if not name then
            name = entry:match("^%-%-([%w%-]+)$")
        end
        if name == "list-cases" then
            options.list = true
        elseif name == "cases-out" then
            options.casesOut = value or argv[index + 1]
            if not value then
                index = (index + 1) as integer
            end
        elseif name == "case" then
            options.only = value or argv[index + 1]
            if not value then
                index = (index + 1) as integer
            end
        elseif name == "json" then
            options.json = true
        elseif name == "quiet" then
            options.quiet = true
        elseif name == "accept" then
            options.accept = true
        elseif name == "out" then
            options.out = value or argv[index + 1] or options.out
            if not value then
                index = (index + 1) as integer
            end
        elseif name == "baseline" then
            options.baseline = value or argv[index + 1]
            if not value then
                index = (index + 1) as integer
            end
        elseif name == "n" then
            local given = tonumber(value or argv[index + 1])
            if not value then
                index = (index + 1) as integer
            end
            if not given or given < 1 or given ~= math.floor(given) then
                error("bench: --n needs a positive whole number", 0)
            end
            options.iterations = math.floor(given)
        end
        index = (index + 1) as integer
    end
end

readOptions()

----------------------------------------------------------------------------
-- Measuring
----------------------------------------------------------------------------

local function readFile(path: string): string?
    local handle = io.open(path, "r")
    if not handle then
        return nil
    end
    local content = handle:read("*a")
    handle:close()

    return content
end

--- The baseline, read once and remembered, or nil when there is none to read.
local baselineDocument: any = nil

local baselineRead = false

local function baseline(): any
    if baselineRead then
        return baselineDocument
    end
    baselineRead = true
    if not options.baseline then
        return nil
    end
    local text = readFile(options.baseline)
    if not text then
        return nil
    end
    local ok, decoded = pcall(json.decode, text)
    baselineDocument = ok and decoded or nil

    return baselineDocument
end

--- The iteration count a baseline recorded for this case, or nil for none.
---
--- Reused rather than recalibrated so that two records counted the same work. A
--- calibrated `n` is derived from a timing, so letting each run pick its own leaves the
--- durations describing different amounts of work and quietly not comparable.
local function baselineIterations(name: string): integer?
    local previous = baseline()
    for _, entry in ipairs(previous and previous.cases or {}) do
        if entry.name == name and entry.kind == "case" then
            return entry.n
        end
    end

    return nil
end

local function median(values: {number}): number
    local sorted: {number} = {}
    for index = 1, #values do
        sorted[index] = values[index]
    end
    table.sort(sorted)

    return sorted[math.ceil(#sorted / 2)]
end

local function smallest(values: {number}): number
    local best = values[1]
    for index = 2, #values do
        if values[index] < best then
            best = values[index]
        end
    end

    return best
end

--- Grows `n` until one round takes long enough to time. Timing-derived, and therefore
--- kept out of the measured phase: the chosen `n` is recorded and the measured rounds
--- all run at it, so a loaded machine cannot change how much work was counted.
---
--- A size is accepted only when it holds twice. The first round at any size also pays
--- for whatever the recorder had not compiled yet, so it times a program that no longer
--- exists by the time the measured rounds run -- which is how an uncalibrated version
--- of this settled on a million iterations that then took a third of the target.
local function calibrate(name: string, body: function(bench.Case): nil, fixed: integer?): integer
    if fixed and fixed > 0 then
        return fixed
    end
    local n: integer = 1
    local held = false
    while n < MAX_N do
        local started = os.clock()
        body(new bench.Case(name = name, n = n))
        if os.clock() - started >= TARGET_ROUND_SEC then
            if held then
                return n
            end
            held = true
        else
            held = false
            n = (n * 2) as integer
        end
    end

    return n
end

local function abortIdentities(report: any): ({string}, integer, integer)
    local sites: {string} = {}
    for _, site in ipairs(report.sites) do
        sites[
            #sites + 1
        ] = (
            "%s|%s|%s|%s"
        ):format(
            tostring(site.severity),
            tostring(site.reason),
            tostring(site.location or ""),
            tostring(site.zone or "")
        )
    end
    table.sort(sites)

    return sites, report.totalAborts, report.blacklisted
end

--- Says a case's name under `--list-cases`, as it is declared.
---
--- Printed here rather than collected and printed by `report`, because a listing run
--- must not depend on the program reaching a report call. A frame session that is
--- inert while listing returns before reporting, which is exactly the case that
--- silently listed nothing when this was deferred.
---
--- @raises when a requested case-list file cannot be opened
local function announce(name: string): nil
    if options.casesOut then
        local handle = io.open(options.casesOut, "a")
        if not handle then
            error("bench: cannot write " .. options.casesOut, 0)
        end
        handle:write(json.encode(name), "\n")
        handle:close()

        return
    end
    io.stdout:write(name, "\n")
end

--- Opens a trace session, or answers nil when one is already open.
---
--- `nupp run --jit-aborts` opens a process-wide session before the program starts, and
--- there is at most one at a time, so a case that insisted on its own would fail under
--- the flag most likely to be set while investigating one. Answering nil instead costs
--- the abort half of that case's record, which is then reported as uncollected rather
--- than as an empty set -- an empty set and an uncollected one gate very differently.
local function openTrace(): any?
    local ok, session = pcall(profile.trace)
    if not ok then
        return nil
    end

    return session
end

--- Measures one case and adds it to the record this program will report.
---
--- The body is handed the case and runs its own loop. Calling a one-iteration closure
--- `n` times instead would put a call boundary inside the measurement and change what
--- the recorder sees, so the loop belongs to the body.
---
--- @param name what to record the case as
--- @param body the work, which iterates `case.n` times
--- @param fixedN an explicit iteration count, skipping calibration
function bench.case(name: string, body: function(bench.Case): nil, fixedN: integer?): nil
    if options.list then
        announce(name)

        return
    end
    if options.only and options.only ~= name then
        return
    end

    -- Opened before calibration, not after it. A loop that aborts and is blacklisted
    -- while being calibrated has already been demoted to the interpreter by the time a
    -- later session opens, so a session opened after calibration reports nothing and
    -- the one finding that mattered is the one that got away.
    local session = openTrace()
    local n = calibrate(name, body, fixedN or options.iterations or baselineIterations(name))
    local subject = new bench.Case(name = name, n = n)
    body(subject)

    collectgarbage("collect")
    local before = collectgarbage("count")
    collectgarbage("stop")
    local times: {number} = {}
    for round = 1, ROUNDS do
        local started = time.now()
        body(subject)
        times[round] = (time.now() - started) / 1000.0
    end
    -- Collected before reading again, so what is reported is what the rounds kept
    -- rather than everything they allocated while the collector was off.
    local allocated = collectgarbage("count") - before
    collectgarbage("restart")
    collectgarbage("collect")
    local retained = collectgarbage("count") - before

    local sites: {string}? = nil
    local total: integer? = nil
    local blacklisted: integer? = nil
    if session then
        local aborts = session:stop()
        traceProfileSeen = aborts.traceProfile
        sites, total, blacklisted = abortIdentities(aborts)
    end
    measurements[
        #measurements + 1
    ] = new bench.Measurement(
        name = name,
        kind = "case",
        n = n,
        rounds = ROUNDS,
        medianSec = median(times),
        minSec = smallest(times),
        allocatedKb = allocated / ROUNDS,
        retainedKb = retained,
        abortSites = sites,
        totalAborts = total,
        blacklisted = blacklisted
    )
end

----------------------------------------------------------------------------
-- Frames
----------------------------------------------------------------------------

--- A running frame measurement, as `frames` returns it.
---
--- The application owns its loop, so this offers a condition and a report rather than
--- taking the loop over. There is no exit-time fallback: nothing hands this module a
--- callback when the chunk returns, collection before shutdown is not guaranteed, and
--- the compiler's entry point ends in `os.exit`. A session that is never reported
--- produces no record, and the runner says so.
record bench.FrameSession
    name: string
    budgetMs: number
    wanted: integer
    samples: {number}
    started: number
    session: any
    done: boolean
end

--- Opens a frame measurement.
---
--- Plain parameters rather than an options record, because a record would make the
--- ordinary call site write `new bench.FrameOptions(...)` -- a table literal is not
--- one, which is what the first spelling of this got wrong in its own documented
--- example.
---
--- @param name what to record the session as
--- @param budgetMs milliseconds a frame is allowed; frames over it are counted
--- @param count frames to record before `more` turns false, or nil to let the
---     application decide when to stop
function bench.frames(name: string, budgetMs: number?, count: integer?): bench.FrameSession
    -- A frame session is a case as far as the runner is concerned: it is named, it is
    -- listed, and it is selected one per process. A session that is being listed or is
    -- not the selected one is handed back already finished, so `more` is false and the
    -- application's loop does not run.
    if options.list then
        announce(name)
    end
    local inert = options.list or (options.only ~= nil and options.only ~= name)
    if inert then
        return new bench.FrameSession(
            name = name,
            budgetMs = budgetMs or 0.0,
            wanted = count or 0,
            samples = {},
            started = 0.0,
            session = nil,
            done = true
        )
    end

    return new bench.FrameSession(
        name = name,
        budgetMs = budgetMs or 0.0,
        wanted = count or 0,
        samples = {},
        started = 0.0,
        session = openTrace(),
        done = false
    )
end

--- Whether more frames are wanted. False once `count` frames have been recorded, and
--- always true when the session was opened without one.
function bench.FrameSession:more(): boolean
    if self.done then
        return false
    end
    if self.wanted <= 0 then
        return true
    end

    return #self.samples < self.wanted
end

--- Marks the start of a frame.
function bench.FrameSession:begin(): nil
    self.started = time.now()
end

--- Marks the end of a frame and records it.
---
--- Elapsed on the monotonic clock, not `os.clock`, which counts processor time. A frame
--- that waited on presentation, on I/O, or on a sleep spends very little of either and
--- blows its budget anyway, and missing the budget is the whole measurement.
function bench.FrameSession:finish(): nil
    self.samples[#self.samples + 1] = time.now() - self.started
end

local function quantile(sorted: {number}, fraction: number): number
    if #sorted == 0 then
        return 0.0
    end
    local rank = math.ceil(fraction * #sorted)
    if rank < 1 then
        rank = 1
    end
    if rank > #sorted then
        rank = #sorted
    end

    return sorted[rank]
end

--- Ends the session, records it, and reports.
---
--- A frame report is a distribution rather than a median: a budget missed one frame in
--- a hundred is a visible stutter and an unmoved mean.
---
--- This writes the record and applies the gate, which is why an application's loop
--- needs no second call. `bench.report` is idempotent, so a program with both cases and
--- frames may still call it itself.
---
--- @raises when a gated counter moved, or the record cannot be written
function bench.FrameSession:report(): nil
    if self.done then
        return
    end
    self.done = true
    local sites: {string}? = nil
    local total: integer? = nil
    local blacklisted: integer? = nil
    if self.session then
        local aborts = self.session:stop()
        traceProfileSeen = aborts.traceProfile
        sites, total, blacklisted = abortIdentities(aborts)
    end
    local sorted: {number} = {}
    for index = 1, #self.samples do
        sorted[index] = self.samples[index]
    end
    table.sort(sorted)
    local over: integer = 0
    if self.budgetMs > 0 then
        for index = 1, #sorted do
            if sorted[index] > self.budgetMs then
                over = (over + 1) as integer
            end
        end
    end

    measurements[
        #measurements + 1
    ] = new bench.Measurement(
        name = self.name,
        kind = "frames",
        p50Ms = quantile(sorted, 0.5),
        p99Ms = quantile(sorted, 0.99),
        p999Ms = quantile(sorted, 0.999),
        frames = #sorted,
        overBudget = over,
        abortSites = sites,
        totalAborts = total,
        blacklisted = blacklisted
    )
    bench.report()
end

----------------------------------------------------------------------------
-- Reporting
----------------------------------------------------------------------------

--- Reads the optimizer's account of this build, when `nupp run --remarks-out` wrote
--- one to the benchmark protocol's fixed `build/remarks.json` path.
---
--- Its absence is a result rather than a failure: a case run without one carries no
--- static counters and says so, and the gate then has only the dynamic half to work
--- with.
local function readRemarks(): any
    if not _G.__nuppRemarksAvailable then
        return nil
    end
    local content = readFile("build/remarks.json")
    if not content then
        return nil
    end
    local ok, decoded = pcall(json.decode, content)
    if not ok then
        return nil
    end

    return decoded
end

local function writeFile(path: string, content: string): nil
    local handle = io.open(path, "w")
    if not handle then
        error("bench: cannot write " .. path, 0)
    end
    handle:write(content)
    handle:close()
end

local function buildRecord(): any
    local remarks = readRemarks()
    local cases = {}
    for index = 1, #measurements do
        cases[index] = measurements[index]
    end

    return {
        schema = bench.SCHEMA,
        cases = cases,
        executionProfile = remarks and remarks.executionProfile or nil,
        remarks = remarks and remarks.remarks or nil,
        allocationSites = remarks and remarks.allocationSites or nil,
        traceProfile = traceProfileSeen,
        compiler = remarks and remarks.compiler or nil,
    }
end

--- Whether two execution profiles describe the same thing being measured.
---
--- The level and the excluded passes are part of what a benchmark is measuring rather
--- than a source of drift, so a record made at another one finds a different baseline
--- rather than a failing one.
local function sameExecution(left: any, right: any): boolean
    if left == nil or right == nil then
        return false
    end
    if left.optLevel ~= right.optLevel then
        return false
    end

    return (left.disabled or "") == (right.disabled or "")
end

--- Whether two trace profiles describe the same recorder.
---
--- Whether a loop aborts is a property of the architecture, operating system, recorder
--- features and LuaJIT revision that watched it, so abort sites are keyed by all of
--- them. `profile.TraceProfile.id` is already the composite of exactly those, so this
--- compares that rather than reassembling the parts -- and in particular rather than
--- comparing the feature list, which is a table and would compare by identity.
local function sameRecorder(left: any, right: any): boolean
    if left == nil or right == nil then
        return false
    end

    return left.id == right.id
end

--- The identities of the allocations the optimizer left standing, as the build
--- recorded them. A static account of this compiler's own output; see
--- `optimize.allocationSites` for what it does and does not say.
--- Counted per file rather than identified by position. An identity of file, line and
--- column makes inserting a comment above unchanged code look like every allocation
--- below it was newly introduced, which fails the gate for a change that allocated
--- nothing. A count moves when an allocation is added or removed and not when one is
--- moved, which is the question being asked.
local function allocationCounts(record: any): {[string]: integer}
    local counts: {[string]: integer} = {}
    for _, site in ipairs(record.allocationSites or {}) do
        local key = tostring(site.file) .. "|" .. tostring(site.kind)
        counts[key] = ((counts[key] or 0) + 1) as integer
    end

    return counts
end

--- The identities of the remarks the optimizer made, as the build recorded them.
local function remarkIdentities(record: any): {string}
    local entries: {string} = {}
    for _, entry in ipairs(record.remarks or {}) do
        local at = entry.range and entry.range.start or nil
        entries[
            #entries + 1
        ] = (
            "%s|%s|%s|%s"
        ):format(tostring(entry.code), tostring(entry.file), tostring(at and at.line or 0), tostring(entry.message))
    end
    table.sort(entries)

    return entries
end

local function listDifference(current: {string}, previous: {string}): {string}
    local seen: {[string]: boolean} = {}
    for _, entry in ipairs(previous) do
        seen[entry] = true
    end
    local added: {string} = {}
    for _, entry in ipairs(current) do
        if not seen[entry] then
            added[#added + 1] = entry
        end
    end

    return added
end

--- Compares one record against one baseline record and returns what moved.
---
--- Exported because the runner owns the baseline for a whole set and has to apply the
--- same rules a standalone case applies to its own. Two copies of these rules would
--- disagree, and the one that mattered would be whichever the reader was not looking
--- at.
---
--- @param record what this run measured
--- @param baseline the record to compare it against
--- @return the gated differences, which are failures
--- @return the differences that were only reported
---
--- A comparison with no comparable baseline is reported as exactly that. It is a
--- result, and a different one from a regression: the runner has to say which, or a
--- lost baseline reads like a pass.
function bench.compare(record: any, baseline: any): ({string}, {string})
    local failures: {string} = {}
    local uncompared: {string} = {}
    if not sameExecution(record.executionProfile, baseline.executionProfile) then
        uncompared[#uncompared + 1] = "execution profile differs; nothing is comparable"

        return failures, uncompared
    end
    local previous: {[string]: any} = {}
    for _, entry in ipairs(baseline.cases or {}) do
        previous[entry.name] = entry
    end
    -- Static counters are properties of the compiler's output, so they compare across
    -- hosts unchanged and are not keyed by the recorder below.
    local currentAllocations = allocationCounts(record)
    local previousAllocations = allocationCounts(baseline)
    local allocationKeys: {string} = {}
    for key in pairs(currentAllocations) do
        allocationKeys[#allocationKeys + 1] = key
    end
    table.sort(allocationKeys)
    for _, key in ipairs(allocationKeys) do
        local now = currentAllocations[key] or 0
        local was = previousAllocations[key] or 0
        if now > was then
            failures[#failures + 1] = ("allocations rose from %d to %d in %s"):format(was, now, key)
        end
    end
    -- Reported rather than gated. A remark carries no field saying whether the pass
    -- fired or declined, so a pass that started firing would add one remark and remove
    -- another, and gating the set would call that improvement a regression.
    local currentRemarks = remarkIdentities(record)
    local previousRemarks = remarkIdentities(baseline)
    for _, entry in ipairs(listDifference(currentRemarks, previousRemarks)) do
        uncompared[#uncompared + 1] = "remark appeared: " .. entry
    end
    for _, entry in ipairs(listDifference(previousRemarks, currentRemarks)) do
        uncompared[#uncompared + 1] = "remark went away: " .. entry
    end
    local recorderMatches = sameRecorder(record.traceProfile, baseline.traceProfile)
    for _, entry in ipairs(record.cases or {}) do
        local was = previous[entry.name]
        if not was then
            uncompared[#uncompared + 1] = entry.name .. ": no baseline"
        elseif not recorderMatches then
            uncompared[#uncompared + 1] = entry.name .. ": trace profile differs, abort sites not compared"
        else
            local added = listDifference(entry.abortSites or {}, was.abortSites or {})
            for _, site in ipairs(added) do
                failures[#failures + 1] = entry.name .. ": new trace abort site: " .. site
            end
        end
    end

    return failures, uncompared
end

--- Formats a record as the compact result table used by both a standalone program
--- and the set runner. The shape follows the useful part of JMH's final report, but
--- names the statistic `p50`: these scores are medians, not averages with confidence
--- intervals.
---
--- Case scores are normalized to one body iteration. The calibrated batch size stays
--- in the JSON record, where the runner also finds it for the next comparison.
function bench.format(record: any): string
    local rows: {any} = {}
    local width: integer = #"Benchmark"
    for _, entry in ipairs(record.cases or {}) do
        if entry.kind == "case" then
            local n = entry.n or 0
            local score = n > 0 and ((entry.medianSec or 0.0) * 1000000000.0 / n) or 0.0
            rows[
                #rows + 1
            ] = {
                name = entry.name,
                mode = "p50",
                count = tostring(entry.rounds or 0),
                score = ("%.3f"):format(score),
                units = "ns/op",
            }
        else
            local count = tostring(entry.frames or 0)
            rows[
                #rows + 1
            ] = {
                name = entry.name,
                mode = "p50",
                count = count,
                score = ("%.3f"):format(entry.p50Ms or 0.0),
                units = "ms/frame",
            }
            rows[
                #rows + 1
            ] = {
                name = entry.name,
                mode = "p99",
                count = count,
                score = ("%.3f"):format(entry.p99Ms or 0.0),
                units = "ms/frame",
            }
            rows[
                #rows + 1
            ] = {
                name = entry.name,
                mode = "p99.9",
                count = count,
                score = ("%.3f"):format(entry.p999Ms or 0.0),
                units = "ms/frame",
            }
            if (entry.overBudget or 0) > 0 then
                rows[
                    #rows + 1
                ] = {
                    name = entry.name .. ":over-budget",
                    mode = "count",
                    count = count,
                    score = tostring(entry.overBudget),
                    units = "frames",
                }
            end
        end
    end
    if #rows == 0 then
        return ""
    end
    for _, row in ipairs(rows) do
        if #row.name > width then
            width = #row.name
        end
    end
    local pattern = "%-" .. tostring(width) .. "s  %5s  %3s  %10s  %s"
    local lines = {pattern:format("Benchmark", "Mode", "Cnt", "Score", "Units")}
    for _, row in ipairs(rows) do
        lines[#lines + 1] = pattern:format(row.name, row.mode, row.count, row.score, row.units)
    end

    return "\n" .. table.concat(lines, "\n") .. "\n"
end

--- Writes the record, compares it against a baseline when one was named, and raises
--- when a gated counter moved.
---
--- The write happens first on purpose. A case that trips the gate is a case whose
--- record the runner has to merge, or the report says only that something failed.
---
--- Raising is how a status reaches the shell: a chunk's return value is discarded and
--- a run that did not raise exits zero. `os.exit` would also produce one and would
--- discard the run's own profile and trace-abort reports, which are written after the
--- chunk returns.
---
--- @raises when a gated counter moved, or the record cannot be written
function bench.report(): nil
    if options.list then
        return
    end
    if reported then
        return
    end
    reported = true
    local record = buildRecord()
    local encoded = json.encode(record)
    writeFile(options.out, encoded)
    if options.json then
        io.stdout:write(encoded, "\n")
    elseif not options.quiet then
        io.stdout:write(bench.format(record))
    end
    if not options.baseline then
        return
    end
    local baselineText = readFile(options.baseline)
    if not baselineText then
        if options.accept then
            writeFile(options.baseline, encoded)

            return
        end
        io.stderr:write("bench: no baseline at " .. options.baseline .. "\n")

        return
    end
    local failures, uncompared = bench.compare(record, json.decode(baselineText))
    for _, note in ipairs(uncompared) do
        io.stderr:write("bench: uncompared: " .. note .. "\n")
    end
    if options.accept then
        writeFile(options.baseline, encoded)

        return
    end
    if #failures > 0 then
        error("bench: " .. table.concat(failures, "\nbench: "), 0)
    end
end

export = bench
