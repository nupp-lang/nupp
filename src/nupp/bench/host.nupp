module nupp.bench.host

--- The host services of the prototype runtime, on its parking surface. The
--- runtime installs this module itself, as one builtin per function; these
--- bodies are the declaration only and never run there.

--- The file's text, or nil and the error.
--- @raises string when called outside the prototype runtime
export function readFile(path: string): (string?, string?)
    error("host service")
end

--- @raises string when called outside the prototype runtime
export function writeFile(path: string, text: string): (boolean?, string?)
    error("host service")
end

--- Parks the task for `ms` milliseconds.
--- @raises string when called outside the prototype runtime
export function sleep(ms: number): boolean
    error("host service")
end

--- Runs a command to completion: its exit code and standard output.
--- @raises string when called outside the prototype runtime
export function run(cmd: string, arg: string?): (number?, string?)
    error("host service")
end

--- @raises string when called outside the prototype runtime
export function listDir(path: string): ({string}?, string?)
    error("host service")
end

--- Seconds since the epoch; answers without parking.
--- @raises string when called outside the prototype runtime
export function now(): number
    error("host service")
end

--- @raises string when called outside the prototype runtime
export function getenv(name: string): string?
    error("host service")
end
