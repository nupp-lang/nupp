module nupp.derive

--[[
`nupp.derive` provides Debug and the runtime for closed derive recipes.
Package providers use the same recipe API.

```nupp
@derive(nupp.derive.Debug)
local record Point
    x: integer
    y: integer
end
local point = new Point(x = 1, y = 2)
print(point:debug())
```

See [derives.md](docs/reference/derives.md) for providers and generated members.
]]

local derive = {}

record derive.Entry
    key: string?
    mt: any
    schema: {
        data: {[string]: any},
        [string]: any
    }
end

local entryKey: table = {}
local derivedByType: any = setmetatable({}, {__mode = "kv"})
-- LuaJIT owns interned ctypes and their metatables. Record entries instead live
-- on the declaration so a temporary record and its recipes can be collected.
local ctypes: any = setmetatable({}, {__mode = "k"})

local function register(key: string, mt: any, schema: any): any
    local entry = {key = key, mt = mt, schema = schema}
    if type(mt) == "table" then
        rawset(mt, entryKey, entry)
    else
        ctypes[mt] = entry
    end
    derivedByType[mt] = entry

    return entry
end

--- Reads the recipe registered for a declaration witness.
--- @internal
function derive.entry(typeObject: any): derive.Entry?
    return derivedByType[typeObject] or ctypes[typeObject]
end

--- Visits loaded declaration recipes without allocating a registry snapshot.
--- @internal
function derive.forEach(callback: function(entry: derive.Entry): nil): nil
    for _, entry in pairs(derivedByType) do
        callback(entry)
    end
end

--- Reads the declaration initializer requested by a derive provider.
--- @internal
function derive.initializer(typeObject: any): any
    local entry = derive.entry(typeObject)
    local name = entry and entry.schema and entry.schema.initializer or nil
    if entry == nil or type(name) ~= "string" then
        return nil
    end

    return entry.mt[name]
end

--- Renders a declaration through its Debug binding.
--- @param target the declaration witness
--- @param value the borrowed value to render
function derive.debug(target: unknown, borrows value: unknown): string
    local rendering = require("nupp.serde.debug")
    return rendering.derived(target as Type<unknown>, value)
end

--- Installs the runtime called by generated derive members.
--- @param namespace the program's `nupp` table
function derive.install(namespace: any): nil
    local runtime = rawget(namespace, "__derive")
    if runtime == nil then
        runtime = {}
        rawset(namespace, "__derive", runtime)
    end
    runtime.register = register
    runtime.entry = derive.entry
    runtime.debug = derive.debug
end

@comptime
local function option(items, annotationName: string, name: string): any
    for _, item in ipairs(items) do
        if item.name == annotationName then
            for index, argument in ipairs(item.arguments) do
                if argument.name == name or name == "value" and index == 1 then
                    return argument.value
                end
            end
        end
    end

    return nil
end

@comptime
local function detail(T: type): any
    local value = nupp.types.describe(T)
    if value.sourceKind then
        local normalized = {}
        for key, item in pairs(value) do
            normalized[key] = item
        end
        normalized.kind = value.sourceKind
        return normalized
    end

    return value
end

@comptime
local function Optional(T: type): type?
    local value = detail(T)
    if value.kind ~= "union" then
        return nil
    end
    local rest = {}
    for _, member in ipairs(value.members or {}) do
        local memberDetail = detail(member)
        if not (memberDetail.kind == "primitive" and memberDetail.name == "nil") then
            rest[#rest + 1] = member
        end
    end
    if #rest == 1 then
        return rest[1]
    end

    return nil
end

@comptime
local function debugSpec(T: type, contract: type): any
    local inner = Optional(T)
    if inner ~= nil then
        return {kind = "optional", value = debugSpec(inner, contract)}
    end
    local value = detail(T)
    if value.kind == "literal" then
        return {kind = "literal", value = value.value}
    end
    if value.kind == "primitive" then
        if value.name == "nil"
            or value.name == "boolean"
            or value.name == "string"
            or value.name == "number"
            or value.name == "integer"
            or value.name == "float"
            or value.name:find("int", 1, true)
            or value.name:find("uint", 1, true)
        then
            return {kind = value.name}
        end
    elseif value.kind == "array" then
        return {kind = "array", value = debugSpec(value.element, contract)}
    elseif value.kind == "map" then
        return {kind = "map", key = debugSpec(value.readKey, contract), value = debugSpec(value.readValue, contract)}
    elseif value.kind == "tuple" then
        local items = {}
        for index, member in ipairs(value.members or {}) do
            items[index] = debugSpec(member, contract)
        end
        return {kind = "tuple", items = items}
    elseif value.kind == "shape" then
        local fields = {}
        for index, field in ipairs(value.fields or {}) do
            local fieldType = field.read
            if fieldType == nil then
                fieldType = field.write
            end
            fields[index] = {name = field.name, type = debugSpec(fieldType, contract)}
        end
        return {kind = "shape", fields = fields}
    elseif value.kind == "reference" and value.nominal then
        if value.nominal.deriveKey and nupp.derive.claims(T, contract) then
            return {kind = "record", typeKey = value.nominal.deriveKey}
        elseif nupp.derive.claims(T, contract) then
            return {kind = "customDebug"}
        end
    end

    return nil
end

@comptime
function derive.Debug(info: nupp.derive.Info): nupp.derive.Result<nupp.Debug>
    if info.kind ~= "record" and info.kind ~= "struct" then
        return nupp.derive.error("Debug can be derived only for records or structs", info.reference, "NUPP2803")
    end
    for _, field in ipairs(info.fields) do
        local skip = option(field.annotations, "debug", "skip") == true
        local redact = option(field.annotations, "debug", "redact") == true
        if skip and redact then
            return nupp.derive.error(
                "field " .. field.name .. " cannot be both skipped and redacted",
                field.reference,
                "NUPP2803"
            )
        end
        if field.name ~= "debug" and not skip and not redact and not debugSpec(field.readType, info.interfaceType) then
            return nupp.derive.error("field type cannot be formatted by Debug", field.reference, "NUPP2803")
        end
    end

    return nupp.derive.implement{
        methods = {
            debug = nupp.derive.forward{
                helper = nupp.derive.helper(derive, "debug"),
                arguments = {nupp.derive.witness(info.ownerType), nupp.derive.receiver()},
            }
        },
    }
end

export = derive
