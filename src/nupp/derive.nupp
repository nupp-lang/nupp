@!internal

--[[
The private declaration registry and runtime helpers used by derive recipes.
]]
module nupp.derive

local derive = {}

record derive.Entry
    key: string?
    mt: any
    schema: {
        data: {[string]: any},
        [string]: any
    }
end

local entryKey: table = {}
local derivedByType: any = setmetatable({}, {__mode = "kv"})
-- LuaJIT owns interned ctypes and their metatables. Record entries instead live
-- on the declaration so a temporary record and its recipes can be collected.
local ctypes: any = setmetatable({}, {__mode = "k"})

local function register(key: string, mt: any, schema: any): any
    local entry = {key = key, mt = mt, schema = schema}
    if type(mt) == "table" then
        rawset(mt, entryKey, entry)
    else
        ctypes[mt] = entry
    end
    derivedByType[mt] = entry

    return entry
end

--- Reads the recipe registered for a declaration witness.
--- @internal
function derive.entry(typeObject: any): derive.Entry?
    return derivedByType[typeObject] or ctypes[typeObject]
end

--- Visits loaded declaration recipes without allocating a registry snapshot.
--- @internal
function derive.forEach(callback: function(entry: derive.Entry): nil): nil
    for _, entry in pairs(derivedByType) do
        callback(entry)
    end
end

--- Reads the declaration initializer requested by a derive provider.
--- @internal
function derive.initializer(typeObject: any): any
    local entry = derive.entry(typeObject)
    local name = entry and entry.schema and entry.schema.initializer or nil
    if entry == nil or type(name) ~= "string" then
        return nil
    end

    return entry.mt[name]
end

--- Renders a declaration through its Debug binding.
--- @param target the declaration witness
--- @param value the borrowed value to render
function derive.debug(target: unknown, borrows value: unknown): string
    local rendering = require("serde.debug")
    return rendering.derived(target as Type<unknown>, value)
end

--- Installs the runtime called by generated derive members.
--- @param namespace the program's `nupp` table
function derive.install(namespace: any): nil
    local runtime = rawget(namespace, "__derive")
    if runtime == nil then
        runtime = {}
        rawset(namespace, "__derive", runtime)
    end
    runtime.register = register
    runtime.entry = derive.entry
    runtime.debug = derive.debug
end

export = derive
