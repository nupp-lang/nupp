module nupp.codec.json.internal.builder

--[[
The value-stream entry points only the JSON decoder uses.

These sit beside the fused decoder rather than in
[](nupp.codec.valuebuilder), whose byte readers, scratch buffers and stream
events stay public for any codec: a pull or serde selection shape, the escape
positions a structural scan retained, and JSON's number grammar mean nothing
to another format. They lower the same way inside `@aot`, and each works on a
stream or scratch buffer that `nupp.codec.valuebuilder` made.
]]
const valuebuilder = require("nupp.codec.valuebuilder")

local stream = {}

--- Starts a bounded stream that materializes only one JSON pull shape.
---
--- This is an internal AOT boundary. The native builder still observes every
--- parsed token so skipped subtrees are validated, but it allocates values only
--- where `shape` selects them. `arrayShapeMarker` is the private key used by the
--- JSON provider's [](nupp.codec.json.arrayOf) shapes.
--- @raises string outside an AOT-compiled function
function stream.newPull(
    nullValue: any,
    maxDepth: uint32,
    stringCapacity: uint32,
    arrayMarker: any,
    objectMarker: any,
    shape: any,
    arrayShapeMarker: any,
    serdeMarkers: any
): any
    error("newPull exists only inside an @aot function", 2)
end

--- Starts the schema-specialized form of a bounded native value stream.
---
--- This has the same source contract as [](nupp.codec.json.internal.builder.newPull),
--- but its distinct intrinsic identity lets AOT erase pull-only dispatch and emit serde
--- stage two independently.
--- @raises string outside an AOT-compiled function
function stream.newSerde(
    nullValue: any,
    maxDepth: uint32,
    stringCapacity: uint32,
    arrayMarker: any,
    objectMarker: any,
    shape: any,
    arrayShapeMarker: any,
    serdeMarkers: any
): any
    error("newSerde exists only inside an @aot function", 2)
end

--- Publishes an escaped source slice using backslash positions retained by
--- the structural scan. Internal to AOT JSON stage two.
--- @raises string outside an AOT-compiled function
function stream.stringEscapes(
    builder: any,
    borrows source: any,
    start: uint32,
    length: uint32,
    escapes: any,
    escapeStart: uint32,
    escapeCount: uint32
): nil
    error("stringEscapes exists only inside an @aot function", 2)
end

--- Selects an escaped object key using retained backslash positions. Internal
--- to AOT JSON stage two.
--- @raises string outside an AOT-compiled function
function stream.keyEscapes(
    builder: any,
    borrows source: any,
    start: uint32,
    length: uint32,
    escapes: any,
    escapeStart: uint32,
    escapeCount: uint32
): nil
    error("keyEscapes exists only inside an @aot function", 2)
end

--- Parses and publishes one JSON number without returning to source-level
--- byte loops. The low 31 bits are the stopping position; bit 31 says whether
--- the token was valid. A token whose value is not finite is invalid, and its
--- stopping position is its own first byte. This is an AOT lowering boundary,
--- not a portable parser API.
---
--- The ordinary body below is the executable semantics of that boundary, not an
--- API anything outside a codec should reach for. It exists because an `@aot`
--- function must return the same values when its artifact is absent, and
--- without it the one decoder that calls this could not run under `aot = "off"`
--- at all -- which is also how it is differentially tested.
--- @param builder a direct value stream
--- @param source the rooted source bytes
--- @param start the number's zero-based first byte
--- @param limit the exclusive source byte limit
--- @return packed success and stopping position
function stream.numberToken(builder: any, borrows source: any, start: uint32, limit: uint32): uint32
    local text = source as string
    local at = start as integer
    if limit > #text or limit >= 2147483648 or start >= limit then
        return nupp.math.u32.wrap(start + 1)
    end

    -- JSON's grammar, in the order it is written: an optional minus, an
    -- integer part that is either one zero or a digit run not starting with
    -- one, an optional fraction of at least one digit, and an optional
    -- exponent of at least one digit after its optional sign.
    local function digits(): integer
        local first = at
        while at < limit and text:byte(at + 1) >= 48 and text:byte(at + 1) <= 57 do
            at = at + 1
        end

        return at - first
    end

    if at < limit and text:byte(at + 1) == 45 then
        at = at + 1
    end
    if at >= limit then
        return nupp.math.u32.wrap(at + 1)
    end
    local lead = text:byte(at + 1)
    if lead == 48 then
        at = at + 1
        if at < limit and text:byte(at + 1) >= 48 and text:byte(at + 1) <= 57 then
            return nupp.math.u32.wrap(at + 1)
        end
    elseif lead >= 49 and lead <= 57 then
        digits()
    else
        return nupp.math.u32.wrap(at + 1)
    end
    if at < limit and text:byte(at + 1) == 46 then
        at = at + 1
        if digits() == 0 then
            return nupp.math.u32.wrap(at + 1)
        end
    end
    if at < limit and (text:byte(at + 1) == 101 or text:byte(at + 1) == 69) then
        at = at + 1
        if at < limit and (text:byte(at + 1) == 43 or text:byte(at + 1) == 45) then
            at = at + 1
        end
        if digits() == 0 then
            return nupp.math.u32.wrap(at + 1)
        end
    end

    local value = tonumber(text:sub(start + 1, at))
    if value == nil then
        return nupp.math.u32.wrap(at + 1)
    end
    -- A token too large for binary64 is refused at its first byte rather than
    -- read as an infinity no encoder writes back. Underflow to zero stands.
    if value == math.huge or value == -math.huge then
        return nupp.math.u32.wrap(start + 1)
    end
    valuebuilder.number(builder, value)

    return nupp.math.u32.wrap(at + 2147483648)
end

--- Reads a retained escape position in source order.
--- @raises string outside an AOT-compiled function
function stream.scratchEscapeWord(scratch: any, index: uint32): uint32
    error("scratchEscapeWord exists only inside an @aot function", 2)
end

--- Returns how many escape positions the structural scan retained.
--- @raises string outside an AOT-compiled function
function stream.scratchEscapeLength(scratch: any): uint32
    error("scratchEscapeLength exists only inside an @aot function", 2)
end

export = stream
