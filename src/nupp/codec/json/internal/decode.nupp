module nupp.codec.json.internal.decode

local _fused = require("nupp.codec.json.internal.decoder.fused")

export const OK = 0
export const SYNTAX = 1
export const INVALID_UTF8 = 2
export const INVALID_CONTROL = 3
export const INVALID_BACKSLASH = 4
export const TAPE = 5

--- Parses a structurally indexed document directly into ordinary Lua values.
---
--- The body lives in `nupp.codec.json.internal.decoder.fused`, monomorphized
--- over the pull builder.
--- @raises string when the native builder cannot be loaded, value allocation
--- fails, or the builder rejects a malformed escaped string
export const decode = _fused.decodePull as function(
    string,
    unknown,
    unknown?,
    unknown?,
    unknown?,
    unknown?,
    unknown?
): (unknown, uint32, uint32)
