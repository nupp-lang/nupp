module nupp.codec.json.internal.decoder.fused

--[[
The one fused JSON decoder, monomorphized per builder.

The structural scan and the tape walk are identical across the pull, serde,
and eager decoders; only the builder constructor varies. `Variant` carries
that choice as a const binder: each exported entry closes it with a literal,
so ahead-of-time compilation emits one specialized native body per variant,
with the untaken variants' constructs pruned before lowering classifies the
entry.

The scan is the vector/bitmask algebra `bench/simd-json/src/simd_json/indexer.nupp`
is written in. One vector of bytes at a time, every byte the scan has to act
on -- a quote, a backslash, a control byte or one of the six structural
characters -- is found by comparisons whose masks are or'd together and read
out as one word of lane bits. The bits are drained in position order, lowest
first, and each event byte is fed to a byte-at-a-time state machine that
keeps string state and backslash parity. Bytes that are not events are never
touched by the drain, which is where the vectors earn their place.

UTF-8 is validated in the same vectors rather than in the drain, by the
lookup4 validator `bench/utf8simd/src/utf8simd.nupp` spells on the general
algebra and simdjson runs: every byte's verdict depends on itself and the
three before it, so the two nibbles of the previous byte and the high nibble
of this one index three tables of error-class bit sets, and the pair is
malformed exactly when the three sets share a class. The third and fourth
bytes of a scalar are the one case a pair cannot see, so those are checked
against the bytes two and three back and folded in with an xor. A vector with
no non-ASCII byte, after another such vector, skips the lookup entirely.

That is why a non-ASCII byte is not an event. It was one only so the drain
could validate it, and a document that is forty percent non-ASCII therefore
drained forty percent of its bytes; nothing above the validator needs to see
it, because a non-ASCII byte outside a string is refused by the tape walk
below as the syntax error it is, and one inside a string is only bytes.

Whatever the vectors do not cover -- the partial vector past the last whole
one, and every byte on a target without vectors -- the same loop finishes one
at a time, so the drain is written once and events are processed in byte
order across both. There the drain does validate UTF-8, from an owed
continuation count and a first-continuation constraint seeded at the hand-off
by looking back over the at most three bytes of a scalar the last whole
vector could not finish. Either way the first error in the input is the one
reported, at the one-based position of the byte that raised it.

The loads and the nibble lookups are the byte-specialized operations left,
and they are left because the general `Species.load` reads a
`nupp.mem.span.Span` and `Vector.swizzle` reads a `Vector`, neither of which
a value-building AOT entry can take as a parameter or make from the string it
already roots. `loadString` and `lookup16` are the VM-aware counterparts that
can, and they serve a `Buffer` source on the same terms.
]]

local _valueBuilder = require("nupp.codec.valuebuilder")
local _simd = require("nupp.simd")
local _preferredU8 = _simd.preferredU8
local {type Buffer} = require("nupp.text")

local fused = {}

-- Variant 0 selects [](nupp.codec.valuebuilder.newPull): every token
-- observed, values allocated only where the pull shape selects them.
-- Variant 1 selects [](nupp.codec.valuebuilder.newSerde), the
-- schema-specialized stream, whose entry also reads buffers. Variant 2
-- selects [](nupp.codec.valuebuilder.newSized), the eager builder that
-- materializes the whole document. Written as literals because switch case
-- patterns and the AOT prune both want the number itself.

--- Parses a structurally indexed document directly into ordinary Lua values.
---
--- @raises when the native builder cannot be loaded, value allocation fails,
--- or the builder rejects a malformed escaped string
@aot
local function decodeFused<const Variant: integer>(
    borrows source: string | Buffer,
    variant: Variant,
    nullValue: any,
    arrayMarker: any?,
    objectMarker: any?,
    shape: any?,
    arrayShapeMarker: any?,
    serdeMarkers: any?
): (any, uint32, uint32)
    local sourceCount = _valueBuilder.length(source)
    if sourceCount > 0x7FFFFFFF then
        return nullValue, 5, 1
    end

    local tape = _valueBuilder.newWordScratch(sourceCount)
    local scanCursor: uint32 = 0
    local tapeCount: uint32 = 0
    local inString = false
    local stringEscaped = false

    -- Backslash parity. A byte is escaped when the run of backslashes ending
    -- immediately before it has odd length, which one remembered position and
    -- one parity bit answer without walking the run.
    local slashOdd = false
    local haveSlash = false
    local lastSlash: uint32 = 0

    -- UTF-8 carry for the tail. Constraint on the next continuation byte:
    -- 1 is A0..BF, 2 is 80..9F, 3 is 90..BF, 4 is 80..8F. The vectors do not
    -- use it; `seeded` marks the hand-off that gives it to the tail.
    local owed: uint32 = 0
    local constraint: uint32 = 0
    local haveNonAscii = false
    local lastNonAscii: uint32 = 0
    local seeded = false

    local species = _preferredU8()
    local lanes: uint32 = nupp.math.u32.wrap(species.lanes)

    -- The lookup4 error classes, from simdjson's `utf8_lookup4`. `byte1High`
    -- is indexed by the previous byte's high nibble, `byte1Low` by its low
    -- nibble and `byte2High` by this byte's high nibble; each entry is the set
    -- of error classes that nibble is compatible with.
    local byte1High = _simd.tableU8x16(2, 2, 2, 2, 2, 2, 2, 2, 128, 128, 128, 128, 33, 1, 21, 73)
    local byte1Low = _simd.tableU8x16(231, 163, 131, 131, 139, 203, 203, 203, 203, 203, 203, 203, 203, 219, 203, 203)
    local byte2High = _simd.tableU8x16(1, 1, 1, 1, 1, 1, 1, 1, 230, 174, 186, 186, 1, 1, 1, 1)
    local zeroBytes = species:splat(0)
    local nibbleMask = species:splat(15)
    local continuationFlag = species:splat(128)
    local previous = zeroBytes
    local previousNonAscii = false

    -- Set when the lookup has seen a malformed pair. The scan then finishes a
    -- byte at a time so the drain can name the first bad byte exactly.
    local vectorsOff = false

    -- One turn of this loop is a whole vector while one fits, then the
    -- hand-off that seeds the tail's UTF-8 state, then one byte at a time.
    -- The loop is entered once more than the source is long so a source
    -- ending exactly on a vector boundary still reaches the hand-off, which
    -- is what tells it about a scalar the last vector left unfinished.
    while scanCursor < sourceCount or not seeded do
        local events: uint32 = 0
        local width: uint32 = 0
        if not vectorsOff and nupp.math.u32.add(scanCursor, lanes) <= sourceCount then
            local block = species:loadString(source, scanCursor)
            local structural = block:equal(123):orBits(block:equal(125)):orBits(block:equal(91)):orBits(block:equal(93))
            local separators = block:equal(58):orBits(block:equal(44))
            local strings = block:equal(34):orBits(block:equal(92))
            events = structural:orBits(separators):orBits(strings):orBits(block:inRange(0, 31)):bits()

            -- The lookup only has to run where a non-ASCII byte is in reach of
            -- it. A vector of ASCII after a vector of ASCII cannot be
            -- malformed, and one after a non-ASCII vector is classified so the
            -- pairs straddling the boundary are seen.
            local currentNonAscii = block:inRange(128, 255):any()
            if currentNonAscii or previousNonAscii then
                local previous1 = _simd.alignBytes(previous, block, 1)
                local previous2 = _simd.alignBytes(previous, block, 2)
                local previous3 = _simd.alignBytes(previous, block, 3)
                local special = previous1:shiftRight(4)
                    :lookup16(byte1High)
                    :andBits(previous1:andBits(nibbleMask):lookup16(byte1Low))
                    :andBits(block:shiftRight(4):lookup16(byte2High))
                -- A byte two back at or above E0, or three back at or above
                -- F0, says this byte must be a third or fourth continuation.
                -- The tables answer the carry class 0x80 for a continuation
                -- after a continuation, so the xor is zero when both agree.
                local mustContinue = previous2:inRange(224, 255):orBits(previous3:inRange(240, 255))
                local required = mustContinue:select(continuationFlag, zeroBytes)
                if required:xorBits(special):equal(0):notBits():any() then
                    -- The lookup names the pair that is malformed, which for
                    -- an overlong or out-of-range form is its continuation
                    -- rather than its lead. Which byte is the first bad one is
                    -- the drain's answer, and the drain is what runs from here
                    -- on: this is the path that is about to return an error,
                    -- so it can afford to be told a byte at a time.
                    vectorsOff = true
                end
            end
            if not vectorsOff then
                previous = block
                previousNonAscii = currentNonAscii
                width = lanes
            else
                events = 0
            end
        elseif not seeded then
            -- The hand-off. Everything before here is validated, so the only
            -- thing the tail has to be told is how many continuations a
            -- scalar begun in the last vector still owes. A scalar is at most
            -- four bytes, so that is answered by walking back over at most
            -- three continuation bytes to the lead that started them.
            seeded = true
            local back: uint32 = 1
            local walking = true
            while walking and back <= 3 and back <= scanCursor do
                local earlier: uint32 = _valueBuilder.byte(source, nupp.math.u32.sub(scanCursor, back))
                if earlier < 128 then
                    walking = false
                elseif earlier >= 192 then
                    -- A lead the lookup could not judge, because what makes
                    -- C0, C1 and F5..FF wrong is the byte after them and that
                    -- byte is past the last whole vector.
                    if earlier < 194 or earlier > 244 then
                        return nullValue, 2, nupp.math.u32.add(nupp.math.u32.sub(scanCursor, back), 1)
                    end
                    local need: uint32 = 3
                    if earlier <= 223 then
                        need = 1
                    elseif earlier <= 239 then
                        need = 2
                    end
                    if need >= back then
                        owed = nupp.math.u32.add(nupp.math.u32.sub(need, back), 1)
                        haveNonAscii = true
                        lastNonAscii = nupp.math.u32.sub(scanCursor, 1)
                        -- The constraint binds the first continuation, which
                        -- is already behind us unless the lead is.
                        if back == 1 then
                            if earlier == 224 then
                                constraint = 1
                            elseif earlier == 237 then
                                constraint = 2
                            elseif earlier == 240 then
                                constraint = 3
                            elseif earlier == 244 then
                                constraint = 4
                            end
                        end
                    end
                    walking = false
                else
                    back = nupp.math.u32.add(back, 1)
                end
            end
        else
            -- A byte at a time past the last whole vector, and everywhere on
            -- a target without vectors. Here a non-ASCII byte is an event,
            -- because here the drain is what validates it.
            if scanCursor < sourceCount then
                local byte: uint32 = _valueBuilder.byteAt(source, scanCursor)
                if byte == 34
                    or byte == 92
                    or byte < 32
                    or byte == 123
                    or byte == 125
                    or byte == 91
                    or byte == 93
                    or byte == 58
                    or byte == 44
                    or byte >= 128
                then
                    events = 1
                end
            end
            width = 1
        end

        while events ~= 0 do
            local lane: uint32 = nupp.math.u32.trailingZeros(events)
            events = nupp.math.u32.andBits(events, nupp.math.u32.sub(events, 1))
            local position: uint32 = nupp.math.u32.add(scanCursor, lane)
            if position < sourceCount then
                local byte: uint32 = _valueBuilder.byteAt(source, position)
                -- A scalar left unfinished by the last non-ASCII byte must be
                -- continued by the very next byte; an event anywhere later
                -- means that byte was not a continuation.
                if owed ~= 0 and (not haveNonAscii or position ~= nupp.math.u32.add(lastNonAscii, 1)) then
                    return nullValue, 2, nupp.math.u32.add(lastNonAscii, 2)
                end
                if byte >= 128 then
                    local isContinuation = byte <= 191
                    if owed ~= 0 then
                        if not isContinuation then
                            return nullValue, 2, nupp.math.u32.add(position, 1)
                        end
                        local constrained = constraint == 1
                            and byte < 160
                            or constraint == 2
                            and byte > 159
                            or constraint == 3
                            and byte < 144
                            or constraint == 4
                            and byte > 143
                        if constrained then
                            return nullValue, 2, nupp.math.u32.add(position, 1)
                        end
                        owed = nupp.math.u32.sub(owed, 1)
                        constraint = 0
                    elseif isContinuation or byte < 194 or byte > 244 then
                        return nullValue, 2, nupp.math.u32.add(position, 1)
                    elseif byte <= 223 then
                        owed = 1
                    elseif byte <= 239 then
                        owed = 2
                        if byte == 224 then
                            constraint = 1
                        elseif byte == 237 then
                            constraint = 2
                        end
                    else
                        owed = 3
                        if byte == 240 then
                            constraint = 3
                        elseif byte == 244 then
                            constraint = 4
                        end
                    end
                    haveNonAscii = true
                    lastNonAscii = position
                    haveSlash = false
                    slashOdd = false
                elseif owed ~= 0 then
                    -- The continuation this byte had to be is ASCII.
                    return nullValue, 2, nupp.math.u32.add(position, 1)
                elseif byte == 92 then
                    if not inString then
                        return nullValue, 4, nupp.math.u32.add(position, 1)
                    end
                    if haveSlash and position == nupp.math.u32.add(lastSlash, 1) then
                        slashOdd = not slashOdd
                    else
                        slashOdd = true
                    end
                    haveSlash = true
                    lastSlash = position
                    stringEscaped = true
                else
                    local escaped = haveSlash and position == nupp.math.u32.add(lastSlash, 1) and slashOdd
                    if byte == 34 and not escaped then
                        -- An opening quote joins the tape bare; the closing
                        -- one carries whether the string it ends held a
                        -- backslash, which is all stage two asks of it.
                        if inString then
                            local word: uint32 = position
                            if stringEscaped then
                                word = nupp.math.u32.orBits(position, 0x80000000)
                            end
                            _valueBuilder.setScratchWord(tape, tapeCount, word)
                            inString = false
                        else
                            _valueBuilder.setScratchWord(tape, tapeCount, position)
                            inString = true
                            stringEscaped = false
                        end
                        tapeCount = nupp.math.u32.add(tapeCount, 1)
                    elseif byte < 32 then
                        local whitespace = byte == 9 or byte == 10 or byte == 13
                        if inString or not whitespace then
                            return nullValue, 3, nupp.math.u32.add(position, 1)
                        end
                    elseif not inString then
                        -- Every remaining event byte outside a string is one
                        -- of the six structural characters.
                        _valueBuilder.setScratchWord(tape, tapeCount, position)
                        tapeCount = nupp.math.u32.add(tapeCount, 1)
                    end
                    haveSlash = false
                    slashOdd = false
                end
            end
        end

        scanCursor = nupp.math.u32.add(scanCursor, width)
    end

    if owed ~= 0 then
        -- A scalar the end of the input cut off is raised one past the last
        -- byte, which is where its missing continuation would have been.
        return nullValue, 2, nupp.math.u32.add(lastNonAscii, 2)
    end

    local builderDepth: uint32 = 1024
    if sourceCount <= 32 then
        builderDepth = 16
    end
    local values = switch variant as integer do
        case 0 -> _valueBuilder.newPull(
            nullValue,
            builderDepth,
            sourceCount,
            arrayMarker,
            objectMarker,
            shape,
            arrayShapeMarker,
            serdeMarkers
        )
        case 1 -> _valueBuilder.newSerde(
            nullValue,
            builderDepth,
            sourceCount,
            arrayMarker,
            objectMarker,
            shape,
            arrayShapeMarker,
            serdeMarkers
        )
        else -> _valueBuilder.newSized(nullValue, builderDepth, sourceCount, arrayMarker, objectMarker)
    end
    local cursor: uint32 = 0
    tapeCount = _valueBuilder.scratchLength(tape)
    local tapeCursor: uint32 = 0
    local needValue = true
    local done = false

    -- The byte that ended the whitespace run is the byte the next step
    -- classifies, at the same cursor. Reading it once and carrying it out
    -- saves a bounds-checked load per token, on a loop that runs once per
    -- token in the document.
    local pending: uint32 = 0
    while not done do
        local skipping = true
        pending = 0
        while skipping and cursor < sourceCount do
            pending = _valueBuilder.byteAt(source, cursor)
            if pending == 32 or pending == 9 or pending == 10 or pending == 13 then
                cursor = nupp.math.u32.add(cursor, 1)
            else
                skipping = false
            end
        end

        if needValue then
            if cursor >= sourceCount then
                return nullValue, 1, nupp.math.u32.add(cursor, 1)
            end

            local tag: uint32 = 0
            local start: uint32 = cursor
            local length: uint32 = 0
            local flags: uint32 = 0
            local containerCapacity: uint32 = 0
            local byte: uint32 = pending

            if byte == 34 then
                tag = 4
                if tapeCursor < tapeCount then
                    local opening = _valueBuilder.scratchWord(tape, tapeCursor)
                    if opening ~= cursor then
                        return nullValue, 5, nupp.math.u32.add(cursor, 1)
                    end
                    tapeCursor = nupp.math.u32.add(tapeCursor, 1)
                else
                    return nullValue, 5, nupp.math.u32.add(cursor, 1)
                end
                if tapeCursor < tapeCount then
                    local closingWord = _valueBuilder.scratchWord(tape, tapeCursor)
                    local closing = nupp.math.u32.andBits(closingWord, 0x7FFFFFFF)
                    if nupp.math.u32.andBits(closingWord, 0x80000000) ~= 0 then
                        flags = 1
                    end
                    start = nupp.math.u32.add(cursor, 1)
                    length = nupp.math.u32.sub(closing, start)
                    -- The builder validates escapes while transforming them.
                    -- Walking this slice here as well would validate every
                    -- escaped value twice before publishing the same string.
                    cursor = nupp.math.u32.add(closing, 1)
                    tapeCursor = nupp.math.u32.add(tapeCursor, 1)
                else
                    return nullValue, 1, nupp.math.u32.add(cursor, 1)
                end
            elseif byte == 91 or byte == 123 then
                if byte == 91 then
                    tag = 5
                else
                    tag = 6
                end
                cursor = nupp.math.u32.add(cursor, 1)
                if tapeCursor < tapeCount then
                    if byte == 123 then
                        -- Four fields covers the record-heavy common case and
                        -- bounds an inaccurate hint to a few hash slots.
                        containerCapacity = 4
                    elseif _valueBuilder.depth(values) == 0 then
                        -- Top-level arrays scale with the document instead of
                        -- repeatedly growing from zero. Cap the estimate at
                        -- 2 MiB of 64-bit slots so one huge element cannot turn
                        -- a construction hint into unbounded retained memory.
                        containerCapacity = nupp.math.u32.shiftRightLogical(sourceCount, 5)
                        if containerCapacity > 262144 then
                            containerCapacity = 262144
                        end
                    else
                        containerCapacity = 4
                    end
                    tapeCursor = nupp.math.u32.add(tapeCursor, 1)
                else
                    return nullValue, 5, cursor
                end
            elseif byte == 116 then
                tag = 1
                local matched: uint32 = 0
                while matched < 4 do
                    local at: uint32 = nupp.math.u32.add(cursor, matched)
                    if at < sourceCount then
                        local actual = _valueBuilder.byteAt(source, at)
                        local expected: uint32 = switch matched do
                            case 0 -> 116
                            case 1 -> 114
                            case 2 -> 117
                            else -> 101
                        end
                        if actual ~= expected then
                            return nullValue, 1, nupp.math.u32.add(at, 1)
                        end
                    else
                        return nullValue, 1, nupp.math.u32.add(at, 1)
                    end
                    matched = nupp.math.u32.add(matched, 1)
                end
                length = 4
                cursor = nupp.math.u32.add(cursor, 4)
            elseif byte == 102 then
                tag = 2
                local matched: uint32 = 0
                while matched < 5 do
                    local at: uint32 = nupp.math.u32.add(cursor, matched)
                    if at < sourceCount then
                        local actual = _valueBuilder.byteAt(source, at)
                        local expected: uint32 = switch matched do
                            case 0 -> 102
                            case 1 -> 97
                            case 2 -> 108
                            case 3 -> 115
                            else -> 101
                        end
                        if actual ~= expected then
                            return nullValue, 1, nupp.math.u32.add(at, 1)
                        end
                    else
                        return nullValue, 1, nupp.math.u32.add(at, 1)
                    end
                    matched = nupp.math.u32.add(matched, 1)
                end
                length = 5
                cursor = nupp.math.u32.add(cursor, 5)
            elseif byte == 110 then
                tag = 0
                local matched: uint32 = 0
                while matched < 4 do
                    local at: uint32 = nupp.math.u32.add(cursor, matched)
                    if at < sourceCount then
                        local actual = _valueBuilder.byteAt(source, at)
                        local expected: uint32 = switch matched do
                            case 0 -> 110
                            case 1 -> 117
                            else -> 108
                        end
                        if actual ~= expected then
                            return nullValue, 1, nupp.math.u32.add(at, 1)
                        end
                    else
                        return nullValue, 1, nupp.math.u32.add(at, 1)
                    end
                    matched = nupp.math.u32.add(matched, 1)
                end
                length = 4
                cursor = nupp.math.u32.add(cursor, 4)
            elseif byte == 45 or byte >= 48 and byte <= 57 then
                tag = 3
                local parsed = _valueBuilder.numberToken(values, source, cursor, sourceCount)
                if parsed < 2147483648 then
                    return nullValue, 1, parsed
                end
                cursor = nupp.math.u32.sub(parsed, 2147483648)
                length = nupp.math.u32.sub(cursor, start)
            else
                return nullValue, 1, nupp.math.u32.add(cursor, 1)
            end

            if tag == 0 then
                _valueBuilder.null(values)
            elseif tag == 1 then
                _valueBuilder.boolean(values, true)
            elseif tag == 2 then
                _valueBuilder.boolean(values, false)
            elseif tag == 4 then
                _valueBuilder.string(values, source, start, length, flags == 1)
            elseif tag == 5 then
                _valueBuilder.openArray(values, containerCapacity)
            elseif tag == 6 then
                _valueBuilder.openObject(values, containerCapacity)
            end
            needValue = false
        elseif _valueBuilder.depth(values) == 0 then
            if cursor < sourceCount then
                return nullValue, 1, nupp.math.u32.add(cursor, 1)
            end
            done = true
        else
            if cursor >= sourceCount then
                return nullValue, 1, nupp.math.u32.add(cursor, 1)
            end
            local builderState = _valueBuilder.state(values)
            local byte = pending
            local kind = nupp.math.u32.andBits(builderState, 0xFF)
            local hasValue = nupp.math.u32.andBits(builderState, 0x100) ~= 0
            local closing = kind == 5 and byte == 93 or kind == 6 and byte == 125
            if closing then
                if tapeCursor >= tapeCount or _valueBuilder.scratchWord(tape, tapeCursor) ~= cursor then
                    return nullValue, 5, nupp.math.u32.add(cursor, 1)
                end
                tapeCursor = nupp.math.u32.add(tapeCursor, 1)
                cursor = nupp.math.u32.add(cursor, 1)
                _valueBuilder.close(values)
            elseif kind == 5 then
                if not hasValue then
                    needValue = true
                elseif byte == 44 then
                    cursor = nupp.math.u32.add(cursor, 1)
                    if tapeCursor >= tapeCount then
                        return nullValue, 5, cursor
                    end
                    tapeCursor = nupp.math.u32.add(tapeCursor, 1)
                    needValue = true
                else
                    return nullValue, 1, nupp.math.u32.add(cursor, 1)
                end
            else
                if hasValue then
                    if byte ~= 44 then
                        return nullValue, 1, nupp.math.u32.add(cursor, 1)
                    end
                    cursor = nupp.math.u32.add(cursor, 1)
                    if tapeCursor >= tapeCount then
                        return nullValue, 5, cursor
                    end
                    tapeCursor = nupp.math.u32.add(tapeCursor, 1)
                    local keySkipping = true
                    while keySkipping and cursor < sourceCount do
                        local keyByte = _valueBuilder.byteAt(source, cursor)
                        if keyByte == 32 or keyByte == 9 or keyByte == 10 or keyByte == 13 then
                            cursor = nupp.math.u32.add(cursor, 1)
                        else
                            keySkipping = false
                        end
                    end
                end
                if cursor >= sourceCount or _valueBuilder.byte(source, cursor) ~= 34 then
                    return nullValue, 1, nupp.math.u32.add(cursor, 1)
                end
                local opening = cursor
                if tapeCursor >= tapeCount or _valueBuilder.scratchWord(tape, tapeCursor) ~= opening then
                    return nullValue, 5, nupp.math.u32.add(cursor, 1)
                end
                tapeCursor = nupp.math.u32.add(tapeCursor, 1)
                if tapeCursor >= tapeCount then
                    return nullValue, 1, nupp.math.u32.add(cursor, 1)
                end
                local closingWord = _valueBuilder.scratchWord(tape, tapeCursor)
                local closingQuote = nupp.math.u32.andBits(closingWord, 0x7FFFFFFF)
                local escaped = nupp.math.u32.andBits(closingWord, 0x80000000) ~= 0
                tapeCursor = nupp.math.u32.add(tapeCursor, 1)
                local keyStart = nupp.math.u32.add(opening, 1)
                local keyLength = nupp.math.u32.sub(closingQuote, keyStart)
                _valueBuilder.key(values, source, keyStart, keyLength, escaped)
                cursor = nupp.math.u32.add(closingQuote, 1)
                local colonSkipping = true
                while colonSkipping and cursor < sourceCount do
                    local colonByte = _valueBuilder.byteAt(source, cursor)
                    if colonByte == 32 or colonByte == 9 or colonByte == 10 or colonByte == 13 then
                        cursor = nupp.math.u32.add(cursor, 1)
                    else
                        colonSkipping = false
                    end
                end
                if cursor >= sourceCount or _valueBuilder.byte(source, cursor) ~= 58 then
                    return nullValue, 1, nupp.math.u32.add(cursor, 1)
                end
                if tapeCursor >= tapeCount or _valueBuilder.scratchWord(tape, tapeCursor) ~= cursor then
                    return nullValue, 5, nupp.math.u32.add(cursor, 1)
                end
                cursor = nupp.math.u32.add(cursor, 1)
                tapeCursor = nupp.math.u32.add(tapeCursor, 1)
                needValue = true
            end
        end
    end

    return _valueBuilder.finish(values), 0, 0
end

--- The pull entry `nupp.codec.json.internal.decode` exports.
function fused.decodePull(
    source: string,
    nullValue: unknown,
    arrayMarker: unknown?,
    objectMarker: unknown?,
    shape: unknown?,
    arrayShapeMarker: unknown?,
    serdeMarkers: unknown?
): (unknown, uint32, uint32)
    return decodeFused(source, 0, nullValue, arrayMarker, objectMarker, shape, arrayShapeMarker, serdeMarkers)
end

--- The serde entry `nupp.codec.json.internal.decoder.serde` exports. The schema
--- argument carries compiled field targets; the native builder consumes those directly
--- instead of resolving scalar shapes through Lua.
function fused.decodeSerde(
    borrows source: string | Buffer,
    nullValue: unknown,
    arrayMarker: unknown?,
    objectMarker: unknown?,
    shape: unknown?,
    arrayShapeMarker: unknown?,
    serdeMarkers: unknown?
): (unknown, uint32, uint32)
    return decodeFused(source, 1, nullValue, arrayMarker, objectMarker, shape, arrayShapeMarker, serdeMarkers)
end

--- The eager entry `nupp.codec.json.internal.decoder.eager` exports.
function fused.decodeEager(
    source: string,
    nullValue: unknown,
    arrayMarker: unknown?,
    objectMarker: unknown?,
    shape: unknown?,
    arrayShapeMarker: unknown?,
    serdeMarkers: unknown?
): (unknown, uint32, uint32)
    return decodeFused(source, 2, nullValue, arrayMarker, objectMarker, shape, arrayShapeMarker, serdeMarkers)
end

export = fused
