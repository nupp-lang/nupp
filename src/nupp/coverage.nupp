local SCRIPT = [[document.querySelectorAll('[data-view]').forEach(function(b){b.onclick=function(){document.querySelectorAll('.view').forEach(function(v){v.classList.toggle('hidden',v.id!==b.dataset.view)})}});document.querySelectorAll('th button[data-key]').forEach(function(b){b.onclick=function(){var table=b.closest('table'),body=table.tBodies[0],key=b.dataset.key,rows=[].slice.call(body.rows),desc=b.dataset.desc==='1';rows.sort(function(a,z){var x=a.dataset[key],y=z.dataset[key];return (Number(x)-Number(y)||x.localeCompare(y))*(desc?-1:1)});table.querySelectorAll('th button[data-key]').forEach(function(h){h.setAttribute('aria-sort','none')});b.dataset.desc=desc?'0':'1';b.setAttribute('aria-sort',desc?'descending':'ascending');rows.forEach(function(r){body.appendChild(r)})}});]]

local STYLE_OVERLAY = [[
:root{--sidebar-width:290px}.shell{grid-template-columns:var(--sidebar-width) 8px minmax(0,1fr)}aside{border-right:0}.sidebar-resizer{position:relative;z-index:1;cursor:col-resize}.sidebar-resizer::before{position:absolute;top:0;bottom:0;left:3px;width:1px;background:var(--line);content:""}.sidebar-resizer:hover::before,.sidebar-resizer:focus-visible::before{width:3px;left:2px;background:var(--accent)}.sidebar-resizer:focus-visible{outline:2px solid var(--accent);outline-offset:-2px}.tree .file.covered{color:#7ee787}.tree .file.partial{color:#e3b341}.tree .file.uncovered{color:#f47067}.tree .file.non-executable{color:var(--faint)}.tree .file[aria-current=page]{color:var(--fg)}@media(max-width:780px){.sidebar-resizer{display:none}}
]]

