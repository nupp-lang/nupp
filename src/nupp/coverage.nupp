--[[
Coverage aggregation and the self-contained static report.

The generated program owns counting; this module deliberately owns none of the
hot path.  It reads the coverage build state and the one shard the built-in
runner wrote, turns them into one aggregate model, then writes JSON, LCOV, and
HTML from that model.
]]

local cjson = require("cjson")
local fs = require("nupp.fs")
local cache = require("nupp.build.cache")
local highlight = require("nupp.doc.highlight")

local coverage = {}
local readFile, writeFile, normalize = fs.readFile, fs.writeFile, fs.normalize

local function percent(covered, total)
    if total == 0 then
        return 100
    end
    return math.floor(covered * 10000 / total + 0.5) / 100
end

local function metric()
    return {covered = 0, total = 0, missing = {}}
end

local function add(metricValue, hit, label)
    metricValue.total = metricValue.total + 1
    if hit then
        metricValue.covered = metricValue.covered + 1
    else
        metricValue.missing[#metricValue.missing + 1] = label
    end
end

local function finish(metricValue)
    metricValue.percent = percent(metricValue.covered, metricValue.total)
end

local function splitLines(source)
    local lines = {}
    if source == "" then
        return lines
    end
    for line in (source .. "\n"):gmatch("(.-)\n") do
        lines[#lines + 1] = line
    end
    if source:sub(-1) == "\n" then
        lines[#lines] = nil
    end

    return lines
end

local function parent(path)
    return normalize(path):match("^(.*)/[^/]+$") or ""
end

local function fileStatus(file)
    local lines, funcs, branches = file.lines, file.functions, file.branches
    if lines.total == 0 and funcs.total == 0 and branches.total == 0 then
        return "non-executable"
    end
    local covered = lines.covered + funcs.covered + branches.covered
    local total = lines.total + funcs.total + branches.total
    if covered == 0 then
        return "uncovered"
    end
    if covered == total then
        return "covered"
    end

    return "partial"
end

local function readShard(path)
    local source, err = readFile(path)
    if not source then
        return nil, err
    end
    local decoder = cjson.new()
    decoder.decode_array_with_array_mt(true)
    local ok, value = pcall(decoder.decode, source)
    if not ok or type(value) ~= "table" or type(value.hits) ~= "table" then
        return nil, "invalid coverage shard " .. path
    end

    return value
end

--- Reads the coverage build state and turns the sites it contains into files with hit
--- counts. The state is the source of the denominator; the shard only adds execution,
--- so an unloaded source module remains visibly uncovered. The report one run produced:
--- every file it saw, and whatever the runner could not account for. `version` is the
--- shard format, not the report's.
type coverage.Model = {version: integer, files: {any}, warnings: {string},

    --- Filled in by `write`, which is the only thing that totals the files.
    summary: {[string]: any}?}

function coverage.collect(statePath: string, shardPath: string): coverage.Model
    local state = cache.loadState(statePath)
    local shard, shardErr = readShard(shardPath)
    local hits = shard and shard.hits or {}
    local files, warnings = {}, {}
    if not shard then
        warnings[#warnings + 1] = shardErr or "coverage runner did not flush a shard"
    end
    for _, record in pairs(state.modules or {}) do
        local manifest = record.coverage
        if manifest and manifest.path and type(manifest.sites) == "table" then
            local path = normalize(manifest.path)
            local file = files[path]
            if not file then
                local source = readFile(path) or ""
                file = {
                    path = path,
                    source = source,
                    generated = record.output,
                    sites = {},
                    lines = metric(),
                    functions = metric(),
                    branches = metric(),
                    lineHits = {},
                    branchHits = {},
                    executableLines = {}
                }
                files[path] = file
            end
            local moduleHits = hits[manifest.path] or hits[path] or {}
            for _, site in ipairs(manifest.sites) do
                local id = tostring(site.id)
                local line = tonumber(site.line) or 0
                local count = tonumber(moduleHits[id]) or 0
                local value = {id = site.id, kind = site.kind, line = line, count = count}
                file.sites[#file.sites + 1] = value
                if site.kind == "statement" then
                    local lineKey = "L" .. line
                    file.executableLines[lineKey] = line
                    file.lineHits[lineKey] = (file.lineHits[lineKey] or 0) + count
                elseif site.kind == "function" then
                    local lineKey = "L" .. line
                    file.executableLines[lineKey] = line
                    file.lineHits[lineKey] = (file.lineHits[lineKey] or 0) + count
                    add(file.functions, count > 0, line)
                elseif site.kind == "branch" then
                    local yes = tonumber(moduleHits[id .. ":true"]) or 0
                    local no = tonumber(moduleHits[id .. ":false"]) or 0
                    add(file.branches, yes > 0, line .. ":true")
                    add(file.branches, no > 0, line .. ":false")
                    local lineKey = "L" .. line
                    local branchHits = file.branchHits[lineKey] or {yes = 0, no = 0}
                    branchHits.yes, branchHits.no = branchHits.yes + yes, branchHits.no + no
                    file.branchHits[lineKey] = branchHits
                end
            end
        end
    end
    local list = {}
    for _, file in pairs(files) do
        local executable = {}
        for _, line in pairs(file.executableLines) do
            executable[#executable + 1] = line
        end
        table.sort(executable)
        for _, line in ipairs(executable) do
            add(file.lines, (file.lineHits["L" .. line] or 0) > 0, line)
        end
        finish(file.lines)
        ;
        finish(file.functions)
        ;
        finish(file.branches)
        file.status = fileStatus(file)
        list[#list + 1] = file
    end
    table.sort(list, function(a, b)
        return a.path < b.path
    end)

    return {version = 1, files = list, warnings = warnings}
end

local function aggregate(files, prefix)
    local value = {path = prefix, lines = metric(), functions = metric(), branches = metric(), files = {}}
    for _, file in ipairs(files) do
        if prefix == "" or file.path:sub(1, #prefix + 1) == prefix .. "/" then
            for _, field in ipairs({"lines", "functions", "branches"}) do
                value[field].covered = value[field].covered + file[field].covered
                value[field].total = value[field].total + file[field].total
            end
            value.files[#value.files + 1] = file
        end
    end
    finish(value.lines)
    ;
    finish(value.functions)
    ;
    finish(value.branches)

    return value
end

local function escape(text)
    return tostring(text):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"):gsub('"', "&quot;")
end

local STYLE = [[
:root{color-scheme:dark;--bg:#0d1117;--panel:#161b22;--panel-raised:#1c2129;--fg:#e6edf3;--muted:#8b949e;--faint:#57606a;--line:#30363d;--accent:#58a6ff;--accent-soft:#1f4268;--covered:#3fb950;--partial:#d29922;--uncovered:#f85149;--none:#57606a;--syntax-comment:#8b949e;--syntax-boolean:#79c0ff;--syntax-keyword:#ff7b72;--syntax-meta:#d2a8ff;--syntax-number:#79c0ff;--syntax-function:#d2a8ff;--syntax-operator:#ff7b72;--syntax-property:#a5d6ff;--syntax-punctuation:#c9d1d9;--syntax-string:#a5d6ff;--syntax-type:#ffa657;--syntax-variable:#e6edf3}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--fg);font:14px/1.5 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}.shell{display:grid;grid-template-columns:290px minmax(0,1fr);min-height:100vh}aside{position:sticky;top:0;height:100vh;background:var(--panel);border-right:1px solid var(--line);padding:1rem;overflow:auto}main{width:min(100%,1500px);padding:2rem;overflow:hidden}.brand{display:block;margin:0 0 1rem;padding:.45rem .55rem;color:var(--fg);border-radius:7px;font-size:1.05rem;font-weight:750;letter-spacing:-.01em;text-decoration:none}.brand:hover{background:var(--panel-raised)}a{color:var(--accent)}.tree,.tree ul{margin:0;padding:0;list-style:none}.tree ul{margin-left:.7rem;padding-left:.65rem;border-left:1px solid color-mix(in srgb,var(--line) 75%,transparent)}.tree li{position:relative;margin:.1rem 0}.tree a{display:flex;min-width:0;align-items:center;gap:.42rem;padding:.32rem .45rem;color:var(--muted);border:1px solid transparent;border-radius:6px;font-size:.82rem;line-height:1.25;text-decoration:none}.tree a:hover{color:var(--fg);background:var(--panel-raised)}.tree a:focus-visible,.tabs button:focus-visible,th button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.tree a[aria-current=page]{color:var(--fg);border-color:color-mix(in srgb,var(--accent) 35%,var(--line));background:var(--accent-soft);font-weight:650}.tree details>summary{display:flex;align-items:cent