.breadcrumbs{display:flex;flex-wrap:wrap;align-items:center;gap:.35rem;margin:0 0 .35rem;color:var(--muted);font-size:.82rem}.breadcrumbs a{color:var(--muted);text-decoration:none}.breadcrumbs a:hover{color:var(--accent);text-decoration:underline}.breadcrumbs [aria-hidden]{color:var(--faint)}.breadcrumbs [aria-current]{color:var(--fg)}
]]

local SPA_STYLE = [[.route[hidden]{display:none}]]

local RESIZE_SCRIPT = [[(function(){var handle=document.querySelector('.sidebar-resizer'),root=document.documentElement;if(!handle)return;function resize(x){var width=Math.max(220,Math.min(520,x));root.style.setProperty('--sidebar-width',width+'px');handle.setAttribute('aria-valuenow',width)}handle.addEventListener('pointerdown',function(e){e.preventDefault();handle.setPointerCapture(e.pointerId);function move(event){resize(event.clientX)}function end(){handle.removeEventListener('pointermove',move);handle.removeEventListener('pointerup',end)}handle.addEventListener('pointermove',move);handle.addEventListener('pointerup',end)})})();]]

local APP_SCRIPT = [[(function(){function show(){var route=location.hash.slice(1)||'all',found=false;document.querySelectorAll('.route').forEach(function(page){var active=page.dataset.route===route;page.hidden=!active;found=found||active});if(!found&&route!=='all'){location.hash='all';return}document.querySelectorAll('[data-route]').forEach(function(link){if(link.tagName==='A'){link.toggleAttribute('aria-current',link.dataset.route===route)}});document.title=(document.querySelector('.route:not([hidden]) h1')||{}).textContent||'Nupp coverage'}window.addEventListener('hashchange',show);document.querySelectorAll('[data-view]').forEach(function(button){button.onclick=function(){var route=button.closest('.route');route.querySelectorAll('.view').forEach(function(view){view.classList.toggle('hidden',view.dataset.view!==button.dataset.view)})}});document.querySelectorAll('th button[data-key]').forEach(function(button){button.onclick=function(){var table=button.closest('table'),body=table.tBodies[0],key=button.dataset.key,rows=[].slice.call(body.rows),desc=button.dataset.desc==='1';rows.sort(function(a,z){var x=a.dataset[key],y=z.dataset[key];return (Number(x)-Number(y)||x.localeCompare(y))*(desc?-1:1)});table.querySelectorAll('th button[data-key]').forEach(function(header){header.setAttribute('aria-sort','none')});button.dataset.desc=desc?'0':'1';button.setAttribute('aria-sort',desc?'descending':'ascending');rows.forEach(function(row){body.appendChild(row)})}});show()})();]]

local NAVIGATION_SCRIPT = [[(function(){function top(){window.scrollTo(0,0)}window.addEventListener('hashchange',top);top()})();]]

local TREE_SCRIPT = [[(function(){function expand(){var route=location.hash.slice(1)||'all';document.querySelectorAll('.tree a[data-route]').forEach(function(link){if(link.dataset.route!==route)return;var parent=link.parentElement;while(parent){if(parent.tagName==='DETAILS')parent.open=true;parent=parent.parentElement}})}window.addEventListener('hashchange',expand);expand()})();]]

local function page(title, tree, body)
    return "<!doctype html><meta charset=utf-8><meta name=viewport content='width=device-width,initial-scale=1'>"
        .. "<title>"
        .. escape(
        title
    )
        .. " | Nupp coverage</title><style>"
        .. STYLE
        .. STYLE_OVERLAY
        .. BREADCRUMB_STYLE
        .. SPA_STYLE
        .. "</style><div class=shell><aside><a class=brand href='index.html'>Nupp coverage</a>"
        .. tree
        .. "</aside><div class=sidebar-resizer role=separator tabindex=0 aria-label='Resize file tree' aria-orientation=vertical aria-valuemin=220 aria-valuemax=520 aria-valuenow=290></div><main>"
        .. body
        .. "</main></div><script>"
        .. "/*"
        .. SCRIPT
        .. "*/"
        .. APP_SCRIPT
        .. NAVIGATION_SCRIPT
        .. TREE_SCRIPT
        .. RESIZE_SCRIPT
        .. "</script>"
end

local function directoryRoute(path)
    return "dir/" .. path
end

local function fileRoute(path)
    return "file/" .. path
end

local function routeHref(route)
    return "#" .. escape(route)
end

local function treeHtml(files)
    local root = {dirs = {}, files = {}}
    for _, file in ipairs(files) do
        local node, parts = root, {}
        for part in file.path:gmatch("[^/]+") do
            parts[#parts + 1] = part
        end
        for index = 1, #parts - 1 do
            local name = parts[index]
            node.dirs[name] = node.dirs[name] or {dirs = {}, files = {}}
            node = node.dirs[name]
        end
        node.files[#node.files + 1] = file
    end
    local function render(node, prefix, depth)
        local out, names = {"<ul>"}, {}
        for name in pairs(node.dirs) do
            names[#names + 1] = name
        end
        table.sort(names)
        for _, name in ipairs(names) do
            local path = prefix == "" and name or prefix .. "/" .. name
            out[
                #out + 1
            ] = "<li><details" .. (
                depth < 2 and " open" or ""
            ) .. "><summary><a data-route='" .. escape(
                directoryRoute(path)
            ) .. "' href='" .. routeHref(
                directoryRoute(path)
            ) .. "'><span class=folder aria-hidden=true></span>" .. escape(
                name
            ) .. "</a></summary>" .. render(node.dirs[name], path, depth + 1) .. "</details></li>"
        end
        table.sort(node.files, function(a, b)
            return a.path < b.path
        end)
        for _, file in ipairs(node.files) do
            out[
                #out + 1
            ] = "<li><a class='file " .. file.status .. "' data-route='" .. escape(
                fileRoute(file.path)
            ) .. "' href='" .. routeHref(
                fileRoute(file.path)
            ) .. "'>" .. escape(file.path:match("([^/]+)$")) .. "</a></li>"
        end
        out[#out + 1] = "</ul>"

        return table.concat(out)
    end

    return "<nav class=tree>" .. render(root, "", 0) .. "</nav>"
end

local function metricCard(label, value)
    return "<div class=card><span>"
        .. label
        .. "</span><strong>"
        .. value.percent
        .. "%</strong><span class=metric>"
        .. value.covered
        .. " / "
        .. value.total
        .. " covered</span></div>"
end

local function pageHeading(path)
    if path == "" or path == "All files" then
        return "<h1>All files</h1>"
    end
    local out, parts, prefix = {
        "<nav class=breadcrumbs aria-label=Breadcrumb>" .. "<a data-route=all href='#all'>All files</a>"
    }, {}, ""
    for part in path:gmatch("[^/]+") do
        parts[#parts + 1] = part
    end
    for index, part in ipairs(parts) do
        prefix = prefix == "" and part or prefix .. "/" .. part
        out[#out + 1] = "<span aria-hidden=true>/</span>"
        if index == #parts then
            out[#out + 1] = "<span aria-current=page>" .. escape(part) .. "</span>"
        else
            out[
                #out + 1
            ] = "<a data-route='" .. escape(
                directoryRoute(prefix)
            ) .. "' href='" .. routeHref(directoryRoute(prefix)) .. "'>" .. escape(part) .. "</a>"
        end
    end
    out[#out + 1] = "</nav><h1>" .. escape(parts[#parts]) .. "</h1>"

    return table.concat(out)
end

local function rows(files)
    local out = {}
    for _, file in ipairs(files) do
        out[
            #out + 1
        ] = "<tr data-name='" .. escape(
            file.path
        )
            .. "' data-lines='"
            .. file.lines.percent
            .. "' data-missed-lines='"
            .. #file.lines.missing
            .. "' data-functions='"
            .. file.functions.percent
            .. "' data-missed-functions='"
            .. #file.functions.missing
            .. "' data-branches='"
            .. file.branches.percent
            .. "' data-missed-arms='"
            .. #file.branches.missing
            .. "'><td><span class='status "
            .. file.status
            .. "'></span><a data-route='"
            .. escape(
            fileRoute(file.path)
        ) .. "' href='" .. routeHref(
            fileRoute(file.path)
        ) .. "'>" .. escape(
            file.path
        )
            .. "</a></td><td>"
            .. file.lines.covered
            .. " / "
            .. file.lines.total
            .. " ("
            .. file.lines.percent
            .. "%)</td><td>"
            .. #file.lines.missing
            .. "</td><td>"
            .. file.functions.covered
            .. " / "
            .. file.functions.total
            .. "</td><td>"
            .. #file.functions.missing
            .. "</td><td>"
            .. file.branches.covered
            .. " / "
            .. file.branches.total
            .. " ("
            .. file.branches.percent
            .. "%)</td><td>"
            .. #file.branches.missing
            .. "</td></tr>"
    end

    return table.concat(out)
end

local function indexBody(summary, model, title)
    local out = {
        pageHeading(title) .. "<div class=cards>",
        metricCard("Lines", summary.lines),
        metricCard("Functions", summary.functions),
        metricCard("Branches", summary.branches),
        "</div>"
    }
    for _, warning in ipairs(model.warnings or {}) do
        out[#out + 1] = "<p class=warning>" .. escape(warning) .. "</p>"
    end
    out[
        #out + 1
    ] = "<table><thead><tr><th><button data-key=name aria-sort=none>Name <span class=sort-indicator aria-hidden=true></span></button></th>"
        .. "<th><button data-key=lines aria-sort=none>Lines <span class=sort-indicator aria-hidden=true></span></button></th><th><button data-key=missedLines aria-sort=none>Missed lines <span class=sort-indicator aria-hidden=true></span></button></th>"
        .. "<th><button data-key=functions aria-sort=none>Functions <span class=sort-indicator aria-hidden=true></span></button></th><th><button data-key=missedFunctions aria-sort=none>Missed functions <span class=sort-indicator aria-hidden=true></span></button></th><th><button data-key=branches aria-sort=none>Branches <span class=sort-indicator aria-hidden=true></span></button></th>"
        .. "<th><button data-key=missedArms aria-sort=none>Missed arms <span class=sort-indicator aria-hidden=true></span></button></th></tr></thead><tbody>"
        .. rows(
        summary.files
    ) .. "</tbody></table>"

    return table.concat(out)
end

local function codeRows(source, file, language)
    local out, sourceLines = {}, splitLines(source)
    local highlighted = highlight.codeLines(source, language)
    local executable = {}
    for _, site in ipairs(file.sites) do
        executable[site.line] = true
    end
    for line, text in ipairs(sourceLines) do
        local hits = file.lineHits["L" .. line] or 0
        local branch = file.branchHits["L" .. line]
        local state = "non-executable"
        if executable[line] then
            state = hits > 0 and "covered" or "uncovered"
            if branch and branch.yes > 0 and branch.no > 0 then
                state = "covered"
            elseif branch and (branch.yes > 0 or branch.no > 0) then
                state = "partial"
            end
        end
        local detail = hits > 0 and tostring(hits) or ""
        if branch then
            detail = detail .. " " .. branch.yes .. "/" .. branch.no
        end
        out[
            #out + 1
        ] = "<span id='L"
            .. line
            .. "' class='row "
            .. state
            .. "'><span class=num>"
            .. line
            .. "</span><span class=hit>"
            .. detail
            .. "</span>"
            .. (
            highlighted[line] or escape(text)
        ) .. "</span>"
    end

    return table.concat(out)
end

local function fileBody(file)
    local generated = readFile(file.generated) or "-- generated Lua unavailable"
    local out = {
        pageHeading(file.path) .. "<div class=cards>",
        metricCard("Lines", file.lines),
        metricCard("Functions", file.functions),
        metricCard("Branches", file.branches),
        "</div><div class=tabs><button data-view=source>Nupp source</button>"
        .. "<button data-view=generated>Generated Lua</button></div>",
        "<pre data-view=source class='view code'>" .. codeRows(file.source, file, "nupp") .. "</pre>",
        "<pre data-view=generated class='view code hidden'>" .. codeRows(generated, file, "lua") .. "</pre>"
    }

    return table.concat(out)
end

local function routeSection(route, body)
    return "<section class=route data-route='" .. escape(route) .. "' hidden>" .. body .. "</section>"
end

local function reportBody(summary, model, dirs)
    local sections = {routeSection("all", indexBody(summary, model, "All files"))}
    for _, dir in ipairs(dirs) do
        sections[#sections + 1] = routeSection(directoryRoute(dir), indexBody(aggregate(model.files, dir), model, dir))
    end
    for _, file in ipairs(model.files) do
        sections[#sections + 1] = routeSection(fileRoute(file.path), fileBody(file))
    end

    return table.concat(sections)
end

local function lcov(model)
    local out = {}
    for _, file in ipairs(model.files) do
        out[#out + 1] = "TN:"
        out[#out + 1] = "SF:" .. file.path
        for _, site in ipairs(file.sites) do
            if site.kind == "statement" then
                out[#out + 1] = "DA:" .. site.line .. "," .. site.count
            elseif site.kind == "branch" then
                local hit = file.branchHits["L" .. site.line] or {yes = 0, no = 0}
                out[#out + 1] = "BRDA:" .. site.line .. ",0," .. site.id .. "," .. hit.yes
                out[#out + 1] = "BRDA:" .. site.line .. ",0," .. site.id + 1 .. "," .. hit.no
            end
        end
        out[#out + 1] = "end_of_record"
    end

    return table.concat(out, "\n") .. "\n"
end

--- Writes all report formats and returns the root roll-up for terminal/JSON callers.
function coverage.write(model: coverage.Model, outDir: string): {[string]: any}
    highlight.configureScintillua(".", {})
    local summary = aggregate(model.files, "")
    model.summary = summary
    local encoder = cjson.new()
    encoder.encode_empty_table_as_object(false)
    encoder.encode_invalid_numbers(false)
    -- Source text and generated Lua belong in their HTML pages, not in the machine
    -- report. Keeping the JSON to metrics/sites makes it practical for CI to read.
    local public = {
        version = model.version,
        warnings = model.warnings,
        files = {},
        summary = {
            path = summary.path,
            lines = summary.lines,
            functions = summary.functions,
            branches = summary.branches
        }
    }
    for _, file in ipairs(model.files) do
        public.files[
            #public.files + 1
        ] = {
            path = file.path,
            status = file.status,
            lines = file.lines,
            functions = file.functions,
            branches = file.branches,
            sites = file.sites
        }
    end
    assert(writeFile(outDir .. "/coverage.json", encoder.encode(public) .. "\n"))
    assert(writeFile(outDir .. "/summary.json", encoder.encode(public.summary) .. "\n"))
    assert(writeFile(outDir .. "/lcov.info", lcov(model)))
    local dirSet, dirs = {}, {}
    for _, file in ipairs(model.files) do
        local dir = parent(file.path)
        while dir ~= "" do
            dirSet[dir] = true
            ;
            dir = parent(dir)
        end
    end
    for dir in pairs(dirSet) do
        dirs[#dirs + 1] = dir
    end
    table.sort(dirs)
    assert(
        writeFile(outDir .. "/index.html", page("All files", treeHtml(model.files), reportBody(summary, model, dirs)))
    )

    return summary
end

return coverage
