--[[
The incremental computation core.

A small library, not a framework. An input carries a revision stamp; a derived
query memoizes its value along with when that value last changed, when it was
last verified, and what it depended on. A read first tries cheap validation —
no dependency has changed since the last verify — and a recomputation compares
the new value against the old and backdates the change stamp when they are equal.
That backdating is the early cutoff, and it is what stops an edit from cascading.

Because Nupp types are content-address interned, plain equality on a module
interface is the interface-hash comparison, for free.

A cycle resolves to nil for the re-entrant edge, which is how a `require` cycle
between modules terminates.
]]

local query = {}

--- One query a computation depended on, recorded while it ran.
type query.Dep = {
    --- The query's name.
    name: string,

    --- The key it was asked for.
    key: any,
}

--- A value set from outside, with the revision at which it last changed.
type query.Input = {value: any, changedAt: integer}

--- What a derived query left behind.
type query.Memo = {
    --- What it computed.
    value: any,

    --- The revision at which that value last actually changed, which the early cutoff
    --- backdates when a recomputation lands on the same value.
    changedAt: integer,

    --- The revision at which it was last known to be up to date.
    verifiedAt: integer,

    --- Everything it read while computing, in order.
    deps: {query.Dep},
}

--- A running computation, collecting what it reads.
type query.Frame = {deps: {query.Dep}}

--- How to compute one query.
---
--- `q` is the query object, passed so a definition can read other queries; it is
--- untyped here because Q is declared below in terms of this.
type query.Def = {
    --- Computes the value for a key.
    fn: function(q: any, key: any): any,

    --- Decides whether a recomputed value counts as unchanged. Optional: plain equality
    --- is right for interned types and scalars.
    eq: (function(a: any, b: any): boolean)?,
}

--- A query database: definitions, inputs, and everything memoized so far.
record query.Q
    --- Bumped by every input change; the clock everything else is stamped against.
    revision: integer

    --- Values set from outside, by query name and key.
    inputs: {[string]: {[any]: query.Input}}

    --- How to compute each derived query.
    defs: {[string]: query.Def}

    --- What each derived query last produced, by name and key.
    memo: {[string]: {[any]: query.Memo}}

    --- Computations currently running, innermost last. Reading a query records it as a
    --- dependency of the frame on top.
    stack: {query.Frame}

    --- Guards against a query re-entering itself.
    active: {[string]: boolean}

    --- How many times each query actually computed, for tests and tooling.
    stats: {[string]: integer}
end

--- A new, empty query database.
function query.new(): query.Q
    return new query.Q{
        revision = 1,
        inputs = {},
        defs = {},
        memo = {},
        stack = {},
        active = {},
        stats = {},
    }
end

--- Registers how to compute a derived query.
---
--- @param name what to call it
--- @param fn computes the value for a key
--- @param eq decides "did the value really change", for the early cutoff
function query.Q:define(name: string, fn: function(q: any, key: any): any,
    eq: (function(a: any, b: any): boolean)?)
    self.defs[name] = {fn = fn, eq = eq}
end

--- Sets an input, which bumps the revision and so invalidates whatever depended on it.
function query.Q:setInput(name: string, key: any, value: any)
    self.revision = self.revision + 1
    local byName = self.inputs[name] or {}
    self.inputs[name] = byName
    byName[key] = {value = value, changedAt = self.revision}
end

--- Removes an overlay, so a derived definition (a disk read, say) takes over again.
function query.Q:clearInput(name: string, key: any)
    self.revision = self.revision + 1
    local byName = self.inputs[name]
    if byName then
        byName[key] = nil
    end
    -- invalidate any memoized fallback so it recomputes fresh
    local m = self.memo[name]
    if m then
        m[key] = nil
    end
end

--- The revision at which a dependency last changed. Defined after Q:get, which it
--- calls; declared here, which Q:get needs.
local depChangedAt: function(self: query.Q, name: string, key: any): integer

--- Records that the running computation read `name`/`key`.
local function record(self: query.Q, name: string, key: any)
    local top = self.stack[#self.stack]
    if top then
        top.deps[#top.deps + 1] = {name = name, key = key}
    end
end

--- The value of a query, computing it only if it has to.
---
--- Three cheaper answers come first: an input is returned outright, a memo verified at
--- the current revision is current by definition, and a memo whose dependencies have
--- all held still is revalidated without running anything. Only then does the
--- definition run.
---
--- @param name which query
--- @param key what to compute it for
--- @raises whatever the definition raised, rethrown with its own message, since a
---     query that could not be computed has no value to hand back
function query.Q:get(name: string, key: any): any
    local byInput = self.inputs[name]
    local inp = byInput and byInput[key]
    if inp then
        record(self, name, key)
        return inp.value
    end

    local def = assert(self.defs[name], "unknown query: " .. tostring(name))
    local m = self.memo[name] or {}
    self.memo[name] = m
    local entry = m[key]

    if entry and entry.verifiedAt == self.revision then
        record(self, name, key)
        return entry.value
    end

    local activeKey = name .. "\0" .. tostring(key)
    if self.active[activeKey] then
        -- cycle: the re-entrant edge observes the previous value (or nil)
        record(self, name, key)
        return entry and entry.value or nil
    end

    if entry then
        local clean = true
        for _, d in ipairs(entry.deps) do
            if depChangedAt(self, d.name, d.key) > entry.verifiedAt then
                clean = false
                break
            end
        end
        if clean then
            entry.verifiedAt = self.revision
            record(self, name, key)
            return entry.value
        end
    end

    self.stats[name] = (self.stats[name] or 0) + 1
    self.active[activeKey] = true
    self.stack[#self.stack + 1] = {deps = {}}
    local ok, value = pcall(def.fn, self, key)
    local frame = self.stack[#self.stack]
    self.stack[#self.stack] = nil
    self.active[activeKey] = nil
    if not ok then
        error(value, 0)
    end

    local changedAt = self.revision
    if entry then
        local same
        if def.eq then
            same = def.eq(entry.value, value)
        else
            same = entry.value == value
        end
        if same then
            changedAt = entry.changedAt -- early cutoff: not really a change
            value = entry.value
        end
    end
    m[key] = {value = value, changedAt = changedAt,
        verifiedAt = self.revision, deps = frame.deps}
    record(self, name, key)
    return value
end

--- Brings a dependency up to date, then reports when it last changed, so a stale answer
--- never passes for a fresh one.
depChangedAt = function(self: query.Q, name: string, key: any): integer
    local byName = self.inputs[name]
    local inp = byName and byName[key]
    if inp then
        return inp.changedAt
    end
    self:get(name, key)
    local m = self.memo[name]
    local entry = m and m[key]
    return entry and entry.changedAt or self.revision
end

return query
