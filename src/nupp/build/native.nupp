--[[
Staging compiler-provided native features.

This consumes effects recorded by the checker.  It deliberately does not read
the manifest: project dependencies and compiler-native features have different
owners and must not be conflated.
]]

local envMod = require("nupp.env")
local native = require("nupp.native")
local fs = require("nupp.fs")
local process = require("nupp.build.process")

local stage = {}

local join = fs.join

local function libraryFile(name: string): string
    if jit.os == "Windows" then return name .. ".dll" end
    if jit.os == "OSX" then return "lib" .. name .. ".dylib" end
    return "lib" .. name .. ".so"
end

--- Builds and stages every native feature in `effects`, returning its files.
function stage.build(root: string, outDir: string, effects: any): any, string?
    local outputs = {}
    for _, feature in ipairs(native.features(effects)) do
        if feature.cargo then
            local compilerRoot = envMod.compilerRoot()
            if not compilerRoot then
                return nil, ("native feature %q needs compiler source; use a source "
                    .. "checkout to build this target"):format(feature.name)
            end
            local targetDir = join(root, join(outDir, "native/" .. feature.name))
            local code, text = process.capture({"cargo", "build", "--release",
                "--manifest-path", join(compilerRoot, feature.cargo), "--target-dir",
                targetDir})
            if code ~= 0 then
                return nil, ("cannot build native feature %q:\n%s")
                    :format(feature.name, text)
            end
            local filename = libraryFile(feature.library)
            local built = join(targetDir, join("release", filename))
            -- ffi.load treats a path containing a slash as an exact filename;
            -- staging the loader name without a platform suffix lets the same
            -- generated bootstrap work on every supported host.
            local output = join(root, join(outDir, join("lib", feature.library)))
            local copied, err = fs.copyFile(built, output)
            if not copied then
                return nil, ("cannot stage native feature %q: %s")
                    :format(feature.name, tostring(err))
            end
            outputs[output] = true
        end
    end
    return outputs
end

return stage
