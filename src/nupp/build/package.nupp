--[[
One file that is the whole program.

A bundle is every module a target reaches, concatenated into one Lua file with
each registered in `package.preload`, so the result runs anywhere LuaJIT does
with nothing beside it. A binary goes one step further: the bundle becomes a
payload appended to a prebuilt host stub, found at run time by a magic trailer
rather than by anything the filesystem has to be asked.
]]

local check = require("nupp.check")
local hash = require("nupp.build.hash")
local process = require("nupp.build.process")
local fs = require("nupp.fs")
local deps = require("nupp.build.deps")
local modulesMod = require("nupp.build.modules")

local normalize, join = fs.normalize, fs.join
local dirname, basename = fs.dirname, fs.basename
local readFile, writeFile = fs.readFile, fs.writeFile
local exists, mkdir = fs.exists, fs.mkdir
local copyFile, listFiles = fs.copyFile, fs.listFiles
local expandGlob = deps.expandGlob
local resourceRelative = modulesMod.resourceRelative

local package_ = {}

--- `text` as a Lua long string, at a bracket level the text itself does not use.
---
--- A declaration file is prose and code, both of which contain `]]`, so the level
--- is chosen by looking rather than by hoping. The leading newline is there
--- because Lua drops one immediately after the opening bracket, and a file whose
--- first line matters would otherwise come back one line short.
local function longString(text: string): string
    local level = 0
    for closing in text:gmatch("%]=*%]") do
        level = math.max(level, #closing - 2 + 1)
    end
    local equals = ("="):rep(level)
    return "[" .. equals .. "[\n" .. text .. "]" .. equals .. "]"
end

--- The Lua module name a target's entry compiles to, and where its `.lua` lands.
local function entryModule(root, outDir, target)
    local mainName = "nupp.main"
    local entries = target.entries or {}
    if entries[1] and not entries[1]:match("%.nupp$") then mainName = entries[1] end
    return mainName, join(root, join(outDir, mainName:gsub("%.", "/") .. ".lua"))
end

--- One target as a single Lua chunk: every module it built preloaded, every
--- resource it declared carried alongside them, and the entry's own code last.
---
--- The result runs under a plain `luajit` with nothing beside it. That is what
--- makes it worth having on its own, and it is also the payload a stub carries;
--- see [distribution.md](../../../docs/distribution.md).
---
--- Resources go in rather than beside, keyed by their path relative to the entry
--- module's directory — the same key `nupp.env` reads its own declarations
--- through, so a program's resources and the compiler's behave identically. A
--- bundle that carried them beside itself would lose them the moment somebody
--- moved the one file, and lose them quietly.
---
--- Deterministic by construction: modules arrive from `listFiles`, which sorts,
--- resources are sorted here, and nothing records a time or a building machine's
--- path. Two builds of one tree produce identical bytes, which is what the
--- packaging fixpoint rests on.
local function bundleText(root, config, target, banner, modules)
    local outDir = target.outDir or "build"
    local _, mainPath = entryModule(root, outDir, target)
    local chunks = {banner or ""}

    -- The modules this build compiled, under the names it compiled them as.
    --
    -- Not every `.lua` under the output directory, which was the first attempt
    -- and is wrong twice over. That directory is also where native dependencies
    -- build, and their trees are full of `.lua` that is examples and scripts —
    -- one of lua-cjson's opens with a hashbang, a syntax error the moment a
    -- preload wraps it in a function. And a resource that happens to end in
    -- `.lua` is not a module: the scintillua lexers are opened by path, never
    -- required, and preloading them added sixteen thousand lines to the bundle
    -- that nothing could ever have asked for.
    --
    -- The build already knows the difference, and it knows the module's name
    -- rather than a path a name has to be guessed back out of.
    local names = {}
    for name in pairs(modules or {}) do names[#names + 1] = name end
    table.sort(names)
    for _, name in ipairs(names) do
        local path = modules[name].output
        if path and normalize(path) ~= normalize(mainPath) then
            local text, readErr = readFile(path)
            if not text then return nil, readErr end
            chunks[#chunks + 1] = ("package.preload[%q] = function(...)\n"):format(name)
            chunks[#chunks + 1] = text
            chunks[#chunks + 1] = "\nend\n"
        end
    end

    local moduleDirPath = normalize(dirname(mainPath))
    local resources, unreachable = {}, {}
    for _, pattern in ipairs(target.resources or {}) do
        for _, source in ipairs(expandGlob(root, pattern)) do
            local staged = normalize(join(root,
                join(outDir, resourceRelative(config, source, root))))
            if staged:sub(1, #moduleDirPath + 1) == moduleDirPath .. "/" then
                local text, readErr = readFile(staged)
                if not text then return nil, readErr end
                resources[#resources + 1] =
                    {name = staged:sub(#moduleDirPath + 1), text = text}
            else
                -- A resource staged beside the entry's directory rather than
                -- under it has no key a running program could ask for, since a
                -- program asks relative to where its own modules are. Left out
                -- and said out loud: a bundle that quietly dropped files would
                -- be discovered by whatever stopped working.
                unreachable[#unreachable + 1] = staged
            end
        end
    end
    table.sort(resources, function(a, b) return a.name < b.name end)
    chunks[#chunks + 1] = 'package.preload["nupp.embedded"] = function()\n'
    chunks[#chunks + 1] = "return {\n"
    for _, resource in ipairs(resources) do
        chunks[#chunks + 1] = ("[%q] = %s,\n")
            :format(resource.name, longString(resource.text))
    end
    chunks[#chunks + 1] = "}\nend\n"

    local mainText, mainErr = readFile(mainPath)
    if not mainText then return nil, mainErr end
    chunks[#chunks + 1] = mainText
    return table.concat(chunks), nil, unreachable
end

--- Where a `bundle` target writes its one file.
local function bundleOutput(root, target, name)
    local outDir = target.outDir or "build"
    return join(root, target.output or join(outDir, name .. ".lua"))
end

-- The trailer a stub reads to find its payload. Specified in
-- docs/distribution.md; the two implementations are this one and the host's,
-- and they are meant to be read side by side.
local PAYLOAD_MAGIC = "NUPPLOAD"
local PAYLOAD_VERSION = 1
local TRAILER_LENGTH = 48

--- `value` as `width` little-endian bytes.
local function littleEndian(value, width)
    local bytes = {}
    for index = 1, width do
        bytes[index] = string.char(value % 256)
        value = math.floor(value / 256)
    end
    return table.concat(bytes)
end

--- A hex digest's first `count` bytes, as bytes.
local function digestPrefix(hex, count)
    local bytes = {}
    for index = 1, count do
        -- Bound before the call: `assert` hands back every argument it was
        -- given, so passing it straight to `string.char` passes the message too.
        local byte = assert(tonumber(hex:sub(index * 2 - 1, index * 2), 16),
            "a digest is hexadecimal")
        bytes[index] = string.char(byte)
    end
    return table.concat(bytes)
end

--- A stub with `payload` appended and a trailer saying where it starts.
---
--- Appending rather than writing a section: an ELF section, a Mach-O segment
--- and a PE resource are three formats and three writers, and this is one that
--- works on all of them. What it costs is the stub's code signature, which the
--- caller repairs afterwards on the platforms that check.
local function stampBinary(stubText, payload)
    local offset = #stubText
    local trailer = PAYLOAD_MAGIC
        .. littleEndian(PAYLOAD_VERSION, 4)
        .. littleEndian(0, 4)
        .. littleEndian(offset, 8)
        .. littleEndian(#payload, 8)
        .. digestPrefix(hash.sha256(payload), 8)
        .. littleEndian(TRAILER_LENGTH, 8)
    assert(#trailer == TRAILER_LENGTH, "the trailer is a fixed size")
    return stubText .. payload .. trailer
end

--- Whether this machine is the one that cares about signatures.
local function onMacOS()
    if package.config:sub(1, 1) == "\\" then return false end
    local _, kernel = process.capture({"uname", "-s"})
    return kernel ~= nil and kernel:find("Darwin") ~= nil
end

--- Writes `payload` into a copy of the stub at `output`.
---
--- The signature is not touched, and on macOS that is the whole trick. A stub
--- arrives ad-hoc signed, and its signature covers the image up to a recorded
--- code limit; bytes appended past that limit are outside what was signed, and
--- the kernel loads the image regardless. Stripping the signature instead gets
--- the binary killed on arm64 before `main` runs, and re-signing afterwards is
--- refused outright — `codesign` will not accept a Mach-O with anything after
--- its signature. Doing nothing is what works.
---
--- What that costs is `codesign --verify`, which reports strict validation
--- failure on the result, and with it notarization. A binary handed to somebody
--- else's Mac needs a signer that can sign over the payload rather than around
--- it; see [distribution.md](../../../docs/distribution.md).
local function stampFile(output, stubText, payload)
    local written, writeErr = writeFile(output, stampBinary(stubText, payload))
    if not written then return nil, tostring(writeErr) end
    local code, chmodErr = process.capture({"chmod", "+x", output})
    if code ~= 0 then
        return nil, "cannot make " .. output .. " executable: "
            .. tostring(chmodErr)
    end
    return true
end


package_.longString = longString
package_.entryModule = entryModule
package_.bundleText = bundleText
package_.bundleOutput = bundleOutput
package_.stampFile = stampFile

return package_
