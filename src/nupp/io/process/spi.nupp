module nupp.io.process.spi

--[[
Implementation interface for process transports.

Importing this declaration starts no child. Every operation receives the
retained provider table as its first argument. Options, Exit, and Interest use
the canonical declarations in [](nupp.io.process.types).

Spawn returns the child owner, optional stdin/stdout/stderr handles, process ID,
and optional failure message. Pipes and process lifetime are separate resources:
closeStream releases a pipe, while reap releases the child owner after settlement.
Construct exit results with `nupp.io.process.types.exited` so callers receive the
shared identity and timeout/killed semantics.

Readiness probes must distinguish pending input from EOF and backpressure from a
closed pipe. waitReady services the requested read/write interests and child
completion for a bounded interval; now supplies its monotonic millisecond clock.
Process cleanup must remain valid after cancellation, kill, and partial spawn.
]]

local {type Options, type Exit, type Interest} = require("nupp.io.process.types")

export interface Provider
    @readonly
    priority: integer?

    --- Returns child, stdin, stdout, stderr, pid, and error in that order.
    --- Absent or inherited pipes have nil handles; failure has no child owner.
    @readonly
    spawn: function(Provider, Options): (any?, any?, any?, any?, integer, string?)

    --- Returns the canonical Exit once available, or nil while the child runs.
    @readonly
    poll: function(Provider, any): (Exit?)

    --- Requests termination; the boolean chooses forced termination.
    --- The child still requires settlement and reap.
    @readonly
    kill: function(Provider, any, boolean): nil

    --- Reads at most the requested byte count. An empty string means pending;
    --- nil means EOF. Report transport failures by raising.
    @readonly
    read: function(Provider, any, integer): (string?)

    --- Optionally reads directly into caller-owned native storage. Zero bytes with
    --- false means pending; zero bytes with true means EOF.
    @readonly
    readInto: (
        function(self: Provider, stream: any, borrows destination: uint8[?], wanted: integer): (integer, boolean)
    )?

    --- Returns accepted bytes and whether the pipe is gone.
    --- Zero bytes with false means backpressure; true means the pipe is closed.
    @readonly
    write: function(Provider, any, string): (integer, boolean)

    --- Optionally accepts bytes directly from caller-owned native storage. The
    --- provider may use the pointer only for the duration of this call.
    @readonly
    writeFrom: (
        function(
            self: Provider,
            stream: any,
            borrows source: const uint8[?],
            offset: integer,
            count: integer
        ): (integer, boolean)
    )?

    --- Releases one pipe handle; repeated release must be harmless.
    @readonly
    closeStream: function(Provider, any): (boolean, string?)

    --- Releases the settled child owner; repeated release must be harmless.
    @readonly
    reap: function(Provider, any): (boolean, string?)

    --- Returns monotonic milliseconds for process deadlines.
    @readonly
    now: function(Provider): number

    --- Waits for the Interest read/write sets or child completion up to the
    --- requested millisecond interval, returning the number of ready interests.
    @readonly
    waitReady: function(Provider, Interest, number): integer
end
