module nupp.io.process

--[[
Starts a child process and drains its streams without deadlocking.

```nupp
local process = nupp.io.process

local child = assert(process.spawn({args = {"cc", "--version"}}))
local result = assert(child:communicate())
print(result.output)
child:close()
```

`spawn` returns nil and a reason when the child cannot be started, the way every
other acquisition of an operating-system resource does, and raises only for
options that could never describe a child.

A child and its streams are owners. See
[ownership.md](docs/learn/runtime/ownership/borrowing.md) for the contract they are handed
out under.
]]

local spi = require("nupp.spi")
local target = require("nupp.runtime.target")

const io = require("nupp.io")
const {type Reader as Reader2} = require("nupp.io")
const {type Buffer} = require("nupp.io")
const {type Writer as Writer2} = require("nupp.io")

local suspension = require("nupp.suspension")
local physical = require("nupp.runtime.storage")
local span = require("nupp.mem.span")
local spanStringValue: function(borrows source: const uint8[?], count: integer): string = physical.string as any

const contract = require("nupp.io.process.spi")
local provider: contract.Provider = do
    const chosen = spi.select(spi.load(contract.Provider))
    if chosen ~= nil then
        yield chosen
    end
    assert(target.host == "native", "nupp.io.process: no implementation is available")
    yield _G.require("nupp.runtime.provider.nativeprocess") as contract.Provider
end
local process = {}
const shared = require("nupp.io.process.types")

----------------------------------------------------------------------------
-- What a process is described by
----------------------------------------------------------------------------

--- Where a stream goes: a pipe this process reads or writes, the parent's own
--- stream, or nothing at all.
type process.StreamMode = shared.StreamMode

--- Where standard error goes, which adds the option to join standard output.
type process.ErrorMode = shared.ErrorMode

--- How a child was asked to be started.
type process.Options = shared.Options

--- Controls a complete duplex exchange.
type process.CommunicateOptions = shared.CommunicateOptions

--- How a child ended.
type process.Exit = shared.Exit

process.Exit = shared.Exit

--- A completed duplex exchange.
type process.Result = shared.Result

process.Result = shared.Result

-- Declared ahead of the records, whose method bodies reach them.
-- How many bytes one read asks for. Large enough that a busy pipe empties in a pass or
-- two, small enough that a quiet one costs a small buffer rather than a large one.
local READ_LIMIT: integer = 65536

-- The longest single wait a stream read asks for, which is the longest a timeout
-- can be.
local FOREVER_MS: integer = 2147483647

----------------------------------------------------------------------------
-- Streams
----------------------------------------------------------------------------

--- @raises string when value is not a positive integer
local function positive(value: integer, what: string, level: integer): integer
    if value ~= math.floor(value) or value < 1 then
        error("nupp: " .. what .. " must be a positive integer", level)
    end

    return value
end

local function spanString(borrows source: span.ByteSpan): string
    local pointer = source:ref()
    return spanStringValue(pointer, #source)
end

local progressed, releasePump, await, pumpOnce
-- Typed where it is declared, because `communicate` hands it a local function that
-- borrows the child's streams, and a borrow may not cross an untyped call.
local awaitTick: function(self: any, operation: string, scoped interest: function(): shared.Interest): nil
local validateOptions: function(options: process.Options): nil
local releaseStream: function(borrows stream: process.Reader | process.Writer | nil): nil

--- One of a child's readable streams.
---
--- Its waiting `read` and its nonblocking `poll` are both here on purpose. A caller
--- draining several streams at once cannot wait on any one of them, because waiting
--- on one is exactly what starves the others, which is the whole reason
--- `communicate` can drain three pipes without deadlocking.
---
--- `read` is the `nupp.io.Reader` operation and waits as long as the stream stays
--- open: the child's deadline in `Options.timeoutMs`, and the enclosing task scope's
--- deadline, are what bound it. `poll` is the concrete nonblocking operation the
--- combined drain needs; generic readers are not widened with readiness operations.
---
--- The tolerance that does exist is narrow and worth naming exactly: closing the same
--- *live opaque handle* twice is harmless, because the second call finds the stream
--- already released and says so. Destroying a handle while a borrowed reference
--- still exists leaves that reference reading freed memory, which no amount of care
--- at the call site can make safe.
---
--- Borrowing the record through `asReader` keeps a single owner and makes its lifetime
--- a question about Nupp values, which the checker can answer.
record process.Reader is Reader2
    @private owner: any
    @private handle: any
    @private closed: boolean
    @private eof: boolean

    --- Takes what a stream has without waiting, as `poll` returns it: the
    --- bytes, or nil and whether the stream has ended. Shared by every read, so
    --- end of stream has one place that decides it.
    --- @raises string when the provider returns an invalid result
    @private takeNow: function(self: process.Reader, wanted: integer): (string?, boolean)

    --- Whether the far end has finished and every byte it sent has been taken,
    --- or this end has been closed. A read returns empty exactly when this is
    --- true.
    function isEnded(self): boolean
        return self.closed or self.eof
    end

    --- Whether this end has been closed.
    function isReleased(self): boolean
        return self.closed
    end

    --- Takes whatever is available: the bytes, or nil when there are none, with
    --- whether the stream has ended as the second result.
    ---
    --- Nil with `false` is "nothing yet" and nil with `true` is the end, so the two
    --- are never the same answer. Without `timeoutMs` this does not wait, which is the
    --- half of reading `communicate` needs so that one quiet stream does not stop it
    --- serving another. With it, this waits up to that many milliseconds for bytes
    --- or the end, for a caller that has other work to come back to.
    ---
    --- `limit` caps how many bytes to take, defaulting to a whole pipe's worth. Zero
    --- and negative limits read one byte: the platform is where a count stops being a
    --- number and becomes a buffer size, and a signed zero or minus one arriving at a
    --- native size conversion is either an empty read that looks like end of stream or
    --- an enormous one. `read` passes its caller's count straight through.
    --- @param self this stream
    --- @param limit the most bytes to take
    --- @param timeoutMs how long to wait for bytes or the end, or nothing to not wait
    --- @return the bytes, or nil when none are available
    --- @return whether the stream has ended
    --- @raises string when the provider returns an invalid result, or timeoutMs is
    ---     outside 0 through 2147483647
    function poll(self, limit: integer?, timeoutMs: integer?): (string?, boolean)
        local wanted = math.floor(limit or READ_LIMIT)
        if wanted < 1 then
            wanted = 1
        end
        if timeoutMs == nil or timeoutMs == 0 then
            return self:takeNow(wanted)
        end
        if timeoutMs < 0 or timeoutMs > 2147483647 or math.floor(timeoutMs) ~= timeoutMs then
            error("nupp: process poll timeout must be 0 through 2147483647 milliseconds", 2)
        end

        local chunk: string? = nil
        local ended = false
        await(
            self.owner,
            "process stream read",
            function(): boolean
                local got, over = self:takeNow(wanted)
                chunk = got
                ended = over

                return got ~= nil or over
            end,
            function(): shared.Interest
                -- This stream, and the child: end of stream is something the child's
                -- ending produces, so a reader that only asked about the pipe could
                -- sleep through the very event that answers it.
                return new shared.Interest(child = self.owner.handle, read = {self.handle}, write = {})
            end,
            self.owner.backend:now() + timeoutMs
        )

        return chunk, ended
    end

    --- Reads up to `count` bytes, suspending until some arrive. Returns empty
    --- at the end of the stream and nil with a reason once this end is closed.
    --- @raises string when count is not a positive integer
    function read(exclusive self, count: integer): (string?, string?)
        if self.closed then
            return nil, "the process reader is closed"
        end
        local wanted = positive(count, "process reader count", 2)
        -- The longest wait `poll` takes, repeated: a read waits for as long as the
        -- stream stays open, and what bounds it is the child's deadline and the task
        -- scope's, not a timer of its own.
        while true do
            local chunk, ended = self:poll(wanted, FOREVER_MS)
            if chunk ~= nil then
                return chunk
            end
            if ended then
                if self.closed then
                    return nil, "the process reader is closed"
                end

                return ""
            end
        end
    end

    --- @raises string when the destination is empty
    function readSpan(exclusive self, exclusive destination: span.Writable<uint8>): (integer?, string?)
        local wanted = positive(#destination, "process reader destination length", 2)
        local chunk, reason = self:read(wanted)
        if chunk == nil then
            return nil, reason
        end
        local input = span.fromString(chunk)
        for index = 1, #chunk do
            destination[index] = input[index]
        end

        return #chunk
    end

    --- @raises string when offset is negative or count is not a positive integer
    function readInto(
        exclusive self,
        exclusive destination: Buffer,
        offset: integer?,
        count: integer?
    ): (integer?, string?)
        local at = offset or 0
        if at < 0 or at ~= math.floor(at) then
            error("nupp: process reader destination offset must be a non-negative integer", 2)
        end
        local wanted = positive(count or READ_LIMIT, "process reader count", 2)
        local chunk, reason = self:read(wanted)
        if chunk == nil then
            return nil, reason
        end
        if #chunk == 0 then
            return 0
        end
        local input = span.fromString(chunk)
        local lease = destination:reserveWrite(at, wanted)
        do
            local output = lease:span()
            for index = 1, #chunk do
                output[index] = input[index]
            end
            nupp.drop(output)
        end
        lease:commit(#chunk)

        return #chunk
    end

    function transferTo(exclusive self, exclusive destination: Writer2): (integer?, string?)
        local total: integer = 0
        while true do
            local chunk, reason = self:read(READ_LIMIT)
            if chunk == nil then
                return nil, reason
            end
            if #chunk == 0 then
                return total
            end
            local wrote, failure = destination:write(chunk)
            if not wrote then
                return nil, failure
            end
            total = total + #chunk
        end
    end

    --- Borrows this stream through the shared completion-oriented contract.
    function asReader(borrows self): Reader2 borrows (self)
        return self
    end

    --- Closes this end.
    ---
    --- Idempotent. Closed-ness follows ownership rather than success. A backend that
    --- gave the stream up and then complained has still given it up, so this end is
    --- shut and the complaint is only reported; one that kept the stream leaves this
    --- end open.
    --- @raises string when the platform reported a problem, released or not
    function close(takes self): nil
        releaseStream(self)
    end
end

--- A child's writable stream.
---
--- `offer` is the nonblocking half, for the same reason the reader has `poll`: the
--- prelude's `nupp.io.Writer.write` writes the whole value, which a drain loop serving
--- three pipes cannot afford to wait for. The completion-oriented `write` remains the
--- ordinary `nupp.io.Writer` operation; `offer` is concrete and additional.
record process.Writer is Writer2
    @private owner: any
    @private handle: any
    @private closed: boolean

    --- Whether the far end has gone, which is not the same as this end being shut.
    --- `closed` means the platform has released this stream; `gone` means nobody is
    --- reading the far end any more. A broken pipe sets only `gone`, because this end
    --- is still ours to close.
    @private gone: boolean

    --- Whether the far end has gone, so that no amount of waiting will deliver another
    --- byte, or this end has been closed.
    function isEnded(self): boolean
        return self.closed or self.gone
    end

    --- Whether this end has been closed.
    function isReleased(self): boolean
        return self.closed
    end

    --- Writes what the pipe will take without waiting. Returns how many bytes
    --- went, which may be none and may be fewer than offered.
    --- @raises string when the provider returns an invalid result
    function offer(self, data: string): integer
        if self.closed or self.gone or #data == 0 then
            return 0
        end
        local sent, gone = self.owner.backend:write(self.handle, data)
        if type(sent) ~= "number" or sent < 0 or sent > #data or sent ~= math.floor(sent) then
            error("nupp: process provider returned an invalid write count", 2)
        end
        if type(gone) ~= "boolean" then
            error("nupp: process provider returned an invalid closed-pipe status", 2)
        end
        if gone then
            -- Nobody is reading and nobody will. Recording it is what stops a writer
            -- waiting on room that will never come; the bytes that did go still count,
            -- and this stream is still open and still ours to close.
            self.gone = true
        end

        return sent
    end

    --- Writes every byte, suspending as often as the pipe makes it. Returns how
    --- many went, which is all of them unless the far end went away or a bound
    --- ran out first.
    ---
    --- `deadline` is a time in the [](nupp.time.now) domain after which no more is
    --- sent, however the child is keeping up. `stallTimeoutMs` bounds a period with no
    --- progress instead, so a child that keeps taking bytes keeps the write going
    --- until the deadline. Without either, only the child's own deadline and the
    --- enclosing task scope's bound the wait.
    --- @param self this stream
    --- @param data the bytes to send
    --- @param deadline when to stop, in the monotonic clock's milliseconds
    --- @param stallTimeoutMs how long the pipe may take nothing before giving up
    --- @return how many bytes went
    function send(self, data: string, deadline: number?, stallTimeoutMs: integer?): integer
        if self.closed or self.gone then
            return 0
        end
        local sent = 0
        local before = 0

        local function interest(): shared.Interest
            -- Room in this pipe, and the child: a child that exits makes every
            -- remaining write impossible, which is an answer too.
            return new shared.Interest(child = self.owner.handle, read = {}, write = {self.handle})
        end

        -- Both of these are written above the loop rather than in it, so the loop holds
        -- no function to build. A loop that builds one is a loop LuaJIT never compiles.
        -- What the pass they belong to varies by is `sent` and `before`, and a name
        -- declared out here is the same cell every pass.
        local function offered(): boolean
            if self.closed or self.gone then
                return true
            end
            sent = sent + self:offer(data:sub(sent + 1))

            -- Return after each piece, not only after the whole value, so a stall
            -- bound measures one period with no progress rather than the whole write.

            return sent > before
        end

        while sent < #data and not self.closed and not self.gone do
            local now = self.owner.backend:now()
            -- Checked here as well as by the wait, because a pipe that always takes
            -- something never makes the wait look at the clock.
            if deadline ~= nil and now >= deadline then
                break
            end
            before = sent
            local stopAt = deadline
            if stallTimeoutMs ~= nil then
                local stalled = now + stallTimeoutMs
                if stopAt == nil or stalled < stopAt then
                    stopAt = stalled
                end
            end
            local completed = await(self.owner, "process stream write", offered, interest, stopAt)
            if not completed then
                break
            end
        end

        return sent as integer
    end

    --- Writes every byte, suspending until the pipe has taken them all.
    ---
    --- Bounded the way `read` is: by the child's deadline and the enclosing task
    --- scope's. `send` takes an explicit deadline or stall bound for a caller that
    --- needs one of its own.
    function write(exclusive self, bytes: string): (boolean, string?)
        if self.closed then
            return false, "the process writer is closed"
        end
        if self.gone then
            return false, "the child is no longer reading this stream"
        end
        local ok, sent = pcall(function(): integer
            return self:send(bytes)
        end)
        if not ok then
            return false, tostring(sent)
        end
        if sent ~= #bytes then
            if self.gone then
                return false, "the child stopped reading before every byte was written"
            end
            return false, "the process writer was closed before every byte was written"
        end

        return true
    end

    function writeSpan(exclusive self, borrows source: span.ByteSpan): (integer?, string?)
        local count = #source
        local wrote, reason = self:write(spanString(source))
        if not wrote then
            return nil, reason
        end

        return count
    end

    function flush(self): (boolean, string?)
        if self.closed then
            return false, "the process writer is closed"
        end
        if self.gone then
            return false, "the child is no longer reading this stream"
        end

        return true
    end

    --- Borrows this stream through the shared completion-oriented contract.
    function asWriter(borrows self): Writer2 borrows (self)
        return self
    end

    --- Closes this end. Idempotent, on the same terms as the reader's: closed-ness
    --- follows what the platform released, not whether it complained, so a stream
    --- already given up is never offered to a retry. Closing a child's stdin is how it
    --- is told there is no more input.
    --- @raises string when the platform reported a problem, released or not
    function close(takes self): nil
        releaseStream(self)
    end
end

function process.Reader.takeNow(self: process.Reader, wanted: integer): (string?, boolean)
    if self.closed or self.eof then
        return nil, true
    end
    local got = self.owner.backend:read(self.handle, wanted)
    if got == nil then
        self.eof = true

        return nil, true
    end
    if type(got) ~= "string" then
        error("nupp: process provider returned a non-string read result", 3)
    end
    if #got > wanted then
        error("nupp: process provider returned more bytes than requested", 3)
    end
    if #got == 0 then
        return nil, false
    end

    return got, false
end

-- Releases one stream, reader or writer: the two share every field this touches.
releaseStream = function(borrows stream: process.Reader | process.Writer | nil): nil
    if stream == nil or stream.closed then
        return
    end
    -- `closeStream` is return-only, so a raise is a backend breaking its contract
    -- rather than an outcome. Since an error says nothing about whether the
    -- stream is still ours, the safe reading is that it is gone: retaining one
    -- native handle is a bounded cost, and retrying a returned handle is not.
    local ok, released, why = pcall(function(): (boolean?, string?)
        return stream.owner.backend:closeStream(stream.handle)
    end)
    if not ok then
        stream.closed = true
        error(
            (
                "nupp: closing a process stream raised: %s"
            ):format(released == nil and "without saying why" or tostring(released)),
            0
        )
    end
    -- Set before the raise below, and deliberately: the error is what happened,
    -- `closed` is what is now true, and the second outlives the first.
    stream.closed = released == true
    if why == nil and released ~= true then
        -- A refusal that named no reason. The contract asks for one, but a caller
        -- returning here believing the stream shut is the worst of the outcomes
        -- available, so the boundary supplies what the backend did not.
        why = "the platform did not release the process stream and did not say why"
    end
    if why ~= nil then
        -- Raised rather than answered, because `close` answers nothing. The status
        -- stops here and becomes an error, which is what a teardown is already
        -- prepared to catch.
        error(("nupp: could not close a process stream: %s"):format(why), 0)
    end
end

local newReader: function(owner: any, handle: any): process.Reader?
local newWriter: function(owner: any, handle: any): process.Writer?

----------------------------------------------------------------------------
-- A running process
----------------------------------------------------------------------------

-- What a child's streams and its waits share with it: the platform, the child
-- handle and where its teardown has got to. Kept apart from the owner so a stream
-- can reach it without holding a second reference to the owner.
local record Child
    backend: contract.Provider
    handle: any
    deadline: number?
    exit: process.Exit?

    --- Whether the whole teardown finished: every stream released, the pump released,
    --- and the child handle released. The aggregate, and what makes a repeat call a
    --- no-op.
    reaped: boolean

    --- Whether the child *handle* has been given back, which is a smaller fact than
    --- `reaped` and has to be tracked apart from it. A teardown where a stream close
    --- complained still has a child to release, and a retry that had already released
    --- it must not ask again, because the native process handle was already returned.
    childReleased: boolean

    --- Whether a teardown is in progress. Separate from `reaped`, which means it
    --- finished: a close that failed part way must be retryable rather than silently
    --- successful.
    closing: boolean

    --- Which coroutine is running that teardown, so a second call can tell whether it
    --- is the same frame coming back around or a different one arriving. Nil on the
    --- main coroutine, which is why `closing` is the flag and this is only the owner.
    closingBy: any

    pump: any

    --- Whether the deadline is what ended it, remembered so the exit can say so.
    timedOut: boolean
end

--- A running child, and the obligation to end it.
---
--- The child is an owner: closing it ends the process, waits for the exit, and
--- releases every stream, and the same runs when its scope ends. Reading a stream
--- or waiting for the exit suspends, so a caller under a scheduler keeps its frame.
record process.Process is nupp.Closeable
    @private state: Child

    --- Operating-system process identifier.
    pid: integer

    --- Its standard input, when it was piped.
    stdin: process.Writer?

    --- Its standard output, when it was piped.
    stdout: process.Reader?

    --- Its standard error, when it was piped.
    stderr: process.Reader?

    --- Whether it is still running, enforcing an elapsed process deadline first.
    function isRunning(self): boolean
        if self.state.exit ~= nil then
            return false
        end
        pumpOnce(self.state)

        return self.state.exit == nil
    end

    --- Waits for it to end and returns how.
    ---
    --- Suspends while it runs.
    function wait(self): process.Exit
        await(
            self.state,
            "process wait",
            function(): boolean
                return self.state.exit ~= nil
            end,
            function(): shared.Interest
                -- The child alone. Its streams are deliberately left out: output nobody
                -- is reading stays ready forever, so asking about it here would turn
                -- this sleep into a spin. The cost is that waiting without draining can
                -- fill a pipe and stall, which is exactly what `communicate` is for.
                return new shared.Interest(child = self.state.handle, read = {}, write = {})
            end
        )
        if self.state.timedOut and self.state.exit ~= nil then
            self.state.exit.timedOut = true
        end

        return self.state.exit as process.Exit
    end

    --- Asks the direct child to end; `force` insists. Descendants keep their
    --- ordinary operating-system lifetime. Returns whether the request was
    --- made.
    function kill(self, force: boolean?): (boolean, io.Error?)
        if self.state.exit ~= nil then
            return true
        end
        local ok, problem = pcall(function(): nil
            self.state.backend:kill(self.state.handle, force == true)
        end)
        if not ok then
            return false, io.toError(problem == nil and "the process could not be terminated" or tostring(problem))
        end

        return true
    end

    --- Writes input, closes stdin, drains stdout and stderr, and waits for the
    --- exit. Returns the complete exchange or a reason it could not be
    --- completed.
    ---
    --- One combined step per pass: offer some input, take whatever each output has,
    --- suspend only when none of the three moved.
    function communicate(self, options: process.CommunicateOptions?): (process.Result?, io.Error?)
        local ok, answer = pcall(function(): process.Result
            local given = options or {}
            local input = given.input
            local pending: string
            if input == nil then
                pending = ""
            elseif type(input) == "string" then
                pending = input as string
            elseif type(input) == "table" and type((input as any).getString) == "function" then
                pending = (input as any):getString()
                if type(pending) ~= "string" then
                    error("nupp: process input getString must return a string", 2)
                end
            else
                error("nupp: process input must be a string, Buffer, or ByteView", 2)
            end
            local maximum = given.maxOutputBytes or 268435456
            if type(maximum) ~= "number" or maximum < 0 or maximum ~= math.floor(maximum) then
                error("nupp: process maximum output must be a non-negative integer", 2)
            end
            local stdin = nupp.borrow(self.stdin)
            local stdout = nupp.borrow(self.stdout)
            local stderr = nupp.borrow(self.stderr)
            local sent = 0
            local out, err = {}, {}
            local outputBytes = 0

            local function inputDone(): boolean
                -- Gone counts as done: there is nobody to deliver the rest to.
                return stdin == nil or stdin.closed or stdin.gone
            end

            local function outputDone(): boolean
                return (stdout == nil or stdout.eof or stdout.closed) and (stderr == nil or stderr.eof or stderr.closed)
            end

            local function idle(): boolean
                return (inputDone() and outputDone()) or self.state.exit ~= nil and outputDone()
            end

            -- A child that has ended will never read again, so whatever is left of the
            -- input is undeliverable and holding its stdin open says otherwise. Closing
            -- it here keeps this function's promise that stdin is closed by the time it
            -- returns, including when the child finished early.
            local function abandonInput(): nil
                if stdin ~= nil and not stdin.closed then
                    releaseStream(stdin)
                end
            end

            -- Everything a quiet pass would have used: the streams still worth
            -- draining, room for whatever input is left, and the child. This is the one
            -- wait that may ask about the outputs, because it is the one that reads
            -- them every pass, so a ready stream leads to work rather than straight
            -- back here.
            --
            -- Written here rather than at the wait it belongs to, because that wait is
            -- inside the loop, and a function built inside a loop is one LuaJIT never
            -- compiles. It reads what varies through names the loop shares with it.
            local function interest(): shared.Interest
                local read: {any} = {}
                if stdout ~= nil and not stdout.eof and not stdout.closed then
                    read[#read + 1] = stdout.handle
                end
                if stderr ~= nil and not stderr.eof and not stderr.closed then
                    read[#read + 1] = stderr.handle
                end
                local write: {any} = {}
                -- Gone is excluded the way closed is: a broken pipe polls ready
                -- forever, so putting it in the write set would make every wait
                -- return immediately and the drain loop spin until the outputs
                -- reach end of file.
                if stdin ~= nil and not stdin.closed and not stdin.gone and sent < #pending then
                    write[#write + 1] = stdin.handle
                end

                return new shared.Interest(child = self.state.handle, read = read, write = write)
            end

            while not (inputDone() and outputDone()) do
                local moved = false
                if stdin ~= nil and not stdin.closed then
                    if sent < #pending then
                        local wrote = stdin:offer(pending:sub(sent + 1))
                        if wrote > 0 then
                            sent = sent + wrote
                            moved = true
                        end
                    end
                    if sent >= #pending then
                        -- Every byte delivered: tell the child there is no more, or it
                        -- reads to end of file forever and nobody's output ever
                        -- arrives.
                        releaseStream(stdin)
                        moved = true
                    end
                end
                if stdout ~= nil and not stdout.eof and not stdout.closed then
                    local chunk, ended = stdout:poll()
                    if chunk ~= nil or ended then
                        if chunk ~= nil then
                            outputBytes = outputBytes + #chunk
                            if outputBytes > maximum then
                                self:kill(true)
                                error("process output exceeds the configured maximum", 0)
                            end
                            out[#out + 1] = chunk
                        end
                        moved = true
                    end
                end
                if stderr ~= nil and not stderr.eof and not stderr.closed then
                    local chunk, ended = stderr:poll()
                    if chunk ~= nil or ended then
                        if chunk ~= nil then
                            outputBytes = outputBytes + #chunk
                            if outputBytes > maximum then
                                self:kill(true)
                                error("process output exceeds the configured maximum", 0)
                            end
                            err[#err + 1] = chunk
                        end
                        moved = true
                    end
                end
                if not moved then
                    -- All three quiet. This is a *retry*, not a condition wait. Only
                    -- the next read can say whether it would now succeed; waiting for
                    -- a predicate only this caller can test is how this deadlocked.
                    -- Give the pumps one pass, then come back.
                    if idle() then
                        break
                    end
                    awaitTick(self.state, "process communicate", interest)
                end
            end

            abandonInput()

            return new process.Result(output = table.concat(out), errorOutput = table.concat(err), exit = self:wait())
        end)
        if not ok then
            return nil, io.toError(
                answer == nil and "process communication failed without saying why" or tostring(answer)
            )
        end

        return answer as process.Result
    end

    --- Closes every stream, ends the child if it is still running, waits for it to
    --- actually finish, and releases it. Idempotent, and retryable: a teardown that
    --- could not finish leaves each piece's own flag, and the next call skips whatever
    --- is already given back.
    --- @raises string when closing a stream or releasing the child fails
    @private teardown: function(self: process.Process): nil

    --- Closes every stream, ends the child if it is still running, waits for it to
    --- actually finish, and releases it. What runs when the owner leaves its scope.
    ---
    --- Every step is attempted, and the first failure is raised once all of them
    --- have been: a close that stopped at the first would leave the rest held.
    --- @raises string when closing a stream or releasing the child fails
    function close(takes self): nil
        self:teardown()
        if self.stdin ~= nil then
            self.stdin:close()
        end
        if self.stdout ~= nil then
            self.stdout:close()
        end
        if self.stderr ~= nil then
            self.stderr:close()
        end
    end
end

function process.Process.teardown(self: process.Process): nil
    local state = self.state
    if state.reaped then
        return
    end
    if state.closing then
        local runner = coroutine.running()
        if runner == state.closingBy then
            -- The same frame come back around: the waits below drive the pump, and
            -- something it drives has called in here. One teardown is enough, and
            -- this one is it. Returning is the only option, since waiting would
            -- be waiting on itself.
            return
        end

        if not suspension.handled() then
            -- Another coroutine, and nothing to schedule it back. The teardown
            -- holding this child belongs to a frame that is somewhere below this
            -- one on the stack, since it can only have got here by being resumed
            -- from inside that teardown, so waiting would be waiting for a frame
            -- that cannot run until this one returns. Saying so beats hanging.
            error(
                "nupp: process close arrived from another coroutine while a teardown was "
                .. "running, with no handler to schedule it",
                0
            )
        end

        -- A different caller under a scheduler, and it must not be told the child
        -- is released while the teardown is still running. Answering "done" is what
        -- lets the owner's scope end, and the scope ending is what runs `close`, so
        -- a premature yes has the next toucher on a handle already given back. It
        -- waits for whoever holds the teardown, then answers on the same terms as
        -- any other close, either finished or free to try again.
        await(
            state,
            "process close",
            function(): boolean
                return not state.closing
            end,
            function(): shared.Interest
                return new shared.Interest(child = state.handle, read = {}, write = {})
            end
        )
        if state.reaped then
            return
        end

        -- The holder's attempt failed and left it open. This caller inherits it.
    end
    state.closing = true
    state.closingBy = coroutine.running()
    -- Every step is attempted and the first failure raised at the end. Stopping at
    -- the first would leave the rest of the child's resources held by a process
    -- that has decided it is finished with them; swallowing them all would report
    -- a clean close that never happened.
    --
    -- Only raises are caught here, and that is now the whole story: a stream close
    -- turns its status into one at its own edge, and the reap is judged below
    -- rather than through this, because it alone has release state worth reading.
    local firstError: any = nil

    local function attempt(step: function(): nil): nil
        local ok, raised = pcall(step)
        if not ok and firstError == nil then
            -- `error(nil)` is a real thing a broken backend can do, and it arrives
            -- here as a failure with nothing to say. Left as nil it would read as
            -- no failure at all, and the teardown would report a clean close.
            firstError = raised == nil and "a teardown step failed without saying why" or raised
        end
    end

    -- Closed one at a time rather than through a list: a reader and a writer are
    -- different types, and a union of their `close` methods is not one callable.
    if self.stdin ~= nil then
        attempt(function(): nil
            releaseStream(self.stdin)
        end)
    end
    if self.stdout ~= nil then
        attempt(function(): nil
            releaseStream(self.stdout)
        end)
    end
    if self.stderr ~= nil then
        attempt(function(): nil
            releaseStream(self.stderr)
        end)
    end
    if state.exit == nil then
        attempt(function(): nil
            -- Ending rather than orphaning: a child outliving the scope that
            -- started it is a leak nobody sees until the machine runs out of them.
            state.backend:kill(state.handle, true)
            -- Terminating takes as long as it takes, so this waits for the exit
            -- rather than asking the platform to reap something still dying. Every
            -- stream close has been attempted by now. Attempted, not necessarily
            -- done, since one may have refused and stayed ours, so the child is
            -- what this waits on and the only thing that can advance it.
            await(
                state,
                "process close",
                function(): boolean
                    return state.exit ~= nil
                end,
                function(): shared.Interest
                    return new shared.Interest(child = state.handle, read = {}, write = {})
                end
            )
        end)
    end
    attempt(function(): nil
        releasePump(state)
    end)

    -- Attempted whatever went before it, and this is the whole point of attempting
    -- every step. Skipping the reap because a stream complained leaves a child
    -- handle held by a process that has finished with it, and under an automatic
    -- close there is no binding left to retry through, so "unreaped" would mean
    -- "unreaped forever". A child that has not exited is a different matter: it is
    -- not reapable yet, and asking would be the error.
    if not state.childReleased and state.exit ~= nil then
        -- Not through `attempt`, because reap answers the same two facts a stream
        -- close does and the generic judge only reads one of them. A reap that
        -- released the child and complained anyway is still a reap: the pid is
        -- gone, and asking again would wait on whatever has since been given that
        -- number. So ownership decides the flag and the complaint is only carried.
        local ok, released, reason = pcall(function(): (boolean?, string?)
            return state.backend:reap(state.handle)
        end)
        if not ok then
            -- The same reading as a stream close that raised: no release state came
            -- back, so the child is treated as gone rather than asked about again.
            state.childReleased = true
            if firstError == nil then
                firstError = released == nil and "reaping the child failed without saying why" or released
            end
        else
            state.childReleased = released == true
            if reason ~= nil then
                if firstError == nil then
                    firstError = reason
                end
            elseif released ~= true and firstError == nil then
                firstError = "the platform did not release the child and did not say why"
            end
        end
    end

    -- Cleared either way, so a close that could not finish can be called again
    -- rather than reporting itself done. A retry finds each piece's own flag and
    -- skips whatever is already given back.
    state.closing = false
    state.closingBy = nil
    -- The aggregate, and only now: every stream given back, the pump gone, and the
    -- child handle released. `reaped` answering anything less would let a repeat
    -- call return early with something still held.
    state.reaped = (self.stdin == nil or self.stdin.closed)
        and (self.stdout == nil or self.stdout.closed)
        and (self.stderr == nil or self.stderr.closed)
        and state.pump == nil
        and state.childReleased
    if firstError ~= nil then
        error(firstError, 0)
    end
end

----------------------------------------------------------------------------
-- Pumping and waiting
----------------------------------------------------------------------------

-- Whether the child has ended since last asked.
progressed = function(self: any): integer
    local moved = 0
    if self.exit == nil then
        local ended = self.backend:poll(self.handle)
        if ended ~= nil then
            self.exit = ended
            moved = moved + 1
        end
    end

    return moved as integer
end

-- Whether the deadline has passed, killing the child if it has.
local function enforceDeadline(self: any): boolean
    -- Once. `timedOut` is the guard, and it has to be, because terminating takes as
    -- many polls as it takes: a deadline re-enforced every pump would go on signaling
    -- a process that is already dying, and a backend that treats a second kill as a
    -- fresh request would never get to finish.
    if self.deadline == nil or self.exit ~= nil or self.timedOut then
        return false
    end
    if self.backend:now() < self.deadline then
        return false
    end
    self.timedOut = true
    self.backend:kill(self.handle, true)

    return true
end

-- One pass of everything that could make progress for this child.
--
-- The deadline is enforced here rather than only before parking, so a child producing
-- nothing at all, the case a deadline exists for, still reaches it.
pumpOnce = function(self: any): integer
    local moved = progressed(self)
    if enforceDeadline(self) then
        moved = moved + progressed(self) + 1
    end

    return moved as integer
end

-- The pump this child needs driven while anything is waiting on it.
local function ensurePump(self: any): nil
    if self.pump ~= nil then
        return
    end
    self.pump = suspension.source("nupp.io.process", 50, function(): integer
        return pumpOnce(self)
    end)
end

releasePump = function(self: any): nil
    if self.pump == nil then
        return
    end
    self.pump:release()
    self.pump = nil
end

-- How long a blocking wait gives the platform before coming back to re-check. Long
-- enough that waiting costs nothing, short enough that a deadline is honoured close to
-- when it falls.
local BLOCKING_WAIT_MS = 20

-- Suspends for one pass of the pumps, then returns whatever happened.
--
-- What a drain loop needs. `await` waits for a predicate; a loop that has to *ask* the
-- streams again to find out whether anything changed has no predicate to wait on, and
-- would park forever on one that only its own next attempt could satisfy.
-- Blocks in the platform until something in `interest` moves, then drives one pass.
--
-- Only ever reached with no handler installed. Nobody to yield to, so blocking here is
-- the whole point: `waitReady` sleeps on Rust-owned activity until a child or stream
-- moves, or the timeout passes, where spinning on a non-blocking poll would burn a
-- core to learn nothing.
--
-- Bounded rather than indefinite, because a deadline has to be reached even when the
-- child never speaks again, and never overshooting it: a wait longer than what is left
-- would report the timeout late by however much it overslept.
local function blockOnce(self: any, interest: shared.Interest, stopAt: number?): nil
    local budget = BLOCKING_WAIT_MS
    -- Only until it fires. Once `timedOut` is set the deadline is in the past and
    -- what remains of it is negative forever, so clamping to it would pin every
    -- wait to zero and spin on non-blocking polls until the killed child's exit
    -- is observed.
    if self.deadline ~= nil and not self.timedOut then
        local remaining = self.deadline - self.backend:now()
        if remaining < budget then
            budget = remaining > 0 and remaining or 0
        end
    end
    if stopAt ~= nil then
        local remaining = stopAt - self.backend:now()
        if remaining < budget then
            budget = remaining > 0 and remaining or 0
        end
    end
    self.backend:waitReady(interest, budget)
    pumpOnce(self)
end

awaitTick = function(self: any, operation: string, scoped interest: function(): shared.Interest): nil
    if not suspension.handled() then
        blockOnce(self, interest())

        return
    end
    ensurePump(self)
    const wanted = interest()
    suspension.suspend(operation, function(resume: function(boolean), context: any): function()?
        local passes = 0
        -- Registered until the resumed task runs; a poll before then must not
        -- resume it twice.
        local resumed = false
        local source = context:source(
            "nupp.io.process.tick",
            50,
            function(): integer
                if resumed then
                    pumpOnce(self)

                    return 0
                end
                passes = passes + 1
                -- A quiet first pass leaves the driver its chance to sleep. The second
                -- resumes unconditionally: one pass has happened, which is all this
                -- waits for, and the caller decides whether it was useful.
                if pumpOnce(self) == 0 and passes == 1 then
                    return 0
                end
                resumed = true
                resume(true)

                return 1
            end,
            -- Only the built-in driver calls this, when a task scope runs with no host
            -- beneath it. Without it a drain loop there polled flat out.
            function(waitMs: integer): integer
                self.backend:waitReady(wanted, waitMs)

                return 0
            end
        )

        return function(): nil
            source:release()
        end
    end)
end

-- Suspends until `ready()` answers true, driving the child while it waits.
await = function(
    self: any,
    operation: string,
    ready: function(): boolean,
    scoped interest: function(): shared.Interest,
    stopAt: number?
): boolean
    if ready() then
        return true
    end
    if stopAt ~= nil and self.backend:now() >= stopAt then
        return false
    end
    if not suspension.handled() then
        -- The same reasoning as `awaitTick`: with nobody to yield to, the platform is
        -- asked to sleep rather than the loop asked to spin. Every wait needs this, not
        -- just the drain loop. `wait`, a stream read, a stream write and `close` all
        -- end up here, and each of them polling flat out is the cost this avoids.
        while not ready() do
            if stopAt ~= nil and self.backend:now() >= stopAt then
                return false
            end
            blockOnce(self, interest(), stopAt)
        end

        return true
    end
    ensurePump(self)

    -- What the wait sleeps on, taken afresh before each park: the streams a wait is
    -- interested in change as they end.
    local wanted: shared.Interest? = nil
    local satisfied = false

    -- Built once rather than per pass: this is already the slow path.
    local function subscribe(resume: function(boolean), context: any): function()?
        local resumed = false
        local source = context:source(
            "nupp.io.process.wait",
            50,
            function(): integer
                local moved = pumpOnce(self)
                -- Registered until the resumed task runs; a poll before then must
                -- not resume it twice.
                if resumed then
                    return 0
                end
                if ready() then
                    satisfied = true
                    resumed = true
                    resume(true)

                    return 1
                end
                if stopAt ~= nil and self.backend:now() >= stopAt or moved > 0 then
                    resumed = true
                    resume(true)

                    return 1
                end

                return 0
            end,
            -- A host never calls a source's wait; the built-in driver does, between
            -- quiet passes, when a task scope runs with no host beneath it. Without
            -- one it would poll the child flat out for as long as the child ran.
            function(waitMs: integer): integer
                if wanted ~= nil then
                    self.backend:waitReady(wanted, waitMs)
                end

                return 0
            end
        )

        return function(): nil
            source:release()
        end
    end

    while not ready() do
        if stopAt ~= nil and self.backend:now() >= stopAt then
            return false
        end
        pumpOnce(self)
        if ready() then
            return true
        end
        wanted = interest()
        satisfied = false
        suspension.suspend(operation, subscribe)
        if satisfied then
            return true
        end
    end

    return true
end

-- A stream for a handle the platform gave, or nothing for a stream that was not piped.
newReader = function(owner: any, handle: any): process.Reader?
    if handle == nil then
        return nil
    end

    return new process.Reader(owner = owner, handle = handle, closed = false, eof = false)
end

newWriter = function(owner: any, handle: any): process.Writer?
    if handle == nil then
        return nil
    end

    return new process.Writer(owner = owner, handle = handle, closed = false, gone = false)
end

----------------------------------------------------------------------------
-- Spawning
----------------------------------------------------------------------------

-- Public callers include plain Lua, so the type declaration is not the runtime
-- boundary. Reject programmer mistakes before allocating a native spawn request;
-- platform failures remain the nil-and-reason result of `spawn`.
validateOptions = function(options: process.Options): nil
    local given: any = options
    if type(given) ~= "table" then
        error("nupp: process options must be a table", 3)
    end
    if type(given.args) ~= "table" or #given.args == 0 then
        error("nupp: process args must contain a program", 3)
    end
    local argumentCount = #given.args
    for key in pairs(given.args) do
        if type(key) ~= "number" or key ~= math.floor(key) or key < 1 or key > argumentCount then
            error("nupp: process args must be a dense list", 3)
        end
    end
    for index = 1, #given.args do
        if type(given.args[index]) ~= "string" then
            error(("nupp: process argument %d must be a string"):format(index), 3)
        end
    end
    if given.cwd ~= nil
        and type(given.cwd) ~= "string"
        and (type(given.cwd) ~= "table" or type(given.cwd.toString) ~= "function")
    then
        error("nupp: process cwd must be a string or path", 3)
    end
    if given.env ~= nil and type(given.env) ~= "table" then
        error("nupp: process env must be a table", 3)
    end
    for name, value in pairs(given.env or {}) do
        if type(name) ~= "string" or type(value) ~= "string" then
            error("nupp: process env must have string names and values", 3)
        end
        -- The child would split such a name at its first `=` and see another
        -- variable altogether.
        if name == "" or name:find("=", 1, true) ~= nil then
            error("nupp: process env names must be non-empty and contain no '='", 3)
        end
    end
    if given.clearEnv ~= nil and type(given.clearEnv) ~= "boolean" then
        error("nupp: process clearEnv must be a boolean", 3)
    end
    local streams = {pipe = true, inherit = true, null = true}
    if given.stdin ~= nil and streams[given.stdin] ~= true then
        error("nupp: process stdin must be pipe, inherit, or null", 3)
    end
    if given.stdout ~= nil and streams[given.stdout] ~= true then
        error("nupp: process stdout must be pipe, inherit, or null", 3)
    end
    if given.stderr ~= nil and streams[given.stderr] ~= true and given.stderr ~= "stdout" then
        error("nupp: process stderr must be pipe, inherit, null, or stdout", 3)
    end
    if given.timeoutMs ~= nil
        and (
            type(given.timeoutMs) ~= "number"
            or given.timeoutMs < 0
            or given.timeoutMs > 2147483647
            or math.floor(given.timeoutMs) ~= given.timeoutMs
        )
    then
        error("nupp: process timeout must be 0 through 2147483647 milliseconds", 3)
    end
end

--- Starts a child process.
---
--- The child is an owner: closing it ends the process, waits for the exit, and
--- releases every stream, and the same runs when its scope ends. A child that
--- cannot be started, such as a program that is not there, returns nil and why
--- rather than raising, as `files.open` and `net.connect` do.
---
--- ```nupp:fragment
--- local child = assert(process.spawn({
---     args = {"grep", "-c", "nupp"},
---     stderr = "stdout",
--- }))
--- local result = assert(child:communicate({input = text}))
--- child:close()
--- ```
---
--- @param options what to run and how to connect it
--- @return the child, which the caller owns and must close
--- @return why it could not be started, when unsuccessful
--- @raises string when the options could never describe a child
function process.spawn(options: process.Options): (affine(process.Process)?, io.Error?)
    validateOptions(options)
    local backend = provider
    local handle, inHandle, outHandle, errHandle, pid, problem = backend:spawn(options)
    if handle == nil then
        return nil, io.toError(problem or "the process could not be started")
    end
    local state = new Child(
        backend = backend,
        handle = handle,
        deadline = options.timeoutMs ~= nil and (backend:now() + options.timeoutMs) or nil,
        exit = nil,
        reaped = false,
        childReleased = false,
        closing = false,
        closingBy = nil,
        pump = nil,
        timedOut = false
    )

    return new process.Process(
        state = state,
        pid = pid,
        stdin = newWriter(state, inHandle),
        stdout = newReader(state, outHandle),
        stderr = newReader(state, errHandle)
    )
end

export = process
