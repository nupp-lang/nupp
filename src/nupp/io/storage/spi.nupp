module nupp.io.storage.spi

--[[Implementation interfaces consumed during ordinary module initialization.
Discover with nupp.spi.load; the consumer chooses the unique highest priority.
Omitted priority is zero. Importing these declarations loads no implementation.]]

--- Persistent string key/value storage in the host's application namespace.
---
--- Missing keys return nil. Successful writes, removals, and clearing complete
--- before returning; host-backed implementations may suspend and may raise on
--- quota or access errors. clear affects the host-defined application namespace,
--- not arbitrary storage outside it.
export interface StorageProvider
    readonly priority: integer?

    --- Returns the stored string, or nil when the key is absent.
    readonly get: function(name: string): string?

    --- Stores the complete string value.
    readonly set: function(name: string, value: string): nil

    --- Removes the key; an absent key needs no value.
    readonly remove: function(name: string): nil

    --- Removes all entries in the host-defined application namespace.
    readonly clear: function(): nil
end
