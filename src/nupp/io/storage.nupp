module nupp.io.storage

--[[
Key/value strings that outlive the process.

```nupp
const storage = require("nupp.io.storage")

storage.set("theme", "dark")

print(storage.get("theme"))  -- dark

storage.remove("theme")
```

Keys and values are UTF-8 strings, so anything structured is encoded first --
[](nupp.codec.json) is the usual choice. On a browser host this is
`localStorage`, scoped to the namespace the host chose; anywhere else it is
whichever `host.storage` provider was registered before this module loaded.

The near neighbour in name is [](nupp.util.Store), which is a different thing:
an in-process bag of live values indexed by typed keys, gone when the program
exits. This one persists untyped text between runs.
]]

const contracts = require("nupp.runtime.services.contracts")

const provider: contracts.StorageProvider = contracts.storage:assemble(function(): contracts.StorageProvider
    return contracts.storage:require("nupp.browser")
end)

--- Reads one UTF-8 value, or nil if the key is absent.
export const get: function(name: string): string? = provider.get

--- Writes one UTF-8 value.
export const set: function(name: string, value: string): nil = provider.set

--- Removes one key.
export const remove: function(name: string): nil = provider.remove

--- Removes every key in the selected store.
export const clear: function(): nil = provider.clear
