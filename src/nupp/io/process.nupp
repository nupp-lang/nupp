--[[
Running a child process.

The lifecycle, the streams, and the draining, written once against a backend
that answers in bytes and opaque handles. Platform providers differ in how they
spawn and how they read; they do not differ in what a process is, so nothing
about what a process is lives in any one of them.

Waiting is a suspension. Under a handler -- a scheduler, a game frame -- reading
a pipe parks the caller and the frame keeps running; with none installed the
built-in handler drives the pumps and blocks. The same call either way, which is
the whole reason `nupp.suspension` exists.

Three details are worth stating, because they are the ones a first
implementation gets wrong and this one got two of them wrong before they were
pointed out.

**`communicate` makes one combined step.** Not "write all the input, then read
stdout to the end, then read stderr". A child that reads its input in pieces
while filling stderr deadlocks against every sequential order: the parent blocks
writing input the child is not reading, because the child is blocked writing
output the parent is not reading. The loop attempts all three every pass and
suspends only when none of them moved.

**A deadline has to be checked while suspended.** Checking it before parking and
never again means a quiet child -- one producing nothing at all -- waits past its
deadline forever, which is precisely the case a deadline is for.

**A killed child is not immediately reapable.** Terminating takes as long as it
takes, so closing waits for the exit rather than reaping something still dying.

See `plans/018-suspension.md`, S5.
]]

local suspension = require("nupp.suspension")
local processtypes = require("nupp.io.processtypes")

local process = {}

--- Re-exported so a caller needs one import.
type process.Options = processtypes.Options

--- Re-exported so a caller needs one import.
type process.Exit = processtypes.Exit

--- Re-exported so a caller needs one import.
type process.CommunicateOptions = processtypes.CommunicateOptions

--- Re-exported so a caller needs one import.
type process.Result = processtypes.Result

-- Declared ahead of the records, whose method bodies reach them.
-- How many bytes one read asks for. Large enough that a busy pipe empties in a pass or
-- two, small enough that a quiet one costs a small buffer rather than a large one.
local READ_LIMIT: integer = 65536

local progressed, releasePump, await, awaitTick, pumpOnce, readForCompletion

-- The backend `process.new` uses, installed by whichever platform module is loaded.
-- Kept internal: a caller naming its platform is a caller that has to change when it
-- moves to another one.
local defaultBackend: processtypes.Backend? = nil

local type NativeBackendFactory = {
    new: function(
        exited: function(exitCode: integer, killed: boolean, timedOut: boolean): processtypes.Exit
    ): processtypes.Backend
}

--- One of a child's readable streams.
---
--- Its blocking `read` and its nonblocking `poll` are both here on purpose. A caller
--- draining several streams at once cannot use the blocking form on any of them,
--- because waiting on one is exactly what starves the others -- which is the whole
--- reason `communicate` can drain three pipes without deadlocking.
---
--- The completion-oriented `nupp.io.Reader` methods are the public tecs-compatible
--- surface. `poll` remains alongside them as the concrete nonblocking operation the
--- combined drain needs; generic readers are not widened with readiness operations.
---
--- The tolerance that does exist is narrow and worth naming exactly: closing the same
--- *live opaque handle* twice is harmless, because the second call finds the descriptor
--- already gone and says so. Retrying the raw descriptor underneath is the opposite --
--- that number belongs to whatever the platform has since handed it to. And destroying
--- a handle while a borrowed reference still exists leaves that reference reading freed
--- memory, which no amount of care at the call site can make safe.
---
--- Borrowing the record through `asReader` keeps a single owner and makes its lifetime
--- a question about Nupp values, which the checker can answer.
record process.Reader is nupp.io.Reader
    owner: any
    handle: any
    closed: boolean
    eof: boolean

    --- Maximum time one completion-oriented read may wait.
    timeoutMs: integer

    --- Whether the far end has finished.
    function isEOF(self): boolean
        return self.eof
    end

    --- Whether this end has been closed.
    function isClosed(self): boolean
        return self.closed
    end

    --- Closes this end. Idempotent.
    ---
    --- `closed` follows ownership rather than success. A platform that gave the
    --- descriptor up and then complained has still given it up, so this end is shut and
    --- the complaint is only reported; a platform that failed with the descriptor still
    --- ours leaves this end open, and another attempt is right. Marking a released
    --- descriptor open again is how a retry comes to close whichever unrelated thing
    --- has since been given that number.
    ---
    --- @raises when the platform reported a problem, released or not
    function release(self): nil
        if self.closed then
            return
        end
        -- `closeStream` is return-only, so a raise is a backend breaking its contract
        -- rather than an outcome. Since an error says nothing about whether the
        -- descriptor is still ours, the safe reading is that it is gone: leaking one
        -- descriptor is a bounded cost, and closing whatever has since been given that
        -- number is not.
        local ok, released, why = pcall(function(): (boolean?, string?)
            return self.owner.backend:closeStream(self.handle)
        end)
        if not ok then
            self.closed = true
            error(
                (
                    "nupp: closing a process stream raised: %s"
                ):format(released == nil and "without saying why" or tostring(released)),
                0
            )
        end
        -- Set before the raise below, and deliberately: the error is what happened,
        -- `closed` is what is now true, and the second outlives the first.
        self.closed = released == true
        if why == nil and released ~= true then
            -- A refusal that named no reason. The contract asks for one, but a caller
            -- returning here believing the stream shut is the worst of the outcomes
            -- available, so the boundary supplies what the backend did not.
            why = "the platform did not release the descriptor and did not say why"
        end
        if why ~= nil then
            -- `release` is the internal ownership operation and answers nothing. Its
            -- public `close` wrapper converts the raise back to a status; teardown is
            -- already prepared to catch it here.
            error(("nupp: could not close a process stream: %s"):format(why), 0)
        end
    end

    --- Takes whatever is available without waiting: the bytes, `""` when nothing is
    --- ready yet, or nil at end of stream.
    ---
    --- The non-blocking half of reading, which `communicate` needs so that one quiet
    --- stream does not stop it serving another.
    --- `limit` caps how many bytes to take, defaulting to a whole pipe's worth. It is
    --- here because the shared `nupp.io.Reader` promises "at most `count`". Without the
    --- limit its completion-oriented method would have to keep surplus bytes beside
    --- this record, giving end of stream and closedness two homes. One place decides
    --- both, and the caller says how much it wants.
    ---
    --- Zero and negative limits read one byte, which is what `nupp.io.Reader` says a
    --- non-positive count does. Settled here rather than at the platform because the
    --- platform is where it stops being a number and becomes a buffer size: a signed
    --- zero or minus one arriving at a native size conversion is either an empty read
    --- that looks like end of stream or an enormous one, and neither is worth being
    --- able to ask for. `read` passes its caller's count straight through.
    function poll(self, limit: integer?): string?
        if self.closed or self.eof then
            return nil
        end
        local wanted = limit or READ_LIMIT
        if wanted < 1 then
            wanted = 1
        end
        local got = self.owner.backend:read(self.handle, wanted)
        if got == nil then
            self.eof = true

            return nil
        end

        return got
    end

    --- Reads the next available bytes, suspending until there are some. Answers nil at
    --- end of stream.
    function next(self): string?
        if self.closed or self.eof then
            return nil
        end
        local chunk = nil
        await(
            self.owner,
            "process stream read",
            function(): boolean
                if self.closed or self.eof then
                    return true
                end
                local got = self:poll()
                if got == nil then
                    return true
                end
                if #got > 0 then
                    chunk = got

                    return true
                end

                return false
            end,
            function(): processtypes.Interest
                -- This stream, and the child: end of stream is something the child's
                -- ending produces, so a reader that only asked about the pipe could
                -- sleep through the very event that answers it.
                return new processtypes.Interest(child = self.owner.handle, read = {self.handle}, write = {})
            end
        )

        return chunk
    end

    --- Bounds the next completion-oriented read.
    --- @raises when timeoutMs is outside 0 through 2147483647
    function setTimeout(self, timeoutMs: integer): nil
        if timeoutMs < 0 or timeoutMs > 2147483647 or math.floor(timeoutMs) ~= timeoutMs then
            error("nupp: process reader timeout must be 0 through 2147483647 milliseconds", 2)
        end
        self.timeoutMs = timeoutMs
    end

    function read(self, count: integer): (string?, string?)
        if self.closed then
            return nil, "the process reader is closed"
        end
        local chunk, reason = readForCompletion(self, count < 1 and 1 or count)
        if reason ~= nil then
            return nil, reason
        end

        return chunk or ""
    end

    function readInto(self, destination: nupp.io.Buffer, offset: integer?, count: integer?): (integer?, string?)
        local at = offset or 0
        local wanted: integer = count or READ_LIMIT
        if at < 0 or wanted < 0 then
            error("nupp: process reader destination offset and count must not be negative", 2)
        end
        if wanted == 0 then
            return 0
        end
        local chunk, reason = self:read(wanted)
        if chunk == nil then
            return nil, reason
        end
        if #chunk == 0 then
            return 0
        end
        destination:setString(chunk, at)

        return #chunk
    end

    function transferTo(self, destination: nupp.io.Writer): (integer?, string?)
        local total: integer = 0
        while true do
            local chunk, reason = self:read(READ_LIMIT)
            if chunk == nil then
                return nil, reason
            end
            if #chunk == 0 then
                return total
            end
            local wrote, failure = destination:write(chunk)
            if not wrote then
                return nil, failure
            end
            total = total + #chunk
        end
    end

    function close(self): (boolean, string?)
        local ok, problem = pcall(function(): nil
            self:release()
        end)
        if not ok then
            return false, problem == nil and "the process reader could not close" or tostring(problem)
        end

        return true
    end
end

--- A child's writable stream.
---
--- `offer` and `isGone` are the nonblocking half, for the same reason the reader has
--- `poll`: the prelude's `nupp.io.Writer.write` writes the whole value, which a drain
--- loop serving three pipes cannot afford to wait for. The completion-oriented `write`
--- remains the ordinary `nupp.io.Writer` operation; `offer` is concrete and additional.
record process.Writer is nupp.io.Writer
    owner: any
    handle: any
    closed: boolean

    --- Whether the far end has gone, which is not the same as this end being shut.
    --- `closed` means the platform has released the descriptor; this means nobody is
    --- reading it any more. A broken pipe sets only this, because the descriptor is
    --- still ours to close and skipping that would leak it.
    gone: boolean

    --- Maximum time one completion-oriented write may wait.
    timeoutMs: integer

    --- Whether the far end has gone: the child is no longer reading this, and no
    --- amount of waiting will change that.
    function isGone(self): boolean
        return self.gone
    end

    --- Whether this end has been closed.
    function isClosed(self): boolean
        return self.closed
    end

    --- Closes this end. Idempotent, on the same terms as the reader's: `closed` follows
    --- what the platform released, not whether it complained, so a descriptor already
    --- given up is never offered to a retry. Closing a child's stdin is how it is told
    --- there is no more input.
    ---
    --- @raises when the platform reported a problem, released or not
    function release(self): nil
        if self.closed then
            return
        end
        -- `closeStream` is return-only, so a raise is a backend breaking its contract
        -- rather than an outcome. Since an error says nothing about whether the
        -- descriptor is still ours, the safe reading is that it is gone: leaking one
        -- descriptor is a bounded cost, and closing whatever has since been given that
        -- number is not.
        local ok, released, why = pcall(function(): (boolean?, string?)
            return self.owner.backend:closeStream(self.handle)
        end)
        if not ok then
            self.closed = true
            error(
                (
                    "nupp: closing a process stream raised: %s"
                ):format(released == nil and "without saying why" or tostring(released)),
                0
            )
        end
        -- Set before the raise below, and deliberately: the error is what happened,
        -- `closed` is what is now true, and the second outlives the first.
        self.closed = released == true
        if why == nil and released ~= true then
            -- A refusal that named no reason. The contract asks for one, but a caller
            -- returning here believing the stream shut is the worst of the outcomes
            -- available, so the boundary supplies what the backend did not.
            why = "the platform did not release the descriptor and did not say why"
        end
        if why ~= nil then
            -- Raised rather than answered, because this signature is tecs's and answers
            -- nothing. The status stops here and becomes an error, which is what the
            -- teardown above is already prepared to catch.
            error(("nupp: could not close a process stream: %s"):format(why), 0)
        end
    end

    --- Writes what the pipe will take without waiting. Answers how many bytes went,
    --- which may be none and may be fewer than offered.
    function offer(self, data: string): integer
        if self.closed or self.gone or #data == 0 then
            return 0
        end
        local sent, gone = self.owner.backend:write(self.handle, data)
        if gone then
            -- Nobody is reading and nobody will. Recording it is what stops a writer
            -- waiting on room that will never come; the bytes that did go still count,
            -- and the descriptor is still open and still ours to close.
            self.gone = true
        end

        return sent
    end

    --- Writes every byte, suspending as often as the pipe makes it. Answers how many
    --- went, which is all of them unless the far end went away first.
    function send(self, data: string, stopAt: number?, stallFor: integer?): integer
        if self.closed or self.gone then
            return 0
        end
        local sent = 0
        local before = 0
        local function interest(): processtypes.Interest
            -- Room in this pipe, and the child: a child that exits makes every
            -- remaining write impossible, which is an answer too.
            return new processtypes.Interest(child = self.owner.handle, read = {}, write = {self.handle})
        end

        -- Both of these are written above the loop rather than in it, so the loop holds
        -- no function to build -- one that does is a loop LuaJIT never compiles. What
        -- the pass they belong to varies by is `sent` and `before`, and a name declared
        -- out here is the same cell every pass.
        local function offered(): boolean
            if self.closed or self.gone then
                return true
            end
            sent = sent + self:offer(data:sub(sent + 1))

            -- Return after each piece, not only after the whole value. A timeout
            -- bounds one period with no progress; a child that keeps taking bytes
            -- may keep the write alive beyond that interval.

            return sent > before
        end

        while sent < #data and not self.closed and not self.gone do
            before = sent
            local completed = await(self.owner, "process stream write", offered, interest, stopAt)
            if not completed then
                break
            end
            if sent > before and stallFor ~= nil then
                stopAt = self.owner.backend:now() + stallFor
            end
        end

        return sent as integer
    end

    --- Bounds the next completion-oriented write.
    --- @raises when timeoutMs is outside 0 through 2147483647
    function setTimeout(self, timeoutMs: integer): nil
        if timeoutMs < 0 or timeoutMs > 2147483647 or math.floor(timeoutMs) ~= timeoutMs then
            error("nupp: process writer timeout must be 0 through 2147483647 milliseconds", 2)
        end
        self.timeoutMs = timeoutMs
    end

    function write(self, bytes: string): (boolean, string?)
        if self.closed then
            return false, "the process writer is closed"
        end
        if self.gone then
            return false, "the child is no longer reading this stream"
        end
        local stopAt = self.owner.backend:now() + self.timeoutMs
        local ok, sent = pcall(function(): integer
            return self:send(bytes, stopAt, self.timeoutMs)
        end)
        if not ok then
            return false, tostring(sent)
        end
        if sent ~= #bytes then
            if self.gone then
                return false, "the child stopped reading before every byte was written"
            end
            return false, "the process write timed out"
        end

        return true
    end

    function writeFrom(self, source: nupp.io.Buffer, offset: integer?, count: integer?): (integer?, string?)
        local at = offset or 0
        local length = source:length()
        local wanted: integer = count == nil and length - at or count as integer
        if at < 0 or wanted < 0 or at + wanted > length then
            error("nupp: process writer buffer range is outside the source", 2)
        end
        local wrote, reason = self:write(source:getString(at, wanted))
        if not wrote then
            return nil, reason
        end

        return wanted
    end

    function writeView(self, source: nupp.io.ByteView, offset: integer?, count: integer?): (integer?, string?)
        local at = offset or 0
        local length = source:length()
        local wanted: integer = count == nil and length - at or count as integer
        if at < 0 or wanted < 0 or at + wanted > length then
            error("nupp: process writer byte-view range is outside the source", 2)
        end
        local bytes = source:getString():sub(at + 1, at + wanted)
        local wrote, reason = self:write(bytes)
        if not wrote then
            return nil, reason
        end

        return wanted
    end

    function flush(self): (boolean, string?)
        if self.closed then
            return false, "the process writer is closed"
        end
        if self.gone then
            return false, "the child is no longer reading this stream"
        end

        return true
    end

    function close(self): (boolean, string?)
        local ok, problem = pcall(function(): nil
            self:release()
        end)
        if not ok then
            return false, problem == nil and "the process writer could not close" or tostring(problem)
        end

        return true
    end
end

--- Borrows a process reader through the shared completion-oriented contract.
function process.asReader(borrows source: process.Reader): nupp.io.Reader borrows (source)
    return source
end

--- Borrows a process writer through the shared completion-oriented contract.
function process.asWriter(borrows source: process.Writer): nupp.io.Writer borrows (source)
    return source
end

--- A running child.
record process.Process
    drop: nosuspend function(takes self: process.Process): nil
    backend: processtypes.Backend
    handle: any
    deadline: number?
    exit: processtypes.Exit?

    --- Whether the whole teardown finished: every stream released, the pump released,
    --- and the child handle released. The aggregate, and what makes a repeat call a
    --- no-op.
    reaped: boolean

    --- Whether the child *handle* has been given back, which is a smaller fact than
    --- `reaped` and has to be tracked apart from it. A teardown where a stream close
    --- complained still has a child to release, and a retry that had already released
    --- it must not ask again -- a pid is reused as readily as a descriptor.
    childReleased: boolean

    --- Whether a teardown is in progress. Separate from `reaped`, which means it
    --- finished: a close that failed part way must be retryable rather than silently
    --- successful.
    closing: boolean

    --- Which coroutine is running that teardown, so a second call can tell whether it
    --- is the same frame coming back around or a different one arriving. Nil on the
    --- main coroutine, which is why `closing` is the flag and this is only the owner.
    closingBy: any

    pump: any

    --- Whether the deadline is what ended it, remembered so the exit can say so.
    timedOut: boolean

    --- Operating-system process identifier.
    pid: integer

    --- Its standard input, when it was piped.
    stdin: process.Writer?

    --- Its standard output, when it was piped.
    stdout: process.Reader?

    --- Its standard error, when it was piped.
    stderr: process.Reader?

    --- Whether it is still running.
    function isRunning(self): boolean
        if self.exit ~= nil then
            return false
        end
        progressed(self)

        return self.exit == nil
    end

    --- Waits for it to end and answers how. Suspends while it runs.
    function wait(self): processtypes.Exit
        await(
            self,
            "process wait",
            function(): boolean
                return self.exit ~= nil
            end,
            function(): processtypes.Interest
                -- The child alone. Its streams are deliberately left out: output nobody
                -- is reading stays ready forever, so asking about it here would turn
                -- this sleep into a spin. The cost is that waiting without draining can
                -- fill a pipe and stall, which is exactly what `communicate` is for.
                return new processtypes.Interest(child = self.handle, read = {}, write = {})
            end
        )
        if self.timedOut and self.exit ~= nil then
            self.exit.timedOut = true
        end

        return self.exit as processtypes.Exit
    end

    --- Asks it to end; `force` insists. Answers whether the request was made.
    function kill(self, force: boolean?): (boolean, string?)
        if self.exit ~= nil then
            return true
        end
        local ok, problem = pcall(function(): nil
            self.backend:kill(self.handle, force == true)
        end)
        if not ok then
            return false, problem == nil and "the process could not be terminated" or tostring(problem)
        end

        return true
    end

    --- Writes input, closes stdin, drains stdout and stderr, and waits for the exit.
    --- Answers the complete exchange or a reason it could not be completed.
    ---
    --- One combined step per pass: offer some input, take whatever each output has,
    --- suspend only when none of the three moved.
    function communicate(self, options: processtypes.CommunicateOptions?): (processtypes.Result?, string?)
        local ok, answer = pcall(function(): processtypes.Result
            local given = options or {}
            local input = given.input
            local pending = input == nil and "" or type(input) == "string" and input as string or input:getString()
            local maximum = given.maxOutputBytes or 268435456
            if maximum < 0 then
                error("nupp: process maximum output must not be negative", 2)
            end
            local stdin, stdout, stderr = self.stdin, self.stdout, self.stderr
            local sent = 0
            local out, err = {}, {}
            local outputBytes = 0
            local function inputDone(): boolean
                -- Gone counts as done: there is nobody to deliver the rest to.
                return stdin == nil or stdin.closed or stdin.gone
            end

            local function outputDone(): boolean
                return (stdout == nil or stdout.eof or stdout.closed) and (stderr == nil or stderr.eof or stderr.closed)
            end

            local function idle(): boolean
                return (inputDone() and outputDone()) or self.exit ~= nil and outputDone()
            end

            -- A child that has ended will never read again, so whatever is left of the
            -- input is undeliverable and holding its stdin open says otherwise. Closing
            -- it here keeps this function's promise that stdin is closed by the time it
            -- returns, including when the child finished early.
            local function abandonInput(): nil
                if stdin ~= nil and not stdin.closed then
                    stdin:release()
                end
            end

            -- Everything a quiet pass would have used: the streams still worth
            -- draining, room for whatever input is left, and the child. This is the one
            -- wait that may ask about the outputs, because it is the one that reads
            -- them every pass -- so a ready stream leads to work rather than straight
            -- back here.
            --
            -- Written here rather than at the wait it belongs to, because that wait is
            -- inside the loop, and a function built inside a loop is one LuaJIT never
            -- compiles. It reads what varies through names the loop shares with it.
            local function interest(): processtypes.Interest
                local read: {any} = {}
                if stdout ~= nil and not stdout.eof and not stdout.closed then
                    read[#read + 1] = stdout.handle
                end
                if stderr ~= nil and not stderr.eof and not stderr.closed then
                    read[#read + 1] = stderr.handle
                end
                local write: {any} = {}
                if stdin ~= nil and not stdin.closed and sent < #pending then
                    write[#write + 1] = stdin.handle
                end

                return new processtypes.Interest(child = self.handle, read = read, write = write)
            end

            while not (inputDone() and outputDone()) do
                local moved = false
                if stdin ~= nil and not stdin.closed then
                    if sent < #pending then
                        local wrote = stdin:offer(pending:sub(sent + 1))
                        if wrote > 0 then
                            sent = sent + wrote
                            moved = true
                        end
                    end
                    if sent >= #pending then
                        -- Every byte delivered: tell the child there is no more, or it
                        -- reads to end of file forever and nobody's output ever
                        -- arrives.
                        stdin:release()
                        moved = true
                    end
                end
                if stdout ~= nil and not stdout.eof and not stdout.closed then
                    local chunk = stdout:poll()
                    if chunk == nil or #chunk > 0 then
                        if chunk ~= nil then
                            outputBytes = outputBytes + #chunk
                            if outputBytes > maximum then
                                self:kill(true)
                                error("process output exceeds the configured maximum", 0)
                            end
                            out[#out + 1] = chunk
                        end
                        moved = true
                    end
                end
                if stderr ~= nil and not stderr.eof and not stderr.closed then
                    local chunk = stderr:poll()
                    if chunk == nil or #chunk > 0 then
                        if chunk ~= nil then
                            outputBytes = outputBytes + #chunk
                            if outputBytes > maximum then
                                self:kill(true)
                                error("process output exceeds the configured maximum", 0)
                            end
                            err[#err + 1] = chunk
                        end
                        moved = true
                    end
                end
                if not moved then
                    -- All three quiet. This is a *retry*, not a condition wait. Only
                    -- the
                    -- next read can say whether it would now succeed; waiting for a
                    -- predicate only this caller can test is how this deadlocked. Give
                    -- the pumps one pass, then come back.
                    if idle() then
                        break
                    end
                    awaitTick(self, "process communicate", interest)
                end
            end

            abandonInput()

            return new processtypes.Result(
                output = table.concat(out),
                errorOutput = table.concat(err),
                exit = self:wait()
            )
        end)
        if not ok then
            return nil, answer == nil and "process communication failed without saying why" or tostring(answer)
        end

        return answer as processtypes.Result
    end

    --- Closes every stream, ends the child if it is still running, waits for it to
    --- actually finish, and releases it. Idempotent, and what `drop` runs when the
    --- owner goes out of lexical scope.
    --- @raises when closing one of the child streams fails
    function close(self): (boolean, string?)
        if self.reaped then
            return true
        end
        if self.closing then
            local runner = coroutine.running()
            if runner == self.closingBy then
                -- The same frame come back around: the waits below drive the pump, and
                -- something it drives has called in here. One teardown is enough, and
                -- this one is it -- returning is the only option, since waiting would
                -- be waiting on itself.
                return true
            end

            if not suspension.handled() then
                -- Another coroutine, and nothing to schedule it back. The teardown
                -- holding this child belongs to a frame that is somewhere below this
                -- one on the stack -- it can only have got here by being resumed from
                -- inside that teardown -- so waiting would be waiting for a frame that
                -- cannot run until this one returns. Saying so beats hanging.
                error(
                    "nupp: process close arrived from another coroutine while a teardown was "
                    .. "running, with no handler to schedule it",
                    0
                )
            end

            -- A different caller under a scheduler, and it must not be told the child
            -- is released while the teardown is still running. Answering "done" is what
            -- lets the owner's scope end, and the scope ending is what runs `drop`, so
            -- a premature yes has the next toucher on a handle already given back. It
            -- waits for whoever holds the teardown, then answers on the same terms as
            -- any other close -- finished, or free to try again.
            await(
                self,
                "process close",
                function(): boolean
                    return not self.closing
                end,
                function(): processtypes.Interest
                    return new processtypes.Interest(child = self.handle, read = {}, write = {})
                end
            )
            if self.reaped then
                return true
            end

            -- The holder's attempt failed and left it open. This caller inherits it.
        end
        self.closing = true
        self.closingBy = coroutine.running()
        -- Every step is attempted and the first failure raised at the end. Stopping at
        -- the first would leave the rest of the child's resources held by a process
        -- that has decided it is finished with them; swallowing them all would report
        -- a clean close that never happened.
        --
        -- Only raises are caught here, and that is now the whole story: a stream close
        -- turns its status into one at its own edge, and the reap is judged below
        -- rather than through this, because it alone has release state worth reading.
        local firstError: any = nil
        local function attempt(step: function(): nil): nil
            local ok, raised = pcall(step)
            if not ok and firstError == nil then
                -- `error(nil)` is a real thing a broken backend can do, and it arrives
                -- here as a failure with nothing to say. Left as nil it would read as
                -- no failure at all, and the teardown would report a clean close.
                firstError = raised == nil and "a teardown step failed without saying why" or raised
            end
        end

        -- Closed one at a time rather than through a list: a reader and a writer are
        -- different types, and a union of their `close` methods is not one callable.
        if self.stdin ~= nil then
            attempt(function(): nil
                self.stdin:release()
            end)
        end
        if self.stdout ~= nil then
            attempt(function(): nil
                self.stdout:release()
            end)
        end
        if self.stderr ~= nil then
            attempt(function(): nil
                self.stderr:release()
            end)
        end
        if self.exit == nil then
            attempt(function(): nil
                -- Ending rather than orphaning: a child outliving the scope that
                -- started it is a leak nobody sees until the machine runs out of them.
                self.backend:kill(self.handle, true)
                -- Terminating takes as long as it takes, so this waits for the exit
                -- rather than asking the platform to reap something still dying. Every
                -- stream close has been attempted by now -- attempted, not necessarily
                -- done, since one may have refused and stayed ours -- so the child is
                -- what this waits on and the only thing that can advance it.
                await(
                    self,
                    "process close",
                    function(): boolean
                        return self.exit ~= nil
                    end,
                    function(): processtypes.Interest
                        return new processtypes.Interest(child = self.handle, read = {}, write = {})
                    end
                )
            end)
        end
        attempt(function(): nil
            releasePump(self)
        end)

        -- Attempted whatever went before it, and this is the whole point of attempting
        -- every step. Skipping the reap because a stream complained leaves a child
        -- handle held by a process that has finished with it -- and under an automatic
        -- drop there is no binding left to retry through, so "unreaped" would mean
        -- "unreaped forever". A child that has not exited is a different matter: it is
        -- not reapable yet, and asking would be the error.
        if not self.childReleased and self.exit ~= nil then
            -- Not through `attempt`, because reap answers the same two facts a stream
            -- close does and the generic judge only reads one of them. A reap that
            -- released the child and complained anyway is still a reap: the pid is
            -- gone, and asking again would wait on whatever has since been given that
            -- number. So ownership decides the flag and the complaint is only carried.
            local ok, released, reason = pcall(function(): (boolean?, string?)
                return self.backend:reap(self.handle)
            end)
            if not ok then
                -- The same reading as a stream close that raised: no release state came
                -- back, so the child is treated as gone rather than asked about again.
                self.childReleased = true
                if firstError == nil then
                    firstError = released == nil and "reaping the child failed without saying why" or released
                end
            else
                self.childReleased = released == true
                if reason ~= nil then
                    if firstError == nil then
                        firstError = reason
                    end
                elseif released ~= true and firstError == nil then
                    firstError = "the platform did not release the child and did not say why"
                end
            end
        end

        -- Cleared either way, so a close that could not finish can be called again
        -- rather than reporting itself done. A retry finds each piece's own flag and
        -- skips whatever is already given back.
        self.closing = false
        self.closingBy = nil
        -- The aggregate, and only now: every stream given back, the pump gone, and the
        -- child handle released. `reaped` answering anything less would let a repeat
        -- call return early with something still held.
        self.reaped = (
            self.stdin == nil or self.stdin.closed
        ) and (
            self.stdout == nil or self.stdout.closed
        ) and (self.stderr == nil or self.stderr.closed) and self.pump == nil and self.childReleased
        if firstError ~= nil then
            error(firstError, 0)
        end

        return true
    end
end

function process.Process.drop(takes self: process.Process): nil
    self:close()
end

function process.destroyProcess(takes self: process.Process): nil
    self:drop()
end

-- Whether the child has ended since last asked.
progressed = function(self: any): integer
    local moved = 0
    if self.exit == nil then
        local ended = self.backend:poll(self.handle)
        if ended ~= nil then
            self.exit = ended
            moved = moved + 1
        end
    end

    return moved as integer
end

-- Whether the deadline has passed, killing the child if it has.
local function enforceDeadline(self: any): boolean
    -- Once. `timedOut` is the guard, and it has to be, because terminating takes as
    -- many polls as it takes: a deadline re-enforced every pump would go on signalling
    -- a process that is already dying, and a backend that treats a second kill as a
    -- fresh request would never get to finish.
    if self.deadline == nil or self.exit ~= nil or self.timedOut then
        return false
    end
    if self.backend:now() < self.deadline then
        return false
    end
    self.timedOut = true
    self.backend:kill(self.handle, true)

    return true
end

-- One pass of everything that could make progress for this child.
--
-- The deadline is enforced here rather than only before parking, so a child producing
-- nothing at all -- the case a deadline exists for -- still reaches it.
pumpOnce = function(self: any): integer
    local moved = progressed(self)
    if enforceDeadline(self) then
        moved = moved + progressed(self) + 1
    end

    return moved as integer
end

-- The pump this child needs driven while anything is waiting on it.
local function ensurePump(self: any): nil
    if self.pump ~= nil then
        return
    end
    self.pump = suspension.source("nupp.io.process", 50, function(): integer
        return pumpOnce(self)
    end)
end

releasePump = function(self: any): nil
    if self.pump == nil then
        return
    end
    self.pump:release()
    self.pump = nil
end

-- How long a blocking wait gives the platform before coming back to re-check. Long
-- enough that waiting costs nothing, short enough that a deadline is honoured close to
-- when it falls.
local BLOCKING_WAIT_MS = 20

-- Suspends for one pass of the pumps, then returns whatever happened.
--
-- What a drain loop needs. `await` waits for a predicate; a loop that has to *ask* the
-- streams again to find out whether anything changed has no predicate to wait on, and
-- would park forever on one that only its own next attempt could satisfy.
-- Blocks in the platform until something in `interest` moves, then drives one pass.
--
-- Only ever reached with no handler installed. Nobody to yield to, so blocking here is
-- the whole point: `waitReady` sleeps in the kernel until a descriptor moves or the
-- timeout passes, where spinning on a non-blocking poll would burn a core to learn
-- nothing.
--
-- Bounded rather than indefinite, because a deadline has to be reached even when the
-- child never speaks again, and never overshooting it: a wait longer than what is left
-- would report the timeout late by however much it overslept.
local function blockOnce(self: any, interest: processtypes.Interest, stopAt: number?): nil
    local budget = BLOCKING_WAIT_MS
    if self.deadline ~= nil then
        local remaining = self.deadline - self.backend:now()
        if remaining < budget then
            budget = remaining > 0 and remaining or 0
        end
    end
    if stopAt ~= nil then
        local remaining = stopAt - self.backend:now()
        if remaining < budget then
            budget = remaining > 0 and remaining or 0
        end
    end
    self.backend:waitReady(interest, budget)
    pumpOnce(self)
end

awaitTick = function(self: any, operation: string, interest: function(): processtypes.Interest): nil
    if not suspension.handled() then
        blockOnce(self, interest())

        return
    end
    ensurePump(self)
    suspension.suspend(operation, function(resume: function(boolean), context: any): function()?
        local source = context:source("nupp.io.process.tick", 50, function(): integer
            pumpOnce(self)
            -- Resumed unconditionally: one pass has happened, which is all this waits
            -- for. The caller decides whether that was useful.
            resume(true)

            return 1
        end)

        return function(): nil
            source:release()
        end
    end)
end

-- Suspends until `ready()` answers true, driving the child while it waits.
await = function(
    self: any,
    operation: string,
    ready: function(): boolean,
    interest: function(): processtypes.Interest,
    stopAt: number?
): boolean
    if ready() then
        return true
    end
    if stopAt ~= nil and self.backend:now() >= stopAt then
        return false
    end
    if not suspension.handled() then
        -- The same reasoning as `awaitTick`: with nobody to yield to, the platform is
        -- asked to sleep rather than the loop asked to spin. Every wait needs this, not
        -- just the drain loop -- `wait`, a stream read, a stream write and `close` all
        -- end up here, and each of them polling flat out is the cost this avoids.
        while not ready() do
            if stopAt ~= nil and self.backend:now() >= stopAt then
                return false
            end
            blockOnce(self, interest(), stopAt)
        end

        return true
    end
    ensurePump(self)
    -- Built once rather than per pass: this is already the slow path.
    local function subscribe(resume: function(boolean), context: any): function()?
        local source = context:source("nupp.io.process.wait", 50, function(): integer
            local moved = pumpOnce(self)
            if ready() or stopAt ~= nil and self.backend:now() >= stopAt or moved > 0 then
                resume(true)

                return 1
            end

            return 0
        end)

        return function(): nil
            source:release()
        end
    end

    while not ready() do
        if stopAt ~= nil and self.backend:now() >= stopAt then
            return false
        end
        pumpOnce(self)
        if ready() then
            return true
        end
        suspension.suspend(operation, subscribe)
    end

    return true
end

-- The shared Reader operation uses the concrete bounded poll but still waits through
-- the same state machine as every other completion-oriented call. Keeping the limit
-- here avoids a surplus buffer and its second notion of EOF.
readForCompletion = function(source: process.Reader, limit: integer): (string?, string?)
    if source.closed or source.eof then
        return nil
    end
    local chunk: string? = nil
    local stopAt = source.owner.backend:now() + source.timeoutMs
    local completed = await(
        source.owner,
        "process stream read",
        function(): boolean
            if source.closed or source.eof then
                return true
            end
            local got = source:poll(limit)
            if got == nil then
                return true
            end
            if #got > 0 then
                chunk = got

                return true
            end

            return false
        end,
        function(): processtypes.Interest
            return new processtypes.Interest(child = source.owner.handle, read = {source.handle}, write = {})
        end,
        stopAt
    )
    if not completed then
        return nil, "the process read timed out"
    end

    return chunk
end

local function newReader(owner: any, handle: any): any
    if handle == nil then
        return nil
    end

    return new process.Reader(owner = owner, handle = handle, closed = false, eof = false, timeoutMs = 30000)
end

local function newWriter(owner: any, handle: any): any
    if handle == nil then
        return nil
    end

    return new process.Writer(owner = owner, handle = handle, closed = false, gone = false, timeoutMs = 30000)
end

--- Installs the backend `process.new` uses.
---
--- Called by a platform module, not by a caller: the point of the seam is that nothing
--- above it names a platform.
function process.useBackend(backend: processtypes.Backend): nil
    defaultBackend = backend
end

-- Public callers include plain Lua, so the type declaration is not the runtime
-- boundary. Reject programmer mistakes before allocating a native spawn request;
-- platform failures remain the nil-and-reason result of `new`.
local function validateOptions(options: processtypes.Options): nil
    local given: any = options
    if type(given.args) ~= "table" or #given.args == 0 then
        error("nupp: process args must contain a program", 3)
    end
    for index = 1, #given.args do
        if type(given.args[index]) ~= "string" then
            error(("nupp: process argument %d must be a string"):format(index), 3)
        end
    end
    local streams = {pipe = true, inherit = true, null = true}
    if given.stdin ~= nil and streams[given.stdin] ~= true then
        error("nupp: process stdin must be pipe, inherit, or null", 3)
    end
    if given.stdout ~= nil and streams[given.stdout] ~= true then
        error("nupp: process stdout must be pipe, inherit, or null", 3)
    end
    if given.stderr ~= nil and streams[given.stderr] ~= true and given.stderr ~= "stdout" then
        error("nupp: process stderr must be pipe, inherit, null, or stdout", 3)
    end
    if given.timeoutMs ~= nil and (
        type(
            given.timeoutMs
        ) ~= "number" or given.timeoutMs < 0 or given.timeoutMs > 2147483647 or math.floor(
            given.timeoutMs
        ) ~= given.timeoutMs
    ) then
        error("nupp: process timeout must be 0 through 2147483647 milliseconds", 3)
    end
end

--- Builds the owned state after the platform has successfully spawned.
local function fromSpawn(
    backend: processtypes.Backend,
    options: processtypes.Options,
    handle: any,
    inHandle: any?,
    outHandle: any?,
    errHandle: any?,
    pid: integer
): affine(process.Process, process.destroyProcess)
    local self = new process.Process(
        stdin = nil,
        stdout = nil,
        stderr = nil,
        backend = backend,
        handle = handle,
        exit = nil,
        reaped = false,
        childReleased = false,
        closing = false,
        closingBy = nil,
        pump = nil,
        timedOut = false,
        pid = pid,
        -- Measured from the start, not from the first wait: a caller that spawns, works
        -- and then waits should not get a deadline counted from whenever it asked.
        deadline = options.timeoutMs ~= nil and (backend:now() + options.timeoutMs) or nil
    )
    self.stdin = newWriter(self, inHandle)
    self.stdout = newReader(self, outHandle)
    self.stderr = newReader(self, errHandle)

    return self
end

--- Starts a child on a given backend.
---
--- Internal, and what the tests use so the state machine can be driven without a
--- platform. Ordinary callers want `process.new`.
---
--- @param backend the platform that runs it
--- @param options what to run and how to connect it
--- @return the child, which must be closed
--- @raises when the options do not describe a runnable child, or the backend cannot
--- start one
function process.spawnOn(
    backend: processtypes.Backend,
    options: processtypes.Options
): affine(process.Process, process.destroyProcess)
    validateOptions(options)
    local handle, inHandle, outHandle, errHandle, pid, problem = backend:spawn(options)
    if handle == nil then
        error(problem or "the process could not be started", 2)
    end

    return fromSpawn(backend, options, handle, inHandle, outHandle, errHandle, pid)
end

--- Starts a child.
---
--- @param options what to run and how to connect it
--- @return the child, which must be closed
function process.new(options: processtypes.Options): (affine(process.Process?, process.destroyProcess), string?)
    validateOptions(options)
    local backend = defaultBackend
    if backend == nil then
        local native = require("nupp.io.processnative") as NativeBackendFactory
        backend = native.new(process.exited)
        defaultBackend = backend
    end

    local handle, inHandle, outHandle, errHandle, pid, problem = (backend as processtypes.Backend):spawn(options)
    if handle == nil then
        return nil, problem or "the process could not be started"
    end

    return fromSpawn(backend as processtypes.Backend, options, handle, inHandle, outHandle, errHandle, pid)
end

--- The exit a backend reports, with `succeeded` attached.
---
--- Backends build these, so the one judgement every caller makes -- did this work --
--- has one definition rather than one per platform.
function process.exited(exitCode: integer, killed: boolean, timedOut: boolean): processtypes.Exit
    return {
        exitCode = exitCode,
        killed = killed,
        timedOut = timedOut,
        succeeded = function(self: processtypes.Exit): boolean
            -- A killed child never succeeded, whatever status the platform reported.
            return not self.killed and not self.timedOut and self.exitCode == 0
        end,
    } as processtypes.Exit
end

return process
