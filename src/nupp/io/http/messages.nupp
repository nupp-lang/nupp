@!internal

module nupp.io.http.messages

const {type Path} = require("io.files")
const uri = require("io.internal.uri")

--- A portable byte source for an HTTP upload, with consuming teardown.
export interface Reader is own.Closeable
    read: function(exclusive self: Reader, count: integer): (string?, string?)
end

--- Transport capability flags describing observable HTTP guarantees.
---
--- A true flag promises the corresponding behavior; callers must not infer support
--- from a provider name or the presence of unrelated methods.
export record Capabilities
    --- Response bytes become available before the whole response arrives.
    streamingresponse: boolean

    --- Request bodies may be read incrementally from a reader or file.
    streamingrequest: boolean

    --- Proxy and per-host certificate policy can be configured by the caller.
    transportpolicy: boolean

    --- Redirect and connection limits can be enforced by the caller.
    connectionpolicy: boolean

    --- The negotiated HTTP version is observable.
    protocolversion: boolean
end

--- The protocol version a response arrived over.
export type Version = "1.0" | "1.1" | "2"

--- What a client applies to every request it sends.
---
--- A plain table, like every other option bag in the io facades. Every field is
--- optional, so `http.newclient()` with nothing is a client with the defaults
--- below. A request may override the three limits it also names.
export type Options = {
    --- The `user-agent` header sent with every request.
    useragent: string?,

    --- Headers sent with every request, which a request's own headers replace by
    --- name.
    headers: {[string]: string}?,

    --- How long a request may take end to end, 30000 by default.
    timeoutms: integer?,

    --- How long establishing a connection may take, 10000 by default.
    connecttimeoutms: integer?,

    --- How long a response body may make no progress before the transfer fails,
    --- 0 to allow any pause and the default. The wait for the response headers
    --- and a streamed upload are bounded by `timeoutms` alone.
    stalltimeoutms: integer?,

    --- How many redirects a request may follow, 5 by default.
    maxredirects: integer?,

    --- How many requests may be in flight at once, 256 by default. A request past
    --- the bound waits for admission rather than failing.
    maxpendingrequests: integer?,

    --- How many connections the pool may hold, 16 by default.
    maxconnections: integer?,

    --- How many connections the pool may hold to one host, 16 by default.
    maxconnectionsperhost: integer?,

    --- How many response bytes a request may take, 0 for no bound and the
    --- default.
    maxbytes: integer?,

    --- Whether to offer and decode compressed responses, true by default.
    compressed: boolean?,

    --- Hosts whose certificates are not verified, each an exact host name or IP
    --- literal. Redirects are followed one hop at a time, so the exemption is
    --- applied per hop rather than to the whole chain.
    insecurehosts: {string}?,

    --- The proxy to reach every host through. Omitted takes the environment's,
    --- and an empty string deliberately uses none. Under CGI, where
    --- `REQUEST_METHOD` is set, the environment names no proxy: a request's own
    --- `Proxy` header arrives there as `HTTP_PROXY`.
    proxy: string?,

    --- Hosts to reach directly rather than through the proxy.
    noproxy: string?,

    --- Credentials for the proxy, as `user:password`.
    proxycredentials: string?
}

--- A request body streamed from a reader rather than held in memory.
---
--- Built by [](io.http.reader). A redirect that preserves the request body
--- cannot replay one, so the request fails rather than following that redirect.
export record ReaderBody is own.Closeable
    --- Where the body's bytes come from.
    reader: Reader

    --- How many bytes the reader will produce, when that is known ahead of time.
    --- The native transport fails a request whose reader produces more or fewer.
    len: integer?

    --- The `content-type` to send, unless the request names one itself.
    contenttype: string?

    function close(takes self): nil
        self.reader:close()
    end
end

--- A request body read from a file as it is sent.
---
--- Built by [](io.http.file). The path must name a regular file: a device,
--- FIFO or directory has no length to send, and the native transport refuses it.
export record FileBody
    --- The file to send, named as anything [](io.files) accepts: text, a
    --- [](io.Path), or an application path.
    path: Path

    --- The `content-type` to send, unless the request names one itself.
    contenttype: string?
end

--- Everything a typed request body may own: immutable bytes, a reader stream, or a
--- file path. Convert a Buffer or ByteView with `getstring()` so the request owns an
--- immutable snapshot rather than borrowing mutable storage.
export type RequestBody = string | ReaderBody | FileBody

--- A request, as `http.Client:send` takes it.
---
--- Only `url` is required, and it must be `http` or `https`. The three limits
--- here override the client's for this request alone. A request is an affine owner;
--- closing it closes a streaming reader body, and otherwise has no external work.
---
--- ```nupp:fragment
--- local request = new http.Request(
---     url = assert(uri.newURI("https://example.com/upload")),
---     method = "POST",
---     headers = {["content-type"] = "application/json"},
---     body = document
--- )
--- ```
export record Request is own.Closeable
    --- Where the request goes.
    url: uri.URI

    --- The method to use, `GET` when omitted.
    method: string?

    --- Headers for this request, which replace the client's by name. A
    --- `content-length` must match the body, where no body counts as zero, and
    --- `transfer-encoding` is the transport's to choose; the native transport
    --- refuses a request that breaks either rule.
    headers: {[string]: string}?

    --- What to send as the body, or nothing.
    body: RequestBody?

    --- How long this request may take end to end, or the client's limit.
    timeoutms: integer?

    --- How long this request's response body may make no progress, or the
    --- client's limit.
    stalltimeoutms: integer?

    --- How many response bytes this request may take, or the client's limit.
    maxbytes: integer?

    --- Closes the request and any streaming reader it owns.
    --- @param self this request, spent by the call
    function close(takes self): nil
        if self.body is ReaderBody then
            self.body:close()
        end
    end
end
