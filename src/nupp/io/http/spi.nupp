module nupp.io.http.spi

--[[
Shared interfaces for HTTP implementations.

The HTTP module selects during initialization. Provider functions
have no implicit receiver; Client and Response methods do. Request, Options,
Version, and Capabilities come from [](nupp.io.http.messages), URI from
[](nupp.io.uri), and Body is the canonical [](nupp.io) Reader interface.

A Client owns its transport and outstanding work. A successful send returns an
affine Response owning the response resources and body reader. Preserve borrowing
of the Request during send and exclusive access during pump. Closing clients
and responses must release resources on success, error, and cancellation paths.
Implementers must not replace these affine contracts with unowned table aliases.

Capabilities describe actual behavior, including streaming, policy control, and
protocol observability. Unsupported options must follow the public HTTP API's
error behavior. The facade selects the implementation at require-time; clients
and resource methods retain direct provider operations.
]]

local {type Version, type Request, type Options, type Capabilities} = require("nupp.io.http.messages")
local {type URI} = require("nupp.io.uri")
local {type Reader as ResponseBody, type Error} = require("nupp.io")
export type Body = ResponseBody

export interface Response is nupp.Closeable
    --- HTTP response status code.
    @readonly
    status: integer

    --- Observed protocol version, absent when the host cannot expose it.
    @readonly
    version: Version?

    --- Canonical final response URI, including completed redirects.
    @readonly
    url: URI

    --- Owned response reader whose lifetime is governed by the response.
    @readonly
    body: Body

    --- Reports whether the status is in the successful 2xx range.
    @readonly
    ok: function(self: Response): boolean

    --- Returns one header value by case-insensitive name, or nil if absent.
    @readonly
    header: function(self: Response, name: string): string?

    --- Returns all values for a case-insensitive header name.
    @readonly
    headerValues: function(self: Response, name: string): {string}

    --- Returns a fresh response header mapping keyed by lowercase name.
    --- Repeated values are joined with `, ` except `set-cookie`, whose first value
    --- is returned; use `headerValues` to preserve every value.
    @readonly
    headers: function(self: Response): {[string]: string}
end

export interface Client is nupp.Closeable
    --- Services outstanding client work, waiting up to the given milliseconds
    --- for some of it to move, while holding exclusive client access.
    @readonly
    pump: function(exclusive self: Client, timeoutMs: integer?): nil

    --- Returns the number of outstanding requests or transfers.
    @readonly
    pending: function(self: Client): integer

    --- Borrows the Request while sending and returns an owned Response or an error.
    @readonly
    send: function(self: Client, borrows request: Request): (Response?, Error?)
end

export interface Provider
    @readonly
    priority: integer?

    --- Constructs an owned client with the requested transport policy.
    @readonly
    newClient: function(options: Options?): Client

    --- Reports the guarantees this implementation actually provides.
    @readonly
    capabilities: function(): Capabilities
end
