@!internal
module nupp.io.uri.pathtext

-- A segment spelled with percent-encoded dots is a dot segment. RFC 3986
-- decodes %2E as unreserved before removing dot segments, and WHATWG lists the
-- encoded spellings among its dot segments, so both specifications agree.
const DOT_SPELLINGS: {[string]: string} = {["%2e"] = ".", [".%2e"] = "..", ["%2e."] = "..", ["%2e%2e"] = "..",}

local function plainDots(segment: string): string?
    if #segment < 3 or #segment > 6 then
        return nil
    end

    return DOT_SPELLINGS[segment:lower()]
end

--- RFC 3986 section 5.2.4, with encoded dots read as dots.
--- @param path the path to reduce
--- @return the path without `.` and `..` segments
export function removeDotSegments(path: string): string
    local input = path
    if input:find("%", 1, true) ~= nil then
        input = input:gsub("[^/]+", plainDots)
    end
    local output: {string} = {}
    while input ~= "" do
        if input:sub(1, 3) == "../" then
            input = input:sub(4)
        elseif input:sub(1, 2) == "./" then
            input = input:sub(3)
        elseif input:sub(1, 3) == "/./" then
            input = "/" .. input:sub(4)
        elseif input == "/." then
            input = "/"
        elseif input:sub(1, 4) == "/../" then
            input = "/" .. input:sub(5)
            output[#output] = nil
        elseif input == "/.." then
            input = "/"
            output[#output] = nil
        elseif input == "." or input == ".." then
            input = ""
        else
            local segment = input:match("^/?[^/]*") as string
            output[#output + 1] = segment
            input = input:sub(#segment + 1)
        end
    end

    return table.concat(output)
end
