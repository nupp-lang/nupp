@!internal
module nupp.io.uri.provider

local spi = require("nupp.spi")
local target = require("nupp.runtime.target")
local contracts = require("nupp.io.uri.spi")

local provider: contracts.UriTextProvider = do
    local chosen: contracts.UriTextProvider?
    local tied = false
    for candidate in spi.load(contracts.UriTextProvider) do
        if chosen == nil or (candidate.priority ?? 0) > (chosen.priority ?? 0) then
            chosen = candidate
            tied = false
        elseif (candidate.priority ?? 0) == (chosen.priority ?? 0) then
            tied = true
        end
    end
    assert(not tied, "nupp.io.uri.provider: multiple implementations have the highest priority")
    if chosen ~= nil then
        yield chosen
    end
    if target.dialect ~= "lua51" then
        yield _G.require("nupp.runtime.provider.nativeuri") as contracts.UriTextProvider
    end
    yield _G.require("nupp.runtime.browser.uri") as contracts.UriTextProvider
end

export = provider
