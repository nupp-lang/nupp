@!internal
module nupp.io.path.provider

local target = require("nupp.runtime.target")
local contracts = require("io.internal.contracts")

local provider: contracts.PathProvider = do
    if target.host == "native" then
        yield _G.require("nupp.runtime.provider.nativepath") as contracts.PathProvider
    end
    yield _G.require("nupp.runtime.browser.path") as contracts.PathProvider
end

export = provider
