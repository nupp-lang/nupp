@!internal
module nupp.io.path.provider

local spi = require("nupp.spi")
local target = require("nupp.runtime.target")
local contracts = require("nupp.io.path.spi")

local provider: contracts.Provider = do
    const chosen = spi.select(spi.load(contracts.Provider))
    if chosen ~= nil then
        yield chosen
    end
    if target.host == "native" then
        yield _G.require("nupp.runtime.provider.nativepath") as contracts.Provider
    end
    yield _G.require("nupp.runtime.browser.path") as contracts.Provider
end

export = provider
