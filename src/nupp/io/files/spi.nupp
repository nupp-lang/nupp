@!internal
module nupp.io.files.spi

local io = require("nupp.io")
local paths = require("nupp.io.path")
local messages = require("nupp.io.files.messages")
local appPaths = require("nupp.io.files.path")

--- An affine open file and its exclusive platform handle. The file is itself the
--- byte stream: every read and write moves its one cursor.
export interface File is io.Reader, io.Writer
    --- Returns the file's byte length without moving its cursor.
    size: function(borrows self: File): (integer?, io.Error?)

    --- Moves the cursor relative to an origin and returns its new position.
    seek: function(exclusive self: File, offset: integer?, origin: messages.Origin?): (integer?, io.Error?)

    --- Returns the shared cursor position.
    position: function(exclusive self: File): (integer?, io.Error?)

    --- Publishes buffered file writes, and reports a write that failed to land.
    flush: function(borrows self: File): (boolean, string?)

    --- Reports whether the file has already been closed.
    isReleased: function(borrows self: File): boolean

    --- Closes the file and spends its ownership. Repeated calls are safe.
    close: @nosuspend function(takes self: File): nil
end

--- A native temporary path removed on close unless persisted.
export interface TemporaryPath is nupp.Closeable
    --- Returns the native path text.
    toString: function(self: TemporaryPath): string

    --- Returns the created path as a path value.
    path: function(self: TemporaryPath): paths.Path

    --- Moves the temporary path to a durable destination.
    persist: function(self: TemporaryPath, destination: any): (boolean, io.Error?)

    --- Reports whether the temporary owner has been closed or persisted.
    isReleased: function(self: TemporaryPath): boolean

    --- Removes the temporary path and spends its ownership. Repeated calls, and a
    --- call after `persist`, are safe and do nothing.
    close: @nosuspend function(takes self: TemporaryPath): nil
end

export interface Provider
    @readonly priority: integer?
    @readonly capabilities: function(): messages.Capabilities
    @readonly info: function(path: any): (messages.Info?, string?)
    @readonly exists: function(path: any): boolean
    @readonly isFile: function(path: any): boolean
    @readonly isDirectory: function(path: any): boolean
    @readonly isSymlink: function(path: any): boolean
    @readonly readLink: function(path: any): (paths.Path?, string?)
    @readonly createSymlink: function(target: any, link: any, kind: ("file" | "directory")?): (boolean, string?)
    @readonly setReadOnly: function(path: any, readOnly: boolean): (boolean, string?)
    @readonly createDirectory: function(path: any): (boolean, string?)
    @readonly remove: function(path: any, recursive: boolean?): (boolean, string?)
    @readonly rename: function(from: any, to: any): (boolean, string?)
    @readonly list: function(path: any): ({messages.Entry}?, string?)
    @readonly glob: function(pattern: string): ({paths.Path}?, string?)
    @readonly read: function(path: any): (string?, string?)
    @readonly write: function(path: any, borrows bytes: string | io.ByteView): (boolean, string?)
    @readonly append: function(path: any, borrows bytes: string | io.ByteView): (boolean, string?)
    @readonly writeAtomic: function(path: any, borrows bytes: string | io.ByteView): (boolean, string?)
    @readonly copy: function(from: any, to: any): (boolean, string?)
    @readonly pendingTransfers: function(): integer
    @readonly open: function(path: any, mode: messages.Mode?): (affine(File?), string?)
    @readonly createTemporaryFile: function(options: messages.TemporaryOptions?): (affine(TemporaryPath?), string?)
    @readonly createTemporaryDirectory: function(options: messages.TemporaryOptions?): (affine(TemporaryPath?), string?)
    @readonly userFolder: function(which: messages.UserFolder): (paths.Path?, string?)
    @readonly applicationPath: function(
        kind: string,
        organization: string,
        application: string
    ): (appPaths.ApplicationPath?, string?)
    @readonly executableDirectory: function(): (paths.Path?, string?)
    @readonly requestPersistentStorage: function(): (boolean, string?)
end
