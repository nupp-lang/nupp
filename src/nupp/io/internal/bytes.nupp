@!internal

module nupp.io.internal.bytes

local immutable = require("io.internal.bytestypes")
local physical = require("nupp.runtime.storage")
local span = require("binary.span")
local bufferstate = require("nupp.io.internal.bufferstate")
-- Raw storage stays private; every lent view retains the buffer as its anchor.
local foreignRead: function(
    borrows owner: any,
    borrows pointer: any,
    integer,
    integer
): span.Span<uint8> borrows (owner, pointer) = (require("nupp.mem.span") as any).__foreignByteSpan
local foreignWrite: function(
    borrows owner: any,
    borrows pointer: any,
    integer
): span.Writable<uint8> borrows (owner, pointer) = (require("nupp.mem.span") as any).__foreignByteWriteSpan

local DEFAULT_READ = 65536
local bounds = require("nupp.io.internal.bounds")

const _SCALAR_REQUIRES = "@requires-dynamically nupp.io.internal.scalars"
const _FILE_REQUIRES = "@requires-dynamically io.internal.fileviews"
local scalarModule: any = nil

local function scalarImplementation(name: string): any
    if scalarModule == nil then
        scalarModule = require(name)
    end
    return scalarModule
end

-- The file views need native storage, so they load only when a file is adapted.
local function fileImplementation(name: string): any
    return require(name)
end

--- Reads fixed-width numbers from a source of bytes.
--- @export
export interface ScalarReader is own.Closeable

    --- How many bytes are left, when that is knowable.
    --- @param self this reader
    --- @return the remaining byte count, or nil over an open-ended source
    --- @raises string when the reader is closed
    remaining: function(self: ScalarReader): integer?

    --- Whether the source has nothing left.
    --- @param self this reader
    --- @return whether it is at the end
    --- @raises string when the reader is closed, or its source failed
    atend: function(self: ScalarReader): boolean

    --- Discards bytes.
    --- @param self this reader
    --- @param count how many to discard
    --- @return this reader
    --- @raises string when there are not that many
    function skip(borrows self, count: integer): ScalarReader borrows (self)
        self:readbytes(count)

        return self
    end

    --- Reads bytes as they are.
    --- @param self this reader
    --- @param count how many to read
    --- @return the bytes
    --- @raises string when there are not that many
    readbytes: function(self: ScalarReader, count: integer): string

    --- Reads an unsigned 8-bit integer.
    --- @param self this reader
    --- @return the value, 0 through 255
    --- @raises string when the source has no bytes left
    function readuint8(self): uint32
        local raw = self:readbytes(1)
        local value = physical.decodeUint8(raw)

        return math.u32.wrap(value as integer)
    end

    --- Reads a signed 8-bit integer.
    --- @param self this reader
    --- @return the value, -128 through 127
    --- @raises string when the source has no bytes left
    function readint8(self): int32
        local raw = self:readbytes(1)
        local value = physical.decodeInt8(raw)

        return math.i32.wrap(value as integer)
    end

    --- Reads an unsigned 16-bit integer in the machine's byte order.
    --- @param self this reader
    --- @return the value, 0 through 65535
    --- @raises string when fewer than 2 bytes are left
    function readuint16(self): uint32
        local raw = self:readbytes(2)
        local value = physical.decodeUint16(raw)

        return math.u32.wrap(value as integer)
    end

    --- Reads a signed 16-bit integer in the machine's byte order.
    --- @param self this reader
    --- @return the value, -32768 through 32767
    --- @raises string when fewer than 2 bytes are left
    function readint16(self): int32
        local raw = self:readbytes(2)
        local value = physical.decodeInt16(raw)

        return math.i32.wrap(value as integer)
    end

    --- Reads an unsigned 32-bit integer in the machine's byte order.
    --- @param self this reader
    --- @return the value, 0 through 4294967295
    --- @raises string when fewer than 4 bytes are left
    function readuint32(self): uint32
        local raw = self:readbytes(4)
        local value = physical.decodeUint32(raw)

        return math.u32.wrap(value as integer)
    end

    --- Reads a signed 32-bit integer in the machine's byte order.
    --- @param self this reader
    --- @return the value
    --- @raises string when fewer than 4 bytes are left
    function readint32(self): int32
        local raw = self:readbytes(4)
        local value = physical.decodeInt32(raw)

        return math.i32.wrap(value as integer)
    end

    --- Reads an unsigned 64-bit integer in the machine's byte order.
    --- @param self this reader
    --- @return the value, as `uint64` cdata
    --- @raises string when fewer than 8 bytes are left
    function readuint64(self): uint64
        local raw = self:readbytes(8)
        local value = physical.decodeUint64(raw)

        return value as uint64
    end

    --- Reads a signed 64-bit integer in the machine's byte order.
    --- @param self this reader
    --- @return the value, as `int64` cdata
    --- @raises string when fewer than 8 bytes are left
    function readint64(self): int64
        local raw = self:readbytes(8)
        local value = physical.decodeInt64(raw)

        return value as int64
    end

    --- Reads a 32-bit float in the machine's byte order.
    --- @param self this reader
    --- @return the value, widened to a Lua number
    --- @raises string when fewer than 4 bytes are left
    function readfloat32(self): float
        local raw = self:readbytes(4)
        local value = physical.decodeFloat32(raw)

        return math.f32.narrow(value as number)
    end

    --- Reads a 64-bit float in the machine's byte order.
    --- @param self this reader
    --- @return the value
    --- @raises string when fewer than 8 bytes are left
    function readfloat64(self): number
        local raw = self:readbytes(8)
        local value = physical.decodeFloat64(raw)

        return value as number
    end

    --- Closes the reader, and the reader it was built over when there was one.
    ---
    --- Repeated calls are safe.
    --- @param self this reader, spent by the call
    close: @nosuspend function(takes self: ScalarReader): nil
end

--- Writes fixed-width numbers into a destination.
--- @export
export interface ScalarWriter is own.Closeable

    --- Writes bytes as they are.
    --- @param self this writer
    --- @param bytes the bytes to write
    --- @return this writer
    --- @raises string when bytes is not a string
    writebytes: function(borrows self: ScalarWriter, bytes: string): ScalarWriter borrows (self)

    --- Writes an unsigned 8-bit integer.
    --- @param self this writer
    --- @param value the number to write
    --- @return this writer
    function writeuint8(borrows self, value: uint32): ScalarWriter borrows (self)
        self:writebytes(physical.encodeUint8(math.u32.wrap(value)))

        return self
    end

    --- Writes a signed 8-bit integer.
    --- @param self this writer
    --- @param value the number to write
    --- @return this writer
    function writeint8(borrows self, value: int32): ScalarWriter borrows (self)
        self:writebytes(physical.encodeInt8(math.i32.wrap(value)))

        return self
    end

    --- Writes an unsigned 16-bit integer in the machine's byte order.
    --- @param self this writer
    --- @param value the number to write
    --- @return this writer
    function writeuint16(borrows self, value: uint32): ScalarWriter borrows (self)
        self:writebytes(physical.encodeUint16(math.u32.wrap(value)))

        return self
    end

    --- Writes a signed 16-bit integer in the machine's byte order.
    --- @param self this writer
    --- @param value the number to write
    --- @return this writer
    function writeint16(borrows self, value: int32): ScalarWriter borrows (self)
        self:writebytes(physical.encodeInt16(math.i32.wrap(value)))

        return self
    end

    --- Writes an unsigned 32-bit integer in the machine's byte order.
    --- @param self this writer
    --- @param value the number to write
    --- @return this writer
    function writeuint32(borrows self, value: uint32): ScalarWriter borrows (self)
        self:writebytes(physical.encodeUint32(value))

        return self
    end

    --- Writes a signed 32-bit integer in the machine's byte order.
    --- @param self this writer
    --- @param value the number to write
    --- @return this writer
    function writeint32(borrows self, value: int32): ScalarWriter borrows (self)
        self:writebytes(physical.encodeInt32(value))

        return self
    end

    --- Writes an unsigned 64-bit integer in the machine's byte order.
    --- @param self this writer
    --- @param value the number to write
    --- @return this writer
    function writeuint64(borrows self, value: uint64): ScalarWriter borrows (self)
        self:writebytes(physical.encodeUint64(value))

        return self
    end

    --- Writes a signed 64-bit integer in the machine's byte order.
    --- @param self this writer
    --- @param value the number to write
    --- @return this writer
    function writeint64(borrows self, value: int64): ScalarWriter borrows (self)
        self:writebytes(physical.encodeInt64(value))

        return self
    end

    --- Writes a 32-bit float in the machine's byte order.
    --- @param self this writer
    --- @param value the number to write
    --- @return this writer
    function writefloat32(borrows self, value: float): ScalarWriter borrows (self)
        self:writebytes(physical.encodeFloat32(value))

        return self
    end

    --- Writes a 64-bit float in the machine's byte order.
    --- @param self this writer
    --- @param value the number to write
    --- @return this writer
    function writefloat64(borrows self, value: number): ScalarWriter borrows (self)
        self:writebytes(physical.encodeFloat64(value))

        return self
    end

    --- Flushes the destination, when there is one to flush.
    ---
    --- This is where a destination that failed to take its bytes says so:
    --- `close` returns nothing, so a caller that needs to know flushes first.
    --- @param self this writer
    --- @return whether it flushed
    --- @return why it did not, when it did not
    flush: function(self: ScalarWriter): (boolean, string?)

    --- Closes the writer, and the writer it was built over when there was one.
    ---
    --- Repeated calls are safe.
    --- @param self this writer, spent by the call
    close: @nosuspend function(takes self: ScalarWriter): nil
end

--- Scalar reads and writes over one byte handle.
--- @export
export interface ScalarStream is ScalarReader, ScalarWriter
    --- Closes the shared byte handle once.
    close: @nosuspend function(takes self: ScalarStream): nil
end

----------------------------------------------------------------------------
-- Owners
----------------------------------------------------------------------------

local readSource: function(source: string): Reader
local readBuffer: function(exclusive source: Buffer): affine(Reader) borrows (source)
local readSpan: function(borrows source: span.Span<uint8>): affine(Reader) borrows (source)
local readSharedBytes: function(source: immutable.SharedBytes): Reader
local writeBuffer: function(exclusive destination: Buffer): affine(Writer) borrows (destination)
local createBuffer: function(initial: integer | string?): affine(Buffer)

--- An appending byte sink.
---
--- The counterpart of `Reader`, and an interface for the same reason: a buffer,
--- an open file and a request body all satisfy it, and a producer written
--- against the contract fills any of them.
--- @export
export interface Writer is own.Closeable
    --- Exclusively borrows a buffer as an appending byte sink.
    function of(exclusive destination: Buffer): affine(Writer) borrows (destination)
        return writeBuffer(destination)
    end

    --- Takes an open file as a byte sink. Closing the writer closes the file.
    function of(takes file: io.File): affine(Writer)
        local create: function(
            takes file: io.File
        ): affine(Writer) = fileImplementation("io.internal.fileviews").ownedwriter
        return create(file)
    end

    --- Appends bytes.
    --- @param self this writer
    --- @param bytes the bytes to append
    --- @return whether they were written
    --- @return why they were not, when unsuccessful
    --- @raises string when bytes is not a string
    write: function(exclusive self: Writer, bytes: string): (boolean, string?)

    --- Appends bytes from a checked shared span.
    --- @param self this writer
    --- @param source bytes valid for the duration of the call
    --- @return how many bytes moved, or nil on failure
    --- @return why it could not, when unsuccessful
    writespan: function(exclusive self: Writer, borrows source: span.Span<uint8>): (integer?, string?)

    --- Nothing is buffered behind this writer, so this only reports whether it is open.
    --- @param self this writer
    --- @return whether the writer is open
    --- @return why it is not, when it is not
    flush: function(self: Writer): (boolean, string?)

    --- Takes this writer and adds fixed-width numeric writes in native byte order.
    ---
    --- Closing the scalar writer closes this writer. Buffers remain owned by
    --- their caller and must outlive the adapter.
    --- @param self the writer to take
    --- @return the scalar writer, owned by the caller
    function scalar(takes self): affine(ScalarWriter)
        local create: function(
            takes source: Writer
        ): affine(ScalarWriter) = scalarImplementation("nupp.io.internal.scalars").writer
        return create(self)
    end

end

--- A reader taken apart into lines.
---
--- Reading a line means reading past its end, so something has to hold what came
--- after it. That is what this owns, and it is why a line reader takes its
--- source rather than borrowing one: two things reading the same bytes would
--- each see half of them.
--- @export
export sealed interface Lines is own.Closeable
    --- Reads the next line, without its terminator.
    ---
    --- Both `\n` and `\r\n` end a line. Bytes left after the last terminator are
    --- a line, because a stream that ended without one still said something.
    --- @param self this line reader
    --- @return the line, or nil at the end
    --- @return why it could not read, when unsuccessful
    read: function(self: Lines): (string?, string?)

    --- Whether this reader has been released.
    isreleased: function(self: Lines): boolean

    --- Releases this reader and the source it took.
    close: @nosuspend function(takes self: Lines): nil
end

-- A lease is handed out by the buffer it borrows, so its terminal has to be declared
-- ahead of both. One generic terminal over the shape the lease record shares with its
-- interface is written once, ahead of them.
local interface LeaseOwner
    drop: @nosuspend function(takes self: LeaseOwner): nil
end

--- Aborts a buffer write lease. Every lease is handed out under this exact cleanup,
--- which is why a caller never names it.
local function destroyLease<T is LeaseOwner>(takes self: T): nil
    self:drop()
end

--- An exclusive prepared region of a buffer. Its span may be written, then the
--- lease is committed with the number of bytes that actually landed. Dropping a
--- lease aborts it without changing the buffer's logical length.
--- @export
export sealed interface BufferWriteLease
    drop: @nosuspend function(takes self: BufferWriteLease): nil
    span: function(exclusive self: BufferWriteLease): span.Writable<uint8> borrows (self)
    commit: function(takes self: BufferWriteLease, written: integer): nil
end

local makeLines: function(takes source: Reader, limit: integer?): affine(Lines)
local readThrough: function(
    exclusive source: Reader,
    exclusive destination: Buffer,
    offset: integer?,
    count: integer?
): (integer?, string?)
local transferThrough: function(exclusive source: Reader, exclusive destination: Writer): (integer?, string?)
local readAll: function(takes source: Reader, maxbytes: integer?): (string?, string?)

--- A forward-only byte source.
---
--- An interface rather than the concrete things that satisfy it. A buffer's
--- reader, an open file and an HTTP response body are all one of these, so
--- code written against the contract works over any of them without knowing
--- which it has.
--- @export
export interface Reader is own.Closeable
    --- Reads a string snapshot.
    function of(source: string): Reader
        return readSource(source)
    end

    --- Exclusively borrows a buffer and consumes its unread bytes.
    function of(exclusive source: Buffer): affine(Reader) borrows (source)
        return readBuffer(source)
    end

    --- Borrows a span without copying its bytes.
    function of(borrows source: span.Span<uint8>): affine(Reader) borrows (source)
        return readSpan(source)
    end

    --- Retains immutable engine bytes without making a string snapshot.
    function of(source: immutable.SharedBytes): Reader
        return readSharedBytes(source)
    end

    --- Reads up to `count` bytes.
    ---
    --- An empty answer is the end.
    --- @param self this reader
    --- @param count the most bytes to read
    --- @return the bytes, or nil when the reader is closed
    --- @return why it could not read, when unsuccessful
    --- @raises string when count is not a positive integer
    read: function(exclusive self: Reader, count: integer): (string?, string?)

    --- Reads directly into a checked writable span. A zero answer is the end.
    --- @param self this reader
    --- @param destination the positive-sized range to fill
    --- @return how many bytes were read, or nil when the reader is closed
    --- @return why it could not read, when unsuccessful
    readspan: function(exclusive self: Reader, exclusive destination: span.ByteWriteSpan): (integer?, string?)

    --- Reads into a buffer.
    ---
    --- A zero answer is the end. The offset and count are checked before anything
    --- is read, so a malformed call consumes no input. This default reserves a
    --- destination span and calls `readspan` to fill it.
    --- @param self this reader
    --- @param destination the buffer to write into
    --- @param offset where in the destination to start, or the beginning
    --- @param count the most bytes to read
    --- @return how many bytes were read, or nil when the reader is closed
    --- @return why it could not read, when unsuccessful
    --- @raises string when offset is negative or count is not a positive integer
    function readinto(
        exclusive self,
        exclusive destination: Buffer,
        offset: integer?,
        count: integer?
    ): (integer?, string?)
        return readThrough(self, destination, offset, count)
    end

    --- Reads into a reservation and commits the number of bytes received.
    ---
    --- Takes the lease on success or failure. End of input commits zero bytes;
    --- failure abandons the reservation without extending the buffer.
    --- @param self this reader
    --- @param destination the positive-sized reservation to fill
    --- @raises string when the reservation is empty or the reader returns an invalid
    ---     count
    --- @return how many bytes were read, or nil on failure
    --- @return why the read failed, when unsuccessful
    function readinto(exclusive self, takes destination: affine(BufferWriteLease, destroyLease)): (integer?, string?)
        local lease = destination
        local landed: integer?
        local reason: string?
        local available: integer
        do
            local output = lease:span()
            available = positive(#output, "Reader:readinto reservation length", 2)
            landed, reason = self:readspan(output)
            own.drop(output)
        end
        if landed == nil then
            own.drop(lease)
            return nil, reason
        end
        local written = integer_(landed, "Reader:readinto byte count", 2)
        if written > available then
            error("nupp: io.Reader returned more bytes than its reservation", 2)
        end
        lease:commit(written)

        return landed, reason
    end

    --- Writes everything left to a writer.
    ---
    --- This default moves the bytes through `read` and `write`; a reader holding
    --- them in memory overrides it to hand over spans instead.
    --- @param self this reader
    --- @param destination the writer to fill
    --- @return how many bytes moved, or nil on failure
    --- @return why it could not, when unsuccessful
    function transferto(exclusive self, exclusive destination: Writer): (integer?, string?)
        return transferThrough(self, destination)
    end

    --- Takes this reader and returns its remaining bytes as a string.
    ---
    --- The reader closes on success or failure. A limit is checked as bytes arrive.
    --- @param self the reader to drain
    --- @param maxbytes the most bytes to accept, or no limit
    --- @return the bytes, or nil when the reader failed or exceeded the limit
    --- @return why it could not read, when unsuccessful
    --- @raises string when maxbytes is not a positive integer
    function readall(takes self, maxbytes: integer?): (string?, string?)
        return readAll(self, maxbytes)
    end

    --- Takes this reader and separates its bytes into lines.
    ---
    --- Closing the result closes this reader. Both `\n` and `\r\n` end a
    --- line; an unterminated final line is returned too.
    --- @param self the reader to take
    --- @param limit the most bytes one line may hold, or 65536
    --- @return the line reader, owned by the caller
    --- @raises string when limit is not a positive integer
    function lines(takes self, limit: integer?): affine(Lines)
        return makeLines(self, limit)
    end

    --- Takes this reader and adds fixed-width numeric reads in native byte order.
    ---
    --- Closing the scalar reader closes this reader. Short reads raise.
    --- @param self the reader to take
    --- @return the scalar reader, owned by the caller
    function scalar(takes self): affine(ScalarReader)
        local create: function(
            takes source: Reader
        ): affine(ScalarReader) = scalarImplementation("nupp.io.internal.scalars").reader
        return create(self)
    end

end

--- Carries the default method table through compilers that erase interface exports.
--- @internal
export const readerdefaults = Reader

local function readIntoBuffer(
    exclusive source: Reader,
    exclusive destination: Buffer,
    offset: integer?,
    count: integer?
): (integer?, string?)
    return source:readinto(destination, offset, count)
end

local function readIntoLease(
    exclusive source: Reader,
    takes destination: affine(BufferWriteLease, destroyLease)
): (integer?, string?)
    return source:readinto(destination)
end

-- Checked callers select an overload directly. Lua callers keep the plain
-- method, which dispatches to those same bodies instead of losing overrides.
local function readIntoLua(source: any, destination: any, offset: any, count: any): (integer?, string?)
    if type(destination) == "table" and type(destination.commit) == "function" then
        if offset ~= nil or count ~= nil then
            error("nupp: Reader:readinto takes no offset or count with a reservation", 2)
        end
        return (readIntoLease as any)(source, @unsafe own.release(destination))
    end

    return (readIntoBuffer as any)(source, @unsafe own.release(destination), offset, count)
end

export function readercompat(declaration: table): nil
    rawset(declaration, "readinto", readIntoLua)
end

--- Carries the writer default methods through the bootstrap compiler.
--- @internal
export const writerdefaults = Writer

--- Carries scalar defaults through the bootstrap compiler.
--- @internal
export const scalarreaderdefaults = ScalarReader

--- Carries scalar defaults through the bootstrap compiler.
--- @internal
export const scalarwriterdefaults = ScalarWriter

--- Carries read/write scalar defaults through the bootstrap compiler.
--- @internal
export const scalarstreamdefaults = ScalarStream

-- Declared ahead of the records because their methods call them, and defined below
-- because they name the records. The types are the contract either way.
local reserve: function(borrows self: Buffer, minimum: integer): nil
local bytesAt: function(borrows self: Buffer, offset: integer, count: integer): string
local newReaderOver: function(bytes: string): Reader
local newWriterOver: function(borrows buffer: Buffer): affine(Writer) borrows (buffer)
local newBufferReader: function(exclusive buffer: Buffer): affine(Reader) borrows (buffer)

local function bigEndian(bytes: string): string
    if physical.encodeUint16(1):byte(1) == 1 then
        return bytes:reverse()
    end
    return bytes
end

local function littleEndian(bytes: string): string
    if physical.encodeUint16(1):byte(1) ~= 1 then
        return bytes:reverse()
    end
    return bytes
end

local writeAt: function(exclusive self: Buffer, bytes: string, offset: integer?): nil

--- Growable byte storage whose pointer and logical length never escape separately.
--- @export
export sealed interface Buffer is own.Closeable
    --- Creates growable byte storage from bytes or a starting capacity.
    function create(initial: integer | string?): affine(Buffer)
        return createBuffer(initial)
    end

    metamethod __len: function(borrows self: Buffer): integer
    metamethod __tostring: function(borrows self: Buffer): string
    len: function(borrows self: Buffer): integer
    reset: function(exclusive self: Buffer): Buffer borrows (self)
    put: function(exclusive self: Buffer, borrows ...: any): Buffer borrows (self)
    putf: function(exclusive self: Buffer, format: string, ...: any): Buffer borrows (self)
    get: function(exclusive self: Buffer, count: integer?): string
    skip: function(exclusive self: Buffer, count: integer): Buffer borrows (self)
    tostring: function(borrows self: Buffer): string

    --- Consumes this buffer and returns its unread bytes as an immutable region.
    ---
    --- LuaJIT copies the bytes through a string into engine storage.
    function freeze(takes self: Buffer): immutable.SharedBytes
        -- The public freeze call selects the engine; loading Buffer stays portable.
        local copy: function(string): immutable.SharedBytes = rawget(immutable.SharedBytes as table, "copy") as any
        local result = copy(self:tostring())
        self:close()
        return result
    end

    span: function(borrows self: Buffer, first: integer?, last: integer?): span.Span<uint8> borrows (self)
    reserve: function(exclusive self: Buffer, count: integer): affine(BufferWriteLease, destroyLease) borrows (self)
    capacity: function(borrows self: Buffer): integer
    ensure: function(exclusive self: Buffer, minimum: integer): nil
    resize: function(exclusive self: Buffer, len: integer): nil

    --- Reads a i8 value at a zero-based byte offset.
    function readi8(borrows self, offset: integer): integer
        return physical.decodeInt8(self:readstring(offset, 1)) as integer
    end

    --- Writes a i8 value within the existing byte extent.
    function writei8(exclusive self, offset: integer, value: integer): nil
        self:readstring(offset, 1)
        writeAt(self, physical.encodeInt8(math.i32.wrap(value)), offset)
    end

    --- Reads a u8 value at a zero-based byte offset.
    function readu8(borrows self, offset: integer): integer
        return physical.decodeUint8(self:readstring(offset, 1)) as integer
    end

    --- Writes a u8 value within the existing byte extent.
    function writeu8(exclusive self, offset: integer, value: integer): nil
        self:readstring(offset, 1)
        writeAt(self, physical.encodeUint8(math.u32.wrap(value)), offset)
    end

    --- Reads a i16 value at a zero-based byte offset.
    function readi16(borrows self, offset: integer): integer
        return physical.decodeInt16(littleEndian(self:readstring(offset, 2))) as integer
    end

    --- Writes a i16 value within the existing byte extent.
    function writei16(exclusive self, offset: integer, value: integer): nil
        self:readstring(offset, 2)
        writeAt(self, littleEndian(physical.encodeInt16(math.i32.wrap(value))), offset)
    end

    --- Reads a i16 value at a zero-based byte offset.
    function readi16be(borrows self, offset: integer): integer
        return physical.decodeInt16(bigEndian(self:readstring(offset, 2))) as integer
    end

    --- Writes a i16 value within the existing byte extent.
    function writei16be(exclusive self, offset: integer, value: integer): nil
        self:readstring(offset, 2)
        writeAt(self, bigEndian(physical.encodeInt16(math.i32.wrap(value))), offset)
    end

    --- Reads a u16 value at a zero-based byte offset.
    function readu16(borrows self, offset: integer): integer
        return physical.decodeUint16(littleEndian(self:readstring(offset, 2))) as integer
    end

    --- Writes a u16 value within the existing byte extent.
    function writeu16(exclusive self, offset: integer, value: integer): nil
        self:readstring(offset, 2)
        writeAt(self, littleEndian(physical.encodeUint16(math.u32.wrap(value))), offset)
    end

    --- Reads a u16 value at a zero-based byte offset.
    function readu16be(borrows self, offset: integer): integer
        return physical.decodeUint16(bigEndian(self:readstring(offset, 2))) as integer
    end

    --- Writes a u16 value within the existing byte extent.
    function writeu16be(exclusive self, offset: integer, value: integer): nil
        self:readstring(offset, 2)
        writeAt(self, bigEndian(physical.encodeUint16(math.u32.wrap(value))), offset)
    end

    --- Reads a i32 value at a zero-based byte offset.
    function readi32(borrows self, offset: integer): int32
        return math.i32.wrap(physical.decodeInt32(littleEndian(self:readstring(offset, 4))) as integer)
    end

    --- Writes a i32 value within the existing byte extent.
    function writei32(exclusive self, offset: integer, value: int32): nil
        self:readstring(offset, 4)
        writeAt(self, littleEndian(physical.encodeInt32(value)), offset)
    end

    --- Reads a i32 value at a zero-based byte offset.
    function readi32be(borrows self, offset: integer): int32
        return math.i32.wrap(physical.decodeInt32(bigEndian(self:readstring(offset, 4))) as integer)
    end

    --- Writes a i32 value within the existing byte extent.
    function writei32be(exclusive self, offset: integer, value: int32): nil
        self:readstring(offset, 4)
        writeAt(self, bigEndian(physical.encodeInt32(value)), offset)
    end

    --- Reads a u32 value at a zero-based byte offset.
    function readu32(borrows self, offset: integer): uint32
        return math.u32.wrap(physical.decodeUint32(littleEndian(self:readstring(offset, 4))) as integer)
    end

    --- Writes a u32 value within the existing byte extent.
    function writeu32(exclusive self, offset: integer, value: uint32): nil
        self:readstring(offset, 4)
        writeAt(self, littleEndian(physical.encodeUint32(value)), offset)
    end

    --- Reads a u32 value at a zero-based byte offset.
    function readu32be(borrows self, offset: integer): uint32
        return math.u32.wrap(physical.decodeUint32(bigEndian(self:readstring(offset, 4))) as integer)
    end

    --- Writes a u32 value within the existing byte extent.
    function writeu32be(exclusive self, offset: integer, value: uint32): nil
        self:readstring(offset, 4)
        writeAt(self, bigEndian(physical.encodeUint32(value)), offset)
    end

    --- Reads a i64 value at a zero-based byte offset.
    function readi64(borrows self, offset: integer): int64
        return physical.decodeInt64(littleEndian(self:readstring(offset, 8))) as int64
    end

    --- Writes a i64 value within the existing byte extent.
    function writei64(exclusive self, offset: integer, value: int64): nil
        self:readstring(offset, 8)
        writeAt(self, littleEndian(physical.encodeInt64(value)), offset)
    end

    --- Reads a i64 value at a zero-based byte offset.
    function readi64be(borrows self, offset: integer): int64
        return physical.decodeInt64(bigEndian(self:readstring(offset, 8))) as int64
    end

    --- Writes a i64 value within the existing byte extent.
    function writei64be(exclusive self, offset: integer, value: int64): nil
        self:readstring(offset, 8)
        writeAt(self, bigEndian(physical.encodeInt64(value)), offset)
    end

    --- Reads a u64 value at a zero-based byte offset.
    function readu64(borrows self, offset: integer): uint64
        return physical.decodeUint64(littleEndian(self:readstring(offset, 8))) as uint64
    end

    --- Writes a u64 value within the existing byte extent.
    function writeu64(exclusive self, offset: integer, value: uint64): nil
        self:readstring(offset, 8)
        writeAt(self, littleEndian(physical.encodeUint64(value)), offset)
    end

    --- Reads a u64 value at a zero-based byte offset.
    function readu64be(borrows self, offset: integer): uint64
        return physical.decodeUint64(bigEndian(self:readstring(offset, 8))) as uint64
    end

    --- Writes a u64 value within the existing byte extent.
    function writeu64be(exclusive self, offset: integer, value: uint64): nil
        self:readstring(offset, 8)
        writeAt(self, bigEndian(physical.encodeUint64(value)), offset)
    end

    --- Reads a f32 value at a zero-based byte offset.
    function readf32(borrows self, offset: integer): number
        return physical.decodeFloat32(littleEndian(self:readstring(offset, 4))) as number
    end

    --- Writes a f32 value within the existing byte extent.
    function writef32(exclusive self, offset: integer, value: number): nil
        self:readstring(offset, 4)
        writeAt(self, littleEndian(physical.encodeFloat32(value)), offset)
    end

    --- Reads a f32 value at a zero-based byte offset.
    function readf32be(borrows self, offset: integer): number
        return physical.decodeFloat32(bigEndian(self:readstring(offset, 4))) as number
    end

    --- Writes a f32 value within the existing byte extent.
    function writef32be(exclusive self, offset: integer, value: number): nil
        self:readstring(offset, 4)
        writeAt(self, bigEndian(physical.encodeFloat32(value)), offset)
    end

    --- Reads a f64 value at a zero-based byte offset.
    function readf64(borrows self, offset: integer): number
        return physical.decodeFloat64(littleEndian(self:readstring(offset, 8))) as number
    end

    --- Writes a f64 value within the existing byte extent.
    function writef64(exclusive self, offset: integer, value: number): nil
        self:readstring(offset, 8)
        writeAt(self, littleEndian(physical.encodeFloat64(value)), offset)
    end

    --- Reads a f64 value at a zero-based byte offset.
    function readf64be(borrows self, offset: integer): number
        return physical.decodeFloat64(bigEndian(self:readstring(offset, 8))) as number
    end

    --- Writes a f64 value within the existing byte extent.
    function writef64be(exclusive self, offset: integer, value: number): nil
        self:readstring(offset, 8)
        writeAt(self, bigEndian(physical.encodeFloat64(value)), offset)
    end

    --- Copies a checked byte range, including overlapping ranges.
    function copy(exclusive self, offset: integer, borrows source: Buffer, first: integer?, count: integer?): nil
        local bytes = source:readstring(first or 0, count)
        self:readstring(offset, #bytes)
        writeAt(self, bytes, offset)
    end

    --- Fills a checked byte range with a byte value.
    --- @raises string when the value is not a byte or the range is invalid
    function fill(exclusive self, offset: integer, value: integer, count: integer?): nil
        if value % 1 ~= 0 or value < 0 or value > 255 then
            error("nupp: buffer fill value must be a byte", 2)
        end
        local bytes = self:readstring(offset, count)
        writeAt(self, string.rep(string.char(value), #bytes), offset)
    end

    --- Reads bytes at a zero-based storage offset.
    readstring: function(borrows self: Buffer, offset: integer, count: integer?): string

    --- Writes bytes within the existing storage extent.
    function writestring(exclusive self, offset: integer, bytes: string): nil
        self:readstring(offset, #bytes)
        writeAt(self, bytes, offset)
    end

    --- Reads up to 32 bits, with the low bit at the lowest bit offset.
    --- @raises string when the bit range is invalid
    function readbits(borrows self, offset: integer, count: integer): integer
        local first = bounds.count(offset, "io.Buffer bit offset", 2)
        local width = bounds.count(count, "io.Buffer bit count", 2)
        if width > 32 then
            error("nupp: buffer bit count exceeds 32", 2)
        end
        local extent = self:len() * 8
        bounds.range(extent, first, width, "io.Buffer bit range", 2)
        local result: integer = 0
        for index = 0, width - 1 do
            local position = bounds.sum(first, index, "io.Buffer bit range", 2)
            local byte = self:readu8(position // 8)
            result = (result + ((byte // (2 ^ (position % 8))) % 2) * (2 ^ index)) as integer
        end

        return result
    end

    --- Writes up to 32 bits without changing adjacent bits.
    --- @raises string when the bit range or value is invalid
    function writebits(exclusive self, offset: integer, count: integer, value: integer): nil
        local first = bounds.count(offset, "io.Buffer bit offset", 2)
        local width = bounds.count(count, "io.Buffer bit count", 2)
        if width > 32 or value < 0 or value % 1 ~= 0 or value >= 2 ^ width then
            error("nupp: buffer bit value is out of bounds", 2)
        end
        self:readbits(first, width)
        for index = 0, width - 1 do
            local position = first + index
            local at = position // 8
            local mask = 2 ^ (position % 8)
            local byte = self:readu8(at)
            local old = (byte // mask) % 2
            local bitValue = (value // (2 ^ index)) % 2
            self:writeu8(at, (byte + (bitValue - old) * mask) as integer)
        end
    end

    reader: function(exclusive self: Buffer): affine(Reader) borrows (self)
    writer: function(exclusive self: Buffer): affine(Writer) borrows (self)
    isreleased: function(borrows self: Buffer): boolean
    close: @nosuspend function(takes self: Buffer): nil
end

local reserveAt_: function(
    exclusive buffer: Buffer,
    offset: integer,
    count: integer
): affine(BufferWriteLease, destroyLease) borrows (buffer)

local newWriteLease: function(
    borrows buffer: Buffer,
    offset: integer,
    count: integer
): affine(BufferWriteLease, destroyLease) borrows (buffer)

local record HeapBuffer is Buffer
    @private _state: any

    close: @nosuspend function(takes self: HeapBuffer): nil
    metamethod __len: function(borrows self: HeapBuffer): integer
    metamethod __tostring: function(borrows self: HeapBuffer): string

    function len(borrows self): integer
        bounds.opened(bufferstate.closed(self._state), "io.Buffer", 2)
        return bufferstate.length(self._state) - bufferstate.read(self._state)
    end

    function reset(exclusive self): Buffer borrows (self)
        bounds.opened(bufferstate.closed(self._state), "io.Buffer", 2)
        bufferstate.reset(self._state)
        return self
    end

    function tostring(borrows self): string
        bounds.opened(bufferstate.closed(self._state), "io.Buffer", 2)
        local first = bufferstate.read(self._state)
        return bytesAt(self, first, bufferstate.length(self._state) - first)
    end

    function get(exclusive self, count: integer?): string
        bounds.opened(bufferstate.closed(self._state), "io.Buffer", 2)
        local first = bufferstate.read(self._state)
        local available = bufferstate.length(self._state) - first
        local taking = count == nil and available or math.min(bounds.count(count, "io.Buffer get count", 2), available)
        local result = bytesAt(self, first, taking)
        bufferstate.setread(self._state, first + taking)

        return result
    end

    function skip(exclusive self, count: integer): Buffer borrows (self)
        bounds.opened(bufferstate.closed(self._state), "io.Buffer", 2)
        local first = bufferstate.read(self._state)
        bufferstate.setread(
            self._state,
            first + math.min(bounds.count(count, "io.Buffer skip count", 2), bufferstate.length(self._state) - first)
        )

        return self
    end

    function put(exclusive self, borrows ...: any): Buffer borrows (self)
        bounds.opened(bufferstate.closed(self._state), "io.Buffer", 2)
        for index = 1, select("#", ...) do
            local value = select(index, ...)
            if type(value) == "string" or type(value) == "number" then
                writeAt(self, tostring(value), bufferstate.length(self._state))
            elseif (value as any).tostring ~= nil then
                writeAt(self, (value as Buffer):tostring(), bufferstate.length(self._state))
            else
                local source = value as span.Span<uint8>
                local count = #source
                local at = bufferstate.length(self._state)
                local _ending = bounds.sum(at, count, "io.Buffer append", 2)
                local lease = newWriteLease(self, at, count)
                do
                    local output = lease:span()
                    physical.copy(output:ref(), source:ref(), count)
                    own.drop(output)
                end
                lease:commit(count)
            end
        end

        return self
    end

    function putf(exclusive self, format: string, ...: any): Buffer borrows (self)
        self:put(string.format(format, ...))
        return self
    end

    -- Trusted compiler entry: refresh a native pointer before virtualizing a span.
    function _spanroot(borrows self): Buffer borrows (self)
        bounds.opened(bufferstate.closed(self._state), "io.Buffer", 2)
        local _base = bufferstate.data(self._state)
        return self
    end

    function span(borrows self, first: integer?, last: integer?): span.Span<uint8> borrows (self)
        bounds.opened(bufferstate.closed(self._state), "io.Buffer", 2)
        local read = bufferstate.read(self._state)
        local start = first or 1
        local finish = last or (bufferstate.length(self._state) - read)
        if start % 1 ~= 0
            or finish % 1 ~= 0
            or start < 1
            or finish < start - 1
            or finish > bufferstate.length(self._state) - read
        then
            error("nupp: buffer span out of bounds", 2)
        end

        return foreignRead(self, bufferstate.data(self._state), read + start - 1, finish - start + 1)
    end

    function reserve(exclusive self, count: integer): affine(BufferWriteLease, destroyLease) borrows (self)
        bounds.opened(bufferstate.closed(self._state), "io.Buffer", 2)
        local available = bounds.count(count, "io.Buffer reserve count", 2)
        local at = bufferstate.length(self._state)
        local _ending = bounds.sum(at, available, "io.Buffer reservation", 2)

        return newWriteLease(self, at, available)
    end

    function capacity(borrows self): integer
        bounds.opened(bufferstate.closed(self._state), "io.Buffer", 2)
        return bufferstate.capacity(self._state)
    end

    function ensure(exclusive self, minimum: integer): nil
        bounds.opened(bufferstate.closed(self._state), "io.Buffer", 2)
        reserve(self, bounds.count(minimum, "io.Buffer capacity", 2))
    end

    function resize(exclusive self, len: integer): nil
        bounds.opened(bufferstate.closed(self._state), "io.Buffer", 2)
        bufferstate.resize(self._state, bounds.count(len, "io.Buffer length", 2))
    end

    function readstring(borrows self, offset: integer, count: integer?): string
        bounds.opened(bufferstate.closed(self._state), "io.Buffer", 2)
        local from, taking = bounds.range(bufferstate.length(self._state), offset, count, "io.Buffer", 2)
        return bytesAt(self, from, taking)
    end

    function reader(exclusive self): affine(Reader) borrows (self)
        bounds.opened(bufferstate.closed(self._state), "io.Buffer", 2)
        return newBufferReader(self)
    end

    function writer(exclusive self): affine(Writer) borrows (self)
        bounds.opened(bufferstate.closed(self._state), "io.Buffer", 2)
        return newWriterOver(self)
    end

    function isreleased(borrows self): boolean
        return bufferstate.closed(self._state)
    end
end
writeAt = function(exclusive buffer: Buffer, bytes: string, offset: integer?): nil
    local state = (buffer as any)._state
    bounds.opened(bufferstate.closed(state), "io.Buffer", 2)
    if type(bytes) ~= "string" then
        error("nupp: io.Buffer bytes must be a string", 2)
    end
    local from = bounds.count(offset == nil and 0 or offset, "io.Buffer offset", 2)
    local ending = bounds.sum(from, #bytes, "io.Buffer range", 2)
    if #bytes == 0 then
        if ending > bufferstate.length(state) then
            bufferstate.resize(state, ending)
        end
        return
    end
    local lease = newWriteLease(buffer, from, #bytes)
    do
        local output = lease:span()
        physical.copy(output:ref(), bytes, #bytes)
        own.drop(output)
    end
    lease:commit(#bytes)
end

local record WriteLease is BufferWriteLease
    @private @readonly anchor: any
    @private @readonly state: any
    @private pointer: uint8[?]
    @private token: integer
    @private @readonly offset: integer
    @private @readonly count: integer

    drop: @nosuspend function(takes self: WriteLease): nil

    function span(exclusive self): span.Writable<uint8> borrows (self)
        return foreignWrite(self, self.pointer, self.count)
    end

    function commit(takes self, written: integer): nil
        local used = bounds.count(written, "io.Buffer committed byte count", 2)
        if used > self.count then
            error("nupp: io.Buffer committed byte count exceeds its lease", 2)
        end
        local ok, why = pcall(bufferstate.commitwrite, self.state, self.token, self.pointer, self.offset, used)
        if not ok then
            bufferstate.dropwrite(self.state, self.token)
            error(why, 0)
        end
        local _raw = @unsafe own.release(self)
    end
end

local function allocateWriteLease(
    borrows buffer: Buffer,
    offset: integer,
    count: integer
): affine(WriteLease, destroyLease) borrows (buffer)
    local state = (buffer as any)._state
    return WriteLease(
        anchor = buffer,
        state = state,
        pointer = bufferstate.data(state),
        token = 0,
        offset = offset,
        count = count
    )
end

newWriteLease = function(
    borrows buffer: Buffer,
    offset: integer,
    count: integer
): affine(BufferWriteLease, destroyLease) borrows (buffer)
    local state = (buffer as any)._state
    local lease = allocateWriteLease(buffer, offset, count)
    do
        local data, token = bufferstate.preparewrite(state, offset, count)
        -- Immutable state/anchor retain the pointer's root. The writer is not
        -- admitted yet, so either barrier may fail safely. Admission validates
        -- this preparation's generation and is the last call before return.
        @unsafe do
            lease.pointer = data
        end
        lease.token = token
        bufferstate.admitwrite(state, token, data)
    end

    return lease
end

--- The storage behind a writer over a buffer.
local record BufferWriter is Writer
    --- Spends the writer; defined after the record, so `close` can reach it.
    drop: function(takes self: BufferWriter): nil

    @private @readonly anchor: any
    @private @readonly _buffer: any
    @private _at: integer
    @private _closed: boolean

    --- Appends bytes.
    --- @param self this writer
    --- @param bytes the bytes to append
    --- @return whether they were written
    --- @return why they were not, when unsuccessful
    --- @raises string when bytes is not a string
    function write(exclusive self, bytes: string): (boolean, string?)
        if self._closed then
            return false, "the writer is closed"
        end
        if type(bytes) ~= "string" then
            error("nupp: Writer:write bytes must be a string", 2)
        end
        local state = self._buffer
        if bufferstate.closed(state._state) then
            return false, "the destination buffer is closed"
        end
        -- The writer already owns the exclusive buffer borrow. A string can use
        -- its admitted write path with the same cleanup as a reserved span.
        writeAt(state as Buffer, bytes, self._at)
        self._at = bounds.sum(self._at, #bytes, "Writer position", 2)

        return true, nil
    end

    function writespan(exclusive self, borrows source: span.Span<uint8>): (integer?, string?)
        if self._closed then
            return nil, "the writer is closed"
        end
        local state = self._buffer
        if bufferstate.closed(state._state) then
            return nil, "the destination buffer is closed"
        end
        local count = #source
        if count == 0 then
            return 0, nil
        end
        local at = self._at
        local lease = newWriteLease(state as Buffer, at, count)
        do
            local output = lease:span()
            if count == 1 then
                output[1] = source[1]
            else
                local destinationPointer = output:ref()
                local sourcePointer = source:ref()
                -- A cached module lookup avoids adding a provider upvalue to
                -- every protected cleanup closure on the native interpreter.
                require("nupp.runtime.storage").copy(destinationPointer, sourcePointer, count)
            end
            own.drop(output)
        end
        lease:commit(count)
        self._at = bounds.sum(at, count, "Writer position", 2)

        return count, nil
    end

    --- Nothing is buffered behind this writer, so this only reports whether it is open.
    --- @param self this writer
    --- @return whether the writer is open
    --- @return why it is not, when it is not
    function flush(self): (boolean, string?)
        if self._closed then
            return false, "the writer is closed"
        end

        return true, nil
    end

    --- Closes the writer.
    --- @param self this writer, spent by the call
    close: @nosuspend function(takes self: BufferWriter): nil
end

----------------------------------------------------------------------------
-- Readers
----------------------------------------------------------------------------

--- The storage behind a reader over held bytes.
-- All producers use one bounded bulk transfer, including the portable host.
local function copyString(
    exclusive destination: span.WriteSpan<uint8>,
    bytes: string,
    offset: integer,
    count: integer
): nil
    local pointer = destination:ref()
    @unsafe do
        local source = physical.borrowString(bytes)
        physical.copy(pointer, (source as const uint8*) + offset, count)
    end
end

local spanText: function(borrows source: const uint8[?], count: integer): string = physical.string as any

-- A SharedBytes source is a retained immutable value; a Span source carries its
-- caller's borrow. The reader uses one implementation for both.
local function heldSpan(borrows source: any): span.Span<uint8> borrows (source)
    if source.view ~= nil and source.viewas ~= nil then
        return (source as immutable.SharedBytes):view()
    end
    return source as span.Span<uint8>
end

local record SpanReader is Reader
    @private _source: any
    @private _at: integer
    @private _closed: boolean

    function read(exclusive self, count: integer): (string?, string?)
        if self._closed then
            return nil, "the reader is closed"
        end
        local wanted = bounds.positive(count, "Reader:read count", 2)
        local source = heldSpan(self._source)
        local taking = math.min(wanted, #source - self._at) as integer
        if taking == 0 then
            return ""
        end
        local window = source:slice(self._at + 1, self._at + taking)
        local bytes = spanText(window:ref(), #window)
        self._at = self._at + taking

        return bytes
    end

    function readspan(exclusive self, exclusive destination: span.ByteWriteSpan): (integer?, string?)
        if self._closed then
            return nil, "the reader is closed"
        end
        local wanted = bounds.positive(#destination, "Reader:readspan destination length", 2)
        local source = heldSpan(self._source)
        local taking = math.min(wanted, #source - self._at) as integer
        if taking > 0 then
            @unsafe do
                local pointer = source:ref()
                physical.copy(destination:ref(), (pointer as const uint8*) + self._at, taking)
            end
            self._at = self._at + taking
        end

        return taking
    end

    close: @nosuspend function(takes self: SpanReader): nil
end

function SpanReader.close(takes self: SpanReader): nil
    local state = @unsafe own.release(self)
    state._closed = true
    state._source = nil
end

local record StringReader is Reader
    --- Spends the reader; defined after the record, so `close` can reach it.
    drop: function(takes self: StringReader): nil

    _bytes: string
    _at: integer
    _closed: boolean

    --- Reads up to `count` bytes.
    ---
    --- An empty answer is the end.
    --- @param self this reader
    --- @param count the most bytes to read
    --- @return the bytes, or nil when the reader is closed
    --- @return why it could not read, when unsuccessful
    --- @raises string when count is not a positive integer
    function read(exclusive self, count: integer): (string?, string?)
        if self._closed then
            return nil, "the reader is closed"
        end
        local wanted = bounds.positive(count, "Reader:read count", 2)
        local bytes = self._bytes
        local at = self._at
        if at > #bytes then
            return "", nil
        end
        local taking = math.min(wanted, #bytes - at + 1)
        local out = bytes:sub(at, at + (taking as integer) - 1)
        self._at = at + (taking as integer)

        return out, nil
    end

    function readspan(exclusive self, exclusive destination: span.ByteWriteSpan): (integer?, string?)
        if self._closed then
            return nil, "the reader is closed"
        end
        local wanted: integer
        do
            local output = destination as span.WriteSpan<uint8>
            wanted = bounds.positive(#output, "Reader:readspan destination length", 2)
        end
        local bytes = self._bytes
        local at = self._at
        if at > #bytes then
            return 0, nil
        end
        local taking = math.min(wanted, #bytes - at + 1) as integer
        copyString(destination, bytes, at - 1, taking)
        self._at = at + taking

        return taking, nil
    end

    function readinto(
        exclusive self,
        exclusive destination: Buffer,
        offset: integer?,
        count: integer?
    ): (integer?, string?)
        if self._closed then
            return nil, "the reader is closed"
        end
        local from = bounds.count(offset == nil and 0 or offset, "Reader:readinto offset", 2)
        local wanted = bounds.positive(count == nil and DEFAULT_READ or count, "Reader:readinto count", 2)
        local bytes = self._bytes
        local at = self._at
        if at > #bytes then
            return 0, nil
        end
        local taking = math.min(wanted, #bytes - at + 1) as integer
        local lease = reserveAt_(destination, from, wanted)
        do
            local output = lease:span()
            copyString(output, bytes, at - 1, taking)
            own.drop(output)
        end
        lease:commit(taking)
        self._at = at + taking

        return taking, nil
    end

    --- Writes everything left to a writer.
    --- @param self this reader
    --- @param destination the writer to fill
    --- @return how many bytes moved, or nil on failure
    --- @return why it could not, when unsuccessful
    function transferto(exclusive self, exclusive destination: Writer): (integer?, string?)
        if self._closed then
            return nil, "the reader is closed"
        end
        local remaining = self._bytes:sub(self._at)
        local ok, reason = destination:write(remaining)
        if not ok then
            return nil, reason
        end
        self._at = #self._bytes + 1

        return #remaining, nil
    end

    --- Closes the reader.
    ---
    --- Repeated calls are safe.
    --- @param self this reader, spent by the call
    close: @nosuspend function(takes self: StringReader): nil
end

local function copyBufferSpan(exclusive buffer: Buffer, exclusive destination: span.ByteWriteSpan, count: integer): nil
    do
        local input = buffer:span(1, count)
        physical.copy(destination:ref(), input:ref(), count)
    end
    buffer:skip(count)
end

--- A reader that exclusively borrows a buffer.
local record BufferReader is Reader
    _source: any
    _closed: boolean

    --- Reads up to `count` bytes from the buffer.
    --- @param self this reader
    --- @param count the most bytes to read
    --- @return the bytes, or nil when the reader is closed
    --- @return why it could not read, when unsuccessful
    --- @raises string when count is not a positive integer
    function read(exclusive self, count: integer): (string?, string?)
        if self._closed then
            return nil, "the reader is closed"
        end
        local wanted = bounds.positive(count, "Reader:read count", 2)
        local source = self._source
        local have = (source as Buffer):len()
        if have == 0 then
            return "", nil
        end

        return (source as Buffer):get(math.min(wanted, have) as integer), nil
    end

    function readspan(exclusive self, exclusive destination: span.ByteWriteSpan): (integer?, string?)
        if self._closed then
            return nil, "the reader is closed"
        end
        local wanted: integer
        do
            local output = destination as span.WriteSpan<uint8>
            wanted = bounds.positive(#output, "Reader:readspan destination length", 2)
        end
        local source = self._source
        local have = (source as Buffer):len()
        if have == 0 then
            return 0, nil
        end
        local taking = math.min(wanted, have) as integer
        copyBufferSpan(source as Buffer, destination, taking)

        return taking, nil
    end

    function readinto(
        exclusive self,
        exclusive destination: Buffer,
        offset: integer?,
        count: integer?
    ): (integer?, string?)
        if self._closed then
            return nil, "the reader is closed"
        end
        local from = bounds.count(offset == nil and 0 or offset, "Reader:readinto offset", 2)
        local wanted = bounds.positive(count == nil and DEFAULT_READ or count, "Reader:readinto count", 2)
        local source = self._source
        local have = (source as Buffer):len()
        if have == 0 then
            return 0, nil
        end
        local taking = math.min(wanted, have) as integer
        local lease = reserveAt_(destination, from, wanted)
        do
            local output = lease:span()
            self:readspan(output)
            own.drop(output)
        end
        lease:commit(taking)

        return taking, nil
    end

    --- Writes everything the buffer has to a writer.
    --- @param self this reader
    --- @param destination the writer to fill
    --- @return how many bytes moved, or nil on failure
    --- @return why it could not, when unsuccessful
    function transferto(exclusive self, exclusive destination: Writer): (integer?, string?)
        if self._closed then
            return nil, "the reader is closed"
        end
        local rest = (self._source as Buffer):get()
        local ok, reason = destination:write(rest)
        if not ok then
            return nil, reason
        end

        return #rest, nil
    end

    --- Closes the reader without closing the buffer behind it.
    ---
    --- Repeated calls are safe. Declared rather than written inline: a cleanup
    --- contract is `@nosuspend`, and an inline method cannot carry one.
    --- @param self this reader, spent by the call
    close: @nosuspend function(takes self: BufferReader): nil
end

----------------------------------------------------------------------------
-- Closing
----------------------------------------------------------------------------

function HeapBuffer.__len(borrows self: HeapBuffer): integer
    return self:len()
end

function HeapBuffer.__tostring(borrows self: HeapBuffer): string
    return self:tostring()
end

function HeapBuffer.close(takes self: HeapBuffer): nil
    local state = @unsafe own.release(self)
    bufferstate.close(state._state)
end

function WriteLease.drop(takes self: WriteLease): nil
    @nosuspend do
        local raw = @unsafe own.release(self)
        bufferstate.dropwrite(raw.state, raw.token)
    end
end

readercompat(Reader as table)
readercompat(SpanReader as table)
readercompat(StringReader as table)
readercompat(BufferReader as table)

function BufferWriter.close(takes self: BufferWriter): nil
    local state = @unsafe own.release(self)
    state._closed = true
end

function StringReader.close(takes self: StringReader): nil
    local state = @unsafe own.release(self)
    state._closed = true
    state._bytes = ""
end

function BufferReader.close(takes self: BufferReader): nil
    local state = @unsafe own.release(self)
    state._closed = true
    state._source = nil
end

----------------------------------------------------------------------------
-- Shared implementations
----------------------------------------------------------------------------

-- Doubling, with a floor, so appending one byte at a time stays linear overall.
reserve = function(borrows self: Buffer, minimum: integer): nil
    bufferstate.reserve((self as any)._state, minimum)
end

bytesAt = function(borrows self: Buffer, offset: integer, count: integer): string
    return bufferstate.text((self as any)._state, offset, count)
end

--- Returns a finite byte count for the built-in reader representations.
--- @internal
export function readerRemaining(borrows source: Reader): integer?
    if source is StringReader then
        return #source._bytes - source._at + 1
    elseif source is SpanReader then
        return #heldSpan(source._source) - source._at
    elseif source is BufferReader then
        return (source._source as Buffer):len()
    end

    return nil
end

newReaderOver = function(bytes: string): Reader
    return StringReader(_bytes = bytes, _at = 1, _closed = false)
end

newBufferReader = function(exclusive buffer: Buffer): affine(Reader) borrows (buffer)
    return BufferReader(_source = buffer as any, _closed = false)
end

newWriterOver = function(borrows buffer: Buffer): affine(Writer) borrows (buffer)
    return BufferWriter(
        anchor = buffer,
        _buffer = buffer,
        _at = bufferstate.length((buffer as any)._state),
        _closed = false
    )
end

----------------------------------------------------------------------------
-- Opening
----------------------------------------------------------------------------

-- Lua 5.1 table length ignores __len. A private userdata facade preserves the
-- public length operation for plain Lua as well as checked source.
local bufferProxyStates: any = setmetatable({}, {__mode = "k"})
local bufferProxyFactory: any = rawget(_G, "newproxy")
local bufferProxyPrototype: any = nil
local bufferProxyMetatable: any = nil
local bufferLengthProbe: any = setmetatable({}, {
    __len = function(): integer
        return 1
    end
})
if #bufferLengthProbe ~= 1 and type(bufferProxyFactory) == "function" then
    bufferProxyPrototype = bufferProxyFactory(true)
    bufferProxyMetatable = getmetatable(bufferProxyPrototype) as any
    bufferProxyMetatable.__index = function(self: any, name: string): any
        return bufferProxyStates[self][name]
    end
    bufferProxyMetatable.__newindex = function(self: any, name: string, value: any): nil
        bufferProxyStates[self][name] = value
    end
    bufferProxyMetatable.__len = function(self: any): integer
        return bufferProxyStates[self]:len() as integer
    end
    bufferProxyMetatable.__tostring = function(self: any): string
        return bufferProxyStates[self]:tostring() as string
    end
end

local function bufferFacade(takes state: HeapBuffer): affine(Buffer)
    local raw = @unsafe own.release(state)
    local put = bufferstate.bindput(raw._state)
    if put ~= nil then
        (raw as any).put = put
    end
    if bufferProxyPrototype ~= nil then
        local proxy = bufferProxyFactory(bufferProxyPrototype)
        bufferProxyStates[proxy] = raw
        return @unsafe own.adopt<affine(Buffer)>(proxy)
    end

    return @unsafe own.adopt<affine(Buffer)>(raw)
end

--- Creates a buffer, optionally over starting bytes or a starting capacity.
---
--- The buffer is an owner, so it closes at its lexical boundary unless it is
--- transferred out of one. A number is a capacity to allocate rather than
--- content, and the buffer is still empty afterwards.
---
--- ```nupp
--- local buffer = io.Buffer.create("hello")
--- assert(buffer:len() == 5)
---
--- local sized = io.Buffer.create(4096)
--- assert(sized:len() == 0 and sized:capacity() == 4096)
--- ```
---
--- @param initial the starting bytes, a starting capacity, or nothing
--- @return the buffer, owned by the caller
--- @raises string when initial is neither bytes nor a capacity
--- @export
export function newBuffer(initial: integer | string?): affine(Buffer)
    if initial ~= nil and type(initial) ~= "number" and type(initial) ~= "string" then
        error("nupp: io.Buffer.create initial value must be bytes or a capacity", 2)
    end
    local bytes = type(initial) == "string" and initial as string or ""
    local capacity = type(initial) == "number" and bounds.count(initial, "io.Buffer.create capacity", 2) or #bytes

    return bufferFacade(HeapBuffer(_state = bufferstate.create(bytes, capacity)))
end

createBuffer = newBuffer

-- Compiler-owned text accumulation uses the same storage implementation without
-- constructing the public ownership facade for a nonescaping builder.
local function finishText(takes buffer: affine(Buffer)): string
    local text = buffer:tostring()
    buffer:close()
    return text
end

rawset(Buffer, "__textBuilder", bufferstate.textbuilder or newBuffer)
rawset(Buffer, "__textFinish", bufferstate.textfinish or finishText)

--- Opens a reader over bytes held as a string.
---
--- The reader is a `Reader` like any other, so a parser written against the
--- contract reads a string here and a file or a response body elsewhere without
--- changing:
---
--- ```nupp
---
--- local reader = io.Reader.of("hello")
--- assert(reader:read(5) == "hello")
--- assert(reader:read(1) == "")
--- ```
---
--- @param text the bytes to read
--- @return the reader, owned by the caller
--- @raises string when text is not a string
--- @export
export function newStringReader(text: string): Reader
    if type(text) ~= "string" then
        error("nupp: io.Reader.of needs a string", 2)
    end

    return newReaderOver(text)
end

local function newSpanReader(borrows source: span.Span<uint8>): affine(Reader) borrows (source)
    return SpanReader(_source = source, _at = 0, _closed = false)
end

local function newSharedBytesReader(source: immutable.SharedBytes): Reader
    return SpanReader(_source = source, _at = 0, _closed = false)
end

local function openReader(source: any): any
    if type(source) == "string" then
        return (newStringReader as any)(source)
    elseif source.view ~= nil and source.viewas ~= nil then
        return (newSharedBytesReader as any)(source)
    elseif source.span ~= nil and source.reserve ~= nil then
        return (newBufferReader as any)(source)
    end
    local _, count = (require("nupp.mem.span") as any).__sharedRef(source)
    if count ~= nil then
        return (newSpanReader as any)(source)
    end
    error("nupp: io.Reader.of needs a string, buffer, SharedBytes, or byte span", 2)
end

--- Opens a byte reader, retaining the source's borrow when needed.
export const newReader: function(source: string): Reader
    & function(exclusive source: Buffer): affine(Reader) borrows (source)
    & function(borrows source: span.Span<uint8>): affine(Reader) borrows (source)
    & function(source: immutable.SharedBytes): Reader = openReader as any

readSource = openReader as any
readBuffer = openReader as any
readSpan = openReader as any
readSharedBytes = openReader as any
-- Checked overloads retain their distinct borrow contracts; Lua and stored
-- references use the same implementation and runtime source discrimination.
rawset(Reader, "of", openReader)

--- Opens a byte writer that appends and exclusively borrows a buffer.
export function newWriter(exclusive destination: Buffer): affine(Writer) borrows (destination)
    return destination:writer()
end

writeBuffer = newWriter

-- Both `Writer.of` forms share one runtime entry: a file is taken and closed with the
-- writer, and anything else is a buffer borrowed for the writer's life.
local function openWriter(destination: any): any
    const publicIo: any = rawget(_G, "io")
    if publicIo ~= nil and publicIo.type(destination) ~= nil then
        return fileImplementation("io.internal.fileviews").ownedwriter(destination)
    end

    return destination:writer()
end

rawset(Writer, "of", openWriter)

readAll = function(takes reader: Reader, maxbytes: integer?): (string?, string?)
    local limit: integer? = nil
    if maxbytes ~= nil then
        limit = bounds.positive(maxbytes, "Reader:readall maxbytes", 2)
    end
    local parts: {string} = {}
    local total: integer = 0
    local failure: string? = nil
    while true do
        local wanted: integer = 65536
        if limit ~= nil and limit - total + 1 < wanted then
            -- One byte past the limit is enough to know the source is larger.
            wanted = limit - total + 1
        end
        local chunk, reason = reader:read(wanted)
        if chunk == nil then
            failure = reason ?? "the reader is closed"
            break
        elseif chunk == "" then
            break
        end
        total = total + #chunk
        if limit ~= nil and total > limit then
            failure = "the reader holds more than " .. tostring(limit) .. " bytes"
            break
        end
        parts[#parts + 1] = chunk
    end
    own.drop(reader)
    if failure ~= nil then
        return nil, failure
    end

    return table.concat(parts), nil
end

export const validatePositive = bounds.positive
export const validateInteger = bounds.count

export type OwnedBuffer = affine(Buffer)

local record LineReader is Lines
    @private _source: Reader
    @private _held: string
    @private _at: integer
    @private _limit: integer
    @private _closed: boolean
    @private _ended: boolean

    function isreleased(self): boolean
        return self._closed
    end

    function read(self): (string?, string?)
        if self._closed then
            return nil, "the line reader is closed"
        end
        while true do
            const found = self._held:find("\n", self._at + 1, true)
            if found ~= nil then
                local line = self._held:sub(self._at + 1, found - 1)
                if line:sub(-1) == "\r" then
                    line = line:sub(1, -2)
                end
                -- Measured against the line, not against the bytes it arrived
                -- in. Checked here rather than only before asking for more,
                -- because a terminator in the same chunk as an overlong line
                -- would otherwise walk past the bound; and after the carriage
                -- return has gone, because neither terminator byte belongs to
                -- the line and counting one against the limit would refuse a
                -- line of exactly the length that was allowed.
                if #line > self._limit then
                    return nil, "a line was longer than the limit"
                end
                self._at = found
                if self._at >= #self._held then
                    self._held = ""
                    self._at = 0
                end

                return line
            end
            -- No terminator yet. A line that never ends is not a line, and
            -- growing until it does is how a peer takes the process down, so
            -- the bound is checked before asking for more rather than after.
            -- A trailing carriage return gets one byte of grace, because it
            -- may be half of a terminator split across chunks: without it a
            -- line of exactly the allowed length would be refused or kept
            -- depending on where the chunks happened to fall.
            local grace = self._held:sub(-1) == "\r" and 1 or 0
            if #self._held - self._at > self._limit + grace then
                return nil, "a line was longer than the limit"
            end
            if self._ended then
                if self._at >= #self._held then
                    return nil
                end
                const rest = self._held:sub(self._at + 1)
                -- At the end a trailing carriage return is line content, not
                -- half a terminator, so the grace granted while more could
                -- still arrive is taken back here.
                if #rest > self._limit then
                    return nil, "a line was longer than the limit"
                end
                self._held = ""
                self._at = 0

                return rest
            end
            local held = #self._held - self._at
            local room = self._limit - held
            local wanted = (room < DEFAULT_READ - 2 and room + 2 or DEFAULT_READ) as integer
            const chunk, why = self._source:read(wanted)
            if chunk == nil then
                return nil, why
            end
            if #chunk > wanted then
                error("nupp: io.Reader returned more bytes than requested", 2)
            end
            if #chunk == 0 then
                self._ended = true
            else
                if self._at > 0 then
                    self._held = self._held:sub(self._at + 1)
                    self._at = 0
                end
                self._held = self._held .. chunk
            end
        end
    end

    function close(takes self): nil
        self._closed = true
        self._source:close()
    end
end

makeLines = function(takes source: Reader, limit: integer?): affine(Lines)
    const bound = bounds.positive(limit or 65536, "io.Reader:lines limit", 2)

    return LineReader(_source = source, _held = "", _at = 0, _limit = bound, _closed = false, _ended = false)
end

-- Validate the destination range before asking the source for any bytes.
readThrough = function(
    exclusive source: Reader,
    exclusive destination: Buffer,
    offset: integer?,
    count: integer?
): (integer?, string?)
    const from = bounds.count(offset or 0, "Reader:readinto offset", 4)
    const wanted = bounds.positive(count or DEFAULT_READ, "Reader:readinto count", 4)
    const lease = reserveAt_(destination, from, wanted)
    return source:readinto(lease)
end

-- The default `transferto`.
transferThrough = function(exclusive source: Reader, exclusive destination: Writer): (integer?, string?)
    const size = DEFAULT_READ as integer
    local moved: integer = 0
    while true do
        const chunk, why = source:read(size)
        if chunk == nil then
            return nil, why
        end
        if #chunk == 0 then
            return moved, nil
        end
        const wrote, failure = destination:write(chunk)
        if not wrote then
            return nil, failure
        end
        moved = moved + (#chunk as integer)
    end
end

--- Reserves a checked positional write for stream implementations.
reserveAt_ = function(
    exclusive buffer: Buffer,
    offset: integer,
    count: integer
): affine(BufferWriteLease, destroyLease) borrows (buffer)
    local state = buffer as any
    bounds.opened(bufferstate.closed(state._state), "io.Buffer", 2)
    local from = bounds.count(offset, "io.Buffer write offset", 2)
    local available = bounds.count(count, "io.Buffer write count", 2)
    local _ending = bounds.sum(from, available, "io.Buffer write range", 2)

    return newWriteLease(buffer, from, available)
end

export const reserveAt = reserveAt_

-- A scheduler registration temporarily retains a closure over an existing loan.
-- The wait ends the registration on success, failure, and cancellation. The box
-- keeps the complete closure alive across that registration, including its roots.
export record WaitCallback is own.Closeable
    @readonly callback: function(): boolean
    close: @nosuspend function(takes self: WaitCallback): nil
end

function WaitCallback.close(takes self: WaitCallback): nil
    local _raw = @unsafe own.release(self)
end

export function waitCallback(borrows callback: function(): boolean): affine(WaitCallback) borrows (callback)
    return WaitCallback(callback = callback)
end
