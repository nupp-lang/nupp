@!internal

module nupp.io.internal.scalars

local storage = require("nupp.io.internal.bytes")
local type ByteView = storage.ByteView
local type Buffer = storage.Buffer
local type ByteQueue = storage.ByteQueue
local type Reader = storage.Reader
local type Writer = storage.Writer
local newBuffer = storage.newBuffer
local integer_ = storage.validateInteger
local physical = require("nupp.runtime.storage")

--- Reads fixed-width numbers from a source of bytes.
--- @export
export interface ScalarReader is nupp.Closeable

    --- How many bytes are left, when that is knowable.
    --- @param self this reader
    --- @return the remaining byte count, or nil over an open-ended source
    --- @raises string when the reader is closed
    remaining: function(self: ScalarReader): integer?

    --- Whether the source has nothing left.
    --- @param self this reader
    --- @return whether it is at the end
    --- @raises string when the reader is closed, or its source failed
    atEnd: function(self: ScalarReader): boolean

    --- Discards bytes.
    --- @param self this reader
    --- @param count how many to discard
    --- @return this reader
    --- @raises string when there are not that many
    skip: function(borrows self: ScalarReader, count: integer): ScalarReader borrows (self)

    --- Reads bytes as they are.
    --- @param self this reader
    --- @param count how many to read
    --- @return the bytes
    --- @raises string when there are not that many
    readBytes: function(self: ScalarReader, count: integer): string

    --- Reads one unsigned 8-bit integer.
    --- @param self this reader
    --- @return the value, 0 through 255
    --- @raises string when the source has no bytes left
    readUint8: function(self: ScalarReader): uint32

    --- Reads one signed 8-bit integer.
    --- @param self this reader
    --- @return the value, -128 through 127
    --- @raises string when the source has no bytes left
    readInt8: function(self: ScalarReader): int32

    --- Reads one unsigned 16-bit integer in the machine's byte order.
    --- @param self this reader
    --- @return the value, 0 through 65535
    --- @raises string when fewer than 2 bytes are left
    readUint16: function(self: ScalarReader): uint32

    --- Reads one signed 16-bit integer in the machine's byte order.
    --- @param self this reader
    --- @return the value, -32768 through 32767
    --- @raises string when fewer than 2 bytes are left
    readInt16: function(self: ScalarReader): int32

    --- Reads one unsigned 32-bit integer in the machine's byte order.
    --- @param self this reader
    --- @return the value, 0 through 4294967295
    --- @raises string when fewer than 4 bytes are left
    readUint32: function(self: ScalarReader): uint32

    --- Reads one signed 32-bit integer in the machine's byte order.
    --- @param self this reader
    --- @return the value
    --- @raises string when fewer than 4 bytes are left
    readInt32: function(self: ScalarReader): int32

    --- Reads one unsigned 64-bit integer in the machine's byte order.
    --- @param self this reader
    --- @return the value, as `uint64` cdata
    --- @raises string when fewer than 8 bytes are left
    readUint64: function(self: ScalarReader): uint64

    --- Reads one signed 64-bit integer in the machine's byte order.
    --- @param self this reader
    --- @return the value, as `int64` cdata
    --- @raises string when fewer than 8 bytes are left
    readInt64: function(self: ScalarReader): int64

    --- Reads one 32-bit float in the machine's byte order.
    --- @param self this reader
    --- @return the value, widened to a Lua number
    --- @raises string when fewer than 4 bytes are left
    readFloat32: function(self: ScalarReader): float

    --- Reads one 64-bit float in the machine's byte order.
    --- @param self this reader
    --- @return the value
    --- @raises string when fewer than 8 bytes are left
    readFloat64: function(self: ScalarReader): number

    --- Closes the reader, and the reader it was built over when there was one.
    ---
    --- Repeated calls are safe.
    --- @param self this reader, spent by the call
    close: @nosuspend function(takes self: ScalarReader): nil
end

-- Declared after the interface they take, so a reader here is the owner it names, and
-- defined below.
local fill: function(borrows self: ScalarReader, need: integer): (integer, string?)
local taken: function(borrows self: ScalarReader, need: integer): string

----------------------------------------------------------------------------
-- Scalars
----------------------------------------------------------------------------

--- The storage behind a scalar reader.
local record Scalars is ScalarReader
    @private
    _pending: string
    @private
    _reader: any
    @private
    _queue: any
    @private
    _closed: boolean
    close: @nosuspend function(takes self: Scalars): nil

    function remaining(self): integer?
        if self._closed then
            error("nupp: io.ScalarReader is closed", 2)
        end
        if self._reader then
            return nil
        end
        if self._queue then
            return #self._pending + storage.queueLength(self._queue as ByteQueue)
        end

        return #self._pending
    end

    function atEnd(self): boolean
        if self._closed then
            error("nupp: io.ScalarReader is closed", 2)
        end
        local have, failure = fill(self, 1)
        if failure then
            error("nupp: io.ScalarReader source failed: " .. tostring(failure), 2)
        end

        return have < 1
    end

    function skip(borrows self, count: integer): ScalarReader borrows (self)
        taken(self, integer_(count, "io.ScalarReader count", 2))

        return self
    end

    function readBytes(self, count: integer): string
        return taken(self, integer_(count, "io.ScalarReader count", 2))
    end

    function readUint8(self): uint32
        local raw = taken(self, 1)
        local value = physical.decodeUint8(raw)

        return nupp.math.u32.wrap(value as integer)
    end

    function readInt8(self): int32
        local raw = taken(self, 1)
        local value = physical.decodeInt8(raw)

        return nupp.math.i32.wrap(value as integer)
    end

    function readUint16(self): uint32
        local raw = taken(self, 2)
        local value = physical.decodeUint16(raw)

        return nupp.math.u32.wrap(value as integer)
    end

    function readInt16(self): int32
        local raw = taken(self, 2)
        local value = physical.decodeInt16(raw)

        return nupp.math.i32.wrap(value as integer)
    end

    function readUint32(self): uint32
        local raw = taken(self, 4)
        local value = physical.decodeUint32(raw)

        return nupp.math.u32.wrap(value as integer)
    end

    function readInt32(self): int32
        local raw = taken(self, 4)
        local value = physical.decodeInt32(raw)

        return nupp.math.i32.wrap(value as integer)
    end

    function readUint64(self): uint64
        local raw = taken(self, 8)
        local value = physical.decodeUint64(raw)

        return value as uint64
    end

    function readInt64(self): int64
        local raw = taken(self, 8)
        local value = physical.decodeInt64(raw)

        return value as int64
    end

    function readFloat32(self): float
        local raw = taken(self, 4)
        local value = physical.decodeFloat32(raw)

        return nupp.math.f32.narrow(value as number)
    end

    function readFloat64(self): number
        local raw = taken(self, 8)
        local value = physical.decodeFloat64(raw)

        return value as number
    end

end

--- Writes fixed-width numbers into a destination.
--- @export
export interface ScalarWriter is nupp.Closeable

    --- Writes bytes as they are.
    --- @param self this writer
    --- @param bytes the bytes to write
    --- @return this writer
    --- @raises string when bytes is not a string
    writeBytes: function(borrows self: ScalarWriter, bytes: string): ScalarWriter borrows (self)

    --- Writes one unsigned 8-bit integer.
    --- @param self this writer
    --- @param value the number to write
    --- @return this writer
    writeUint8: function(borrows self: ScalarWriter, value: uint32): ScalarWriter borrows (self)

    --- Writes one signed 8-bit integer.
    --- @param self this writer
    --- @param value the number to write
    --- @return this writer
    writeInt8: function(borrows self: ScalarWriter, value: int32): ScalarWriter borrows (self)

    --- Writes one unsigned 16-bit integer in the machine's byte order.
    --- @param self this writer
    --- @param value the number to write
    --- @return this writer
    writeUint16: function(borrows self: ScalarWriter, value: uint32): ScalarWriter borrows (self)

    --- Writes one signed 16-bit integer in the machine's byte order.
    --- @param self this writer
    --- @param value the number to write
    --- @return this writer
    writeInt16: function(borrows self: ScalarWriter, value: int32): ScalarWriter borrows (self)

    --- Writes one unsigned 32-bit integer in the machine's byte order.
    --- @param self this writer
    --- @param value the number to write
    --- @return this writer
    writeUint32: function(borrows self: ScalarWriter, value: uint32): ScalarWriter borrows (self)

    --- Writes one signed 32-bit integer in the machine's byte order.
    --- @param self this writer
    --- @param value the number to write
    --- @return this writer
    writeInt32: function(borrows self: ScalarWriter, value: int32): ScalarWriter borrows (self)

    --- Writes one unsigned 64-bit integer in the machine's byte order.
    --- @param self this writer
    --- @param value the number to write
    --- @return this writer
    writeUint64: function(borrows self: ScalarWriter, value: uint64): ScalarWriter borrows (self)

    --- Writes one signed 64-bit integer in the machine's byte order.
    --- @param self this writer
    --- @param value the number to write
    --- @return this writer
    writeInt64: function(borrows self: ScalarWriter, value: int64): ScalarWriter borrows (self)

    --- Writes one 32-bit float in the machine's byte order.
    --- @param self this writer
    --- @param value the number to write
    --- @return this writer
    writeFloat32: function(borrows self: ScalarWriter, value: float): ScalarWriter borrows (self)

    --- Writes one 64-bit float in the machine's byte order.
    --- @param self this writer
    --- @param value the number to write
    --- @return this writer
    writeFloat64: function(borrows self: ScalarWriter, value: number): ScalarWriter borrows (self)

    --- The buffer this writer fills, when it has one of its own.
    --- @param self this writer
    --- @return the buffer, or nil when writing through a writer
    buffer: function(borrows self: ScalarWriter): Buffer? borrows (self)

    --- Flushes the destination, when there is one to flush.
    ---
    --- This is where a destination that failed to take its bytes says so: `close`
    --- answers nothing, so a caller that needs to know flushes first.
    --- @param self this writer
    --- @return whether it flushed
    --- @return why it did not, when it did not
    flush: function(self: ScalarWriter): (boolean, string?)

    --- Closes the writer, and the writer it was built over when there was one.
    ---
    --- Repeated calls are safe.
    --- @param self this writer, spent by the call
    close: @nosuspend function(takes self: ScalarWriter): nil
end

-- Declared after the interface it takes and answers, and defined below.
local put: function(borrows self: ScalarWriter, bytes: string): nil

--- The storage behind a scalar writer.
local record ScalarSink is ScalarWriter
    @private
    _buffer: any
    @private
    _writer: any
    @private
    _ownsBuffer: boolean
    @private
    _closed: boolean
    close: @nosuspend function(takes self: ScalarSink): nil

    function writeBytes(borrows self, bytes: string): ScalarWriter borrows (self)
        if type(bytes) ~= "string" then
            error("nupp: io.ScalarWriter bytes must be a string", 2)
        end

        put(self, bytes)

        return self
    end

    function writeUint8(borrows self, value: uint32): ScalarWriter borrows (self)
        put(self, physical.encodeUint8(value))

        return self
    end

    function writeInt8(borrows self, value: int32): ScalarWriter borrows (self)
        put(self, physical.encodeInt8(value))

        return self
    end

    function writeUint16(borrows self, value: uint32): ScalarWriter borrows (self)
        put(self, physical.encodeUint16(value))

        return self
    end

    function writeInt16(borrows self, value: int32): ScalarWriter borrows (self)
        put(self, physical.encodeInt16(value))

        return self
    end

    function writeUint32(borrows self, value: uint32): ScalarWriter borrows (self)
        put(self, physical.encodeUint32(value))

        return self
    end

    function writeInt32(borrows self, value: int32): ScalarWriter borrows (self)
        put(self, physical.encodeInt32(value))

        return self
    end

    function writeUint64(borrows self, value: uint64): ScalarWriter borrows (self)
        put(self, physical.encodeUint64(value))

        return self
    end

    function writeInt64(borrows self, value: int64): ScalarWriter borrows (self)
        put(self, physical.encodeInt64(value))

        return self
    end

    function writeFloat32(borrows self, value: float): ScalarWriter borrows (self)
        put(self, physical.encodeFloat32(value))

        return self
    end

    function writeFloat64(borrows self, value: number): ScalarWriter borrows (self)
        put(self, physical.encodeFloat64(value))

        return self
    end

    function buffer(borrows self): Buffer? borrows (self)
        return self._buffer
    end

    function flush(self): (boolean, string?)
        if self._closed then
            return false, "the writer is closed"
        end
        if self._writer then
            return self._writer:flush()
        end

        return true, nil
    end

end

function Scalars.close(takes self: Scalars): nil
    local state = @unsafe nupp.release(self)
    local reader = state._reader
    state._closed = true
    state._pending = ""
    state._queue = nil
    state._reader = nil
    if reader then
        reader:close()
    end
end

function ScalarSink.close(takes self: ScalarSink): nil
    local state = @unsafe nupp.release(self)
    local writer = state._writer
    local buffer = state._buffer
    local ownsBuffer = state._ownsBuffer
    state._closed = true
    state._writer = nil
    state._buffer = nil
    if writer then
        writer:close()
    elseif ownsBuffer and buffer then
        buffer:close()
    end
end

-- Pulls from whichever source this reader was built over until `need` bytes are
-- pending or the source stops answering. A reader that reports a failure stops the
-- fill; the caller decides whether that is fatal.
fill = function(borrows self: ScalarReader, need: integer): (integer, string?)
    local state = self as any
    local failure: string? = nil
    if state._reader then
        while #(state._pending as string) < need do
            local wanted = need - #(state._pending as string)
            local chunk, reason = state._reader:read(wanted)
            if chunk == nil then
                failure = reason
                break
            elseif chunk == "" then
                break
            end
            if #chunk > wanted then
                error("nupp: io.Reader returned more bytes than requested", 3)
            end
            state._pending = (state._pending as string) .. (chunk as string)
        end
    elseif state._queue then
        local want = need - #(state._pending as string)
        local queue = state._queue as ByteQueue
        local have = want > 0 and storage.queueLength(queue) or 0
        if have > 0 then
            local taking = math.min(want, have) as integer
            local chunk: any = queue:get(taking)
            if type(chunk) ~= "string" or #chunk ~= taking then
                error("nupp: io.ByteQueue returned the wrong byte count", 3)
            end
            state._pending = (state._pending as string) .. (chunk as string)
        end
    end

    return #(state._pending as string), failure
end

--- @raises string when the reader is closed, its source failed, or it is short
taken = function(borrows self: ScalarReader, need: integer): string
    local state = self as any
    if state._closed then
        error("nupp: io.ScalarReader is closed", 3)
    end
    local have, failure = fill(self, need)
    if failure then
        error("nupp: io.ScalarReader source failed: " .. tostring(failure), 3)
    end
    if have < need then
        error(("nupp: io.ScalarReader needs %d bytes, has %d"):format(need, have), 3)
    end
    local out = (state._pending as string):sub(1, need)
    state._pending = (state._pending as string):sub(need + 1)

    return out
end

--- @raises string when the writer is closed, or its destination failed
put = function(borrows self: ScalarWriter, bytes: string): nil
    local state = self as any
    if state._closed then
        error("nupp: io.ScalarWriter is closed", 3)
    end
    if state._buffer then
        -- Kept untyped: a local typed as the buffer would be an owner of it, and
        -- would close it on the way out.
        local buffer = state._buffer
        buffer:setString(bytes, buffer:length())

        return
    end
    local ok, reason = state._writer:write(bytes)
    if not ok then
        error("nupp: io.ScalarWriter destination failed: " .. tostring(reason), 3)
    end
end

local function queueLike(value: any): boolean
    local kind = type(value)
    if kind == "table" then
        return value.get ~= nil
    elseif kind == "userdata" or kind == "cdata" then
        -- Reading a field off foreign data can raise, so asking is done under pcall.
        local ok, getter = pcall(function(): any
            return value.get
        end)

        return ok and getter ~= nil
    else
        return false
    end
end

local function readerLike(value: any): boolean
    local kind = type(value)
    if kind ~= "table" and kind ~= "userdata" and kind ~= "cdata" then
        return false
    end
    local ok, answer = pcall(function(): boolean
        return type(value.read) == "function"
            and type(value.readSpan) == "function"
            and type(value.readInto) == "function"
            and type(value.transferTo) == "function"
            and type(value.close) == "function"
    end)

    return ok and answer
end

-- The two scalar factories are declared below rather than written as exports,
-- because each accepts its sources under different ownership: a snapshot or buffer is
-- borrowed, a reader is taken, and a string or queue carries no obligation at all.
-- One parameter cannot say three things, so the surface is an intersection of three
-- signatures over one body.
local function openScalarReader(source: any): ScalarReader
    local pending = ""
    local reader: any = nil
    local queue: any = nil
    local kind = type(source)
    if kind == "string" then
        pending = source
    elseif readerLike(source) then
        reader = source
    elseif kind == "table" and source.getString ~= nil then
        pending = source:getString()
    elseif queueLike(source) then
        queue = source
    else
        error("nupp: io.newScalarReader needs bytes, a snapshot, a buffer, a reader or a byte queue", 2)
    end

    return new Scalars(_pending = pending, _reader = reader, _queue = queue, _closed = false)
end

local function openScalarWriter(destination: any): ScalarWriter
    local buffer: any = nil
    local writer: any = nil
    local ownsBuffer = false
    if destination == nil then
        -- The scalar writer owns this buffer. `buffer()` only borrows it, and scalar
        -- teardown discharges the buffer obligation with the writer's own.
        buffer = @unsafe nupp.release(newBuffer(nil))
        ownsBuffer = true
    elseif type(destination) == "table" and destination.write ~= nil then
        writer = destination
    elseif type(destination) == "table" and destination.setString ~= nil then
        buffer = destination
    else
        error("nupp: io.newScalarWriter needs a buffer, a writer, or nothing", 2)
    end

    return new ScalarSink(_buffer = buffer, _writer = writer, _ownsBuffer = ownsBuffer, _closed = false)
end

--- Opens a cursor for sized integer and float reads.
---
--- A string, snapshot or buffer is read from a copy of its bytes taken here, and
--- reports its `remaining` count. A reader or a queue is consumed in place: the reader
--- answers no count, the queue answers what it still holds.
---
--- What the source is decides what happens to it. A snapshot or a buffer is
--- borrowed and outlives the cursor; a reader is taken, and closing the cursor
--- closes it; a string or a queue carries no obligation either way.
---
--- ```nupp
--- do
---     local cursor = io.newScalarReader(header)
---     local magic = cursor:readUint32()
---     local count = cursor:readUint16()
--- end
--- ```
---
--- @param source the bytes, snapshot, buffer, reader or queue to read
--- @return the new reader, owned by the caller
--- @raises string when source is none of those
--- @export
export const newScalarReader: function(source: string | ByteQueue): affine(ScalarReader)
    & function(borrows source: ByteView | Buffer): affine(ScalarReader)
    & function(takes source: Reader): affine(ScalarReader) = openScalarReader as any

--- Opens a cursor for sized integer and float writes.
---
--- A buffer is appended to, keeping what it already holds. A writer receives the bytes
--- as they are written. Omitting the destination starts a fresh buffer, which
--- `ScalarWriter:buffer` hands back.
---
--- ```nupp
--- do
---     local cursor = io.newScalarWriter()
---     cursor:writeUint32(0x4d495355):writeUint16(2)
---     local bytes = cursor:buffer()
---     assert(bytes ~= nil and bytes:getString() ~= "")
--- end
--- ```
---
--- @param destination the buffer or writer to append to, or nothing for a fresh buffer
--- @return the new writer, owned by the caller
--- @raises string when destination is neither a buffer nor a writer
--- @export
export const newScalarWriter: function(): affine(ScalarWriter)
    & function(borrows destination: Buffer): affine(ScalarWriter) borrows (destination)
    & function(takes destination: Writer): affine(ScalarWriter) = openScalarWriter as any
