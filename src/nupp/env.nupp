--[[
The environment a check happens in.

Created once per project or session and shared across every file checked in it,
so the prelude is parsed once and a module's type is computed once. It carries:

- the global bindings and types, from the prelude and any declaration files;
- the string library's shape, which is what makes `s:sub()` type;
- the cache of already-resolved modules, keyed by module name;
- the `require()` hook the checker calls to resolve a name to a type.

Project configuration comes from an `nupp.lua` file at the project root, which
returns a table — `{ include = { "src" } }` and the rest — and which is also
where the include roots that module resolution searches are named.
]]

local parser = require("nupp.parser")
local check = require("nupp.check")
local cst = require("nupp.cst")
local T = require("nupp.types")
local annotationMod = require("nupp.annotations")

local envMod = {}

local modulePatterns = {
    "/%s.d.nupp", "/%s.nupp", "/%s.lua",
    "/%s/init.nupp", "/%s/init.lua",
}

local runtimeModulePatterns = {
    "/%s.nupp", "/%s.lua", "/%s/init.nupp", "/%s/init.lua",
}

local function moduleDir()
    local src = debug.getinfo(1, "S").source
    return src:match("^@(.*)[/\\]") or "."
end

local function readFile(path)
    local f = io.open(path, "rb")
    if not f then return nil end
    local content = f:read("*a")
    f:close()
    return content
end

-- Where a bundled declaration comes from.
--
-- A build leaves them on disk beside the compiled modules. The stage-0 bundle
-- cannot: it is one file, and one file cannot bring a directory along, so it
-- carries them inside itself as a preloaded module of path -> source.
--
-- Deliberately only the compiler's own declarations, and deliberately not a
-- general virtual filesystem layered under every read. A VFS would let an
-- in-memory entry shadow a real file the user wrote at the same path, and then
-- which one wins is a question the language would have to answer forever. This
-- answers a much smaller one: where the compiler keeps its own prelude.
local embedded = nil
local function bundledSource(relative)
    if embedded == nil then
        local preloaded = package.preload["nupp.embedded"]
        embedded = preloaded and preloaded() or false
    end
    if embedded and embedded[relative] then return embedded[relative] end
    return readFile(moduleDir() .. relative)
end

-- Parenthesized so the replacement count `gsub` also returns cannot ride
-- along as a stray second argument wherever a path is passed on.
local function normalizePath(path)
    path = path:gsub("\\", "/"):gsub("/+", "/")
    path = path:gsub("^%./", ""):gsub("/%./", "/")
    return (path:gsub("/$", ""))
end

local function pathDir(path)
    return normalizePath(path):match("^(.*)/[^/]+$") or ""
end

local function shellQuote(text)
    return "'" .. text:gsub("'", "'\\''") .. "'"
end

local function listLjppFiles(root, withDeclarations)
    local command
    if package.config:sub(1, 1) == "\\" then
        command = ('dir /s /b "%s\\*.nupp" 2>nul'):format(
            root:gsub('"', '""'))
    else
        command = "find " .. shellQuote(root) .. " -type f -name '*.nupp'"
            .. (withDeclarations and "" or " ! -name '*.d.nupp'")
            .. " 2>/dev/null"
    end
    local pipe = io.popen(command)
    if not pipe then return {} end
    local files = {}
    for path in pipe:lines() do files[#files + 1] = normalizePath(path) end
    pipe:close()
    return files
end

-- Generated output is not written by hand, and a dot-directory is somebody
-- else's bookkeeping — a VCS store, a nested worktree.
local function isBookkeepingPath(path, outDir)
    local generated = path == outDir or path:sub(1, #outDir + 1) == outDir .. "/"
    local hidden = ("/" .. path):find("/%.") ~= nil
    return generated or hidden
end

local function outDirFor(env)
    local rootDir = env.rootDir or "."
    local build = (env.config or {}).build or {}
    return normalizePath(rootDir .. "/" .. (build.outDir or "build"))
end

function envMod.listProjectFiles(env)
    local files, seen = {}, {}
    local outDir = outDirFor(env)
    for _, root in ipairs(env.roots or {}) do
        for _, path in ipairs(listLjppFiles(root)) do
            if not seen[path] and not isBookkeepingPath(path, outDir) then
                seen[path] = true
                files[#files + 1] = path
            end
        end
    end
    table.sort(files)
    return files
end

-- Every file the project is written in, declarations included.
--
-- Deliberately not the whole tree, and deliberately not the module list either.
--
-- Not the tree, because a tree also holds build output, a tracked bootstrap and
-- test fixtures — files nobody writes by hand, and a formatter that rewrites
-- them breaks the build to tidy something that was never untidy. The include
-- roots are where a project itself says its source lives, so they are what is
-- taken; a project that declares none is its own root.
--
-- Not the module list, because a declaration file is source: the formatter has
-- a doctrine for the typed layer a `.d.nupp` is entirely made of. Nothing
-- requires one as a module, which is why the module list drops them, but
-- somebody wrote it and somebody reads it.
--
-- `withDeclarations` false drops the `.d.nupp` files again, which is what a
-- build wants: they describe an interface somebody else implements, so there is
-- nothing to compile.
function envMod.listSourceFiles(env, withDeclarations)
    if withDeclarations == nil then withDeclarations = true end
    local rootDir = env.rootDir or "."
    local roots = {}
    for _, dir in ipairs((env.config or {}).include or {}) do
        roots[#roots + 1] = rootDir .. "/" .. dir
    end
    if #roots == 0 then roots[1] = rootDir end
    local outDir = outDirFor(env)
    local files, seen = {}, {}
    for _, root in ipairs(roots) do
        for _, path in ipairs(listLjppFiles(root, withDeclarations)) do
            if not seen[path] and not isBookkeepingPath(path, outDir) then
                seen[path] = true
                files[#files + 1] = path
            end
        end
    end
    table.sort(files)
    return files
end

function envMod.moduleNameForPath(env, path)
    path = normalizePath(path)
    local best = nil
    for _, rawRoot in ipairs(env.roots or {}) do
        local root = normalizePath(rawRoot)
        local rel = nil
        if root == "." or root == "" then
            if path:sub(1, 1) ~= "/" then rel = path end
        elseif path:sub(1, #root + 1) == root .. "/" then
            rel = path:sub(#root + 2)
        end
        if rel and rel:match("%.nupp$") and not rel:match("%.d%.nupp$") then
            rel = rel:gsub("%.nupp$", "")
            rel = rel:gsub("/init$", "")
            local name = rel:gsub("/", ".")
            if name ~= "" and (not best or #name < #best) then best = name end
        end
    end
    return best
end

local function declarationKind(stat)
    if stat.kind == "recordDecl" then return stat.declKind end
    if stat.kind == "enumDecl" then return "enum" end
    return "type"
end

local function annotatedDeclaration(stat)
    local annotationDefinition = false
    while stat and stat.kind == "pragmaStmt" do
        if stat.name and stat.name.text == "annotation" then
            annotationDefinition = true
        end
        stat = stat.stat
    end
    return stat, annotationDefinition
end

-- Extracts only project-index information from one overlay-aware parse.
-- `signature` changes when any part of an exported declaration changes,
-- while body-only edits outside declarations leave the header unchanged.
function envMod.projectHeader(env, path, parsed)
    path = normalizePath(path)
    local header = {
        path = path, moduleName = envMod.moduleNameForPath(env, path),
        declarations = {},
    }
    if not parsed or #parsed.errors > 0 then return header end
    local moduleLocal = cst.returnedLocal(parsed.root)
    header.moduleLocal = moduleLocal
    for _, block in ipairs(parsed.root.blocks or {}) do
        for _, stat in ipairs(block.stats or {}) do
            local declaration, isAnnotation = annotatedDeclaration(stat)
            local visibility = declaration
                and cst.declVisibility(declaration, moduleLocal)
            if declaration and (declaration.kind == "typeAlias"
                or declaration.kind == "recordDecl"
                or declaration.kind == "enumDecl")
                and (visibility == "module" or visibility == "global") then
                header.declarations[#header.declarations + 1] = {
                    name = declaration.name.text,
                    kind = declarationKind(declaration),
                    statKind = declaration.kind,
                    visibility = visibility,
                    token = declaration.name,
                    signature = cst.textOf(stat),
                    isAnnotation = isAnnotation,
                }
            end
        end
    end
    return header
end

-- Builds the lookup tables from per-file headers. `nominals` is deliberately
-- longer-lived than an index revision so declaration-site identity survives
-- overlay edits and dependent query rechecks.
function envMod.buildProjectIndex(headers, nominals)
    local index = {
        byName = {}, byPath = {}, modules = {}, annotationsByName = {},
        -- Final path segment -> the modules that end in it. Nothing resolves
        -- through this: a module is reached by requiring it. It exists so an
        -- unknown name that happens to name a module can say so, which is the
        -- one thing a reader loses by that name meaning nothing.
        moduleBasenames = {},
    }
    nominals = nominals or {}
    for _, header in ipairs(headers or {}) do
        local moduleName = header.moduleName
        if moduleName then
            index.modules[moduleName] = header.path
            local short = moduleName:match("([^.]+)$")
            local named = index.moduleBasenames[short] or {}
            named[#named + 1] = moduleName
            index.moduleBasenames[short] = named
        end
        local occurrences = {}
        for _, declaration in ipairs(header.declarations or {}) do
            local occurrenceKey = declaration.name .. "\0" .. declaration.kind
                .. "\0" .. declaration.visibility
            occurrences[occurrenceKey] = (occurrences[occurrenceKey] or 0) + 1
            local identityKey = header.path .. "\0" .. occurrenceKey .. "\0"
                .. tostring(occurrences[occurrenceKey])
            local entry = {
                name = declaration.name, path = header.path,
                moduleName = moduleName,
                visibility = declaration.visibility, kind = declaration.kind,
                signature = declaration.signature,
                definition = {
                    filename = header.path, token = declaration.token,
                    name = declaration.name,
                    kind = declaration.kind == "record"
                    and "type" or declaration.kind,
                },
            }
            if declaration.statKind ~= "typeAlias" then
                local nominal = nominals[identityKey]
                if not nominal then
                    nominal = T.nominal(entry.name, entry.kind)
                    nominals[identityKey] = nominal
                end
                entry.type = nominal
            end
            local named = index.byName[entry.name] or {}
            named[#named + 1] = entry
            index.byName[entry.name] = named
            local inFile = index.byPath[header.path] or {}
            inFile[#inFile + 1] = entry
            index.byPath[header.path] = inFile
            if declaration.isAnnotation then
                local definitions = index.annotationsByName[entry.name] or {}
                definitions[#definitions + 1] = entry
                index.annotationsByName[entry.name] = definitions
            end
        end
    end
    for _, named in pairs(index.moduleBasenames) do table.sort(named) end
    return index
end

-- Builds a declaration-header index without checking bodies. Nominal export
-- skeletons are allocated here, giving them stable declaration-site identity
-- and allowing mutually recursive project types to see one another.
function envMod.ensureProjectIndex(env)
    if env.projectIndex then return env.projectIndex end
    local headers = {}
    for _, path in ipairs(envMod.listProjectFiles(env)) do
        local source = readFile(path)
        headers[#headers + 1] = envMod.projectHeader(env, path,
            source and parser.parse(source, path) or nil)
    end
    env.projectNominals = env.projectNominals or {}
    env.projectIndex = envMod.buildProjectIndex(headers, env.projectNominals)
    return env.projectIndex
end

local function projectIndexFor(env)
    local ensure = env.ensureProjectIndex or envMod.ensureProjectIndex
    return ensure(env)
end

function envMod.declarationType(env, filename, name, kind, visibility)
    if visibility ~= "module" and visibility ~= "global" then return nil end
    local index = projectIndexFor(env)
    local path = normalizePath(filename)
    for _, entry in ipairs(index.byPath[path] or {}) do
        if entry.name == name and entry.kind == kind
            and entry.visibility == visibility then
            return entry.type, entry
        end
    end
    return nil
end

local function findModulePath(env, name, patterns)
    local rel = name:gsub("%.", "/")
    for _, root in ipairs(env.roots) do
        for _, pattern in ipairs(patterns) do
            local candidate = root .. pattern:format(rel)
            local f = io.open(candidate, "rb")
            if f then
                f:close()
                return candidate
            end
        end
    end
    return nil
end

-- Finds the file backing module `name`, or nil. Shared by the batch
-- resolver below and the incremental engine.
function envMod.findModulePath(env, name)
    return findModulePath(env, name, modulePatterns)
end

-- Runtime loading deliberately excludes declaration files, but includes plain
-- Lua so execution uses the same roots and precedence as type resolution. If
-- no project module exists, require() continues through Lua's remaining loaders.
function envMod.findRuntimeModulePath(env, name)
    return findModulePath(env, name, runtimeModulePatterns)
end

local function seededExports(env, path)
    local exports = {types = {}, typeDefs = {}, values = {}}
    local index = projectIndexFor(env)
    for _, entry in ipairs(index.byPath[normalizePath(path)] or {}) do
        if entry.visibility == "module" and entry.type then
            exports.types[entry.name] = entry.type
            exports.typeDefs[entry.name] = entry.definition
            if entry.kind == "struct" then exports.values[entry.name] = entry.type end
        end
    end
    return exports
end

local function loadModule(env, name)
    local cached = env.loaded[name]
    if cached then return cached end
    local path = envMod.findModulePath(env, name)
    if not path then
        -- bundled declarations are the fallback, so a project may ship its
        -- own file for a bundled name and have it win
        local bundled = env.bundled and env.bundled[name]
        return bundled
    end
    path = normalizePath(path)
    local byPath = env.loadedPaths[path]
    if byPath then
        env.loaded[name] = byPath
        return byPath
    end
    local src = readFile(path)
    if not src then return nil end
    local record = {
        inProgress = true, path = path, exports = seededExports(env, path),
    }
    env.loaded[name] = record
    env.loadedPaths[path] = record
    local result = parser.parse(src, path)
    if #result.errors == 0 then
        local _, moduleType, exports = check.check(result, path, env, {
            moduleName = name, initialExports = record.exports,
        })
        record.type = moduleType or T.any
        record.exports = exports or record.exports
    else
        record.type = T.any
    end
    record.inProgress = false
    return record
end

-- Resolves `name` ("a.b.c") against the search roots; returns the module's
-- runtime value type, caching per path. Cycles yield any for the value layer.
function envMod.resolveModule(env, name)
    local record = loadModule(env, name)
    if not record then return nil end
    return record.inProgress and T.any or record.type
end

function envMod.resolveModuleExports(env, name)
    local record = loadModule(env, name)
    return record and record.exports or nil
end

-- Only a global is reachable without saying where it comes from; a module
-- member is reached through the table it was declared on. Two globals of one
-- name conflict wherever they sit, so there is no nearest-wins rule to apply.
local function globalEntry(entries, kind)
    local found = nil
    local matches = {}
    for _, entry in ipairs(entries or {}) do
        if entry.visibility == "global"
            and (not kind or entry.kind == kind) then
            matches[#matches + 1] = entry
            found = entry
        end
    end
    if #matches > 1 then return nil, "ambiguous project type", matches end
    return found
end

-- Loading the declaring module is what fills the index entry's type in, so an
-- unqualified global resolves on the first reference to it.
local function loadedGlobal(env, entries, kind)
    local entry, err, conflicts = globalEntry(entries, kind)
    if not entry then return nil, err, conflicts end
    if entry.moduleName then
        env.resolveModuleExports(env, entry.moduleName)
    end
    return entry, nil
end

function envMod.resolveProjectType(env, filename, name)
    local index = projectIndexFor(env)
    local entry, err, conflicts = loadedGlobal(env, index.byName[name])
    if not entry then return nil, nil, err, nil, nil, conflicts end
    return entry.type, entry.definition, nil, entry.moduleName, entry.visibility
end

-- The modules whose final path segment is `short`, for diagnostics only. A file
-- of this name existing is what makes a missing `require` worth mentioning
-- rather than leaving the name to mean nothing until it is run.
function envMod.modulesNamed(env, short)
    local index = projectIndexFor(env)
    return index.moduleBasenames[short]
end

-- The modules exporting a type named `name`, for the fix that offers the
-- qualified spelling of an unqualified type nobody declared here. Reads the
-- declaration-header index only: a name being exported somewhere is a
-- syntactic fact, and loading those modules to say so would check the project
-- to answer a question about a program that does not compile.
function envMod.modulesExporting(env, name)
    local index = projectIndexFor(env)
    local modules, seen = {}, {}
    for _, entry in ipairs(index.byName[name] or {}) do
        if entry.visibility == "module" and entry.moduleName
            and not seen[entry.moduleName] then
            seen[entry.moduleName] = true
            modules[#modules + 1] = entry.moduleName
        end
    end
    table.sort(modules)
    return modules
end

function envMod.resolveProjectValue(env, filename, name)
    local index = projectIndexFor(env)
    local entry, err, conflicts = loadedGlobal(env, index.byName[name], "struct")
    if not entry then return nil, nil, err, nil, conflicts end
    return entry.type, entry.definition, nil, entry.moduleName
end

-- Resolves a project annotation lazily. Loading the module checks its
-- @annotation declaration, which installs the typed schema into this
-- environment's registry before the caller validates the application.
function envMod.resolveProjectAnnotation(env, filename, name)
    local index = projectIndexFor(env)
    local entries = index.annotationsByName[name]
    if not entries or #entries == 0 then return nil end
    if #entries > 1 then return nil, "ambiguous project annotation @" .. name end
    local entry = entries[1]
    if normalizePath(entry.path) ~= normalizePath(filename)
        and entry.moduleName then
        env.resolveModuleExports(env, entry.moduleName)
    end
    return env.annotations:get(name), nil
end

function envMod.resolveQualifiedType(env, filename, moduleName, typeName)
    local names = {moduleName}
    local currentModule = envMod.moduleNameForPath(env, filename)
    local currentDir = currentModule and currentModule:match("^(.*)%.[^.]+$")
    if currentDir and not moduleName:find("%.", 1, false) then
        table.insert(names, 1, currentDir .. "." .. moduleName)
    end
    local self_ = normalizePath(filename)
    for _, candidate in ipairs(names) do
        -- A file's own declarations are already in scope, so resolving its
        -- module here would only re-enter the check that is running and cache
        -- the half-built exports it finds.
        local candidatePath = envMod.findModulePath(env, candidate)
        if not candidatePath or normalizePath(candidatePath) ~= self_ then
            local exports = env.resolveModuleExports(env, candidate)
            local t = exports and exports.types[typeName] or nil
            if t then
                return t, exports.typeDefs[typeName], candidate
            end
        end
    end
    return nil
end

-- The nominal a module exports under `typeName`, for the value path: a record's
-- runtime table and a struct's ctype are values as well as types, and the
-- module table they sit on is inferred open, so this pairing is known nowhere
-- else.
--
-- The project index decides first whether there is a declaration to find, which
-- costs no loading. Only then is the declaring module resolved, so an ordinary
-- field access on a required module never pulls that module in mid-check while
-- a construction still resolves whatever order the files are reached in.
function envMod.exportedNominal(env, moduleName, typeName)
    local index = projectIndexFor(env)
    local entry = nil
    for _, candidate in ipairs(index.byName[typeName] or {}) do
        if candidate.moduleName == moduleName
            and candidate.visibility == "module"
            and (candidate.kind == "record" or candidate.kind == "struct") then
            entry = candidate
            break
        end
    end
    if not entry then return nil end
    if entry.type then return entry.type, entry.definition end
    local exports = env.resolveModuleExports(env, moduleName)
    return exports and exports.types[typeName] or entry.type,
        exports and exports.typeDefs[typeName] or entry.definition
end

-- The config `dir` declares, or an empty table. A folder with no `nupp.lua`
-- is still a folder of Nupp files; it just says nothing about how to read them.
local function configAt(dir)
    local chunk = loadfile(dir .. "/nupp.lua")
    if not chunk then return {} end
    local ok, loaded = pcall(chunk)
    return ok and type(loaded) == "table" and loaded or {}
end

-- rootDir: project root (search base and nupp.lua location). opts.config
-- may override the loaded config table.
--
-- opts.folders are further roots to search, which is what an editor session
-- opened on more than one folder amounts to. Each brings the include paths its
-- own `nupp.lua` declares, because a folder whose sources sit under `src` is
-- unreadable without them. Everything else — lint levels, strictness, the
-- language mode — still comes from `rootDir`: the session was started against
-- one project, and letting a second folder redecide those would mean the same
-- file checked differently depending on which window opened it.
function envMod.new(rootDir, opts)
    rootDir = rootDir or "."
    local env = {
        globals = {},
        globalTypes = {},
        globalTypeDefs = {},
        annotations = annotationMod.new(),
        loaded = {},
        loadedPaths = {},
        bundled = {}, -- built-in module decls; survives loaded resets
        resolveModule = envMod.resolveModule,
        resolveModuleExports = envMod.resolveModuleExports,
        resolveProjectType = envMod.resolveProjectType,
        resolveProjectValue = envMod.resolveProjectValue,
        resolveProjectAnnotation = envMod.resolveProjectAnnotation,
        resolveQualifiedType = envMod.resolveQualifiedType,
        exportedNominal = envMod.exportedNominal,
        modulesNamed = envMod.modulesNamed,
        modulesExporting = envMod.modulesExporting,
        declarationType = envMod.declarationType,
        moduleNameForPath = envMod.moduleNameForPath,
        ensureProjectIndex = envMod.ensureProjectIndex,
        rootDir = rootDir,
    }

    local config = opts and opts.config or configAt(rootDir)
    env.config = config or {}

    env.roots = {rootDir}
    for _, dir in ipairs(env.config.include or {}) do
        env.roots[#env.roots + 1] = rootDir .. "/" .. dir
    end
    local seenRoot = {}
    for _, root in ipairs(env.roots) do seenRoot[normalizePath(root)] = true end
    local function addRoot(dir)
        if seenRoot[normalizePath(dir)] then return end
        seenRoot[normalizePath(dir)] = true
        env.roots[#env.roots + 1] = dir
    end
    env.folders = {}
    for _, folder in ipairs(opts and opts.folders or {}) do
        if normalizePath(folder) ~= normalizePath(rootDir) then
            env.folders[#env.folders + 1] = normalizePath(folder)
            addRoot(folder)
            for _, dir in ipairs(configAt(folder).include or {}) do
                addRoot(folder .. "/" .. dir)
            end
        end
    end

    -- Bootstrap the stdlib prelude (a real .d.nupp checked by nupp itself).
    local preludePath = moduleDir() .. "/decls/prelude.d.nupp"
    local src = bundledSource("/decls/prelude.d.nupp")
    -- Not optional. Without it every name in the standard library is unknown,
    -- and an ordinary check says nothing about that — it only shows up under
    -- --strict, or as types quietly widening to any. A compiler that cannot
    -- find its own prelude is broken, not lenient.
    assert(src, "internal error: cannot read the prelude at " .. preludePath)
    do
        local result = parser.parse(src, preludePath)
        assert(#result.errors == 0,
            "internal error: prelude has syntax errors: "
            .. (result.errors[1] and result.errors[1].msg or "?"))
        local diags = check.check(result, preludePath, env,
            {declareGlobals = true})
        assert(#diags == 0,
            "internal error: prelude has type errors: "
            .. (diags[1] and diags[1].msg or "?"))
        local strlib = env.globals["string"]
        env.stringLib = strlib and strlib.t or nil
    end

    -- Bundled module declarations (require("string.buffer") etc.). One relative
    -- path reaches them whether they are on disk beside the compiled modules or
    -- carried inside the stage-0 bundle.
    local BUNDLED = {
        ["string.buffer"] = "/decls/stringbuffer.d.nupp",
        ["cjson"] = "/decls/cjson.d.nupp",
        ["cjson.safe"] = "/decls/cjsonsafe.d.nupp",
        ["ffi"] = "/decls/ffi.d.nupp",
        -- The jit.* submodules are require()-only: LuaJIT registers them
        -- under package.loaded without putting them on the `jit` table, so
        -- they are modules here rather than fields in the prelude.
        ["jit.util"] = "/decls/jit/util.d.nupp",
        ["jit.profile"] = "/decls/jit/profile.d.nupp",
        ["jit.zone"] = "/decls/jit/zone.d.nupp",
        ["jit.vmdef"] = "/decls/jit/vmdef.d.nupp",
    }
    -- The standard library, which is this compiler's own Nupp rather than a
    -- description of someone else's C. It is typed already, so there is nothing to
    -- declare a second time: the implementation is the surface, and a project
    -- outside this tree reads exactly the source that went into the binary it is
    -- running. A hand-written `.d.nupp` beside it would be a second copy with
    -- nothing holding the two together.
    local BUNDLED_SOURCE = {
        ["nupp.std.resources"] = "/std/resources.nupp",
        ["nupp.std.zone"] = "/std/zone.nupp",
        ["nupp.std.profile"] = "/std/profile.nupp",
    }

    -- `declarationFile` is the whole difference: a `.d.nupp` describes an interface
    -- it does not own, an implementation is checked as the module it is.
    local function loadBundled(name: string, file: string, declarationFile: boolean): any
        local bundledSrc = bundledSource(file)
        if not bundledSrc then return false end
        local result = parser.parse(bundledSrc, name)
        if #result.errors > 0 then return false end
        -- Keep the exports, not just the module value: a module names the types its
        -- API is written in, and code that passes those values around has to be
        -- able to name them too (`local b: buffer.Buffer`).
        local diags, moduleType, exports = check.check(result, name, env,
            {moduleName = name, declarationFile = declarationFile})
        if #diags == 0 and moduleType then
            return {type = moduleType, exports = exports}
        end
        return false
    end

    -- Loaded when something asks for one, not when an environment is made. Eager
    -- loading meant every check of every project parsed and checked all of these,
    -- which doubled the wall time of a small one for modules it never required.
    -- Both readers reach `env.bundled` by name, so this lives in one metatable
    -- rather than at each of them, and a miss is remembered as `false` so an
    -- ordinary unresolved name is not retried on every lookup.
    local PENDING: {[string]: {file: string, declaration: boolean}} = {}
    for name, file in pairs(BUNDLED) do
        PENDING[name] = {file = file, declaration = true}
    end
    for name, file in pairs(BUNDLED_SOURCE) do
        PENDING[name] = {file = file, declaration = false}
    end
    setmetatable(env.bundled, {__index = function(store: any, name: string): any
        local pending = PENDING[name]
        local loaded: any = false
        if pending then
            loaded = loadBundled(name, pending.file, pending.declaration)
        end
        rawset(store, name, loaded)
        return loaded
    end})

    return env
end

return envMod
