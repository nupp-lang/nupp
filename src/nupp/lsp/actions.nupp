--[[
The refactorings the server offers.

Wrapping an owned local in a `with` scope and unwrapping one again, with the
reindentation each implies. A refactoring rewrites source rather than the tree,
so it works in byte offsets and keeps what it did not touch.
]]

local cst = require("nupp.cst")
local tree = require("nupp.lsp.tree")

local actions = {}

--- One replacement over the original document, in the shape the checker's fixes already
--- speak: a byte offset, how much of the source it covers, and what takes its place.
--- Offsets never account for each other, so a whole action converts to protocol edits
--- in one place.
type actions.Edit = {offset: integer, length: integer, newText: string}

actions.QUICKFIX = "quickfix"

actions.REFACTOR = "refactor.rewrite"

-- The formatter's indent, so a rewritten scope is indented the way `nupp fmt` would
-- have indented it and reformatting the file is a no-op.
local INDENT = "    "

local function lineStart(source, offset)
    while offset > 1 and source:byte(offset - 1) ~= 10 do
        offset = offset - 1
    end
    return offset
end

--- The whitespace `offset`'s line opens with, which a rewrite keeps.
local function indentAt(source, offset)
    local start = lineStart(source, offset)
    local _, stop = source:find("^[ \t]*", start)
    return source:sub(start, stop)
end

--- Edits indenting every non-blank line that starts in [from, to) by one level, or
--- removing one level when `remove` is set. Blank lines stay blank rather than
--- collecting trailing spaces the formatter would take straight back out.
local function reindentEdits(source, from, to, remove)
    local edits = {}
    local at = lineStart(source, from)
    while at < to do
        local _, stop = source:find("^[ \t]*", at)
        local blank = source:byte(stop + 1) == 10 or stop >= #source
        if not blank then
            if remove then
                local width = math.min(stop - at + 1, #INDENT)
                if width > 0 then
                    edits[#edits + 1] = {offset = at, length = width, newText = ""}
                end
            else
                edits[#edits + 1] = {offset = at, length = 0, newText = INDENT}
            end
        end
        local newline = source:find("\n", at, true)
        if not newline then
            break
        end
        at = newline + 1
    end

    return edits
end

-- Statements whose meaning depends on which scope encloses them. `with` closes its
-- owners on every one of these paths; a manual `dispose` written after the body does
-- not, so unwrapping past one would silently change what the program does on that path.
local ESCAPING_STATS: {[string]: boolean} = {returnStmt = true, breakStmt = true, continueStmt = true, gotoStmt = true,}

--- Whether `node` leaves its enclosing block by a path a rewrite would have to account
--- for. A nested function body is not descended into: its `return` leaves that
--- function, not this scope.
local function escapesScope(node)
    local found = false
    local function walk(value)
        if found or cst.isToken(value) then
            return
        end
        if value.kind == "funcbody" then
            return
        end
        if ESCAPING_STATS[value.kind] then
            found = true
            ;
            return
        end
        for _, child in ipairs(value) do
            walk(child)
        end
    end

    walk(node)

    return found
end

--- The owned type a local declaration binds, when it binds exactly one name to exactly
--- one expression and that value is an owner with cleanups to run. An opaque owner
--- (`@owned()` with no cleanup names) is transfer-only: `with` has nothing to call at
--- scope exit, so it is not offered one.
local function ownedLocal(stat)
    if stat.kind ~= "localStmt" or stat.isConst then
        return nil
    end
    if #(stat.names or {}) ~= 1 or #(stat.exprs or {}) ~= 1 then
        return nil
    end
    local nameTok = stat.names[1]
    local def = nameTok.definition
    local t = def and def.type
    if not t or t.tag ~= "owned" or #(t.cleanups or {}) == 0 then
        return nil
    end

    return def
end

--- The `dispose(<name>)` statement discharging `def`, searched forward from `from` in
--- `block`. It is where the owner's life already ends, so it is where the `with` scope
--- ends too.
local function disposeOf(block: cst.Block, from: integer, def: tree.Definition): integer?
    for i = from, #(block.stats or {}) do
        local stat = block.stats[i]
        local call = stat.kind == "callStmt" and stat.expr or nil
        local callee = call and call.kind == "call" and call.obj or nil
        -- A call holds its argument list as a plain node, so reaching the expressions
        -- inside it says which two productions those nodes are.
        local args = call and (call as cst.Call).args and ((call as cst.Call).args as cst.Args).exprs or {}
        if callee and callee.kind == "name" and callee.token and callee.token.text == "dispose" and #args == 1 and args[
            1
        ].kind == "name" and (
            args[1] as cst.NameExpr
        ).token and ((args[1] as cst.NameExpr).token as nupp.lexer.Token).definition == def then
            return i
        end
    end

    return nil
end

--- The edits turning `local h = acquire() ... dispose(h)` into a `with` scope.
---
--- The header is rewritten in place rather than regenerated, so a type annotation and
--- the acquisition expression survive exactly as written. The scope closes at the
--- `dispose` when there is one, and otherwise at the end of the enclosing block, which
--- is the same place the owner's obligation currently comes due.
function actions.wrapInWith(source: string, root: cst.Child, stat: tree.Kinded): {actions.Edit}?
    local def = ownedLocal(stat)
    if not def then
        return nil
    end
    -- A block and the position in it are found together, as are the two bounds of a
    -- node, so testing one of a pair settles the other. The casts below say so where
    -- the checker cannot follow the assignment that paired them.
    local block, index = tree.enclosingBlock(root, stat as cst.Node)
    if not block then
        return nil
    end
    local localTok = (stat as cst.Node)[1]
    if not localTok or not cst.isToken(localTok) or localTok.text ~= "local" then
        return nil
    end
    local _, headEnd = tree.nodeBounds(stat as cst.Node)
    local closeAt = disposeOf(block, (index as integer) + 1, def)
    local lastBody = (closeAt or #block.stats + 1) - 1
    -- Returning the owner is the one disposition `with` cannot express: the scope would
    -- close it on the way out and hand back a dead value.
    for i = (index as integer) + 1, lastBody do
        local s = block.stats[i]
        if s.kind == "returnStmt" and tree.mentions(s, def) then
            return nil
        end
    end
    local indent = indentAt(source, localTok.offset)
    local edits = {}
    edits[#edits + 1] = {offset = localTok.offset, length = #localTok.text, newText = "with"}
    if not closeAt and lastBody < (index as integer) + 1 then
        -- An owner acquired and never touched again: opening and closing the scope land
        -- on the same offset, so they are one edit rather than two zero-width inserts
        -- whose order would decide which came first.
        edits[#edits + 1] = {offset = headEnd as integer, length = 0, newText = " do\n" .. indent .. "end"}
        return edits
    end
    edits[#edits + 1] = {offset = headEnd as integer, length = 0, newText = " do"}
    if lastBody >= (index as integer) + 1 then
        -- Up to the `dispose` line rather than the last statement, so a comment sitting
        -- between them moves into the body along with the code it is about.
        local bodyFrom = tree.nodeBounds(block.stats[(index as integer) + 1])
        local bodyTo
        if closeAt then
            bodyTo = lineStart(source, (tree.nodeBounds(block.stats[closeAt])))
        else
            local _, last = tree.nodeBounds(block.stats[lastBody])
            bodyTo = last
        end
        for _, edit in ipairs(reindentEdits(source, bodyFrom, bodyTo)) do
            edits[#edits + 1] = edit
        end
    end
    if closeAt then
        local from, to = tree.nodeBounds(block.stats[closeAt])
        edits[#edits + 1] = {offset = from as integer, length = (to as integer) - (from as integer), newText = "end"}
    else
        local _, to = tree.nodeBounds(block.stats[lastBody])
        edits[#edits + 1] = {offset = to as integer, length = 0, newText = "\n" .. indent .. "end"}
    end

    return edits
end

--- The edits turning a `with` scope back into acquisitions and explicit disposals.
---
--- Cleanup keeps the order `with` gives it: acquired left to right, disposed right to
--- left. The body may not leave the scope by `return`, `break`, `continue` or `goto`,
--- because `with` closes its owners on those paths and a trailing `dispose` would not.
function actions.unwrapWith(source: string, stat: tree.Kinded): {actions.Edit}?
    if stat.kind ~= "withStmt" or not stat.withTok or not stat.doTok or not stat.endTok then
        return nil
    end
    if stat.body and escapesScope(stat.body) then
        return nil
    end
    local indent = indentAt(source, stat.withTok.offset)
    local declarations, disposals = {}, {}
    for i, binding in ipairs(stat.bindings or {}) do
        if not binding.name or not binding.expr then
            return nil
        end
        local from = binding.name.offset
        local _, to = tree.nodeBounds(binding.expr)
        declarations[i] = "local " .. source:sub(from, (to as integer) - 1)
        table.insert(disposals, 1, ("dispose(%s)"):format(binding.name.text))
    end
    if #declarations == 0 then
        return nil
    end
    local separator = "\n" .. indent
    local edits = {}
    edits[
        1
    ] = {
        offset = stat.withTok.offset,
        length = stat.doTok.offset + #stat.doTok.text - stat.withTok.offset,
        newText = table.concat(declarations, separator),
    }
    if stat.body then
        -- Down to the `end` line rather than the last statement, so a comment sitting
        -- between them comes out of the body with the code it is about.
        local from = tree.nodeBounds(stat.body)
        local to = lineStart(source, stat.endTok.offset)
        if from then
            for _, edit in ipairs(reindentEdits(source, from, to, true)) do
                edits[#edits + 1] = edit
            end
        end
    end
    edits[
        #edits + 1
    ] = {offset = stat.endTok.offset, length = #stat.endTok.text, newText = table.concat(disposals, separator),}

    return edits
end

return actions
