-- Temporary compatibility facade sharing the canonical context and catalog.
module binary.digest

local implementation = require("nupp.digest.digest")
export type Digest = implementation.Digest
export const Digest = implementation.Digest
export type Algorithm = Digest.Algorithm
export const Algorithm = Digest.Algorithm
export const lookup = Algorithm.lookup
export const algorithm = Algorithm.of
export const algorithms = Algorithm.names
export const newdigest = Digest.create
export const digest = Digest.compute
export const hexdigest = Digest.computehex
