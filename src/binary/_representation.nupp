@!internal

local contracts = require("nupp.runtime.contracts")
local nativeStorage = require("nupp.vm.storagebinding")

local storage: contracts.CstorageProvider? = nativeStorage
if storage ~= nil then
    assert(storage.representation == "native", "nupp.runtime.storage: target requires native pointer storage")
end
local tableStructs: contracts.StructvalueProvider = require("nupp.runtime.provider.tablestruct")
local structs: contracts.StructvalueProvider = storage and storage.structs or tableStructs

return {storage = storage, structs = structs}
