module binary.hash

--[[General-purpose byte hashing.

Cryptographic digests, checksums and keyed authentication use the separate
[](binary.hash.digest), [](binary.hash.checksum) and [](binary.hash.mac) modules.

```nupp
local hash = binary.hash
print(hash.fnv1a64("hello"))
```
]]

local hash = require("nupp.util.internal.hash")

--- Hashes bytes with FNV-1a over 64 bits, as sixteen lowercase hexadecimal digits.
export const fnv1a64 = hash.fnv1a64
