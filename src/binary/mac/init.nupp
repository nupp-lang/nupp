-- Temporary compatibility facade sharing the canonical context and catalog.
module binary.mac

local implementation = require("nupp.digest.mac")
export type Mac = implementation.Mac
export const Mac = implementation.Mac
export type Algorithm = Mac.Algorithm
export const Algorithm = Mac.Algorithm
export const lookup = Algorithm.lookup
export const algorithm = Algorithm.of
export const algorithms = Algorithm.names
export const newmac = Mac.create
export const digest = Mac.compute
export const hexdigest = Mac.computehex
