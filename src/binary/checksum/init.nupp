-- Temporary compatibility facade sharing the canonical context and catalog.
module binary.checksum

local implementation = require("nupp.digest.checksum")
export type Checksum = implementation.Checksum
export const Checksum = implementation.Checksum
export type Algorithm = Checksum.Algorithm
export const Algorithm = Checksum.Algorithm
export const lookup = Algorithm.lookup
export const algorithm = Algorithm.of
export const algorithms = Algorithm.names
export const newchecksum = Checksum.create
export const value = Checksum.compute
