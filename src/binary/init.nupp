--[[
`binary` provides byte encodings, compression, hashes, and bitsets. Use `hexencode` and
`base64encode` to encode bytes as text, and `Bitset` for a mutable set of bits.

```nupp
local selected = binary.Bitset(64)
selected:set(31)
selected:set(32)
assert(selected:count() == 2)
```

A bitset keeps 32 positions in each stored word. Positions and word indexes
start at zero; `wordat` returns a signed 32-bit word. The set grows as positions
are added, and clearing it retains capacity for reuse.

See [](binary.span) for checked storage views, [](binary.digest) for digests,
and [](binary.CompressionFormat) for compression streams.

## Algorithm descriptors

Use `digest`, `checksum`, and `mac` to select reusable algorithm descriptors.
`formats(kind)` lists the available canonical names for a [](binary.FormatKind).

```nupp
local sha256 = binary.digest("sha256")
assert(#sha256:computehex("hello") == 64)
local running = sha256:create()
running:write("hello")
assert(running:hexdigest() == sha256:computehex("hello"))
```

Descriptors create independent incremental contexts with `create()`. MAC
operations take a raw-byte key; the descriptor retains no key. See
[digests.md](docs/learn/runtime/data/digests.md) for incremental writes and
finalization.

## Compression

Use `compress` to select a format and `formats("compression")` to list the
available names. A descriptor compresses bytes or wraps an [](io) stream.

```nupp
local gzip = binary.compress("gzip")
local encoded = gzip:compress("hello", {gzip = {level = 6}})
assert(gzip:decompress(encoded) == "hello")
```

A factory consumes the reader or writer it wraps. A compression writer has to
end in `finish()`; closing or dropping one unfinished aborts the stream and
raises, because a truncated member is worse than a loud failure.

Adapter policy and format options are separate, which is why the options table
is keyed by format name.

## Built-in formats

| Name | Container | Writer options | Reader options |
| --- | --- | --- | --- |
| `gzip` | RFC 1952 gzip | `gzip = { level = 0..9 }` | `gzip = { concatenatedmembers = boolean }` |
| `zlib` | RFC 1950 zlib | `zlib = { level = 0..9 }` | none |
| `deflate-raw` | RFC 1951 raw DEFLATE | `deflateraw = { level = 0..9 }` | none |

All three take levels zero through nine. Gzip checks its CRC and size trailers
and reads concatenated members by default, zlib checks its Adler-32 trailer, and
raw DEFLATE has no checksum at all. Trailing bytes are rejected in every case.

The `deflateraw` options key configures the `deflate-raw` format.
]]
module binary

local compressionapi = require("nupp.compression")
export type CompressionFormat = compressionapi.CompressionFormat
export type CompressionWriter = compressionapi.CompressionWriter
export type CompressionWriterOptions = compressionapi.CompressionWriterOptions
export type CompressionReaderOptions = compressionapi.CompressionReaderOptions
export type GzipWriterOptions = compressionapi.GzipWriterOptions
export type ZlibWriterOptions = compressionapi.ZlibWriterOptions
export type DeflateRawWriterOptions = compressionapi.DeflateRawWriterOptions
export type GzipReaderOptions = compressionapi.GzipReaderOptions
export const CompressionFormat = compressionapi.CompressionFormat

--- Acquires a retained compression format descriptor or raises when unavailable.
export const compress = compressionapi.compress

local checksumapi = require("nupp.digest.checksum")
export type Checksum = checksumapi.Checksum
export const Checksum = checksumapi.Checksum
export type ChecksumFormat = checksumapi.ChecksumFormat
export const ChecksumFormat = checksumapi.ChecksumFormat

--- Acquires a retained checksum descriptor or raises when unavailable.
export const checksum = checksumapi.checksum

local digestapi = require("nupp.digest.digest")
export type Digest = digestapi.Digest
export const Digest = digestapi.Digest
export type DigestFormat = digestapi.DigestFormat
export const DigestFormat = digestapi.DigestFormat

--- Acquires a retained digest descriptor or raises when unavailable.
export const digest = digestapi.digest

local macapi = require("nupp.digest.mac")
export type Mac = macapi.Mac
export const Mac = macapi.Mac
export type MacFormat = macapi.MacFormat
export const MacFormat = macapi.MacFormat

--- Acquires a retained authentication descriptor without retaining a key.
export const mac = macapi.mac

--- Algorithm families accepted by `formats`.
export type FormatKind = "digest" | "checksum" | "mac" | "compression"

--- Lists available canonical names in ascending order for an algorithm family.
--- @param kind algorithm family to list
--- @return available canonical names in ascending order
--- @raises string when the family is unknown
export function formats(kind: FormatKind): {string}
    if kind == "digest" then
        return digestapi.formats()
    elseif kind == "checksum" then
        return checksumapi.formats()
    elseif kind == "mac" then
        return macapi.formats()
    elseif kind == "compression" then
        return compressionapi.formats()
    end
    error("unknown binary format kind " .. tostring(kind), 2)
end

local bitset = require("nupp.util.internal.bitset")

--- A growable set of bit positions counting from 0.
export type Bitset = bitset.Bitset

export const Bitset = bitset.Bitset

local hash = require("nupp.util.internal.hash")

--- Hashes bytes with FNV-1a over 64 bits, as sixteen lowercase hexadecimal digits.
export const fnv1a64 = hash.fnv1a64

--- Encodes raw bytes as lowercase hexadecimal.
---
--- ```nupp
--- assert(binary.hexencode("Nu") == "4e75")
--- ```
export const hexencode = require("nupp.util.internal.encoding").hexencode

--- Decodes either case of hexadecimal without whitespace or a prefix.
---
--- ```nupp
--- assert(binary.hexdecode("4E75") == "Nu")
--- ```
--- @return raw bytes, or nil and a reason
export function hexdecode(text: string): (string?, string?)
    if #text % 2 ~= 0 then
        return nil, "hex input must contain an even number of digits"
    end
    if text:find("[^0-9a-fA-F]") then
        return nil, "hex input contains a non-hexadecimal digit"
    end
    local parts: {string} = {}
    for index = 1, #text, 2 do
        parts[#parts + 1] = string.char(assert(tonumber(text:sub(index, index + 1), 16)))
    end

    return table.concat(parts)
end

local encoding = require("nupp.util.internal.encoding")

--- Encodes bytes as standard base64, padded.
---
--- ```nupp
--- assert(binary.base64encode("Nupp") == "TnVwcA==")
--- ```
--- @param value the bytes to encode
--- @return the encoded text
export const base64encode: function(value: string): string = encoding.base64encode

--- Decodes canonical standard base64 with required padding.
---
--- Returns nil and a reason when the text is not canonical padded Base64.
---
--- ```nupp
--- assert(binary.base64decode("TnVwcA==") == "Nupp")
--- local bytes, reason = binary.base64decode("TnVwcA")
--- assert(bytes == nil and reason ~= nil)
--- ```
--- @param text the text to decode
--- @return the decoded bytes, or nil when the text is not base64
--- @return why the text is not base64, when it is not
export const base64decode: function(text: string): (string?, string?) = encoding.base64decode
