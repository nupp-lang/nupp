@!internal
module math.internal.random

const INV32 = 1.0 / 4294967296.0
const TWO21 = 2097152
const TWO32 = 4294967296
const TWO53 = 9007199254740992
const DEFAULT_SEED = 0x5EED1234
const GOLDEN = math.i32.wrap(0x9E3779B9)
const ZERO = math.i32.wrap(0)

--- SplitMix32's finalizer: one word in, one avalanched word out.
local function mix32(value: int32): int32
    local shifted = math.i32.fromu32(math.u32.shiftrightlogical(math.u32.fromi32(value), 16))
    local mixed = math.i32.mul(math.i32.xorbits(value, shifted), math.i32.wrap(0x21F0AAAD))
    shifted = math.i32.fromu32(math.u32.shiftrightlogical(math.u32.fromi32(mixed), 15))
    mixed = math.i32.mul(math.i32.xorbits(mixed, shifted), math.i32.wrap(0x735A2D97))
    shifted = math.i32.fromu32(math.u32.shiftrightlogical(math.u32.fromi32(mixed), 15))

    return math.i32.xorbits(mixed, shifted)
end

--- Expands a seed into four state words without xoshiro's all-zero state.
local function expand(seed: integer): (int32, int32, int32, int32)
    local counter = math.i32.wrap(seed)
    counter = math.i32.add(counter, GOLDEN)
    local s0 = mix32(counter)
    counter = math.i32.add(counter, GOLDEN)
    local s1 = mix32(counter)
    counter = math.i32.add(counter, GOLDEN)
    local s2 = mix32(counter)
    counter = math.i32.add(counter, GOLDEN)
    local s3 = mix32(counter)
    if s0 == ZERO and s1 == ZERO and s2 == ZERO and s3 == ZERO then
        return GOLDEN, ZERO, ZERO, ZERO
    end

    return s0, s1, s2, s3
end

--- An independent deterministic xoshiro128** sequence.
--- @export
export record Xoshiro128
    @private s0: int32
    @private s1: int32
    @private s2: int32
    @private s3: int32

    --- Creates a generator. An omitted seed uses a fixed reproducible value.
    constructor(self, seed: integer?)
        self.s0, self.s1, self.s2, self.s3 = expand(seed or DEFAULT_SEED)
    end

    --- Returns the next multiple of 2^-32 in [0, 1).
    function next(self): number
        -- A destructured record load no longer carries the checker's
        -- fixed-width provenance, so establish each local explicitly before
        -- feeding it back to the i32 operations.
        local s0 = math.i32.wrap(self.s0 as integer)
        local s1 = math.i32.wrap(self.s1 as integer)
        local s2 = math.i32.wrap(self.s2 as integer)
        local s3 = math.i32.wrap(self.s3 as integer)
        local result = math.i32.mul(math.i32.rotateleft(math.i32.mul(s1, math.i32.wrap(5)), 7), math.i32.wrap(9))
        local shifted = math.i32.shiftleft(s1, 9)
        s2 = math.i32.xorbits(s2, s0)
        s3 = math.i32.xorbits(s3, s1)
        s1 = math.i32.xorbits(s1, s2)
        s0 = math.i32.xorbits(s0, s3)
        s2 = math.i32.xorbits(s2, shifted)
        s3 = math.i32.rotateleft(s3, 11)
        self.s0, self.s1, self.s2, self.s3 = s0, s1, s2, s3

        return ((result as number) * INV32) % 1
    end

    --- Returns an integer in [1, m], or in [m, n] when both are given.
    ---
    --- A range of up to 2^32 values takes one draw, so seeded sequences over
    --- small ranges stay what they were. A wider one takes 53 bits from two
    --- draws and rejects the uneven tail, so every value in it can come up.
    --- @raises string when the selected range is empty, when a bound is not a
    ---     finite integer, or when the range holds more than 2^53 values
    function integer(self, m: integer, n: integer?): integer
        local low: integer = 1
        local high: integer = m
        if n ~= nil then
            low = m
            high = n
        end
        if low % 1 ~= 0 or high % 1 ~= 0 or math.abs(low) > TWO53 or math.abs(high) > TWO53 then
            error(
                "nupp: random.Xoshiro128:integer(" .. tostring(
                    low
                ) .. ", " .. tostring(high) .. ") needs finite integer bounds",
                2
            )
        end
        if high < low then
            error(
                "nupp: random.Xoshiro128:integer(" .. tostring(low) .. ", " .. tostring(high) .. ") has an empty range",
                2
            )
        end
        local span = high - low + 1
        if span <= TWO32 then
            return low + assert(math.tointeger(math.floor(self:next() * span)))
        end
        if span > TWO53 then
            error(
                "nupp: random.Xoshiro128:integer(" .. tostring(
                    low
                ) .. ", " .. tostring(high) .. ") spans more than 2^53 values",
                2
            )
        end

        -- 21 bits of one draw above all 32 of the next give an integer uniform
        -- in [0, 2^53), exact in a double. Values past the last whole multiple
        -- of the span would favour the low residues, so they are drawn again;
        -- at worst that is under half of the draws.
        local limit = span * math.floor(TWO53 / span)
        while true do
            local wide = math.floor(self:next() * TWO21) * TWO32 + self:next() * TWO32
            if wide < limit then
                return (low + wide % span) as integer
            end
        end
    end

    --- Returns the next value in [low, high), or (high, low] when reversed.
    ---
    --- Equal bounds return that bound.
    function range(self, low: number, high: number): number
        return low + self:next() * (high - low)
    end

    --- Shuffles a list in place with Fisher-Yates and returns the same list.
    function shuffle<T>(self, values: {T}): {T}
        for index = #values, 2, -1 do
            local other = 1 + assert(math.tointeger(math.floor(self:next() * index)))
            values[index], values[other] = values[other], values[index]
        end

        return values
    end

    --- Restarts this generator from a 32-bit seed without changing its identity.
    function reseed(self, seed: integer): nil
        self.s0, self.s1, self.s2, self.s3 = expand(seed)
    end

    --- Copies the four signed 32-bit state words into a fresh array.
    function state(self): {integer}
        return {self.s0, self.s1, self.s2, self.s3}
    end

    --- Restores exactly four state words.
    --- @raises string when there are not four words or all four are zero
    function setstate(self, words: {integer}): nil
        if #words ~= 4 then
            error("nupp: random.Xoshiro128:setstate needs four state words", 2)
        end
        local s0 = math.i32.wrap(words[1])
        local s1 = math.i32.wrap(words[2])
        local s2 = math.i32.wrap(words[3])
        local s3 = math.i32.wrap(words[4])
        if s0 == ZERO and s1 == ZERO and s2 == ZERO and s3 == ZERO then
            error("nupp: random.Xoshiro128:setstate refused the all-zero state, the one xoshiro cannot leave", 2)
        end
        self.s0, self.s1, self.s2, self.s3 = s0, s1, s2, s3
    end
end
