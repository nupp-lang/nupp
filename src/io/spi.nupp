module io.spi

--[[Implementation interfaces consumed during ordinary module initialization.
Discover with package.providers; the consumer chooses the unique highest priority.
Omitted priority is zero. Importing these declarations loads no implementation.]]

--- Environmental path facts, independent of lexical path manipulation.
---
--- sep reports the host convention. cwd and canonicalize may
--- return nil with an explanatory message when the host has no such facility or
--- an operating-system operation fails. The public path type is `io.Path`.
export interface PathProvider
    @readonly priority: integer?

    --- Returns the host path separator.
    @readonly sep: function(): string

    --- Returns the process directory or nil and an environmental error.
    @readonly cwd: function(): (string?, string?)

    --- Resolves a host filesystem path or returns nil and an error.
    @readonly canonicalize: function(path: string): (string?, string?)
end
