@!internal
--[[
Shared-byte regions retain immutable engine-owned storage.
They require the Nupp engine host supplied by a stamped binary.

```nupp
const Bytes = io.Bytes

const region = Bytes.copy("hello, region")
const hello = region:slice(0, 5)
assert(hello:len() == 5 and hello:tostring() == "hello")
```

A region names an extent of one reference-counted engine block. It crosses
worker boundaries by reference, slices without copying, and is read in place
through a borrowed [](binary.span) byte view; converting it to a Lua string
is one explicit call.

A region is storage, so its positions are zero-based offsets and counts, as a
[](io.Buffer)'s are: `slice(offset, count)` and `view(offset, count)`
name `count` bytes starting `offset` bytes in.

Use `io.Buffer` to build a region and `freeze()` to consume the buffer:

```nupp
local buffer = io.Buffer.create()
buffer:put("ABCDE", "!")
assert(buffer:freeze():tostring() == "ABCDE!")
```

`io.Bytes` is transitional. Shared long strings replace it when workers can
share string storage; use strings for immutable bytes that stay in one lane.
]]
module io.internal.bytestypes

local span = require("binary.span")

const _FACTORY_REQUIRES = "@requires-dynamically io.internal.sharedbytes"
local factory: any = nil

local function implementation(name: string): any
    if factory == nil then
        factory = require(name)
    end
    return factory
end

--- An immutable extent of an engine-owned block. Crossing a worker boundary
--- moves a reference, never the bytes; reading happens in place through a
--- borrowed byte view, and `tostring` is the one explicit copy into a Lua state.
export record Bytes
    --- Copies text into immutable engine-owned bytes.
    copy: function(text: string): Bytes

    --- Reads a whole file directly into immutable engine-owned bytes.
    readfile: function(path: string): (Bytes?, string?)

    @private _handle: any
    @private _first: integer
    @private _length: integer

    --- How many bytes the region holds.
    len: @nosuspend function(Bytes): integer

    --- A zero-copy region over `count` bytes starting `offset` bytes into this one.
    slice: function(Bytes, integer, integer): Bytes

    --- A read-only borrowed view over `count` bytes starting `offset` bytes in,
    --- the whole region by default.
    view: function(borrows self: Bytes, integer?, integer?): span.Span<uint8> borrows (self)

    --- A checked zero-copy view of the complete region as physical elements.
    viewas: function<T>(borrows self: Bytes, ctype<T>): span.Span<T> borrows (self)

    --- The region's bytes copied and interned as an ordinary string.
    tostring: @nosuspend function(Bytes): string
end

function Bytes.copy(text: string): Bytes
    local create: function(string): Bytes = implementation("io.internal.sharedbytes").Bytes.copy
    return create(text)
end

function Bytes.readfile(path: string): (Bytes?, string?)
    local read: function(string): (Bytes?, string?) = implementation("io.internal.sharedbytes").Bytes.readfile
    return read(path)
end
