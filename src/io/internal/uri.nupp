@!internal
module io.internal.uri

local uriTypes = require("io.internal.uritypes")
local provider = require("nupp.io.uri.provider")

export type URI = uriTypes.URI
export const URI = uriTypes.URI

local function fromComponents(components: any): (string?, string?)
    if type(components) ~= "table" then
        return nil, "nupp: io.URI.of needs absolute text or URI components"
    end
    local scheme = components.scheme
    if type(scheme) ~= "string" or not (scheme as string):match("^[A-Za-z][A-Za-z0-9+.-]*$") then
        return nil, "nupp: URI components need a non-empty scheme"
    end
    for _, name in ipairs({"userinfo", "host", "path", "query", "fragment",}) do
        local value = components[name]
        if value ~= nil and type(value) ~= "string" then
            return nil, "nupp: URI component " .. name .. " must be a string or nil"
        end
    end
    local port = components.port
    if port ~= nil and (type(port) ~= "number" or port ~= math.floor(port) or port < 0 or port > 65535) then
        return nil, "nupp: URI component port must be an integer from 0 through 65535 or nil"
    end
    -- A delimiter that would end the component early. `#` always starts the
    -- fragment, `?` starts the query anywhere before one, and inside the
    -- authority `/`, `?` and `#` end it while `@` moves the host boundary.
    for name, delimiters in pairs({userinfo = "[/?#]", host = "[/?#@]", path = "[?#]", query = "#",}) do
        local value = components[name]
        if value ~= nil and (value as string):find(delimiters) ~= nil then
            return nil, "nupp: URI component " .. name .. " cannot contain a component delimiter"
        end
    end
    -- A colon in a host ends it and starts the port, unless it is inside an
    -- IPv6 literal's brackets.
    local host = components.host
    if host ~= nil and (host as string):find(":", 1, true) ~= nil and not (host as string):match("^%[[^%]]*%]$") then
        return nil, "nupp: URI component host cannot contain a component delimiter"
    end
    -- RFC 3986 section 3.3: beside an authority a path is empty or rooted, and
    -- without one it must not begin with `//`, which would reparse as one.
    local path = components.path
    if components.host or components.userinfo or port then
        if path ~= nil and path ~= "" and (path as string):sub(1, 1) ~= "/" then
            return nil, "nupp: URI component path must be empty or begin with \"/\" beside an authority"
        end
    elseif path ~= nil and (path as string):sub(1, 2) == "//" then
        return nil, "nupp: URI component path cannot begin with \"//\" when there is no authority"
    end
    local out = scheme .. ":"
    if components.host or components.userinfo or port then
        out = out .. "//"
        if components.userinfo then
            out = out .. components.userinfo .. "@"
        end
        out = out .. (components.host or "")
        if port then
            out = out .. ":" .. tostring(port)
        end
    end
    out = out .. (components.path or "")
    if components.query then
        out = out .. "?" .. components.query
    end
    if components.fragment then
        out = out .. "#" .. components.fragment
    end

    return out, nil
end

const URI_CACHE_CAPACITY = 1024
local uriCache: {[string]: any} = {}
local uriCacheSize = 0
local uriCacheNewest: any = nil
local uriCacheOldest: any = nil

local function adopt(value: URI): URI
    local text = value:tostring()
    local found = uriCache[text]
    if found ~= nil then
        if found ~= uriCacheNewest then
            local older, newer = found.older, found.newer
            if older ~= nil then
                older.newer = newer
            else
                uriCacheOldest = newer
            end
            if newer ~= nil then
                newer.older = older
            end
            found.older = uriCacheNewest
            found.newer = nil
            uriCacheNewest.newer = found
            uriCacheNewest = found
        end

        return found.value
    end

    local entry = {value = value, older = uriCacheNewest, newer = nil}
    if uriCacheNewest ~= nil then
        uriCacheNewest.newer = entry
    else
        uriCacheOldest = entry
    end
    uriCacheNewest = entry
    uriCache[text] = entry
    uriCacheSize = uriCacheSize + 1
    if uriCacheSize > URI_CACHE_CAPACITY then
        local evicted = uriCacheOldest
        uriCacheOldest = evicted.newer
        uriCacheOldest.older = nil
        uriCache[evicted.value:tostring()] = nil
        uriCacheSize = uriCacheSize - 1
    end

    return value
end

--- Parses absolute URI text or component values.
export function newuri(value: string | URI.Components): (URI?, string?)
    local text: string
    if type(value) == "string" then
        text = value as string
    else
        local composed, reason = fromComponents(value)
        if composed == nil then
            return nil, reason
        end
        text = composed
    end
    local cached = uriCache[text]
    if cached ~= nil then
        return adopt(cached.value)
    end
    local parts, reason = provider.parse(text)
    if parts == nil then
        return nil, reason
    end

    return adopt(
        setmetatable(
            {
                _text = parts.text,
                _scheme = parts.scheme,
                _authority = parts.authority,
                _username = parts.username,
                _password = parts.password,
                _host = parts.host,
                _port = parts.port,
                _path = parts.path,
                _query = parts.query,
                _fragment = parts.fragment,
            } as any,
            URI as any
        ) as URI
    )

end

--- Reports whether text parses as an absolute URI, without building one.
--- @param value the text to test
--- @return whether it parses
--- @return why it did not, when it did not
--- @export
export function validateuri(value: string): (boolean, string?)
    local parsed, reason = provider.parse(value)
    return parsed ~= nil, reason
end
