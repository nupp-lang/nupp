@!internal

module io.internal.process.types

const {type Path} = require("io.files.internal.path")
const {type Buffer, type Error} = require("nupp.io")
const {type ByteView} = require("nupp.io")

export type StreamMode = "pipe" | "inherit" | "null"

export type ErrorMode = Error.Mode

export type Options = {
    --- Lua file mode, "r" by default. On Windows, "rb" and "wb" disable text
    --- translation for File methods. Byte streams and `communicate` stay binary.
    mode: ("r" | "w" | "rb" | "wb")?,

    --- The child's working directory, as anything [](io.files) accepts, or nil
    --- to inherit this one.
    cwd: Path?,

    --- Variables overlaid on the inherited environment, or the whole environment
    --- when `clearenv` is set. A name must be non-empty and contain no `=`.
    env: {[string]: string}?,

    --- Whether to start from an empty environment rather than this process's.
    clearenv: boolean?,

    --- Where the child's standard input comes from: `"inherit"` in read mode, `"pipe"`
    --- in write mode.
    stdin: StreamMode?,

    --- Where the child's standard output goes: `"pipe"` in read mode, `"inherit"` in
    --- write mode.
    stdout: StreamMode?,

    --- Where the child's standard error goes, `"inherit"` by default.
    stderr: ErrorMode?,

    --- Kill the child after this many milliseconds. The clock starts when it is
    --- created, not when it is first waited on.
    timeoutms: integer?
}

export type SpawnOptions = Options & {args: {string}}

export type CommunicateOptions = {
    --- Complete standard input.
    ---
    --- Omitted input sends EOF immediately.
    input: (string | Buffer | ByteView)?,

    --- Maximum stdout and stderr bytes together.
    ---
    --- Defaults to 256 MiB.
    maxoutputbytes: integer?
}

export interface Exit
    --- The platform status code. A Unix signal is reported as 128 plus its number.
    --- Zero indicates success only when neither `killed` nor `timedout` is set.
    exitcode: integer

    --- The terminating signal, when available from the provider.
    signal: integer?

    --- Whether it was terminated rather than exiting on its own.
    killed: boolean

    --- Whether it was terminated because its deadline passed.
    timedout: boolean

end

export record Result
    --- How the child ended.
    exit: Exit

    --- Captured standard output.
    output: string

    --- Captured standard error.
    erroroutput: string

    --- Whether the child exited normally with status zero.
    function succeeded(self): boolean
        return not self.exit.killed and not self.exit.timedout and self.exit.exitcode == 0
    end
end

export record Interest
    --- The child, when its termination is one of the things being waited for, and nil
    --- when this wait would not be advanced by it.
    child: any?

    --- Stream handles this wait wants bytes from.
    read: {any}

    --- Stream handles this wait wants to put bytes into.
    write: {any}
end
