-- Temporary compatibility facade; consumers move to io.gpu.Layout.
module io.gpu.layout

local implementation = require("nupp.gpu.layout")
export type Layout = implementation.Layout
export const Layout = implementation.Layout
export function new(shape: {integer}, strides: {integer}, offset: integer?): Layout
    return new Layout(shape, strides, offset)
end

export function subview(borrows value: Layout, origin: {integer}, shape: {integer}): Layout
    return value:subview(origin, shape)
end

export function transpose(borrows value: Layout, order: {integer}): Layout
    return value:transpose(order)
end

export function broadcast(borrows value: Layout, shape: {integer}): Layout
    return value:broadcast(shape)
end

export function asstrided(borrows value: Layout, shape: {integer}, strides: {integer}, relativeoffset: integer): Layout
    return value:asstrided(shape, strides, relativeoffset)
end
