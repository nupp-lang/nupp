module io.terminal

--[[
`io.terminal` formats terminal styles and aligned tables.
Terminal styles and tables share the stream's color policy.

```nupp
local terminal = require("io.terminal")
local styles = terminal.style(io.stderr)
io.stderr:write(styles.strong("error:") .. " bad input\n")
```

See [command-line applications](docs/learn/projects/command-line-applications.md#use-terminal-colors)
for styles and aligned tables.
]]

local terminal = {}
const terminalTypes = require("nupp.cli.internal.terminal")
const tables = require("nupp.cli.internal.table")

type terminal.ColorMode = terminalTypes.ColorMode
type terminal.Style = terminalTypes.Style
type terminal.Alignment = tables.Alignment
type terminal.Cell = tables.Cell
type terminal.Column = tables.Column
type terminal.TableOptions = tables.Options

--- Sets the process-wide default color policy.
function terminal.setcolormode(wanted: terminal.ColorMode): nil
    return require("nupp.cli.internal.terminal").setColorMode(wanted)
end

--- Runs a body under one color policy and restores the previous policy.
function terminal.withcolormode(wanted: terminal.ColorMode, body: function(): nil): nil
    return require("nupp.cli.internal.terminal").withColorMode(wanted, body)
end

--- Reports whether escapes should be written to a stream.
function terminal.colorenabled(stream: LuaFile): boolean
    return require("nupp.cli.internal.terminal").colorEnabled(stream)
end

--- Reports whether a stream is connected to a terminal.
function terminal.isterminal(stream: LuaFile): boolean
    return require("nupp.cli.internal.terminal").isTerminal(stream)
end

--- Reports how many columns a stream's terminal has, when it has one.
function terminal.columns(stream: LuaFile): integer?
    return require("nupp.cli.internal.terminal").columns(stream)
end

--- Returns the generic styles selected for a stream.
function terminal.style(stream: LuaFile): terminal.Style
    return require("nupp.cli.internal.terminal").style(stream)
end

--- Renders aligned columns, painting each cell after it is padded.
function terminal.table(options: terminal.TableOptions): string
    return require("nupp.cli.internal.table").render(options)
end

--- Renders aligned columns straight to a stream.
function terminal.writetable(stream: LuaFile, options: terminal.TableOptions): nil
    return require("nupp.cli.internal.table").write(stream, options)
end

--- A plain table cell.
function terminal.cell(value: string): terminal.Cell
    return require("nupp.cli.internal.table").text(value)
end

--- A table cell that paints itself, whatever its column says.
function terminal.paintedcell(value: string, paint: function(string): string): terminal.Cell
    return require("nupp.cli.internal.table").painted(value, paint)
end

--- A table cell carrying an aside, measured with the cell and painted apart
--- from it.
function terminal.annotatedcell(value: string, note: string, paint: (function(string): string)?): terminal.Cell
    return require("nupp.cli.internal.table").annotated(value, note, paint)
end

--- Selects the color associated with a diagnostic severity.
function terminal.severity(styles: terminal.Style, name: string?): function(string): string
    return require("nupp.cli.internal.terminal").forSeverity(styles, name)
end

export = terminal
