@!internal

--[[Private TLS transport implementation for `io.net`.]]
module io.net.internal.tls

const assert2 = require("assert")

local target = require("nupp.runtime.target")

const io = require("nupp.io")
local scalarAdapters = require("nupp.io.internal.scalars")
const {type Reader} = require("nupp.io")
const {type Writer} = require("nupp.io")
const {type Buffer} = require("nupp.io.internal.bytes")

local net = require("nupp.io.net")
local takeStreamHandle: function(takes source: net.Stream): any = require("nupp.io.net.internal").takeStreamHandle
local suspension = require("nupp.suspension")
local span = require("bytes.span")
local physical = require("nupp.runtime.storage")
local spanStringValue: function(borrows source: const uint8[?], count: integer): string = physical.string as any

const contract = require("io.net.internal.contracts")
local provider: contract.TlsProvider = do
    assert2(target.host == "native", "io.net: no implementation is available")
    yield _G.require("nupp.runtime.provider.nativetls") as contract.TlsProvider
end

const shared = require("io.net.internal.tlstypes")

--- How a client session is opened.
export type TlsClientOptions = shared.ClientOptions

--- How a server session is opened.
export type TlsServerOptions = shared.ServerOptions

--- The smallest set of operations a platform has to answer for this module.

--- @raises string when the value is not a positive integer
local function positive(value: integer, what: string, level: integer): integer
    if value < 1 or math.floor(value) ~= value then
        error("nupp: " .. what .. " must be a positive integer", level + 1)
    end

    return value
end

--- Packs a protocol list the way the provider takes one.
---
--- Separated by NUL rather than by anything printable, because a protocol name
--- is arbitrary bytes and any printable delimiter is a name somebody may
--- legitimately want.
--- @raises string when a protocol is empty or longer than 255 bytes
local function packProtocols(protocols: {string}?, level: integer): string
    if protocols == nil or #protocols == 0 then
        return ""
    end
    local packed = {}
    for index, protocol in ipairs(protocols) do
        if #protocol < 1 or #protocol > 255 then
            error("nupp: tls protocol " .. index .. " must be 1 through 255 bytes", level + 1)
        end
        if protocol:find("\0", 1, true) ~= nil then
            error("nupp: tls protocol " .. index .. " must not hold a NUL", level + 1)
        end
        packed[index] = protocol
    end

    return table.concat(packed, "\0") .. "\0"
end

--- Suspends until `ready` returns true, driving the connection's reactor.
---
--- The session has no reactor of its own: what it is waiting for is always the
--- socket underneath it, so this drives that one rather than registering a
--- second source that would poll the same thing twice.
local function await(operation: string, borrows ready: function(): boolean): nil
    -- The suspension contract unregisters its sources before returning or raising.
    -- Keep the actual closure and its captured span roots; only the scheduler's
    -- temporary callback registration lies outside lexical borrow tracking.
    local held = require("nupp.io.internal.bytes").waitCallback(ready)
    local state = @unsafe own.release(held)
    local pollReady = state.callback
    if pollReady() then
        return
    end
    suspension.suspend(operation, function(resume: function(boolean), context: any): function()?
        -- Registered until the resumed task runs; a poll before then must not
        -- resume it twice.
        local resumed = false
        const source = context:source(
            "tls",
            50,
            function(): integer
                net.pump(0)
                if not resumed and pollReady() then
                    resumed = true
                    resume(true)

                    return 1
                end

                return 0
            end,
            function(waitMs: integer): integer
                net.pump(waitMs)

                return 0
            end
        )

        return function(): nil
            source:release()
        end
    end)
end

--- An encrypted connection.
---
--- Owns the connection it encrypts over. Closing the session sends
--- `close_notify`, drains it, and closes the socket.
--- @export
export record TlsSession is io.Reader, io.Writer
    --- Takes both directions as one owned scalar stream.
    function scalar(takes self): affine(io.ScalarStream)
        return scalarAdapters.duplex(self)
    end

    @private _provider: contract.TlsProvider
    @private _session: any

    @private _closed: boolean
    @private _ready: boolean
    @private _ended: boolean

    --- Whether the connection underneath is still open.
    ---
    --- False once this session is released: closing frees the native session,
    --- so the question has to be answered from this record's own state rather
    --- than asked of memory that has been given back.
    function isconnected(self): boolean
        if self._closed then
            return false
        end

        return self._provider:connected(self._session)
    end

    --- Whether the handshake has finished.
    function isready(self): boolean
        return self._ready
    end

    --- Whether this session has been released.
    function isreleased(self): boolean
        return self._closed
    end

    --- Whether the peer closed its sending half.
    function isended(self): boolean
        return self._ended
    end

    --- The application protocol both sides agreed on, or nil when none was
    --- negotiated.
    ---
    --- Nil is not a failure: it is what neither side offering a list looks
    --- like. A server that offered a list sharing nothing with the client's
    --- refuses the handshake instead, so a session that exists and returns nil
    --- was never asked to pick one.
    function protocol(self): string?
        if self._closed or not self._ready then
            return nil
        end

        return self._provider:protocol(self._session)
    end

    --- Whether the peer's certificate satisfied what was asked of it.
    ---
    --- Answered after the handshake and not before, because before it there is
    --- no certificate to have an opinion about.
    function isverified(self): boolean
        if self._closed or not self._ready then
            return false
        end

        return self._provider:verified(self._session)
    end

    --- Whether this connection skipped the full asymmetric handshake by
    --- resuming a cached session.
    ---
    --- Servers return false. The server-side store is deliberately opaque: a
    --- client can use this answer to observe its cache, while accepting a
    --- session does not change what a server application may do with it.
    function isresumed(self): boolean
        if self._closed or not self._ready then
            return false
        end

        const resumed = self._provider.resumed

        return resumed ~= nil and resumed(self._provider, self._session) or false
    end

    --- Drives the handshake one pass, without suspending.
    ---
    --- The form a host with its own loop wants, and the form two sessions in one
    --- thread need: a handshake is two peers taking turns, so something has to
    --- be able to give one side a turn without waiting for it to finish.
    --- `handshake` is this in a loop with the waiting done for you.
    --- @param self this session
    --- @return whether the handshake has finished, or nil when it failed
    --- @return why it failed, when it did
    function step(self): (boolean?, io.Error?)
        if self._closed then
            return nil, io.toError("the session is closed")
        end
        if self._ready then
            return true
        end
        const done, why = self._provider:handshake(self._session)
        if done == nil then
            return nil, io.toError(why)
        end
        if done then
            self._ready = true
        end

        return self._ready
    end

    --- Drives the handshake to completion, suspending while it waits on the
    --- connection.
    --- @param self this session
    --- @return whether the handshake finished
    --- @return why it did not, when unsuccessful
    function handshake(self): (boolean, io.Error?)
        if self._closed then
            return false, io.toError("the session is closed")
        end
        if not self:isconnected() then
            return false, io.toError("the connection underneath was closed first")
        end
        if self._ready then
            return true
        end
        local failure: io.Error? = nil
        await("io.net handshake", function(): boolean
            const done, why = self:step()
            if done == nil then
                failure = why or io.toError("the handshake failed")

                return true
            end

            return done or false
        end)
        if failure ~= nil then
            return false, failure
        end

        return true
    end

    --- Reads up to `count` decrypted bytes, suspending while none have arrived.
    ---
    --- An empty answer is the end, exactly as on a plain connection, and it is
    --- only ever the end: here that end is the peer's `close_notify` and
    --- nothing else. A connection that simply stopped is a truncated stream and
    --- is reported as a failure, because what arrived is the front of a message
    --- rather than the whole of one and no authenticated party said otherwise.
    --- @param self this session
    --- @param count the most bytes to read
    --- @return the bytes, or nil when the session is closed
    --- @return why it could not read, when unsuccessful
    --- @raises string when count is not a positive integer
    function read(exclusive self, count: integer): (string?, string?)
        if self._closed then
            return nil, "the session is closed"
        end
        if not self._ready then
            return nil, "the handshake has not finished"
        end
        const wanted = positive(count, "io.net.TlsSession read count", 2)
        local chunk: string? = nil
        local failure: string? = nil
        local ended = false
        -- The wait borrows plain values rather than the session, which this read
        -- holds exclusively.
        const provider = self._provider
        const session = self._session
        await("io.net read", function(): boolean
            const got, why = provider:read(session, wanted)
            if why ~= nil then
                failure = why

                return true
            end
            if got == nil then
                return false
            end
            if #got > wanted then
                failure = "the TLS provider returned more bytes than requested"

                return true
            end
            chunk = got
            ended = #got == 0

            return true
        end)
        if ended then
            self._ended = true
        end
        if failure ~= nil then
            return nil, failure
        end

        return chunk or ""
    end

    --- Reads directly into a checked writable span. A zero answer is the end.
    --- @raises string when the destination is empty
    function readspan(exclusive self, exclusive destination: span.ByteWriteSpan): (integer?, string?)
        if self._closed then
            return nil, "the session is closed"
        end
        if not self._ready then
            return nil, "the handshake has not finished"
        end
        local readInto = self._provider.readspan
        if readInto == nil then
            local chunk, why = self:read(positive(#destination, "TLS destination length", 2))
            if chunk == nil then
                return nil, why
            end
            local input = span.fromstring(chunk)
            for index = 1, #chunk do
                destination[index] = input[index]
            end
            return #chunk
        end
        const wanted = positive(#destination, "io.net.TlsSession readspan destination length", 2)
        local chunk: integer? = nil
        local failure: string? = nil
        local ended = false
        -- The wait borrows plain values rather than the session, which this read
        -- holds exclusively.
        const provider = self._provider
        const session = self._session
        await("io.net read", function(): boolean
            const got, why = readInto(provider, session, destination)
            if why ~= nil then
                failure = why

                return true
            end
            if got == nil then
                return false
            end
            if got < 0 or got > wanted or got % 1 ~= 0 then
                failure = "the TLS provider returned more bytes than requested"

                return true
            end
            chunk = got
            ended = got == 0

            return true
        end)
        if ended then
            self._ended = true
        end
        if failure ~= nil then
            return nil, failure
        end

        return chunk or 0
    end

    --- Writes plaintext, in as many records as it takes.
    --- @param self this session
    --- @param bytes the bytes to append
    --- @return whether they were written
    --- @return why they were not, when unsuccessful
    function write(exclusive self, bytes: string): (boolean, string?)
        if self._closed then
            return false, "the session is closed"
        end
        if not self:isconnected() then
            return false, "the connection underneath was closed first"
        end
        if not self._ready then
            return false, "the handshake has not finished"
        end
        -- The wait's callback is kept by the reactor until the write lands, so it
        -- holds the backend and the session rather than the exclusive receiver.
        const backend, session = self._provider, self._session
        local at: integer = 1
        while at <= #bytes do
            local took: integer? = nil
            local failure: string? = nil
            const remaining = bytes:sub(at)
            await("io.net write", function(): boolean
                const moved, why = backend:write(session, remaining)
                if why ~= nil then
                    failure = why

                    return true
                end
                if moved == nil then
                    return false
                end
                if moved < 1 or moved > #remaining or math.floor(moved) ~= moved then
                    failure = "the TLS provider returned an invalid write count"

                    return true
                end
                took = moved

                return true
            end)
            if failure ~= nil then
                return false, failure
            end
            at = at + (took or 0)
        end

        return true
    end

    --- Appends bytes from a checked shared span.
    function writespan(exclusive self, borrows source: span.Span<uint8>): (integer?, string?)
        if self._closed then
            return nil, "the session is closed"
        end
        if not self:isconnected() then
            return nil, "the connection underneath was closed first"
        end
        if not self._ready then
            return nil, "the handshake has not finished"
        end
        local writeFrom = self._provider.writespan
        if writeFrom == nil then
            local ok, why = self:write(spanStringValue(source:ref(), #source))
            if not ok then
                return nil, why
            end
            return #source
        end
        -- The wait's callback is kept by the reactor until the write lands, so it
        -- holds the backend and the session rather than the exclusive receiver.
        const backend, session = self._provider, self._session
        local at: integer = 1
        while at <= #source do
            local took: integer? = nil
            local failure: string? = nil
            const remaining = source:slice(at)
            await("io.net write", function(): boolean
                const moved, why = writeFrom(backend, session, remaining)
                if why ~= nil then
                    failure = why

                    return true
                end
                if moved == nil then
                    return false
                end
                if moved < 1 or moved > #remaining or math.floor(moved) ~= moved then
                    failure = "the TLS provider returned an invalid write count"

                    return true
                end
                took = moved

                return true
            end)
            if failure ~= nil then
                return nil, failure
            end
            at = at + (took or 0)
        end

        return #source
    end

    --- Waits until the records this session wrote have left the process.
    ---
    --- A TLS write puts encrypted records on the connection underneath, and
    --- that connection has a queue. Reporting success while they sit in it
    --- would let a caller write, flush, close the connection, and have the
    --- records cancelled with it.
    function flush(self): (boolean, string?)
        if self._closed then
            return false, "the session is closed"
        end
        if not self:isconnected() then
            return false, "the connection underneath was closed first"
        end

        local complete = false
        local failure: string? = nil
        await("io.net flush", function(): boolean
            const done, why = self._provider:flushed(self._session)
            if why ~= nil then
                failure = why

                return true
            end
            complete = done

            return done
        end)
        if failure ~= nil then
            return false, failure
        end

        return complete
    end

    --- Sends `close_notify`, drains it, and closes the owned connection.
    --- Terminal and idempotent.
    ---
    --- The drain is bounded: a peer that has stopped reading gets about a
    --- second for the last records and the alert before the connection is
    --- closed without them.
    function close(takes self): nil
        if self._closed then
            return
        end
        if self._ready and self:isconnected() then
            -- The records already written go first, then the alert that says
            -- this side is finished, and both are waited for. Submitting the
            -- alert and returning would let the connection be released with it
            -- still queued, and a peer that never receives it sees a stream
            -- that stopped rather than one that ended -- which is exactly the
            -- truncation a `close_notify` exists to rule out. The provider
            -- answers once they are out or once the drain's time is spent.
            const chosen, session = self._provider, self._session
            await("io.net close", function(): boolean
                const sent, why = chosen:closenotify(session)

                return sent or why ~= nil
            end)
        end
        self._closed = true
        self._provider:destroy(self._session)
    end
end

require("nupp.io.internal.bytes").readercompat(TlsSession as table)

--- Encrypts a connection as the client.
---
--- Every option is optional. Verification is on unless `verify` is false, and a
--- verified session needs the `hostname` to check the certificate against, so a
--- client that names no options is refused for that rather than connecting to
--- whoever answers.
--- @param stream the connection to adopt; it is consumed even when setup fails
--- @param options what to expect of the peer
--- @return the session, which the caller owns and must close
--- @return why it could not be made, when unsuccessful
--- @raises string when verification is asked for without a name to verify against
--- @export
export function tlsclient(takes stream: net.Stream, options: TlsClientOptions?): (affine(TlsSession)?, io.Error?)
    const chosen = provider
    const given: TlsClientOptions = options or {}
    const verify = given.verify ~= false
    if verify and (given.hostname == nil or given.hostname == "") then
        error("nupp: io.net.tlsclient needs a hostname to verify the peer against", 2)
    end
    const protocols = packProtocols(given.protocols, 2)
    const session, why = chosen:wrap(
        takeStreamHandle(stream),
        false,
        given.hostname or "",
        "",
        "",
        given.authority,
        protocols,
        verify
    )
    if session == nil then
        return nil, io.toError(why)
    end

    return TlsSession(_provider = chosen, _session = session, _closed = false, _ready = false, _ended = false)
end

--- Encrypts a connection as the server.
--- @param stream the connection to adopt; it is consumed even when setup fails
--- @param options the server identity and application protocols to present
--- @return the session, which the caller owns and must close
--- @return why it could not be made, when unsuccessful
--- @export
export function tlsserver(takes stream: net.Stream, options: TlsServerOptions): (affine(TlsSession)?, io.Error?)
    const chosen = provider
    const protocols = packProtocols(options.protocols, 2)
    const session, why = chosen:wrap(
        takeStreamHandle(stream),
        true,
        "",
        options.certificate,
        options.privatekey,
        nil,
        protocols,
        false
    )
    if session == nil then
        return nil, io.toError(why)
    end

    return TlsSession(_provider = chosen, _session = session, _closed = false, _ready = false, _ended = false)
end
