module io.files.messages

--[[
`io.files.messages` defines filesystem metadata and capability contracts.
Providers and callers share the same entry and information types.

```nupp
local messages = require("io.files.messages")
local function isfile(info: messages.Info): boolean
    return info.kind == "file"
end
```
]]
local source1 = require("nupp.io.files.messages")
export type Capabilities = source1.Capabilities
export type Entry = source1.Entry
export type Info = source1.Info
export type Kind = source1.Kind
export type Mode = source1.Mode
export type Origin = source1.Origin
export type TemporaryOptions = source1.TemporaryOptions
export type UserFolder = source1.UserFolder
export const Capabilities = source1.Capabilities
export const Entry = source1.Entry
export const Info = source1.Info
export const TemporaryOptions = source1.TemporaryOptions
