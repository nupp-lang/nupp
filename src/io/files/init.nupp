--[[
Portable filesystem access accepts native paths on native hosts and
app-owned paths on browser hosts. Set an app id before
resolving the portable configuration, data, or cache directory.

```nupp
local files = io.files
files.setappid("example", "notes")

local data = assert(files.datapath())
assert(files.mkdir(data))
local file = assert(io.open(data:join("notes.txt"), "w"))
assert(file:write("hello"))
```

Native programs may also pass ordinary strings or [](io.Path)
values. Browser programs refuse raw path text and use the opaque
`AppPath` values returned by `configurationpath`, `datapath`, or
`cachepath`.

Browser app data lives in the Origin Private File System. It remains
evictable unless `requestpersistentstorage` succeeds. Capability flags describe
the operations whose native semantics have no browser equivalent.
]]
module io.files

const io = require("nupp.io")
const paths = require("io.internal.path")
const contracts = require("io.files.internal.contracts")
const messages = require("io.files.messages")
const appPaths = require("io.files.internal.path")

local provider: contracts.Provider = require("nupp.runtime.bindings.files")

--- The kind of filesystem object described by metadata or a directory entry.
export type Kind = messages.Kind

--- A portable name for a conventional user directory.
export type UserFolder = messages.UserFolder

--- A file open mode: read, write, append, or an updating variant.
export type Mode = messages.Mode

--- The base used by a file seek.
export type Origin = messages.Origin

--- Metadata about one filesystem object.
export type Info = messages.Info

--- An immediate child returned by a directory listing.
export type Entry = messages.Entry

--- Naming and placement options for a native temporary path.
export type TemporaryOptions = messages.TemporaryOptions

--- The exact filesystem guarantees supplied by the selected provider.
export type Capabilities = messages.Capabilities

--- An opaque portable path rooted in this app's platform storage.
export type AppPath = appPaths.AppPath

--- A native path or an opaque app-owned path.
export type Path = appPaths.Path

--- A native temporary path removed when its owner closes unless persisted.
export type TemporaryPath = contracts.TemporaryPath

--- Constructs filesystem metadata, primarily for provider implementations.
export const Info = messages.Info

--- Constructs a directory entry, primarily for provider implementations.
export const Entry = messages.Entry

--- Constructs native temporary-path options.
export const TemporaryOptions = messages.TemporaryOptions

--- Constructs a filesystem capability report.
export const Capabilities = messages.Capabilities

local organization: string?
local app: string?
local roots: {[string]: appPaths.AppPath} = {}

--- Selects the app id used to resolve configuration, data, and cache roots.
--- @param neworganization the organization component
--- @param newapp the app component
--- @return nil after selecting the app id
export function setappid(neworganization: string, newapp: string): nil
    appPaths.encodeid(neworganization, "organization")
    appPaths.encodeid(newapp, "app")
    organization = neworganization
    app = newapp
end

--- Returns the selected app id, or nil values before one is set.
--- @return the organization component
--- @return the app component
export function appid(): (string?, string?)
    return organization, app
end

--- Carries a provider's answer out with its reason as an io error.
local function answered<T>(value: T, why: string?): (T, io.Error?)
    return value, io.toError(why)
end

local function apppath(kind: string): (appPaths.AppPath?, io.Error?)
    if organization == nil or app == nil then
        return nil, io.toError("app id is unset; call files.setappid first", "invalid")
    end
    local key = kind .. "\0" .. organization .. "\0" .. app
    local remembered = roots[key]
    if remembered ~= nil then
        local created, reason = provider.createDirectory(remembered)
        if not created then
            return nil, io.toError(reason)
        end
        return remembered, nil
    end
    local value, reason = provider.apppath(kind, organization, app)
    if value ~= nil then
        roots[key] = value
    end

    return value, io.toError(reason)
end

--- Resolves and creates this app's platform configuration directory.
---
--- Configuration, data and cache are always three distinct directories, so
--- clearing one with a recursive `remove` never reaches another.
--- @return the configuration path, or nil on failure
--- @return a failure reason, when unsuccessful
export function configurationpath(): (appPaths.AppPath?, io.Error?)
    return apppath("configuration")
end

--- Resolves and creates this app's platform data directory.
--- @return the data path, or nil on failure
--- @return a failure reason, when unsuccessful
export function datapath(): (appPaths.AppPath?, io.Error?)
    return apppath("data")
end

--- Resolves and creates this app's platform cache directory.
--- @return the cache path, or nil on failure
--- @return a failure reason, when unsuccessful
export function cachepath(): (appPaths.AppPath?, io.Error?)
    return apppath("cache")
end

--- Reports the exact guarantees of the selected filesystem provider.
--- @return the provider capabilities
export const capabilities = provider.capabilities

--- Describes the filesystem object at a path.
--- @param path the path to inspect
--- @return its metadata, or nil on failure
--- @return a failure reason, when unsuccessful
export function info(path: Path): (messages.Info?, io.Error?)
    return answered(provider.info(path))
end

--- Reports whether a path resolves.
---
--- Any failure reads as `false`, a refused permission or an I/O error as much as
--- a missing name. Ask `info` when the reason matters.
--- @param path the path to inspect
--- @return whether it exists
export function exists(path: Path): boolean
    return provider.exists(path)
end

--- Reports whether a path resolves to a file.
---
--- Any failure reads as `false`; ask `info` when the reason matters.
--- @param path the path to inspect
--- @return whether it is a file
export function isfile(path: Path): boolean
    return provider.isFile(path)
end

--- Reports whether a path resolves to a directory.
---
--- Any failure reads as `false`; ask `info` when the reason matters.
--- @param path the path to inspect
--- @return whether it is a directory
export function isdirectory(path: Path): boolean
    return provider.isDirectory(path)
end

--- Reports whether a path itself is a symbolic link.
---
--- Any failure reads as `false`, and so does a provider with no links at all;
--- `capabilities().symlinks` says which that is.
--- @param path the path to inspect
--- @return whether it is a symbolic link
export function issymlink(path: Path): boolean
    return provider.isSymlink(path)
end

--- Reads a symbolic link target without resolving it.
--- @param path the link to read
--- @return its target, or nil on failure
--- @return a failure reason, when unsuccessful
export function readlink(path: Path): (paths.Path?, io.Error?)
    return answered(provider.readLink(path))
end

--- Creates a symbolic link when the provider supports one.
--- @param targetpath the path the link names
--- @param link where to create the link
--- @param kind whether a Windows link names a file or directory
--- @return whether the link was created
--- @return a failure reason, when unsuccessful
export function symlink(targetpath: Path, link: Path, kind: ("file" | "directory")?): (boolean, io.Error?)
    return answered(provider.createSymlink(targetpath, link, kind))
end

--- Sets or clears a path's native read-only attribute.
--- @param path the path to change
--- @param readonly whether writes should be refused
--- @return whether the attribute was changed
--- @return a failure reason, when unsuccessful
export function setreadonly(path: Path, readonly: boolean): (boolean, io.Error?)
    return answered(provider.setReadOnly(path, readonly))
end

--- Creates a directory and all missing parents.
--- @param path the directory to create
--- @return whether the directory exists afterward
--- @return a failure reason, when unsuccessful
export function mkdir(path: Path): (boolean, io.Error?)
    return answered(provider.createDirectory(path))
end

--- Removes a file, link, or directory.
--- @param path the path to remove
--- @param recursive whether to remove a directory's contents
--- @return whether the path was removed
--- @return a failure reason, when unsuccessful
export function remove(path: Path, recursive: boolean?): (boolean, io.Error?)
    return answered(provider.remove(path, recursive))
end

--- Renames a path, replacing an existing destination when supported.
--- @param from the source path
--- @param to the destination path
--- @return whether the path was renamed
--- @return a failure reason, when unsuccessful
export function rename(from: Path, to: Path): (boolean, io.Error?)
    return answered(provider.rename(from, to))
end

--- Lists a directory's immediate children.
--- @param path the directory to list
--- @return its entries, or nil on failure
--- @return a failure reason, when unsuccessful
export function list(path: Path): ({messages.Entry}?, io.Error?)
    return answered(provider.list(path))
end

--- Expands a native filesystem glob.
--- @param pattern the glob pattern
--- @return sorted matching paths, or nil on failure
--- @return a failure reason, when unsuccessful
export function glob(pattern: string): ({paths.Path}?, io.Error?)
    return answered(provider.glob(pattern))
end

--- Atomically replaces a file when the provider supports it.
--- @param path the destination file
--- @param bytes the byte string or view to write
--- @return whether the file was replaced
--- @return a failure reason, when unsuccessful
export function writeatomic(path: Path, borrows bytes: string | io.ByteView): (boolean, io.Error?)
    return answered(provider.writeAtomic(path, bytes))
end

--- Copies a file over another.
--- @param from the source file
--- @param to the destination file
--- @return whether the file was copied
--- @return a failure reason, when unsuccessful
export function copy(from: Path, to: Path): (boolean, io.Error?)
    return answered(provider.copy(from, to))
end

--- Reports whole-file transfers that have not settled.
--- @return the number of pending transfers
export const pendingtransfers = provider.pendingTransfers

--- Creates a native temporary file owner when the provider supports one.
--- @param options naming and placement options
--- @return the temporary path owner, or nil on failure
--- @return a failure reason, when unsuccessful
export function tmpfile(options: messages.TemporaryOptions?): (affine(contracts.TemporaryPath?), io.Error?)
    local owner, why = provider.createTemporaryFile(options)
    if owner == nil then
        return nil, io.toError(why)
    end

    return owner, nil
end

--- Creates a native temporary directory owner when the provider supports one.
--- @param options naming and placement options
--- @return the temporary path owner, or nil on failure
--- @return a failure reason, when unsuccessful
export function tmpdirectory(options: messages.TemporaryOptions?): (affine(contracts.TemporaryPath?), io.Error?)
    local owner, why = provider.createTemporaryDirectory(options)
    if owner == nil then
        return nil, io.toError(why)
    end

    return owner, nil
end

--- Resolves a conventional native user folder.
--- @param which the folder to resolve
--- @return its native path, or nil when unavailable
--- @return a failure reason, when unsuccessful
export function userfolder(which: messages.UserFolder): (paths.Path?, io.Error?)
    return answered(provider.userFolder(which))
end

--- Returns the native running executable's directory.
--- @return the executable directory, or nil when unavailable
--- @return a failure reason, when unsuccessful
export function executabledirectory(): (paths.Path?, io.Error?)
    return answered(provider.executableDirectory())
end

--- Requests non-evictable browser storage; native providers succeed without work.
--- @return whether persistence is guaranteed
--- @return a failure reason, when unsuccessful
export function requestpersistentstorage(): (boolean, io.Error?)
    return answered(provider.requestPersistentStorage())
end
