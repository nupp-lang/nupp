@!internal

module serde.json.internal.contracts

local {type Buffer as SharedBuffer} = require("nupp.io.internal.bytes")

--[[Implementation interfaces consumed during ordinary module initialization.
The build binds the implementation for the selected target. Importing these
declarations loads no implementation.]]

--- A complete JSON value whose immutable bytes have already been encoded or
--- validated.
---
--- Values come from `encoded` or `verified`; the private token prevents checked
--- callers from manufacturing an unverified fast-path value.
export record EncodedValue
    @private _token: any
end

--- A JSON string whose immutable encoded bytes have already been produced or
--- validated.
---
--- `Writer:key` accepts this type without validating UTF-8 or escaping it again.
--- Values produced by `encodedstring` and `verifiedstring` are interned.
export record EncodedString
    @private _token: any
end

--- Values that can write a complete JSON value through a checked writer.
---
--- `serde.json` names it for callers; it is declared here so the modules the facade
--- reads, serde and types.derive among them, can name it without reading the facade.
--- `Writer` below names the encoder `serde.json.Writer.of()` returns.
---
--- ```nupp
--- local record Money is serde.json.JSONEncodable
---     cents: integer
---
---     function writejson(self, exclusive out: serde.json.Writer): nil
---         out:startobject():key("cents"):write(self.cents):endobject()
---     end
--- end
--- ```
export interface JSONEncodable
    --- Writes this value at the writer's current value position.
    --- @param self the value being encoded
    --- @param out the checked destination
    writejson: function(self, exclusive out: Writer): nil
end

--- A checked incremental JSON writer.
---
--- ```nupp
--- local out = io.Buffer.create()
--- local writer = serde.json.Writer.of(out)
--- writer:startobject():key("ok"):write(true):endobject()
--- writer:close()
--- assert(out:getstring() == [[{"ok":true}]])
--- ```
--- @export
export interface Writer is own.Closeable
    --- Starts an array value.
    ---
    --- ```nupp
    --- local out = io.Buffer.create()
    --- local writer = serde.json.Writer.of(out)
    --- writer:startarray():write("first"):endarray()
    --- writer:close()
    --- assert(out:getstring() == "[\"first\"]")
    --- ```
    --- @param self the writer
    --- @return this writer
    startarray: function(exclusive self: Writer): Writer borrows (self)

    --- Starts an object value.
    ---
    --- ```nupp
    --- local out = io.Buffer.create()
    --- local writer = serde.json.Writer.of(out)
    --- writer:startobject():endobject()
    --- writer:close()
    --- assert(out:getstring() == "{}")
    --- ```
    --- @param self the writer
    --- @return this writer
    startobject: function(exclusive self: Writer): Writer borrows (self)

    --- Selects the next object member.
    ---
    --- ```nupp
    --- local out = io.Buffer.create()
    --- local writer = serde.json.Writer.of(out)
    --- writer:startobject():key("answer"):write(42):endobject()
    --- writer:close()
    --- assert(out:getstring() == [[{"answer":42}]])
    --- ```
    --- @param self the writer
    --- @param name the next member name
    --- @return this writer
    key: function(exclusive self: Writer, name: string): Writer borrows (self)
        & function(exclusive self: Writer, name: EncodedString): Writer borrows (self)

    --- Appends a complete Lua value.
    ---
    --- ```nupp
    --- local out = io.Buffer.create()
    --- local writer = serde.json.Writer.of(out)
    --- writer:startarray():write({id = 41}):endarray()
    --- writer:close()
    --- assert(out:getstring() == "[{\"id\":41}]")
    --- ```
    --- @param self the writer
    --- @param value the next JSON value
    --- @return this writer
    write: function(
        exclusive self: Writer,
        value: string | number | boolean | {any} | {[string]: any}
    ): Writer borrows (self)
        & function(
            exclusive self: Writer,
            value: EncodedValue | EncodedString
        ): Writer borrows (self)

    --- Appends JSON null.
    ---
    --- ```nupp
    --- local out = io.Buffer.create()
    --- local writer = serde.json.Writer.of(out)
    --- writer:startarray():null():endarray()
    --- writer:close()
    --- assert(out:getstring() == "[null]")
    --- ```
    --- @param self the writer
    --- @return this writer
    null: function(exclusive self: Writer): Writer borrows (self)

    --- Ends the current array.
    ---
    --- ```nupp
    --- local out = io.Buffer.create()
    --- local writer = serde.json.Writer.of(out)
    --- writer:startarray():startobject():endobject():endarray()
    --- writer:close()
    --- assert(out:getstring() == "[{}]")
    --- ```
    --- @param self the writer
    --- @return this writer
    endarray: function(exclusive self: Writer): Writer borrows (self)

    --- Ends the current object.
    ---
    --- ```nupp
    --- local out = io.Buffer.create()
    --- local writer = serde.json.Writer.of(out)
    --- writer:startobject():key("items"):startarray():endarray():endobject()
    --- writer:close()
    --- assert(out:getstring() == [[{"items":[]}]])
    --- ```
    --- @param self the writer
    --- @return this writer
    endobject: function(exclusive self: Writer): Writer borrows (self)

    --- Publishes staged bytes without ending the document.
    ---
    --- ```nupp
    --- local out = io.Buffer.create()
    --- local writer = serde.json.Writer.of(out)
    --- writer:startarray():write(1)
    --- writer:flush()
    --- assert(out:getstring() == "[1")
    --- writer:endarray()
    --- writer:close()
    --- assert(out:getstring() == "[1]")
    --- ```
    --- @param self the writer
    flush: @nosuspend function(exclusive self: Writer): nil

    --- Discards staged bytes and prevents further writes.
    ---
    --- Bytes already flushed to the destination remain there. Repeated aborts
    --- and closing an aborted writer are harmless.
    ---
    --- ```nupp
    --- local out = io.Buffer.create()
    --- local writer = serde.json.Writer.of(out)
    --- writer:startarray():write(1)
    --- writer:abort()
    --- writer:close()
    --- assert(out:getstring() == "")
    --- ```
    --- @param self the writer
    abort: @nosuspend function(exclusive self: Writer): nil

    --- Verifies and publishes a complete root, then releases backing state.
    ---
    --- ```nupp
    --- local out = io.Buffer.create()
    --- local writer = serde.json.Writer.of(out)
    --- writer:write({ok = true})
    --- writer:close()
    --- assert(out:getstring() == [[{"ok":true}]])
    --- ```
    --- @param self the writer
    close: @nosuspend function(takes self: Writer): nil
end

--- Marks a table while returning the same generic table and ownership.
---
--- The takes/preserves relation is intentional: an implementation must not copy the
--- container or erase an affine owner while applying its JSON marker.
export type MarkContainer = function<T is table>(takes value: T): T preserves value

--- JSON API 2, including portable encoding and optional compiled serde.
---
--- Arrays, objects, null sentinels, and verified fragments must agree across every
--- member of this table. Keep marker identities stable for the loaded provider.
--- The caller's nullvalue controls null conversion; omission follows the public
--- JSON API's nil behavior. Reject malformed syntax, invalid UTF-8, unsupported
--- container shapes, and invalid raw fragments according to that API.
---
--- The three serde hooks are optional accelerators. If supplied together, compiled
--- schemas and both decode entry points must share their representation and
--- unknown-member policy. All buffer operations use the canonical shared Buffer;
--- they must preserve the declared exclusive access and ownership guarantees.
export interface Provider

    --- Builds an array projection shape with the supplied element shape.
    @readonly arrayof: function(shape: any?): any

    --- Marks and returns the same table as an array, preserving its ownership.
    @readonly asarray: MarkContainer

    --- Marks and returns the same table as an object, preserving its ownership.
    @readonly asobject: MarkContainer

    --- Reports whether a value has JSON array semantics.
    @readonly isarray: function(value: any): boolean

    --- Parses JSON, applying the caller-selected representation of null.
    @readonly decode: function(text: string, nullvalue: any?): any

    --- Serializes a value with this provider's markers and null convention.
    @readonly encode: function(value: any, nullvalue: any?): string

    --- Creates a validated encoded-value fragment for subsequent composition.
    @readonly encoded: function(value: any, nullvalue: any?): any

    --- Validates a numeric lexeme without conversion and retains its exact bytes.
    @readonly numbertoken: function(text: string): any

    --- Creates a fragment containing one escaped JSON string.
    @readonly encodedstring: function(value: string): any

    --- Parses only the value projection described by shape.
    @readonly pull: function(text: string, shape: any, nullvalue: any?): any

    --- Validates raw JSON and retains a fragment suitable for composition.
    @readonly verified: function(text: string): any

    --- Validates a raw encoded JSON string fragment.
    @readonly verifiedstring: function(text: string): any

    --- Creates a JSON writer over exclusive access to the canonical buffer.
    @readonly newwriter: function(exclusive out: SharedBuffer, nullvalue: any?): any

    --- Stable explicit null marker owned by this loaded implementation.
    @readonly NULL: any

    --- Stable empty-array marker value.
    @readonly EMPTY_ARRAY: table

    --- Stable empty-object marker value.
    @readonly EMPTY_OBJECT: table

    --- Optionally prepares a schema plan with its unknown-member policy.
    @readonly compileserde: (function(plan: any, unknownmembers: string): any)?

    --- Optionally decodes a prepared schema, returning value or diagnostic.
    @readonly decodeserde: (function(schema: any, text: string): (any?, string?))?

    --- Optionally decodes from exclusive access to the canonical buffer.
end
