--[[
The `encoding` option: a document declared, or byte-order-marked, as
UTF-16LE, UTF-16BE, ISO-8859-1, Windows-1252 or US-ASCII is transcoded to
UTF-8 before the reader sees it.

Each conversion is a `gsub` over the input with a table, so a document costs
a pass in the runtime's pattern code rather than a loop per byte.
]]
module serde.xml.internal.encoding

local text = require("serde.xml.internal.text")

local find = string.find
local sub = string.sub
local gsub = string.gsub
local byte = string.byte
local char = string.char
local lower = string.lower
local encode = text.encode

--- Windows-1252's 0x80-0x9F, as code points; the five it leaves undefined are
--- nil.
const CP1252: {
    [integer]: integer
} = {
    [0x80] = 0x20AC,
    [0x82] = 0x201A,
    [0x83] = 0x0192,
    [0x84] = 0x201E,
    [0x85] = 0x2026,
    [0x86] = 0x2020,
    [0x87] = 0x2021,
    [0x88] = 0x02C6,
    [0x89] = 0x2030,
    [0x8A] = 0x0160,
    [0x8B] = 0x2039,
    [0x8C] = 0x0152,
    [0x8E] = 0x017D,
    [0x91] = 0x2018,
    [0x92] = 0x2019,
    [0x93] = 0x201C,
    [0x94] = 0x201D,
    [0x95] = 0x2022,
    [0x96] = 0x2013,
    [0x97] = 0x2014,
    [0x98] = 0x02DC,
    [0x99] = 0x2122,
    [0x9A] = 0x0161,
    [0x9B] = 0x203A,
    [0x9C] = 0x0153,
    [0x9E] = 0x017E,
    [0x9F] = 0x0178,
}

local latin1: {[string]: string} = {}
local windows1252: {[string]: string} = {}
for value = 0x80, 0xFF do
    latin1[char(value)] = encode(value)
    local mapped = value >= 0xA0 and value or CP1252[value]
    if mapped ~= nil then
        windows1252[char(value)] = encode(mapped)
    end
end

--- What a label names, as one of this module's encodings.
const LABELS: {
    [string]: string
} = {
    ["utf-8"] = "utf-8",
    ["utf8"] = "utf-8",
    ["utf-16"] = "utf-16",
    ["utf-16le"] = "utf-16le",
    ["utf-16be"] = "utf-16be",
    ["iso-8859-1"] = "iso-8859-1",
    ["iso8859-1"] = "iso-8859-1",
    ["latin1"] = "iso-8859-1",
    ["latin-1"] = "iso-8859-1",
    ["l1"] = "iso-8859-1",
    ["windows-1252"] = "windows-1252",
    ["cp1252"] = "windows-1252",
    ["us-ascii"] = "us-ascii",
    ["ascii"] = "us-ascii",
}

local function failure(message: string, offset: integer?): never
    text.fail(nil, offset ?? 1, "unsupported-encoding", message, "/")
end

--- One UTF-16 code unit's UTF-8, or a marker for a surrogate, keyed by the
--- unit's two bytes in the order the input holds them.
local function unitTable(bigEndian: boolean): {[string]: string}
    local cache: {[string]: string} = {}

    return setmetatable(cache, {
        __index = function(store: {[string]: string}, pair: string): string
            local a, b = byte(pair, 1, 2)
            local unit = bigEndian and ((a as integer) << 8 | (b as integer)) or ((b as integer) << 8 | (a as integer))
            local result: string
            if unit >= 0xD800 and unit <= 0xDBFF then
                result = "\255H" .. char(unit >> 8, unit & 0xFF)
            elseif unit >= 0xDC00 and unit <= 0xDFFF then
                result = "\255L" .. char(unit >> 8, unit & 0xFF)
            else
                result = encode(unit)
            end
            rawset(store, pair, result)

            return result
        end,
    }) as {[string]: string}
end

local LE_UNITS = unitTable(false)
local BE_UNITS = unitTable(true)

local function combine(high: string, low: string): string
    local h1, h2 = byte(high, 1, 2)
    local l1, l2 = byte(low, 1, 2)
    local highUnit = (h1 as integer) << 8 | (h2 as integer)
    local lowUnit = (l1 as integer) << 8 | (l2 as integer)

    return encode(0x10000 + ((highUnit - 0xD800) << 10) + (lowUnit - 0xDC00))
end

--- Transcodes complete UTF-16 code units.
local function utf16(bytes: string, bigEndian: boolean): string
    local converted = gsub(bytes, "..", bigEndian and BE_UNITS or LE_UNITS)
    if find(converted, "\255", 1, true) then
        converted = gsub(converted, "\255H(..)\255L(..)", combine)
        if find(converted, "\255", 1, true) then
            failure("the UTF-16 document holds an unpaired surrogate")
        end
    end

    return converted
end

--- Transcodes a single-byte encoding.
local function singleByte(bytes: string, name: string): string
    if name == "us-ascii" then
        local high = find(bytes, "[\128-\255]")
        if high ~= nil then
            failure("byte " .. tostring(high) .. " is not US-ASCII", high)
        end
        return bytes
    end
    local map = name == "iso-8859-1" and latin1 or windows1252
    local converted = gsub(bytes, "[\128-\255]", map)
    if name == "windows-1252" then
        for undefined in pairs({[0x81] = true, [0x8D] = true, [0x8F] = true, [0x90] = true, [0x9D] = true}) do
            if find(bytes, char(undefined), 1, true) then
                failure(string.format("byte 0x%02X is not defined in Windows-1252", undefined))
            end
        end
    end

    return converted
end

--- Names the encoding a document's first bytes say it is in.
---
--- @param head at least the document's first few hundred bytes
--- @return the encoding: `utf-8`, `utf-16le`, `utf-16be`, `iso-8859-1`,
---     `windows-1252` or `us-ascii`
--- @return how many byte-order-mark bytes to drop
--- @raises serde.Error when the declaration names an unsupported encoding or
---     contradicts the byte-order mark
export function detect(head: string): (string, integer)
    local b1, b2, b3 = byte(head, 1, 3)
    local marked: string? = nil
    local skip: integer = 0
    if b1 == 0xEF and b2 == 0xBB and b3 == 0xBF then
        marked, skip = "utf-8", 3
    elseif b1 == 0xFF and b2 == 0xFE then
        marked, skip = "utf-16le", 2
    elseif b1 == 0xFE and b2 == 0xFF then
        marked, skip = "utf-16be", 2
    elseif b1 == 0x3C and b2 == 0 then
        marked = "utf-16le"
    elseif b1 == 0 and b2 == 0x3C then
        marked = "utf-16be"
    end
    -- The declaration, read as ASCII in whichever byte order holds it.
    local ascii = sub(head, skip + 1)
    if marked == "utf-16le" then
        ascii = gsub(ascii, "(.)%z", "%1")
    elseif marked == "utf-16be" then
        ascii = gsub(ascii, "%z(.)", "%1")
    end
    local declared: string? = nil
    if find(ascii, "^<%?xml[%s?]") then
        local close = find(ascii, "?>", 1, true)
        local declaration = sub(ascii, 1, close ?? #ascii)
        local _, _, label = find(declaration, "encoding%s*=%s*[\"']([^\"']*)[\"']")
        if label ~= nil then
            declared = LABELS[lower(label as string)]
            if declared == nil then
                failure("the document declares " .. (label as string) .. ", which is not supported")
            end
        end
    end
    if marked == nil then
        if declared == "utf-16" or declared == "utf-16le" or declared == "utf-16be" then
            failure(
                "the document declares " .. (declared as string) .. " but is written in an ASCII-compatible encoding"
            )
        end
        return declared ?? "utf-8", 0
    end
    if declared ~= nil and declared ~= marked and not (declared == "utf-16" and marked ~= "utf-8") then
        failure("the document declares " .. (declared as string) .. " but its first bytes are " .. (marked as string))
    end
    if marked == "utf-8" then
        return "utf-8", 0
    end

    return marked as string, skip
end

--- Transcodes a whole document to UTF-8.
---
--- @param source the document
--- @return the document as UTF-8, and whether it was transcoded
--- @raises serde.Error when the encoding is unsupported, contradicted, or
---     the bytes are malformed in it
export function transcode(source: string): (string, boolean)
    local name, skip = detect(sub(source, 1, 512))
    if name == "utf-8" then
        return source, false
    end
    local body = sub(source, skip + 1)
    if name == "utf-16le" or name == "utf-16be" then
        if #body % 2 ~= 0 then
            failure("the UTF-16 document has an odd number of bytes")
        end
        return utf16(body, name == "utf-16be"), true
    end

    return singleByte(body, name), true
end

--- Transcodes a streamed document chunk by chunk.
---
--- @param pull the source's chunks
--- @return the chunks as UTF-8, and whether they are transcoded
export function transcodestream(pull: function(): string?): (function(): string?, boolean)
    local head = ""
    local finished = false
    while #head < 512 and not finished do
        local data = pull()
        if data == nil or data == "" then
            finished = true
        else
            head = head .. data
        end
    end
    local name, skip = detect(head)
    if name == "utf-8" then
        local first: string? = head
        return function(): string?
            if first ~= nil then
                local chunk = first
                first = nil
                return chunk
            end
            if finished then
                return nil
            end

            return pull()
        end, false
    end
    local pending = sub(head, skip + 1)
    local wide = name == "utf-16le" or name == "utf-16be"
    local bigEndian = name == "utf-16be"
    local done = false

    local function produce(): string?
        while true do
            if done then
                return nil
            end
            if not finished then
                local data = pull()
                if data == nil or data == "" then
                    finished = true
                else
                    pending = pending .. data
                end
            end
            if pending == "" then
                if finished then
                    done = true
                    return nil
                end
                continue
            end
            local chunk = pending
            pending = ""
            if wide then
                local keep = #chunk % 2
                -- A high surrogate at the end waits for its low half.
                if not finished and #chunk - keep >= 2 then
                    local u1, u2 = byte(chunk, #chunk - keep - 1, #chunk - keep)
                    local highByte = bigEndian and u1 or u2
                    if (highByte as integer) >= 0xD8 and (highByte as integer) <= 0xDB then
                        keep = keep + 2
                    end
                end
                if keep > 0 then
                    if finished then
                        failure("the UTF-16 document ends inside a character")
                    end
                    pending = sub(chunk, #chunk - keep + 1)
                    chunk = sub(chunk, 1, #chunk - keep)
                end
                if chunk ~= "" then
                    return utf16(chunk, bigEndian)
                end
            else
                return singleByte(chunk, name)
            end
        end
    end

    return produce, true
end
