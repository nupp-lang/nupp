--[[
Two profiling channels: one for where the time went, one for whether it went
there compiled.

```nupp:fragment
local profile = debug.profile

local session = profile.sample({intervalms = 5})
render()
local report = session:stop("profile.out")
print(report.samples, report.stacks)
```

`profile.sample` is the statistical sampler. A timer interrupts the program and
writes down where it was; what comes back is collapsed-stack text, the format
speedscope.app, FlameGraph.pl and inferno all read.

`profile.trace` watches the JIT give up. It aggregates trace aborts, so
blacklisted hot code, a bytecode the compiler will not record, and traces that
grew past a limit all become rows rather than silence. That is the question a
sampler cannot answer and the one that usually matters here: code the JIT
refused is an order of magnitude slower than code it took, and nothing says so
out loud.

Both channels attribute work through [](debug.profile.zone), so a sample or an
abort carries the zone path that was open when it happened. Both are
process-wide rather than per-coroutine, and at most one session of each kind
runs at a time.

Neither is free. A sample session pays a timer interrupt, a stack walk and a
table write at every interval; a trace session pays a callback at every abort,
inside the compiler. A session is a `own.Closeable`, so a local session closes
when its block ends. `stop` returns the report, and a session nothing stopped
is closed without one.

See [profiling.md](docs/learn/performance/profiling.md) for reading a report, and
[jit-trace-checking.md](docs/learn/performance/jit-trace-checking.md) for finding the same aborts without running
the program.
]]
module debug.profile

local zone = require("debug.profile.zone")
local profiler = require("jit.profile")
local jitutil = require("jit.util")
local vmdef = require("jit.vmdef")

--- What `profile.sample` collects, and how much of it. Every field is optional.
export type SampleOptions = {
    --- Milliseconds between samples; 10 by default, which is 100 a second. Must be
    --- between 1 and 2147483647, the range LuaJIT's profiler accepts. Below about 10
    --- the timer starts taking real time away from the thread it is measuring, so
    --- lower it for a short window and read the result knowing that it was paid for.
    intervalms: integer?,

    --- How many frames to walk per sample; 16 by default. Must be between 1 and
    --- 2147483647, the range LuaJIT's stack dumper accepts. The walk is linear in
    --- this and it happens on the interrupted thread, so raise it only when a
    --- specific question needs the depth.
    stackdepth: integer?,

    --- Keep only the samples taken under a zone path starting with this, so
    --- "frame/render" reads as that subtree alone.
    ---
    --- Applied at `stop` rather than while sampling: narrowing it costs nothing at
    --- runtime, and widening it afterwards is not possible, because the prefix is fixed
    --- when the session starts.
    zone: string?,

    --- The module the program starts at, as a stack frame names it. Everything below
    --- the outermost frame from it is dropped.
    ---
    --- A profiler samples the whole stack it is embedded in, and what is under the
    --- program, the loader that read it and the pcall that guards it, is not the
    --- program. Naming its module cuts the report back to it.
    ---
    --- Frames read "<module>:<name>", so the module is the part to give. A stack with
    --- no frame from it is kept whole rather than emptied, and two stacks that differ
    --- only below the root become one, their counts summed.
    root: string?
}

--- What `profile.trace` counts. Every field is optional.
export type TraceOptions = {
    --- Include the aborts that are ordinary trace formation rather than a refusal:
    --- leaving a loop, recursion, an inner loop. False by default; turn it on when the
    --- question is why a particular trace never formed.
    includebenign: boolean?
}

--- A running profiling session whose declaration chooses the report `stop` returns.
---
--- Sampling and trace-abort sessions share this lifecycle. Generic helpers can use
--- `S.Report` to preserve the concrete report chosen by a session declaration, and take
--- the session `borrows`. Each session is also a `own.Closeable`: `close`, which
--- lexical cleanup calls, ends one that nothing stopped without building a report, and
--- does nothing after `stop`. The two are separate so a helper bounded by this one can
--- still name `S.Report`.
export interface Session
    --- What `stop` returns, chosen by the session declaration rather than here.
    associated type Report

    --- Stops recording without ending the session. Idempotent.
    pause: function(self)

    --- Resumes recording. Idempotent.
    resume: function(self)

    --- Ends the session and returns what it saw, optionally writing it to a
    --- file.
    stop: function(self, filename: string?): self.Report
end

--- How much an abort is worth reading.
---
--- `blacklist` is always actionable: the code is demoted to the interpreter for the
--- rest of the process. `warn` is a refusal that may or may not sit on a hot path.
--- `info` is trace formation working as designed.
export type Severity = "blacklist" | "warn" | "info"

--- A distinct stack, and what landed on it.
---
--- A row of a `SampleReport`, built at `stop`. The five state counts sum to `count`.
export record Sample
    --- The zone path the samples were taken under, "" when none was open.
    zonepath: string

    --- The stack as `dumpstack` rendered it, ";" between frames, outermost first.
    stack: string

    --- Samples on this stack, in every VM state.
    count: integer

    --- Samples running compiled machine code.
    compiled: integer

    --- Samples in the interpreter.
    interpreted: integer

    --- Samples inside a C function.
    ccode: integer

    --- Samples in the garbage collector.
    collecting: integer

    --- Samples inside the JIT compiler itself.
    compiling: integer
end

--- Lua leaf samples attributed to a source line. Native VM states have no
--- reliable Lua location and are excluded.
export type SourceSample = {
    file: string,
    line: integer,
    samples: integer
}

--- What a sample session saw, as `SampleSession:stop` returns it.
---
--- `tostring` on it is the collapsed-stack text, so it prints and pipes directly.
export record SampleReport
    --- The interval the session ran at, so the sample counts can be read as time.
    intervalms: integer

    --- Samples recorded, after the zone filter.
    samples: integer

    --- Lua leaf locations, ordered by file and line. Their sum can be less than
    --- samples because native VM states have no reliable Lua source location.
    sourcesamples: {SourceSample}

    --- Distinct stacks they fell on.
    stacks: integer

    --- One line per stack: semicolon-separated frames, a space, then the sample count.
    --- Ordered by count descending. Empty when nothing was sampled, which a short
    --- session and a zone prefix that matched nothing both produce.
    text: string

    metamethod __tostring: function(self): string
end

--- A running sampler, as `profile.sample` returns it.
---
--- Live until `stop` or `close`, and there is at most one at a time. A local
--- session closes when its block ends, so the timer never outlives the question.
export record SampleSession is Session, own.Closeable
    associated type Report = SampleReport

    --- The interval it was started at.
    intervalms: integer

    --- The zone prefix `stop` will filter by, or nil for all of them.
    zonefilter: string?

    --- The module `stop` will cut the stacks back to, or nil to keep them whole.
    root: string?

    --- Whether recording is suspended. The timer keeps firing.
    paused: boolean

    --- Whether `stop` has run.
    stopped: boolean

    --- Samples so far, by zone path and then by stack. Two levels rather than one
    --- joined key, so a sample taken in a zone that has not changed since the last one
    --- costs a single table lookup.
    aggregate: {[string]: {[string]: Sample}}

    --- Lua leaf locations counted separately in each zone, before filtering.
    sourcesamples: {[string]: {[string]: integer}}

    pause: function(self)
    resume: function(self)
    stop: function(self, filename: string?): self.Report
    close: function(takes self: SampleSession): nil
end

--- A place the JIT gave up, and how often it did.
---
--- A row of a `TraceReport`, built at `stop`.
export record AbortSite
    --- How much it is worth reading.
    severity: Severity

    --- Times this exact severity, reason, location and zone fired.
    count: integer

    --- The reason, from `jit.vmdef.traceerr`. An unrecordable bytecode is rendered with
    --- the opcode's name.
    reason: string

    --- Stable compiler identity and classification for the raw VM reason above.
    reasonid: string

    --- What the identity is worth acting on: a `blocker` cannot record at all, a
    --- `risk` may or may not sit on a hot path, and a `stop` is trace formation
    --- working as designed.
    reasonclass: 'blocker' | 'risk' | 'stop'

    --- The VM's own text, before the registry mapped it.
    rawreason: string

    --- "<file>:<line>" of the function being recorded when it aborted.
    location: string

    --- Where the root trace began, including when recording entered a library.
    rootlocation: string?

    --- The zone path that was open, "" when none was.
    zonepath: string
end

--- The exact recorder configuration used to normalize a trace report.
---
--- Two reports are comparable when their `id` matches. A report taken under an
--- unsupported recorder still reads, but its reasons were mapped from a VM the
--- registry was not written against.
export record TraceProfile
    --- Every field below joined, which is what two reports are compared on.
    id: string

    --- The pinned LuaJIT commit, or "external:<version>" for any other build.
    luajitrevision: string

    --- The snapshot timestamp from the full version string.
    luajitversion: integer

    --- `jit.arch`.
    architecture: string

    --- `jit.os`.
    operatingsystem: string

    --- The recorder flags `jit.status` reported, sorted.
    enabledrecorderfeatures: {string}

    --- A digest of the VM's bytecode name table, so a renumbered opcode set is
    --- visible rather than silently remapped.
    bytecodeschema: string

    --- Whether this is the recorder the reason registry was written against.
    supported: boolean
end

-------------------------------------------------------------------------------
-- Trace reasons
-------------------------------------------------------------------------------

--- A stable reason the JIT declined to record, however it was observed.
---
--- `class` is what the reason is worth acting on: a `blocker` cannot record at
--- all, a `risk` may or may not sit on a hot path, and a `stop` is trace formation
--- working as designed. The three index fields are the routes to it, from a
--- bytecode name, from a static finding, and from the VM's own runtime text.
---
--- The recorder's strings are presentation, not API. An abort is interpreted under
--- the recorder that emitted it and mapped to one of these, and `nupp bc --check`,
--- `@jit` contracts and `nupp explain` read the same records, so a bytecode finding,
--- a contract error and an observed abort never acquire three explanations.
export type Reason = {
    id: string,
    class: 'blocker' | 'risk' | 'stop',
    opcodes: {[string]: boolean}?,
    source: {[string]: boolean}?,
    runtime: {string}?,
    explanation: string?,
    repair: string?,
    lint: string?,
    contractseverity: string?
}

--- The version of the reason catalog, bumped when a reader would misread it.
export const catalogversion = 1

--- The reason catalog's identity, which reports carry beside its version.
export const catalogid = "nupp-trace-reasons-v1"

local pinnedrev = "1edc3e52b67eaf6ce5f809be8e17d6862594b8bc"
local pinnedversion = 1785763465

local catalog: {
    Reason
} = {
    {
        id = "jit/tailcall-constructor",
        class = "risk",
        explanation = "a constructor in tail position can leave the root trace before its caller loop closes",
        repair = "bind the constructed result before returning it and inspect run --jit-aborts",
    },
    {
        id = "jit/loop-function-construction",
        class = "blocker",
        opcodes = {FNEW = true},
        source = {["jit-loop-closure"] = true, ["loop-invariant-closure"] = true},
        explanation = "LuaJIT has no recorder for constructing a function",
        repair = "declare one function outside the loop and pass what varies to it",
        lint = "NUPP2515",
        contractseverity = "error",
    },
    {
        id = "jit/loop-upvalue-close",
        class = "blocker",
        opcodes = {UCLO = true},
        explanation = "LuaJIT has no recorder for closing an upvalue",
        repair = "move the captured lifetime outside the repeated region",
        contractseverity = "error",
    },
    {
        id = "jit/ffi-vararg-policy",
        class = "risk",
        source = {["jit-boundary"] = true},
        explanation = "this variadic FFI form depends on argument types and the target ABI",
        repair = "move the call behind an explicit jit.off boundary when it is not a hot operation",
        lint = "NUPP2514",
        contractseverity = "error",
    },
    {
        id = "jit/ffi-callback",
        class = "risk",
        source = {["jit-callback"] = true},
        explanation = "a C call that re-enters Lua through this callback cannot remain on a trace",
        repair = "disable the callback and its calling boundary with jit.off",
        lint = "NUPP2502",
        contractseverity = "error",
    },
    {
        id = "jit/disabled-callee",
        class = "blocker",
        explanation = "the resolved callee is explicitly disabled with jit.off",
        repair = "remove @jit from the caller or keep the disabled call outside its checked hot path",
        contractseverity = "error",
    },
    {
        id = "jit/dynamic-call",
        class = "risk",
        explanation = "the call target is dynamic, so its bytecode recordability is unknown",
    },
    {id = "jit/expected-loop-leave", class = "stop", runtime = {"leaving loop in root trace"}},
    {id = "jit/expected-inner-loop", class = "stop", runtime = {"inner loop in root trace"}},
    {id = "jit/expected-down-recursion", class = "stop", runtime = {"down-recursion, restarting"}},
    {id = "jit/expected-up-recursion", class = "stop", runtime = {"up-recursion"}},
    {id = "jit/retry-recording", class = "stop", runtime = {"retry recording"}},
    {id = "jit/runtime-blacklisted", class = "risk", runtime = {"blacklisted"}},
    {id = "jit/runtime-trace-too-short", class = "stop", runtime = {"trace too short"}},
    {id = "jit/runtime-trace-too-long", class = "risk", runtime = {"trace too long"}},
    {id = "jit/runtime-trace-too-deep", class = "risk", runtime = {"trace too deep"}},
    {id = "jit/runtime-too-many-snapshots", class = "risk", runtime = {"too many snapshots"}},
    {id = "jit/runtime-loop-unroll-limit", class = "risk", runtime = {"loop unroll limit reached"}},
    {id = "jit/runtime-call-unroll-limit", class = "risk", runtime = {"call unroll limit reached"}},
    {id = "jit/runtime-disabled-callee", class = "blocker", runtime = {"JIT compilation disabled for function"}},
    {id = "jit/runtime-ffi-call", class = "risk", runtime = {"NYI: unsupported C function type"}},
    {id = "jit/runtime-ffi-conversion", class = "risk", runtime = {"NYI: unsupported C type conversion"}},
    {id = "jit/runtime-type-instability", class = "risk", runtime = {"persistent type instability"}},
    {
        id = "jit/runtime-machine-code-limit",
        class = "risk",
        runtime = {"machine code too long", "hit mcode limit (retrying)", "failed to allocate mcode memory",}
    },
    {id = "jit/runtime-recorder-error", class = "risk", runtime = {"error thrown or hook called during recording"}},
    {id = "jit/runtime-unknown", class = "risk"},
}

local byid, byopcode, bysource, bytext = {}, {}, {}, {}
for _, record in ipairs(catalog) do
    byid[record.id] = record
    for opcode in pairs(record.opcodes or {}) do
        byopcode[opcode] = record
    end
    for source in pairs(record.source or {}) do
        bysource[source] = record
    end
    for _, format in ipairs(record.runtime or {}) do
        bytext[format] = record
    end
end

-- FNV-1a over 32 bits. The prime 16777619 is 2^24 + 2^8 + 0x93 and is multiplied in
-- those pieces: each product fits a double's mantissa, where the direct multiply can
-- exceed it and lose exactly the low bits `tobit` keeps. `tohex` because "%08x" widens
-- a negative word to sixteen digits.
local function fnv(value: string): string
    local digest = bit.tobit(2166136261)
    for index = 1, #value do
        local mixed = bit.bxor(digest, value:byte(index))
        digest = bit.tobit(bit.lshift(mixed, 24) + bit.lshift(mixed, 8) + mixed * 0x93)
    end

    return bit.tohex(digest)
end

--- Describes the recorder this process is running.
---
--- @return the profile every event from this process is interpreted under
export function recorder(): TraceProfile
    local status = {jit.status()}
    local flags = {}
    for index = 2, #status do
        flags[#flags + 1] = tostring(status[index])
    end
    table.sort(flags)
    -- `jit.version_num` is the compatibility number (20199 for every current 2.1
    -- snapshot). The pinned snapshot identity is the timestamp suffix exposed in the
    -- full version string.
    local version = math.floor(tonumber(jit.version:match("LuaJIT 2%.1%.(%d+)")) or jit.version_num) as integer
    local revision = version == pinnedversion and pinnedrev or "external:" .. tostring(version)
    local schema = fnv(vmdef.bcnames)

    return TraceProfile(
        id = table.concat({revision, jit.arch, jit.os, table.concat(flags, ","), schema}, "|"),
        luajitrevision = revision,
        luajitversion = version,
        architecture = jit.arch,
        operatingsystem = jit.os,
        enabledrecorderfeatures = flags,
        bytecodeschema = schema,
        supported = revision == pinnedrev
    )
end

--- Returns the reason filed under a stable identity.
---
--- @param id the identity, as a report or a diagnostic carries it
--- @return the reason, or nil when nothing is filed under it
export function reason(id: string): Reason?
    return byid[id]
end

--- Returns the reason for a bytecode LuaJIT has no recorder for.
---
--- @param opcode the bytecode's name, as `opname` renders it
--- @return the reason, or nil when that bytecode records
export function foropcode(opcode: string): Reason?
    return byopcode[opcode]
end

--- Returns the reason a static finding maps to.
---
--- This is what keeps a checker finding and an observed abort from explaining the
--- same thing two different ways.
---
--- @param source the static finding's name
--- @return the reason, or nil when the finding has no runtime counterpart
export function forsource(source: string): Reason?
    return bysource[source]
end

--- Renders a bytecode number as the name LuaJIT knows it by.
---
--- @param opcode the number the VM reported
--- @return the trimmed name
export function opname(opcode: integer): string
    local start = opcode * 6 + 1
    return (vmdef.bcnames:sub(start, start + 5):gsub("%s+$", ""))
end

--- Interprets a raw abort the VM reported.
---
--- An abort naming an unrecordable bytecode is routed by that opcode rather
--- than by its text, so it lands on the same reason a static check would have
--- found. Anything unrecognized returns `jit/runtime-unknown` rather than
--- nothing.
---
--- @param code the VM's trace error number, or nil
--- @param arg whatever the VM passed beside it
--- @return the reason it maps to
--- @return the rendered text, for display
export function abort(code: integer?, arg: number | string | nil): (Reason, string)
    if not code then
        return byid["jit/runtime-unknown"], "abort"
    end
    local format = vmdef.traceerr[code]
    if not format then
        return byid["jit/runtime-unknown"], "error " .. tostring(code)
    end
    if format:find("NYI: bytecode", 1, true) and type(arg) == "number" then
        local op = opname(arg as integer)
        return byopcode[op] or byid["jit/runtime-unknown"], "NYI: bytecode " .. op
    end
    local record = bytext[format] or byid["jit/runtime-unknown"]
    if arg == nil then
        return record, format
    end
    local ok, detail = pcall(string.format, format, arg)

    return record, ok and detail as string or format
end

--- Returns every reason, in catalog order.
---
--- The list is a copy, so a caller sorting or filtering it cannot disturb the
--- catalog the checker reads.
---
--- @return one entry per known reason
export function reasons(): {Reason}
    local copy = {}
    for index, record in ipairs(catalog) do
        copy[index] = record
    end

    return copy
end

--- What a trace session saw, as `TraceSession:stop` returns it.
---
--- `tostring` on it renders `sites` as RFC 4180 CSV, so it prints, sorts and diffs
--- directly.
export record TraceReport
    --- Wallclock seconds the session was active, in whole seconds: it comes from
    --- `os.time`, so a session shorter than one reads as zero and dividing by it is the
    --- caller's problem.
    durationsec: integer

    --- Abort events recorded. Excludes the benign ones unless `includebenign` was set.
    totalaborts: integer

    --- Blacklist events among them. Always actionable.
    blacklisted: integer

    --- One row per distinct severity, reason, location and zone. Ordered by severity,
    --- then by count descending.
    sites: {AbortSite}

    --- The recorder and registry identities under which the events were interpreted.
    traceprofile: TraceProfile

    --- The reason registry the identities came from.
    reasoncatalogid: string

    --- Its version, so a stored report can be reread under a later one.
    reasoncatalogversion: integer

    metamethod __tostring: function(self): string
end

--- A running trace-abort collector, as `profile.trace` returns it.
---
--- Live until `stop` or `close`, and there is at most one at a time. A local
--- session closes when its block ends, so the event hook never outlives the question.
export record TraceSession is Session, own.Closeable
    associated type Report = TraceReport

    --- Whether the benign trace-formation events are being counted.
    includebenign: boolean

    --- `os.time` when the session started.
    startedat: integer

    --- Whether aggregation is suspended. The hook stays attached.
    paused: boolean

    --- Whether `stop` has run.
    stopped: boolean

    --- Aborts so far, by severity, reason, location and zone joined.
    sites: {[string]: AbortSite}

    --- Aborts counted so far.
    totalaborts: integer

    --- Blacklist events among them.
    blacklisted: integer

    traceprofile: TraceProfile

    --- The handler to hand back to `jit.attach` to detach it. Dropping the last
    --- reference to a handler does not remove it.
    callback: function(...: any)

    pause: function(self)
    resume: function(self)
    stop: function(self, filename: string?): self.Report
    close: function(takes self: TraceSession): nil
end

-------------------------------------------------------------------------------
-- Shared
-------------------------------------------------------------------------------

-- Writes `text` to `path`, replacing whatever was there. Raised errors carry the path,
-- since the caller passed a name and a failure that does not repeat it says nothing
-- about which name was wrong.
local function save(path: string, text: string)
    local file, openerr = io.open(path, "wb")
    if not file then
        error("nupp: cannot write the profile report '" .. path .. "': " .. (openerr or "unknown"), 3)
    end
    local written, writeerr = file:write(text)
    if not written then
        file:close()
        error("nupp: cannot write the profile report '" .. path .. "': " .. (writeerr or "unknown"), 3)
    end
    local closed, closeerr = file:close()
    if not closed then
        error("nupp: cannot close the profile report '" .. path .. "': " .. (closeerr or "unknown"), 3)
    end
end

-------------------------------------------------------------------------------
-- Sampling
-------------------------------------------------------------------------------

-- The zone path and the stack are joined with ";" and "/" respectively, and a
-- collapsed-stack line ends at its first newline, so a frame carrying either would be
-- read as two frames or as two lines. Nothing legitimately names a function this way;
-- what does is a chunk loaded from a string.
local function sanitize(frame: string): string
    return (frame:gsub("[;/\n\r]", "_"))
end

-- Appends the pieces of `text`, split on `separator`, to `frames`. Empty pieces are
-- dropped: a zone path is "" when no zone is open, and dumpstack can render a frame it
-- has no name for as nothing at all.
local function append(frames: {string}, text: string, separator: string)
    if text == "" then
        return
    end

    local pattern = "[^" .. separator .. "]+"
    for piece in text:gmatch(pattern) do
        frames[#frames + 1] = sanitize(piece)
    end
end

-- Collapsed-stack text: one line per stack, frames separated by ";", then a space and
-- the sample count. The zone path leads, so a flame graph opens on the zones and drills
-- into the code beneath each.
--
-- Each row carries its VM state as a "_[N]" suffix, the convention FlameGraph
-- and speedscope already colour on. The letters are LuaJIT's own: N compiled, I
-- interpreted, C in a C function, G collecting, J compiling.
local function collapse(samples: {Sample}): string
    if #samples == 0 then
        return ""
    end

    table.sort(samples, function(a: Sample, b: Sample): boolean
        if a.count ~= b.count then
            return a.count > b.count
        end
        if a.zonepath ~= b.zonepath then
            return a.zonepath < b.zonepath
        end

        return a.stack < b.stack
    end)

    local lines: {string} = {}
    for index = 1, #samples do
        local sample = samples[index]
        local frames: {string} = {}
        append(frames, sample.zonepath, "/")
        append(frames, sample.stack, ";")
        if #frames == 0 then
            frames[1] = "<root>"
        end
        -- A stack may have samples in several VM states. Preserve each count:
        -- assigning the dominant state to the whole stack hides GC and C work.
        local states = {
            N = sample.compiled,
            I = sample.interpreted,
            C = sample.ccode,
            G = sample.collecting,
            J = sample.compiling
        }
        for _, state in ipairs({"N", "I", "C", "G", "J"}) do
            local count = states[state]
            if count > 0 then
                local prefix = table.concat(frames, ";")
                if state == "C" or state == "G" or state == "J" then
                    -- VM state was captured at the interrupt, but the stack is
                    -- inspected later. Native/GC/JIT work must not inherit that
                    -- later Lua callback's frames.
                    local zones: {string} = {}
                    append(zones, sample.zonepath, "/")
                    zones[#zones + 1] = "<" .. (state == "G" and "GC" or state == "J" and "JIT" or "C") .. ">"
                    prefix = table.concat(zones, ";")
                end
                lines[#lines + 1] = prefix .. "_[" .. state .. "] " .. string.format("%d", count)
            end
        end
    end

    return table.concat(lines, "\n")
end

-- Everything below the outermost frame belonging to `root` is what started the program
-- rather than the program. Frames read "<module>:<name>", so the module is matched at a
-- frame boundary; a substring match anywhere would cut a stack at a function that
-- merely mentions the name.
--
-- A stack with no frame from `root` was taken before the program was entered or
-- after it returned -- while this command was still loading its own modules, say.
-- It used to be left whole, on the grounds that the frames it has are the frames
-- it had. But they are this command's frames, and a report about somebody's
-- program is the one place they do not belong: whether any appear at all then
-- depends on where a millisecond timer happened to land.
--
-- So the time is kept and the frames are not. One name says the sample was
-- outside the program without saying what this command was doing at the time.
local OUTSIDE_ROOT = "<outside>"

local function trimroot(stack: string, root: string): string
    local prefix = root .. ":"
    local from = 1
    while from <= #stack do
        if stack:sub(from, from + #prefix - 1) == prefix then
            return stack:sub(from)
        end
        local at = stack:find(";", from, true)
        if not at then
            break
        end
        from = at + 1
    end

    return OUTSIDE_ROOT
end

-- One session at a time: the profiler is a process-wide singleton, and starting a
-- second would silently replace the first's callback while its handle still looked
-- live.
local sampling = false

-- LuaJIT's POSIX sampler is SIGPROF plus an interval timer, and it arms the timer
-- before it installs the handler, then at teardown disarms the timer before it
-- puts the old handler back. SIGPROF's default action terminates the process, so
-- a sample landing in either window kills the process outright rather than being
-- recorded -- which is what a host reporting "Profiling timer expired" and a
-- worker dead at signal 27 has just watched happen. At one millisecond a suite
-- offers those windows a few thousand chances.
--
-- Neither window can be closed from here, but both can be made harmless: with
-- the disposition already SIG_IGN, an early sample is ignored, and it is SIG_IGN
-- that LuaJIT saves and restores around its own handler, so a late one is
-- ignored too. Put the real disposition back afterwards, since leaving a process
-- unable to be profiled by anything else is not this module's decision to make.
local mute, unmute = nil, nil
do
    local loaded, ffi = pcall(require, "ffi")
    if loaded and package.config:sub(1, 1) ~= "\\" then
        -- Declared here rather than trusted to exist: another module may have
        -- declared it already, which raises rather than answering.
        pcall((ffi as any).cdef, "void (*signal(int, void (*)(int)))(int);")
        local reachable, signal = pcall(function(): any
            return (ffi as any).C.signal
        end)
        if reachable and signal ~= nil then
            -- SIGPROF is 27 on every platform this runs a sampler on.
            local SIGPROF, SIG_IGN = 27, (ffi as any).cast("void (*)(int)", 1)
            -- Held with a flag of its own rather than tested for nil. The
            -- disposition that has to be put back is usually the default, which
            -- is a null function pointer, and a null pointer compares equal to
            -- nil -- so a restore guarded on the pointer would skip exactly the
            -- case it exists for and leave the process unable to be profiled.
            local previous: any = nil
            local captured = false
            mute = function(): nil
                local ok, was = pcall(signal as any, SIGPROF, SIG_IGN)
                previous, captured = was, ok
            end
            unmute = function(): nil
                if captured then
                    pcall(signal as any, SIGPROF, previous)
                    previous, captured = nil, false
                end
            end
        end
    end
end

-- Ends a sample session's recording: what `stop` does before it builds the report,
-- and all that `close` does.
local function haltsample(borrows session: SampleSession): nil
    session.stopped = true
    profiler.stop()
    if unmute ~= nil then
        unmute()
    end
    sampling = false
    zone.release()
end

--- Starts sampling.
---
--- ```nupp:fragment
--- local session = profile.sample({intervalms = 5, zone = "frame/render"})
--- render()
--- local report = session:stop("render.collapsed")
--- print(report.samples, report.stacks)
--- ```
---
--- @param options omitted samples every zone at 10 ms to a depth of 16
--- @return the handle whose `stop` produces the report
--- @raises string when a sample session is already running or an option is out of range
export function sample(options: SampleOptions?): SampleSession
    if sampling then
        error("nupp: a sample session is already running; stop it first", 2)
    end

    local opts: SampleOptions = options or {}
    local intervalms = opts.intervalms or 10
    if intervalms < 1 or intervalms > 2147483647 then
        error("nupp: a sample session's intervalms must be between 1 and 2147483647", 2)
    end
    local stackdepth = opts.stackdepth or 16
    if stackdepth < 1 or stackdepth > 2147483647 then
        error("nupp: a sample session's stackdepth must be between 1 and 2147483647", 2)
    end

    local owned = SampleSession(
        intervalms = intervalms,
        zonefilter = opts.zone,
        root = opts.root,
        paused = false,
        stopped = false,
        aggregate = {},
        sourcesamples = {}
    )
    -- The sampler's callback reads the session for as long as it runs, while the
    -- caller holds the one obligation to close it.
    local session: any = @unsafe own.release(owned)

    -- Negative, so the walk runs outermost frame first: that is the order a collapsed
    -- stack is written in, and reversing it here would mean building a list per sample
    -- on the interrupted thread.
    local walk = -stackdepth
    local aggregate = session.aggregate
    -- The zone path is a string the zone module holds onto until the stack changes, so
    -- consecutive samples in one zone hit the same table entry without hashing a fresh
    -- key.
    local lastpath = ""
    local laststacks: {[string]: Sample} = {}
    aggregate[lastpath] = laststacks

    local function record(thread: any, samples: integer, vmstate: string)
        if session.paused then
            return
        end

        local path = zone.path()
        if path ~= lastpath then
            local stacks = aggregate[path]
            if not stacks then
                stacks = {}
                aggregate[path] = stacks
            end
            lastpath, laststacks = path, stacks
        end

        -- Only meaningful for the thread this callback was handed, and only while it is
        -- running.
        local stack = thread and profiler.dumpstack(thread, "FZ;", walk) or ""
        local sample = laststacks[stack]
        if not sample then
            sample = Sample(
                zonepath = path,
                stack = stack,
                count = 0,
                compiled = 0,
                interpreted = 0,
                ccode = 0,
                collecting = 0,
                compiling = 0
            )
            laststacks[stack] = sample
        end

        if thread and (vmstate == "N" or vmstate == "I") then
            -- Preserve paths and lines independently of the flamegraph's names.
            local location = profiler.dumpstack(thread, "pl", 1)
            local locations = session.sourcesamples[path]
            if not locations then
                locations = {}
                session.sourcesamples[path] = locations
            end
            locations[location] = (locations[location] or 0) + samples
        end
        sample.count = sample.count + samples
        if vmstate == "N" then
            sample.compiled = sample.compiled + samples
        elseif vmstate == "I" then
            sample.interpreted = sample.interpreted + samples
        elseif vmstate == "C" then
            sample.ccode = sample.ccode + samples
        elseif vmstate == "G" then
            sample.collecting = sample.collecting + samples
        elseif vmstate == "J" then
            sample.compiling = sample.compiling + samples
        end
    end

    zone.acquire()
    if mute ~= nil then
        mute()
    end
    -- "l" keys the sampler on the source line, which is the finest thing it coalesces
    -- on: consecutive samples sharing a key arrive as one call carrying their count, so
    -- anything coarser would attribute a run of samples to whichever stack the last of
    -- them was on. "i<n>" is the interval. The stack and the VM state arrive either
    -- way.
    profiler.start("li" .. string.format("%d", intervalms), record)
    sampling = true

    return session as SampleSession
end

--- Stops recording without ending the session. The timer keeps firing, at the cost of
--- one test per sample, and what was recorded on either side of the pause is kept,
--- which is how a benchmark leaves its setup out.
---
--- Idempotent.
---
--- @raises string once the session has stopped
function SampleSession:pause()
    if self.stopped then
        error("nupp: the sample session has already stopped", 2)
    end
    self.paused = true
end

--- Resumes recording. Idempotent.
---
--- @raises string once the session has stopped
function SampleSession:resume()
    if self.stopped then
        error("nupp: the sample session has already stopped", 2)
    end
    self.paused = false
end

--- Ends the session and reports what it saw.
---
--- @param filename also write the collapsed-stack text there, replacing
---     whatever was in it
--- @return the report, whose `tostring` is that same text
--- @raises string once the session has stopped, so it cannot be called twice
function SampleSession:stop(filename: string?): SampleReport
    if self.stopped then
        error("nupp: the sample session has already stopped", 2)
    end
    haltsample(self)

    local prefix = self.zonefilter
    -- The filter names a subtree, so a match has to end at a path component:
    -- "frame/render" keeps "frame/render/sprites" and not the sibling
    -- "frame/renderer", which merely shares the characters.
    local subtree = (prefix or "") .. "/"
    local root = self.root
    local kept: {Sample} = {}
    local samples: integer = 0
    -- Trimming can bring two stacks together, when what they differed in was only what
    -- started them, so the rows are merged rather than the first one standing for both.
    -- The key holds a NUL because a zone name and a frame can hold anything else.
    local merged: {[string]: Sample} = {}
    for path, stacks in pairs(self.aggregate) do
        if not prefix or path == prefix or path:sub(1, #subtree) == subtree then
            for _, seen in pairs(stacks) do
                samples = samples + seen.count
                local stack = root and trimroot(seen.stack, root) or seen.stack
                local row = merged[path .. "\0" .. stack]
                if not row then
                    row = Sample(
                        zonepath = path,
                        stack = stack,
                        count = 0,
                        compiled = 0,
                        interpreted = 0,
                        ccode = 0,
                        collecting = 0,
                        compiling = 0
                    )
                    merged[path .. "\0" .. stack] = row
                    kept[#kept + 1] = row
                end
                row.count = row.count + seen.count
                row.compiled = row.compiled + seen.compiled
                row.interpreted = row.interpreted + seen.interpreted
                row.ccode = row.ccode + seen.ccode
                row.collecting = row.collecting + seen.collecting
                row.compiling = row.compiling + seen.compiling
            end
        end
    end

    local counts: {[string]: integer} = {}
    for path, locations in pairs(self.sourcesamples) do
        if not prefix or path == prefix or path:sub(1, #subtree) == subtree then
            for location, count in pairs(locations) do
                counts[location] = (counts[location] or 0) + count
            end
        end
    end
    local sourcesamples: {SourceSample} = {}
    for location, count in pairs(counts) do
        local file, at = location:match("^(.*):(%d+)$")
        local line = tonumber(at)
        if file and line and line > 0 then
            sourcesamples[#sourcesamples + 1] = {file = file, line = line as integer, samples = count}
        end
    end
    table.sort(sourcesamples, function(a: SourceSample, b: SourceSample): boolean
        if a.file ~= b.file then
            return a.file < b.file
        end
        return a.line < b.line
    end)
    local report = SampleReport(
        intervalms = self.intervalms,
        sourcesamples = sourcesamples,
        samples = samples,
        stacks = #kept,
        text = collapse(kept)
    )
    if filename then
        save(filename, report.text)
    end

    return report
end

-------------------------------------------------------------------------------
-- Trace aborts
-------------------------------------------------------------------------------

local function classify(text: string, reasonclass: string): Severity
    if text:find("blacklist", 1, true) then
        return "blacklist"
    end
    if reasonclass == "stop" then
        return "info"
    end

    return "warn"
end

local function rank(severity: Severity): integer
    if severity == "blacklist" then
        return 0
    elseif severity == "warn" then
        return 1
    else
        return 2
    end
end

-- Lua prefixes a file source with "@", and the function descriptions inherit it. Strip
-- it so a row reads "path:line". A source that is not a file, "[C]" or a loaded string,
-- does not carry the prefix and is left as it is.
local function trimsource(source: string): string
    if source:sub(1, 1) == "@" then
        return source:sub(2)
    end
    return source
end

-- Where the compiler was when it gave up. `funcinfo` knows the bytecode position, so it
-- can name the line inside the function rather than the line the function started on;
-- `debug.getinfo` is the fallback for the case where it answers nothing useful.
local function locate(func: any, pc: any): string
    if func then
        local ok, info = pcall(jitutil.funcinfo, func, pc as integer)
        if ok and info then
            local described = info as {[string]: any}
            local source = described.short_src or described.source or "?"
            local line = described.currentline or described.linedefined or 0
            return string.format("%s:%d", trimsource(source as string), line as integer)
        end
    end
    if type(func) == "function" then
        local info = debug.getinfo(func, "S")
        return string.format(
            "%s:%d",
            trimsource(info and info.short_src or "?"),
            (info and info.linedefined or 0) as integer
        )
    end

    return "?:0"
end

-- RFC 4180: a field holding a comma, a quote or a line break is quoted, and an embedded
-- quote is doubled. In practice only `reason` ever needs it.
local function quote(text: string): string
    if text:find("[,\"\n\r]") then
        return "\"" .. text:gsub("\"", "\"\"") .. "\""
    end
    return text
end

local function tocsv(report: TraceReport): string
    local lines: {string} = {"severity,count,reason,location,zone,rootLocation"}
    for index = 1, #report.sites do
        local site = report.sites[index]
        lines[
            #lines + 1
        ] = table.concat(
            {
                site.severity,
                string.format("%d", site.count),
                quote(site.reason),
                quote(site.location),
                quote(site.zonepath),
                quote(site.rootlocation or site.location),
            },
            ","
        )
    end

    return table.concat(lines, "\n")
end

-- A record's namespace table is the metatable its instances are stamped with, so
-- installing a declared contract is an ordinary assignment to it. The cast is because
-- the contract is not a field: see
-- [metamethods.md](docs/learn/language/metamethods.md).
(TraceReport as {[string]: any}).__tostring = tocsv;

(SampleReport as {[string]: any}).__tostring = function(report: SampleReport): string
    return report.text
end

local tracing = false

--- Ends the session without a report, as lexical cleanup does.
---
--- Does nothing once `stop` has run, so a block that stopped its session to read the
--- report closes it for free.
function SampleSession.close(takes self: SampleSession): nil
    if not self.stopped then
        haltsample(self)
    end
end

-- Ends a trace session's counting: what `stop` does before it builds the report, and
-- all that `close` does.
local function halttrace(borrows session: TraceSession): nil
    session.stopped = true
    -- No event names the handler to remove.
    jit.attach(session.callback)
    tracing = false
    zone.release()
end

--- Starts collecting trace aborts.
---
--- ```nupp:fragment
--- local session = profile.trace()
--- render()
--- local report = session:stop("aborts.csv")
--- print(report.blacklisted, report.totalaborts)
--- ```
---
--- @param options omitted leaves the benign trace-formation events out
--- @return the handle whose `stop` produces the report
--- @raises string when a trace session is already running
export function trace(options: TraceOptions?): TraceSession
    if tracing then
        error("nupp: a trace session is already running; stop it first", 2)
    end

    local opts: TraceOptions = options or {}
    local owned = TraceSession(
        includebenign = opts.includebenign or false,
        startedat = os.time() as integer,
        paused = false,
        stopped = false,
        sites = {},
        totalaborts = 0,
        blacklisted = 0,
        traceprofile = recorder(),
        callback = function()
        end
    )
    -- The hook reads the session for as long as it is attached, while the caller holds
    -- the one obligation to close it.
    local session: any = @unsafe own.release(owned)

    -- Variadic because `jit.attach` hands each event its own arguments; a "trace"
    -- event's are what this unpacks. Trace numbers connect side traces to their
    -- root; persistent site identities use locations rather than attempt numbers.
    local roots = {}

    local function onevent(...: any)
        local what, tracenum, func, pc, errcode, errarg = ...
        if what == "start" then
            if session.paused or roots[errcode] == false then
                roots[tracenum] = false
            else
                roots[tracenum] = roots[errcode] or locate(func, pc)
            end
            return
        elseif what == "flush" then
            roots = {}
            return
        end
        if what ~= "abort" or session.paused or roots[tracenum] == false then
            return
        end

        local code = type(errcode) == "number" and errcode as integer or nil
        local detail = (type(errarg) == "number" or type(errarg) == "string") and errarg or nil
        local entry, text = abort(code, detail)
        local severity = classify(text, entry.class)
        if severity == "info" and not session.includebenign then
            return
        end

        session.totalaborts = session.totalaborts + 1
        if severity == "blacklist" then
            session.blacklisted = session.blacklisted + 1
        end

        local location = locate(func, pc)
        local path = zone.path()
        local rootlocation = roots[tracenum] or location
        local key = severity .. "|" .. text .. "|" .. rootlocation .. "|" .. location .. "|" .. path
        local site = session.sites[key]
        if site then
            site.count = site.count + 1
        else
            session.sites[
                key
            ] = AbortSite(
                severity = severity,
                count = 1,
                reason = text,
                reasonid = entry.id,
                reasonclass = entry.class,
                rawreason = text,
                location = location,
                rootlocation = rootlocation,
                zonepath = path
            )
        end
    end

    session.callback = onevent
    zone.acquire()
    jit.attach(onevent, "trace")
    tracing = true

    return session as TraceSession
end

--- Stops counting without ending the session. The hook stays attached, at the cost of
--- one test per abort, and what was counted on either side of the pause is kept.
---
--- Idempotent.
---
--- @raises string once the session has stopped
function TraceSession:pause()
    if self.stopped then
        error("nupp: the trace session has already stopped", 2)
    end
    self.paused = true
end

--- Resumes counting. Idempotent.
---
--- @raises string once the session has stopped
function TraceSession:resume()
    if self.stopped then
        error("nupp: the trace session has already stopped", 2)
    end
    self.paused = false
end

--- Ends the session and reports what it saw.
---
--- @param filename also write the CSV there, replacing whatever was in it
--- @return the report, whose `tostring` is that CSV
--- @raises string once the session has stopped, so it cannot be called twice
function TraceSession:stop(filename: string?): TraceReport
    if self.stopped then
        error("nupp: the trace session has already stopped", 2)
    end
    halttrace(self)

    local sites: {AbortSite} = {}
    for _, site in pairs(self.sites) do
        sites[#sites + 1] = site
    end
    table.sort(sites, function(a: AbortSite, b: AbortSite): boolean
        local left, right = rank(a.severity), rank(b.severity)
        if left ~= right then
            return left < right
        end
        if a.count ~= b.count then
            return a.count > b.count
        end
        if a.reason ~= b.reason then
            return a.reason < b.reason
        end

        return a.location < b.location
    end)

    local report = TraceReport(
        durationsec = (os.time() as integer) - self.startedat,
        totalaborts = self.totalaborts,
        blacklisted = self.blacklisted,
        sites = sites,
        traceprofile = self.traceprofile,
        reasoncatalogid = catalogid,
        reasoncatalogversion = catalogversion
    )
    if filename then
        save(filename, tostring(report))
    end

    return report
end

--- Ends the session without a report, as lexical cleanup does.
---
--- Does nothing once `stop` has run, so a block that stopped its session to read the
--- report closes it for free.
function TraceSession.close(takes self: TraceSession): nil
    if not self.stopped then
        halttrace(self)
    end
end
