--[[
`debug.bench` measures code from inside an ordinary program.
A benchmark links this module, runs under `nupp run`, and reports its own cases:

```nupp:fragment
local bench = debug.bench

local function sized(b: debug.bench.Case): nil
    for _ = 1, b.n do
        bench.keep(point())
    end
end

bench.case("presize.sized", sized)
bench.report()
```

The library and `nupp bench` have different jobs. An application's hot loop
lives in the application, so only something the loop can call can measure it.
The command discovers those programs and gives each named case an isolated
process.

`report` raises rather than returning a status, because a chunk's return value
is discarded and a run that did not raise exits zero. It writes the record
first, so a case that trips the gate is still a case whose record the runner can
merge.
]]
module debug.bench

local json = require("serde.json")
local profile = require("debug.profile")
local statistics = require("nupp.bench.internal.statistics")
local recordio = require("nupp.bench.internal.record")

--- The schema version of a written record. Bumped when a reader would otherwise
--- misread an older file, and checked where a baseline is read.
---
--- Four records every duration in milliseconds, as the rest of the runtime does, where
--- three recorded seconds. Three added per-measurement samples on the case path,
--- within-process dispersion, trend and outlier classification, and a runner-side
--- document holding one record per fork.
---
--- An older record still reads as a baseline for the deterministic counters: version
--- two and three records carry no duration in the fields this version reads, so every
--- duration verdict against one is inconclusive rather than an error. Any other schema
--- is refused.
export const schema = 4

--- The oldest schema a standalone program still reads as a baseline.
export const oldest = 2

--- Rounds timed per case. The median of these is what a record reports, so an odd
--- count has a middle to take.
local ROUNDS: integer = 7

--- Milliseconds a calibrated round should take. Long enough that the clock's
--- resolution is not the measurement, short enough that seven of them are not a wait.
local TARGET_ROUND_MS = 50.0

--- Iterations calibration will not exceed, so a body that is somehow free terminates.
local MAX_N = 1 << 30

----------------------------------------------------------------------------
-- The sink
----------------------------------------------------------------------------

--- Where `keep` stores. A table field rather than an upvalue, so the store crosses
--- the module boundary, which is what makes the value escape, and so a `keep` lowered
--- inline elsewhere in the program writes the same slot this file does; see `keep`.
--- Not part of the documented API; `keep` is.
--- @internal
export const sink: {value: any} = {value = nil}

--- Keeps a value the measured body produced, so the work that produced it survives.
---
--- This is the one rule writing a case requires. LuaJIT removes work whose result does
--- not escape its trace, which is correct and is also the most common way a benchmark
--- comes out impossibly fast: the loop under test is deleted and the measurement is of
--- nothing.
---
--- The store is to a field of this module's `sink`, which is visible outside any trace
--- and so cannot be sunk. Nothing checks that this stays true of LuaJIT; a collapse in
--- the reported durations is the only signal, which is why it is worth reading them.
---
--- Called in statement position on a receiver statically known to be this module,
--- this is generated inline as that store rather than called.
---
--- @param value whatever the measured body produced
export function keep(value: any): nil
    sink.value = value
end

----------------------------------------------------------------------------
-- Records
----------------------------------------------------------------------------

--- A case handed to a measured body.
export record Case
    --- The case's name, as `case` was given it.
    name: string

    --- Iterations the body is to run. Fixed before the measured rounds begin, and
    --- carried in the record, so a comparison can re-run the same work.
    n: integer
end

--- An expanded suite case handed to setup, run and teardown callbacks.
export record Invocation
    --- The unqualified case name from the suite declaration.
    name: string

    --- Case-specific data supplied by the declaration.
    data: any

    --- One value for each parameter in the expanded case.
    parameters: {[string]: any}
end

--- An implementation of every case in a suite.
export type Variant = {
    name: string,
    setup: (function(Invocation): any)?,
    run: function(any, Invocation): any,
    teardown: (function(any, Invocation): nil)?
}

--- A workload in a suite. Parameter lists are expanded as a Cartesian product.
export type SuiteCase = {
    name: string,
    data: any?,
    parameters: {[string]: {any}}?,

    --- Operations represented by a call to a variant's `run` callback.
    operations: integer?
}

--- A comparative benchmark suite.
export type SuiteOptions = {
    name: string,
    variants: {Variant},
    cases: {SuiteCase},

    --- Variant used as the denominator in the human result table.
    baseline: string?,

    --- Calls made before timing begins.
    warmup: integer?,

    --- Calls to `run` inside a timed sample. State is set up once per sample.
    batch: integer?,

    --- Stop once both this many samples and this many milliseconds of measured time
    --- exist.
    minsamples: integer?,
    minms: number?,

    --- Safety bounds when a sample is much faster or slower than expected.
    maxsamples: integer?,
    maxms: number?
}

--- Optional sections in the human result report.
export type FormatOptions = {
    --- Compare suite variants by their geometric-mean ratio.
    geomean: boolean?,

    --- Forks behind the measurements, when the runner merged them.
    ---
    --- Decides which columns the table carries. One fork reports a within-process
    --- interquartile range, which is a spread and not an interval; more than one
    --- reports the interval and the coverage it attained.
    forks: integer?,

    --- Lines appended below the table, each already wrapped.
    notes: {string}?
}

--- One measured case, suite variant or frame session, as a record carries it.
export record Measurement
    --- The case's name.
    name: string

    --- `case`, `suite` or `frames`.
    kind: string

    --- Iterations per round, for a case.
    n: integer?

    --- Rounds timed, for a case.
    rounds: integer?

    --- The median round, in milliseconds. Recorded, never gated.
    medianms: number?

    --- The fastest round, in milliseconds.
    fastest: number?

    --- Suite samples in milliseconds, normalized to one represented operation.
    samplesms: {number}?

    meanms: number?
    stdevms: number?
    p90ms: number?

    --- The 99th percentile of this measurement's samples, in milliseconds: rounds for
    --- a case, samples for a suite, frames for a frame session.
    p99ms: number?

    --- Calls to a suite variant inside a timed sample, and the operations a call
    --- represents.
    batch: integer?

    opspercall: integer?
    warmup: integer?
    minsamples: integer?
    minms: number?
    maxsamples: integer?
    maxms: number?

    --- Comparative-suite identity. Kept apart so a reader need not parse `name`.
    suite: string?

    variant: string?
    casename: string?
    parameters: {[string]: any}?
    baseline: string?

    --- Kilobytes allocated, read with the collector stopped. A case stores one round;
    --- a suite stores one represented operation. A size rather than a count of
    --- allocations, and recorded only.
    allocatedkb: number?

    --- Kilobytes still held once the collector has run again, which is what "retained"
    --- has to mean. An earlier implementation reported the number above and called it
    --- this one: with collection stopped for the rounds, the heap delta is what they
    --- allocated, not what survived them.
    retainedkb: number?

    --- Frame durations in milliseconds at the named quantiles. `p99ms` is above.
    p50ms: number?

    p999ms: number?

    --- Frames recorded, and how many exceeded the budget.
    frames: integer?

    overbudget: integer?

    --- Abort site identities seen while measuring, each
    --- `severity|reason|location|zone`. Identities rather than counts: a count is
    --- partly a function of how much work ran, and a loop that started aborting is the
    --- finding at any count.
    ---
    --- Nil when no session could be opened, which is not the same as an empty set: one
    --- says nothing aborted and the other says nobody looked.
    abortsites: {string}?

    --- Abort events and blacklistings behind those sites. Recorded, never gated.
    totalaborts: integer?

    blacklisted: integer?

    --- Collapsed-stack profile written for this measured window, when requested.
    profilepath: string?

    --- Quantiles of this measurement's own samples, in milliseconds.
    ---
    --- The table shows `[p25, p99]` beside the score, which is a range rather than a
    --- percentage either side of the median on purpose: a benchmark whose samples are
    --- bimodal puts its median in the gap between the two clusters, and a symmetric
    --- "+-x%" around that median describes a distribution the run never produced.
    ---
    --- The upper end is the tail rather than the third quartile because the tail is
    --- what a reader is looking for. A slow mode holding a tenth of the samples moves
    --- p99 and leaves p75 where it was, so a box would have hidden exactly the case
    --- worth seeing. `p75ms` stays in the record for anyone who wants the box.
    p25ms: number?

    p75ms: number?

    --- The interquartile range of this measurement's own samples, in milliseconds.
    ---
    --- Within-process spread. It says how much the samples inside a process varied
    --- and is not a confidence interval: those samples share a heap, a set of compiled
    --- traces and a thermal state, so they are not independent draws and no interval
    --- may be derived from them. An interval comes from fork summaries, which the
    --- runner assembles across processes.
    iqrms: number?

    --- What a monotone-trend test made of this process's samples in execution order:
    --- `trend`, `no-trend-detected`, or `unknown`.
    ---
    --- There is no value asserting a steady state. A test that found no trend has not
    --- established one, and saying otherwise is the mistake this field exists to
    --- avoid making.
    trend: string?

    --- Kendall's tau and the two-sided p-value behind `trend`, and how far the level
    --- actually moved between the ends of the series.
    ---
    --- `trend` needs both a significant test and a drift worth acting on, so a series
    --- that moved half a percent with a p-value of 0.005 is not reported as trending.
    trendtau: number?

    trendpvalue: number?
    trenddrift: number?

    --- The fraction of this measurement's samples lying within ten percent of its
    --- median.
    ---
    --- Near one when the samples describe a single rate. Near zero when they split
    --- into clusters and the median falls in the gap, which is what a collector
    --- running on alternate samples produces and which makes the reported score
    --- describe a rate the benchmark never ran at.
    concentration: number?

    --- Samples beyond three interquartile ranges of the nearer quartile, and the
    --- largest of them over the median.
    ---
    --- Classified, never removed. A real warmup or deoptimization phase falls exactly
    --- where these fences do, so excluding what they catch would delete the behavior
    --- `trend` is looking for. Every sample stays in `samplesms` and in the median.
    outliercount: integer?

    outliermax: number?

    --- Processes this measurement summarizes, when the runner merged forks into it.
    ---
    --- Absent on a measurement a child wrote: a child is a process and knows nothing
    --- about the others.
    forkcount: integer?

    --- One normalized summary per fork, in execution order. The input the interval
    --- below was computed from, kept so a reader can recompute it.
    forksms: {number}?

    --- The interval for this benchmark's population median, when one is available.
    ---
    --- `coverage` is the probability this interval actually attains, not one
    --- that was requested: it falls out of the fork count through the sign test, and a
    --- run with too few forks gets no interval rather than a relabelled one.
    intervallowms: number?

    intervalhighms: number?
    coverage: number?

    --- Why there is no interval: `below-minimum-forks` or `trend-warning`.
    withheld: string?
end

local measurements: {Measurement} = {}
local recorder: any = nil

local type Job = {
    name: string,
    run: function(): nil
}

local jobs: {Job} = {}
local selected: integer = 0
local declared: {[string]: boolean} = {}

--- Whether `report` has already written. A frame session reports itself, so a program
--- with both frames and cases would otherwise write twice and gate twice.
local reported = false

----------------------------------------------------------------------------
-- Program arguments
----------------------------------------------------------------------------

local options = {
    out = "build/bench-record.json",
    baseline = nil as string?,
    json = false,
    accept = false,
    quiet = false,

    --- Run only this case, or every case when nil. The runner names one per child,
    --- because a process is the measurement boundary: two cases sharing one share its
    --- heap, its compiled traces and its blacklist.
    only = nil as string?,

    --- Print the case names and measure nothing. How the runner learns what to spawn.
    list = false,

    --- Where a listing writes JSON strings, one per declared case. Nil keeps the
    --- human-facing `--list-cases` form on stdout.
    casesout = nil as string?,

    --- Iterations selected by the set runner from this case's merged baseline.
    iterations = nil as integer?,

    --- Internal handoff from `nupp bench`; callers choose the directory on the
    --- command and the runner gives every isolated child its own file.
    sampleout = nil as string?,
    intervalms = 1,
    samplezone = nil as string?,
    sampleroot = nil as string?,
}

local function parseargs(): nil
    local argv = io.cli.args as {string}?
    if not argv then
        return
    end
    local index: integer = 1
    while argv[index] do
        local entry = argv[index]
        local name, value = entry:match("^%-%-([%w%-]+)=(.*)$")
        if not name then
            name = entry:match("^%-%-([%w%-]+)$")
        end
        if name == "list-cases" then
            options.list = true
        elseif name == "cases-out" then
            options.casesout = value or argv[index + 1]
            if not value then
                index = (index + 1) as integer
            end
        elseif name == "case" then
            options.only = value or argv[index + 1]
            if not value then
                index = (index + 1) as integer
            end
        elseif name == "json" then
            options.json = true
        elseif name == "quiet" then
            options.quiet = true
        elseif name == "accept" then
            options.accept = true
        elseif name == "out" then
            options.out = value or argv[index + 1] or options.out
            if not value then
                index = (index + 1) as integer
            end
        elseif name == "baseline" then
            options.baseline = value or argv[index + 1]
            if not value then
                index = (index + 1) as integer
            end
        elseif name == "n" then
            local given = tonumber(value or argv[index + 1])
            if not value then
                index = (index + 1) as integer
            end
            if not given or given < 1 or given ~= math.floor(given) then
                error("nupp: --n needs a positive whole number", 0)
            end
            options.iterations = math.floor(given)
        elseif name == "sample-out" then
            options.sampleout = value or argv[index + 1]
            if not value then
                index = (index + 1) as integer
            end
        elseif name == "sample-interval-ms" then
            local given = tonumber(value or argv[index + 1])
            if not value then
                index = (index + 1) as integer
            end
            if not given or given < 1 or given ~= math.floor(given) then
                error("nupp: --sample-interval-ms needs a positive whole number", 0)
            end
            options.intervalms = math.floor(given)
        elseif name == "sample-zone" then
            options.samplezone = value or argv[index + 1]
            if not value then
                index = (index + 1) as integer
            end
        elseif name == "sample-root" then
            options.sampleroot = value or argv[index + 1]
            if not value then
                index = (index + 1) as integer
            end
        end
        index = (index + 1) as integer
    end
end

parseargs()

----------------------------------------------------------------------------
-- Measuring
----------------------------------------------------------------------------

local function readfile(path: string): string?
    local handle = io.open(path, "r")
    if not handle then
        return nil
    end
    local content = handle:read("*a")
    handle:close()

    return content
end

--- Decodes a baseline record, refusing one this version cannot read.
---
--- Anything that decodes as JSON used to read as a baseline: a record from a newer
--- bench, or a file that is not a record at all, matched no case, so every case read
--- as having no baseline, and that looks like a pass. Exported so the runner applies
--- the same rule to its own documents, from the oldest schema it reads.
---
--- @param text what the baseline file holds
--- @param path where it was read from, for the message
--- @param floor the oldest schema the reader accepts, `oldest` by
---     default
--- @return the decoded baseline, or nil where it is refused
--- @return why it was refused, naming its schema and the ones this version reads
export function decode(text: string, path: string, floor: integer?): (any, string?)
    local low = floor or oldest
    local decoded, document = pcall(json.decodevalue, text)
    if not decoded or type(document) ~= "table" or json.isarray(document) then
        return nil, ("nupp: baseline %s is not a bench record"):format(path)
    end
    local version = document.schema
    if type(version) ~= "number" or version ~= math.floor(version) or version < low or version > schema then
        return nil, (
            "nupp: baseline %s has schema %s; this bench reads schema %d, and %d through %d without durations"
        ):format(path, version == nil and "none" or tostring(version), schema, low, schema - 1)
    end

    return recordio.read(document), nil
end

--- The baseline, read once and remembered, or nil when there is none to read.
local baselinedoc: any = nil

local baselineread = false

local function baseline(): any
    if baselineread then
        return baselinedoc
    end
    baselineread = true
    if not options.baseline then
        return nil
    end
    local text = readfile(options.baseline)
    if not text then
        return nil
    end
    local document, refused = decode(text, options.baseline)
    -- Accepting replaces the file, so one this version cannot read is only replaced.
    if refused and not options.accept then
        error(refused, 0)
    end
    baselinedoc = document

    return baselinedoc
end

--- The iteration count a baseline recorded for this case, or nil for none.
---
--- Reused rather than recalibrated so that two records counted the same work. A
--- calibrated `n` is derived from a timing, so letting each run pick its own leaves the
--- durations describing different amounts of work and quietly not comparable.
local function recordedn(name: string): integer?
    local previous = baseline()
    for _, entry in ipairs(previous and previous.cases or {}) do
        if entry.name == name and entry.kind == "case" then
            return entry.n
        end
    end

    return nil
end

local function median(values: {number}): number
    local sorted: {number} = {}
    for index = 1, #values do
        sorted[index] = values[index]
    end
    table.sort(sorted)

    return sorted[math.ceil(#sorted / 2)]
end

local function smallest(values: {number}): number
    local best = values[1]
    for index = 2, #values do
        if values[index] < best then
            best = values[index]
        end
    end

    return best
end

local function quantile(sorted: {number}, fraction: number): number
    if #sorted == 0 then
        return 0.0
    end
    local rank = math.ceil(fraction * #sorted)
    if rank < 1 then
        rank = 1
    end
    if rank > #sorted then
        rank = #sorted
    end

    return sorted[rank]
end

--- Grows `n` until one round takes long enough to time. Timing-derived, and therefore
--- kept out of the measured phase: the chosen `n` is recorded and the measured rounds
--- all run at it, so a loaded machine cannot change how much work was counted.
---
--- A size is accepted only when it holds twice. The first round at any size also pays
--- for whatever the recorder had not compiled yet, so it times a program that no longer
--- exists by the time the measured rounds run -- which is how an uncalibrated version
--- of this settled on a million iterations that then took a third of the target.
local function calibrate(name: string, body: function(Case): nil, fixed: integer?): integer
    if fixed and fixed > 0 then
        return fixed
    end
    local n: integer = 1
    local held = false
    while n < MAX_N do
        -- The monotonic clock, because it is the clock the measured rounds below are
        -- timed on. Calibrating against `os.clock` processor time would size `n` from
        -- one quantity and then report another, and the two part company for any body
        -- that waits on anything.
        local started = os.monotonic()
        body(Case(name = name, n = n))
        if os.monotonic() - started >= TARGET_ROUND_MS then
            if held then
                return n
            end
            held = true
        else
            held = false
            n = (n * 2) as integer
        end
    end

    return n
end

local function identities(report: any): ({string}, integer, integer)
    local sites: {string} = {}
    for _, site in ipairs(report.sites) do
        sites[
            #sites + 1
        ] = (
            "%s|%s|%s|%s"
        ):format(
            tostring(site.severity),
            tostring(site.reason),
            tostring(site.location or ""),
            tostring(site.zone or "")
        )
    end
    table.sort(sites)

    return sites, report.aborts, report.blacklisted
end

--- Says a case's name under `--list-cases`, as it is declared.
---
--- Printed here rather than collected and printed by `report`, because a listing run
--- must not depend on the program reaching a report call. A frame session that is
--- inert while listing returns before reporting, which is exactly the case that
--- silently listed nothing when this was deferred.
---
--- @raises string when a requested case-list file cannot be opened
local function announce(listing: any): nil
    if options.casesout then
        local handle = io.open(options.casesout, "a")
        if not handle then
            error("nupp: cannot write " .. options.casesout, 0)
        end
        handle:write(json.encodevalue(recordio.writemeasurement(listing)), "\n")
        handle:close()

        return
    end
    io.stdout:write(listing.name, "\n")
end

--- Opens a trace session, or returns nil when one is already open.
---
--- `nupp run --jit-aborts` opens a process-wide session before the program starts, and
--- there is at most one at a time, so a case that insisted on its own would fail under
--- the flag most likely to be set while investigating one. Answering nil instead costs
--- the abort half of that case's record, which is then reported as uncollected rather
--- than as an empty set -- an empty set and an uncollected one gate very differently.
local function opentrace(): any?
    local ok, session = pcall(profile.trace)
    if not ok then
        return nil
    end

    -- The harness stops every session it opens, on each case's own schedule.

    return @unsafe own.release(session)
end

--- Opens the optional sampler paused. Setup, teardown and harness bookkeeping stay
--- outside the collapsed stacks; measured bodies resume it explicitly.
local function opensample(): any?
    if not options.sampleout then
        return nil
    end
    local argv = io.cli.args as {string}?
    local root = options.sampleroot or (argv and argv[0] and argv[0]:match("([^/\\]+)$") or nil)
    local session = profile.sample({intervalms = options.intervalms, zone = options.samplezone, root = root,})
    session:pause()

    return @unsafe own.release(session)
end

--- Announces work before it starts, so calibration or an application-owned frame
--- loop never makes the command look stuck. JSON and runner-child processes stay
--- silent; the set runner announces those children with their source paths instead.
local function announcerun(name: string): nil
    if options.json or options.quiet then
        return
    end
    io.stdout:write("# Benchmark: ", name, "\n")
    io.stdout:flush()
end

local function register(name: string, run: function(): nil, listing: any?): nil
    if name == "" then
        error("nupp: a benchmark name cannot be empty", 3)
    end
    if declared[name] then
        error("nupp: duplicate benchmark " .. name, 3)
    end
    declared[name] = true
    local declared = listing or {name = name}
    if options.list then
        announce(declared)

        return
    end
    if options.only and options.only ~= name then
        return
    end
    selected = (selected + 1) as integer
    jobs[#jobs + 1] = {name = name, run = run,}
end

local function measurecase(name: string, body: function(Case): nil, fixedn: integer?): nil
    announcerun(name)

    -- Opened before calibration, not after it. A loop that aborts and is blacklisted
    -- while being calibrated has already been demoted to the interpreter by the time a
    -- later session opens, so a session opened after calibration reports nothing and
    -- the one finding that mattered is the one that got away.
    local session = opentrace()
    local n = calibrate(name, body, fixedn or options.iterations or recordedn(name))
    local subject = Case(name = name, n = n)
    body(subject)

    collectgarbage("collect")
    local before = collectgarbage("count")
    collectgarbage("stop")
    local times: {number} = {}
    for round = 1, ROUNDS do
        local started = os.monotonic()
        body(subject)
        times[round] = os.monotonic() - started
    end
    -- Collected before reading again, so what is reported is what the rounds kept
    -- rather than everything they allocated while the collector was off.
    local allocated = collectgarbage("count") - before
    collectgarbage("restart")
    collectgarbage("collect")
    local retained = math.max(0.0, collectgarbage("count") - before)

    local sites: {string}? = nil
    local total: integer? = nil
    local blacklisted: integer? = nil
    if session then
        local aborts = session:stop()
        recorder = aborts.recorder
        sites, total, blacklisted = identities(aborts)
    end
    local sampling = opensample()
    if sampling then
        collectgarbage("collect")
        for _ = 1, ROUNDS do
            sampling:resume()
            body(subject)
            sampling:pause()
        end
        sampling:stop(options.sampleout)
    end
    -- Retained in execution order, not just summarized. The runner's interval is built
    -- from one summary per process, but a reader wanting to see what a process actually
    -- did -- or a later warmup classifier wanting to run over it -- needs the series
    -- itself, and a median thrown away cannot be recovered.
    local rounds = statistics.trend(times)
    local far = statistics.outliers(times)
    local ordered = statistics.sorted(times)
    measurements[
        #measurements + 1
    ] = Measurement(
        name = name,
        kind = "case",
        n = n,
        rounds = ROUNDS,
        medianms = median(times),
        fastest = smallest(times),
        samplesms = times,
        p25ms = statistics.quantile(ordered, 0.25),
        p75ms = statistics.quantile(ordered, 0.75),
        p99ms = statistics.quantile(ordered, 0.99),
        iqrms = statistics.iqr(times),
        trend = rounds.verdict,
        trendtau = rounds.tau,
        trendpvalue = rounds.pValue,
        trenddrift = rounds.drift,
        concentration = statistics.concentration(times, statistics.CONCENTRATION_TOLERANCE),
        outliercount = far.severe,
        outliermax = far.maxRatio,
        allocatedkb = allocated / ROUNDS,
        retainedkb = retained,
        abortsites = sites,
        totalaborts = total,
        blacklisted = blacklisted,
        profilepath = options.sampleout
    )
end

--- Measures a case and adds it to the record this program will report.
---
--- The body is handed the case and runs its own loop. Calling a one-iteration closure
--- `n` times instead would put a call boundary inside the measurement and change what
--- the recorder sees, so the loop belongs to the body.
---
--- @param name what to record the case as
--- @param body the work, which iterates `case.n` times
--- @param fixedn an explicit iteration count, skipping calibration
--- @raises string when the name is empty or already declared
export function case(name: string, body: function(Case): nil, fixedn: integer?): nil
    register(name, function(): nil
        measurecase(name, body, fixedn)
    end)
end

----------------------------------------------------------------------------
-- Comparative suites
----------------------------------------------------------------------------

local function positiveint(value: integer?, fallback: integer, name: string): integer
    local answer = value or fallback
    if answer < 1 or answer ~= math.floor(answer) then
        error("nupp: " .. name .. " needs a positive whole number", 3)
    end

    return answer
end

local function positivenum(value: number?, fallback: number, name: string): number
    local answer = value or fallback
    if answer <= 0 then
        error("nupp: " .. name .. " needs a positive number", 3)
    end

    return answer
end

local function expand(source: {[string]: {any}}?): {{[string]: any}}
    if not source then
        return {{} as {[string]: any}}
    end
    local keys: {string} = {}
    for key in pairs(source) do
        keys[#keys + 1] = key
    end
    table.sort(keys)
    local expanded: {{[string]: any}} = {}
    local current: {[string]: any} = {}
    local visit: function(integer): nil
    visit = function(index: integer): nil
        if index > #keys then
            local copy: {[string]: any} = {}
            for key, value in pairs(current) do
                copy[key] = value
            end
            expanded[#expanded + 1] = copy

            return
        end
        local key = keys[index]
        local values = source[key]
        if not values then
            error("nupp: parameter " .. key .. " disappeared", 3)
        end
        if #values == 0 then
            error("nupp: parameter " .. key .. " has no values", 3)
        end
        for _, value in ipairs(values) do
            current[key] = value
            visit((index + 1) as integer)
        end
        current[key] = nil
    end
    visit(1)

    return expanded
end

local function suitename(suite: string, casename: string, variant: string, parameters: {[string]: any}): string
    local keys: {string} = {}
    for key in pairs(parameters) do
        keys[#keys + 1] = key
    end
    table.sort(keys)
    local suffix: {string} = {}
    for _, key in ipairs(keys) do
        suffix[#suffix + 1] = key .. "=" .. tostring(parameters[key])
    end
    local name = suite .. "." .. casename .. "." .. variant
    if #suffix > 0 then
        name = name .. ":" .. table.concat(suffix, ",")
    end

    return name
end

local function callvariant(variant: Variant, invocation: Invocation, iterations: integer, session: any?): number
    local state: any = nil
    if variant.setup then
        state = variant.setup(invocation)
    end
    if session then
        session:resume()
    end
    local started = os.monotonic()
    local result: any = nil
    for _ = 1, iterations do
        result = variant.run(state, invocation)
    end
    local elapsed = os.monotonic() - started
    if session then
        session:pause()
    end
    keep(result)
    if variant.teardown then
        variant.teardown(state, invocation)
    end

    return elapsed
end

local function summarize(samples: {number}): (number, number, number, number, number, number)
    local sorted: {number} = {}
    local total = 0.0
    for index = 1, #samples do
        local value = samples[index]
        sorted[index] = value
        total = total + value
    end
    table.sort(sorted)
    local mean = total / #sorted
    local squared = 0.0
    for _, value in ipairs(sorted) do
        local delta = value - mean
        squared = squared + delta * delta
    end
    local stdev = #sorted > 1 and math.sqrt(squared / (#sorted - 1)) or 0.0

    return smallest(sorted), mean, stdev, quantile(sorted, 0.5), quantile(sorted, 0.9), quantile(sorted, 0.99)
end

local function measuresuite(
    opts: SuiteOptions,
    spec: SuiteCase,
    variant: Variant,
    parameters: {[string]: any},
    name: string
): nil
    local warmups = positiveint(opts.warmup, 10, "warmup")
    local iterations = positiveint(opts.batch, 1, "batch")
    local minsamples = positiveint(opts.minsamples, 15, "minsamples")
    local maxsamples = positiveint(opts.maxsamples, 100000, "maxsamples")
    local minms = positivenum(opts.minms, 500.0, "minms")
    local maxms = positivenum(opts.maxms, 10000.0, "maxms")
    local operations = positiveint(spec.operations, 1, "case operations")
    if maxsamples < minsamples then
        error("nupp: maxsamples must be at least minsamples", 0)
    end
    if maxms < minms then
        error("nupp: maxms must be at least minms", 0)
    end

    announcerun(name)
    collectgarbage("collect")
    local session = opentrace()
    if session then
        session:pause()
    end
    for _ = 1, warmups do
        callvariant(
            variant,
            Invocation(name = spec.name, data = spec.data, parameters = parameters),
            iterations,
            session
        )
    end

    local invocation = Invocation(name = spec.name, data = spec.data, parameters = parameters)
    local samples: {number} = {}
    local measured = 0.0
    local wallstart = os.monotonic()
    while #samples < minsamples or measured < minms do
        if #samples >= maxsamples or os.monotonic() - wallstart >= maxms then
            break
        end
        local elapsed = callvariant(variant, invocation, iterations, session)
        measured = measured + elapsed
        samples[#samples + 1] = elapsed / (iterations * operations)
    end
    if #samples < minsamples or measured < minms then
        error(
            (
                "nupp: %s reached its sampling limit after %d samples and %.3f ms measured; increase batch or the maximums"
            ):format(name, #samples, measured),
            0
        )
    end

    -- Allocation is a separate pass so stopping the collector cannot change the
    -- timing distribution. The collector otherwise stays enabled throughout warmup
    -- and measurement, as it does in the application.
    local function prime(): nil
    end

    pcall(prime)
    local state: any = nil
    if variant.setup then
        state = variant.setup(invocation)
    end

    local function pass(): any
        local last: any = nil
        for _ = 1, iterations do
            last = variant.run(state, invocation)
        end

        return last
    end

    collectgarbage("collect")
    local before = collectgarbage("count")
    collectgarbage("stop")
    local ok, result = pcall(pass)
    local allocated = collectgarbage("count") - before
    collectgarbage("restart")
    if not ok then
        error(result, 0)
    end
    keep(result)
    if variant.teardown then
        variant.teardown(state, invocation)
    end
    collectgarbage("collect")
    local retained = math.max(0.0, collectgarbage("count") - before)

    local sites: {string}? = nil
    local totalaborts: integer? = nil
    local blacklisted: integer? = nil
    if session then
        local aborts = session:stop()
        recorder = aborts.recorder
        sites, totalaborts, blacklisted = identities(aborts)
    end
    local sampling = opensample()
    if sampling then
        collectgarbage("collect")
        for _ = 1, #samples do
            callvariant(variant, invocation, iterations, sampling)
        end
        sampling:stop(options.sampleout)
    end
    local minimum, mean, stdev, p50, p90, p99 = summarize(samples)
    -- Tested in execution order, before anything sorts the series. This process only:
    -- pooling two processes' samples manufactures a step at the join that belongs to
    -- neither of them.
    local drift = statistics.trend(samples)
    local far = statistics.outliers(samples)
    local ordered = statistics.sorted(samples)
    measurements[
        #measurements + 1
    ] = Measurement(
        name = name,
        kind = "suite",
        rounds = #samples,
        medianms = p50,
        fastest = minimum,
        samplesms = samples,
        meanms = mean,
        stdevms = stdev,
        p90ms = p90,
        p99ms = p99,
        p25ms = statistics.quantile(ordered, 0.25),
        p75ms = statistics.quantile(ordered, 0.75),
        iqrms = statistics.iqr(samples),
        trend = drift.verdict,
        trendtau = drift.tau,
        trendpvalue = drift.pValue,
        trenddrift = drift.drift,
        concentration = statistics.concentration(samples, statistics.CONCENTRATION_TOLERANCE),
        outliercount = far.severe,
        outliermax = far.maxRatio,
        batch = iterations,
        opspercall = operations,
        warmup = warmups,
        minsamples = minsamples,
        minms = minms,
        maxsamples = maxsamples,
        maxms = maxms,
        suite = opts.name,
        variant = variant.name,
        casename = spec.name,
        parameters = parameters,
        baseline = opts.baseline or opts.variants[1].name,
        allocatedkb = allocated / (iterations * operations),
        retainedkb = retained,
        abortsites = sites,
        totalaborts = totalaborts,
        blacklisted = blacklisted,
        profilepath = options.sampleout
    )
end

local function registersuite(options: SuiteOptions, spec: SuiteCase, variant: Variant, parameters: {[string]: any}): nil
    local name = suitename(options.name, spec.name, variant.name, parameters)
    register(
        name,
        function(): nil
            measuresuite(options, spec, variant, parameters, name)
        end,
        {name = name, suite = options.name, casename = spec.name, variant = variant.name, parameters = parameters,}
    )
end

--- Declares a comparative suite. Every case, parameter set and variant is a named
--- benchmark and therefore gets its own process under the set runner.
---
--- @raises string when the declaration or its sampling bounds are invalid
export function suite(options: SuiteOptions): nil
    if #options.variants == 0 then
        error("nupp: a suite needs at least one variant", 2)
    end
    if #options.cases == 0 then
        error("nupp: a suite needs at least one case", 2)
    end
    local variants: {[string]: boolean} = {}
    for _, variant in ipairs(options.variants) do
        if variants[variant.name] then
            error("nupp: duplicate variant " .. variant.name, 2)
        end
        variants[variant.name] = true
    end
    local baseline = options.baseline or options.variants[1].name
    if not variants[baseline] then
        error("nupp: baseline does not name a variant", 2)
    end
    local cases: {[string]: boolean} = {}
    for _, spec in ipairs(options.cases) do
        if cases[spec.name] then
            error("nupp: duplicate suite case " .. spec.name, 2)
        end
        cases[spec.name] = true
        for _, parameters in ipairs(expand(spec.parameters)) do
            for _, variant in ipairs(options.variants) do
                registersuite(options, spec, variant, parameters)
            end
        end
    end
end

----------------------------------------------------------------------------
-- Frames
----------------------------------------------------------------------------

--- A running frame measurement, as `frames` returns it.
---
--- The application owns its loop, so this offers a condition and a report rather than
--- taking the loop over. There is no exit-time fallback: nothing hands this module a
--- callback when the chunk returns, collection before shutdown is not guaranteed, and
--- the compiler's entry point ends in `os.exit`. A session that is never reported
--- produces no record, and the runner says so.
export record FrameSession
    name: string
    budgetms: number
    wanted: integer
    samples: {number}
    started: number
    session: any
    sampling: any
    done: boolean
end

--- Opens a frame measurement.
---
--- Plain parameters rather than an options record, because a record would make the
--- ordinary call site write `bench.FrameOptions(...)` -- a table literal is not
--- one, which is what the first version of this API got wrong in its documented
--- example.
---
--- @param name what to record the session as
--- @param budgetms milliseconds a frame is allowed; frames over it are counted
--- @param count frames to record before `more` turns false, or nil to let the
---     application decide when to stop
--- @raises string when the name is empty or already declared
export function frames(name: string, budgetms: number?, count: integer?): FrameSession
    -- A frame session is a case as far as the runner is concerned: it is named, it is
    -- listed, and it is selected one per process. A session that is being listed or is
    -- not the selected one is handed back already finished, so `more` is false and the
    -- application's loop does not run.
    if name == "" then
        error("nupp: a benchmark name cannot be empty", 2)
    end
    if declared[name] then
        error("nupp: duplicate benchmark " .. name, 2)
    end
    declared[name] = true
    if options.list then
        announce({name = name})
    end
    local inert = options.list or (options.only ~= nil and options.only ~= name)
    if inert then
        return FrameSession(
            name = name,
            budgetms = budgetms or 0.0,
            wanted = count or 0,
            samples = {},
            started = 0.0,
            session = nil,
            sampling = nil,
            done = true
        )
    end

    selected = (selected + 1) as integer
    announcerun(name)

    return FrameSession(
        name = name,
        budgetms = budgetms or 0.0,
        wanted = count or 0,
        samples = {},
        started = 0.0,
        session = opentrace(),
        sampling = opensample(),
        done = false
    )
end

--- Whether more frames are wanted. False once `count` frames have been recorded, and
--- always true when the session was opened without one.
function FrameSession:more(): boolean
    if self.done then
        return false
    end
    if self.wanted <= 0 then
        return true
    end

    return #self.samples < self.wanted
end

--- Marks the start of a frame.
function FrameSession:begin(): nil
    if self.sampling then
        self.sampling:resume()
    end
    self.started = os.monotonic()
end

--- Marks the end of a frame and records it.
---
--- Elapsed on the monotonic clock, not `os.clock`, which counts processor time. A frame
--- that waited on presentation, on I/O, or on a sleep spends very little of either and
--- blows its budget anyway, and missing the budget is the whole measurement.
function FrameSession:finish(): nil
    local finished = os.monotonic()
    if self.sampling then
        self.sampling:pause()
    end
    self.samples[#self.samples + 1] = finished - self.started
end

--- Ends the session, records it, and reports.
---
--- A frame report is a distribution rather than a median: a budget missed one frame in
--- a hundred is a visible stutter and an unmoved mean.
---
--- This writes the record and applies the gate, which is why an application's loop
--- needs no second call. `report` is idempotent, so a program with both cases and
--- frames may still call it itself.
---
--- @raises string when a gated counter moved, or the record cannot be written
function FrameSession:report(): nil
    if self.done then
        return
    end
    self.done = true
    local sites: {string}? = nil
    local total: integer? = nil
    local blacklisted: integer? = nil
    if self.session then
        local aborts = self.session:stop()
        recorder = aborts.recorder
        sites, total, blacklisted = identities(aborts)
    end
    if self.sampling then
        self.sampling:stop(options.sampleout)
    end
    local sorted: {number} = {}
    for index = 1, #self.samples do
        sorted[index] = self.samples[index]
    end
    table.sort(sorted)
    local over: integer = 0
    if self.budgetms > 0 then
        for index = 1, #sorted do
            if sorted[index] > self.budgetms then
                over = (over + 1) as integer
            end
        end
    end

    measurements[
        #measurements + 1
    ] = Measurement(
        name = self.name,
        kind = "frames",
        p50ms = quantile(sorted, 0.5),
        p99ms = quantile(sorted, 0.99),
        p999ms = quantile(sorted, 0.999),
        frames = #sorted,
        overbudget = over,
        abortsites = sites,
        totalaborts = total,
        blacklisted = blacklisted,
        profilepath = options.sampleout
    )
    report()
end

----------------------------------------------------------------------------
-- Reporting
----------------------------------------------------------------------------

--- Reads the optimizer's account of this build, when `nupp run --remarks-out` wrote
--- one: the benchrunner asks for the default `build/remarks.json`, and `run` says
--- where it wrote.
---
--- Its absence is a result rather than a failure: a case run without one carries no
--- static counters and says so, and the gate then has only the dynamic half to work
--- with.
local function readremarks(): any
    local path = _G.__nuppRemarksOut
    if type(path) ~= "string" then
        return nil
    end
    local content = readfile(path)
    if not content then
        return nil
    end
    local decoded = json.decodevalue(content)

    return decoded
end

local function writefile(path: string, content: string): nil
    local handle = io.open(path, "w")
    if not handle then
        error("nupp: cannot write " .. path, 0)
    end
    handle:write(content)
    handle:close()
end

local function buildrecord(): any
    local remarks = readremarks()
    local cases = {}
    for index = 1, #measurements do
        cases[index] = measurements[index]
    end

    return {
        schema = schema,
        cases = cases,
        executionProfile = remarks and remarks.executionProfile or nil,
        remarks = remarks and remarks.remarks or nil,
        allocationSites = remarks and remarks.allocationSites or nil,
        traceProfile = recorder,
        compiler = remarks and remarks.compiler or nil,
    }
end

--- Whether two execution profiles describe the same thing being measured.
---
--- The level and the excluded passes are part of what a benchmark is measuring rather
--- than a source of drift, so a record made at another one finds a different baseline
--- rather than a failing one.
local function sameexecution(left: any, right: any): boolean
    if left == nil or right == nil then
        return false
    end
    if left.optLevel ~= right.optLevel then
        return false
    end

    return (left.disabled or "") == (right.disabled or "")
end

--- Whether two trace profiles describe the same recorder.
---
--- Whether a loop aborts is a property of the architecture, operating system, recorder
--- features and LuaJIT revision that watched it, so abort sites are keyed by all of
--- them. `profile.TraceProfile.id` is already the composite of exactly those, so this
--- compares that rather than reassembling the parts -- and in particular rather than
--- comparing the feature list, which is a table and would compare by identity.
local function samerecorder(left: any, right: any): boolean
    if left == nil or right == nil then
        return false
    end

    return left.id == right.id
end

--- The identities of the allocations the optimizer left standing, as the build
--- recorded them. A static account of this compiler's own output; see
--- `optimize.allocationSites` for what it does and does not say.
--- Counted per file rather than identified by position. An identity of file, line and
--- column makes inserting a comment above unchanged code look like every allocation
--- below it was newly introduced, which fails the gate for a change that allocated
--- nothing. A count moves when an allocation is added or removed and not when one is
--- moved, which is the question being asked.
local function alloccounts(record: any): {[string]: integer}
    local counts: {[string]: integer} = {}
    for _, site in ipairs(record.allocationSites or {}) do
        local key = tostring(site.file) .. "|" .. tostring(site.kind)
        counts[key] = ((counts[key] or 0) + 1) as integer
    end

    return counts
end

--- The identities of the remarks the optimizer made, as the build recorded them.
local function remarkids(record: any): {string}
    local entries: {string} = {}
    for _, entry in ipairs(record.remarks or {}) do
        local at = entry.range and entry.range.start or nil
        entries[
            #entries + 1
        ] = (
            "%s|%s|%s|%s"
        ):format(tostring(entry.code), tostring(entry.file), tostring(at and at.line or 0), tostring(entry.message))
    end
    table.sort(entries)

    return entries
end

local function difference(current: {string}, previous: {string}): {string}
    local seen: {[string]: boolean} = {}
    for _, entry in ipairs(previous) do
        seen[entry] = true
    end
    local added: {string} = {}
    for _, entry in ipairs(current) do
        if not seen[entry] then
            added[#added + 1] = entry
        end
    end

    return added
end

--- Compares a record against one baseline record and returns what moved.
---
--- Exported because the runner owns the baseline for a whole set and has to apply the
--- same rules a standalone case applies to its own. Two copies of these rules would
--- disagree, and the one that mattered would be whichever the reader was not looking
--- at.
---
--- @param record what this run measured
--- @param baseline the record to compare it against
--- @return the gated differences, which are failures
--- @return the differences that were only reported
---
--- A comparison with no comparable baseline is reported as exactly that. It is a
--- result, and a different one from a regression: the runner has to say which, or a
--- lost baseline reads like a pass.
export function compare(record: any, baseline: any): ({string}, {string})
    local failures: {string} = {}
    local uncompared: {string} = {}
    if not sameexecution(record.executionProfile, baseline.executionProfile) then
        uncompared[#uncompared + 1] = "execution profile differs; nothing is comparable"

        return failures, uncompared
    end
    local previous: {[string]: any} = {}
    for _, entry in ipairs(baseline.cases or {}) do
        previous[entry.name] = entry
    end
    -- Static counters are properties of the compiler's output, so they compare across
    -- hosts unchanged and are not keyed by the recorder below.
    local nowallocs = alloccounts(record)
    local wasallocs = alloccounts(baseline)
    local allockeys: {string} = {}
    for key in pairs(nowallocs) do
        allockeys[#allockeys + 1] = key
    end
    table.sort(allockeys)
    for _, key in ipairs(allockeys) do
        local now = nowallocs[key] or 0
        local was = wasallocs[key] or 0
        if now > was then
            failures[#failures + 1] = ("allocations rose from %d to %d in %s"):format(was, now, key)
        end
    end
    -- Reported rather than gated. A remark carries no field saying whether the pass
    -- fired or declined, so a pass that started firing would add one remark and remove
    -- another, and gating the set would call that improvement a regression.
    local nowremarks = remarkids(record)
    local wasremarks = remarkids(baseline)
    for _, entry in ipairs(difference(nowremarks, wasremarks)) do
        uncompared[#uncompared + 1] = "remark appeared: " .. entry
    end
    for _, entry in ipairs(difference(wasremarks, nowremarks)) do
        uncompared[#uncompared + 1] = "remark went away: " .. entry
    end
    local comparable = samerecorder(record.traceProfile, baseline.traceProfile)
    for _, entry in ipairs(record.cases or {}) do
        local was = previous[entry.name]
        if not was then
            uncompared[#uncompared + 1] = entry.name .. ": no baseline"
        elseif not comparable then
            uncompared[#uncompared + 1] = entry.name .. ": trace profile differs, abort sites not compared"
        elseif entry.abortsites == nil or was.abortsites == nil then
            uncompared[#uncompared + 1] = entry.name .. ": trace aborts were not collected"
        else
            local added = difference(entry.abortsites or {}, was.abortsites or {})
            for _, site in ipairs(added) do
                failures[#failures + 1] = entry.name .. ": new trace abort site: " .. site
            end
        end
    end

    return failures, uncompared
end

--- Formats a record as the compact result table used by both a standalone program
--- and the set runner. The shape follows the useful part of JMH's final report, but
--- names the statistic `p50`: these scores are medians, not averages with confidence
--- intervals.
---
--- Case scores are normalized to one body iteration. The calibrated batch size stays
--- in the JSON record, where the runner also finds it for the next comparison.
export function format(record: any, options: FormatOptions?): string
    local geomean = options and options.geomean == true
    local rows: {any} = {}
    local width: integer = #"Benchmark"
    local baselines: {[string]: number} = {}
    local ratios = false
    local workloads: {any} = {}
    local bykey: {[string]: any} = {}
    local suites: {any} = {}
    local byname: {[string]: any} = {}

    local function paramtext(entry: any): string
        local keys: {string} = {}
        for key in pairs(entry.parameters or {}) do
            keys[#keys + 1] = key
        end
        table.sort(keys)
        local values: {string} = {}
        for _, key in ipairs(keys) do
            values[#values + 1] = key .. "=" .. tostring(entry.parameters[key])
        end

        return table.concat(values, ",")
    end

    local function keyof(entry: any): string
        return tostring(entry.suite) .. "|" .. tostring(entry.casename) .. "|" .. paramtext(entry)
    end

    for _, entry in ipairs(record.cases or {}) do
        if entry.kind == "suite" then
            ratios = true
            local key = keyof(entry)
            local workload = bykey[key]
            if not workload then
                local parameters = paramtext(entry)
                local label = tostring(entry.suite) .. "." .. tostring(entry.casename)
                if parameters ~= "" then
                    label = label .. ":" .. parameters
                end
                workload = {
                    label = label,
                    suite = entry.suite,
                    casename = entry.casename,
                    baseline = entry.baseline,
                    values = {},
                    variants = {},
                    seen = {},
                }
                bykey[key] = workload
                workloads[#workloads + 1] = workload
                local group = byname[entry.suite]
                if not group then
                    group = {name = entry.suite, baseline = entry.baseline, workloads = {}, variants = {}, seen = {},}
                    byname[entry.suite] = group
                    suites[#suites + 1] = group
                end
                group.workloads[#group.workloads + 1] = workload
            end
            if not workload.seen[entry.variant] then
                workload.seen[entry.variant] = true
                workload.variants[#workload.variants + 1] = entry.variant
            end
            workload.values[entry.variant] = entry.medianms or 0.0
            local group = byname[entry.suite]
            if group and not group.seen[entry.variant] then
                group.seen[entry.variant] = true
                group.variants[#group.variants + 1] = entry.variant
            end
            if entry.variant == entry.baseline then
                baselines[key] = entry.medianms or 0.0
            end
        end
    end

    -- How wide the samples behind one score were, in the score's own units.
    --
    -- With one process this is that process's interquartile range, written as a
    -- percentage either side of the median. It is a spread, not an interval: the
    -- samples it summarizes share a heap and a set of compiled traces, so nothing
    -- about a population median follows from it, and the note below the table says so.
    local function spreadcell(entry: any, scale: number): string
        local low = entry.p25ms
        local tail = entry.p99ms
        if not low or not tail then
            return "-"
        end

        return ("[%.3f, %.3f]"):format(low * scale, tail * scale)
    end

    -- The interval for a merged measurement, or why there is not one.
    local function intervalcell(entry: any, scale: number): string
        if entry.withheld == "trend-warning" then
            return "unstable"
        end
        if not entry.intervallowms or not entry.intervalhighms then
            return "-"
        end

        return ("[%.3f, %.3f]"):format(entry.intervallowms * scale, entry.intervalhighms * scale)
    end

    local function coveragecell(entry: any): string
        if not entry.coverage then
            return "-"
        end

        return ("%.2f%%"):format(entry.coverage * 100.0)
    end

    -- Allocation is measured in a separate collector-stopped pass and stored in
    -- kilobytes. Suites already normalize it to one represented operation; a case
    -- stores one round, so divide by the calibrated iteration count here just as its
    -- duration score does.
    local function alloccell(entry: any): string
        local allocated = entry.allocatedkb
        if allocated == nil then
            return "-"
        end
        if entry.kind == "case" then
            local n = entry.n or 0
            if n <= 0 then
                return "-"
            end
            allocated = allocated / n
        elseif entry.kind ~= "suite" then
            return "-"
        end

        return ("%.3f"):format(allocated * 1024.0)
    end

    for _, entry in ipairs(record.cases or {}) do
        if entry.kind == "case" then
            local n = entry.n or 0
            local scale = n > 0 and (1000000.0 / n) or 0.0
            local score = (entry.medianms or 0.0) * scale
            rows[
                #rows + 1
            ] = {
                name = entry.name,
                mode = "p50",
                count = tostring(entry.rounds or 0),
                forkcount = tostring(entry.forkcount or 1),
                score = ("%.3f"):format(score),
                units = "ns/op",
                allocation = alloccell(entry),
                ratio = "-",
                spread = spreadcell(entry, scale),
                interval = intervalcell(entry, scale),
                coverage = coveragecell(entry),
            }
        elseif entry.kind == "suite" then
            local scale = 1000000.0
            local score = (entry.medianms or 0.0) * scale
            local basescore = baselines[keyof(entry)]
            local ratio = "-"
            if basescore and score > 0 then
                ratio = ("%.3fx"):format(basescore / (entry.medianms or 0.0))
            end
            rows[
                #rows + 1
            ] = {
                name = entry.name,
                mode = "p50",
                count = tostring(entry.rounds or 0),
                forkcount = tostring(entry.forkcount or 1),
                score = ("%.3f"):format(score),
                units = "ns/op",
                allocation = alloccell(entry),
                ratio = ratio,
                spread = spreadcell(entry, scale),
                interval = intervalcell(entry, scale),
                coverage = coveragecell(entry),
            }
        else
            local count = tostring(entry.frames or 0)
            rows[
                #rows + 1
            ] = {
                name = entry.name,
                mode = "p50",
                count = count,
                forkcount = tostring(entry.forkcount or 1),
                score = ("%.3f"):format(entry.p50ms or 0.0),
                units = "ms/frame",
                allocation = "-",
                ratio = "-",
                spread = "-",
                interval = "-",
                coverage = "-",
            }
            rows[
                #rows + 1
            ] = {
                name = entry.name,
                mode = "p99",
                count = count,
                forkcount = tostring(entry.forkcount or 1),
                score = ("%.3f"):format(entry.p99ms or 0.0),
                units = "ms/frame",
                allocation = "-",
                ratio = "-",
                spread = "-",
                interval = "-",
                coverage = "-",
            }
            rows[
                #rows + 1
            ] = {
                name = entry.name,
                mode = "p99.9",
                count = count,
                forkcount = tostring(entry.forkcount or 1),
                score = ("%.3f"):format(entry.p999ms or 0.0),
                units = "ms/frame",
                allocation = "-",
                ratio = "-",
                spread = "-",
                interval = "-",
                coverage = "-",
            }
            if (entry.overbudget or 0) > 0 then
                rows[
                    #rows + 1
                ] = {
                    name = entry.name .. ":over-budget",
                    mode = "count",
                    count = count,
                    forkcount = tostring(entry.forkcount or 1),
                    score = tostring(entry.overbudget),
                    units = "frames",
                    allocation = "-",
                    ratio = "-",
                    spread = "-",
                    interval = "-",
                    coverage = "-",
                }
            end
        end
    end
    if #rows == 0 then
        return ""
    end
    for _, row in ipairs(rows) do
        if #row.name > width then
            width = #row.name
        end
    end
    -- One fork reports a within-process spread; more than one reports the interval
    -- across processes and the coverage that interval attains. The heading changes with
    -- the column because the two quantities support entirely different claims, and a
    -- reader who sees "IQR" where they expected an interval should notice.
    local forks = options and options.forks or 1
    local replicated = forks > 1
    local spreadwidth: integer = replicated and 20 or 18
    local spreadheading = replicated and "Interval" or "p25-p99"
    for _, row in ipairs(rows) do
        local cell = (replicated and row.interval or row.spread) or "-"
        if #cell > spreadwidth then
            spreadwidth = #cell as integer
        end
    end
    local pattern = "%-" .. tostring(width) .. "s  %5s  %5s  %10s  %-8s  %12s  %" .. tostring(spreadwidth) .. "s"
    local headings = {
        "Benchmark",
        "Mode",
        replicated and "Forks" or "Cnt",
        "Score",
        "Units",
        "Alloc B/op",
        spreadheading,
    }
    if replicated then
        pattern = pattern .. "  %9s"
        headings[#headings + 1] = "Coverage"
    end
    if ratios then
        pattern = pattern .. "  %8s"
        headings[#headings + 1] = "Ratio"
    end

    local function emit(cells: {string}): string
        if #cells == 7 then
            return pattern:format(cells[1], cells[2], cells[3], cells[4], cells[5], cells[6], cells[7])
        end
        if #cells == 8 then
            return pattern:format(cells[1], cells[2], cells[3], cells[4], cells[5], cells[6], cells[7], cells[8])
        end

        return pattern:format(cells[1], cells[2], cells[3], cells[4], cells[5], cells[6], cells[7], cells[8], cells[9])
    end

    local lines = {emit(headings),}
    for _, row in ipairs(rows) do
        local cells = {
            row.name,
            row.mode,
            (replicated and row.forkcount or row.count) or "0",
            row.score,
            row.units,
            row.allocation,
            (replicated and row.interval or row.spread) or "-",
        }
        if replicated then
            cells[#cells + 1] = row.coverage or "-"
        end
        if ratios then
            cells[#cells + 1] = row.ratio
        end
        lines[#lines + 1] = emit(cells)
    end

    local winners: {any} = {}
    local winnerwidth: integer = #"Workload"
    local variantwidth: integer = #"Winner"
    for _, workload in ipairs(workloads) do
        local winner: string? = nil
        local fastest = math.huge
        local runnerup = math.huge
        local compared: integer = 0
        for _, variant in ipairs(workload.variants) do
            local score = workload.values[variant]
            if score and score > 0 then
                compared = (compared + 1) as integer
                if score < fastest then
                    runnerup = fastest
                    fastest = score
                    winner = variant
                elseif score < runnerup then
                    runnerup = score
                end
            end
        end
        if winner and compared > 1 then
            winners[
                #winners + 1
            ] = {
                workload = workload.label,
                winner = winner,
                speedup = runnerup < math.huge and runnerup / fastest or 1.0,
            }
            winnerwidth = math.max(winnerwidth, #workload.label)
            variantwidth = math.max(variantwidth, #winner)
        end
    end
    if #winners > 0 then
        lines[#lines + 1] = ""
        lines[#lines + 1] = "Winners"
        local winnerpattern = "%-" .. tostring(winnerwidth) .. "s  %-" .. tostring(variantwidth) .. "s  %8s"
        lines[#lines + 1] = winnerpattern:format("Workload", "Winner", "Speedup")
        for _, winner in ipairs(winners) do
            lines[#lines + 1] = winnerpattern:format(winner.workload, winner.winner, ("%.3fx"):format(winner.speedup))
        end
    end

    for _, group in ipairs(geomean and suites or {}) do
        local expected: integer = 0
        for _, workload in ipairs(group.workloads) do
            local basescore = workload.values[group.baseline]
            if basescore and basescore > 0 then
                expected = (expected + 1) as integer
            end
        end
        local summary: {any} = {}
        local summarywidth: integer = #"Variant"
        for _, variant in ipairs(group.variants) do
            local cases: {[string]: any} = {}
            local order: {string} = {}
            local compared: integer = 0
            for _, workload in ipairs(group.workloads) do
                local basescore = workload.values[group.baseline]
                local score = workload.values[variant]
                if basescore and basescore > 0 and score and score > 0 then
                    local name = workload.casename
                    local tally = cases[name]
                    if not tally then
                        tally = {total = 0.0, count = 0}
                        cases[name] = tally
                        order[#order + 1] = name
                    end
                    tally.total = tally.total + math.log(basescore / score)
                    tally.count = (tally.count + 1) as integer
                    compared = (compared + 1) as integer
                end
            end
            if expected > 0 and compared == expected then
                local total = 0.0
                for _, name in ipairs(order) do
                    local tally = cases[name]
                    total = total + tally.total / tally.count
                end
                summary[#summary + 1] = {variant = variant, ratio = math.exp(total / #order),}
                summarywidth = math.max(summarywidth, #variant)
            end
        end
        if #summary > 1 then
            lines[#lines + 1] = ""
            lines[#lines + 1] = "Geometric mean: " .. tostring(group.name) .. " (vs " .. tostring(group.baseline) .. ")"
            local summarypattern = "%-" .. tostring(summarywidth) .. "s  %8s"
            lines[#lines + 1] = summarypattern:format("Variant", "Ratio")
            for _, entry in ipairs(summary) do
                lines[#lines + 1] = summarypattern:format(entry.variant, ("%.3fx"):format(entry.ratio))
            end
        end
    end

    -- The standing note is the part of this table that stops it being over-read. A
    -- single-fork run publishes a number with a spread beside it, and without a
    -- sentence saying what that spread is not, a reader has every reason to treat it
    -- as an error bar and to believe a four percent difference.
    if not replicated then
        lines[#lines + 1] = ""
        lines[#lines + 1] = "note: 1 fork per benchmark. p25-p99 is within-process spread, NOT a confidence"
        lines[#lines + 1] = "      interval: samples inside one process share its heap, traces and thermal"
        lines[#lines + 1] = "      state, so no population interval follows from them. A score far from the"
        lines[#lines + 1] = "      middle of that range means the samples are not centered on it. No interval or"
        lines[
            #lines + 1
        ] = (
            "      verdict is available below %d forks; run --pilot to size a replicated run."
        ):format(statistics.MIN_INTERVAL_SAMPLES)
    end
    for _, note in ipairs(options and options.notes or {}) do
        lines[#lines + 1] = note
    end

    return "\n" .. table.concat(lines, "\n") .. "\n"
end

--- Writes the record, compares it against a baseline when one was named, and raises
--- when a gated counter moved.
---
--- The write happens first on purpose. A case that trips the gate is a case whose
--- record the runner has to merge, or the report says only that something failed.
---
--- Raising is how a status reaches the shell: a chunk's return value is discarded and
--- a run that did not raise exits zero. `os.exit` would also produce one and would
--- discard the run's own profile and trace-abort reports, which are written after the
--- chunk returns.
---
--- @raises string when a gated counter moved, or the record cannot be written
export function report(): nil
    if options.list then
        return
    end
    if reported then
        return
    end
    if options.only and selected == 0 then
        error("nupp: no benchmark named " .. options.only, 0)
    end
    if not options.only and #jobs > 1 then
        error("nupp: this program defines more than one benchmark; use --case NAME or nupp bench", 0)
    end
    reported = true
    local pending = jobs
    jobs = {}
    for _, job in ipairs(pending) do
        job.run()
    end
    local record = buildrecord()
    local encoded = json.encodevalue(recordio.write(record))
    writefile(options.out, encoded)
    if options.json then
        io.stdout:write(encoded, "\n")
    elseif not options.quiet then
        io.stdout:write(format(record))
    end
    if not options.baseline then
        return
    end
    local text = readfile(options.baseline)
    if not text then
        if options.accept then
            writefile(options.baseline, encoded)

            return
        end
        io.stderr:write("nupp: no baseline at " .. options.baseline .. "\n")

        return
    end
    local previous, refused = decode(text, options.baseline)
    if refused then
        if options.accept then
            io.stderr:write(refused, "; replacing it\n")
            writefile(options.baseline, encoded)

            return
        end
        error(refused, 0)
    end
    local failures, uncompared = compare(record, previous)
    for _, note in ipairs(uncompared) do
        io.stderr:write("nupp: uncompared: " .. note .. "\n")
    end
    if options.accept then
        writefile(options.baseline, encoded)

        return
    end
    if #failures > 0 then
        error("nupp: " .. table.concat(failures, "\nnupp: "), 0)
    end
end
