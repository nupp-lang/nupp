module re

--[[
LPeg 1.1's official `re` frontend, bundled so `require("re")` answers it.

This is upstream's Lua source, carried rather than reimplemented: it compiles
`re` pattern text into LPeg patterns at runtime, and its `compile`, `match`,
`find`, `gsub` and `updatelocale` behave exactly as
[LPeg's own documentation](http://www.inf.puc-rio.br/~roberto/lpeg/re.html)
describes. It is here for Lua that already requires it, and because
`nupp.peg.compile` reaches it for a grammar only known at run time.

Write [](nupp.peg) instead. It accepts the same syntax at either phase: a
`comptime` grammar is parsed and validated by the compiler and carries typed
captures, and a genuinely dynamic one compiles through `nupp.peg.compile` and
answers `Peg<...any>`. Both spellings select the same native LPeg feature, so
requiring this module directly buys no portability -- only untyped results.
]]

local tonumber, type, error = tonumber, type, error
local setmetatable = setmetatable
local m = require("lpeg")
local mm = m
local mt: any = getmetatable(mm.P(0))
local any = m.P(1)
local Predef = {nl = m.P"\n"}
local mem;
local fmem;
local gmem
local re = {}

--- Rereads the locale, so the predefined classes follow it.
---
--- `%a`, `%d`, `%s` and the rest of the predefined classes are read out of the
--- locale when this module loads. Call this after changing the locale to rebuild
--- them. It also empties the pattern caches `match`, `find` and `gsub` keep, since
--- a cached pattern still holds the classes it was compiled against.
--- @export
function re.updatelocale()
    mm.locale(Predef)
    Predef.a = Predef.alpha;
    Predef.c = Predef.cntrl;
    Predef.d = Predef.digit
    Predef.g = Predef.graph;
    Predef.l = Predef.lower;
    Predef.p = Predef.punct
    Predef.s = Predef.space;
    Predef.u = Predef.upper;
    Predef.w = Predef.alnum
    Predef.x = Predef.xdigit
    Predef.A = any - Predef.a;
    Predef.C = any - Predef.c;
    Predef.D = any - Predef.d
    Predef.G = any - Predef.g;
    Predef.L = any - Predef.l;
    Predef.P = any - Predef.p
    Predef.S = any - Predef.s;
    Predef.U = any - Predef.u;
    Predef.W = any - Predef.w
    Predef.X = any - Predef.x
    mem = {};
    fmem = {};
    gmem = {};
    local weak = {__mode = "v"}
    setmetatable(mem, weak);
    setmetatable(fmem, weak);
    setmetatable(gmem, weak)
end

re.updatelocale()

local function patt_error(s, i)
    local msg = (#s < i + 20) and s:sub(i) or s:sub(i, i + 20) .. "...";
    error(("pattern error near '%s'"):format(msg), 2)
end

local function mult(p, n)
    local np = mm.P(true);
    while n >= 1 do
        if n % 2 >= 1 then
            np = np * p
        end;
        p = p * p;
        n = n / 2
    end;

    return np
end

local function equalcap(s, i, c)
    if type(c) ~= "string" then
        return nil
    end;
    local e = #c + i;
    if s:sub(i, e - 1) == c then
        return e
    end;

    return nil
end

local S = (Predef.space + "--" * (any - Predef.nl) ^ 0) ^ 0
local name = m.R("AZ", "az", "__") * m.R("AZ", "az", "__", "09") ^ 0
local arrow = S * "<-"
local seq_follow = m.P"/" + ")" + "}" + ":}" + "~}" + "|}" + (name * arrow) + -1
name = m.C(name)
local Def = name * m.Carg(1)

local function getdef(id, defs)
    local c = defs and defs[id];
    if not c then
        error("undefined name: " .. id)
    end;

    return c
end

local function defwithfunc(f)
    return (m.Cg as any)(Def / getdef * m.Cc(f), nil)
end

local num = m.C(m.R"09" ^ 1) * S / tonumber
local String = "'" * m.C((any - "'") ^ 0) * "'" + '"' * m.C((any - '"') ^ 0) * '"'
local defined = "%" * Def / function(c, Defs)
    local cat = Defs and Defs[c] or Predef[c];
    if not cat then
        error("name '" .. c .. "' undefined")
    end;

    return cat
end
local Range = m.Cs(any * (m.P"-" / "") * (any - "]")) / mm.R
local item = (defined + Range + m.C(any)) / m.P
local Class = "[" * (m.C(m.P"^" ^ -1)) * (item * ((item % mt.__add) - "]") ^ 0) / function(c, p)
    return c == "^" and any - p or p
end * "]"

local function adddef(t, k, exp)
    if t[k] then
        error("'" .. k .. "' already defined as a rule")
    else
        t[k] = exp
    end;

    return t
end

local function firstdef(n, r)
    return adddef({n}, n, r)
end

local function NT(n, b)
    if not b then
        error("rule '" .. n .. "' used outside a grammar")
    else
        return mm.V(n)
    end
end

local exp = m.P{
    "Exp",
    Exp = S * (m.V"Grammar" + m.V"Seq" * ("/" * S * m.V"Seq" % mt.__add) ^ 0),
    Seq = (m.Cc(m.P"") * (m.V"Prefix" % mt.__mul) ^ 0) * (#seq_follow + patt_error),
    Prefix = "&" * S * m.V"Prefix" / mt.__len + "!" * S * m.V"Prefix" / mt.__unm + m.V"Suffix",
    Suffix = m.V"Primary" * S * ((
        m.P"+" * m.Cc(
            1,
            mt.__pow
        ) + m.P"*" * m.Cc(
            0,
            mt.__pow
        ) + m.P"?" * m.Cc(
            -1,
            mt.__pow
        ) + m.P"^" * (
            (m.Cg as any)(num * m.Cc(mult)) + (m.Cg as any)(m.C(m.S"+-" * m.R"09" ^ 1) * m.Cc(mt.__pow))
        ) + "->" * S * (
            (m.Cg as any)((String + num) * m.Cc(mt.__div)) + m.P"{}" * m.Cc(nil, m.Ct) + defwithfunc(mt.__div)
        ) + "=>" * S * defwithfunc(mm.Cmt) + ">>" * S * defwithfunc(mt.__mod) + "~>" * S * defwithfunc(mm.Cf)
    ) % function(a, b, f)
        return f(a, b)
    end * S) ^ 0,
    Primary = "(" * m.V"Exp" * ")" + String / mm.P + Class + defined + "{:" * (
        name * ":" + m.Cc(nil)
    ) * m.V"Exp" * ":}" / function(n, p)
        return (mm.Cg as any)(p, n)
    end + "=" * name / function(n)
        return mm.Cmt(mm.Cb(n), equalcap)
    end + m.P"{}" / mm.Cp + "{~" * m.V"Exp" * "~}" / mm.Cs + "{|" * m.V"Exp" * "|}" / mm.Ct + "{" * m.V"Exp" * "}" / (
        mm.C as any
    ) + m.P"." * m.Cc(any) + (name * -arrow + "<" * name * ">") * m.Cb("G") / NT,
    Definition = name * arrow * m.V"Exp",
    Grammar = (m.Cg as any)(m.Cc(true), "G") * ((m.V"Definition" / firstdef) * (m.V"Definition" % adddef) ^ 0) / mm.P
}
local pattern = S * (m.Cg as any)(m.Cc(false), "G") * exp / mm.P * (-any + patt_error)

--- Compiles `re` pattern text into an LPeg pattern.
---
--- An argument that is already an LPeg pattern is handed back unchanged, so a
--- caller may accept either spelling. Nothing is cached here: `match`, `find` and
--- `gsub` keep their own caches, and a pattern compiled with definitions is not
--- a function of its text alone.
---
--- @param p the pattern text, or an LPeg pattern to pass through
--- @param defs the values `%name` and the `->`, `=>`, `>>` and `~>` actions refer
---     to by name, or nil when the pattern names none
--- @return the compiled LPeg pattern
--- @raises when the text is not a well-formed pattern, or names something `defs`
---     does not define
--- @export
function re.compile(p, defs): any
    if mm.type(p) == "pattern" then
        return p
    end;
    local cp = pattern:match(p, 1, defs);
    if not cp then
        error("incorrect pattern", 3)
    end;

    return cp
end

--- Matches a pattern against `s`, anchored at `i`.
---
--- The pattern has to match at the starting position rather than somewhere after
--- it; `find` is the searching form. Compiled patterns are cached weakly by their
--- text, so repeating one does not recompile it. A pattern needing definitions
--- cannot be spelled here, because the cache is keyed by text alone: compile it
--- with `compile` and match the result.
---
--- @param s the subject bytes
--- @param p the pattern text, or an LPeg pattern
--- @param i the 1-based position to match at, or nil for the beginning
--- @return the pattern's captures, or the position after the match when it
---     captures nothing, or nil when it does not match
--- @raises when the text is not a well-formed pattern
--- @export
function re.match(s, p, i): ...any
    local cp = mem[p];
    if not cp then
        cp = re.compile(p);
        mem[p] = cp
    end;

    return cp:match(s, i or 1)
end

--- Searches `s` for the first position at or after `i` where the pattern matches.
---
--- The pattern's own captures are discarded: what a search answers is where the
--- match is, and a caller wanting the captures matches at the position it reports.
---
--- @param s the subject bytes
--- @param p the pattern text, or an LPeg pattern
--- @param i the 1-based position to begin searching at, or nil for the beginning
--- @return the 1-based positions the match begins and ends at, both inclusive, or
---     nil when the pattern matches nowhere at or after `i`
--- @raises when the text is not a well-formed pattern
--- @export
function re.find(s, p, i): ((integer, integer) | (nil))
    local cp = fmem[p];
    if not cp then
        cp = re.compile(p) / 0;
        cp = mm.P{mm.Cp() * cp * mm.Cp() + 1 * mm.V(1)};
        fmem[p] = cp
    end;
    local first, ending = cp:match(s, i or 1);
    if first then
        return first, ending - 1
    end;

    return first
end

--- Replaces every match of the pattern in `s`.
---
--- @param s the subject bytes
--- @param p the pattern text, or an LPeg pattern
--- @param rep a replacement string, a table the first capture indexes, or a
---     function of the captures
--- @return the subject with every match replaced
--- @raises when the text is not a well-formed pattern
--- @export
function re.gsub(s, p, rep): string
    local g = gmem[p] or {};
    gmem[p] = g;
    local cp = g[rep];
    if not cp then
        cp = re.compile(p);
        cp = (mm.Cs as any)((cp / rep + 1) ^ 0);
        g[rep] = cp
    end;

    return cp:match(s)
end

export = re
