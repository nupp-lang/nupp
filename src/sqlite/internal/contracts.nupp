    [6410] = "SQLITE_IOERR_GETTEMPPATH",
    [6666] = "SQLITE_IOERR_CONVPATH",
    [6922] = "SQLITE_IOERR_VNODE",
    [7178] = "SQLITE_IOERR_AUTH",
    [7434] = "SQLITE_IOERR_BEGIN_ATOMIC",
    [7690] = "SQLITE_IOERR_COMMIT_ATOMIC",
    [7946] = "SQLITE_IOERR_ROLLBACK_ATOMIC",
    [8202] = "SQLITE_IOERR_DATA",
    [8458] = "SQLITE_IOERR_CORRUPTFS",
    [8714] = "SQLITE_IOERR_IN_PAGE",
    [8970] = "SQLITE_IOERR_BADKEY",
    [9226] = "SQLITE_IOERR_CODEC",
}

--- The symbolic name of a result code: its own when SQLite documents it,
--- else its primary code's with the number, as in `SQLITE_IOERR(4874)`.
export function codename(code: integer): string
    local name = NAMES[code]
    if name ~= nil then
        return name
    end
    local primary = NAMES[code & 0xff]
    if primary ~= nil then
        return primary .. "(" .. tostring(code) .. ")"
    end

    return "SQLITE_UNKNOWN(" .. tostring(code) .. ")"
end

--- The error for a failed call: its extended code, SQLite's message, the SQL
--- text it was given, and the offset SQLite reported in that text, when any.
export function failure(code: integer, message: string, sql: string?, offset: integer?): Error
    return Error(
        code = code,
        primary = code & 0xff,
        name = codename(code),
        message = message,
        sql = sql,
        offset = offset
    )
end

--- A prepared statement. Closing it finalizes it.
export interface Statement is own.Closeable
    close: function(takes self: Statement): nil

    --- How many parameters it takes.
    parametercount: function(self: Statement): integer

    --- The index of a parameter named with its prefix (`:name`), or zero.
    parameterindex: function(self: Statement, name: string): integer

    --- The name of a parameter, with its prefix, or nil for a positional one.
    parametername: function(self: Statement, index: integer): string?

    bindnull: function(exclusive self: Statement, index: integer): nil
    bindinteger: function(exclusive self: Statement, index: integer, value: integer): nil
    bindfloat: function(exclusive self: Statement, index: integer, value: number): nil
    bindtext: function(exclusive self: Statement, index: integer, value: string): nil
    bindblob: function(exclusive self: Statement, index: integer, value: string): nil

    --- Steps it: true while a row is ready, false once it is done.
    step: function(exclusive self: Statement): boolean

    reset: function(exclusive self: Statement): nil
    clearbindings: function(exclusive self: Statement): nil

    --- How many columns a row has.
    columncount: function(self: Statement): integer

    columnname: function(self: Statement, index: integer): string
    columntype: function(self: Statement, index: integer): StorageClass

    --- The column's value in the current row, copied: an integer, a float,
    --- the exact bytes of text or a blob, or nil for NULL.
    column: function(self: Statement, index: integer): Column?
end

--- An open connection. Closing it closes SQLite's once every statement
--- prepared on it is finalized.
export interface Database is own.Closeable
    close: function(takes self: Database): nil

    --- Prepares the first statement of `sql` from byte `offset`, from zero,
    --- and answers it, or nil when the rest is only whitespace and comments,
    --- and how many bytes from `offset` it consumed. A failure's offset is
    --- into the whole of `sql`.
    prepare: function(self: Database, sql: string, offset: integer): (Statement?, integer)

    changes: function(self: Database): integer
    totalchanges: function(self: Database): integer
    lastrowid: function(self: Database): integer

    --- Whether no transaction is open.
    autocommit: function(self: Database): boolean
end

--- Binds SQLite on a host.
export interface Provider
    --- Opens a connection, writable or not, creating the file or not, that
    --- waits up to `busytimeout` milliseconds for a lock.
    open: function(path: string, readonly: boolean, create: boolean, busytimeout: integer): Database

    --- The library's version text.
    version: function(): string

    --- How many connections and statements are open.
    openhandles: function(): integer
end
