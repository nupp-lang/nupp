@!internal
--[[
What the `sqlite` library asks of the provider that binds SQLite on a host,
and the error both raise. The native core's is
`nupp.runtime.provider.nativesqlite`.

A provider raises an [](Error) for a call SQLite failed, copies every value
out of SQLite's memory before answering it, and counts the connections and
statements it holds open. Columns and parameters are numbered as SQLite
numbers them here: columns from zero, parameters from one.
]]
module sqlite.internal.contracts

--- A storage class, as SQLite names the five.
export type StorageClass = "integer" | "float" | "text" | "blob" | "null"

--- A value a column holds: nil for NULL.
export type Column = integer | number | string

--- A failed SQLite call.
export record Error
    --- SQLite's extended result code, such as 2067 for
    --- `SQLITE_CONSTRAINT_UNIQUE`.
    @readonly code: integer

    --- The primary result code, `code & 0xff`: 19 for any constraint.
    @readonly primary: integer

    --- The symbolic name of `code`, such as `SQLITE_CONSTRAINT_UNIQUE`.
    @readonly name: string

    --- SQLite's message.
    @readonly message: string

    --- The SQL text the failing call was given, when there was one.
    @readonly sql: string?

    --- The byte offset into `sql`, from zero, of the token SQLite failed
    --- at, when it reports one.
    @readonly offset: integer?

    --- Failures raised while handling this one, such as a rollback that
    --- failed after it.
    @readonly suppressed: const{unknown} = {}

    --- Renders the name, the message, and the offset when there is one, as in
    --- `SQLITE_ERROR: near "frm": syntax error (at byte 9)`.
    metamethod __tostring: function(self): string
end

Error.__tostring = function(self: Error): string
    local at = self.offset ~= nil and " (at byte " .. tostring(self.offset) .. ")" or ""
    local suppressed = #self.suppressed > 0 and " (suppressed " .. tostring(#self.suppressed) .. " later failure)" or ""
    return self.name .. ": " .. self.message .. at .. suppressed
end

-- The documented result codes, primary and extended, by number.
local NAMES: {
    [integer]: string
} = {
    [0] = "SQLITE_OK",
    [1] = "SQLITE_ERROR",
    [2] = "SQLITE_INTERNAL",
    [3] = "SQLITE_PERM",
    [4] = "SQLITE_ABORT",
    [5] = "SQLITE_BUSY",
    [6] = "SQLITE_LOCKED",
    [7] = "SQLITE_NOMEM",
    [8] = "SQLITE_READONLY",
    [9] = "SQLITE_INTERRUPT",
    [10] = "SQLITE_IOERR",
    [11] = "SQLITE_CORRUPT",
    [12] = "SQLITE_NOTFOUND",
    [13] = "SQLITE_FULL",
    [14] = "SQLITE_CANTOPEN",
    [15] = "SQLITE_PROTOCOL",
    [16] = "SQLITE_EMPTY",
    [17] = "SQLITE_SCHEMA",
    [18] = "SQLITE_TOOBIG",
    [19] = "SQLITE_CONSTRAINT",
    [20] = "SQLITE_MISMATCH",
    [21] = "SQLITE_MISUSE",
    [22] = "SQLITE_NOLFS",
    [23] = "SQLITE_AUTH",
    [24] = "SQLITE_FORMAT",
    [25] = "SQLITE_RANGE",
    [26] = "SQLITE_NOTADB",
    [27] = "SQLITE_NOTICE",
    [28] = "SQLITE_WARNING",
    [100] = "SQLITE_ROW",
    [101] = "SQLITE_DONE",
    [256] = "SQLITE_OK_LOAD_PERMANENTLY",
    [257] = "SQLITE_ERROR_MISSING_COLLSEQ",
    [261] = "SQLITE_BUSY_RECOVERY",
    [262] = "SQLITE_LOCKED_SHAREDCACHE",
    [264] = "SQLITE_READONLY_RECOVERY",
    [266] = "SQLITE_IOERR_READ",
    [267] = "SQLITE_CORRUPT_VTAB",
    [270] = "SQLITE_CANTOPEN_NOTEMPDIR",
    [275] = "SQLITE_CONSTRAINT_CHECK",
    [279] = "SQLITE_AUTH_USER",
    [283] = "SQLITE_NOTICE_RECOVER_WAL",
    [284] = "SQLITE_WARNING_AUTOINDEX",
    [512] = "SQLITE_OK_SYMLINK",
    [513] = "SQLITE_ERROR_RETRY",
    [516] = "SQLITE_ABORT_ROLLBACK",
    [517] = "SQLITE_BUSY_SNAPSHOT",
    [518] = "SQLITE_LOCKED_VTAB",
