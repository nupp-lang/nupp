module types

--[[
`types` provides type builders, typed keys, stores, and generated debug formatting.
Compiler-only builders run inside `@comptime` functions.

```nupp
const theme: types.Key<string> = types.newKey("app.theme")
const store = types.newStore()
store:set(theme, "dark")
assert(store:get(theme) == "dark")
```

See [derives.md](docs/reference/derives.md) for [](Debug),
[](types.derive) for recipes, and [](types.reflect) for reflection.
]]
const types2 = require("types")
const derive = require("types.derive")

local store = require("nupp.util.internal.store")
local runtime = require("nupp.derive")

--- The interface implemented by the Debug provider.
export type Debug = nupp.__Debug

--- A typed identity for a value in a [](Store).
export type Key<T> = store.Key<T>

export const Key = store.Key

--- An independent typed bag indexed by keys.
export type Store = store.Store

--- Registers a new key, optionally under a name.
export const newKey = store.newKey

--- Creates an empty store.
export const newStore = store.newStore

@comptime
local function option(items, annotationName: string, name: string): any
    for _, item in ipairs(items) do
        if item.name == annotationName then
            for index, argument in ipairs(item.arguments) do
                if argument.name == name or name == "value" and index == 1 then
                    return argument.value
                end
            end
        end
    end

    return nil
end

@comptime
local function detail(T: type): any
    local value = types2.describe(T)
    if value.sourceKind then
        local normalized = {}
        for key, item in pairs(value) do
            normalized[key] = item
        end
        normalized.kind = value.sourceKind
        return normalized
    end

    return value
end

@comptime
local function Optional(T: type): type?
    local value = detail(T)
    if value.kind ~= "union" then
        return nil
    end
    local rest = {}
    for _, member in ipairs(value.members or {}) do
        local memberDetail = detail(member)
        if not (memberDetail.kind == "primitive" and memberDetail.name == "nil") then
            rest[#rest + 1] = member
        end
    end
    if #rest == 1 then
        return rest[1]
    end

    return nil
end

@comptime
local function debugSpec(T: type, contract: type): any
    local inner = Optional(T)
    if inner ~= nil then
        return {kind = "optional", value = debugSpec(inner, contract)}
    end
    local value = detail(T)
    if value.kind == "literal" then
        return {kind = "literal", value = value.value}
    end
    if value.kind == "primitive" then
        if value.name == "nil"
            or value.name == "boolean"
            or value.name == "string"
            or value.name == "number"
            or value.name == "integer"
            or value.name == "float"
            or value.name:find("int", 1, true)
            or value.name:find("uint", 1, true)
        then
            return {kind = value.name}
        end
    elseif value.kind == "array" then
        return {kind = "array", value = debugSpec(value.element, contract)}
    elseif value.kind == "map" then
        return {kind = "map", key = debugSpec(value.readKey, contract), value = debugSpec(value.readValue, contract)}
    elseif value.kind == "tuple" then
        local items = {}
        for index, member in ipairs(value.members or {}) do
            items[index] = debugSpec(member, contract)
        end
        return {kind = "tuple", items = items}
    elseif value.kind == "shape" then
        local fields = {}
        for index, field in ipairs(value.fields or {}) do
            local fieldType = field.read
            if fieldType == nil then
                fieldType = field.write
            end
            fields[index] = {name = field.name, type = debugSpec(fieldType, contract)}
        end
        return {kind = "shape", fields = fields}
    elseif value.kind == "reference" and value.nominal then
        if value.nominal.deriveKey and derive.claims(T, contract) then
            return {kind = "record", typeKey = value.nominal.deriveKey}
        elseif derive.claims(T, contract) then
            return {kind = "customDebug"}
        end
    end

    return nil
end

--- Generates deterministic debug formatting for a record or struct.
--- Field annotations can skip a value or redact it while retaining its name.
--- @param info the declaration the provider inspects
--- @return the checked forwarding recipe
@comptime
export function Debug(info: types.derive.Info): types.derive.Result<types.Debug>
    if info.kind ~= "record" and info.kind ~= "struct" then
        return derive.error("Debug can be derived only for records or structs", info.reference, "NUPP2803")
    end
    for _, field in ipairs(info.fields) do
        local skip = option(field.annotations, "debug", "skip") == true
        local redact = option(field.annotations, "debug", "redact") == true
        if skip and redact then
            return derive.error(
                "field " .. field.name .. " cannot be both skipped and redacted",
                field.reference,
                "NUPP2803"
            )
        end
        if field.name ~= "debug" and not skip and not redact and not debugSpec(field.readType, info.interfaceType) then
            return derive.error("field type cannot be formatted by Debug", field.reference, "NUPP2803")
        end
    end

    return derive.implement{
        methods = {
            debug = derive.forward{
                helper = derive.helper(runtime, "debug"),
                arguments = {derive.witness(info.ownerType), derive.receiver()},
            }
        },
    }
end
