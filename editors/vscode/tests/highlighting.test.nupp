local function render(task: Task): string
-- <- storage.modifier.local.nupp
--    ^^^^^^^^ storage.type.function.nupp
--             ^^^^^^ entity.name.function.nupp
   local suffix = task.title ~= '' and `title: ${task.title}` or 'none'
--                           ^^ keyword.operator.nupp
--                              ^^ string.quoted.single.nupp
--                                     ^^^^^^^^^^^^^^^^^^^^^ string.quoted.other.interpolated.nupp
--                                             ^^ punctuation.section.interpolation.begin.nupp
--                                               ^^^^ source.nupp.embedded
   return task.id > 0 ? suffix : "missing"
-- ^^^^^^ keyword.control.nupp
--                    ^ keyword.operator.nupp
--                               ^^^^^^^^^ string.quoted.double.nupp
end

local function isTask(value: Task): value is Task
--                                        ^^ keyword.control.nupp
   return value is Task
--              ^^ keyword.operator.word.nupp
end

--- Renders one task.
-- <- comment.line.documentation.nupp
--- @param task the task to render
--  ^^^^^^^^^^^ comment.line.documentation.nupp
--- @return the rendered title
--  ^^^^^^^^^^^^ comment.line.documentation.nupp
--- ```nupp
--  ^^^ punctuation.definition.markdown.nupp
--     ^^^^ fenced_code.block.language.nupp
--- local function renderExample(value: Task): string
--  ^^^^^ storage.modifier.local.nupp
--        ^^^^^^^^ storage.type.function.nupp
--                 ^^^^^^^^^^^^^ entity.name.function.nupp
--  ^^^^^ source.nupp.embedded
---    return value.title
--     ^^^^^^ keyword.control.nupp
--- end
--  ^^^ keyword.control.nupp
--- ```
--  ^^^ punctuation.definition.markdown.nupp
local function documented(task: Task): string
   return task.title
end

