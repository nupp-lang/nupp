{
  "comments": {
    "lineComment": "--"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "`", "close": "`", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["'", "'"],
    ["\"", "\""],
    ["`", "`"]
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*|(?:0[xX][0-9A-Fa-f]+|[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eEpP][+-]?[0-9]+)?(?:[uU]?[lL][lL]|[iI])?",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:(?:if|elseif|while|for)\\b.*\\b(?:then|do)|(?:(?:local|const)\\s+)?function\\b(?!.*\\bend\\b).*|repeat\\b(?!.*\\buntil\\b).*|do\\b(?!.*\\bend\\b).*|local\\s+(?:record|interface|struct|enum)\\b(?!.*\\bend\\b).*|.*[({\\[])\\s*(?:--.*)?$",
    "decreaseIndentPattern": "^\\s*(?:(?:end|else|elseif|until)\\b|[})\\]])"
  }
}
