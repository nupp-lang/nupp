{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nupp embedded JSON",
  "scopeName": "source.nupp.embedded.json",
  "patterns": [
    { "include": "source.json" },
    { "name": "string.quoted.double.json", "begin": "\\\"", "end": "\\\"" },
    { "name": "constant.numeric.json", "match": "-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?" },
    { "name": "constant.language.json", "match": "\\b(?:true|false|null)\\b" },
    { "name": "punctuation.definition.json", "match": "[{}\\[\\],:]" }
  ]
}
