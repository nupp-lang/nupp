{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "nupp",
  "description": "Nupp editor tooling for Claude Code",
  "owner": {
    "name": "Nupp"
  },
  "plugins": [
    {
      "name": "nupp-lsp",
      "description": "Nupp language server, for code intelligence over .nupp files",
      "version": "0.1.0",
      "source": "./plugins/nupp-lsp",
      "category": "development",
      "strict": false,
      "lspServers": {
        "nupp": {
          "command": "nupp",
          "args": ["lsp", "serve"],
          "extensionToLanguage": {
            ".nupp": "nupp"
          }
        }
      }
    }
  ]
}
