-- Browser providers keep the Nupp API in checked source. Their work crosses
-- one suspension boundary to the application Worker and its browser APIs.

local time = require("coroutine")
local mac = require("binary").Mac
local digests = require("binary").Digest

time.sleep(10)
local key = os.uuid4()
local digest = digests.computehex("sha256", os.randombytes(32))
print(key, digest)
print(mac.computehex("hmac-sha256", "key", "browser message"))

-- try breaking it: pass a negative count to randombytes and read the checked
