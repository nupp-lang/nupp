-- Browser providers keep the Nupp API in checked source. Their work crosses
-- one suspension boundary to the application Worker and its browser APIs.

coroutine.sleep(10)
local key = os.uuid(4)
local digest = binary.Digest.computehex("sha256", os.randombytes(32))
print(key, digest)
print(binary.Mac.computehex("hmac-sha256", "key", "browser message"))

