local byteapi = require("bytes")

-- Browser providers keep the Nupp API in checked source. Their work crosses
-- one suspension boundary to the application Worker and its browser APIs.

coroutine.sleep(10)
local key = os.uuid(4)
local digest = byteapi.digest("sha256"):computehex(os.randombytes(32))
print(key, digest)
print(byteapi.mac("hmac-sha256"):computehex("key", "browser message"))

-- try breaking it: pass a negative count to randombytes and read the checked
-- provider error
