-- Browser providers keep the Nupp API in checked source. Their work crosses
-- one suspension boundary to the application Worker and its browser APIs.

local crypto = require("nupp.crypto")
local storage = require("nupp.io.storage")
local time = require("nupp.time")
local mac = require("nupp.mac")
local digests = require("nupp.digest")
local uuid = require("nupp.uuid")

time.sleep(10)
local key = uuid.v4()
local digest = digests.hexDigest("sha256", crypto.randomBytes(32))
storage.set(key, digest)
print(key, storage.get(key))
print(mac.hexDigest("hmac-sha256", "key", "browser message"))
storage.remove(key)

-- try breaking it: pass a negative count to randomBytes, or an empty storage
-- key, and read the checked provider error
