-- Select a value binding independently of its wire format.
local serde = require("nupp.serde")
local json = require("nupp.serde.json")
local documents = require("nupp.serde.document")

local record User
    id: uint32
    name: string?
    tags: {string}?
end

local users = serde.binding(User)
local bytes = json.encode(users, new User(id = 41, name = "Ada", tags = {"admin"}))
print(bytes)
local restored = json.decode(users, bytes)
print(restored.id, restored.name or "anonymous")

-- Documents preserve data without choosing an application declaration.
local contents = documents.documentAdapter():contents()
local loose = json.decodeDocument(documents.documentAdapter(), [[{"ok":true,"count":3}]])
print(json.encode(contents, loose))

-- Try decoding [[{"id":"41"}]] or assigning a number to tags.
