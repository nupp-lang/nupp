-- This runs a real WebGPU compute shader in the playground's application
-- Worker. Each input word becomes one invocation; the shader xors it with the
-- mask, then the Worker copies the result back before `xorU32` returns.
--
-- The first browser GPU profile uses uint32 values so its CPU and GPU meanings
-- agree bit-for-bit. It is deliberately a small runnable step toward the
-- compiler-emitted @aot(target = "gpu") backend.

local gpu = require("nupp.gpu")

local u32 = nupp.math.u32.wrap
local input: {uint32} = {u32(0x00000000), u32(0x00ff00ff), u32(0x12345678), u32(0xffffffff),}
local output = gpu.xorU32(input, u32(0xa5a5a5a5))

for index, value in ipairs(output) do
    print(('%d: 0x%08x'):format(index, value))
end

-- try breaking it: pass a negative or non-integer value, or change the mask
-- and rerun to see the same operation carried out by every GPU invocation
