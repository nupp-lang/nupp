const {type Invocation} = require("nupp.bench")

--- OPT-1 presizing, measured through `nupp.bench`.
---
--- The Lua benchmark beside this one compares hand-written compiler output; this
--- compares what the compiler actually emits for the same two shapes, which is the
--- thing that can regress. `bench.keep` is what stops the loop being deleted: an
--- earlier version of `bench/presize.lua` measured LuaJIT removing it.
---
--- Run: nupp run bench/run.nupp --file bench/presize.bench.nupp
local bench = require("nupp.bench")

local function grown(_: any, _: Invocation): nil
    for _ = 1, 100000 do
        local point: {[string]: integer} = {}
        point.x = 1
        point.y = 2
        point.z = 3
        point.w = 4
        bench.keep(point)
    end
end

local function sized(_: any, _: Invocation): nil
    for _ = 1, 100000 do
        bench.keep({x = 1, y = 2, z = 3, w = 4})
    end
end

bench.suite(
    {
        name = "presize",
        baselineVariant = "grown",
        variants = {{name = "grown", run = grown}, {name = "sized", run = sized},},
        cases = {{name = "point", operations = 100000},},
        warmupIterations = 2,
    } as bench.SuiteOptions
)
bench.report()
