module jobs

export record Payload
    id: integer
    label: string
    bytes: string
end

export function identity(value: integer): integer
    return value
end

export function echoText(value: string): string
    return value
end

export function echoPayload(value: Payload): Payload
    return value
end

export function echoDynamic(value: any): any
    return value
end

export record Sparse
    id: integer
    label: string
    bytes: string
    note: string?
end

export function echoSparse(value: Sparse): Sparse
    return value
end

const sharedbytes = io.Bytes

export function regionSize(corpus: io.Bytes): integer
    return corpus:len()
end

export function countRange(corpus: io.Bytes, offset: integer, count: integer): integer
    const bytes = corpus:view(offset, count)
    local count: integer = 0
    for index = 1, #bytes do
        if bytes[index] == 0x0A then
            count = count + 1
        end
    end

    return count
end

export function countText(value: string): integer
    local count: integer = 0
    for index = 1, #value do
        if value:byte(index) == 0x0A then
            count = count + 1
        end
    end

    return count
end

const heap = require("nupp.mem.heap")

export function bounce(takes frame: heap.Array<uint8>): affine(heap.Array<uint8>, heap.destroyarray)
    return frame
end

export function bump(takes frame: heap.Array<uint8>, seed: integer): affine(heap.Array<uint8>, heap.destroyarray)
    local writable = frame:write()
    writable[1] = seed % 256
    own.drop(writable)

    return frame
end

export function burn(iterations: integer): number
    local value = 1.0
    for index = 1, iterations do
        value = value * 1.0000001 + index % 7
    end

    return value
end
