local record Point
    x: number
    y: number
    name: string

    function length(self: Point): number
        return self.x * self.x + self.y * self.y
    end
end

local function describe(p: Point): string
    return p.name .. "!"
end

local function total(points: {Point}): number
    local sum = 0
    for i = 1, #points do
        sum = sum + points[i]:length()
    end
    return sum
end

local function fromAny(value: any): number
    local p = value as Point
    return p.x
end

local function safe(value: any): boolean
    local ok = pcall(fromAny, value)
    return ok
end

local function main(): number
    local points: {Point} = {}
    for i = 1, 100 do
        points[i] = new Point(x = i, y = i * 2, name = "p" .. i)
    end
    local t = total(points)
    local labels: {[string]: boolean} = {}
    labels[describe(points[1])] = true
    local bad: any = 5
    if safe(points[2]) and not safe(bad) and labels["p1!"] then
        return t
    end
    return -1
end

--- Builds the points once and sums them two hundred times: the typed tier's
--- share of the program, with the allocation loop amortised away.
local function hot(): number
    local points: {Point} = {}
    for i = 1, 100 do
        points[i] = new Point(x = i, y = i * 2, name = "p")
    end
    local t = 0
    for _ = 1, 200 do
        t = t + total(points)
    end
    return t
end

return {main = main, hot = hot}
