-- The AoS loop the reification thesis rests on, written in Nupp and
-- raced against the plain-table code the same program would otherwise be.
-- Run: nupp run bench/aos.nupp

local struct Particle
    x: number
    y: number
    z: number
    vx: number
    vy: number
    vz: number
end

local N: number = 200000
local STEPS: number = 60
local ROUNDS: number = 5

local function median(times: {number}): number
    table.sort(times)
    return times[math.ceil(#times / 2)]
end

-- reified: one contiguous block of Particle
local function runStruct(): number
    local ps = carray(Particle, N)
    unsafe do
        -- This benchmark deliberately measures the raw carray lowering. N is
        -- both the allocation bound and the loop bound; the unsafe boundary
        -- records that invariant without adding a checked-view cost to one arm.
        for i = 0, N - 1 do
            ps[i].x = i
            ps[i].y = i * 2
            ps[i].vx = 0.1
            ps[i].vy = 0.2
            ps[i].vz = 0.3
        end
    end
    local times: {number} = {}
    for r = 0, ROUNDS do
        local t0 = os.clock()
        local dt = 1 / 60
        unsafe do
            for _ = 1, STEPS do
                for i = 0, N - 1 do
                    local p = ps[i]
                    p.x = p.x + p.vx * dt
                    p.y = p.y + p.vy * dt
                    p.z = p.z + p.vz * dt
                end
            end
        end
        if r > 0 then
            table.insert(times, os.clock() - t0)
        end
    end

    return median(times)
end

-- the same program written with tables
local function runTables(): number
    local ps = {}
    for i = 1, N do
        ps[i] = {x = i, y = i * 2, z = 0, vx = 0.1, vy = 0.2, vz = 0.3}
    end
    local times: {number} = {}
    for r = 0, ROUNDS do
        local t0 = os.clock()
        local dt = 1 / 60
        for _ = 1, STEPS do
            for i = 1, N do
                local p = ps[i]
                p.x = p.x + p.vx * dt
                p.y = p.y + p.vy * dt
                p.z = p.z + p.vz * dt
            end
        end
        if r > 0 then
            table.insert(times, os.clock() - t0)
        end
    end

    return median(times)
end

local tables = runTables()
local structs = runStruct()
print(("tables  %7.1f ms"):format(tables * 1000))
print(("carray  %7.1f ms"):format(structs * 1000))
print(("speedup %7.1fx"):format(tables / structs))
