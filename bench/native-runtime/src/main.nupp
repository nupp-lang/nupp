const http = require("nupp.io.http")
const bytesIO = require("nupp.io")
const array = require("nupp.mem.array")
const net = require("nupp.io.net")
const processes = require("nupp.io.process")
const span = require("nupp.mem.span")
const time = require("nupp.time")
const tls = require("nupp.io.tls")
const uri = require("nupp.io.uri")

const SAMPLES = 9
const WARMUPS = 2
const NET_LATENCY_ROUNDS = 1000
const NET_THROUGHPUT_CHUNKS = 256
const HTTP_LATENCY_REQUESTS = 300
const HTTP_THROUGHPUT_REQUESTS = 8
const CHUNK_BYTES = 64 * 1024
const LARGE_HTTP_BYTES = 4 * 1024 * 1024
const COPY_SAMPLES = 5
const COPY_WARMUPS = 1
local COPY_BYTES: {integer} = {64, 1024, 64 * 1024, 1024 * 1024, 16 * 1024 * 1024}

-- The operating-system PID, not the process identity assigned by a shell or
-- C runtime. Under MSYS, `_getpid` returns an MSYS identity while Get-Process
-- requires the Win32 PID returned by GetCurrentProcessId.
local function nativeProcessId(): integer
    const ffi = require("ffi")
    local declared: boolean
    local read: boolean
    local pid: any
    if package.config:sub(1, 1) == "\\" then
        -- DWORD is `unsigned long` in the Windows API. Keep __stdcall for the
        -- 32-bit ABI; LuaJIT treats it as a no-op on Win64.
        declared = pcall(ffi.cdef, "unsigned long __stdcall GetCurrentProcessId(void);")
        read, pid = pcall(function(): integer
            const kernel32 = ffi.load("kernel32")

            return kernel32.GetCurrentProcessId() as integer
        end)
    else
        declared = pcall(ffi.cdef, "int getpid(void);")
        read, pid = pcall(function(): integer
            return ffi.C.getpid() as integer
        end)
    end
    if not declared or not read or type(pid) ~= "number" then
        error("native runtime benchmark could not read its process ID")
    end
    local processId = pid as integer
    if processId < 1 then
        error("native runtime benchmark requires a positive process ID")
    end

    return processId
end

local function median(values: {number}): number
    table.sort(values)

    return values[math.ceil(#values / 2)] as number
end

local function readExactly(exclusive stream: bytesIO.Reader, wanted: integer): nil
    local received: integer = 0
    while received < wanted do
        const chunk, why = stream:read(wanted - received)
        if chunk == nil then
            error(why or "network read failed")
        end
        if #chunk == 0 then
            error("network peer ended before the expected bytes arrived")
        end
        received = received + (#chunk as integer)
    end
end

local function readExactlyInto(exclusive stream: bytesIO.Reader, exclusive output: bytesIO.Buffer, wanted: integer): nil
    output:clear()
    local received: integer = 0
    while received < wanted do
        const count, why = stream:readInto(output, received, wanted - received)
        if count == nil then
            error(why or "network readInto failed")
        elseif count == 0 then
            error("network peer ended before the expected bytes arrived")
        end
        received = received + count
    end
end

local function readExactlySpan(exclusive stream: bytesIO.Reader, wanted: integer): nil
    local bytes = array.bytes(wanted)
    local output = bytes:write()
    local received: integer = 0
    while received < wanted do
        const count, why = stream:readSpan(output)
        if count == nil then
            error(why or "network readSpan failed")
        elseif count == 0 then
            error("network peer ended before the expected bytes arrived")
        end
        received = received + count
    end
    nupp.drop(output)
end

local function networkLatency(): number
    local listener = assert(net.listen({host = "127.0.0.1", port = 0}))
    local client = assert(net.connect({host = "127.0.0.1", port = listener:port(), sendHighWater = CHUNK_BYTES}))
    local served = assert(listener:accept())
    assert(client:setNoDelay(true))
    assert(served:setNoDelay(true))
    local samples: {number} = {}
    for sample = 1, SAMPLES + WARMUPS do
        const started = time.now()
        for _ = 1, NET_LATENCY_ROUNDS do
            assert(client:write("q"))
            readExactly(served, 1)
            assert(served:write("r"))
            readExactly(client, 1)
        end
        if sample > WARMUPS then
            samples[#samples + 1] = time.now() - started
        end
    end
    served:close()
    client:close()
    listener:close()

    return median(samples) * 1000 / NET_LATENCY_ROUNDS
end

local function networkThroughput(): number
    local listener = assert(net.listen({host = "127.0.0.1", port = 0}))
    local client = assert(net.connect({host = "127.0.0.1", port = listener:port(), sendHighWater = CHUNK_BYTES}))
    local served = assert(listener:accept())
    const first = ("abcdefgh"):rep(CHUNK_BYTES / 8)
    const second = ("hgfedcba"):rep(CHUNK_BYTES / 8)
    local samples: {number} = {}
    for sample = 1, SAMPLES + WARMUPS do
        const started = time.now()
        for chunk = 1, NET_THROUGHPUT_CHUNKS do
            const payload = chunk % 2 == 0 and first or second
            assert(client:write(payload))
            readExactly(served, #payload as integer)
        end
        const elapsed = time.now() - started
        if sample > WARMUPS then
            samples[#samples + 1] = CHUNK_BYTES * NET_THROUGHPUT_CHUNKS / elapsed / 1048.576
        end
    end
    served:close()
    client:close()
    listener:close()

    return median(samples)
end

local function networkCopyThroughput(path: string, payloadBytes: integer): number
    local listener = assert(net.listen({host = "127.0.0.1", port = 0}))
    local client = assert(net.connect({host = "127.0.0.1", port = listener:port(), sendHighWater = CHUNK_BYTES}))
    local served = assert(listener:accept())
    local output = bytesIO.newBuffer(CHUNK_BYTES)
    const payload = ("abcdefgh"):rep(CHUNK_BYTES / 8)
    const chunkPayload = payload:sub(1, math.min(payloadBytes, CHUNK_BYTES))
    const input = span.fromString(chunkPayload)
    local samples: {number} = {}
    for sample = 1, COPY_SAMPLES + COPY_WARMUPS do
        local remaining = payloadBytes
        const started = time.now()
        while remaining > 0 do
            local taking = math.min(remaining, CHUNK_BYTES)
            if path == "string" then
                assert(client:write(chunkPayload))
                readExactly(served, taking)
            else
                local chunk = input:slice(1, taking)
                assert(client:writeSpan(chunk) == taking)
                if path == "span" then
                    readExactlySpan(served, taking)
                else
                    readExactlyInto(served, output, taking)
                end
            end
            remaining = remaining - taking
        end
        const elapsed = time.now() - started
        if sample > COPY_WARMUPS then
            samples[#samples + 1] = payloadBytes / elapsed / 1048.576
        end
    end
    output:close()
    served:close()
    client:close()
    listener:close()

    return median(samples)
end

local function networkSplitThroughput(payloadBytes: integer): number
    local listener = assert(net.listen({host = "127.0.0.1", port = 0}))
    local client = assert(net.connect({host = "127.0.0.1", port = listener:port(), sendHighWater = CHUNK_BYTES}))
    local served = assert(listener:accept())
    local writer = net.asWriter(client)
    local reader = net.asReader(served)
    local output = bytesIO.newBuffer(CHUNK_BYTES)
    const payload = ("abcdefgh"):rep(CHUNK_BYTES / 8)
    const input = span.fromString(payload)
    local samples: {number} = {}
    for sample = 1, COPY_SAMPLES + COPY_WARMUPS do
        local remaining = payloadBytes
        const started = time.now()
        while remaining > 0 do
            local taking = math.min(remaining, CHUNK_BYTES)
            local chunk = input:slice(1, taking)
            assert(writer:writeSpan(chunk) == taking)
            readExactlyInto(reader, output, taking)
            remaining = remaining - taking
        end
        const elapsed = time.now() - started
        if sample > COPY_WARMUPS then
            samples[#samples + 1] = payloadBytes / elapsed / 1048.576
        end
    end
    writer:close()
    reader:close()
    output:close()
    served:close()
    client:close()
    listener:close()

    return median(samples)
end

local function datagramThroughput(payloadBytes: integer): number
    local sender = assert(net.bind({host = "127.0.0.1", port = 0}))
    local receiver = assert(net.bind({host = "127.0.0.1", port = 0}))
    local destination = {host = "127.0.0.1", port = receiver:port()} as net.Address
    const payload = ("d"):rep(payloadBytes)
    local output = bytesIO.newBuffer(payloadBytes)
    local samples: {number} = {}
    const messages = 2000
    for sample = 1, COPY_SAMPLES + COPY_WARMUPS do
        const started = time.now()
        for _ = 1, messages do
            assert(sender:sendTo(destination, payload))
            const message = assert(receiver:receiveFrom(output, payloadBytes))
            if message.length ~= payloadBytes or message.truncated then
                error("datagram benchmark received the wrong message")
            end
        end
        const elapsed = time.now() - started
        if sample > COPY_WARMUPS then
            samples[#samples + 1] = payloadBytes * messages / elapsed / 1048.576
        end
    end
    output:close()
    receiver:close()
    sender:close()

    return median(samples)
end

local function networkCopyAllocation(direct: boolean): number
    local listener = assert(net.listen({host = "127.0.0.1", port = 0}))
    local client = assert(net.connect({host = "127.0.0.1", port = listener:port(), sendHighWater = CHUNK_BYTES}))
    local served = assert(listener:accept())
    local output = bytesIO.newBuffer(CHUNK_BYTES)
    const payload = ("abcdefgh"):rep(CHUNK_BYTES / 8)
    const input = span.fromString(payload)
    collectgarbage("collect")
    collectgarbage("stop")
    local before = collectgarbage("count") as number
    local remaining = 16 * 1024 * 1024
    while remaining > 0 do
        if direct then
            assert(client:writeSpan(input) == CHUNK_BYTES)
            readExactlyInto(served, output, CHUNK_BYTES)
        else
            assert(client:write(payload))
            readExactly(served, CHUNK_BYTES)
        end
        remaining = remaining - CHUNK_BYTES
    end
    local answer = (collectgarbage("count") as number) - before
    collectgarbage("restart")
    collectgarbage("collect")
    output:close()
    served:close()
    client:close()
    listener:close()

    return answer
end

local function httpPort(): integer
    const port = tonumber(os.getenv("NUPP_BENCH_HTTP_PORT") or "")
    if port == nil then
        error("NUPP_BENCH_HTTP_PORT is required")
    end

    return port as integer
end

local function netPort(): integer
    const port = tonumber(os.getenv("NUPP_BENCH_NET_PORT") or "")
    if port == nil then
        error("NUPP_BENCH_NET_PORT is required")
    end

    return port as integer
end

local function tlsPort(): integer
    const port = tonumber(os.getenv("NUPP_BENCH_TLS_PORT") or "")
    if port == nil then
        error("NUPP_BENCH_TLS_PORT is required")
    end

    return port as integer
end

local function tlsAuthority(): string
    local source = assert(io.open("../../tests/data/localhost-cert.pem", "rb"))
    local authority = assert(source:read("*a"))
    source:close()

    return authority
end

local function tlsThroughput(port: integer, direct: boolean): number
    local stream = assert(net.connect({host = "127.0.0.1", port = port, sendHighWater = CHUNK_BYTES}))
    local session = assert(
        tls.client(stream, {hostname = "localhost", authority = tlsAuthority()} as tls.ClientOptions)
    )
    assert(session:handshake())
    const payload = ("t"):rep(CHUNK_BYTES)
    const input = span.fromString(payload)
    local output = bytesIO.newBuffer(CHUNK_BYTES)
    local samples: {number} = {}
    const payloadBytes = 4 * 1024 * 1024
    for sample = 1, COPY_SAMPLES + COPY_WARMUPS do
        local remaining = payloadBytes
        const started = time.now()
        while remaining > 0 do
            if direct then
                assert(session:writeSpan(input) == CHUNK_BYTES)
                readExactlyInto(session, output, CHUNK_BYTES)
            else
                assert(session:write(payload))
                readExactly(session, CHUNK_BYTES)
            end
            remaining = remaining - CHUNK_BYTES
        end
        const elapsed = time.now() - started
        if sample > COPY_WARMUPS then
            samples[#samples + 1] = payloadBytes * 2 / elapsed / 1048.576
        end
    end
    output:close()
    session:close()

    return median(samples)
end

local function httpLatency(port: integer): number
    local client = http.client(new http.Options(proxy = "", maxConnections = 1, maxConnectionsPerHost = 1))
    const target = assert(uri.newURI(("http://127.0.0.1:%d/small"):format(port)))
    local samples: {number} = {}
    for sample = 1, SAMPLES + WARMUPS do
        const started = time.now()
        for _ = 1, HTTP_LATENCY_REQUESTS do
            local request = new http.Request(url = target)
            local response = assert(client:send(request))
            local received: integer = 0
            while true do
                const chunk, why = response.body:read(CHUNK_BYTES)
                if chunk == nil then
                    error(why or "HTTP body read failed")
                end
                if #chunk == 0 then
                    break
                end
                received = received + (#chunk as integer)
            end
            if received ~= 64 then
                error("small HTTP response had the wrong length")
            end
            response:close()
        end
        if sample > WARMUPS then
            samples[#samples + 1] = time.now() - started
        end
    end
    client:close()

    return median(samples) * 1000 / HTTP_LATENCY_REQUESTS
end

local function httpThroughput(port: integer): number
    local client = http.client(new http.Options(proxy = "", maxConnections = 1, maxConnectionsPerHost = 1))
    const target = assert(uri.newURI(("http://127.0.0.1:%d/large"):format(port)))
    local samples: {number} = {}
    for sample = 1, SAMPLES + WARMUPS do
        const started = time.now()
        for _ = 1, HTTP_THROUGHPUT_REQUESTS do
            local request = new http.Request(url = target)
            local response = assert(client:send(request))
            local received: integer = 0
            while true do
                const chunk, why = response.body:read(CHUNK_BYTES)
                if chunk == nil then
                    error(why or "HTTP body read failed")
                end
                if #chunk == 0 then
                    break
                end
                received = received + (#chunk as integer)
            end
            if received ~= LARGE_HTTP_BYTES then
                error("large HTTP response had the wrong length")
            end
            response:close()
        end
        const elapsed = time.now() - started
        if sample > WARMUPS then
            samples[#samples + 1] = LARGE_HTTP_BYTES * HTTP_THROUGHPUT_REQUESTS / elapsed / 1048.576
        end
    end
    client:close()

    return median(samples)
end

local function httpCopyThroughput(port: integer, direct: boolean, payloadBytes: integer): number
    local client = http.client(new http.Options(proxy = "", maxConnections = 1, maxConnectionsPerHost = 1))
    const target = assert(uri.newURI(("http://127.0.0.1:%d/bytes/%d"):format(port, payloadBytes)))
    local samples: {number} = {}
    local requests = math.max(2, math.min(1000, math.floor((32 * 1024 * 1024) / payloadBytes)))
    local output = bytesIO.newBuffer(CHUNK_BYTES)
    for sample = 1, COPY_SAMPLES + COPY_WARMUPS do
        const started = time.now()
        for _ = 1, requests do
            local request = new http.Request(url = target)
            local response = assert(client:send(request))
            local received: integer = 0
            while true do
                local count: integer?
                local why: string?
                if direct then
                    output:clear()
                    count, why = response.body:readInto(output, 0, CHUNK_BYTES)
                else
                    local chunk: string?
                    chunk, why = response.body:read(CHUNK_BYTES)
                    count = chunk ~= nil and #chunk as integer or nil
                end
                if count == nil then
                    error(why or "HTTP body read failed")
                elseif count == 0 then
                    break
                end
                received = received + count
            end
            if received ~= payloadBytes then
                error("HTTP response had the wrong length")
            end
            response:close()
        end
        const elapsed = time.now() - started
        if sample > COPY_WARMUPS then
            samples[#samples + 1] = payloadBytes * requests / elapsed / 1048.576
        end
    end
    output:close()
    client:close()

    return median(samples)
end

local function httpCopyAllocation(port: integer, direct: boolean): number
    local client = http.client(new http.Options(proxy = "", maxConnections = 1, maxConnectionsPerHost = 1))
    const target = assert(uri.newURI(("http://127.0.0.1:%d/bytes/%d"):format(port, 16 * 1024 * 1024)))
    local request = new http.Request(url = target)
    local response = assert(client:send(request))
    local output = bytesIO.newBuffer(CHUNK_BYTES)
    collectgarbage("collect")
    collectgarbage("stop")
    local before = collectgarbage("count") as number
    while true do
        local count: integer?
        if direct then
            output:clear()
            count = assert(response.body:readInto(output, 0, CHUNK_BYTES))
        else
            const chunk = assert(response.body:read(CHUNK_BYTES))
            count = #chunk as integer
        end
        if count == 0 then
            break
        end
    end
    local answer = (collectgarbage("count") as number) - before
    collectgarbage("restart")
    collectgarbage("collect")
    output:close()
    response:close()
    client:close()

    return answer
end

local function copyAllocations(port: integer): nil
    print("copy-reduction Lua allocation: one 16 MiB payload with the collector stopped")
    print(("network string %12.2f KiB"):format(networkCopyAllocation(false)))
    print(("network buffer %12.2f KiB"):format(networkCopyAllocation(true)))
    print(("HTTP string    %12.2f KiB"):format(httpCopyAllocation(port, false)))
    print(("HTTP buffer    %12.2f KiB"):format(httpCopyAllocation(port, true)))
end

local function processEcho(): nil
    while true do
        local chunk = io.stdin:read(CHUNK_BYTES)
        if chunk == nil then
            return
        end
        io.write(chunk)
        io.stdout:flush()
    end
end

local function processOutput(payloadBytes: integer): nil
    const chunk = ("p"):rep(CHUNK_BYTES)
    local remaining = payloadBytes
    while remaining > 0 do
        io.write(chunk:sub(1, math.min(remaining, CHUNK_BYTES)))
        remaining = remaining - CHUNK_BYTES
    end
end

local function processCommunicateThroughput(payloadBytes: integer): number
    const input = ("p"):rep(payloadBytes)
    const executable = assert(os.getenv("NUPP_BENCH_EXECUTABLE"))
    local samples: {number} = {}
    for sample = 1, COPY_SAMPLES + COPY_WARMUPS do
        local child = new processes.Process({args = {executable, "process-peer"}, stderr = "null"} as processes.Options)
        const started = time.now()
        const result = assert(child:communicate({input = input, maxOutputBytes = payloadBytes + CHUNK_BYTES}))
        const elapsed = time.now() - started
        if #result.output ~= payloadBytes then
            error("process echo returned the wrong byte count")
        end
        assert(child:close())
        if sample > COPY_WARMUPS then
            samples[#samples + 1] = payloadBytes * 2 / elapsed / 1048.576
        end
    end

    return median(samples)
end

local function processReadIntoThroughput(payloadBytes: integer): number
    local samples: {number} = {}
    local output = bytesIO.newBuffer(CHUNK_BYTES)
    const executable = assert(os.getenv("NUPP_BENCH_EXECUTABLE"))
    for sample = 1, COPY_SAMPLES + COPY_WARMUPS do
        local child = new processes.Process(
            {
                args = {executable, "process-output", tostring(payloadBytes)},
                stdin = "null",
                stderr = "null",
            } as processes.Options
        )
        assert(child.stdout ~= nil)
        local received: integer = 0
        const started = time.now()
        while true do
            output:clear()
            const count, why = child.stdout:readInto(output, 0, CHUNK_BYTES)
            if count == nil then
                error(why or "process output read failed")
            elseif count == 0 then
                break
            end
            received = received + count
        end
        const elapsed = time.now() - started
        if received ~= payloadBytes or not child:wait():succeeded() then
            error("process output returned the wrong byte count")
        end
        assert(child:close())
        if sample > COPY_WARMUPS then
            samples[#samples + 1] = payloadBytes / elapsed / 1048.576
        end
    end
    output:close()

    return median(samples)
end

local function copyReduction(port: integer, includeReadSpan: boolean): nil
    print(("copy-reduction benchmark: median of %d samples after %d warmup"):format(COPY_SAMPLES, COPY_WARMUPS))
    for _, bytes in ipairs(COPY_BYTES) do
        print(("network string %8d B  %9.2f MiB/s"):format(bytes, networkCopyThroughput("string", bytes)))
        if includeReadSpan then
            print(("network span   %8d B  %9.2f MiB/s"):format(bytes, networkCopyThroughput("span", bytes)))
        end
        print(("network buffer %8d B  %9.2f MiB/s"):format(bytes, networkCopyThroughput("buffer", bytes)))
        print(("HTTP string    %8d B  %9.2f MiB/s"):format(bytes, httpCopyThroughput(port, false, bytes)))
        print(("HTTP buffer    %8d B  %9.2f MiB/s"):format(bytes, httpCopyThroughput(port, true, bytes)))
    end
    print(("network split  %8d B  %9.2f MiB/s"):format(16 * 1024 * 1024, networkSplitThroughput(16 * 1024 * 1024)))
    for _, bytes in ipairs({1200, 1472, 2048}) do
        print(("datagram        %8d B  %9.2f MiB/s"):format(bytes, datagramThroughput(bytes)))
    end
end

local function netSlowReader(): never
    io.stdout:setvbuf("no")
    local listener = assert(net.listen({host = "127.0.0.1", port = 0}))
    local client = assert(net.connect({host = "127.0.0.1", port = listener:port(), sendHighWater = CHUNK_BYTES}))
    local served = assert(listener:accept())
    const payload = ("abcdefgh"):rep(CHUNK_BYTES / 8)
    print("READY net-slow-reader")
    while true do
        assert(client:write(payload))
    end
    served:close()
    client:close()
    listener:close()
    error("unreachable")
end

local function netSlowWriter(port: integer): never
    io.stdout:setvbuf("no")
    local stream = assert(net.connect({host = "127.0.0.1", port = port, receiveHighWater = CHUNK_BYTES}))
    local reader = net.asReader(stream)
    print("READY net-slow-writer")
    while true do
        const chunk, why = reader:read(CHUNK_BYTES)
        if chunk == nil then
            error(why or "slow network writer failed")
        end
        if #chunk == 0 then
            error("slow network writer ended before the resource sample completed")
        end
    end
    reader:close()
    stream:close()
    error("unreachable")
end

local function httpSlowReader(port: integer): nil
    io.stdout:setvbuf("no")
    local client = http.client(new http.Options(proxy = "", maxConnections = 1, maxConnectionsPerHost = 1))
    local request = new http.Request(url = assert(uri.newURI(("http://127.0.0.1:%d/slow-reader"):format(port))))
    local response = assert(client:send(request))
    print("READY http-slow-reader")
    time.sleep(30000)
    response:close()
    client:close()
end

local function httpSlowWriter(port: integer): nil
    io.stdout:setvbuf("no")
    local client = http.client(new http.Options(proxy = "", maxConnections = 1, maxConnectionsPerHost = 1))
    local request = new http.Request(url = assert(uri.newURI(("http://127.0.0.1:%d/slow-writer"):format(port))))
    local response = assert(client:send(request))
    print("READY http-slow-writer")
    while true do
        const chunk, why = response.body:read(CHUNK_BYTES)
        if chunk == nil then
            error(why or "slow HTTP writer failed")
        end
        if #chunk == 0 then
            break
        end
    end
    response:close()
    client:close()
end

const mode = arg[1] or "benchmark"
if mode == "process-peer" then
    processEcho()
elseif mode == "process-output" then
    processOutput(assert(tonumber(arg[2])) as integer)
else
    io.stdout:setvbuf("no")
    print(("NUPP_BENCH_PID %d"):format(nativeProcessId()))
end

if mode == "process-peer" or mode == "process-output" then
    -- Child modes finish above without loading a network peer.
elseif mode == "net-slow-reader" then
    netSlowReader()
elseif mode == "net-slow-writer" then
    netSlowWriter(netPort())
elseif mode == "http-slow-reader" then
    httpSlowReader(httpPort())
elseif mode == "http-slow-writer" then
    httpSlowWriter(httpPort())
elseif mode == "copy-reduction" then
    copyReduction(httpPort(), true)
elseif mode == "copy-reduction-compatible" then
    copyReduction(httpPort(), false)
elseif mode == "copy-allocation" then
    copyAllocations(httpPort())
elseif mode == "copy-datagram" then
    for _, bytes in ipairs({1200, 1472, 2048}) do
        print(("datagram        %8d B  %9.2f MiB/s"):format(bytes, datagramThroughput(bytes)))
    end
elseif mode == "copy-process" then
    const bytes = (tonumber(arg[2]) or 4 * 1024 * 1024) as integer
    print(("process communicate %8d B  %9.2f MiB/s"):format(bytes, processCommunicateThroughput(bytes)))
    print(("process readInto    %8d B  %9.2f MiB/s"):format(bytes, processReadIntoThroughput(bytes)))
elseif mode == "copy-tls" then
    const port = tlsPort()
    print(("TLS string  %9.2f MiB/s  4 MiB echo"):format(tlsThroughput(port, false)))
    print(("TLS buffer  %9.2f MiB/s  4 MiB echo"):format(tlsThroughput(port, true)))
elseif mode == "benchmark" then
    const port = httpPort()
    print(("native runtime benchmark: median of %d samples after %d warmups"):format(SAMPLES, WARMUPS))
    print(("network round trip  %9.2f us/op  public stream ping-pong"):format(networkLatency()))
    print(("network throughput  %9.2f MiB/s  64 KiB write/read chunks"):format(networkThroughput()))
    print(("HTTP small request  %9.2f us/op  pooled request + 64 B body"):format(httpLatency(port)))
    print(("HTTP body download  %9.2f MiB/s  pooled 4 MiB responses"):format(httpThroughput(port)))
else
    error("unknown benchmark mode: " .. mode)
end
