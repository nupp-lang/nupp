-- Generated static PEG matchers against Nupp's Rust regex native provider.
--
-- Build the provider and run this file from the repository root:
--   cargo build --release --locked --manifest-path runtime/regex/Cargo.toml
--   NUPP_REGEX_LIBRARY="$PWD/build/host/release/libnupp_regex.dylib" \
--      ./bin/nupp run -O2 bench/peg-vs-rust-regex.nupp
--
-- The benchmark intentionally covers only anchored ASCII recognition. Recursive
-- grammars, replacement, unanchored search and Unicode classes have no fair
-- counterpart in the other engine and belong in separate capability benchmarks.

local jit: any = require("jit")

local ROUNDS = 7
local ITERATIONS = 250000

local pegSetupStarted = os.clock()
local Identifier: nupp.Peg.Matcher<integer> = comptime do
    local head = nupp.peg.range("az", "AZ") + nupp.peg.literal("_")
    local tail = head + nupp.peg.range("09")
    return nupp.peg.compile(head * tail^0 * nupp.peg.eof())
end

local Date: nupp.Peg.Matcher<integer> = comptime do
    local digit = nupp.peg.range("09")
    return nupp.peg.compile(
        digit * digit * digit * digit * nupp.peg.literal("-")
        * digit * digit * nupp.peg.literal("-") * digit * digit
        * nupp.peg.eof()
    )
end

local Route: nupp.Peg.Matcher<integer> = comptime do
    local method = nupp.peg.literal("GET")
        + nupp.peg.literal("POST")
        + nupp.peg.literal("PUT")
        + nupp.peg.literal("PATCH")
        + nupp.peg.literal("DELETE")
    local pathByte = nupp.peg.range("az", "09") + nupp.peg.set("/_-")
    local version = nupp.peg.literal("HTTP/1.")
        * (nupp.peg.literal("0") + nupp.peg.literal("1"))
    return nupp.peg.compile(
        method * nupp.peg.literal(" ") * pathByte^1
        * nupp.peg.literal(" ") * version * nupp.peg.eof()
    )
end
local pegSetupMicros = (os.clock() - pegSetupStarted) * 1000000

-- Resolve the lazy native provider before measuring pattern compilation itself.
local regexLibrary: nupp.Regex.Library = nupp.regex
local regexSetupStarted = os.clock()
local identifierRegex = regexLibrary.compile("^[A-Za-z_][A-Za-z0-9_]*$")
local dateRegex = regexLibrary.compile("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
local routeRegex = regexLibrary.compile("^(?:GET|POST|PUT|PATCH|DELETE) [a-z0-9/_-]+ HTTP/1[.][01]$")
local regexSetupMicros = (os.clock() - regexSetupStarted) * 1000000

local record Workload
    name: string
    subjects: {string}
    peg: function(string): boolean
    regex: function(string): boolean
end

local workloads = {
    new Workload {
        name = "identifier-short",
        subjects = {"player_1", "_x", "Velocity2", "abc123", "1player", "bad-name", "", "two words"},
        peg = function(subject: string): boolean return Identifier(subject) ~= nil end,
        regex = function(subject: string): boolean return identifierRegex:isMatch(subject) end,
    },
    new Workload {
        name = "identifier-long",
        subjects = {
            "materialized_identifier_0123456789_abcdefghijklmnopqrstuvwxyz",
            "another_valid_identifier_with_a_long_ascii_tail_9876543210",
            "_private_component_name_with_many_segments_and_digits_42",
            "ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz_0123456789",
            "9materialized_identifier_0123456789_abcdefghijklmnopqrstuvwxyz",
            "materialized_identifier_0123456789-abcdefghijklmnopqrstuvwxyz",
            "materialized identifier 0123456789 abcdefghijklmnopqrstuvwxyz",
            "materialized_identifier_0123456789_abcdefghijklmnopqrstuvwxy!",
        },
        peg = function(subject: string): boolean return Identifier(subject) ~= nil end,
        regex = function(subject: string): boolean return identifierRegex:isMatch(subject) end,
    },
    new Workload {
        name = "fixed-date",
        subjects = {
            "2026-08-10", "1970-01-01", "9999-99-99", "0000-00-00",
            "2026/08/10", "26-08-10", "2026-8-10", "2026-08-100",
        },
        peg = function(subject: string): boolean return Date(subject) ~= nil end,
        regex = function(subject: string): boolean return dateRegex:isMatch(subject) end,
    },
    new Workload {
        name = "http-route",
        subjects = {
            "GET /users/42 HTTP/1.1",
            "POST /api/v1/items HTTP/1.0",
            "PATCH /player_inventory/slot-4 HTTP/1.1",
            "DELETE /cache/key_99 HTTP/1.0",
            "HEAD /users/42 HTTP/1.1",
            "GET users/42 HTTP/1.1",
            "GET /Users/42 HTTP/1.1",
            "GET /users/42 HTTP/2.0",
        },
        peg = function(subject: string): boolean return Route(subject) ~= nil end,
        regex = function(subject: string): boolean return routeRegex:isMatch(subject) end,
    },
}

local sink = 0

local function median(values: {number}): number
    table.sort(values)
    return values[math.ceil(#values / 2)]
end

local function measure(test: function(string): boolean, subjects: {string}): number
    local cycles = math.floor(ITERATIONS / #subjects)
    jit.flush()
    for _ = 1, 10000 do
        for _, subject in ipairs(subjects) do
            if test(subject) then sink = sink + 1 end
        end
    end
    local samples = {}
    for round = 1, ROUNDS do
        local hits = 0
        local started = os.clock()
        for _ = 1, cycles do
            for _, subject in ipairs(subjects) do
                if test(subject) then hits = hits + 1 end
            end
        end
        local elapsed = os.clock() - started
        samples[round] = cycles * #subjects / elapsed
        sink = sink + hits
    end
    return median(samples)
end

print(string.format("generated PEG vs Rust regex, %s, %d rounds x %d matches",
    jit.version, ROUNDS, ITERATIONS
))
print(string.format("runtime setup for 3 matchers: PEG %.1f us, regex compile %.1f us",
    pegSetupMicros, regexSetupMicros
))
print("workload                 PEG matches/s  regex matches/s  PEG/regex")
print("-----------------------  -------------  ---------------  ---------")

local ratios = {}
for _, workload in ipairs(workloads) do
    for _, subject in ipairs(workload.subjects) do
        assert(workload.peg(subject) == workload.regex(subject),
            workload.name .. " engines disagree on " .. subject)
    end
    local peg = measure(workload.peg, workload.subjects)
    local regex = measure(workload.regex, workload.subjects)
    local ratio = peg / regex
    ratios[#ratios + 1] = ratio
    print(string.format("%-23s  %13.0f  %15.0f  %8.2fx", workload.name, peg, regex, ratio))
end

local product = 1
for _, ratio in ipairs(ratios) do product = product * ratio end
print(string.format("geometric mean                                      %8.2fx",
    product^(1 / #ratios)
))
assert(sink > 0)
