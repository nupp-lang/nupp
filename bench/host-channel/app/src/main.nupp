--[[
Runs one host channel program in the real browser guest: a contract scenario
from `tests/stdlib/os/host/fixtures/scenarios.lua` or a workload from `bench.lua`, chosen by
the global the page's initialization chunk sets. Both are plain Lua carried as
text and loaded at run time; requiring what they use here is what bundles it.
]]

local json = require("serde.json")
local sources = require("sources")
local _host = os.host
local _span = require("binary.span")
local _tasks = require("coroutine")
local _time = require("coroutine")
local _events = require("events")
local _hostevents = require("hostevents")
local _clock = os.monotonic

-- The page names the program in an initialization chunk; a page that starts the
-- application through the packaged entry, which carries none, is asked.
local selection: any = rawget(_G, "__hostChannelProgram")
if selection == nil then
    local file, name, options = _host.call("bench.program")
    selection = {file = file, name = name, options = json.decodevalue(options)}
end
local load: any = rawget(_G, "loadstring")
local programs: any = (load(sources[selection.file], "@" .. selection.file))()
local ok, value = pcall(programs[selection.name], selection.options)

return json.encodevalue(ok and {ok = true, value = value} or {ok = false, error = tostring(value)})
