module gemm

-- Naive GEMM over row-major binary32 matrices: c[m x n] = a[m x k] * b[k x n].
-- Each dispatched thread owns one output element. Its one-based loop index is
-- converted to a zero-based row and column, and every a/b access is a proved
-- cursor whose bound check the shader keeps, so the matrix buffers may have the
-- independently sized dimensions the uniforms describe.
local span = require("nupp.mem.span")

@aot(target = "gpu")
local function gemmNaive(
    exclusive c: span.WriteSpan<float>,
    borrows a: span.Span<float>,
    borrows b: span.Span<float>,
    columns: uint32,
    inner: uint32
): nil
    for i = 1, #c do
        local offset = nupp.math.u32.sub(nupp.math.u32.wrap(i), 1)
        local row = nupp.math.u32.div(offset, columns)
        local col = nupp.math.u32.mod(offset, columns)
        local acc: float = 0.0
        local j = nupp.math.u32.wrap(0)
        while j < inner do
            local ai = nupp.math.u32.add(nupp.math.u32.mul(row, inner), j)
            local bi = nupp.math.u32.add(nupp.math.u32.mul(j, columns), col)
            if ai < #a then
                if bi < #b then
                    acc = nupp.math.f32.fma(nupp.math.f32.narrow(a[ai + 1]), nupp.math.f32.narrow(b[bi + 1]), acc)
                end
            end
            j = nupp.math.u32.add(j, 1)
        end
        c[i] = acc
    end
end

-- The same scalar IR through the CPU AOT tier: the reference the GPU result must
-- match element-exactly and a real baseline for the generated native kernel.
@aot
local function gemmCpu(
    exclusive c: span.WriteSpan<float>,
    borrows a: span.Span<float>,
    borrows b: span.Span<float>,
    columns: uint32,
    inner: uint32
): nil
    for i = 1, #c do
        local offset = nupp.math.u32.sub(nupp.math.u32.wrap(i), 1)
        local row = nupp.math.u32.div(offset, columns)
        local col = nupp.math.u32.mod(offset, columns)
        local acc: float = 0.0
        local j = nupp.math.u32.wrap(0)
        while j < inner do
            local ai = nupp.math.u32.add(nupp.math.u32.mul(row, inner), j)
            local bi = nupp.math.u32.add(nupp.math.u32.mul(j, columns), col)
            if ai < #a then
                if bi < #b then
                    acc = nupp.math.f32.fma(nupp.math.f32.narrow(a[ai + 1]), nupp.math.f32.narrow(b[bi + 1]), acc)
                end
            end
            j = nupp.math.u32.add(j, 1)
        end
        c[i] = acc
    end
end

export const gemm = gemmNaive
export const cpu = gemmCpu
