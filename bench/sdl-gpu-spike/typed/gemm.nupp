module gemm

-- Naive GEMM over row-major binary32 matrices: c[m x n] = a[m x k] * b[k x n].
-- Each dispatched thread owns one output element. Its one-based loop index is
-- converted to a zero-based row and column, and every a/b access is a proved
-- cursor whose bound check the shader keeps, so the matrix buffers may have the
-- independently sized dimensions the uniforms describe.
local span = require("nupp.mem.span")
local gpu = require("nupp.gpu")

-- Small conformance kernels separate storage binding and scalar-uniform
-- failures before the full GEMM makes either one look like a zero result.
@aot(target = "gpu")
local function copyProbe(exclusive output: span.WriteSpan<float>, borrows input: span.Span<float>): nil
    assert(#output == #input)
    for i = 1, #output do
        output[i] = input[i]
    end
end

@aot(target = "gpu")
local function fillProbe(exclusive output: span.WriteSpan<float>, borrows input: span.Span<float>, value: float): nil
    assert(#output == #input)
    for i = 1, #output do
        output[i] = input[i] * 0.0 + value
    end
end

-- Keep the complete GEMM ABI but avoid its loop and index arithmetic. This
-- distinguishes missing span metadata or trailing scalar uniforms from a
-- failure in the matrix body itself.
@aot(target = "gpu")
local function abiProbe(
    exclusive output: span.WriteSpan<float>,
    borrows a: span.Span<float>,
    borrows b: span.Span<float>,
    columns: uint32,
    inner: uint32
): nil
    for i = 1, #output do
        local offset = nupp.math.u32.sub(nupp.math.u32.wrap(i), 1)
        local value: float = 0.0
        if offset < #a then
            local left = nupp.math.f32.narrow(a[offset + 1])
            if offset < #b then
                local right = nupp.math.f32.narrow(b[offset + 1])
                if columns ~= 0 then
                    if inner ~= 0 then
                        value = nupp.math.f32.add(left, right)
                    end
                end
            end
        end
        output[i] = value
    end
end

@aot(target = "gpu")
local function loopProbe(
    exclusive output: span.WriteSpan<float>,
    borrows input: span.Span<float>,
    iterations: uint32
): nil
    assert(#output == #input)
    for i = 1, #output do
        local value: float = 0.0
        local cursor: uint32 = 0
        while cursor < iterations do
            value = nupp.math.f32.add(value, 1.0)
            cursor = nupp.math.u32.add(cursor, 1)
        end
        output[i] = input[i] * 0.0 + value
    end
end

@aot(target = "gpu")
local function fmaProbe(
    exclusive output: span.WriteSpan<float>,
    borrows a: span.Span<float>,
    borrows b: span.Span<float>
): nil
    assert(#output == #a and #output == #b)
    for i = 1, #output do
        output[i] = nupp.math.f32.fma(nupp.math.f32.narrow(a[i]), nupp.math.f32.narrow(b[i]), nupp.math.f32.narrow(0.0))
    end
end

@aot(target = "gpu")
local function uintUniformProbe(
    exclusive output: span.WriteSpan<float>,
    borrows input: span.Span<float>,
    value: uint32
): nil
    assert(#output == #input)
    for i = 1, #output do
        if value == 73 then
            output[i] = input[i]
        else
            output[i] = 0.0
        end
    end
end

@aot(target = "gpu")
local function fixedLoopProbe(exclusive output: span.WriteSpan<float>, borrows input: span.Span<float>): nil
    assert(#output == #input)
    for i = 1, #output do
        local value: float = 0.0
        local cursor: uint32 = 0
        while cursor < 7 do
            value = nupp.math.f32.add(value, 1.0)
            cursor = nupp.math.u32.add(cursor, 1)
        end
        output[i] = input[i] * 0.0 + value
    end
end

@aot(target = "gpu")
local function gemmNaive(
    exclusive c: span.WriteSpan<float>,
    borrows a: span.Span<float>,
    borrows b: span.Span<float>,
    columns: uint32,
    inner: uint32
): nil
    for i = 1, #c do
        local offset = nupp.math.u32.sub(nupp.math.u32.wrap(i), 1)
        local row = nupp.math.u32.div(offset, columns)
        local col = nupp.math.u32.mod(offset, columns)
        local acc: float = 0.0
        local j = nupp.math.u32.wrap(0)
        while j < inner do
            local ai = nupp.math.u32.add(nupp.math.u32.mul(row, inner), j)
            local bi = nupp.math.u32.add(nupp.math.u32.mul(j, columns), col)
            if ai < #a then
                if bi < #b then
                    acc = nupp.math.f32.fma(nupp.math.f32.narrow(a[ai + 1]), nupp.math.f32.narrow(b[bi + 1]), acc)
                end
            end
            j = nupp.math.u32.add(j, 1)
        end
        c[i] = acc
    end
end

-- The same scalar IR through the CPU AOT tier: the reference the GPU result must
-- match element-exactly and a real baseline for the generated native kernel.
@aot
local function gemmCpu(
    exclusive c: span.WriteSpan<float>,
    borrows a: span.Span<float>,
    borrows b: span.Span<float>,
    columns: uint32,
    inner: uint32
): nil
    for i = 1, #c do
        local offset = nupp.math.u32.sub(nupp.math.u32.wrap(i), 1)
        local row = nupp.math.u32.div(offset, columns)
        local col = nupp.math.u32.mod(offset, columns)
        local acc: float = 0.0
        local j = nupp.math.u32.wrap(0)
        while j < inner do
            local ai = nupp.math.u32.add(nupp.math.u32.mul(row, inner), j)
            local bi = nupp.math.u32.add(nupp.math.u32.mul(j, columns), col)
            if ai < #a then
                if bi < #b then
                    acc = nupp.math.f32.fma(nupp.math.f32.narrow(a[ai + 1]), nupp.math.f32.narrow(b[bi + 1]), acc)
                end
            end
            j = nupp.math.u32.add(j, 1)
        end
        c[i] = acc
    end
end

-- One 16 by 16 output tile per 256-lane workgroup. Each load phase writes one
-- disjoint shared slot, and the following compute phase reads only indices
-- whose complete uint32 range the compiler proves lies inside that tile.
@aot(target = "gpu")
local function gemmTiled(
    exclusive c: span.WriteSpan<float>,
    borrows a: span.Span<float>,
    borrows b: span.Span<float>,
    columns: uint32,
    inner: uint32
): nil
    local groups = nupp.math.u32.div(nupp.math.u32.wrap(#c), nupp.math.u32.wrap(256))
    gpu.workgroups(groups, 256, function(groupIndex: uint32, phases: gpu.Phases)
        local aTile = phases:scratch(nupp.math.f32.narrow(0.0), 256)
        local bTile = phases:scratch(nupp.math.f32.narrow(0.0), 256)
        local accumulators = phases:scratch(nupp.math.f32.narrow(0.0), 256)
        phases:run(function(localIndex: uint32)
            accumulators[localIndex] = nupp.math.f32.narrow(0.0)
        end)

        local tile: uint32 = 0
        while nupp.math.u32.mul(tile, nupp.math.u32.wrap(16)) < inner do
            phases:run(function(localIndex: uint32)
                local laneRow = nupp.math.u32.div(localIndex, nupp.math.u32.wrap(16))
                local laneColumn = nupp.math.u32.mod(localIndex, nupp.math.u32.wrap(16))
                local tilesPerRow = nupp.math.u32.div(columns, nupp.math.u32.wrap(16))
                local tileRow = nupp.math.u32.div(groupIndex, tilesPerRow)
                local tileColumn = nupp.math.u32.mod(groupIndex, tilesPerRow)
                local row = nupp.math.u32.add(nupp.math.u32.mul(tileRow, nupp.math.u32.wrap(16)), laneRow)
                local column = nupp.math.u32.add(nupp.math.u32.mul(tileColumn, nupp.math.u32.wrap(16)), laneColumn)
                local base = nupp.math.u32.mul(tile, nupp.math.u32.wrap(16))
                local aColumn = nupp.math.u32.add(base, laneColumn)
                local bRow = nupp.math.u32.add(base, laneRow)
                local ai = nupp.math.u32.add(nupp.math.u32.mul(row, inner), aColumn)
                local bi = nupp.math.u32.add(nupp.math.u32.mul(bRow, columns), column)
                if aColumn < inner then
                    if ai < #a then
                        aTile[localIndex] = nupp.math.f32.narrow(a[ai + 1])
                    else
                        aTile[localIndex] = nupp.math.f32.narrow(0.0)
                    end
                else
                    aTile[localIndex] = nupp.math.f32.narrow(0.0)
                end
                if bRow < inner then
                    if bi < #b then
                        bTile[localIndex] = nupp.math.f32.narrow(b[bi + 1])
                    else
                        bTile[localIndex] = nupp.math.f32.narrow(0.0)
                    end
                else
                    bTile[localIndex] = nupp.math.f32.narrow(0.0)
                end
            end)
            phases:run(function(localIndex: uint32)
                local value = nupp.math.f32.narrow(accumulators[localIndex])
                value = nupp.math.f32.fma(
                    nupp.math.f32.narrow(aTile[nupp.math.u32.mul(nupp.math.u32.div(localIndex, 16), 16)]),
                    nupp.math.f32.narrow(bTile[nupp.math.u32.mod(localIndex, 16)]),
                    value
                )
                value = nupp.math.f32.fma(
                    nupp.math.f32.narrow(
                        aTile[nupp.math.u32.add(nupp.math.u32.mul(nupp.math.u32.div(localIndex, 16), 16), 1)]
                    ),
                    nupp.math.f32.narrow(bTile[nupp.math.u32.add(16, nupp.math.u32.mod(localIndex, 16))]),
                    value
                )
                value = nupp.math.f32.fma(
                    nupp.math.f32.narrow(
                        aTile[nupp.math.u32.add(nupp.math.u32.mul(nupp.math.u32.div(localIndex, 16), 16), 2)]
                    ),
                    nupp.math.f32.narrow(bTile[nupp.math.u32.add(32, nupp.math.u32.mod(localIndex, 16))]),
                    value
                )
                value = nupp.math.f32.fma(
                    nupp.math.f32.narrow(
                        aTile[nupp.math.u32.add(nupp.math.u32.mul(nupp.math.u32.div(localIndex, 16), 16), 3)]
                    ),
                    nupp.math.f32.narrow(bTile[nupp.math.u32.add(48, nupp.math.u32.mod(localIndex, 16))]),
                    value
                )
                value = nupp.math.f32.fma(
                    nupp.math.f32.narrow(
                        aTile[nupp.math.u32.add(nupp.math.u32.mul(nupp.math.u32.div(localIndex, 16), 16), 4)]
                    ),
                    nupp.math.f32.narrow(bTile[nupp.math.u32.add(64, nupp.math.u32.mod(localIndex, 16))]),
                    value
                )
                value = nupp.math.f32.fma(
                    nupp.math.f32.narrow(
                        aTile[nupp.math.u32.add(nupp.math.u32.mul(nupp.math.u32.div(localIndex, 16), 16), 5)]
                    ),
                    nupp.math.f32.narrow(bTile[nupp.math.u32.add(80, nupp.math.u32.mod(localIndex, 16))]),
                    value
                )
                value = nupp.math.f32.fma(
                    nupp.math.f32.narrow(
                        aTile[nupp.math.u32.add(nupp.math.u32.mul(nupp.math.u32.div(localIndex, 16), 16), 6)]
                    ),
                    nupp.math.f32.narrow(bTile[nupp.math.u32.add(96, nupp.math.u32.mod(localIndex, 16))]),
                    value
                )
                value = nupp.math.f32.fma(
                    nupp.math.f32.narrow(
                        aTile[nupp.math.u32.add(nupp.math.u32.mul(nupp.math.u32.div(localIndex, 16), 16), 7)]
                    ),
                    nupp.math.f32.narrow(bTile[nupp.math.u32.add(112, nupp.math.u32.mod(localIndex, 16))]),
                    value
                )
                value = nupp.math.f32.fma(
                    nupp.math.f32.narrow(
                        aTile[nupp.math.u32.add(nupp.math.u32.mul(nupp.math.u32.div(localIndex, 16), 16), 8)]
                    ),
                    nupp.math.f32.narrow(bTile[nupp.math.u32.add(128, nupp.math.u32.mod(localIndex, 16))]),
                    value
                )
                value = nupp.math.f32.fma(
                    nupp.math.f32.narrow(
                        aTile[nupp.math.u32.add(nupp.math.u32.mul(nupp.math.u32.div(localIndex, 16), 16), 9)]
                    ),
                    nupp.math.f32.narrow(bTile[nupp.math.u32.add(144, nupp.math.u32.mod(localIndex, 16))]),
                    value
                )
                value = nupp.math.f32.fma(
                    nupp.math.f32.narrow(
                        aTile[nupp.math.u32.add(nupp.math.u32.mul(nupp.math.u32.div(localIndex, 16), 16), 10)]
                    ),
                    nupp.math.f32.narrow(bTile[nupp.math.u32.add(160, nupp.math.u32.mod(localIndex, 16))]),
                    value
                )
                value = nupp.math.f32.fma(
                    nupp.math.f32.narrow(
                        aTile[nupp.math.u32.add(nupp.math.u32.mul(nupp.math.u32.div(localIndex, 16), 16), 11)]
                    ),
                    nupp.math.f32.narrow(bTile[nupp.math.u32.add(176, nupp.math.u32.mod(localIndex, 16))]),
                    value
                )
                value = nupp.math.f32.fma(
                    nupp.math.f32.narrow(
                        aTile[nupp.math.u32.add(nupp.math.u32.mul(nupp.math.u32.div(localIndex, 16), 16), 12)]
                    ),
                    nupp.math.f32.narrow(bTile[nupp.math.u32.add(192, nupp.math.u32.mod(localIndex, 16))]),
                    value
                )
                value = nupp.math.f32.fma(
                    nupp.math.f32.narrow(
                        aTile[nupp.math.u32.add(nupp.math.u32.mul(nupp.math.u32.div(localIndex, 16), 16), 13)]
                    ),
                    nupp.math.f32.narrow(bTile[nupp.math.u32.add(208, nupp.math.u32.mod(localIndex, 16))]),
                    value
                )
                value = nupp.math.f32.fma(
                    nupp.math.f32.narrow(
                        aTile[nupp.math.u32.add(nupp.math.u32.mul(nupp.math.u32.div(localIndex, 16), 16), 14)]
                    ),
                    nupp.math.f32.narrow(bTile[nupp.math.u32.add(224, nupp.math.u32.mod(localIndex, 16))]),
                    value
                )
                value = nupp.math.f32.fma(
                    nupp.math.f32.narrow(
                        aTile[nupp.math.u32.add(nupp.math.u32.mul(nupp.math.u32.div(localIndex, 16), 16), 15)]
                    ),
                    nupp.math.f32.narrow(bTile[nupp.math.u32.add(240, nupp.math.u32.mod(localIndex, 16))]),
                    value
                )
                accumulators[localIndex] = value
            end)
            tile = nupp.math.u32.add(tile, 1)
        end
        phases:run(function(localIndex: uint32)
            local laneRow = nupp.math.u32.div(localIndex, nupp.math.u32.wrap(16))
            local laneColumn = nupp.math.u32.mod(localIndex, nupp.math.u32.wrap(16))
            local tilesPerRow = nupp.math.u32.div(columns, nupp.math.u32.wrap(16))
            local tileRow = nupp.math.u32.div(groupIndex, tilesPerRow)
            local tileColumn = nupp.math.u32.mod(groupIndex, tilesPerRow)
            local row = nupp.math.u32.add(nupp.math.u32.mul(tileRow, nupp.math.u32.wrap(16)), laneRow)
            local column = nupp.math.u32.add(nupp.math.u32.mul(tileColumn, nupp.math.u32.wrap(16)), laneColumn)
            local output = nupp.math.u32.add(nupp.math.u32.mul(row, columns), column)
            if output < #c then
                c[output + 1] = nupp.math.f32.narrow(accumulators[localIndex])
            end
        end)
    end)
end

-- Dense batched output with independently strided A and B inputs. A zero batch
-- stride broadcasts one matrix across every batch; transposes are represented
-- by exchanging the row/inner or inner/column strides.
@aot(target = "gpu")
local function gemmBatched(
    exclusive c: span.WriteSpan<float>,
    borrows a: span.Span<float>,
    borrows b: span.Span<float>,
    rows: uint32,
    columns: uint32,
    inner: uint32,
    aBatchStride: uint32,
    aRowStride: uint32,
    aInnerStride: uint32,
    bBatchStride: uint32,
    bInnerStride: uint32,
    bColumnStride: uint32
): nil
    for i = 1, #c do
        local offset = nupp.math.u32.sub(nupp.math.u32.wrap(i), 1)
        local plane = nupp.math.u32.mul(rows, columns)
        local batch = nupp.math.u32.div(offset, plane)
        local within = nupp.math.u32.mod(offset, plane)
        local row = nupp.math.u32.div(within, columns)
        local column = nupp.math.u32.mod(within, columns)
        local value: float = 0.0
        local cursor: uint32 = 0
        while cursor < inner do
            local ai = nupp.math.u32.add(
                nupp.math.u32.add(nupp.math.u32.mul(batch, aBatchStride), nupp.math.u32.mul(row, aRowStride)),
                nupp.math.u32.mul(cursor, aInnerStride)
            )
            local bi = nupp.math.u32.add(
                nupp.math.u32.add(nupp.math.u32.mul(batch, bBatchStride), nupp.math.u32.mul(cursor, bInnerStride)),
                nupp.math.u32.mul(column, bColumnStride)
            )
            if ai < #a then
                local left = nupp.math.f32.narrow(a[ai + 1])
                if bi < #b then
                    value = nupp.math.f32.fma(left, nupp.math.f32.narrow(b[bi + 1]), value)
                end
            end
            cursor = nupp.math.u32.add(cursor, 1)
        end
        c[i] = value
    end
end

export const gemm = gemmNaive
export const cpu = gemmCpu
export const tiled = gemmTiled
export const batched = gemmBatched
export const copy = copyProbe
export const fill = fillProbe
export const abi = abiProbe
export const loop = loopProbe
export const fma = fmaProbe
export const uintUniform = uintUniformProbe
export const fixedLoop = fixedLoopProbe
