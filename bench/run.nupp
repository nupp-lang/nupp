--- Runs the benchmark set and merges what each case reported.
---
--- One case is one process, and a case here means a `bench.case`, not a file: trace
--- state, the compiler's trace budget, blacklisted traces and the heap are all
--- process-wide, so two cases sharing a process measure each other. Each file is asked
--- what cases it defines and then run once per case.
---
--- The baseline belongs to the runner rather than to a case. A child comparing against
--- it would have each of them read and overwrite one file describing all of them.
---
--- It lives here rather than in `src/` because it contains no compiler: it globs a
--- directory, starts children, and merges JSON. See
--- [NEP 32](docs/neps/0032-benchmarks-as-programs.md).
---
--- Run: nupp task bench
local json = require("nupp.codec.json")

local files = require("nupp.io.files")
local process = require("nupp.io.process")
local type Bench = {
    compare: function(any, any): ({string}, {string}),
    format: function(any): string
}
local bench = require("nupp.bench") as Bench
local compare = bench.compare
local format = bench.format

--- Where a child is told to write, and where the merged record goes.
local RECORD_OUT = "build/bench-case.json"

local REMARKS_OUT = "build/remarks.json"
local MERGED_OUT = "build/bench-record.json"
local DEFAULT_TIMEOUT_MS: integer = 120000

local function readFile(path: string): string?
    local handle = io.open(path, "r")
    if not handle then
        return nil
    end
    local content = handle:read("*a")
    handle:close()

    return content
end

local function writeFile(path: string, content: string): boolean
    local handle = io.open(path, "w")
    if not handle then
        return false
    end
    handle:write(content)
    handle:close()

    return true
end

local function appendFile(path: string, content: string): boolean
    local handle = io.open(path, "a")
    if not handle then
        return false
    end
    handle:write(content)
    handle:close()

    return true
end

--- The files to ask: `bench/*.bench.nupp`.
---
--- A case file is named rather than discovered by trying it, because `bench/` also
--- holds programs that are not cases -- hand-written comparisons, spikes and probes.
--- Running one to find out reports "wrote no record", which is the right answer for a
--- case that failed to report and the wrong one for a file that was never a case.
local function discover(): {string}
    local found: {string} = {}
    for _, path in ipairs(files.glob("bench/*.bench.nupp") or {}) do
        found[#found + 1] = path
    end
    table.sort(found)

    return found
end

local function nuppRun(path: string, extra: {string}, timeoutMs: integer): (boolean, string?)
    local args = {"./bin/nupp", "run", "-O1", "--remarks-out", path}
    for _, entry in ipairs(extra) do
        args[#args + 1] = entry
    end
    local child = new process.Process(
        {args = args, stdin = "inherit", stdout = "pipe", stderr = "pipe", timeoutMs = timeoutMs,} as process.Options
    )
    local result, communicateProblem = child:communicate()
    child:close()
    if not result then
        return false, communicateProblem or "could not collect child output"
    end
    if result.errorOutput ~= "" then
        io.stderr:write(result.errorOutput)
    end
    if not result:succeeded() and result.output ~= "" then
        io.stderr:write(result.output)
    end
    if result.exit.timedOut then
        return false, ("timed out after %.3fs"):format(timeoutMs / 1000.0)
    end

    return result:succeeded(), nil
end

--- The case names a file defines, by asking it rather than by reading it.
local function casesIn(path: string, timeoutMs: integer): ({string}, string?)
    local listing = "build/bench-cases.txt"
    os.remove(listing)
    local ok, problem = nuppRun(path, {"--list-cases", "--cases-out", listing}, timeoutMs)
    if not ok then
        return {}, problem and "case listing " .. problem or "case listing failed"
    end
    local text = readFile(listing)
    if not text then
        return {}, "wrote no case listing"
    end
    local names: {string} = {}
    local seen: {[string]: boolean} = {}
    for line in text:gmatch("[^\r\n]+") do
        local ok, name = pcall(json.decode, line)
        if not ok or type(name) ~= "string" then
            return {}, "wrote an invalid case listing"
        end
        if seen[name] then
            return {}, "defines the case " .. name .. " more than once"
        end
        seen[name] = true
        names[#names + 1] = name
    end

    return names, nil
end

--- Runs one named case in its own process and returns the record it wrote.
local function runCase(path: string, name: string, n: integer?, timeoutMs: integer): (any?, string?)
    os.remove(RECORD_OUT)
    os.remove(REMARKS_OUT)
    local extra = {"--case", name, "--out", RECORD_OUT, "--quiet"}
    if n then
        extra[#extra + 1] = "--n"
        extra[#extra + 1] = tostring(n)
    end
    local ok, runProblem = nuppRun(path, extra, timeoutMs)
    local text = readFile(RECORD_OUT)
    if not text then
        return nil, path .. " / " .. name .. ": " .. (runProblem or "wrote no record")
    end
    local parsed, decoded = pcall(json.decode, text)
    if not parsed then
        return nil, path .. " / " .. name .. ": wrote a record that does not parse"
    end
    -- Re-read after the child exited. `nupp run` writes the account again once every
    -- module the program required has been compiled, so this is the complete one and
    -- what the child embedded mid-run is only the entry.
    local remarksText = readFile(REMARKS_OUT)
    if remarksText then
        local readOk, remarks = pcall(json.decode, remarksText)
        if readOk then
            decoded.executionProfile = remarks.executionProfile
            decoded.remarks = remarks.remarks
            decoded.allocationSites = remarks.allocationSites
            decoded.compiler = remarks.compiler
        end
    end
    if not ok then
        return decoded, path .. " / " .. name .. ": " .. (runProblem or "the case reported a failure")
    end

    return decoded, nil
end

--- The record this exact case had before, if any.
local function previousCase(document: any, path: string, name: string): any?
    for _, entry in ipairs(document and document.cases or {}) do
        if entry.name == name and entry.case == path then
            return entry.record
        end
    end

    return nil
end

--- The fixed iteration count in one case record, if it is a throughput case.
local function previousIterations(record: any): integer?
    for _, measurement in ipairs(record and record.cases or {}) do
        if measurement.kind == "case" and type(measurement.n) == "number" and measurement.n >= 1 then
            return math.floor(measurement.n)
        end
    end

    return nil
end

local function usage(): nil
    io.stdout:write(
        [[
Usage: nupp run bench/run.nupp [options]

  --case NAME             run only an exact benchmark name
  --file PATH             inspect and run only one benchmark program
  --list                  list benchmark names and source files without running
  --timeout-ms INTEGER    child deadline in milliseconds (default 120000)
  --baseline PATH         compare deterministic counters with this baseline
  --accept                replace the named baseline after a complete run
  --history PATH          append the complete JSON record as one NDJSON line
  --label TEXT            attach a label to the record and history entry
  --json                  write only the merged JSON record to stdout
]]
    )
end

local function main(): integer
    local baselinePath: string? = nil
    local accept = false
    local asJson = false
    local listOnly = false
    local only: string? = nil
    local onlyFile: string? = nil
    local historyPath: string? = nil
    local label: string? = nil
    local timeoutMs = DEFAULT_TIMEOUT_MS
    local argv = _G.arg as {string}?
    local index: integer = 1
    while argv and argv[index] do
        local entry = argv[index]
        if entry == "--accept" then
            accept = true
        elseif entry == "--json" then
            asJson = true
        elseif entry == "--list" then
            listOnly = true
        elseif entry == "--help" then
            usage()

            return 0
        elseif entry == "--baseline" then
            local given = argv[index + 1]
            if not given then
                io.stderr:write("bench: --baseline needs a path\n")

                return 1
            end
            baselinePath = given
            index = (index + 1) as integer
        elseif entry == "--case" then
            local given = argv[index + 1]
            if not given then
                io.stderr:write("bench: --case needs a name\n")

                return 1
            end
            only = given
            index = (index + 1) as integer
        elseif entry == "--file" then
            local given = argv[index + 1]
            if not given then
                io.stderr:write("bench: --file needs a path\n")

                return 1
            end
            onlyFile = given
            index = (index + 1) as integer
        elseif entry == "--history" then
            local given = argv[index + 1]
            if not given then
                io.stderr:write("bench: --history needs a path\n")

                return 1
            end
            historyPath = given
            index = (index + 1) as integer
        elseif entry == "--label" then
            local given = argv[index + 1]
            if not given then
                io.stderr:write("bench: --label needs text\n")

                return 1
            end
            label = given
            index = (index + 1) as integer
        elseif entry == "--timeout-ms" then
            local given = tonumber(argv[index + 1])
            if not given or given < 1 or given ~= math.floor(given) then
                io.stderr:write("bench: --timeout-ms needs a positive whole number\n")

                return 1
            end
            timeoutMs = math.floor(given)
            index = (index + 1) as integer
        end
        index = (index + 1) as integer
    end

    if listOnly then
        local failed = false
        local listed: integer = 0
        local paths = onlyFile and {onlyFile} or discover()
        for _, path in ipairs(paths) do
            local names, problem = casesIn(path, timeoutMs)
            if problem then
                io.stderr:write("bench: " .. path .. ": " .. problem .. "\n")
                failed = true
            end
            for _, name in ipairs(names) do
                if not only or only == name then
                    io.stdout:write(name, "\t", path, "\n")
                    listed = (listed + 1) as integer
                end
            end
        end
        if listed == 0 and not failed then
            io.stderr:write("bench: no benchmark matched the selection\n")
            failed = true
        end

        return failed and 1 or 0
    end

    local previous: any = nil
    if baselinePath then
        local text = readFile(baselinePath)
        if text then
            local ok, decoded = pcall(json.decode, text)
            previous = ok and decoded or nil
        end
        -- A named baseline that is not there is not a pass. Exiting zero here is how a
        -- lost baseline comes to look exactly like a clean run.
        if not previous and not accept then
            io.stderr:write("bench: no baseline at " .. baselinePath .. "\n")

            return 1
        end
    end

    local merged: {any} = {}
    local executionFailures: {string} = {}
    local regressions: {string} = {}
    local notes: {string} = {}
    local matched: integer = 0
    local paths = onlyFile and {onlyFile} or discover()
    for _, path in ipairs(paths) do
        local names, listingFailure = casesIn(path, timeoutMs)
        if listingFailure then
            executionFailures[#executionFailures + 1] = path .. ": " .. listingFailure
        elseif #names == 0 then
            executionFailures[#executionFailures + 1] = path .. ": defines no case"
        end
        for _, name in ipairs(names) do
            if only and name ~= only then
                goto nextCase
            end
            matched = (matched + 1) as integer
            if not asJson then
                io.stdout:write(("# Benchmark: %s (%s)\n"):format(name, path))
                io.stdout:flush()
            end
            local was = previousCase(previous, path, name)
            local record, failure = runCase(path, name, previousIterations(was), timeoutMs)
            if failure then
                executionFailures[#executionFailures + 1] = failure
            end
            if record then
                merged[#merged + 1] = {case = path, name = name, record = record,}
                if previous then
                    if not was then
                        notes[#notes + 1] = name .. ": no baseline for this case"
                    else
                        local caseFailures, caseNotes = compare(record, was)
                        for _, entry in ipairs(caseFailures) do
                            regressions[#regressions + 1] = name .. ": " .. entry
                        end
                        for _, entry in ipairs(caseNotes) do
                            notes[#notes + 1] = name .. ": " .. entry
                        end
                    end
                end
            end
            ::nextCase::
        end
    end
    if (only or onlyFile) and matched == 0 and #executionFailures == 0 then
        local description = only and ("case " .. only) or ("file " .. (onlyFile or ""))
        executionFailures[#executionFailures + 1] = "no benchmark matched " .. description
    end

    local document = {schema = 2, recordedAt = os.date("!%Y-%m-%dT%H:%M:%SZ"), label = label, cases = merged,}
    local encoded = json.encode(document)
    if not writeFile(MERGED_OUT, encoded) then
        executionFailures[#executionFailures + 1] = "cannot write " .. MERGED_OUT
    end
    if historyPath and #executionFailures == 0 and not appendFile(historyPath, encoded .. "\n") then
        executionFailures[#executionFailures + 1] = "cannot append " .. historyPath
    end
    if asJson then
        io.stdout:write(encoded, "\n")
    else
        local cases = {}
        for _, entry in ipairs(merged) do
            for _, measurement in ipairs(entry.record.cases or {}) do
                cases[#cases + 1] = measurement
            end
        end
        io.stdout:write(format({cases = cases,}))
    end
    for _, note in ipairs(notes) do
        io.stderr:write("bench: uncompared: " .. note .. "\n")
    end
    for _, failure in ipairs(executionFailures) do
        io.stderr:write("bench: " .. failure .. "\n")
    end
    for _, regression in ipairs(regressions) do
        io.stderr:write("bench: " .. (accept and "accepted: " or "") .. regression .. "\n")
    end
    if baselinePath and accept then
        if #executionFailures > 0 then
            io.stderr:write("bench: baseline not written because a case failed\n")

            return 1
        end
        if not writeFile(baselinePath, encoded) then
            io.stderr:write("bench: cannot write " .. baselinePath .. "\n")

            return 1
        end
        io.stdout:write("bench: baseline written to " .. baselinePath .. "\n")

        return 0
    end
    if accept and not baselinePath then
        io.stderr:write("bench: --accept needs --baseline PATH to write\n")

        return 1
    end

    return (#executionFailures > 0 or #regressions > 0) and 1 or 0
end

os.exit(main())
