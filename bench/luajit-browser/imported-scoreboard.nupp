const assert2 = require("assert")

local json = require("serde.json")
local text = require("string.buffer")
local utf8 = require("utf8")
local uri = io

local type Player = {
    name: string,
    score: integer,
    connected: boolean
}
local type Snapshot = {
    round: integer,
    names: {string},
    total: integer,
    payload: string
}

local function scorePlayers(players: {Player}, round: integer): Snapshot
    local names: {string} = {}
    local total: integer = 0
    for _, player in ipairs(players) do
        if player.connected then
            names[#names + 1] = utf8.truncate(player.name, 24)
            total = total + player.score
        end
    end
    table.sort(names)
    local payload = json.encodevalue({round = round, players = names, total = total})

    return {round = round, names = names, total = total, payload = payload}
end

local function describe(snapshot: Snapshot): string
    local out = text.new()
    out:put("round=", tostring(snapshot.round), "\n")
    out:put("players=", table.concat(snapshot.names, ", "), "\n")
    out:put("total=", tostring(snapshot.total), "\n")
    out:put("payload=", binary.hexencode(snapshot.payload), "\n")

    return out:get()
end

local function destination(round: integer): (string, string)
    local localFile = io.Path.of("scores", "round-" .. tostring(round)):withextension("json")
    local endpoint = assert2(uri.URI.of("https://game.example/scores/"))
    local remoteFile = assert2(endpoint:resolve(assert2(localFile:filename())))
    return localFile:tostring(), remoteFile:tostring()
end

local players: {
    Player
} = {
    {name = "Ada", score = 120, connected = true},
    {name = "Lin", score = 90, connected = true},
    {name = "Grace", score = 140, connected = false},
}
local round: integer = 5
local snapshot = scorePlayers(players, round)
local localFile, remoteFile = destination(round)
local report = describe(snapshot)
local wire = binary.hexencode("scoreboard-edit-5")
assert2(binary.hexdecode(wire) == "scoreboard-edit-5")
assert2(snapshot.total == 210)
assert2(utf8.len(snapshot.names[1]) == 3)
return report, localFile, remoteFile, wire
