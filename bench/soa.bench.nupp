-- Compares compiler-lowered SoA rows with hand-written parallel cdata columns
-- and the canonical AoS struct layout.
-- Run: nupp bench --file bench/soa.bench.nupp

local bench = require("nupp.bench")
const {type Invocation} = require("nupp.bench")
local soa = require("nupp.mem.soa")
local ffi = require("ffi")

local struct Particle
    x: float
    y: float
    dx: float
    dy: float
end

local struct Scalar
    value: float
end

local COUNT: integer = 100000
local STEPS: integer = 30
local DT = 1 / 60

local function generatedSoA(_: any, _: Invocation): number
    local particles = soa.allocate(ffi.typeof<Particle>(), COUNT)
    local sink = 0.0
    with rows = particles:write() do
        for i = 1, #rows do
            rows[i].x = i
            rows[i].y = i * 2
            rows[i].dx = 0.1
            rows[i].dy = 0.2
        end
        for _ = 1, STEPS do
            for i = 1, #rows do
                rows[i].x += rows[i].dx * DT
                rows[i].y += rows[i].dy * DT
            end
        end
        for i = 1, #rows do
            sink += rows[i].x + rows[i].y
        end
    end

    return sink
end

local function handwrittenSoA(_: any, _: Invocation): number
    unsafe do
        local xs = carray(Scalar, COUNT)
        local ys = carray(Scalar, COUNT)
        local dxs = carray(Scalar, COUNT)
        local dys = carray(Scalar, COUNT)
        for i = 0, COUNT - 1 do
            xs[i].value = i + 1
            ys[i].value = (i + 1) * 2
            dxs[i].value = 0.1
            dys[i].value = 0.2
        end
        for _ = 1, STEPS do
            for i = 0, COUNT - 1 do
                xs[i].value += dxs[i].value * DT
                ys[i].value += dys[i].value * DT
            end
        end
        local sink = 0.0
        for i = 0, COUNT - 1 do
            sink += xs[i].value + ys[i].value
        end

        return sink
    end
end

local function ordinaryAoS(_: any, _: Invocation): number
    unsafe do
        local particles = carray(Particle, COUNT)
        for i = 0, COUNT - 1 do
            particles[i].x = i + 1
            particles[i].y = (i + 1) * 2
            particles[i].dx = 0.1
            particles[i].dy = 0.2
        end
        for _ = 1, STEPS do
            for i = 0, COUNT - 1 do
                particles[i].x += particles[i].dx * DT
                particles[i].y += particles[i].dy * DT
            end
        end
        local sink = 0.0
        for i = 0, COUNT - 1 do
            sink += particles[i].x + particles[i].y
        end

        return sink
    end
end

bench.suite(
    {
        name = "soa",
        baselineVariant = "handwritten-soa",
        variants = {
            {name = "generated-soa", run = generatedSoA},
            {name = "handwritten-soa", run = handwrittenSoA},
            {name = "aos", run = ordinaryAoS},
        },
        cases = {{name = "particle-update", operations = COUNT * STEPS},},
        warmupIterations = 1,
        sampleIterations = 2,
        minSamples = 5,
        minDurationSec = 0.5,
        maxSamples = 250,
        maxDurationSec = 10,
    } as bench.SuiteOptions
)
bench.report()
