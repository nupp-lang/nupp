-- Compare Nupp's automatic PEG specialization layer with forced LPeg lowering.
-- Run: nupp bench --file bench/peg-kernels.bench.nupp

local bench = require("nupp.bench")
const {type Invocation} = require("nupp.bench")

local AutoSpan = nupp.peg.compile("[a-zA-Z_] [a-zA-Z_0-9]* !.")
local LPEGSpan = nupp.peg.compile("[a-zA-Z_] [a-zA-Z_0-9]* !.", {backend = "lpeg"})
local AutoList = nupp.peg.compile("{| { [a-z]+ } (',' { [a-z]+ })* |} !.")
local LPEGList = nupp.peg.compile("{| { [a-z]+ } (',' { [a-z]+ })* |} !.", {backend = "lpeg"})
local AutoNested = nupp.peg.compile("start <- value !. value <- 'x' / '(' value ')'")
local LPEGNested = nupp.peg.compile("start <- value !. value <- 'x' / '(' value ')'", {backend = "lpeg"})
local AutoRoute = nupp.peg.compile(
    [[
    ('GET' / 'POST' / 'PUT' / 'PATCH' / 'DELETE') ' '
    [a-z0-9/_-]+ ' HTTP/1.' ('0' / '1') !.
]]
)
local LPEGRoute = nupp.peg.compile(
    [[
    ('GET' / 'POST' / 'PUT' / 'PATCH' / 'DELETE') ' '
    [a-z0-9/_-]+ ' HTTP/1.' ('0' / '1') !.
]],
    {backend = "lpeg"}
)

local record Workload
    name: string
    automatic: nupp.peg.Peg<any>
    lpeg: nupp.peg.Peg<any>
    subjects: {string}
end

local workloads = {
    new Workload(
        name = "single-span",
        automatic = AutoSpan,
        lpeg = LPEGSpan,
        subjects = {"alpha_123", "_name9", "long_identifier_1234567890", "x", "9bad", "bad-name", "", "two words",}
    ),
    new Workload(
        name = "capture-list",
        automatic = AutoList,
        lpeg = LPEGList,
        subjects = {"one,two,three", "a,b,c,d", "single", "many,small,words,here", "one,", ",two", "UPPER", "",}
    ),
    new Workload(
        name = "nested",
        automatic = AutoNested,
        lpeg = LPEGNested,
        subjects = {"x", "(x)", "((x))", "((((x))))", "((x)", "(x))", "y", ""}
    ),
    new Workload(
        name = "packed-route",
        automatic = AutoRoute,
        lpeg = LPEGRoute,
        subjects = {
            "GET /users/42 HTTP/1.1",
            "POST /items HTTP/1.0",
            "DELETE /x HTTP/1.1",
            "PATCH /a-b_9 HTTP/1.1",
            "HEAD / HTTP/1.1",
            "GET  HTTP/1.1",
            "GET /x HTTP/2.0",
            "GET /X HTTP/1.1",
        }
    ),
}

local BATCH: integer = 10000

local function runAutomatic(_: any, invocation: Invocation): integer
    local workload = invocation.data as Workload
    local hits: integer = 0
    for _ = 1, BATCH do
        for _, subject in ipairs(workload.subjects) do
            if workload.automatic(subject) ~= nil then
                hits = hits + 1
            end
        end
    end

    return hits
end

local function runLPeg(_: any, invocation: Invocation): integer
    local workload = invocation.data as Workload
    local hits: integer = 0
    for _ = 1, BATCH do
        for _, subject in ipairs(workload.subjects) do
            if workload.lpeg(subject) ~= nil then
                hits = hits + 1
            end
        end
    end

    return hits
end

local cases = {}
for _, workload in ipairs(workloads) do
    for _, subject in ipairs(workload.subjects) do
        assert(workload.automatic(subject) ~= nil == (workload.lpeg(subject) ~= nil))
    end
    cases[#cases + 1] = {name = workload.name, data = workload, operations = BATCH * #workload.subjects}
end

bench.suite(
    {
        name = "peg-kernels",
        baselineVariant = "automatic",
        variants = {{name = "automatic", run = runAutomatic}, {name = "lpeg", run = runLPeg},},
        cases = cases,
        warmupIterations = 3,
        minSamples = 7,
        minDurationSec = 0.5,
    } as bench.SuiteOptions
)
bench.report()
