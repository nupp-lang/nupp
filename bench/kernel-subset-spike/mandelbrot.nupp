-- Mandelbrot escape counts, as one AOT-compiled function.
--
-- The Tecs workload in kernels.nupp is memory-bound: it streams two component columns
-- and does a little arithmetic per row, so it measures bandwidth more than code. This
-- one is the opposite and is here for that reason. Each pixel reads sixteen bytes once
-- and then runs a bounded loop over four live doubles that touches no memory at all, so
-- what it measures is how well the inner loop was compiled. That is the
-- register-resident arithmetic chain docs/neps/0009-ahead-of-time-compilation.md asks
-- for in its performance gates, written as ordinary Nupp.
--
-- The complex plane is an input rather than something the kernel derives from a
-- pixel index, which keeps this a map over two spans and leaves the grid the
-- caller's business.
local span = require("nupp.mem.span")

local struct Point
    re: float
    im: float
end

local struct Escape
    iterations: int32
    escaped: uint32
end

-- Fusing `a * b + c` into one rounding is faster and gives a different answer,
-- so it is asked for here rather than assumed. Without this line the kernel is
-- exact and reproducible across targets; with it, it is neither. Measured on
-- Apple arm64 at 1024x768 and 256 iterations it is worth about six percent
-- either way -- 128.5 against 121.4 MPix/s lane-parallel, 66.4 against 62.6
-- forced scalar -- which is a real gain and not the doubling this comment used
-- to claim. `mandelbrot_exact.nupp` is the same source without the line.
@relax("fp-contract")
@aot
local function mandelbrot(
    exclusive escapes: span.WriteSpan<Escape>,
    borrows points: span.Span<Point>,
    first: integer,
    last: integer,
    maxIterations: int32
): nil
    assert(#escapes == #points, "length mismatch")
    assert(first >= 1 and last <= #escapes and first <= last + 1, "range out of bounds")

    for i = first, last do
        local escape = escapes[i]
        local point = points[i]
        local cx = point.re
        local cy = point.im
        -- The main cardioid and the period-2 bulb are known to be in the set, so
        -- a point inside either needs no iteration at all. This is the single
        -- largest win available here and it costs a handful of multiplies: the
        -- interior is exactly the region that otherwise runs every iteration.
        -- It changes no answer, because a point that is in the set would have
        -- reached maxIterations anyway.
        local cardioidX = cx - 0.25
        local ySquared = cy * cy
        local q = cardioidX * cardioidX + ySquared
        local inCardioid = 0
        if q * (q + cardioidX) <= 0.25 * ySquared then
            inCardioid = 1
        end
        if (cx + 1.0) * (cx + 1.0) + ySquared <= 0.0625 then
            inCardioid = 1
        end
        -- z is carried as its two components and their squares, so the escape
        -- test and the next iterate share the multiplications rather than
        -- repeating them. This is the ordinary formulation, not an AOT-specific
        -- one: the same source compiles either way.
        local zx = 0.0
        local zy = 0.0
        local zxSquared = 0.0
        local zySquared = 0.0
        local iteration = 0
        local escaped = 0
        if inCardioid == 1 then
            iteration = maxIterations
        end
        while iteration < maxIterations do
            if zxSquared + zySquared > 4.0 then
                escaped = 1
                break
            end
            zy = 2.0 * zx * zy + cy
            zx = zxSquared - zySquared + cx
            zxSquared = zx * zx
            zySquared = zy * zy
            iteration = iteration + 1
        end
        escape.iterations = iteration
        escape.escaped = escaped
    end
end

return {mandelbrot = mandelbrot, Point = Point, Escape = Escape,}
