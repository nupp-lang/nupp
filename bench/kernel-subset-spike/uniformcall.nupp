-- A helper called with uniform arguments, from inside a lane body.
--
-- The call produces the same pair of results for every lane, so nothing about
-- it is lane-typed and it stays the statement it was. Before this it produced a
-- node no verifier rule covered, and compiling the kernel raised rather than
-- declining lanes -- a latent hole, because no committed kernel had one.
--
-- Forced, because two multiplies over twenty-four bytes is below the threshold.
-- The point of the file is the shape rather than the decision about it.
local span = require("nupp.span")

local struct Position
    x: float
    y: float
end

local struct Velocity
    vx: float
    vy: float
end

--- The step a whole call shares, as a pair. Pure and visible, so the lane pass
--- may treat it as substitution rather than as a call it cannot see into.
local function schedule(dt: number, drag: number): (number, number)
    return dt * 0.5, 1.0 - drag * dt
end

@aot(lanes = true)
local function advance(
    exclusive positions: span.WriteSpan<Position>,
    borrows velocities: span.Span<Velocity>,
    first: integer,
    last: integer,
    dt: number,
    drag: number
): nil
    if positions.count ~= velocities.count then
        error("length mismatch", 2)
    end
    if first < 1 or last > positions.count or first > last + 1 then
        error("range out of bounds", 2)
    end

    for i = first, last do
        -- Both operands are uniform parameters, so both results are uniform and
        -- every lane reads the same two numbers.
        local half, damping = schedule(dt, drag)
        local position = positions:getMut(i)
        local velocity = velocities:get(i)
        position.x = (position.x + velocity.vx * dt) * damping + half * velocity.vx
        position.y = (position.y + velocity.vy * dt) * damping + half * velocity.vy
    end
end

return {advance = advance, Position = Position, Velocity = Velocity,}
