-- Fixed nonescaping accumulator storage at three literal block sizes. The
-- generated assembly answers whether the stack arrays scalar-replace into
-- registers before a broader blocked-kernel surface is justified.
local valuebuilder = require("nupp.data.valuebuilder")

local function indexOf(row: integer, column: integer, width: integer): uint32
    return nupp.math.u32.wrap((row - 1) * width + column - 1)
end

@aot(lanes = false)
local function accumulate2(seed: uint32): uint32
    local values = valuebuilder.newFixedWordScratch(4)
    for row = 1, 2 do
        for column = 1, 2 do
            local index = indexOf(row, column, 2)
            valuebuilder.setScratchWord(values, index, nupp.math.u32.add(seed, index))
        end
    end
    local total = nupp.math.u32.wrap(0)
    for row = 1, 2 do
        for column = 1, 2 do
            total = nupp.math.u32.add(total, valuebuilder.scratchWord(values, indexOf(row, column, 2)))
        end
    end
    return total
end

@aot(lanes = false)
local function accumulate4(seed: uint32): uint32
    local values = valuebuilder.newFixedWordScratch(16)
    for row = 1, 4 do
        for column = 1, 4 do
            local index = indexOf(row, column, 4)
            valuebuilder.setScratchWord(values, index, nupp.math.u32.add(seed, index))
        end
    end
    local total = nupp.math.u32.wrap(0)
    for row = 1, 4 do
        for column = 1, 4 do
            total = nupp.math.u32.add(total, valuebuilder.scratchWord(values, indexOf(row, column, 4)))
        end
    end
    return total
end

@aot(lanes = false)
local function accumulate16(seed: uint32): uint32
    local values = valuebuilder.newFixedWordScratch(256)
    for row = 1, 16 do
        for column = 1, 16 do
            local index = indexOf(row, column, 16)
            valuebuilder.setScratchWord(values, index, nupp.math.u32.add(seed, index))
        end
    end
    local total = nupp.math.u32.wrap(0)
    for row = 1, 16 do
        for column = 1, 16 do
            total = nupp.math.u32.add(total, valuebuilder.scratchWord(values, indexOf(row, column, 16)))
        end
    end
    return total
end

return {accumulate2 = accumulate2, accumulate4 = accumulate4, accumulate16 = accumulate16,}
