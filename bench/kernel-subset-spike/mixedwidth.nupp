-- What the all-or-nothing gang-width rule costs, as a kernel that pays it.
--
-- Width selection is all-or-nothing today: one binary64 varying value drops the
-- whole loop to four lanes, whatever the other values are. This is that shape --
-- everything the loop carries is binary32 except one running total, which is
-- binary64 because summing many small contributions in binary32 loses them.
--
-- It exists to measure the cost of the rule rather than to argue about it. The
-- bound on what mixed-width gangs could recover here is the ratio between this
-- kernel and `mixedwidth_f32.nupp`, which is the same arithmetic with the total
-- narrowed so the whole loop is 32-bit and gets eight lanes. Mixed widths would
-- recover less than that bound, because the binary64 value would still occupy
-- twice the registers of a binary32 one.
local span = require("nupp.span")

local struct Body
    x: float
    y: float
    vx: float
    vy: float
end

local struct Track
    distance: float
    steps: int32
end

@aot(lanes = true)
local function integrate(
    exclusive tracks: span.WriteSpan<Track>,
    borrows bodies: span.Span<Body>,
    first: integer,
    last: integer,
    steps: int32,
    damping: float,
    interval: float,
    limit: float
): nil
    if tracks.count ~= bodies.count then
        error("length mismatch", 2)
    end
    if first < 1 or last > tracks.count or first > last + 1 then
        error("range out of bounds", 2)
    end

    for i = first, last do
        local track = tracks:getMut(i)
        local body = bodies:get(i)
        local x = nupp.math.f32.narrow(body.x)
        local y = nupp.math.f32.narrow(body.y)
        local vx = nupp.math.f32.narrow(body.vx)
        local vy = nupp.math.f32.narrow(body.vy)
        -- The one binary64 value, and the reason this loop has no gang at all.
        -- A running total over many contributions is exactly where binary32
        -- stops being enough: each is small against the accumulated sum, so in
        -- binary32 most of them round away entirely.
        local travelled = 0.0
        local step = 0
        while step < steps do
            local ax = nupp.math.f32.mul(x, damping)
            local ay = nupp.math.f32.mul(y, damping)
            vx = nupp.math.f32.add(vx, ax)
            vy = nupp.math.f32.add(vy, ay)
            local dx = nupp.math.f32.mul(vx, interval)
            local dy = nupp.math.f32.mul(vy, interval)
            x = nupp.math.f32.add(x, dx)
            y = nupp.math.f32.add(y, dy)
            travelled = travelled
                + math.sqrt(nupp.math.f32.add(nupp.math.f32.mul(dx, dx), nupp.math.f32.mul(dy, dy)))
            step = step + 1
            if nupp.math.f32.add(nupp.math.f32.mul(x, x), nupp.math.f32.mul(y, y)) < limit then
                break
            end
        end
        track.distance = nupp.math.f32.narrow(travelled)
        track.steps = step
    end
end

return {integrate = integrate, Body = Body, Track = Track,}
