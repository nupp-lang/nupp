local span = require("nupp.mem.span")
local array = require("nupp.mem.array")
local simd = require("nupp.simd")

@aot
local function advance(
    exclusive xs: span.WriteSpan<float>,
    exclusive ys: span.WriteSpan<float>,
    borrows vxs: span.Span<float>,
    borrows vys: span.Span<float>,
    first: integer,
    last: integer,
    dt: float
): nil
    if #xs ~= #ys or #xs ~= #vxs or #xs ~= #vys then
        error("length mismatch", 2)
    end
    if first < 1 or last > #xs or first > last + 1 then
        error("range out of bounds", 2)
    end

    if floats = simd.species(array.float, 4) then
        local doubles = assert(simd.species(array.number, 4))
        -- A uint32 cursor bounded by the span proves every whole-vector
        -- access, so none of them checks its lanes; `last` alone does not.
        local cursor: uint32 = nupp.math.u32.wrap(first - 1)
        while cursor + floats.lanes <= #xs and cursor + floats.lanes <= last do
            local x = doubles:convert(floats:load(xs, cursor + 1))
            local y = doubles:convert(floats:load(ys, cursor + 1))
            local vx = doubles:convert(floats:load(vxs, cursor + 1))
            local vy = doubles:convert(floats:load(vys, cursor + 1))
            floats:store(xs, cursor + 1, floats:convert(x + vx * dt))
            floats:store(ys, cursor + 1, floats:convert(y + vy * dt))
            cursor = cursor + floats.lanes
        end
        if cursor < last then
            local active = floats:tail(last - cursor)
            local x = doubles:convert(floats:load(xs, cursor + 1, active))
            local y = doubles:convert(floats:load(ys, cursor + 1, active))
            local vx = doubles:convert(floats:load(vxs, cursor + 1, active))
            local vy = doubles:convert(floats:load(vys, cursor + 1, active))
            floats:store(xs, cursor + 1, floats:convert(x + vx * dt), active)
            floats:store(ys, cursor + 1, floats:convert(y + vy * dt), active)
        end
    else
        for index = first, last do
            xs[index] = xs[index] + vxs[index] * dt
            ys[index] = ys[index] + vys[index] * dt
        end
    end
end

@aot
local function advanceScalar(
    exclusive xs: span.WriteSpan<float>,
    exclusive ys: span.WriteSpan<float>,
    borrows vxs: span.Span<float>,
    borrows vys: span.Span<float>,
    first: integer,
    last: integer,
    dt: float
): nil
    if #xs ~= #ys or #xs ~= #vxs or #xs ~= #vys then
        error("length mismatch", 2)
    end
    if first < 1 or last > #xs or first > last + 1 then
        error("range out of bounds", 2)
    end

    for index = first, last do
        xs[index] = xs[index] + vxs[index] * dt
        ys[index] = ys[index] + vys[index] * dt
    end
end

return {advance = advance, advanceScalar = advanceScalar,}
