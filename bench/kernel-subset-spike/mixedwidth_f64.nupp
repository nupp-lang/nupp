-- Which half of the mixed-width cost is which.
--
-- `mixedwidth.nupp` takes the binary64 gang and has to round every explicit
-- binary32 operation through a narrow vector and back. `mixedwidth_f32.nupp`
-- takes the 32-bit gang and rounds nothing. Those differ in two ways at once --
-- lane count and rounding -- so neither says which one costs.
--
-- This is the same loop in ordinary binary64 arithmetic: the same four lanes as
-- `mixedwidth.nupp` and no rounding at all. What separates it from that kernel
-- is the rounding alone, and what separates it from the 32-bit one is the lane
-- count alone.
local span = require("nupp.span")

local struct Body
    x: float
    y: float
    vx: float
    vy: float
end

local struct Track
    distance: float
    steps: int32
end

@aot(lanes = true)
local function integrate(
    exclusive tracks: span.WriteSpan<Track>,
    borrows bodies: span.Span<Body>,
    first: integer,
    last: integer,
    steps: int32,
    damping: float,
    interval: float,
    limit: float
): nil
    if #tracks ~= #bodies then
        error("length mismatch", 2)
    end
    if first < 1 or last > #tracks or first > last + 1 then
        error("range out of bounds", 2)
    end

    for i = first, last do
        local track = tracks[i]
        local body = bodies[i]
        local x = body.x
        local y = body.y
        local vx = body.vx
        local vy = body.vy
        local travelled = 0.0
        local step = 0
        while step < steps do
            local ax = x * damping
            local ay = y * damping
            vx = vx + ax
            vy = vy + ay
            local dx = vx * interval
            local dy = vy * interval
            x = x + dx
            y = y + dy
            travelled = travelled + math.sqrt(dx * dx + dy * dy)
            step = step + 1
            if x * x + y * y < limit then
                break
            end
        end
        track.distance = nupp.math.f32.narrow(travelled)
        track.steps = step
    end
end

return {integrate = integrate, Body = Body, Track = Track,}
