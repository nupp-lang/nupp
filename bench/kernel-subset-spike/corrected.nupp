-- The three binary32 operations whose native instruction is not their meaning.
--
-- add, sub, mul, div and sqrt are bit-identical to the single-precision
-- instruction because a binary32 operation over binary32 operands computed in
-- binary64 and rounded once rounds the same way (53 >= 2 * 24 + 2). min, max
-- and fma are not covered by that argument, and a differential over every
-- interesting binary32 value says why: `nupp.math.f32` canonicalizes every NaN
-- where the instruction propagates a payload, and min and max return that
-- canonical NaN where IEEE minNum returns whichever operand is not NaN.
--
-- Nothing else differs -- not signed zero, not subnormals, not overflow, not
-- any ordinary value -- so each is admitted with a correcting select rather
-- than left out of the subset. This kernel is what proves the correction, by
-- running the three over inputs that include both NaN shapes.
local span = require("nupp.mem.span")

local struct Sample
    a: float
    b: float
    c: float
end

local struct Result
    least: float
    greatest: float
    fused: float
end

-- Forced: this kernel exists to prove the lane form of three operations, so
-- it has to have one. Its arithmetic per byte is far below where lanes pay.
@aot(vectorize = true)
local function corrected(
    exclusive results: span.WriteSpan<Result>,
    borrows samples: span.Span<Sample>,
    first: integer,
    last: integer
): nil
    if #results ~= #samples then
        error("length mismatch", 2)
    end
    if first < 1 or last > #results or first > last + 1 then
        error("range out of bounds", 2)
    end

    for i = first, last do
        local result = results[i]
        local sample = samples[i]
        local a = nupp.math.f32.narrow(sample.a)
        local b = nupp.math.f32.narrow(sample.b)
        local c = nupp.math.f32.narrow(sample.c)
        result.least = nupp.math.f32.min(a, b)
        result.greatest = nupp.math.f32.max(a, b)
        result.fused = nupp.math.f32.fma(a, b, c)
    end
end

return {corrected = corrected, Sample = Sample, Result = Result,}
