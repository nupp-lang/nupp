-- Mandelbrot escape counts in explicit binary32, as one AOT-compiled function.
--
-- This is mandelbrot.nupp's algorithm with one thing changed: it asks for
-- binary32 arithmetic instead of ordinary binary64 operators. It is therefore a
-- different program with different answers -- binary32 rounding moves which
-- iteration a pixel escapes on -- and it says so in its own source rather than
-- acquiring that meaning from a compiler flag or an annotation.
--
-- Nothing here is new language. `nupp.math.f32` and `nupp.math.i32` are the
-- released fixed-width namespaces, their Lua implementations are the exact
-- oracle this is diffed against, and an ordinary run of this file computes the
-- same answers one pixel at a time. What AOT adds is that a binary32 operation
-- over binary32 operands is bit-identical to the native single-precision
-- instruction, so eight lanes fit in the registers four binary64 lanes needed.
--
-- The cost is visible in every line: the arithmetic is prefix calls rather than
-- operators. That is the trade this file exists to price.
local span = require("nupp.mem.span")

local struct Point
    re: float
    im: float
end

local struct Escape
    iterations: int32
    escaped: uint32
end

@aot
local function mandelbrot(
    exclusive escapes: span.WriteSpan<Escape>,
    borrows points: span.Span<Point>,
    first: integer,
    last: integer,
    maxIterations: int32
): nil
    if #escapes ~= #points then
        error("length mismatch", 2)
    end
    if first < 1 or last > #escapes or first > last + 1 then
        error("range out of bounds", 2)
    end

    for i = first, last do
        local escape = escapes[i]
        local point = points[i]
        -- A float field already holds a binary32 value, so narrowing the loaded
        -- number re-establishes the refinement without changing it.
        local cx = nupp.math.f32.narrow(point.re)
        local cy = nupp.math.f32.narrow(point.im)
        -- The cardioid and period-2 bulb test, in the same binary32 the rest of
        -- the kernel uses. Every constant here is exact in binary32.
        local quarter: float = 0.25
        local cardioidX = nupp.math.f32.sub(cx, quarter)
        local ySquared = nupp.math.f32.mul(cy, cy)
        local q = nupp.math.f32.add(nupp.math.f32.mul(cardioidX, cardioidX), ySquared)
        local inCardioid: int32 = 0
        if nupp.math.f32.mul(q, nupp.math.f32.add(q, cardioidX))
            <= nupp.math.f32.mul(quarter, ySquared)
        then
            inCardioid = 1
        end
        local shifted = nupp.math.f32.add(cx, 1.0)
        if nupp.math.f32.add(nupp.math.f32.mul(shifted, shifted), ySquared) <= 0.0625 then
            inCardioid = 1
        end
        local zx: float = 0.0
        local zy: float = 0.0
        local zxSquared: float = 0.0
        local zySquared: float = 0.0
        local iteration: int32 = 0
        local escaped: int32 = 0
        if inCardioid == 1 then
            iteration = maxIterations
        end
        while iteration < maxIterations do
            if nupp.math.f32.add(zxSquared, zySquared) > 4.0 then
                escaped = 1
                break
            end
            zy = nupp.math.f32.add(
                nupp.math.f32.mul(nupp.math.f32.mul(zx, 2.0), zy), cy)
            zx = nupp.math.f32.add(nupp.math.f32.sub(zxSquared, zySquared), cx)
            zxSquared = nupp.math.f32.mul(zx, zx)
            zySquared = nupp.math.f32.mul(zy, zy)
            iteration = nupp.math.i32.add(iteration, 1)
        end
        escape.iterations = iteration
        escape.escaped = escaped
    end
end

return {mandelbrot = mandelbrot, Point = Point, Escape = Escape,}
