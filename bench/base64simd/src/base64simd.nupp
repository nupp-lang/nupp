module base64simd

--[[
Base64 encoding a vector at a time, written on the general `nupp.simd`
algebra: a byte species, `swizzle` over a pair of vectors for the byte
shuffles, and `interleave` for the output layout. Three vectors of input become
four of output per iteration -- forty-eight bytes to sixty-four on a
sixteen-lane species.

The shape is the one the literature describes. Three vectors `a`, `b`, `c`
hold `3 * lanes` consecutive bytes; the three bytes of every triple are
gathered into `b0`, `b1`, `b2` by a paired swizzle whose index vector is an
arithmetic sequence with stride three, and which reads `c` in a second swizzle
for the triples that begin past the pair. Four six-bit indexes come out of
shifts and masks. Comparisons select the four contiguous ranges of the Base64
alphabet without assuming a particular native lane count. Two rounds of
`interleave` put the four symbol vectors back into byte order, and four stores
write them.

Every vector load and store is proved in range by the loop condition, which
bounds the input by three vectors and the output by four. Every access is
an offset from one of those two cursors. What the vector loop does not
cover, the byte loop below it finishes, and the last one or two bytes get their
padding after that.
]]

const io = require("nupp.io")
local array = require("nupp.mem.array")
local simd = require("nupp.simd")
local span = require("nupp.mem.span")

local base64simd = {}

const ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

const ALPHABET_BYTES = span.fromString(ALPHABET)

--- Maps Base64 indexes to their alphabet bytes for every preferred width.
local function alphabetByte(value: simd.Vector<uint8, simd.Preferred>): simd.Vector<uint8, simd.Preferred>
    return (
        value < 26
    ):select(value + 65, (value < 52):select(value + 71, (value < 62):select(value - 4, (value == 62):select(43, 47))))
end

--- Encodes `source` into `output`, which must hold `4 * ceil(#source / 3)`
--- bytes, and answers how many bytes it wrote. `alphabet` is the sixty-four
--- symbols, which the byte tail reads by index.
---
--- Three input cursors and four output cursors advance together, one per
--- vector, because the loop condition proves each load and store from the
--- cursor it names and a `+ lanes` offset is not a cursor.
@aot
local function encode(
    exclusive output: span.WriteSpan<uint8>,
    borrows source: span.Span<uint8>,
    borrows alphabet: span.Span<uint8>
): uint32
    local at: uint32 = 0
    local out: uint32 = 0
    if species = simd.species(array.uint8) then
        local lanes: uint32 = species.lanes
        -- Lane `i` of `b_k` is byte `3i + k` of the group. Within the first
        -- two vectors that is index `3i + k + 1` of the pair; past them it is
        -- the same index less two vectors, read from the third. Each index
        -- vector is zero, and reads zero, where the other one applies.
        local gather0 = species:iota(1, 3)
        local gather1 = species:iota(2, 3)
        local gather2 = species:iota(3, 3)
        local gather0c = gather0 - 2 * lanes
        local gather1c = gather1 - 2 * lanes
        local gather2c = gather2 - 2 * lanes
        while at + 3 * lanes <= #source and out + 4 * lanes <= #output do
            local a = species:load(source, at + 1)
            local b = species:load(source, at + lanes + 1)
            local c = species:load(source, at + 2 * lanes + 1)

            local b0 = a:swizzle(gather0, b) | c:swizzle(gather0c)
            local b1 = a:swizzle(gather1, b) | c:swizzle(gather1c)
            local b2 = a:swizzle(gather2, b) | c:swizzle(gather2c)

            local d0 = b0 >> 2
            local d1 = ((b0 & 3) << 4) | (b1 >> 4)
            local d2 = ((b1 & 15) << 2) | (b2 >> 6)
            local d3 = b2 & 63

            local e0 = alphabetByte(d0)
            local e1 = alphabetByte(d1)
            local e2 = alphabetByte(d2)
            local e3 = alphabetByte(d3)

            -- Symbols of one quantum are consecutive in the output: first
            -- the even and odd symbols pair up, then the pairs do.
            local p, q = e0:interleave(e2)
            local r, s = e1:interleave(e3)
            local w0, w1 = p:interleave(r)
            local w2, w3 = q:interleave(s)
            species:store(output, out + 1, w0)
            species:store(output, out + lanes + 1, w1)
            species:store(output, out + 2 * lanes + 1, w2)
            species:store(output, out + 3 * lanes + 1, w3)

            at = at + 3 * lanes
            out = out + 4 * lanes
        end
    end

    -- Whatever the vectors did not cover, by the triple. Each byte is read
    -- at its own cursor under its own bound, which is the shape a span read
    -- in a compiled body takes, and so is each symbol of the alphabet.
    local in1: uint32 = at + 1
    local in2: uint32 = at + 2
    local to1: uint32 = out + 1
    local to2: uint32 = out + 2
    local to3: uint32 = out + 3
    while at < #source
        and in1 < #source
        and in2 < #source
        and out < #output
        and to1 < #output
        and to2 < #output
        and to3 < #output do
        local c0: uint32 = source[at + 1]
        local c1: uint32 = source[in1 + 1]
        local c2: uint32 = source[in2 + 1]
        local d0 = nupp.math.u32.shiftRightLogical(c0, 2)
        local d1 = nupp.math.u32.orBits(
            nupp.math.u32.shiftLeft(nupp.math.u32.andBits(c0, 3), 4),
            nupp.math.u32.shiftRightLogical(c1, 4)
        )
        local d2 = nupp.math.u32.orBits(
            nupp.math.u32.shiftLeft(nupp.math.u32.andBits(c1, 15), 2),
            nupp.math.u32.shiftRightLogical(c2, 6)
        )
        local d3 = nupp.math.u32.andBits(c2, 63)
        if d0 < #alphabet and d1 < #alphabet and d2 < #alphabet and d3 < #alphabet then
            output[out + 1] = alphabet[d0 + 1]
            output[to1 + 1] = alphabet[d1 + 1]
            output[to2 + 1] = alphabet[d2 + 1]
            output[to3 + 1] = alphabet[d3 + 1]
        end
        at = at + 3
        in1 = in1 + 3
        in2 = in2 + 3
        out = out + 4
        to1 = to1 + 4
        to2 = to2 + 4
        to3 = to3 + 4
    end

    -- The last one or two bytes, padded.
    if at < #source and out < #output and to1 < #output and to2 < #output and to3 < #output then
        local c0: uint32 = source[at + 1]
        local c1: uint32 = 0
        local c2: uint32 = 0
        local tailPadding: uint32 = 2
        if in1 < #source then
            c1 = source[in1 + 1]
            tailPadding = 1
        end
        local d0 = nupp.math.u32.shiftRightLogical(c0, 2)
        local d1 = nupp.math.u32.orBits(
            nupp.math.u32.shiftLeft(nupp.math.u32.andBits(c0, 3), 4),
            nupp.math.u32.shiftRightLogical(c1, 4)
        )
        local d2 = nupp.math.u32.orBits(
            nupp.math.u32.shiftLeft(nupp.math.u32.andBits(c1, 15), 2),
            nupp.math.u32.shiftRightLogical(c2, 6)
        )
        if d0 < #alphabet and d1 < #alphabet and d2 < #alphabet then
            output[out + 1] = alphabet[d0 + 1]
            output[to1 + 1] = alphabet[d1 + 1]
            if tailPadding == 1 then
                output[to2 + 1] = alphabet[d2 + 1]
            else
                output[to2 + 1] = 61
            end
            output[to3 + 1] = 61
        end
        out = out + 4
    end

    return out
end

--- How many bytes `value` encodes to: four for every three, rounded up.
local function encodedLength(value: string): integer
    return 4 * math.floor((#value + 2) / 3)
end

--- Encodes bytes as standard base64 with padding.
--- @param value the bytes to encode
--- @return the encoded text
--- @export
function base64simd.encode(value: string): string
    local bound = encodedLength(value)
    local buffer = io.newBuffer(bound)
    local lease = buffer:reserveWrite(0, bound)
    local target = lease:span()
    local written = encode(target, span.fromString(value), ALPHABET_BYTES)
    nupp.drop(target)
    lease:commit(written)

    return buffer:getString(0, written)
end

--- Allocates the same output buffer and writes one byte.
---
--- The ablation that isolates what the encoder pays before it encodes
--- anything: the buffer is sized from the input, so its cost is a function of
--- length rather than a constant per call, and the colocated C control reuses
--- one buffer where this allocates every time.
--- @param value the bytes whose length sizes the buffer
--- @return one byte
--- @export
function base64simd.allocOnly(value: string): string
    local bound = encodedLength(value)
    local buffer = io.newBuffer(bound)
    local lease = buffer:reserveWrite(0, math.max(bound, 1))
    local target = lease:span()
    target[1] = #value % 256
    nupp.drop(target)
    lease:commit(1)

    return buffer:getString(0, 1)
end

export = base64simd
