;; The typed tier: unboxed f64 and typed struct references, no casts.
(module
  (type $node (struct (field (mut (ref null $node))) (field (mut (ref null $node)))))
  (func $fib (export "fib") (param $n f64) (result f64)
    (if (f64.lt (local.get $n) (f64.const 2)) (then (return (local.get $n))))
    (f64.add (call $fib (f64.sub (local.get $n) (f64.const 1))) (call $fib (f64.sub (local.get $n) (f64.const 2)))))
  (func $make (param $d f64) (result (ref $node))
    (if (f64.eq (local.get $d) (f64.const 0)) (then (return (struct.new $node (ref.null $node) (ref.null $node)))))
    (struct.new $node (call $make (f64.sub (local.get $d) (f64.const 1))) (call $make (f64.sub (local.get $d) (f64.const 1)))))
  (func $check (param $t (ref $node)) (result f64)
    (if (ref.is_null (struct.get $node 0 (local.get $t))) (then (return (f64.const 1))))
    (f64.add (f64.add (call $check (ref.as_non_null (struct.get $node 0 (local.get $t)))) (call $check (ref.as_non_null (struct.get $node 1 (local.get $t))))) (f64.const 1)))
  (func (export "trees") (param $iters f64) (param $depth f64) (result f64)
    (local $i f64) (local $s f64)
    (block $done (loop $l
      (br_if $done (f64.ge (local.get $i) (local.get $iters)))
      (local.set $s (f64.add (local.get $s) (call $check (call $make (local.get $depth)))))
      (local.set $i (f64.add (local.get $i) (f64.const 1)))
      (br $l)))
    (local.get $s))
  ;; Allocation rate: n short-lived structs, each dropped at once.
  (func (export "churn") (param $n f64) (result f64)
    (local $i f64) (local $x (ref null $node))
    (block $done (loop $l
      (br_if $done (f64.ge (local.get $i) (local.get $n)))
      (local.set $x (struct.new $node (ref.null $node) (ref.null $node)))
      (local.set $i (f64.add (local.get $i) (f64.const 1)))
      (br $l)))
    (if (ref.is_null (local.get $x)) (then (return (f64.const -1))))
    (local.get $i))
)
