;; An allocation-heavy workload beside a large live heap: the untyped boxed
;; trees from untyped.wat, with `build_live` first filling a global list of
;; records holding boxed numbers and interned-like strings that stay alive.
(module
  (type $num (struct (field f64)))
  (type $node (struct (field (mut anyref)) (field (mut anyref))))
  (type $bytes (array (mut i8)))
  (type $lnode (struct (field $next (mut (ref null $lnode))) (field $a (mut anyref)) (field $b (mut anyref)) (field $s (mut (ref null $bytes)))))
  (global $live (mut (ref null $lnode)) (ref.null $lnode))
  (global $count (mut i32) (i32.const 0))
  (func $box (param f64) (result anyref) (struct.new $num (local.get 0)))
  (func $unbox (param anyref) (result f64) (struct.get $num 0 (ref.cast (ref $num) (local.get 0))))
  (func (export "build_live") (param $n i32)
    (local $i i32) (local $head (ref null $lnode))
    (block $done (loop $l
      (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
      (local.set $head (struct.new $lnode (local.get $head) (call $box (f64.convert_i32_u (local.get $i))) (call $box (f64.const 1.5)) (array.new_fixed $bytes 8 (i32.const 107) (i32.const 101) (i32.const 121) (local.get $i) (i32.shr_u (local.get $i) (i32.const 8)) (i32.shr_u (local.get $i) (i32.const 16)) (i32.const 0) (i32.const 0))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $l)))
    (global.set $live (local.get $head))
    (global.set $count (local.get $n)))
  (func (export "live_count") (result i32) (global.get $count))
  (func $make (param $d anyref) (result anyref)
    (local $x f64)
    (local.set $x (call $unbox (local.get $d)))
    (if (f64.eq (local.get $x) (f64.const 0)) (then (return (struct.new $node (ref.null any) (ref.null any)))))
    (struct.new $node (call $make (call $box (f64.sub (local.get $x) (f64.const 1)))) (call $make (call $box (f64.sub (local.get $x) (f64.const 1))))))
  (func $check (param $t anyref) (result anyref)
    (local $n (ref $node))
    (local.set $n (ref.cast (ref $node) (local.get $t)))
    (if (ref.is_null (struct.get $node 0 (local.get $n))) (then (return (call $box (f64.const 1)))))
    (call $box (f64.add (f64.add (call $unbox (call $check (struct.get $node 0 (local.get $n)))) (call $unbox (call $check (struct.get $node 1 (local.get $n))))) (f64.const 1))))
  (func (export "trees") (param $iters f64) (param $depth f64) (result f64)
    (local $i f64) (local $s f64)
    (block $done (loop $l
      (br_if $done (f64.ge (local.get $i) (local.get $iters)))
      (local.set $s (f64.add (local.get $s) (call $unbox (call $check (call $make (call $box (local.get $depth)))))))
      (local.set $i (f64.add (local.get $i) (f64.const 1)))
      (br $l)))
    (local.get $s))
)
