-- Compare full JSON decoding through Nupp PEG, native LPeg 1.1 `re`, and the
-- production Nupp JSON runtime.
-- Run with: ./bin/nupp bench --file bench/json-lpeg.bench.nupp

local bench = require("nupp.bench")
const {type Invocation} = require("nupp.bench")
local runtime = require("nupp.codec.json")
local lpeg: any = require("lpeg")
local re: any = require("re")

local JSON_NULL = {}

local function codepoint(value: integer): string
    if value <= 0x7f then
        return string.char(value)
    elseif value <= 0x7ff then
        return string.char(0xc0 + math.floor(value / 0x40), 0x80 + value % 0x40)
    elseif value <= 0xffff then
        return string.char(
            0xe0 + math.floor(value / 0x1000),
            0x80 + math.floor(value / 0x40) % 0x40,
            0x80 + value % 0x40
        )
    end

    return string.char(
        0xf0 + math.floor(value / 0x40000),
        0x80 + math.floor(value / 0x1000) % 0x40,
        0x80 + math.floor(value / 0x40) % 0x40,
        0x80 + value % 0x40
    )
end

local SIMPLE_ESCAPES = {['"'] = '"', ["\\"] = "\\", ["/"] = "/", b = "\b", f = "\f", n = "\n", r = "\r", t = "\t",}

local function decodedString(raw: string): string
    if not raw:find("\\", 1, true) then
        return raw
    end
    local out, position = {}, 1
    while position <= #raw do
        local slash = raw:find("\\", position, true)
        if not slash then
            out[#out + 1] = raw:sub(position)
            break
        end
        out[#out + 1] = raw:sub(position, slash - 1)
        local escaped = raw:sub(slash + 1, slash + 1)
        local simple = SIMPLE_ESCAPES[escaped]
        if simple then
            out[#out + 1] = simple
            position = slash + 2
        else
            local first = assert(tonumber(raw:sub(slash + 2, slash + 5), 16)) as integer
            position = slash + 6
            if first >= 0xd800 and first <= 0xdbff then
                local second = assert(tonumber(raw:sub(slash + 8, slash + 11), 16)) as integer
                first = 0x10000 + (first - 0xd800) * 0x400 + second - 0xdc00
                position = slash + 12
            end
            out[#out + 1] = codepoint(first)
        end
    end

    return table.concat(out)
end

local function decodedNumber(raw: string): number
    return assert(tonumber(raw))
end

-- Flat key/value captures avoid allocating a temporary pair table for every member.
local function object(members: {any}): any
    local value = {}
    for index = 1, #members, 2 do
        value[members[index]] = members[index + 1]
    end

    return value
end

local function array(items: {any}): any
    return items
end

local function yes(_: string): boolean
    return true
end

local function no(_: string): boolean
    return false
end

local function null(_: string): any
    return JSON_NULL
end

local definitions: any = {
    string = decodedString,
    number = decodedNumber,
    object = object,
    array = array,
    yes = yes,
    no = no,
    null = null,
}

local NuppDecoder: nupp.peg.Peg<any> = nupp.peg.compile(
    [[
    start <- space value !.
    value <- object / array / string / number / true / false / null
    object <- ('{' space {| (member (',' space member)*)? |} '}' space) -> object
    member <- string ':' space value
    array <- ('[' space {| (value (',' space value)*)? |} ']' space) -> array
    string <- ('"' { character* } '"' space) -> string
    character <- escape / !'"' !'\' !%cntrl .
    escape <- '\' ([\"/bfnrt] / 'u' %x^4)
    number <- ({ '-'? ('0' / [1-9] [0-9]*) ('.' [0-9]+)? ([eE] [+-]? [0-9]+)? } space) -> number
    true <- 'true' space -> yes
    false <- 'false' space -> no
    null <- 'null' space -> null
    space <- %s*
]],
    {definitions = definitions}
)

local NuppRecognizer = nupp.peg.compile(
    [[
    start <- space value !.
    value <- object / array / string / number / true / false / null
    object <- '{' space (string ':' space value (',' space string ':' space value)*)? '}' space
    array <- '[' space (value (',' space value)*)? ']' space
    string <- '"' character* '"' space
    character <- escape / !'"' !'\' !%cntrl .
    escape <- '\' ([\"/bfnrt] / 'u' %x^4)
    number <- '-'? ('0' / [1-9] [0-9]*) ('.' [0-9]+)? ([eE] [+-]? [0-9]+)? space
    true <- 'true' space
    false <- 'false' space
    null <- 'null' space
    space <- %s*
]]
)

-- Keep only structural recursion as named rules to compare equivalent graph shapes.
local NuppInlineRecognizer = nupp.peg.compile(
    [[
    start <- %s* value !.
    value <- object / array
        / '"' (('\' ([\"/bfnrt] / 'u' %x^4)) / !'"' !'\' !%cntrl .)* '"' %s*
        / '-'? ('0' / [1-9] [0-9]*) ('.' [0-9]+)? ([eE] [+-]? [0-9]+)? %s*
        / 'true' %s* / 'false' %s* / 'null' %s*
    object <- '{' %s* (
        '"' (('\' ([\"/bfnrt] / 'u' %x^4)) / !'"' !'\' !%cntrl .)* '"' %s*
        ':' %s* value (
            ',' %s* '"' (('\' ([\"/bfnrt] / 'u' %x^4)) / !'"' !'\' !%cntrl .)* '"' %s*
            ':' %s* value
        )*
    )? '}' %s*
    array <- '[' %s* (value (',' %s* value)*)? ']' %s*
]]
)

local DECODER_GRAMMAR = [[
    start <- space value !.
    value <- object / array / string / number / true / false / null
    object <- ('{' space {| (member (',' space member)*)? |} '}' space) -> object
    member <- string ':' space value
    array <- ('[' space {| (value (',' space value)*)? |} ']' space) -> array
    string <- ('"' { character* } '"' space) -> string
    character <- escape / !'"' !'\' !%cntrl .
    escape <- '\' ([\"/bfnrt] / 'u' %x^4)
    number <- ({ '-'? ('0' / [1-9] [0-9]*) ('.' [0-9]+)? ([eE] [+-]? [0-9]+)? } space) -> number
    true <- 'true' space -> yes
    false <- 'false' space -> no
    null <- 'null' space -> null
    space <- %s*
]]

local RECOGNIZER_GRAMMAR = [[
    start <- space value !.
    value <- object / array / string / number / true / false / null
    object <- '{' space (string ':' space value (',' space string ':' space value)*)? '}' space
    array <- '[' space (value (',' space value)*)? ']' space
    string <- '"' character* '"' space
    character <- escape / !'"' !'\' !%cntrl .
    escape <- '\' ([\"/bfnrt] / 'u' %x^4)
    number <- '-'? ('0' / [1-9] [0-9]*) ('.' [0-9]+)? ([eE] [+-]? [0-9]+)? space
    true <- 'true' space
    false <- 'false' space
    null <- 'null' space
    space <- %s*
]]

local LPegDecoder = re.compile(DECODER_GRAMMAR, definitions)
local LPegRecognizer = re.compile(RECOGNIZER_GRAMMAR)

local tiny = runtime.encode({
    ok = true,
    count = 42,
    name = "Nupp \"PEG\"",
    missing = runtime.NULL,
    values = {1, 2, 3, 4},
})

local function records(count: integer): string
    local values = {}
    for index = 1, count do
        values[
            index
        ] = {
            id = index,
            active = index % 3 ~= 0,
            score = index * 1.25,
            name = "record-" .. index,
            note = "quoted \"text\", slash \\, and newline\n",
            tags = {"alpha", "beta", "gamma", "delta"},
            point = {x = index, y = -index, z = index / 3},
        }
    end

    return runtime.encode({version = 1, records = values})
end

local fixtures = {
    {name = "tiny", text = tiny},
    {name = "medium", text = records(64)},
    {name = "large", text = records(1024)},
}

local function nuppDecode(text: string): any
    return NuppDecoder(text)
end

local function lpegDecode(text: string): any
    return lpeg.match(LPegDecoder, text)
end

local function nuppRecognize(text: string): any
    return NuppRecognizer(text)
end

local function nuppInlineRecognize(text: string): any
    return NuppInlineRecognizer(text)
end

local function lpegRecognize(text: string): any
    return lpeg.match(LPegRecognizer, text)
end

local function runtimeDecode(text: string): any
    return runtime.decode(text, runtime.NULL)
end

local edgeText = [[ {"empty":[],"object":{},"unicode":"\u0041\uD834\uDD1E","exponent":-1.25e+2} ]]
for _, parse in ipairs({nuppDecode, lpegDecode}) do
    local edge = assert(parse(edgeText))
    assert(#edge.empty == 0 and next(edge.object) == nil)
    assert(edge.unicode == "A" .. codepoint(0x1d11e) and edge.exponent == -125)
    for _, invalid in ipairs({"[1,]", "{\"x\":01}", "\"\\q\"", "true false"}) do
        assert(parse(invalid) == nil)
    end
end

for _, fixture in ipairs(fixtures) do
    local nuppValue = assert(nuppDecode(fixture.text))
    local lpegValue = assert(lpegDecode(fixture.text))
    assert(nuppValue.version == lpegValue.version)
    if nuppValue.records then
        assert(#nuppValue.records == #lpegValue.records)
        assert(nuppValue.records[1].note == lpegValue.records[1].note)
    else
        assert(nuppValue.name == lpegValue.name)
        assert(nuppValue.missing == JSON_NULL and lpegValue.missing == JSON_NULL)
    end
end

local NUPP_DECODE_BYTES = 64 * 1024
local NUPP_RECOGNIZE_BYTES = 128 * 1024

local function run(parser: function(string): any, byteBudget: integer, invocation: Invocation): any
    local text = invocation.data as string
    local iterations = math.max(1, math.floor(byteBudget / #text))
    local result: any = nil
    for _ = 1, iterations do
        result = assert(parser(text))
    end

    return result
end

local function decodeNupp(_: any, invocation: Invocation): any
    return run(nuppDecode, NUPP_DECODE_BYTES, invocation)
end

local function decodeLPeg(_: any, invocation: Invocation): any
    return run(lpegDecode, NUPP_DECODE_BYTES, invocation)
end

local function decodeRuntime(_: any, invocation: Invocation): any
    return run(runtimeDecode, NUPP_DECODE_BYTES, invocation)
end

local function recognizeNupp(_: any, invocation: Invocation): any
    return run(nuppRecognize, NUPP_RECOGNIZE_BYTES, invocation)
end

local function recognizeInline(_: any, invocation: Invocation): any
    return run(nuppInlineRecognize, NUPP_RECOGNIZE_BYTES, invocation)
end

local function recognizeLPeg(_: any, invocation: Invocation): any
    return run(lpegRecognize, NUPP_RECOGNIZE_BYTES, invocation)
end

local decodeCases = {}
local recognizeCases = {}
for _, fixture in ipairs(fixtures) do
    local decodeIterations = math.max(1, math.floor(NUPP_DECODE_BYTES / #fixture.text))
    local recognizeIterations = math.max(1, math.floor(NUPP_RECOGNIZE_BYTES / #fixture.text))
    decodeCases[
        #decodeCases + 1
    ] = {name = fixture.name, data = fixture.text, operations = #fixture.text * decodeIterations}
    recognizeCases[
        #recognizeCases + 1
    ] = {name = fixture.name, data = fixture.text, operations = #fixture.text * recognizeIterations}
end

bench.suite(
    {
        name = "json-decode",
        baselineVariant = "runtime",
        variants = {
            {name = "runtime", run = decodeRuntime},
            {name = "nupp-peg", run = decodeNupp},
            {name = "lpeg", run = decodeLPeg},
        },
        cases = decodeCases,
        warmupIterations = 3,
        minSamples = 7,
        minDurationSec = 0.5,
    } as bench.SuiteOptions
)

bench.suite(
    {
        name = "json-recognize",
        baselineVariant = "lpeg",
        variants = {
            {name = "lpeg", run = recognizeLPeg},
            {name = "nupp-rules", run = recognizeNupp},
            {name = "nupp-inline", run = recognizeInline},
        },
        cases = recognizeCases,
        warmupIterations = 3,
        minSamples = 7,
        minDurationSec = 0.5,
    } as bench.SuiteOptions
)
bench.report()
