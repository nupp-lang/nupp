local span = binary.span

@aot(target = "gpu")
local function scores(
    exclusive output: span.WriteSpan<float>,
    borrows query: span.Span<float>,
    borrows key: span.Span<float>,
    tokens: uint32,
    width: uint32,
    scale: float
): nil
    for i = 1, #output do
        local offset = math.u32.wrap(i) - 1
        local row = math.u32.div(offset, tokens)
        local column = math.u32.mod(offset, tokens)
        local inner: uint32 = 0
        local value: float32 = 0.0
        while inner < width do
            local qi = row * width + inner
            local ki = column * width + inner
            if qi < #query then
                local q = math.f32.narrow(query[qi + 1])
                if ki < #key then
                    value = math.f32.fma(q, math.f32.narrow(key[ki + 1]), value)
                end
            end
            inner = inner + 1
        end
        output[i] = math.f32.mul(value, math.f32.narrow(scale))
    end
end

local function scoresCpu(
    exclusive output: span.WriteSpan<float>,
    borrows query: span.Span<float>,
    borrows key: span.Span<float>,
    tokens: uint32,
    width: uint32,
    scale: float
): nil
    for i = 1, #output do
        local offset = math.u32.wrap(i) - 1
        local row = math.u32.div(offset, tokens)
        local column = math.u32.mod(offset, tokens)
        local inner: uint32 = 0
        local value: float32 = 0.0
        while inner < width do
            local qi = row * width + inner
            local ki = column * width + inner
            if qi < #query then
                local q = math.f32.narrow(query[qi + 1])
                if ki < #key then
                    value = math.f32.fma(q, math.f32.narrow(key[ki + 1]), value)
                end
            end
            inner = inner + 1
        end
        output[i] = math.f32.mul(value, math.f32.narrow(scale))
    end
end

@aot(target = "gpu")
local function softmax(exclusive output: span.WriteSpan<float>, borrows input: span.Span<float>, tokens: uint32): nil
    if #output ~= #input then
        error("length mismatch", 2)
    end
    for i = 1, #output do
        local offset = math.u32.wrap(i) - 1
        local row = math.u32.div(offset, tokens)
        local base = row * tokens
        local maximum = math.f32.narrow(input[i])
        local column: uint32 = 0
        while column < tokens do
            local cursor = base + column
            if cursor < #input then
                maximum = math.f32.max(maximum, math.f32.narrow(input[cursor + 1]))
            end
            column = column + 1
        end
        local total: float32 = 0.0
        column = 0
        while column < tokens do
            local cursor = base + column
            if cursor < #input then
                total = math.f32.add(total, math.f32.exp(math.f32.sub(math.f32.narrow(input[cursor + 1]), maximum)))
            end
            column = column + 1
        end
        local reciprocal: float32 = 0.125
        local refinement: uint32 = 0
        while refinement < 8 do
            reciprocal = math.f32.mul(reciprocal, math.f32.sub(2.0, math.f32.mul(total, reciprocal)))
            refinement = refinement + 1
        end
        output[i] = math.f32.mul(math.f32.exp(math.f32.sub(math.f32.narrow(input[i]), maximum)), reciprocal)
    end
end

local function softmaxCpu(exclusive output: span.WriteSpan<float>, borrows input: span.Span<float>, tokens: uint32): nil
    if #output ~= #input then
        error("length mismatch", 2)
    end
    for i = 1, #output do
        local offset = math.u32.wrap(i) - 1
        local row = math.u32.div(offset, tokens)
        local base = row * tokens
        local maximum = math.f32.narrow(input[i])
        local column: uint32 = 0
        while column < tokens do
            local cursor = base + column
            if cursor < #input then
                maximum = math.f32.max(maximum, math.f32.narrow(input[cursor + 1]))
            end
            column = column + 1
        end
        local total: float32 = 0.0
        column = 0
        while column < tokens do
            local cursor = base + column
            if cursor < #input then
                total = math.f32.add(total, math.f32.exp(math.f32.sub(math.f32.narrow(input[cursor + 1]), maximum)))
            end
            column = column + 1
        end
        local reciprocal: float32 = 0.125
        local refinement: uint32 = 0
        while refinement < 8 do
            reciprocal = math.f32.mul(reciprocal, math.f32.sub(2.0, math.f32.mul(total, reciprocal)))
            refinement = refinement + 1
        end
        output[i] = math.f32.mul(math.f32.exp(math.f32.sub(math.f32.narrow(input[i]), maximum)), reciprocal)
    end
end

@aot(target = "gpu")
local function mix(
    exclusive output: span.WriteSpan<float>,
    borrows probabilities: span.Span<float>,
    borrows value: span.Span<float>,
    tokens: uint32,
    width: uint32
): nil
    for i = 1, #output do
        local offset = math.u32.wrap(i) - 1
        local row = math.u32.div(offset, width)
        local column = math.u32.mod(offset, width)
        local keyIndex: uint32 = 0
        local total: float32 = 0.0
        while keyIndex < tokens do
            local pi = row * tokens + keyIndex
            local vi = keyIndex * width + column
            if pi < #probabilities then
                local probability = math.f32.narrow(probabilities[pi + 1])
                if vi < #value then
                    total = math.f32.fma(probability, math.f32.narrow(value[vi + 1]), total)
                end
            end
            keyIndex = keyIndex + 1
        end
        output[i] = total
    end
end

local function mixCpu(
    exclusive output: span.WriteSpan<float>,
    borrows probabilities: span.Span<float>,
    borrows value: span.Span<float>,
    tokens: uint32,
    width: uint32
): nil
    for i = 1, #output do
        local offset = math.u32.wrap(i) - 1
        local row = math.u32.div(offset, width)
        local column = math.u32.mod(offset, width)
        local keyIndex: uint32 = 0
        local total: float32 = 0.0
        while keyIndex < tokens do
            local pi = row * tokens + keyIndex
            local vi = keyIndex * width + column
            if pi < #probabilities then
                local probability = math.f32.narrow(probabilities[pi + 1])
                if vi < #value then
                    total = math.f32.fma(probability, math.f32.narrow(value[vi + 1]), total)
                end
            end
            keyIndex = keyIndex + 1
        end
        output[i] = total
    end
end

return {scores = scores, scoresCpu = scoresCpu, softmax = softmax, softmaxCpu = softmaxCpu, mix = mix, mixCpu = mixCpu,}
