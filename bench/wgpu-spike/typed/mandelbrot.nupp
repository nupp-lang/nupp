module mandelbrot

-- A binary32 point-batch Mandelbrot, expressed as a
-- one dispatch covers the complete input through 64-thread workgroups.
local span = binary.span
local gpu = io.gpu

const WORKGROUP_SIZE = 64

local struct PointValue
    re: float
    im: float
end

local struct EscapeValue
    iterations: int32
    escaped: uint32
end

@aot(target = "gpu")
local function generatedMandelbrot(
    exclusive escapes: span.WriteSpan<EscapeValue>,
    borrows points: span.Span<PointValue>,
    maxIterations: int32
): nil
    local groups = math.u32.div(math.u32.wrap(#escapes), math.u32.wrap(WORKGROUP_SIZE))
    gpu.workgroups(groups, 64, function(groupIndex: uint32, phases: gpu.Phases)
        phases:run(function(localIndex: uint32)
            local index = groupIndex * math.u32.wrap(WORKGROUP_SIZE) + localIndex
            local pointCursor = index
            local escapeCursor = index
            if pointCursor < #points then
                if escapeCursor < #escapes then
                    local escape = escapes[escapeCursor + 1]
                    local point = points[pointCursor + 1]
                    local cx = math.f32.narrow(point.re)
                    local cy = math.f32.narrow(point.im)
                    local cardioidX = math.f32.sub(cx, 0.25)
                    local ySquared = math.f32.mul(cy, cy)
                    local cardioidSquare = math.f32.mul(cardioidX, cardioidX)
                    local q = math.f32.add(cardioidSquare, ySquared)
                    local cardioidMetric = math.f32.mul(q, math.f32.add(q, cardioidX))
                    local cardioidLimit = math.f32.mul(0.25, ySquared)
                    local inside: int32 = 0
                    if cardioidMetric <= cardioidLimit then
                        inside = 1
                    end
                    local shifted = math.f32.add(cx, 1.0)
                    local bulbSquare = math.f32.mul(shifted, shifted)
                    if math.f32.add(bulbSquare, ySquared) <= 0.0625 then
                        inside = 1
                    end

                    local zx: float32 = 0.0
                    local zy: float32 = 0.0
                    local zxSquared: float32 = 0.0
                    local zySquared: float32 = 0.0
                    local iteration: int32 = 0
                    local escaped: int32 = 0
                    if inside == 1 then
                        iteration = maxIterations
                    end
                    while iteration < maxIterations do
                        if math.f32.add(zxSquared, zySquared) > 4.0 then
                            escaped = 1
                            break
                        end
                        local doubledZx = math.f32.mul(zx, 2.0)
                        zy = math.f32.fma(doubledZx, zy, cy)
                        zx = math.f32.add(math.f32.sub(zxSquared, zySquared), cx)
                        zxSquared = math.f32.mul(zx, zx)
                        zySquared = math.f32.mul(zy, zy)
                        iteration = iteration + 1
                    end
                    if iteration < maxIterations then
                        escaped = 1
                    end
                    escape.iterations = iteration
                    escape.escaped = escaped
                end
            end
        end)
    end)
end

export type Point = PointValue
export type Escape = EscapeValue
-- The struct declarations themselves, which `gpu.Context:buffer` takes as its element.
export const PointLayout = PointValue
export const EscapeLayout = EscapeValue
export const mandelbrot = generatedMandelbrot
