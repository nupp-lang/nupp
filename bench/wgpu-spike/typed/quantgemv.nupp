module quantgemv

local span = binary.span

-- GPU kernels need 32-bit storage, so the GPU forms read the same bytes as
-- little-endian uint32 words: weight k is byte k % 4 of word k / 4.
@aot(target = "gpu")
local function q8(
    exclusive output: span.WriteSpan<float>,
    borrows weights: span.Span<uint32>,
    borrows input: span.Span<float>,
    width: uint32,
    scale: float,
    zeroPoint: int32
): nil
    for i = 1, #output do
        local row = math.u32.sub(math.u32.wrap(i), math.u32.wrap(1))
        local column: uint32 = 0
        local total: float = 0.0
        while column < width do
            local weightIndex = math.u32.add(math.u32.mul(row, width), column)
            local wordCursor = math.u32.div(weightIndex, math.u32.wrap(4))
            local inputCursor = column
            if wordCursor < #weights then
                local shift = math.u32.mul(math.u32.mod(weightIndex, math.u32.wrap(4)), math.u32.wrap(8))
                local byte = math.u32.andbits(
                    math.u32.shiftrightlogical(weights[wordCursor + 1], shift),
                    math.u32.wrap(255)
                )
                local signed = math.i32.fromu32(byte)
                if byte >= math.u32.wrap(128) then
                    signed = math.i32.sub(signed, math.i32.wrap(256))
                end
                local centered = math.i32.sub(signed, zeroPoint)
                local weight = math.f32.mul(math.f32.narrow(centered as number), scale)
                if inputCursor < #input then
                    total = math.f32.fma(weight, math.f32.narrow(input[inputCursor + 1]), total)
                end
            end
            column = math.u32.add(column, math.u32.wrap(1))
        end
        output[i] = total
    end
end

@aot
local function q8Cpu(
    exclusive output: span.WriteSpan<float>,
    borrows weights: span.Span<int8>,
    borrows input: span.Span<float>,
    width: uint32,
    scale: float,
    zeroPoint: int32
): nil
    for i = 1, #output do
        local row = math.u32.sub(math.u32.wrap(i), math.u32.wrap(1))
        local column: uint32 = 0
        local total: float = 0.0
        while column < width do
            local weightCursor = math.u32.add(math.u32.mul(row, width), column)
            local inputCursor = column
            if weightCursor < #weights then
                local centered = math.i32.sub(weights[weightCursor + 1], zeroPoint)
                local weight = math.f32.mul(math.f32.narrow(centered as number), scale)
                if inputCursor < #input then
                    total = math.f32.fma(weight, math.f32.narrow(input[inputCursor + 1]), total)
                end
            end
            column = math.u32.add(column, math.u32.wrap(1))
        end
        output[i] = total
    end
end

-- Weight k of the packed int4 form is nibble k % 8 of word k / 8.
@aot(target = "gpu")
local function q4(
    exclusive output: span.WriteSpan<float>,
    borrows weights: span.Span<uint32>,
    borrows input: span.Span<float>,
    width: uint32,
    scale: float,
    zeroPoint: int32
): nil
    for i = 1, #output do
        local row = math.u32.sub(math.u32.wrap(i), math.u32.wrap(1))
        local column: uint32 = 0
        local total: float = 0.0
        while column < width do
            local weightIndex = math.u32.add(math.u32.mul(row, width), column)
            local wordCursor = math.u32.div(weightIndex, math.u32.wrap(8))
            local inputCursor = column
            if wordCursor < #weights then
                local shift = math.u32.mul(math.u32.mod(weightIndex, math.u32.wrap(8)), math.u32.wrap(4))
                local nibble = math.u32.andbits(
                    math.u32.shiftrightlogical(weights[wordCursor + 1], shift),
                    math.u32.wrap(15)
                )
                local signed = math.i32.fromu32(nibble)
                if nibble >= math.u32.wrap(8) then
                    signed = math.i32.sub(signed, math.i32.wrap(16))
                end
                local centered = math.i32.sub(signed, zeroPoint)
                local weight = math.f32.mul(math.f32.narrow(centered as number), scale)
                if inputCursor < #input then
                    total = math.f32.fma(weight, math.f32.narrow(input[inputCursor + 1]), total)
                end
            end
            column = math.u32.add(column, math.u32.wrap(1))
        end
        output[i] = total
    end
end

@aot
local function q4Cpu(
    exclusive output: span.WriteSpan<float>,
    borrows weights: span.Span<uint8>,
    borrows input: span.Span<float>,
    width: uint32,
    scale: float,
    zeroPoint: int32
): nil
    for i = 1, #output do
        local packedWidth = math.u32.div(width, math.u32.wrap(2))
        local row = math.u32.sub(math.u32.wrap(i), math.u32.wrap(1))
        local column: uint32 = 0
        local total: float = 0.0
        while column < width do
            local weightCursor = math.u32.add(math.u32.mul(row, packedWidth), math.u32.div(column, math.u32.wrap(2)))
            local inputCursor = column
            if weightCursor < #weights then
                local high = math.u32.mod(column, math.u32.wrap(2)) == math.u32.wrap(1)
                local bits = math.u32.wrap(weights[weightCursor + 1])
                if high then
                    bits = math.u32.shiftrightlogical(bits, 4)
                end
                local nibble = math.u32.andbits(bits, math.u32.wrap(15))
                local signed = math.i32.fromu32(nibble)
                if nibble >= math.u32.wrap(8) then
                    signed = math.i32.sub(signed, math.i32.wrap(16))
                end
                local centered = math.i32.sub(signed, zeroPoint)
                local weight = math.f32.mul(math.f32.narrow(centered as number), scale)
                if inputCursor < #input then
                    total = math.f32.fma(weight, math.f32.narrow(input[inputCursor + 1]), total)
                end
            end
            column = math.u32.add(column, math.u32.wrap(1))
        end
        output[i] = total
    end
end

export const int8 = q8
export const int8Cpu = q8Cpu
export const int4 = q4
export const int4Cpu = q4Cpu
