module reduction

local gpu = io.gpu
local span = require("bytes.span")

@aot(target = "gpu")
local function expSum(exclusive output: span.WriteSpan<float>, borrows input: span.Span<float>): nil
    local groups = math.u32.div(math.u32.wrap(#input), math.u32.wrap(256))
    gpu.workgroups(groups, 256, function(groupIndex: uint32, phases: gpu.Phases)
        local values = phases:scratch(math.f32.narrow(0.0), 256)
        phases:run(function(localIndex: uint32)
            local cursor = groupIndex * math.u32.wrap(256) + localIndex
            if cursor < #input then
                values[localIndex] = math.f32.exp(math.f32.narrow(input[cursor + 1]))
            else
                values[localIndex] = math.f32.narrow(0.0)
            end
        end)
        phases:reducesum(values)
        phases:run(function(localIndex: uint32)
            if localIndex == math.u32.wrap(0) and groupIndex < #output then
                output[groupIndex + 1] = values[0]
            end
        end)
    end)
end

@aot(target = "gpu")
local function sum(exclusive output: span.WriteSpan<float>, borrows input: span.Span<float>): nil
    local groups = math.u32.div(math.u32.wrap(#input), math.u32.wrap(256))
    gpu.workgroups(groups, 256, function(groupIndex: uint32, phases: gpu.Phases)
        local values = phases:scratch(math.f32.narrow(0.0), 256)
        phases:run(function(localIndex: uint32)
            local cursor = groupIndex * math.u32.wrap(256) + localIndex
            if cursor < #input then
                values[localIndex] = math.f32.narrow(input[cursor + 1])
            else
                values[localIndex] = math.f32.narrow(0.0)
            end
        end)
        phases:reducesum(values)
        phases:run(function(localIndex: uint32)
            if localIndex == math.u32.wrap(0) and groupIndex < #output then
                output[groupIndex + 1] = values[0]
            end
        end)
    end)
end

export const exp = expSum
export const sum = sum
