local span = require("bytes.span")

@aot(target = "gpu")
local function heavy(
    exclusive output: span.WriteSpan<float>,
    borrows input: span.Span<float>,
    steps: int32,
    scale: float,
    bias: float
): nil
    if #output ~= #input then
        error("length mismatch", 2)
    end

    for index = 1, #output do
        local value = math.f32.narrow(input[index])
        local step: int32 = 0
        while step < steps do
            value = math.f32.add(math.f32.mul(value, math.f32.narrow(scale)), math.f32.narrow(bias))
            step = step + 1
        end
        output[index] = value
    end
end

return heavy
