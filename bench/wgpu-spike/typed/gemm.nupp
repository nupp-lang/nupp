module gemm

const assert2 = assert

-- Naive GEMM over row-major binary32 matrices: c[m x n] = a[m x k] * b[k x n].
-- Each dispatched thread owns one output element. Its one-based loop index is
-- converted to a zero-based row and column, and every a/b access is a proved
-- cursor whose bound check the shader keeps, so the matrix buffers may have the
-- independently sized dimensions the uniforms describe.
local span = binary.span
local gpu = io.gpu

-- Small conformance kernels separate storage binding and scalar-uniform
-- failures before the full GEMM makes either one look like a zero result.
@aot(target = "gpu")
local function copyProbe(exclusive output: span.WriteSpan<float>, borrows input: span.Span<float>): nil
    assert2(#output == #input)
    for i = 1, #output do
        output[i] = input[i]
    end
end

@aot(target = "gpu")
local function fillProbe(exclusive output: span.WriteSpan<float>, borrows input: span.Span<float>, value: float): nil
    assert2(#output == #input)
    for i = 1, #output do
        output[i] = input[i] * 0.0 + value
    end
end

-- Keep the complete GEMM ABI but avoid its loop and index arithmetic. This
-- distinguishes missing span metadata or trailing scalar uniforms from a
-- failure in the matrix body itself.
@aot(target = "gpu")
local function abiProbe(
    exclusive output: span.WriteSpan<float>,
    borrows a: span.Span<float>,
    borrows b: span.Span<float>,
    columns: uint32,
    inner: uint32
): nil
    for i = 1, #output do
        local offset = math.u32.sub(math.u32.wrap(i), 1)
        local value: float = 0.0
        if offset < #a then
            local left = math.f32.narrow(a[offset + 1])
            if offset < #b then
                local right = math.f32.narrow(b[offset + 1])
                if columns ~= 0 then
                    if inner ~= 0 then
                        value = math.f32.add(left, right)
                    end
                end
            end
        end
        output[i] = value
    end
end

@aot(target = "gpu")
local function loopProbe(
    exclusive output: span.WriteSpan<float>,
    borrows input: span.Span<float>,
    iterations: uint32
): nil
    assert2(#output == #input)
    for i = 1, #output do
        local value: float = 0.0
        local cursor: uint32 = 0
        while cursor < iterations do
            value = math.f32.add(value, 1.0)
            cursor = math.u32.add(cursor, 1)
        end
        output[i] = input[i] * 0.0 + value
    end
end

@aot(target = "gpu")
local function fmaProbe(
    exclusive output: span.WriteSpan<float>,
    borrows a: span.Span<float>,
    borrows b: span.Span<float>
): nil
    assert2(#output == #a and #output == #b)
    for i = 1, #output do
        output[i] = math.f32.fma(math.f32.narrow(a[i]), math.f32.narrow(b[i]), math.f32.narrow(0.0))
    end
end

@aot(target = "gpu")
local function uintUniformProbe(
    exclusive output: span.WriteSpan<float>,
    borrows input: span.Span<float>,
    value: uint32
): nil
    assert2(#output == #input)
    for i = 1, #output do
        if value == 73 then
            output[i] = input[i]
        else
            output[i] = 0.0
        end
    end
end

@aot(target = "gpu")
local function fixedLoopProbe(exclusive output: span.WriteSpan<float>, borrows input: span.Span<float>): nil
    assert2(#output == #input)
    for i = 1, #output do
        local value: float = 0.0
        local cursor: uint32 = 0
        while cursor < 7 do
            value = math.f32.add(value, 1.0)
            cursor = math.u32.add(cursor, 1)
        end
        output[i] = input[i] * 0.0 + value
    end
end

@aot(target = "gpu")
local function gemmNaive(
    exclusive c: span.WriteSpan<float>,
    borrows a: span.Span<float>,
    borrows b: span.Span<float>,
    columns: uint32,
    inner: uint32
): nil
    for i = 1, #c do
        local offset = math.u32.sub(math.u32.wrap(i), 1)
        local row = math.u32.div(offset, columns)
        local col = math.u32.mod(offset, columns)
        local acc: float = 0.0
        local j = math.u32.wrap(0)
        while j < inner do
            local ai = math.u32.add(math.u32.mul(row, inner), j)
            local bi = math.u32.add(math.u32.mul(j, columns), col)
            if ai < #a then
                if bi < #b then
                    acc = math.f32.fma(math.f32.narrow(a[ai + 1]), math.f32.narrow(b[bi + 1]), acc)
                end
            end
            j = math.u32.add(j, 1)
        end
        c[i] = acc
    end
end

-- The same scalar IR through the CPU AOT tier: the reference the GPU result must
-- match element-exactly and a real baseline for the generated native kernel.
@aot
local function gemmCpu(
    exclusive c: span.WriteSpan<float>,
    borrows a: span.Span<float>,
    borrows b: span.Span<float>,
    columns: uint32,
    inner: uint32
): nil
    for i = 1, #c do
        local offset = math.u32.sub(math.u32.wrap(i), 1)
        local row = math.u32.div(offset, columns)
        local col = math.u32.mod(offset, columns)
        local acc: float = 0.0
        local j = math.u32.wrap(0)
        while j < inner do
            local ai = math.u32.add(math.u32.mul(row, inner), j)
            local bi = math.u32.add(math.u32.mul(j, columns), col)
            if ai < #a then
                if bi < #b then
                    acc = math.f32.fma(math.f32.narrow(a[ai + 1]), math.f32.narrow(b[bi + 1]), acc)
                end
            end
            j = math.u32.add(j, 1)
        end
        c[i] = acc
    end
end

-- One 16 by 16 output tile per 256-lane workgroup. Each load phase writes one
-- disjoint shared slot, and the following compute phase reads only indices
-- whose complete uint32 range the compiler proves lies inside that tile.
@aot(target = "gpu")
local function gemmTiled(
    exclusive c: span.WriteSpan<float>,
    borrows a: span.Span<float>,
    borrows b: span.Span<float>,
    columns: uint32,
    inner: uint32
): nil
    local groups = math.u32.div(math.u32.wrap(#c), math.u32.wrap(256))
    gpu.workgroups(groups, 256, function(groupIndex: uint32, phases: gpu.Phases)
        local aTile = phases:scratch(math.f32.narrow(0.0), 256)
        local bTile = phases:scratch(math.f32.narrow(0.0), 256)
        local accumulators = phases:scratch(math.f32.narrow(0.0), 256)
        phases:run(function(localIndex: uint32)
            accumulators[localIndex] = math.f32.narrow(0.0)
        end)

        local tile: uint32 = 0
        while math.u32.mul(tile, math.u32.wrap(16)) < inner do
            phases:run(function(localIndex: uint32)
                local laneRow = math.u32.div(localIndex, math.u32.wrap(16))
                local laneColumn = math.u32.mod(localIndex, math.u32.wrap(16))
                local tilesPerRow = math.u32.div(columns, math.u32.wrap(16))
                local tileRow = math.u32.div(groupIndex, tilesPerRow)
                local tileColumn = math.u32.mod(groupIndex, tilesPerRow)
                local row = math.u32.add(math.u32.mul(tileRow, math.u32.wrap(16)), laneRow)
                local column = math.u32.add(math.u32.mul(tileColumn, math.u32.wrap(16)), laneColumn)
                local base = math.u32.mul(tile, math.u32.wrap(16))
                local aColumn = math.u32.add(base, laneColumn)
                local bRow = math.u32.add(base, laneRow)
                local ai = math.u32.add(math.u32.mul(row, inner), aColumn)
                local bi = math.u32.add(math.u32.mul(bRow, columns), column)
                if aColumn < inner then
                    if ai < #a then
                        aTile[localIndex] = math.f32.narrow(a[ai + 1])
                    else
                        aTile[localIndex] = math.f32.narrow(0.0)
                    end
                else
                    aTile[localIndex] = math.f32.narrow(0.0)
                end
                if bRow < inner then
                    if bi < #b then
                        bTile[localIndex] = math.f32.narrow(b[bi + 1])
                    else
                        bTile[localIndex] = math.f32.narrow(0.0)
                    end
                else
                    bTile[localIndex] = math.f32.narrow(0.0)
                end
            end)
            phases:run(function(localIndex: uint32)
                local value = math.f32.narrow(accumulators[localIndex])
                value = math.f32.fma(
                    math.f32.narrow(aTile[math.u32.mul(math.u32.div(localIndex, 16), 16)]),
                    math.f32.narrow(bTile[math.u32.mod(localIndex, 16)]),
                    value
                )
                value = math.f32.fma(
                    math.f32.narrow(aTile[math.u32.add(math.u32.mul(math.u32.div(localIndex, 16), 16), 1)]),
                    math.f32.narrow(bTile[math.u32.add(16, math.u32.mod(localIndex, 16))]),
                    value
                )
                value = math.f32.fma(
                    math.f32.narrow(aTile[math.u32.add(math.u32.mul(math.u32.div(localIndex, 16), 16), 2)]),
                    math.f32.narrow(bTile[math.u32.add(32, math.u32.mod(localIndex, 16))]),
                    value
                )
                value = math.f32.fma(
                    math.f32.narrow(aTile[math.u32.add(math.u32.mul(math.u32.div(localIndex, 16), 16), 3)]),
                    math.f32.narrow(bTile[math.u32.add(48, math.u32.mod(localIndex, 16))]),
                    value
                )
                value = math.f32.fma(
                    math.f32.narrow(aTile[math.u32.add(math.u32.mul(math.u32.div(localIndex, 16), 16), 4)]),
                    math.f32.narrow(bTile[math.u32.add(64, math.u32.mod(localIndex, 16))]),
                    value
                )
                value = math.f32.fma(
                    math.f32.narrow(aTile[math.u32.add(math.u32.mul(math.u32.div(localIndex, 16), 16), 5)]),
                    math.f32.narrow(bTile[math.u32.add(80, math.u32.mod(localIndex, 16))]),
                    value
                )
                value = math.f32.fma(
                    math.f32.narrow(aTile[math.u32.add(math.u32.mul(math.u32.div(localIndex, 16), 16), 6)]),
                    math.f32.narrow(bTile[math.u32.add(96, math.u32.mod(localIndex, 16))]),
                    value
                )
                value = math.f32.fma(
                    math.f32.narrow(aTile[math.u32.add(math.u32.mul(math.u32.div(localIndex, 16), 16), 7)]),
                    math.f32.narrow(bTile[math.u32.add(112, math.u32.mod(localIndex, 16))]),
                    value
                )
                value = math.f32.fma(
                    math.f32.narrow(aTile[math.u32.add(math.u32.mul(math.u32.div(localIndex, 16), 16), 8)]),
                    math.f32.narrow(bTile[math.u32.add(128, math.u32.mod(localIndex, 16))]),
                    value
                )
                value = math.f32.fma(
                    math.f32.narrow(aTile[math.u32.add(math.u32.mul(math.u32.div(localIndex, 16), 16), 9)]),
                    math.f32.narrow(bTile[math.u32.add(144, math.u32.mod(localIndex, 16))]),
                    value
                )
                value = math.f32.fma(
                    math.f32.narrow(aTile[math.u32.add(math.u32.mul(math.u32.div(localIndex, 16), 16), 10)]),
                    math.f32.narrow(bTile[math.u32.add(160, math.u32.mod(localIndex, 16))]),
                    value
                )
                value = math.f32.fma(
                    math.f32.narrow(aTile[math.u32.add(math.u32.mul(math.u32.div(localIndex, 16), 16), 11)]),
                    math.f32.narrow(bTile[math.u32.add(176, math.u32.mod(localIndex, 16))]),
                    value
                )
                value = math.f32.fma(
                    math.f32.narrow(aTile[math.u32.add(math.u32.mul(math.u32.div(localIndex, 16), 16), 12)]),
                    math.f32.narrow(bTile[math.u32.add(192, math.u32.mod(localIndex, 16))]),
                    value
                )
                value = math.f32.fma(
                    math.f32.narrow(aTile[math.u32.add(math.u32.mul(math.u32.div(localIndex, 16), 16), 13)]),
                    math.f32.narrow(bTile[math.u32.add(208, math.u32.mod(localIndex, 16))]),
                    value
                )
                value = math.f32.fma(
                    math.f32.narrow(aTile[math.u32.add(math.u32.mul(math.u32.div(localIndex, 16), 16), 14)]),
                    math.f32.narrow(bTile[math.u32.add(224, math.u32.mod(localIndex, 16))]),
                    value
                )
                value = math.f32.fma(
                    math.f32.narrow(aTile[math.u32.add(math.u32.mul(math.u32.div(localIndex, 16), 16), 15)]),
                    math.f32.narrow(bTile[math.u32.add(240, math.u32.mod(localIndex, 16))]),
                    value
                )
                accumulators[localIndex] = value
            end)
            tile = math.u32.add(tile, 1)
        end
        phases:run(function(localIndex: uint32)
            local laneRow = math.u32.div(localIndex, math.u32.wrap(16))
            local laneColumn = math.u32.mod(localIndex, math.u32.wrap(16))
            local tilesPerRow = math.u32.div(columns, math.u32.wrap(16))
            local tileRow = math.u32.div(groupIndex, tilesPerRow)
            local tileColumn = math.u32.mod(groupIndex, tilesPerRow)
            local row = math.u32.add(math.u32.mul(tileRow, math.u32.wrap(16)), laneRow)
            local column = math.u32.add(math.u32.mul(tileColumn, math.u32.wrap(16)), laneColumn)
            local output = math.u32.add(math.u32.mul(row, columns), column)
            if output < #c then
                c[output + 1] = math.f32.narrow(accumulators[localIndex])
            end
        end)
    end)
end

-- Dense batched output with independently strided A and B inputs. A zero batch
-- stride broadcasts one matrix across every batch; transposes are represented
-- by exchanging the row/inner or inner/column strides.
@aot(target = "gpu")
local function gemmBatched(
    exclusive c: span.WriteSpan<float>,
    borrows a: span.Span<float>,
    borrows b: span.Span<float>,
    rows: uint32,
    columns: uint32,
    inner: uint32,
    aBatchStride: uint32,
    aRowStride: uint32,
    aInnerStride: uint32,
    bBatchStride: uint32,
    bInnerStride: uint32,
    bColumnStride: uint32
): nil
    for i = 1, #c do
        local offset = math.u32.sub(math.u32.wrap(i), 1)
        local plane = math.u32.mul(rows, columns)
        local batch = math.u32.div(offset, plane)
        local within = math.u32.mod(offset, plane)
        local row = math.u32.div(within, columns)
        local column = math.u32.mod(within, columns)
        local value: float = 0.0
        local cursor: uint32 = 0
        while cursor < inner do
            local ai = math.u32.add(
                math.u32.add(math.u32.mul(batch, aBatchStride), math.u32.mul(row, aRowStride)),
                math.u32.mul(cursor, aInnerStride)
            )
            local bi = math.u32.add(
                math.u32.add(math.u32.mul(batch, bBatchStride), math.u32.mul(cursor, bInnerStride)),
                math.u32.mul(column, bColumnStride)
            )
            if ai < #a then
                local left = math.f32.narrow(a[ai + 1])
                if bi < #b then
                    value = math.f32.fma(left, math.f32.narrow(b[bi + 1]), value)
                end
            end
            cursor = math.u32.add(cursor, 1)
        end
        c[i] = value
    end
end

export const now = os.monotonic

export const gemm = gemmNaive
export const cpu = gemmCpu
export const tiled = gemmTiled
export const batched = gemmBatched
export const copy = copyProbe
export const fill = fillProbe
export const abi = abiProbe
export const loop = loopProbe
export const fma = fmaProbe
export const uintUniform = uintUniformProbe
export const fixedLoop = fixedLoopProbe
