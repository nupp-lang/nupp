-- The AoS loop the reification thesis rests on, raced against the plain-table
-- code the same program would otherwise be.
-- Run: nupp bench --file bench/aos.bench.nupp

local bench = require("nupp.bench")
const {type Invocation} = require("nupp.bench")

local struct Particle
    x: number
    y: number
    z: number
    vx: number
    vy: number
    vz: number
end

local N: integer = 200000
local STEPS: integer = 60
local DT = 1 / 60

local function structs(_: any, _: Invocation): number
    local ps = carray(Particle, N)
    local sink = 0.0
    unsafe do
        -- N is both the allocation bound and the loop bound. The unsafe boundary
        -- records that invariant without adding a checked-view cost to this arm.
        for i = 0, N - 1 do
            ps[i].x = i
            ps[i].y = i * 2
            ps[i].vx = 0.1
            ps[i].vy = 0.2
            ps[i].vz = 0.3
        end
        for _ = 1, STEPS do
            for i = 0, N - 1 do
                local p = ps[i]
                p.x = p.x + p.vx * DT
                p.y = p.y + p.vy * DT
                p.z = p.z + p.vz * DT
            end
        end
        sink = ps[N - 1].x + ps[N - 1].y + ps[N - 1].z
    end

    return sink
end

local function tables(_: any, _: Invocation): number
    local ps = {}
    for i = 1, N do
        ps[i] = {x = i, y = i * 2, z = 0, vx = 0.1, vy = 0.2, vz = 0.3}
    end
    for _ = 1, STEPS do
        for i = 1, N do
            local p = ps[i]
            p.x = p.x + p.vx * DT
            p.y = p.y + p.vy * DT
            p.z = p.z + p.vz * DT
        end
    end
    local last = ps[N]

    return last.x + last.y + last.z
end

bench.suite(
    {
        name = "aos",
        baselineVariant = "tables",
        variants = {{name = "tables", run = tables}, {name = "carray", run = structs},},
        cases = {{name = "particle-update", operations = N * STEPS},},
        warmupIterations = 1,
        minSamples = 5,
        minDurationSec = 0.5,
        maxSamples = 100,
        maxDurationSec = 10,
    } as bench.SuiteOptions
)
bench.report()
