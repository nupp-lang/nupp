@@ -1015,2 +1034,2 @@ function TaskMT.await(self: any): ...any
-    const owner = self._owner as ScopeState
-    const child = self._child as Child
+    const child = managedStates[self] as Child
+    const owner = child.scope as ScopeState
@@ -1175 +1194,7 @@ end
-local function spawnRaw(owner: ScopeState, name: string, body: any, arguments: Packed?): Child
+local function spawnRaw(
+    owner: ScopeState,
