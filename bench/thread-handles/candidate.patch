@@ -87,0 +88,19 @@ local timeModule: any = loadedTime or {now = missingTime, wakeat = missingTime}
+-- Experimental LuaJIT representation. Live coroutine frames keep their Child
+-- alive. Only a dead coroutine needs an environment anchor; installing it while
+-- running would also change the environment inherited by loadstring chunks.
+local rawResume = coroutine.resume
+local managedStates: any = setmetatable({}, {__mode = "kv"})
+local managedKey: any = {}
+local globalEnvironment: any = {__index = _G}
+local coroutineHost: any = rawget(_G, "coroutine")
+local threadEnvironment: any = debug
+
+local function anchorCompleted(co: thread, value: any): nil
+    const original = threadEnvironment.getfenv(co)
+    const environment: any = {[managedKey] = value}
+    threadEnvironment.setfenv(
+        co,
+        setmetatable(environment, original == _G and globalEnvironment or {__index = original})
+    )
+end
+
@@ -553,0 +573,4 @@ local function settleChild(owner: ScopeState, child: Child, status: string): nil
+    const co = child.thread
+    if co ~= nil and managedStates[co] == child and coroutine.status(co) == "dead" then
+        anchorCompleted(co, child)
+    end
@@ -704 +727 @@ local function resumeChild(owner: ScopeState, child: Child): nil
