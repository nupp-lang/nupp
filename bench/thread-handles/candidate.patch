-    return newTask(owner, spawnRaw(owner, name, body, arguments))
+    const _, co = spawnRaw(owner, name, body, arguments, true)
+
+    return co
@@ -1295 +1327 @@ function ForkMT.isdone(self: any): boolean
-    return (self._task as any):isdone()
+    return (managedStates[self]._task as any):isdone()
@@ -1299 +1331 @@ function ForkMT.status(self: any): string
-    return (self._task as any):status()
+    return (managedStates[self]._task as any):status()
@@ -1303 +1335 @@ function ForkMT.cancel(self: any, reason: string?): boolean
-    return (self._task as any):cancel(reason)
+    return (managedStates[self]._task as any):cancel(reason)
@@ -1307 +1339 @@ function ForkMT.await(self: any): ...any
-    const owner = self._owner as ScopeState
+    const owner = managedStates[self]._owner as ScopeState
@@ -1311 +1343 @@ function ForkMT.await(self: any): ...any
-    )(self._task)
+    )(managedStates[self]._task)
@@ -1324,0 +1357,31 @@ end
+-- The metatable is shared by LuaJIT threads. Raw coroutines retain their prior
+-- index behavior, and managed handles select the existing task method family.
+const probe = coroutine.create(function(): nil
+    return nil
+end)
+local threadMethods: any = debug.getmetatable(probe) or {}
+const previousIndex = threadMethods.__index
+threadMethods.__index = function(self: any, key: any): any
+    const state = managedStates[self]
+    if state ~= nil then
+        const methods = state._task ~= nil and ForkMT or TaskMT
+
+        return methods[key]
+    end
+    if type(previousIndex) == "function" then
+        return previousIndex(self, key)
+    elseif type(previousIndex) == "table" then
+        return previousIndex[key]
+    end
+
+    return nil
+end
+debug.setmetatable(probe, threadMethods)
+coroutineHost.resume = function(co: any, ...: any): ...any
+    if managedStates[co] ~= nil then
+        return false, "nupp: a managed task is resumed by its scope; use await"
+    end
+
+    return rawResume(co, ...)
+end
+
@@ -1349 +1412,9 @@ local function startWorker(scope: any, dedicated: boolean, fn: any, ...: any): a
-    return setmetatable({_owner = owner, _task = task,}, ForkMT)
+    const state = {_owner = owner, _task = task,}
+    -- A local completion proxy owns the provider handle through its initial
+    -- closure. The job still executes in the provider's isolated VM.
+    const co = coroutine.create(function(): any
+        return state
+    end)
+    managedStates[co] = state
+
+    return co
