-- Representative regular-backend span kernel for plan 061.
--
-- `guarded` is the shape used by the AOT kernel subset today. `ranged` preserves
-- its length error and replaces only the handwritten range guard with the standard
-- witness. The benchmark driver supplies the handwritten direct form so this file
-- remains ordinary checked Nupp.
local span = require("nupp.mem.span")
local indexed = require("nupp.mem.indexed")

local kernel = {}

struct kernel.Position
    x: float
    y: float
end

struct kernel.Velocity
    x: float
    y: float
end

@relax("frames")
function kernel.guarded(
    exclusive positions: span.WriteSpan<kernel.Position>,
    borrows velocities: span.Span<kernel.Velocity>,
    first: integer,
    last: integer,
    steps: integer,
    dt: float
): nil
    if #positions ~= #velocities then
        error("length mismatch", 2)
    end
    if first < 1 or last > #positions or first > last + 1 then
        error("range out of bounds", 2)
    end

    for _ = 1, steps do
        for index = first, last do
            positions[index].x = velocities[index].x * dt + velocities[index].y
            positions[index].y = velocities[index].y * dt - velocities[index].x
        end
    end
end

@relax("frames")
function kernel.ranged(
    exclusive positions: span.WriteSpan<kernel.Position>,
    borrows velocities: span.Span<kernel.Velocity>,
    first: integer,
    last: integer,
    steps: integer,
    dt: float
): nil
    if #positions ~= #velocities then
        error("length mismatch", 2)
    end
    const output = positions
    const input = velocities
    const rows = indexed.range(first, last, output, input)

    for _ = 1, steps do
        for index = rows.first, rows.last do
            output[index].x = input[index].x * dt + input[index].y
            output[index].y = input[index].y * dt - input[index].x
        end
    end
end

-- Correctness sentinels for the direct form's root and offset behavior. They are not
-- part of the timed kernel.
@relax("frames")
function kernel.stringChecksum(text: string): number
    const bytes = span.fromString(text)
    const rows = indexed.range(1, #bytes, bytes)
    local total = 0
    for index = rows.first, rows.last do
        if index % 257 == 0 then
            collectgarbage()
        end
        total = total + bytes[index]
    end

    return total
end

@relax("frames")
function kernel.gcCopy(
    exclusive positions: span.WriteSpan<kernel.Position>,
    borrows velocities: span.Span<kernel.Velocity>
): nil
    const output = positions
    const input = velocities
    const rows = indexed.range(1, #output, output, input)
    for index = rows.first, rows.last do
        if index % 67 == 0 then
            collectgarbage()
        end
        output[index].x = input[index].x
    end
end

@relax("frames")
function kernel.rootGcCopy(
    exclusive positions: kernel.Position[?],
    borrows velocities: kernel.Velocity[?],
    count: integer
): nil
    const output = span.writeCarray(positions, count)
    const input = span.fromCarray(velocities, count)
    for index = 1, #output do
        if index % 67 == 0 then
            collectgarbage()
        end
        output[index].x = input[index].x
    end
    drop output
end

return kernel
