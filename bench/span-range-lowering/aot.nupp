-- Forced-scalar native context for the same position/velocity element update.
-- The driver invokes one sweep repeatedly so the AOT body keeps the subset's
-- canonical single map loop.
local span = require("nupp.mem.span")

local struct Position
    x: float
    y: float
end

local struct Velocity
    x: float
    y: float
end

@aot(vectorize = false)
local function advance(
    exclusive positions: span.WriteSpan<Position>,
    borrows velocities: span.Span<Velocity>,
    first: integer,
    last: integer,
    dt: float
): nil
    if #positions ~= #velocities then
        error("length mismatch", 2)
    end
    if first < 1 or last > #positions or first > last + 1 then
        error("range out of bounds", 2)
    end

    for index = first, last do
        local position = positions[index]
        local velocity = velocities[index]
        position.x = velocity.x * dt + velocity.y
        position.y = velocity.y * dt - velocity.x
    end
end

return {advance = advance, Position = Position, Velocity = Velocity,}
