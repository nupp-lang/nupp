const extensions = require("nupp.serde.extensions")
local record Schema
    @readonly name: string
end
local calls = 0
local key: extensions.Key<Schema, string> = extensions.key(function(schema: Schema): string
    calls += 1
    return schema.name .. ":encoded"
end)
local schema = new Schema(name = "record")
local cache = extensions.cache(schema)
assert(calls == 0)
assert(cache:get(key) == "record:encoded")
assert(cache:get(key) == "record:encoded")
assert(calls == 1)
cache:clear()
assert(cache:get(key) == "record:encoded")
assert(calls == 2)

-- Identity includes both the host and the extension key, not a schema name.
local otherHost = extensions.cache(new Schema(name = "other"))
assert(otherHost:get(key) == "other:encoded")
local otherKey: extensions.Key<Schema, string> = extensions.key(function(host: Schema): string
    return host.name .. ":alternate"
end)
assert(cache:get(otherKey) == "record:alternate")
assert(cache:get(key) == "record:encoded")

-- Nil is a cached result, not an absent entry.
local nilCalls = 0
local nilKey: extensions.Key<Schema, string?> = extensions.key(function(host: Schema): string?
    nilCalls += 1
    return nil
end)
assert(cache:get(nilKey) == nil)
assert(cache:get(nilKey) == nil)
assert(nilCalls == 1)

-- A failure preserves its identity, and is retried only after explicit release.
local marker = {}
local failures = 0
local failed: extensions.Key<Schema, string> = extensions.key(function(host: Schema): string
    failures += 1
    error(marker, 0)
end)

local function fail(): nil
    cache:get(failed)
end

local ok, first = pcall(fail)
local again, second = pcall(fail)
assert(not ok and not again and first == marker and second == marker)
assert(failures == 1)
cache:clear()
assert(not pcall(fail))
assert(failures == 2)

-- A failed entry counts against the same bound as a successful one.
local bounded = extensions.cache(schema, 1)

local function useBounded(): nil
    bounded:get(failed)
end

assert(not pcall(useBounded))

local function overflow(): nil
    bounded:get(key)
end

local full, fullError = pcall(overflow)
assert(not full and tostring(fullError):find("limit exceeded", 1, true) ~= nil)
bounded:clear()
assert(bounded:get(key) == "record:encoded")

-- Clearing an active cache cannot replace the in-flight entry.
local cleared: extensions.Key<Schema, string> = extensions.key(function(host: Schema): string
    cache:clear()
    return "unreachable"
end)

local function clearDuringBuild(): nil
    cache:get(cleared)
end

local clearedOk, clearedError = pcall(clearDuringBuild)
assert(not clearedOk and tostring(clearedError):find("is initializing", 1, true) ~= nil)
cache:clear()
assert(cache:get(key) == "record:encoded")

-- Recursive extension resolution fails deterministically instead of publishing
-- an incompletely initialized value. Recursive serializers must link their
-- private placeholders before their root initializer returns.
local cycle: extensions.Key<Schema, string>?
cycle = extensions.key(function(host: Schema): string
    return cache:get(assert(cycle))
end)

local function recurse(): nil
    cache:get(assert(cycle))
end

local cyclic, cycleError = pcall(recurse)
assert(not cyclic and tostring(cycleError):find("recursive extension", 1, true) ~= nil)
assert(not pcall(recurse))
cache:clear()
assert(cache:get(key) == "record:encoded")
return true
