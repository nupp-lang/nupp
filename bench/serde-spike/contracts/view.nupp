const assert2 = require("assert")

const util = require("types")

local serde = require("serde")
local views = require("serde.document")
local json = require("serde.json")
local contexts = require("serde.codec")
local core = require("serde")
local record Child
    name: string
end
local record Value
    child: Child
    items: {string}
end
local binding = serde.binding(Value)
local adapter = views.viewadapter(binding)
local key = util.Key<string>()
local builder = contexts.contextbuilder({}, {})
builder:set(key, "model context")
local context = builder:freeze()
local owner = Value(child = Child(name = "first"), items = {"one"})
local view = views.view(binding, owner, context)
local snapshot = view:snapshot()
assert2(view.binding == binding and snapshot.binding == binding)
owner.child.name, owner.items[1] = "changed", "two"
assert2(json.encodedocument(adapter, view) == '{"child":{"name":"changed"},"items":["two"]}')
assert2(json.encodedocument(adapter, snapshot) == '{"child":{"name":"first"},"items":["one"]}')
assert2(assert2(snapshot:context()):get(key) == "model context")
assert2(assert2(snapshot:document():get("child")):get("name") ~= nil)
local restored = json.decodedocument(adapter, '{"child":{"name":"read"},"items":[]}', context)
assert2(assert2(restored:context()):get(key) == "model context")
assert2(json.encodedocument(adapter, restored) == '{"child":{"name":"read"},"items":[]}')
local foreign = views.viewadapter(serde.binding(Value, serde.Options(naming = "snakecase")))
assert2(not pcall(json.encodedocument, foreign, view))

local model = require("example.richmodel")
local schema = model.newModel()
local packetBinding = model.binding(schema)
local packet = model.Packet(id = "first", created = core.Timestamp(seconds = "0", nanos = 1))
local typed = views.view(packetBinding, packet)
local held = typed:snapshot()
packet.id = "updated"
local packetAdapter = views.viewadapter(packetBinding)
local epochs, dates = json.codec(model.policy(true)), json.codec(model.policy(false))
assert2(epochs:encodedocument(packetAdapter, typed):find('"identifier":"updated"', 1, true))
assert2(dates:encodedocument(packetAdapter, held):find('"id":"first"', 1, true))
assert2(dates:encodedocument(packetAdapter, held):find('1970-01-01T00:00:00.000000001Z', 1, true))
