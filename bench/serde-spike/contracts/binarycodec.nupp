const assert2 = require("assert")

local __serdeJson = require("serde.json")
local core = require("serde")
local codec = require("example.binarycodec")
local syntax = require("example.binary")
local declarations = require("serde")
local structure = require("serde.adapters")
local indexed = require("serde.adapters")
local bridge = require("serde.document")
local documents = require("serde.document")
local scalar = require("serde.adapters")

local record Numbers is codec.Policy
    function number<M is core.Member>(self, member: M): integer
        return member.index or 1
    end
end
local policy = Numbers()
local binary = codec.codec(policy)
local record Packet
    name: string
    serial: uint64
    pair: {int32, string}
end
local binding = declarations.binding(Packet)
local packet = Packet(name = "direct", serial = 18446744073709551615ULL, pair = {-32768, "pair"})
local bytes = binary:encode(binding, packet)
local restored = binary:decode(binding, bytes)
assert2(
    restored.name == packet.name
    and restored.serial == packet.serial
    and restored.pair[1] == -32768
    and restored.pair[2] == "pair"
)
local source = syntax.reader(bytes)
local entries: {syntax.Entry} = {}
while true do
    local entry = source:next()
    if entry == nil then
        break
    end
    entries[#entries + 1] = entry
end
assert2(#entries == 3 and entries[2].bytes == string.rep("\255", 8))
local reordered = syntax.encode({entries[3], entries[1], entries[2]})
assert2(binary:decode(binding, reordered).serial == packet.serial)
assert2(not pcall(binary.decode, binary, binding, bytes:sub(1, #bytes - 1)))
assert2(not pcall(binary.decode, binary, binding, syntax.encode({entries[1], entries[1], entries[2], entries[3]})))
local extended = syntax.Entry(field = entries[3].field, bytes = entries[3].bytes .. "\0")
assert2(not pcall(binary.decode, binary, binding, syntax.encode({entries[1], entries[2], extended})))

-- Reuse the declaration's public field operations with dense indexed storage.
-- The binary codec never learns the declaration's member type or constructor.
local record IndexField<T, S is own.Closeable, M is core.Member> is structure.FieldConsumer<T, S, M, nil>
    @readonly layout: indexed.Layout<M>
    @readonly required: boolean
    function apply<V is own.Copyable>(
        self,
        member: M,
        has: structure.Has<T>,
        get: structure.Get<T, V>,
        set: structure.Set<S, V>,
        adapter: core.Adapter<V, M>,
        fallback: (function(): V)?
    ): nil
        if fallback ~= nil then
            self.layout:adddefault(member, adapter, fallback)
        else
            self.layout:add(member, adapter, self.required)
        end
    end
end
local record IndexStructure<
    T,
    M is core.Member
> is structure.StructureConsumer<T, M, core.Binding<indexed.IndexedValue>>
    function apply<S is own.Closeable>(
        self,
        member: M,
        fields: const{structure.Field<T, S, M>},
        construction: structure.Construction<T, S>,
        unknown: core.UnknownConsumer<S>,
        additional: core.Members<M, T>?
    ): core.Binding<indexed.IndexedValue>
        assert2(additional == nil, "this indexed fixture needs fixed known fields")
        local layout = indexed.layout(member)
        for _, field in ipairs(fields) do
            field:accept(IndexField<T, S, M>(layout = layout, required = field.required))
        end

        return layout:binding()
    end
end
local record IndexBinding<T> is core.Consumer<T, nil, core.Binding<indexed.IndexedValue>>
    function apply<M is core.Member>(
        self,
        adapter: core.Adapter<T, M>,
        borrows state: nil
    ): core.Binding<indexed.IndexedValue>
        return assert2(structure.inspect(adapter, IndexStructure<T, M>()))
    end
end
-- Declaration bindings wrap their structure adapter, so use a separately owned
-- model for inspectable record/indexed access below.
local record Member is core.Member
    @readonly name: string
    @readonly index: integer?
end
local root = Member(name = "Envelope")
local name = Member(name = "name", index = 1)
local blob = Member(name = "blob", index = 2)
local record Captured
    @readonly field: syntax.Field
    @readonly value: documents.Document
end
local record Envelope
    name: string
    blob: string
    unknown: {Captured} = {}
end
local record Builder is own.Closeable
    name: string?
    blob: string?
    unknown: {Captured} = {}
    function close(takes self): nil
    end
end
local record Construction is structure.Construction<Envelope, Builder>
    function begin(self): Builder
        return Builder()
    end

    function finish(self, takes state: Builder): Envelope
        local owned: Builder = state
        local value = Envelope(name = assert2(owned.name), blob = assert2(owned.blob), unknown = owned.unknown)
        owned:close()
        return value
    end
end
local record Unknown is core.UnknownConsumer<Builder>
    function apply<F is core.WireField>(
        self,
        exclusive state: Builder,
        identity: F,
        exclusive reader: core.UnknownReader
    ): nil
        state.unknown[
            #state.unknown + 1
        ] = Captured(field = syntax.identity(identity), value = reader:capturevalue(documents.adapter()))
    end
end
local record Additional is core.Members<Member, Envelope>
    function apply(self, borrows value: Envelope, exclusive writer: core.Writer<Member>): nil
        for _, entry in ipairs(value.unknown) do
            writer:writeunknown(entry.field, entry.value, documents.adapter())
        end
    end
end
local fields: {structure.Field<Envelope, Builder, Member>} = {
    structure.field<Envelope, Builder, string, Member>(
        name,
        function(borrows value: Envelope): string borrows (value)
            return value.name
        end,
        function(exclusive state: Builder, value: string): nil
            state.name = value
        end,
        scalar.text(name),
        true,
        false
    ),
    structure.field<Envelope, Builder, string, Member>(
        blob,
        function(borrows value: Envelope): string borrows (value)
            return value.blob
        end,
        function(exclusive state: Builder, value: string): nil
            state.blob = value
        end,
        scalar.bytes(blob),
        true,
        false
    )
}
local plain = core.Bound<Envelope, Member>(adapter = structure.structure(root, fields, Construction(), nil, nil))
local dynamic = plain:accept(IndexBinding<Envelope>(), nil)
local envelope = Envelope(name = "wire", blob = "\0\255bytes")
local encoded = binary:encode(plain, envelope)
local indexedValue = binary:decode(dynamic, encoded)
assert2(binary:encode(dynamic, indexedValue) == encoded)
assert2(bridge.into(plain, bridge.from(dynamic, indexedValue)).blob == envelope.blob)
local opened = core.Bound<Envelope, Member>(
    adapter = structure.structure(root, fields, Construction(), Unknown(), Additional())
)
local reader = syntax.reader(encoded)
local first, second = assert2(reader:next()), assert2(reader:next())
local future = syntax.Entry(field = syntax.Field(number = 47, wire = 200), bytes = "\0future\255")
local captured = binary:decode(opened, syntax.encode({future, second, first}))
assert2(captured.blob == envelope.blob and #captured.unknown == 1)
assert2(captured.unknown[1].field.number == 47 and captured.unknown[1].field.wire == 200)
local replay = syntax.reader(binary:encode(opened, captured))
assert2(assert2(replay:next()).bytes == envelope.name)
assert2(assert2(replay:next()).bytes == envelope.blob)
assert2(assert2(replay:next()).bytes == future.bytes)
assert2(replay:next() == nil)
assert2(not pcall(binary.decode, binary, plain, syntax.encode({first, second, future})))
local foreign = codec.codec(Numbers())
assert2(not pcall(foreign.encode, foreign, opened, captured))
local wrongWire = syntax.Entry(field = syntax.Field(number = 1, wire = 2), bytes = "name")
assert2(not pcall(binary.decode, binary, opened, syntax.encode({wrongWire, second})))

local record Skip is core.UnknownConsumer<Builder>
    function apply<F is core.WireField>(
        self,
        exclusive state: Builder,
        field: F,
        exclusive reader: core.UnknownReader
    ): nil
        reader:skipvalue()
    end
end
local skipping = core.Bound<Envelope, Member>(adapter = structure.structure(root, fields, Construction(), Skip(), nil))
local skipped = binary:decode(skipping, syntax.encode({future, first, second}))
assert2(skipped.name == envelope.name and #skipped.unknown == 0)
local malformed = syntax.Entry(field = first.field, bytes = "\255")
assert2(not pcall(binary.decode, binary, plain, syntax.encode({malformed, second})))
