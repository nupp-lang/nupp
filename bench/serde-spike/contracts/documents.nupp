local __serdeJson = require("serde.json")
const util = require("types")

local core = require("serde")
local documents = require("serde.document")
local readers = require("serde.document")
local contexts = require("serde.codec")
local json = require("serde.json")
local model = require("example.richmodel")
local richJson = json.codec(model.policy(true))

local record Custom is core.Atom
    @readonly family: table
    @readonly payload: string
    function snapshot(borrows self): core.Atom
        return Custom(family = self.family, payload = self.payload)
    end
end
local family: table = {}
local atom = Custom(family = family, payload = "custom")
local codec, profile = {}, {}
local key = util.Key<string>()
local builder = contexts.contextbuilder(codec, profile)
builder:set(key, "retained")
local context = builder:freeze()
local original = documents.withcontext(
    documents.tuple({
        documents.null(),
        documents.integer(core.Integer(decimal = "18446744073709551615", width = 64, signed = false)),
        documents.decimal(core.Decimal(coefficient = "-0", exponent = -2)),
        documents.float(core.Float(value = 1.5, width = 32)),
        documents.biginteger("123456789012345678901234567890"),
        documents.bytes("\0\255blob"),
        documents.timestamp(core.Timestamp(seconds = "-1", nanos = 500000000)),
        documents.union("ok", documents.bool(true)),
        documents.map({
            documents.MapEntry(
                key = documents.integer(core.Integer(decimal = "7", width = 32, signed = true)),
                value = documents.null()
            )
        }),
        documents.atom(atom),
        documents.null(),
    }),
    context
)
local snapshot = readers.snapshot(original)
assert(snapshot ~= original and snapshot.kind == "tuple" and snapshot:size() == 11)
assert(snapshot:at(1).kind == "null" and snapshot:at(11).kind == "null")
assert(snapshot:at(2):integer().decimal == "18446744073709551615")
assert(snapshot:at(3):decimal().coefficient == "-0" and snapshot:at(3):decimal().exponent == -2)
assert(snapshot:at(4):float().width == 32 and snapshot:at(4):float().value == 1.5)
assert(snapshot:at(5):biginteger() == "123456789012345678901234567890")
assert(snapshot:at(6):bytes() == "\0\255blob")
assert(snapshot:at(7):timestamp().nanos == 500000000)
assert(assert(snapshot:at(8):get("ok")):bool())
assert(snapshot:at(9):entry(1).key:integer().decimal == "7")
assert(snapshot:at(9):entry(1).value.kind == "null")
assert(snapshot:at(10):atom().family == atom.family)
assert(assert(snapshot:at(9):entry(1).value:context()):get(key) == "retained")
local jsonValue = documents.tuple({snapshot:at(2), snapshot:at(3), snapshot:at(6), snapshot:at(9), documents.null()})
local bytes = richJson:encode(documents.adapter():contents(), jsonValue)
assert(bytes == '[18446744073709551615,-0e-2,"AP9ibG9i",{"7":null},null]')
assert(
    not pcall(function(): string
        return richJson:encode(documents.adapter():contents(), snapshot)
    end)
)
print("rich documents snapshot exact values, typed keys, nulls, atoms, and context without wire serialization")

local boundary = documents.boundary(documents.boundary(documents.string("nested")))
local copied = readers.snapshot(boundary)
assert(copied.kind == "document" and copied:document().kind == "document")
assert(copied:document():document():string() == "nested")
assert(richJson:encode(documents.adapter():contents(), copied) == '"nested"')

local record Mutable is core.Atom
    @readonly family: table
    payload: string
    function snapshot(borrows self): core.Atom
        return Mutable(family = self.family, payload = self.payload)
    end
end
local mutable = Mutable(family = family, payload = "original")
local retained = documents.atom(mutable)
mutable.payload = "changed"
local exported = retained:atom() as Mutable
assert(exported.payload == "original")
exported.payload = "changed again"
assert((readers.snapshot(retained):atom() as Mutable).payload == "original")
