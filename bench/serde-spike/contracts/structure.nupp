const assert2 = require("assert")

local core = require("serde")
local structure = require("serde.adapters")
local codec = require("serde.json")
local plans = require("serde.json")
local json = require("serde.json")

local record Counts
    opened: integer = 0
    closed: integer = 0
    finished: integer = 0
    gets: integer = 0
end
local counts = Counts()
local type Handler = function(): string
local record Value
    text: string
    callback: Handler
    constructor(self, text: string)
        assert2(text ~= "invalid", "constructor validation")
        self.text = text
        self.callback = function(): string
            return "default"
        end
    end
end
local record Builder is own.Closeable
    text: string?
    function close(takes self): nil
        counts.closed += 1
    end
end
local record Construction is structure.Construction<Value, Builder>
    function begin(self): Builder
        counts.opened += 1
        return Builder()
    end

    function finish(self, takes state: Builder): Value
        local owned: Builder = state
        local value = Value(text = assert2(owned.text, "required text"))
        counts.finished += 1
        owned:close()

        return value
    end
end
local record Member is core.Member
    @readonly name: string
    @readonly index: integer?
end
local record Description is core.Description<Member>
    @readonly member: Member
    @readonly kind: core.Kind
    @readonly nullable: boolean = false
    @readonly width: integer?
    @readonly signed: boolean?
    @readonly canread: boolean = true
    @readonly children: {core.Child<Member>} = {}
end
local record Text is core.Adapter<string, Member>
    @readonly member: Member
    function describe(self, direction: core.Direction): core.Description<Member>
        return Description(member = self.member, kind = "string")
    end

    function write(self, borrows value: string, exclusive writer: core.Writer<Member>): nil
        writer:writestring(self.member, tostring(value))
    end

    function read(self, exclusive reader: core.Reader<Member>): string
        return reader:readstring(self.member)
    end
end
local record Callback is core.Adapter<Handler, Member>
    @readonly member: Member
    function describe(self, direction: core.Direction): core.Description<Member>
        error("excluded adapter must not be described")
    end

    function write(self, borrows value: Handler, exclusive writer: core.Writer<Member>): nil
        error("excluded adapter must not write")
    end

    function read(self, exclusive reader: core.Reader<Member>): Handler
        error("excluded adapter must not read")
    end
end
local record Policy<M is core.Member> is plans.Policy<M>
    function name(self, member: M): string
        return member.name
    end

    function select(self, member: M, direction: core.Direction): plans.Selection
        return member.name == "callback" and "redact" or "traverse"
    end

    function timestamp(self, member: M, borrows value: core.Timestamp): json.EncodedValue
        error("no timestamp mapping")
    end

    function parsetimestamp(self, member: M, text: string, kind: "string" | "number"): core.Timestamp
        error("no timestamp mapping")
    end
end
local record Factory is plans.PolicyFactory
    function policy<M is core.Member>(self, member: M): plans.Policy<M>
        return Policy<M>()
    end
end
local root = Member(name = "Value")
local textMember = Member(name = "text", index = 1)
local callbackMember = Member(name = "callback", index = 2)
local fields: {structure.Field<Value, Builder, Member>} = {
    structure.field<Value, Builder, string, Member>(
        textMember,
        function(borrows value: Value): string borrows (value)
            counts.gets += 1
            return value.text
        end,
        function(exclusive state: Builder, value: string): nil
            state.text = value
        end,
        Text(member = textMember),
        true,
        false
    ),
    structure.field<Value, Builder, Handler, Member>(
        callbackMember,
        function(borrows value: Value): Handler borrows (value)
            error("redacted getter must not execute")
        end,
        function(exclusive state: Builder, value: Handler): nil
            error("redacted setter must not execute")
        end,
        Callback(member = callbackMember),
        true,
        true
    )
}
local selected = structure.structure(root, fields, Construction())
local binding: core.Binding<Value> = core.Bound<Value, Member>(adapter = selected)
local engine = codec.codec(Factory())
assert2(engine:encode(binding, Value(text = "ok")) == '{"text":"ok","callback":"[redacted]"}')
assert2(counts.gets == 1)
local decoded = engine:decode(binding, '{"text":"ok","callback":null}')
assert2(decoded.text == "ok" and decoded.callback() == "default")
assert2(counts.opened == 1 and counts.closed == 1 and counts.finished == 1)
for _, input in ipairs({'{}', '{"text":"invalid"}', '{"text":"ok","callback":[}', '{"text":"ok"} trailing'}) do
    assert2(not pcall(engine.decode, engine, binding, input))
    assert2(counts.closed == counts.opened, input .. ": " .. tostring(counts.closed) .. "/" .. tostring(counts.opened))
    assert2(counts.finished == 1)
end
local record Inspect is structure.StructureConsumer<Value, Member, integer>
    function apply<S is own.Closeable>(
        self,
        member: Member,
        described: const{structure.Field<Value, S, Member>},
        construction: structure.Construction<Value, S>,
        unknown: core.UnknownConsumer<S>,
        additional: core.Members<Member, Value>?
    ): integer
        assert2(member == root and described[1].member == textMember and described[2].hasdefault)
        return #described
    end
end
assert2(structure.inspect(selected, Inspect()) == 2)
print("typed structure operations preserve selection, checked construction, and abort cleanup")
