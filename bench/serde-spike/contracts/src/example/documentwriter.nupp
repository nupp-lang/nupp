module example.documentwriter

local core = require("contract.value")
local documents = require("example.document")
local errors = require("contract.errors")
local numbers = require("contract.numbers")

local record Frame
    @readonly kind: core.Kind
    @readonly fields: {documents.Entry} = {}
    @readonly elements: {documents.Document} = {}
    @readonly entries: {documents.MapEntry} = {}
    @readonly names: {[string]: boolean} = {}
    inEntry: boolean = false
    readingKey: boolean = false
    key: documents.Document?
end

local fromContents: function<D>(adapter: core.DocumentAdapter<D>, borrows value: D, depth: integer): documents.Document

export record Output<M is core.Member> is core.Writer<M>
    @private @readonly frames: {Frame} = {}
    @private @readonly source: core.Context?
    @private @readonly depth: integer = 0
    @private result: documents.Document?
    @private closed: boolean = false

    function live(self): nil
        assert(not self.closed, "document writer scope has expired")
    end

    function finish(self): documents.Document
        self:live()
        assert(#self.frames == 0, "unfinished document aggregate")
        return assert(self.result, "binding did not emit a value")
    end

    function close(takes self): nil
        self.closed = true
    end

    function include(exclusive self, member: M): boolean
        self:live()
        return true
    end

    function put(exclusive self, member: M, value: documents.Document): nil
        self:live()
        if self.source ~= nil and value:context() == nil then
            value = documents.withContext(value, self.source)
        end
        local frame = self.frames[#self.frames]
        if frame == nil then
            assert(self.result == nil, "binding emitted more than one value")
            self.result = value
        elseif frame.kind == "structure" or frame.kind == "union" then
            assert(not frame.names[member.name], "duplicate logical document member")
            frame.names[member.name] = true
            frame.fields[#frame.fields + 1] = new documents.Entry(name = member.name, value = value)
        elseif frame.kind == "map" then
            assert(frame.inEntry, "map value outside an entry")
            if frame.readingKey then
                assert(frame.key == nil, "map key emitted more than one value")
                frame.key = value
            else
                local key = assert(frame.key, "map entry has no key or emitted more than one value")
                frame.entries[#frame.entries + 1] = new documents.MapEntry(key = key, value = value)
                frame.key = nil
            end
        else
            frame.elements[#frame.elements + 1] = value
        end
    end

    function writeNull(exclusive self, member: M): nil
        self:put(member, documents.null())
    end

    function writeBoolean(exclusive self, member: M, value: boolean): nil
        self:put(member, documents.boolean(value))
    end

    function writeInteger(exclusive self, member: M, borrows value: core.Integer): nil
        self:put(member, documents.integer(numbers.integer(value.decimal, value.width, value.signed)))
    end

    function writeFloat(exclusive self, member: M, value: number, width: 32 | 64): nil
        self:put(member, documents.float(new core.Float(value = numbers.floating(value, width), width = width)))
    end

    function writeBigInteger(exclusive self, member: M, value: string): nil
        self:put(member, documents.bigInteger(value))
    end

    function writeDecimal(exclusive self, member: M, borrows value: core.Decimal): nil
        self:put(
            member,
            documents.decimal(new core.Decimal(coefficient = value.coefficient, exponent = value.exponent))
        )
    end

    function writeNumberToken(exclusive self, member: M, value: string): nil
        self:put(member, documents.numberToken(value))
    end

    function writeString(exclusive self, member: M, value: string): nil
        self:put(member, documents.string(value))
    end

    function writeBytes(exclusive self, member: M, value: string): nil
        self:put(member, documents.bytes(value))
    end

    function writeTimestamp(exclusive self, member: M, borrows value: core.Timestamp): nil
        self:put(member, documents.timestamp(new core.Timestamp(seconds = value.seconds, nanos = value.nanos)))
    end

    function writeAtom<A is core.Atom>(exclusive self, member: M, borrows value: A): nil
        self:put(member, documents.atom(value))
    end

    function writeDocument<D>(exclusive self, member: M, borrows value: D, adapter: core.DocumentAdapter<D>): nil
        self:put(member, documents.document(fromContents(adapter, value, self.depth + #self.frames + 1)))
    end

    function aggregate<S>(
        exclusive self,
        member: M,
        kind: core.Kind,
        size: integer?,
        borrows source: S,
        emit: core.Members<M, S>
    ): nil
        self:live()
        if self.depth + #self.frames >= 128 then
            error(
                new errors.Error(code = "limit", message = "document nesting limit exceeded", path = "$", cause = nil),
                0
            )
        end
        local frame = new Frame(kind = kind)
        self.frames[#self.frames + 1] = frame
        emit:apply(source, self)
        local value: documents.Document
        if kind == "structure" then
            value = documents.object(frame.fields)
        elseif kind == "union" then
            assert(#frame.fields == 1, "union requires exactly one alternative")
            value = documents.union(frame.fields[1].name, frame.fields[1].value)
        elseif kind == "map" then
            value = documents.map(frame.entries)
        elseif kind == "tuple" then
            value = documents.tuple(frame.elements)
        else
            value = documents.list(frame.elements)
        end
        assert(size == nil or value:size() == size, "wrong aggregate size")
        table.remove(self.frames)
        self:put(member, value)
    end

    function writeStruct<S>(exclusive self, member: M, borrows source: S, emit: core.Members<M, S>): nil
        self:aggregate(member, "structure", nil, source, emit)
    end

    function writeUnion<S>(exclusive self, member: M, borrows source: S, emit: core.Members<M, S>): nil
        self:aggregate(member, "union", 1, source, emit)
    end

    function writeList<S>(exclusive self, member: M, size: integer?, borrows source: S, emit: core.Members<M, S>): nil
        self:aggregate(member, "list", size, source, emit)
    end

    function writeTuple<S>(exclusive self, member: M, size: integer, borrows source: S, emit: core.Members<M, S>): nil
        self:aggregate(member, "tuple", size, source, emit)
    end

    function writeMap<S>(exclusive self, member: M, size: integer?, borrows source: S, emit: core.Members<M, S>): nil
        self:aggregate(member, "map", size, source, emit)
    end

    function writeEntry<K, V>(
        exclusive self,
        borrows key: K,
        keyEmit: core.Members<M, K>,
        borrows value: V,
        valueEmit: core.Members<M, V>
    ): nil
        self:live()
        local frame = assert(self.frames[#self.frames], "entry outside map")
        assert(frame.kind == "map" and not frame.inEntry, "entry outside map")
        frame.inEntry, frame.readingKey = true, true
        keyEmit:apply(key, self)
        assert(frame.key ~= nil, "map key did not emit a value")
        frame.readingKey = false
        local before = #frame.entries
        valueEmit:apply(value, self)
        assert(#frame.entries == before + 1, "map entry did not emit a value")
        frame.inEntry = false
    end

    function writeUnknown<F is core.WireField, D>(
        exclusive self,
        field: F,
        borrows value: D,
        adapter: core.DocumentAdapter<D>
    ): nil
        self:live()
        if getmetatable(field) ~= documents.Name then
            error("wire field needs an explicit logical identity mapping", 2)
        end
        local frame = assert(self.frames[#self.frames], "unknown field outside structure")
        assert(frame.kind == "structure" or frame.kind == "union", "unknown field outside structure")
        local name = (field as documents.Name).name
        assert(not frame.names[name], "unknown field collides with a logical member")
        frame.names[name] = true
        frame.fields[
            #frame.fields + 1
        ] = new documents.Entry(name = name, value = fromContents(adapter, value, self.depth + #self.frames))
    end
end

local record Capture<T> is core.Consumer<T, T, documents.Document>
    @readonly context: core.Context?
    @readonly depth: integer = 0
    function apply<M is core.Member>(self, adapter: core.Adapter<T, M>, borrows value: T): documents.Document
        local writer = new Output<M>(source = self.context, depth = self.depth)
        adapter:write(value, writer)
        return writer:finish()
    end
end

fromContents = function<D>(adapter: core.DocumentAdapter<D>, borrows value: D, depth: integer): documents.Document
    assert(depth <= 128, "document nesting limit exceeded")
    return adapter:contents():accept(new Capture<D>(context = adapter:context(value), depth = depth), value)
end

export function fromBinding<T>(binding: core.Binding<T>, borrows value: T, context: core.Context?): documents.Document
    return binding:accept(new Capture<T>(context = context), value)
end
