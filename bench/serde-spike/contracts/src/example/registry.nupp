module example.registry

const assert2 = require("assert")

local __serdeJson = require("serde.json")

local core = require("serde")
local documents = require("serde.document")
local bridge = require("serde.document")

export interface Consumer<R>
    apply: function<T is own.Copyable>(self, identity: string, binding: core.Binding<T>, borrows value: T): R
end
export interface Value
    identity: function(self): string
    accept: function<R>(self, consumer: Consumer<R>): R
end
local record Selected<T is own.Copyable> is Value
    @readonly id: string
    @readonly binding: core.Binding<T>
    @readonly value: T
    function identity(self): string
        return self.id
    end

    function accept<R>(self, consumer: Consumer<R>): R
        return consumer:apply<T>(self.id, self.binding, self.value)
    end
end
local interface Entry
    read: function(self, value: documents.Document): Value
end
local record Bound<T is own.Copyable> is Entry
    @readonly id: string
    @readonly binding: core.Binding<T>
    function read(self, value: documents.Document): Value
        return Selected<T>(id = self.id, binding = self.binding, value = bridge.into(self.binding, value))
    end
end

-- The discriminator belongs to this registry. It is never a module name or a
-- request to load executable code, and resolution does not use global state.
export record Registry
    @private @readonly entries: {[string]: Entry} = {}
    function register<T is own.Copyable>(self, identity: string, binding: core.Binding<T>): nil
        assert2(identity ~= "" and self.entries[identity] == nil, "duplicate or empty type identity")
        self.entries[identity] = Bound<T>(id = identity, binding = binding)
    end

    function contains(self, identity: string): boolean
        return self.entries[identity] ~= nil
    end

    function reconstruct(self, identity: string, value: documents.Document): Value
        return assert2(self.entries[identity], "unknown type discriminator: " .. identity):read(value)
    end
end

local record Project is Consumer<documents.Document>
    function apply<T is own.Copyable>(
        self,
        identity: string,
        binding: core.Binding<T>,
        borrows value: T
    ): documents.Document
        return bridge.from(binding, value)
    end
end
export function project(value: Value): documents.Document
    return value:accept(Project())
end

export function registry(): Registry
    return Registry()
end
