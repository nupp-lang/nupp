module example.openapi

const assert2 = require("assert")

local __serdeJson = require("serde.json")

local core = require("serde")
local structures = require("serde.adapters")
local plans = require("serde.json")
local json = require("serde.json")
local documents = require("serde.document")
local jsonDocument = require("serde.json")

export type View = "request" | "response"
export record Property is core.Member
    @readonly name: string
    @readonly index: integer?
    @readonly readOnly: boolean = false
    @readonly writeOnly: boolean = false
end
export record Choice
    @readonly alternative: "text" | "integer"
    @readonly value: documents.Document
end
export record Value
    name: string
    secret: string = ""
    identifier: string = ""
    payload: Choice
    additional: {[string]: documents.Document}
end
export record Model
    @readonly root: Property
    @readonly name: Property
    @readonly secret: Property
    @readonly identifier: Property
    @readonly payload: Property
    @readonly positiveAlternative: boolean
end
export function model(positiveAlternative: boolean?): Model
    return Model(
        root = Property(name = "Response"),
        name = Property(name = "name", index = 1),
        secret = Property(name = "secret", index = 2, writeOnly = true),
        identifier = Property(name = "id", index = 3, readOnly = true),
        payload = Property(name = "payload", index = 4),
        positiveAlternative = positiveAlternative == true
    )
end

local record Description is core.Description<Property>
    @readonly kind: core.Kind
    @readonly member: Property
    @readonly nullable: boolean = false
    @readonly width: integer?
    @readonly signed: boolean?
    @readonly canread: boolean = true
    @readonly children: {core.Child<Property>} = {}
end
local record Text is core.Adapter<string, Property>
    @readonly member: Property
    function describe(self, direction: core.Direction): core.Description<Property>
        return Description(kind = "string", member = self.member)
    end

    function write(self, borrows value: string, exclusive writer: core.Writer<Property>): nil
        writer:writestring(self.member, tostring(value))
    end

    function read(self, exclusive reader: core.Reader<Property>): string
        return reader:readstring(self.member)
    end
end

local function choose(schema: Model, value: documents.Document): Choice
    if value.kind == "string" then
        return Choice(alternative = "text", value = value)
    else
        assert2(value.kind == "numbertoken", "oneOf accepts text or an integer")
        local token = value:numbertoken()
        assert2(token:match("^%-?%d+$") ~= nil, "oneOf integer branch refused a fraction")
        local parsed = assert2(tonumber(token), "invalid integer")
        assert2(parsed >= -2147483648 and parsed <= 2147483647, "oneOf integer overflow")
        assert2(not schema.positiveAlternative or parsed <= 0, "ambiguous oneOf: two integer alternatives match")
        return Choice(alternative = "integer", value = value)
    end
end

local record Alternatives is core.Adapter<Choice, Property>
    @readonly schema: Model
    function describe(self, direction: core.Direction): core.Description<Property>
        return Description(kind = "dynamic", member = self.schema.payload)
    end

    function write(self, borrows value: Choice, exclusive writer: core.Writer<Property>): nil
        local selected = choose(self.schema, value.value)
        assert2(selected.alternative == value.alternative, "wrong oneOf selection")
        if selected.alternative == "text" then
            writer:writestring(self.schema.payload, selected.value:string())
        else
            writer:writenumbertoken(self.schema.payload, selected.value:numbertoken())
        end
    end

    function read(self, exclusive reader: core.Reader<Property>): Choice
        local value = reader:readdocument(self.schema.payload, documents.adapter())
        return choose(self.schema, value)
    end
end
local record Builder is own.Closeable
    name: string?
    secret: string = ""
    identifier: string = ""
    payload: Choice?
    additional: {[string]: documents.Document} = {}
    function close(takes self): nil
    end
end
local record Construction is structures.Construction<Value, Builder>
    function begin(self): Builder
        return Builder()
    end

    function finish(self, takes state: Builder): Value
        local owned: Builder = state
        local result = Value(
            name = assert2(owned.name, "required name"),
            secret = owned.secret,
            identifier = owned.identifier,
            payload = assert2(owned.payload, "required payload"),
            additional = owned.additional
        )
        owned:close()

        return result
    end
end
local record Unknown is core.UnknownConsumer<Builder>
    function apply<F is core.WireField>(
        self,
        exclusive state: Builder,
        field: F,
        exclusive reader: core.UnknownReader
    ): nil
        -- This fixture's JSON field identity exposes its literal name explicitly.
        -- Protocols with different identities supply their own capture operation.
        local name = jsonDocument.fieldname(field)
        state.additional[name] = reader:capturevalue(documents.adapter())
    end
end
local record Additional is core.Members<Property, Value>
    function apply(self, borrows value: Value, exclusive writer: core.Writer<Property>): nil
        local names: {string} = {}
        for name in pairs(value.additional) do
            names[#names + 1] = name
        end
        table.sort(names)
        for _, name in ipairs(names) do
            writer:writeunknown(
                jsonDocument.FieldName(name = name),
                assert2(value.additional[name]),
                documents.adapter()
            )
        end
    end
end
export function binding(schema: Model): core.Binding<Value>
    local fields: {structures.Field<Value, Builder, Property>} = {
        structures.field<Value, Builder, string, Property>(
            schema.name,
            function(borrows value: Value): string borrows (value)
                return value.name
            end,
            function(exclusive state: Builder, value: string): nil
                state.name = value
            end,
            Text(member = schema.name),
            true,
            false
        ),
        structures.field<Value, Builder, string, Property>(
            schema.secret,
            function(borrows value: Value): string borrows (value)
                return value.secret
            end,
            function(exclusive state: Builder, value: string): nil
                state.secret = value
            end,
            Text(member = schema.secret),
            false,
            true
        ),
        structures.field<Value, Builder, string, Property>(
            schema.identifier,
            function(borrows value: Value): string borrows (value)
                return value.identifier
            end,
            function(exclusive state: Builder, value: string): nil
                state.identifier = value
            end,
            Text(member = schema.identifier),
            false,
            true
        ),
        structures.field<Value, Builder, Choice, Property>(
            schema.payload,
            function(borrows value: Value): Choice borrows (value)
                return value.payload
            end,
            function(exclusive state: Builder, value: Choice): nil
                state.payload = value
            end,
            Alternatives(schema = schema),
            true,
            false
        )
    }

    return core.Bound<Value, Property>(
        adapter = structures.structure(schema.root, fields, Construction(), Unknown(), Additional())
    )
end

local record DocumentBuilder is own.Closeable
    @readonly fields: {documents.Entry} = {}
    function close(takes self): nil
    end
end
local record DocumentConstruction is structures.Construction<documents.Document, DocumentBuilder>
    function begin(self): DocumentBuilder
        return DocumentBuilder()
    end

    function finish(self, takes state: DocumentBuilder): documents.Document
        local owned: DocumentBuilder = state
        local value = documents.object(owned.fields)
        assert2(value:get("name") ~= nil and value:get("payload") ~= nil, "missing required OpenAPI property")
        for _, name in ipairs({"secret", "id"}) do
            if value:get(name) == nil then
                owned.fields[#owned.fields + 1] = documents.Entry(name = name, value = documents.string(""))
            end
        end
        value = documents.object(owned.fields)
        owned:close()

        return value
    end
end
local record DocumentField is structures.Field<documents.Document, DocumentBuilder, Property>
    @readonly member: Property
    @readonly required: boolean
    @readonly hasdefault: boolean
    @readonly adapter: core.Adapter<documents.Document, Property>
    function describe(self, direction: core.Direction): core.Description<Property>
        return self.adapter:describe(direction)
    end

    function write(self, borrows source: documents.Document, exclusive writer: core.Writer<Property>): nil
        local value = source:get(self.member.name)
        assert2(value ~= nil or not self.required, "missing required OpenAPI property")
        if value ~= nil then
            self.adapter:write(value, writer)
        end
    end

    function read(self, exclusive state: DocumentBuilder, exclusive reader: core.Reader<Property>): nil
        state.fields[#state.fields + 1] = documents.Entry(name = self.member.name, value = self.adapter:read(reader))
    end

    function accept<R>(self, consumer: structures.FieldConsumer<documents.Document, DocumentBuilder, Property, R>): R
        local name = self.member.name
        return consumer:apply<documents.Document>(
            self.member,
            function(borrows source: documents.Document): boolean
                return source:get(name) ~= nil
            end,
            structures.copiedget<documents.Document, documents.Document>(function(
                borrows source: documents.Document
            ): documents.Document
                return (assert2(source:get(name), "absent property"))
            end),
            function(exclusive state: DocumentBuilder, value: documents.Document): nil
                state.fields[#state.fields + 1] = documents.Entry(name = name, value = value)
            end,
            self.adapter,
            nil
        )
    end
end
local record DocumentScalar is core.Adapter<documents.Document, Property>
    @readonly schema: Model
    @readonly member: Property
    function describe(self, direction: core.Direction): core.Description<Property>
        return Description(member = self.member, kind = self.member == self.schema.payload and "dynamic" or "string")
    end

    function write(self, borrows value: documents.Document, exclusive writer: core.Writer<Property>): nil
        if self.member == self.schema.payload then
            local copied = value.kind == "string" and documents.string(value:string())
                or documents.numbertoken(value:numbertoken())
            local selected = choose(self.schema, copied)
            if selected.alternative == "text" then
                writer:writestring(self.member, selected.value:string())
            else
                writer:writenumbertoken(self.member, selected.value:numbertoken())
            end
        else
            writer:writestring(self.member, value:string())
        end
    end

    function read(self, exclusive reader: core.Reader<Property>): documents.Document
        if self.member == self.schema.payload then
            local value = reader:readdocument(self.member, documents.adapter())
            return choose(self.schema, value).value
        else
            return documents.string(reader:readstring(self.member))
        end
    end
end
local record DocumentUnknown is core.UnknownConsumer<DocumentBuilder>
    function apply<F is core.WireField>(
        self,
        exclusive state: DocumentBuilder,
        field: F,
        exclusive reader: core.UnknownReader
    ): nil
        state.fields[
            #state.fields + 1
        ] = documents.Entry(name = jsonDocument.fieldname(field), value = reader:capturevalue(documents.adapter()))
    end
end
local record DocumentAdditional is core.Members<Property, documents.Document>
    @readonly names: {[string]: boolean}
    function apply(self, borrows value: documents.Document, exclusive writer: core.Writer<Property>): nil
        local names: {string} = {}
        for index = 1, value:size() do
            local field = value:field(index)
            if not self.names[field.name] then
                names[#names + 1] = field.name
            end
        end
        table.sort(names)
        for _, name in ipairs(names) do
            writer:writeunknown(jsonDocument.FieldName(name = name), assert2(value:get(name)), documents.adapter())
        end
    end
end
export function documentBinding(schema: Model): core.Binding<documents.Document>
    local fields: {structures.Field<documents.Document, DocumentBuilder, Property>} = {}
    local names: {[string]: boolean} = {}
    for _, member in ipairs({schema.name, schema.secret, schema.identifier, schema.payload}) do
        local required = member == schema.name or member == schema.payload
        fields[
            #fields + 1
        ] = DocumentField(
            member = member,
            required = required,
            hasdefault = not required,
            adapter = DocumentScalar(schema = schema, member = member)
        )
        names[member.name] = true
    end

    return core.Bound<documents.Document, Property>(
        adapter = structures.structure(
            schema.root,
            fields,
            DocumentConstruction(),
            DocumentUnknown(),
            DocumentAdditional(names = names)
        )
    )
end

local record Policy<M is core.Member> is plans.Policy<M>
    @readonly view: View
    function name(self, member: M): string
        return member.name
    end

    function select(self, member: M, direction: core.Direction): plans.Selection
        assert2(getmetatable(member) == Property, "OpenAPI policy needs its own property handles")
        local property = member as Property
        if self.view == "request" and property.readOnly or self.view == "response" and property.writeOnly then
            return "omit"
        end

        return "traverse"
    end

    function timestamp(self, member: M, borrows value: core.Timestamp): json.EncodedValue
        error("OpenAPI fixture has no timestamp mapping")
    end

    function parsetimestamp(self, member: M, text: string, kind: "string" | "number"): core.Timestamp
        error("OpenAPI fixture has no timestamp mapping")
    end
end
local record Factory is plans.PolicyFactory
    @readonly view: View
    function policy<M is core.Member>(self, member: M): plans.Policy<M>
        local documentPolicy = __serdeJson.documentpolicy(member, true)
        if documentPolicy ~= nil then
            return documentPolicy
        end
        assert2(getmetatable(member) == Property, "OpenAPI policy needs its own model")

        return Policy<M>(view = self.view)
    end
end
export function policy(view: View): plans.PolicyFactory
    return Factory(view = view)
end
