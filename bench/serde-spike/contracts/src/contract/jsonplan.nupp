module contract.jsonplan

local core = require("contract.value")
local json = require("nupp.codec.json")
local errors = require("contract.errors")

export type Selection = "traverse" | "omit" | "redact"
export interface Policy<M is core.Member>
    name: function(self, member: M): string
    select: function(self, member: M, direction: core.Direction): Selection
    timestamp: function(self, member: M, borrows value: core.Timestamp): json.EncodedValue
    parseTimestamp: function(self, member: M, text: string, kind: "string" | "number"): core.Timestamp
end

export interface PolicyFactory
    policy: function<M is core.Member>(self, member: M): Policy<M>
end

export record Plan<M is core.Member>
    @readonly description: core.Description<M>
    @private @readonly names: {[string]: M}
    @private @readonly keys: {[M]: json.EncodedString}
    @private @readonly wireNames: {[M]: string}
    @private @readonly omittedNames: {[string]: boolean}
    @private @readonly actions: {[M]: Selection}
    @private @readonly children: {[M]: Plan<M>}
    function member(self, name: string): M?
        return self.names[name]
    end

    function key(self, member: M): json.EncodedString?
        return self.keys[member]
    end

    function wireName(self, member: M): string?
        return self.wireNames[member]
    end

    function omitsName(self, name: string): boolean
        return self.omittedNames[name] == true
    end

    function action(self, member: M): Selection?
        return self.actions[member]
    end

    function child(self, member: M): Plan<M>?
        return self.children[member]
    end

    function slot(self, index: integer): Plan<M>?
        local child = self.description.children[index]
        local plan = child ~= nil and self.children[child.member] or nil
        if plan ~= nil then
            return plan
        end
        if self.description.kind == "dynamic" then
            return nil
        else
            error("missing container slot " .. tostring(index), 2)
        end
    end
end

local function build<M is core.Member>(
    description: core.Description<M>,
    policy: Policy<M>,
    direction: core.Direction,
    seen: {[core.Description<M>]: Plan<M>},
    path: string
): Plan<M>
    local prior = seen[description]
    if prior ~= nil then
        return prior
    end
    if direction == "read" and not description.canRead then
        error(
            new errors.Error(
                code = "unsupported",
                message = "binding has no construction operation",
                path = path,
                cause = nil
            ),
            0
        )
    end
    if description.kind == "opaque" or description.kind == "atom" then
        error(
            new errors.Error(
                code = "unsupported",
                message = "JSON does not support " .. description.kind,
                path = path,
                cause = nil
            ),
            0
        )
    end
    local result = new Plan<M>(
        description = description,
        names = {},
        keys = {},
        wireNames = {},
        omittedNames = {},
        actions = {},
        children = {}
    )
    seen[description] = result
    for _, child in ipairs(description.children) do
        local member = child.member
        local childPath = path .. "[" .. json.encode(member.name) .. "]"
        local action = policy:select(member, direction)
        result.actions[member] = action
        if action ~= "traverse" and direction == "read" and child.required and not child.hasDefault then
            error(
                new errors.Error(
                    code = "unsupported",
                    message = "omitted member has no default",
                    path = childPath,
                    cause = nil
                ),
                0
            )
        end
        if description.kind == "structure" or description.kind == "union" then
            local name = policy:name(member)
            if action == "omit" then
                result.omittedNames[name] = true
            else
                if result.names[name] ~= nil then
                    error(
                        new errors.Error(
                            code = "contract",
                            message = "colliding JSON member name: " .. name,
                            path = childPath,
                            cause = nil
                        ),
                        0
                    )
                end
                result.names[name] = member
                result.keys[member] = json.encodedString(name)
                result.wireNames[member] = name
            end
        end
        if action == "traverse" then
            local ok, described = pcall(child.describe, child, direction)
            if not ok then
                error(errors.wrap(described, childPath, nil), 0)
            end
            result.children[member] = build(described as core.Description<M>, policy, direction, seen, childPath)
        end
    end

    return result
end

export function resolve<M is core.Member>(
    description: core.Description<M>,
    policy: Policy<M>,
    direction: core.Direction
): Plan<M>
    return build(description, policy, direction, {}, "$")
end
