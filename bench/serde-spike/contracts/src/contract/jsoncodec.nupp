module contract.jsoncodec

local core = require("contract.value")
local plans = require("contract.jsonplan")
local readers = require("contract.jsonreader")
local writers = require("contract.jsonwriter")
local syntax = require("contract.jsonsyntax")
local json = require("nupp.codec.json")
local text = require("nupp.text")
local contexts = require("contract.context")
local errors = require("contract.errors")
local extensions = require("contract.jsonextensions")

export const identity: table = {}

local record Append<T> is core.IntoConsumer<T, T, text.Buffer, nil>
    @readonly factory: plans.PolicyFactory
    @readonly cache: extensions.Scope
    function apply<M is core.Member>(
        self,
        adapter: core.Adapter<T, M>,
        borrows value: T,
        exclusive buffer: text.Buffer
    ): nil
        local operation = self.cache:resolve(adapter, "write")
        local sink = json.newWriter(buffer)
        do
            local writer = writers.output(sink, self.factory, operation.policy, operation.plan, self.cache)
            writer:emit(adapter, value)
            writer:close()
        end
        sink:close()
    end
end

local function append<T>(
    binding: core.Binding<T>,
    borrows value: T,
    exclusive buffer: text.Buffer,
    factory: plans.PolicyFactory,
    cache: extensions.Scope
): nil
    local mark = #buffer
    local consumer = new Append<T>(factory = factory, cache = cache)
    local ok, problem = pcall(binding.acceptInto, binding, consumer, value, buffer)
    if not ok then
        -- Successful writes append directly. Only rollback copies the old prefix.
        local prefix = buffer:tostring():sub(1, mark)
        buffer:set(prefix)
        error(problem, 0)
    end
end

local record Encode<T> is core.Consumer<T, T, string>
    @readonly factory: plans.PolicyFactory
    @readonly cache: extensions.Scope
    function apply<M is core.Member>(self, adapter: core.Adapter<T, M>, borrows value: T): string
        local operation = self.cache:resolve(adapter, "write")
        local buffer = text.newBuffer()
        local sink = json.newWriter(buffer)
        do
            local writer = writers.output(sink, self.factory, operation.policy, operation.plan, self.cache)
            writer:emit(adapter, value)
            writer:close()
        end
        sink:close()

        return buffer:tostring()
    end
end

local record Decode<T> is core.Consumer<T, string, T>
    @readonly factory: plans.PolicyFactory
    @readonly cache: extensions.Scope
    @readonly context: core.Context?
    function apply<M is core.Member>(self, adapter: core.Adapter<T, M>, borrows bytes: string): T
        local operation = self.cache:resolve(adapter, "read")
        local cursor = syntax.reader(bytes:sub(1))
        local reader = readers.input(cursor, operation.policy, operation.plan, self.context)
        local ok, result = pcall(adapter.read, adapter, reader)
        if not ok then
            error(errors.wrap(result, cursor:path(), cursor:offset()), 0)
        end
        cursor:finish()

        return result as T
    end
end

export function encode<T>(binding: core.Binding<T>, borrows value: T, factory: plans.PolicyFactory): string
    return binding:accept(new Encode<T>(factory = factory, cache = extensions.scope(factory)), value)
end

export function encodeInto<T>(
    binding: core.Binding<T>,
    borrows value: T,
    exclusive buffer: text.Buffer,
    factory: plans.PolicyFactory
): nil
    append(binding, value, buffer, factory, extensions.scope(factory))
end

export function decode<T>(
    binding: core.Binding<T>,
    bytes: string,
    factory: plans.PolicyFactory,
    context: core.Context?
): T
    local source = contexts.builder(identity, factory as table, context):freeze()
    return binding:accept(new Decode<T>(factory = factory, cache = extensions.scope(factory), context = source), bytes)
end

export interface Codec
    encode: function<T>(self, binding: core.Binding<T>, borrows value: T): string
    encodeInto: function<T>(self, binding: core.Binding<T>, borrows value: T, exclusive buffer: text.Buffer): nil
    decode: function<T>(self, binding: core.Binding<T>, bytes: string, context: core.Context?): T
    clear: function(self): nil
    cachedBindings: function(self): integer
end

local record Cached is Codec
    @readonly factory: plans.PolicyFactory
    @readonly cache: extensions.Scope

    function encode<T>(self, binding: core.Binding<T>, borrows value: T): string
        return binding:accept(new Encode<T>(factory = self.factory, cache = self.cache), value)
    end

    function encodeInto<T>(self, binding: core.Binding<T>, borrows value: T, exclusive buffer: text.Buffer): nil
        append(binding, value, buffer, self.factory, self.cache)
    end

    function decode<T>(self, binding: core.Binding<T>, bytes: string, context: core.Context?): T
        local source = contexts.builder(identity, self.factory as table, context):freeze()
        return binding:accept(new Decode<T>(factory = self.factory, cache = self.cache, context = source), bytes)
    end

    function clear(self): nil
        self.cache:clear()
    end

    function cachedBindings(self): integer
        return self.cache:size()
    end
end

export function codec(factory: plans.PolicyFactory, capacity: integer?): Codec
    return new Cached(factory = factory, cache = extensions.scope(factory, capacity))
end
