module contract.breadth

const assert2 = require("assert")

local __serdeJson = require("serde.json")

local model = require("example.richmodel")
local smithy = require("example.smithy")
local api = require("example.openapi")
local registry = require("example.registry")
local core = require("serde")
local serde = require("serde")
local json = require("serde.json")
local syntax = require("serde.json")
local docs = require("serde.document")
local bridge = require("serde.document")
local readers = require("serde.document")
local views = require("serde.document")
local cases = {}

local function task(name, work)
    local value = work()
    assert2(value ~= nil)
    cases[#cases + 1] = {name = name, work = work}
end

local function bindingCases(name, binding, input, policy)
    local codec = json.codec(policy)
    local value = codec:decode(binding, input)
    local canonical = codec:encode(binding, value)
    assert2(codec:encode(binding, codec:decode(binding, canonical)) == canonical)
    -- One buffer reused across iterations; a managed alias lets each task borrow it.
    local buffer = own.manage(io.Buffer.create()):alias()
    task(name .. "/encode", function()
        return codec:encode(binding, value)
    end)
    task(name .. "/decode", function()
        return codec:decode(binding, input)
    end)
    task(name .. "/buffer", function()
        return buffer:withexclusive(function(exclusive target: io.Buffer): integer
            target:clear()
            codec:encodeinto(binding, value, target)
            return target:len()
        end)
    end)
    task(name .. "/fresh-buffer", function()
        local fresh = io.Buffer.create()
        codec:encodeinto(binding, value, fresh)
        local size = fresh:len()
        fresh:close()

        return size
    end)
    task(name .. "/embedded", function()
        return buffer:withexclusive(function(exclusive target: io.Buffer): integer
            target:clear()
            local sink = syntax.Writer.of(target)
            sink:startarray()
            codec:writevalue(binding, value, sink)
            sink:endarray()
            sink:close()

            return target:len()
        end)
    end)

    return value, codec
end

local schema = model.newModel()
local nominal, indexed, document = model.binding(schema), model.indexed(schema), model.documentBinding(schema)
local epoch, date = model.policy(true), model.policy(false)
local source = '{"identifier":"outer","created":0.000000001,"next":{"identifier":"inner","created":-0.5},"labels":{"7":"seven"}}'
local value, codec = bindingCases("recursive/nominal", nominal, source, epoch)
bindingCases("recursive/indexed", indexed, source, epoch)
bindingCases("recursive/document", document, source, epoch)
local logical = bridge.from(nominal, value)
local view, viewAdapter = views.view(nominal, value), views.viewadapter(nominal)
task("document/typed-view-create", function()
    return views.view(nominal, value)
end)
task("document/typed-view-encode", function()
    return codec:encodedocument(viewAdapter, view)
end)
task("document/typed-snapshot", function()
    return view:snapshot()
end)
task("document/snapshot", function()
    return readers.snapshot(logical)
end)
task("document/project", function()
    return bridge.from(nominal, value)
end)
local reconstruction = bridge.decoder(nominal)
task("document/reconstruct", function()
    return reconstruction:read(logical)
end)
local store = registry.registry()
store:register("example#Packet", nominal)
task("document/registry", function()
    return store:reconstruct("example#Packet", logical)
end)
local dateCodec = json.codec(date)
local alternate = false
task("policy/switch", function()
    alternate = not alternate
    return (alternate and codec or dateCodec):encode(nominal, value)
end)
task("extensions/cold", function()
    local fresh = json.codec(epoch)
    return fresh:encode(nominal, value)
end)
local apiBinding = api.binding(api.model())
bindingCases(
    "openapi/request",
    apiBinding,
    '{"name":"other","secret":"hidden","payload":7,"extra":true}',
    api.policy("request")
)
local ast = [[{"smithy":"2.0","shapes":{"example#Request":{"type":"structure","members":{"id":{"target":"smithy.api#String","traits":{"smithy.api#required":{}}},"active":{"target":"smithy.api#Boolean","traits":{"smithy.api#required":{}}},"name":{"target":"smithy.api#String","traits":{"smithy.api#required":{}}}}}}}]]
local loaded = smithy.parse(ast)
local smithyBinding = smithy.binding(loaded:shape("example#Request"))
bindingCases("smithy/document", smithyBinding, '{"id":"7","active":true,"name":"sample"}', smithy.policy(false, true))
task("model/load", function()
    return smithy.parse(ast)
end)
local record Strings
    id: string
    active: boolean
    name: string
end
local structure = require("serde.adapters")
local scalar = require("serde.adapters")
local record StringBuilder is own.Closeable
    id: string?
    active: boolean?
    name: string?
    function close(takes self): nil
        self.id, self.active, self.name = nil, nil, nil
    end
end
local record StringConstruction is structure.Construction<Strings, StringBuilder>
    function begin(self): StringBuilder
        return StringBuilder()
    end

    function finish(self, takes state: StringBuilder): Strings
        local owned: StringBuilder = state
        local active = owned.active
        assert2(active ~= nil)
        local result = Strings(id = assert2(owned.id), active = active, name = assert2(owned.name))
        owned:close()

        return result
    end
end
local smithyShape = loaded:shape("example#Request")
local idMember, activeMember, nameMember = assert2(
    smithyShape:member("id")
), assert2(smithyShape:member("active")), assert2(smithyShape:member("name"))
local smithyFields = {
    structure.field<Strings, StringBuilder, string, smithy.Member>(
        idMember,
        function(borrows value: Strings): string borrows (value)
            return value.id
        end,
        function(exclusive state: StringBuilder, value: string): nil
            state.id = value
        end,
        scalar.text(idMember),
        true,
        false
    ),
    structure.field<Strings, StringBuilder, boolean, smithy.Member>(
        activeMember,
        function(borrows value: Strings): boolean borrows (value)
            return value.active
        end,
        function(exclusive state: StringBuilder, value: boolean): nil
            state.active = value
        end,
        scalar.bool(activeMember),
        true,
        false
    ),
    structure.field<Strings, StringBuilder, string, smithy.Member>(
        nameMember,
        function(borrows value: Strings): string borrows (value)
            return value.name
        end,
        function(exclusive state: StringBuilder, value: string): nil
            state.name = value
        end,
        scalar.text(nameMember),
        true,
        false
    )
}
local typedSmithy = core.Bound<Strings, smithy.Member>(
    adapter = structure.structure(smithy.root(smithyShape), smithyFields, StringConstruction(), nil, nil, true)
)
bindingCases("smithy/nominal", typedSmithy, '{"id":"7","active":true,"name":"sample"}', smithy.policy(false, true))
bindingCases("declaration/smithy-equivalent", serde.binding(Strings), '{"id":"7","active":true,"name":"sample"}')
local record Escaped
    name: string
end
local escaped = serde.binding(
    Escaped,
    serde.Options(fields = {name = serde.FieldOptions(name = 'a"b')}, unknownmembers = "ignore")
)
bindingCases("matching/escaped-unknown", escaped, '{"unknown":{"nested":[1,null,{"x":false}]},"a\\\"b":"value"}')
local record Event
    createdAt: integer
end
local hook = serde.binding(
    Event,
    serde.Options(fields = {createdAt = serde.FieldOptions(representation = serde.iso8601seconds)})
)
bindingCases("hook/timestamp", hook, '{"createdAt":"1970-01-01T00:00:02Z"}')
local documentAdapter = docs.adapter()
local rich = docs.tuple({
    docs.biginteger("123456789012345678901234567890"),
    docs.decimal(core.Decimal(coefficient = "12345678901234567890", exponent = -9)),
    docs.bytes(string.rep("blob", 16384))
})
local richCodec = json.codec(epoch)
local richBytes = richCodec:encodedocument(documentAdapter, rich)
task("rich/blob-exact-encode", function()
    return richCodec:encodedocument(documentAdapter, rich)
end)
task("rich/json-contents-decode", function()
    return richCodec:decodedocument(documentAdapter, richBytes)
end)
bindingCases(
    "large-string",
    serde.binding(Strings),
    '{"id":"7","active":true,"name":' .. syntax.encodevalue(string.rep('large " payload ', 4096)) .. '}'
)
local richContents = documentAdapter:contents()
local richCanonical = richCodec:encode(richContents, rich)
local richBuffer = own.manage(io.Buffer.create()):alias()
assert2(
    richBuffer:withexclusive(function(exclusive target: io.Buffer): boolean
        richCodec:encodeinto(richContents, rich, target)
        return target:getstring() == richCanonical
    end)
)
task("rich/blob-buffer", function()
    return richBuffer:withexclusive(function(exclusive target: io.Buffer): integer
        target:clear()
        richCodec:encodeinto(richContents, rich, target)
        return target:len()
    end)
end)
task("rich/blob-fresh-buffer", function()
    local fresh = io.Buffer.create()
    richCodec:encodeinto(richContents, rich, fresh)
    local size = fresh:len()
    fresh:close()

    return size
end)
task("rich/blob-embedded", function()
    return richBuffer:withexclusive(function(exclusive target: io.Buffer): integer
        target:clear()
        local sink = syntax.Writer.of(target)
        sink:startarray()
        richCodec:writevalue(richContents, rich, sink)
        sink:endarray()
        sink:close()

        return target:len()
    end)
end)
-- Bounded extension churn and release are checked separately from timings.
local bounded = json.codec(epoch, 8)
for index = 1, 64 do
    local binding = model.binding(model.newModel())
    local item = bounded:decode(binding, source)
    assert2(bounded:encode(binding, item) ~= "")
    assert2(bounded:cachedbindings() <= 8)
end
bounded:clear()
assert2(bounded:cachedbindings() == 0)
export = cases
