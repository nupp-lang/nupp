module contract.declaration

local core = require("contract.value")
local access = require("contract.access")
local structure = require("contract.structure")
local plans = require("contract.jsonplan")
local json = require("nupp.codec.json")

local cacheKey: table = {}
local wideRuntime: any

local function wide(): any
    if wideRuntime == nil then
        local ok, runtime = pcall(_G.require, "ffi")
        if not ok then
            error("declaration binding: this target has no exact 64-bit carrier", 2)
        end
        wideRuntime = runtime
    end

    return wideRuntime
end

local record Member is core.Member
    @readonly name: string
    @readonly index: integer?
end

local record Description is core.Description<Member>
    @readonly member: Member
    @readonly kind: core.Kind
    @readonly nullable: boolean = false
    @readonly width: integer?
    @readonly signed: boolean?
    @readonly canRead: boolean = true
    @readonly children: const{core.Child<Member>} = {}
end

local record Scalar is core.Adapter<unknown, Member>
    @readonly description: Description
    @readonly integer: boolean = false

    function describe(self, direction: core.Direction): core.Description<Member>
        if self.description.kind == "integer" and self.description.width == 64 then
            wide()
        end
        return self.description
    end

    function write(self, borrows value: unknown, exclusive writer: core.Writer<Member>): nil
        local member = self.description.member
        local kind = self.description.kind
        if kind == "string" then
            writer:writeString(member, (value as string):sub(1))
        elseif kind == "boolean" then
            writer:writeBoolean(member, value == true)
        elseif kind == "float" then
            writer:writeFloat(member, (value as number) + 0, self.description.width as(32 | 64))
        elseif kind == "numberToken" then
            local number = (value as number) + 0
            assert(
                number == number and number ~= math.huge and number ~= -math.huge and number % 1 == 0,
                "expected a finite integer"
            )
            writer:writeNumberToken(member, ("%.17g"):format(number))
        elseif kind == "integer" then
            local decimal: string
            if self.description.width == 64 then
                -- tostring on the exact carrier includes LuaJIT's width suffix.
                decimal = tostring(value):gsub("[Uu]?[Ll][Ll]$", "")
            else
                decimal = ("%.0f"):format((value as number) + 0)
            end
            writer:writeInteger(
                member,
                new core.Integer(
                    decimal = decimal,
                    width = self.description.width as(8 | 16 | 32 | 64),
                    signed = self.description.signed == true
                )
            )
        elseif kind == "null" then
            writer:writeNull(member)
        else
            error("declaration field requires an explicit value adapter", 2)
        end
    end

    function read(self, exclusive reader: core.Reader<Member>): unknown
        local member = self.description.member
        local kind = self.description.kind
        if kind == "string" then
            return reader:readString(member)
        elseif kind == "boolean" then
            return reader:readBoolean(member)
        elseif kind == "float" then
            return reader:readFloat(member, self.description.width as(32 | 64))
        elseif kind == "numberToken" then
            local number = tonumber(reader:readNumberToken(member))
            assert(
                number ~= nil and number == number and number ~= math.huge and number ~= -math.huge and number % 1 == 0,
                "expected a finite integer"
            )
            return number
        elseif kind == "integer" then
            local decimal = reader:readInteger(
                member,
                self.description.width as(8 | 16 | 32 | 64),
                self.description.signed == true
            ).decimal
            if self.description.width == 64 then
                local runtime: any = wide()
                local magnitude: any = runtime.new("uint64_t", 0)
                local negative = decimal:sub(1, 1) == "-"
                for position = negative and 2 or 1, #decimal do
                    magnitude = magnitude * 10 + (assert(decimal:byte(position)) - 48)
                end
                if self.description.signed then
                    if negative then
                        return runtime.cast("int64_t", 0 - magnitude)
                    end
                    return runtime.cast("int64_t", magnitude)
                end
                return magnitude
            end
            return tonumber(decimal)
        elseif kind == "null" then
            reader:readNull(member)
            return nil
        else
            error("declaration field requires an explicit value adapter", 2)
        end
    end
end

local record Link is core.Adapter<unknown, Member>
    target: core.Adapter<unknown, Member>?
    function describe(self, direction: core.Direction): core.Description<Member>
        return assert(self.target, "incomplete declaration graph"):describe(direction)
    end

    function write(self, borrows value: unknown, exclusive writer: core.Writer<Member>): nil
        assert(self.target, "incomplete declaration graph"):write(value, writer)
    end

    function read(self, exclusive reader: core.Reader<Member>): unknown
        return assert(self.target, "incomplete declaration graph"):read(reader)
    end
end

local record Nullable is core.Adapter<unknown, Member>
    @readonly member: Member
    @readonly target: core.Adapter<unknown, Member>
    writeDescription: Description?
    readDescription: Description?
    function describe(self, direction: core.Direction): core.Description<Member>
        local prior: Description?
        if direction == "write" then
            prior = self.writeDescription
        else
            prior = self.readDescription
        end
        if prior ~= nil then
            return prior
        end
        local target = self.target:describe(direction)
        local result = new Description(
            member = self.member,
            kind = target.kind,
            nullable = true,
            width = target.width,
            signed = target.signed,
            canRead = target.canRead,
            children = target.children
        )
        if direction == "write" then
            self.writeDescription = result
        else
            self.readDescription = result
        end

        return result
    end

    function write(self, borrows value: unknown, exclusive writer: core.Writer<Member>): nil
        if value == nil then
            writer:writeNull(self.member)
        else
            self.target:write(value, writer)
        end
    end

    function read(self, exclusive reader: core.Reader<Member>): unknown
        if reader:isNull() then
            reader:readNull(self.member)
            return nil
        end

        return self.target:read(reader)
    end
end

local record Construction is structure.Construction<unknown, access.Builder<unknown>>
    @readonly selected: access.Access<unknown>
    function begin(self): access.Builder<unknown>
        return self.selected:begin()
    end

    function finish(self, takes state: access.Builder<unknown>): unknown
        return self.selected:finish(state)
    end
end

local record Checked is core.Adapter<unknown, Member>
    @readonly target: core.Adapter<unknown, Member>
    @readonly problem: string?
    function describe(self, direction: core.Direction): core.Description<Member>
        if direction == "read" and self.problem ~= nil then
            error(self.problem, 2)
        end
        return self.target:describe(direction)
    end

    function write(self, borrows value: unknown, exclusive writer: core.Writer<Member>): nil
        self.target:write(value, writer)
    end

    function read(self, exclusive reader: core.Reader<Member>): unknown
        assert(self.problem == nil, self.problem)
        return self.target:read(reader)
    end
end

local record Child is core.Child<Member>
    @readonly member: Member
    @readonly required: boolean = true
    @readonly hasDefault: boolean = false
    @readonly adapter: core.Adapter<unknown, Member>
    function describe(self, direction: core.Direction): core.Description<Member>
        return self.adapter:describe(direction)
    end
end

local record SequenceState
    @readonly values: {unknown} = {}
    count: integer = 0
end

local record EmitElements is core.Members<Member, unknown>
    @readonly adapters: {core.Adapter<unknown, Member>}
    @readonly tuple: boolean
    function apply(self, borrows source: unknown, exclusive writer: core.Writer<Member>): nil
        local count = self.tuple and #self.adapters or #(source as {unknown})
        for index = 1, count do
            self.adapters[self.tuple and index or 1]:write((source as {unknown})[index], writer)
        end
    end
end

local record ReadElements is core.ElementConsumer<Member, SequenceState>
    @readonly adapters: {core.Adapter<unknown, Member>}
    @readonly tuple: boolean
    function apply(self, exclusive state: SequenceState, index: integer, exclusive reader: core.Reader<Member>): nil
        assert(index == state.count + 1, "nonsequential element")
        local value = self.adapters[self.tuple and index or 1]:read(reader)
        assert(
            self.tuple or value ~= nil,
            "a Nupp array cannot retain a null element; use a document or explicit mapping"
        )
        state.values[index] = value
        state.count = index
    end
end

local record Sequence is core.Adapter<unknown, Member>
    @readonly description: Description
    @readonly elements: EmitElements
    @readonly consume: ReadElements
    function describe(self, direction: core.Direction): core.Description<Member>
        return self.description
    end

    function write(self, borrows value: unknown, exclusive writer: core.Writer<Member>): nil
        if self.elements.tuple then
            writer:writeTuple(self.description.member, #self.elements.adapters, value, self.elements)
        else
            writer:writeList(self.description.member, #(value as {unknown}), value, self.elements)
        end
    end

    function read(self, exclusive reader: core.Reader<Member>): unknown
        local state = new SequenceState()
        if self.elements.tuple then
            reader:readTuple(self.description.member, #self.elements.adapters, state, self.consume)
        else
            reader:readList(self.description.member, state, self.consume)
        end

        return state.values
    end
end

local record One is core.Members<Member, unknown>
    @readonly adapter: core.Adapter<unknown, Member>
    function apply(self, borrows source: unknown, exclusive writer: core.Writer<Member>): nil
        self.adapter:write(source, writer)
    end
end

local record MapState
    @readonly values: {[unknown]: unknown} = {}
    @readonly seen: {[unknown]: boolean} = {}
end

local record EmitEntries is core.Members<Member, unknown>
    @readonly key: One
    @readonly value: One
    function apply(self, borrows source: unknown, exclusive writer: core.Writer<Member>): nil
        for key, value in pairs(source as {[unknown]: unknown}) do
            writer:writeEntry(key, self.key, value, self.value)
        end
    end
end

local record ReadEntries is core.EntryConsumer<Member, MapState>
    @readonly key: One
    @readonly value: One
    function apply(
        self,
        exclusive state: MapState,
        exclusive key: core.Reader<Member>,
        exclusive value: core.Reader<Member>
    ): nil
        local name = self.key.adapter:read(key)
        assert(name ~= nil and name == name, "invalid map key")
        assert(not state.seen[name], "duplicate map key")
        local item = self.value.adapter:read(value)
        assert(item ~= nil, "a Nupp map cannot retain a null value; use a document or explicit mapping")
        state.seen[name] = true
        state.values[name] = item
    end
end

local record Map is core.Adapter<unknown, Member>
    @readonly description: Description
    @readonly entries: EmitEntries
    @readonly consume: ReadEntries
    function describe(self, direction: core.Direction): core.Description<Member>
        return self.description
    end

    function write(self, borrows value: unknown, exclusive writer: core.Writer<Member>): nil
        writer:writeMap(self.description.member, nil, value, self.entries)
    end

    function read(self, exclusive reader: core.Reader<Member>): unknown
        local state = new MapState()
        reader:readMap(self.description.member, state, self.consume)
        return state.values
    end
end

local record Graph
    @readonly root: access.Access<unknown>
    @readonly nodes: {[Member]: {[integer]: Link}} = {}
    @readonly members: {[integer]: {Member}} = {}
    @readonly accesses: {[integer]: access.Access<unknown>} = {}
end

local resolve: function(graph: Graph, index: integer, member: Member): core.Adapter<unknown, Member>

local function recordAdapter(graph: Graph, index: integer, member: Member): core.Adapter<unknown, Member>
    local selected = graph.accesses[index]
    if selected == nil then
        selected = graph.root:nested(index)
        graph.accesses[index] = selected
    end
    local members = graph.members[index]
    if members == nil then
        members = {}
        for position, field in ipairs(selected.fields) do
            members[position] = new Member(name = field.name, index = position)
        end
        graph.members[index] = members
    end
    local parameters: {[string]: const access.Parameter} = {}
    for _, parameter in ipairs(selected.parameters) do
        parameters[parameter.name] = parameter
    end
    local matched: {[string]: boolean} = {}
    local fields: {structure.Field<unknown, access.Builder<unknown>, Member>} = {}
    for position, field in ipairs(selected.fields) do
        local parameter = parameters[field.name]
        local compatible = parameter ~= nil and parameter.typeIndex == field.typeIndex
        if compatible then
            matched[field.name] = true
        end
        local child = resolve(graph, field.typeIndex, members[position])
        local target: core.Adapter<unknown, Member> = new Checked(
            target = child,
            problem = not compatible and ("field " .. field.name .. " requires an explicit construction mapping") or nil
        )
        fields[position] = structure.field<unknown, access.Builder<unknown>, unknown, Member>(
            members[position],
            function(borrows value: unknown): unknown borrows (value)
                return selected:get(value, field)
            end,
            function(exclusive state: access.Builder<unknown>, value: unknown): nil
                state:set(assert(parameter, "field has no construction parameter"), value)
            end,
            target,
            parameter ~= nil and not parameter.optional,
            field.hasDefault or parameter == nil
        )
    end
    local problem = selected:constructionError()
    for _, parameter in ipairs(selected.parameters) do
        if not matched[parameter.name] then
            problem = "constructor requires an explicit mapping for " .. parameter.name
        end
    end

    return new Checked(
        target = structure.adapter(member, fields, new Construction(selected = selected)),
        problem = problem
    )
end

resolve = function(graph: Graph, index: integer, member: Member): core.Adapter<unknown, Member>
    local slots = graph.nodes[member]
    if slots == nil then
        slots = {}
        graph.nodes[member] = slots
    end
    local prior = slots[index]
    if prior ~= nil then
        return prior
    end
    local link = new Link()
    slots[index] = link
    local node: any = graph.root.info.types[index]
    local kind = node.kind
    if kind == "record" or kind == "struct" then
        link.target = recordAdapter(graph, index, member)
    elseif kind == "array" or kind == "tuple" then
        local adapters: {core.Adapter<unknown, Member>} = {}
        local children: {core.Child<Member>} = {}
        local elements: {integer} = kind == "array" and {node.element} or node.members
        for position, element in ipairs(elements) do
            local child = new Member(name = tostring(position), index = position)
            adapters[position] = resolve(graph, element, child)
            children[position] = new Child(member = child, adapter = adapters[position])
        end
        link.target = new Sequence(
            description = new Description(
                member = member,
                kind = kind == "array" and "list" or "tuple",
                children = children
            ),
            elements = new EmitElements(adapters = adapters, tuple = kind == "tuple"),
            consume = new ReadElements(adapters = adapters, tuple = kind == "tuple")
        )
    elseif kind == "map" and node.readKey ~= nil and node.readValue ~= nil then
        local key = new Member(name = "key", index = 1)
        local value = new Member(name = "value", index = 2)
        local keyAdapter = resolve(graph, node.readKey, key)
        local valueAdapter = resolve(graph, node.readValue, value)
        link.target = new Map(
            description = new Description(
                member = member,
                kind = "map",
                children = {
                    new Child(member = key, adapter = keyAdapter),
                    new Child(member = value, adapter = valueAdapter)
                }
            ),
            entries = new EmitEntries(key = new One(adapter = keyAdapter), value = new One(adapter = valueAdapter)),
            consume = new ReadEntries(key = new One(adapter = keyAdapter), value = new One(adapter = valueAdapter))
        )
    elseif kind == "const" then
        link.target = resolve(graph, node.element, member)
    elseif kind == "literal" then
        link.target = resolve(graph, node.base, member)
    elseif kind == "union" then
        local target: integer? = nil
        local nullable = false
        for _, alternative in ipairs(node.members) do
            if graph.root.info.types[alternative].kind == "nil" then
                nullable = true
            elseif target == nil then
                target = alternative
            else
                target = -1
            end
        end
        if target ~= nil and target > 0 and nullable then
            link.target = new Nullable(member = member, target = resolve(graph, target, member))
        else
            link.target = new Scalar(description = new Description(member = member, kind = "opaque", canRead = false))
        end
    else
        local scalar: core.Kind = "opaque"
        local width: integer? = nil
        local signed: boolean? = nil
        if kind == "string" or kind == "boolean" then
            scalar = kind
        elseif kind == "nil" then
            scalar = "null"
        elseif kind == "integer" then
            scalar = "numberToken"
        elseif kind == "number" or kind == "float" then
            scalar, width = "float", kind == "float" and 32 or 64
        elseif kind == "int8"
            or kind == "uint8"
            or kind == "int16"
            or kind == "uint16"
            or kind == "int32"
            or kind == "uint32"
            or kind == "int64"
            or kind == "uint64"
        then
            scalar, width, signed = "integer", tonumber(kind:match("%d+")) as integer, kind:sub(1, 1) == "i"
        end
        link.target = new Scalar(
            description = new Description(
                member = member,
                kind = scalar,
                width = width,
                signed = signed,
                canRead = scalar ~= "opaque"
            )
        )
    end

    return link
end

local record Root<T is nupp.Copyable> is core.Adapter<T, Member>
    @readonly target: core.Adapter<unknown, Member>
    function describe(self, direction: core.Direction): core.Description<Member>
        return self.target:describe(direction)
    end

    function write(self, borrows value: T, exclusive writer: core.Writer<Member>): nil
        self.target:write(value as unknown, writer)
    end

    function read(self, exclusive reader: core.Reader<Member>): T
        return self.target:read(reader) as T
    end
end

export function binding<T is nupp.Copyable>(target: Type<T>): core.Binding<T>
    local selected = access.of(target)
    local cached = rawget(selected.info, cacheKey)
    if cached ~= nil then
        return cached as core.Binding<T>
    end
    local root = selected as access.Access<unknown>
    local graph = new Graph(root = root)
    graph.accesses[selected.typeIndex] = root
    local member = new Member(name = selected.info.name)
    local result: core.Binding<T> = new core.Bound<T, Member>(
        adapter = new Root<T>(target = resolve(graph, selected.typeIndex, member))
    )
    rawset(selected.info, cacheKey, result)

    return result
end

local record Policy<M is core.Member> is plans.Policy<M>
    function name(self, member: M): string
        return member.name
    end

    function select(self, member: M, direction: core.Direction): plans.Selection
        assert(getmetatable(member) == Member, "declaration policy requires declaration members")
        return "traverse"
    end

    function timestamp(self, member: M, borrows value: core.Timestamp): json.EncodedValue
        error("a timestamp requires an explicit declaration mapping")
    end

    function parseTimestamp(self, member: M, text: string, kind: "string" | "number"): core.Timestamp
        error("a timestamp requires an explicit declaration mapping")
    end
end

local record Factory is plans.PolicyFactory
    function policy<M is core.Member>(self, member: M): plans.Policy<M>
        assert(getmetatable(member) == Member, "declaration policy requires a declaration binding")
        return new Policy<M>()
    end
end

export function policy(): plans.PolicyFactory
    return new Factory()
end
