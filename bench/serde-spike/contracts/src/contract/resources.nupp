module contract.resources

export record Key<H is table, V>
    @private @readonly build: function(host: H): managed(V)
    @private @readonly _hostType: (function(host: H): H)?
    @private @readonly _valueType: (function(value: V): V)?
end

local record Entry
    state: "initializing" | "ready" | "failed"
    value: unknown
end

export record Scope<H is table> is nupp.Closeable
    @private @readonly host: H
    @private group: nupp.ManagedGroup
    @private entries: {[unknown]: Entry}
    @private @readonly limit: integer
    @private count: integer
    @private active: integer
    @private closed: boolean

    function get<V>(exclusive self, key: Key<H, V>): alias(V)
        if self.closed then
            error("resource extension scope is closed", 2)
        end
        local found = self.entries[key]
        if found ~= nil then
            if found.state == "failed" then
                error(found.value, 0)
            elseif found.state == "initializing" then
                error("recursive resource extension initialization", 2)
            else
                assert(found.state == "ready")
            end
            local erased, problem = nupp.recoverAlias(found.value)
            if erased == nil then
                error(problem, 2)
            end
            -- The private invariant key is the witness for this cache entry.
            -- recoverAlias checks the managed-cell brand at the erased boundary.
            return erased as alias(V)
        end
        if self.count >= self.limit then
            error("resource extension limit exceeded", 2)
        end
        local entry = new Entry(state = "initializing", value = nil)
        self.entries[key] = entry
        self.count += 1
        self.active += 1
        local ok, owner = pcall(key.build, self.host)
        self.active -= 1
        if not ok then
            entry.state, entry.value = "failed", owner
            error(owner, 0)
        end
        local result = self.group:adopt(owner)
        entry.value, entry.state = result, "ready"

        return result
    end

    function close(takes self): nil
        self.closed = true
        self.group:close()
    end
end

export function key<H is table, V>(build: function(host: H): managed(V)): Key<H, V>
    return new Key<H, V>(build = build)
end

export function scope<H is table>(host: H, limit: integer?): Scope<H>
    local maximum = limit or 256
    if maximum < 1 then
        error("resource extension limit must be positive", 2)
    end

    return new Scope<H>(
        host = host,
        group = nupp.managedGroup(),
        entries = {},
        limit = maximum,
        count = 0,
        active = 0,
        closed = false
    )
end
