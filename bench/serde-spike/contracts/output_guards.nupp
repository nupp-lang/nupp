local __serdeJson = require("serde.json")
local __serdeCodec = require("serde.codec")
local core = require("serde")
local documents = require("serde.document")
local errors = require("serde")
local json = require("serde.json")
local model = require("example.richmodel")
local text = require("string.buffer")

local binding = model.binding(model.newModel())
local codec = json.codec(model.policy(true))
local value = codec:decode(binding, '{"identifier":"cycle","created":0}')
value.next = value
local buffer = text.new()
buffer:put("prefix")

local function cyclic(): nil
    codec:encodeinto(binding, value, buffer)
end

local ok, problem = pcall(cyclic)
assert(not ok and getmetatable(problem) == errors.Error, tostring(problem))
assert((problem as errors.Error).code == "limit", tostring(problem))
assert(buffer:tostring() == "prefix")
value.next = nil

local record Custom is core.Atom
    @readonly family: table
    function snapshot(borrows self): core.Atom
        return Custom(family = self.family)
    end
end
value.document = documents.list({documents.atom(Custom(family = {}))})
local accepted, unsupported = pcall(codec.encode, codec, binding, value)
assert(not accepted and getmetatable(unsupported) == errors.Error)
local failure = unsupported as errors.Error
assert(failure.code == "unsupported")
assert(failure.path == '$["document"][1]', failure.path)
value.document = nil
assert(codec:encode(binding, value) == '{"identifier":"cycle","created":0}')
print("output limits bound cycles and document errors retain their containing logical paths")
