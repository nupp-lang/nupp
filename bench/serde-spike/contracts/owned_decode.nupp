const assert2 = require("assert")

local core = require("serde")
local codec = require("serde.json")
local plans = require("serde.json")
local json = require("serde.json")

local record Counts
    created: integer = 0
    closed: integer = 0
end
local record Resource is own.Closeable
    @readonly counts: Counts
    text: string
    function close(takes self): nil
        self.counts.closed += 1
    end
end
local record Member is core.Member
    @readonly name: string
    @readonly index: integer?
end
local record Description is core.Description<Member>
    @readonly member: Member
    @readonly kind: core.Kind = "string"
    @readonly nullable: boolean = false
    @readonly width: integer?
    @readonly signed: boolean?
    @readonly canread: boolean = true
    @readonly children: {core.Child<Member>} = {}
end
local record Adapter is core.Adapter<Resource, Member>
    @readonly counts: Counts
    @readonly description: Description
    @readonly fail: boolean
    @readonly consume: boolean = true
    function describe(self, direction: core.Direction): core.Description<Member>
        return self.description
    end

    function write(self, borrows value: Resource, exclusive writer: core.Writer<Member>): nil
        writer:writestring(self.description.member, value.text)
    end

    function read(self, exclusive reader: core.Reader<Member>): Resource
        self.counts.created += 1
        local result = Resource(counts = self.counts, text = "")
        if self.consume then
            result.text = reader:readstring(self.description.member)
        end
        assert2(not self.fail, "model rejected the value")

        return result
    end
end
local record Policy<M is core.Member> is plans.Policy<M>
    function name(self, member: M): string
        return member.name
    end

    function select(self, member: M, direction: core.Direction): plans.Selection
        return "traverse"
    end

    function timestamp(self, member: M, borrows value: core.Timestamp): json.EncodedValue
        error("no timestamp mapping", 2)
    end

    function parsetimestamp(self, member: M, text: string, kind: "string" | "number"): core.Timestamp
        error("no timestamp mapping", 2)
    end
end
local record Factory is plans.PolicyFactory
    function policy<M is core.Member>(self, member: M): plans.Policy<M>
        return Policy<M>()
    end
end

local counts = Counts()
local member = Member(name = "resource")

local function binding(fail: boolean): core.Binding<Resource>
    return core.OwnedBound<Resource, Member>(
        drop = function(takes value: Resource): nil
            value:close()
        end,
        adapter = Adapter(counts = counts, description = Description(member = member), fail = fail)
    )
end

local jsonCodec = codec.codec(Factory())
local accepted = binding(false)
do
    local resource = jsonCodec:decode(accepted, '"kept"')
    assert2(resource.text == "kept")
    assert2(jsonCodec:encode(accepted, resource) == '"kept"')
end
assert2(counts.created == 1 and counts.closed == 1)

local function decodeAndClose(selected: core.Binding<Resource>, input: string): nil
    local resource = jsonCodec:decode(selected, input)
    resource:close()
end

assert2(not pcall(decodeAndClose, accepted, '"value" trailing'))
assert2(counts.created == 2 and counts.closed == 2)
assert2(not pcall(decodeAndClose, binding(true), '"value"'))
assert2(counts.created == 3 and counts.closed == 3)
print("owning decode results transfer cleanup and aborted construction closes exactly once")

local record Field is core.Child<Member>
    @readonly member: Member
    @readonly target: core.Description<Member>
    @readonly required: boolean = true
    @readonly hasdefault: boolean = false
    function describe(self, direction: core.Direction): core.Description<Member>
        return self.target
    end
end
local record ReadField is core.MemberConsumer<Member, Resource>
    function apply(self, exclusive state: Resource, field: Member, exclusive reader: core.Reader<Member>): nil
        state.text = reader:readstring(field)
    end
end
local record SkipField is core.UnknownConsumer<Resource>
    function apply<F is core.WireField>(
        self,
        exclusive state: Resource,
        field: F,
        exclusive reader: core.UnknownReader
    ): nil
        reader:skipvalue()
    end
end
local readField, skipField = ReadField(), SkipField()
local record Aggregate is core.Adapter<Resource, Member>
    @readonly counts: Counts
    @readonly description: Description
    function describe(self, direction: core.Direction): core.Description<Member>
        return self.description
    end

    function write(self, borrows value: Resource, exclusive writer: core.Writer<Member>): nil
        error("encode not used by this construction fixture")
    end

    function read(self, exclusive reader: core.Reader<Member>): Resource
        self.counts.created += 1
        local result = Resource(counts = self.counts, text = "")
        reader:readstruct(self.description.member, result, readField, skipField)
        assert2(result.text ~= "", "required text")

        return result
    end
end
local textMember = Member(name = "text", index = 1)
local aggregate: core.Binding<Resource> = core.OwnedBound<Resource, Member>(
    drop = function(takes value: Resource): nil
        value:close()
    end,
    adapter = Aggregate(
        counts = counts,
        description = Description(
            member = member,
            kind = "structure",
            children = {Field(member = textMember, target = Description(member = textMember))}
        )
    )
)
do
    local result = jsonCodec:decode(aggregate, '{"text":"aggregate"}')
    assert2(result.text == "aggregate")
end
assert2(counts.created == 4 and counts.closed == 4)
assert2(not pcall(decodeAndClose, aggregate, '{"text":"partial","unknown":[}'))
assert2(counts.created == 5 and counts.closed == 5)
assert2(not pcall(decodeAndClose, aggregate, '{}'))
assert2(counts.created == 6 and counts.closed == 6)
print("aggregate callbacks borrow owning construction state exclusively")

local before = counts.closed
local unconsumed: core.Binding<Resource> = core.OwnedBound<Resource, Member>(
    drop = function(takes value: Resource): nil
        value:close()
    end,
    adapter = Adapter(counts = counts, description = Description(member = member), fail = false, consume = false)
)
assert2(not pcall(decodeAndClose, unconsumed, '"ignored"'))
assert2(counts.closed == before + 1 and counts.closed == counts.created, "JSON publication leaked an owned result")
