const assert2 = require("assert")

local __serdeJson = require("serde.json")
local declarations = require("serde")
local debug = require("serde.debug")
local json = require("serde.json")
local record Credentials
    user: string
    @debug(redact = true)
    password: string
    @debug(skip = true)
    cache: function(): nil
    @debug(redact = true)
    callback: function(): nil
end
local binding = declarations.binding(Credentials)
local value = Credentials(
    user = "ada",
    password = "secret",
    cache = function(): nil
        error("skipped callback was used")
    end,
    callback = function(): nil
        error("redacted callback was used")
    end
)
local expected = 'Credentials { user = "ada", password = <redacted>, callback = <redacted> }'
assert2(debug.render(binding, value) == expected)
assert2(
    not pcall(function()
        return json.codec(__serdeJson.defaultpolicy):encode(binding, value)
    end)
)
assert2(debug.render(binding, value) == expected)
local buffer = io.Buffer.create()
buffer:setstring("prefix:", buffer:len())
debug.write(binding, value, buffer)
assert2(buffer:getstring() == "prefix:" .. expected)
local record Other
    name: string
    @debug(skip = true)
    ignored: function(): nil
end
local other = declarations.binding(Other)
local instance = Other(name = "second", ignored = function(): nil
end)
assert2(
    not pcall(function()
        return json.codec(__serdeJson.defaultpolicy):encode(other, instance)
    end)
)
assert2(debug.render(other, instance) == 'Other { name = "second" }')
local record Node
    name: string
    next: Node?
end
local nodes = declarations.binding(Node)
local cycle = Node(name = "root")
cycle.next = cycle
assert2(debug.render(nodes, cycle) == 'Node { name = "root", next = <cycle> }')
local record Pair
    first: Node
    second: Node
end
local leaf = Node(name = "shared")
local rendered = debug.render(declarations.binding(Pair), Pair(first = leaf, second = leaf))
assert2(not rendered:find("<cycle>", 1, true))
local record Wide
    signed: int64
    unsigned: uint64
end
assert2(
    debug.render(
        declarations.binding(Wide),
        Wide(signed = -7LL, unsigned = 9ULL)
    ) == "Wide { signed = -7LL, unsigned = 9ULL }"
)

local record Custom is types.Debug
    value: integer
    function debug(self): string
        return "CUSTOM(" .. self.value .. ")"
    end
end
local record Nested
    custom: Custom
    list: {Custom}
end
local customized = Custom(value = 7)
assert2(
    debug.render(
        debug.binding(Nested),
        Nested(custom = customized, list = {customized})
    ) == "Nested { custom = CUSTOM(7), list = {CUSTOM(7)} }"
)
local record Printable
    value: types.Debug
end
assert2(debug.render(debug.binding(Printable), Printable(value = customized)) == "Printable { value = CUSTOM(7) }")
assert2(
    not pcall(function()
        return json.codec(__serdeJson.defaultpolicy)
            :encode(declarations.binding(Printable), Printable(value = customized))
    end)
)

local record Box<T is types.Debug>
    value: T
end
assert2(debug.derived(Box as Type<unknown>, Box<Custom>(value = customized)) == "Box { value = CUSTOM(7) }")

local record MapOwner
    values: {[integer]: string}
end
assert2(
    debug.render(
        declarations.binding(MapOwner),
        MapOwner(values = {[2] = "two", [10] = "ten"})
    ) == 'MapOwner { values = {[10LL] = "ten", [2LL] = "two"} }'
)
