local __serdeJson = require("nupp.serde.json")
local model = require("example.richmodel")
local core = require("nupp.serde")
local json = require("nupp.serde.json")
local schema = model.newModel()
local binding = model.binding(schema)
local first, second = json.codec(model.policy(true)), json.codec(model.policy(false))
-- The first operation is decode: no model value exists to inspect while the
-- codec resolves members, names, recursive edges, and construction support.
local cold = first:decode(binding, [[{"identifier":"cold","created":0}]])
assert(cold.id == "cold" and cold.created.seconds == "0")
local value = new model.Packet(id = "abc", created = new core.Timestamp(seconds = "1700000000", nanos = 0))
local encoded = first:encode(binding, value)
assert(encoded == [[{"identifier":"abc","created":1700000000}]])
local decoded = first:decode(binding, encoded)
assert(decoded.id == "abc" and decoded.created.seconds == "1700000000" and decoded.note == nil)
assert(second:encode(binding, value) == [[{"id":"abc","created":"2023-11-14T22:13:20Z"}]])
print("rich binding round-trip passed")

local indexed = model.indexed(schema)
local slots = model.indexedValue(schema, value.id, value.created)
assert(first:encode(indexed, slots) == encoded)
local restored = first:decode(indexed, encoded)
assert(first:encode(indexed, restored) == encoded)
assert(
    not pcall(function(): nil
        local foreign = model.indexedValue(model.newModel(), value.id, value.created)
        first:encode(indexed, foreign)
    end)
)

local fractional = new model.Packet(id = "fraction", created = new core.Timestamp(seconds = "-1", nanos = 123456789))
for _, profile in ipairs({first, second}) do
    local bytes = profile:encode(binding, fractional)
    local actual = profile:decode(binding, bytes)
    assert(actual.created.seconds == "-1" and actual.created.nanos == 123456789)
end

local documents = require("nupp.serde.document")
local withDocument = new model.Packet(
    id = "doc",
    created = value.created,
    document = documents.object({
        new documents.Entry(
            name = "items",
            value = documents.list({
                documents.null(),
                documents.numberToken("123456789012345678901234567890"),
                documents.string("last")
            })
        )
    })
)
local documentBytes = first:encode(binding, withDocument)
local documentValue = first:decode(binding, documentBytes)
local items = assert(assert(documentValue.document):get("items"))
assert(items:size() == 3 and items:at(1).kind == "null")
assert(items:at(2):numberToken() == "123456789012345678901234567890")
assert(first:encode(binding, documentValue) == documentBytes)

local timestamps = require("nupp.serde.codec")
for _, seconds in ipairs({"900719925474099312345", "-900719925474099312345", "-1", "0"}) do
    local stamp = new core.Timestamp(seconds = seconds, nanos = 123456789)
    local actual = timestamps.parseEpoch(timestamps.formatEpoch(stamp))
    assert(actual.seconds == seconds and actual.nanos == stamp.nanos)
end

local debug = require("nupp.serde.debug")
local child = new model.Packet(id = "child", created = value.created, choice = model.knownChoice("known"))
local parent = new model.Packet(
    id = "parent",
    created = value.created,
    next = child,
    labels = {[0] = "zero", [-2] = "negative", [2147483647] = "max"}
)
for _, profile in ipairs({first, second}) do
    local bytes = profile:encode(binding, parent)
    local actual = profile:decode(binding, bytes)
    assert(actual.labels ~= nil and actual.labels[-2] == "negative" and actual.labels[2147483647] == "max")
    assert(actual.next ~= nil and actual.next.id == "child")
    assert(profile:encode(binding, actual) == bytes)
    local indexed = profile:decode(model.indexed(schema), bytes)
    assert(profile:encode(model.indexed(schema), indexed) == bytes)
    assert(debug.render(binding, actual) == debug.render(model.indexed(schema), indexed))
end

local unknownBytes = [[{"identifier":"unknown","created":0,"choice":{"future":{"exact":999999999999999999999999}}}]]
local unknownValue = first:decode(binding, unknownBytes)
assert(unknownValue.choice ~= nil and unknownValue.choice:unknownField() ~= nil)
assert(assert(assert(unknownValue.choice:unknownValue()):get("exact")):numberToken() == "999999999999999999999999")
assert(first:encode(binding, unknownValue) == unknownBytes)
assert(
    not pcall(function()
        return second:encode(binding, unknownValue)
    end)
)
for _, bytes in ipairs({
    [[{"identifier":"x","created":0,"choice":{}}]],
    [[{"identifier":"x","created":0,"choice":{"text":"known","future":null}}]],
    [[{"identifier":"x","created":0,"choice":{"future":null,"other":null}}]],
    [[{"identifier":"x","created":0,"labels":{"0":"one","-0":"two"}}]],
    [[{"identifier":"x","created":0,"labels":{"2147483648":"overflow"}}]],
}) do
    assert(
        not pcall(function()
            return first:decode(binding, bytes)
        end)
    )
end
assert(
    not pcall(function(): unknown
        return first:decode(model.binding(model.newModel(true)), "{}")
    end)
)
assert(
    not pcall(function(): string
        return first:encode(model.binding(model.newModel(true)), value)
    end)
)
assert(second:encode(model.binding(model.newModel(true)), value) == second:encode(binding, value))
print("maps, recursion, unknown unions, and model-blind traversal passed")
