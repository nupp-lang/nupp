const assert2 = require("assert")

local __serdeJson = require("serde.json")
local declarations = require("serde")
local json = require("serde.json")

local record Text
    value: string
end
local record Wide
    value: uint64
end
local text = declarations.binding(Text)
local wide = declarations.binding(Wide)
local codec = json.codec(__serdeJson.defaultPolicy)
local original: any = _G.require
-- Where the exact carrier is the FFI, a target without it refuses 64-bit
-- declarations before reading. The VM carries them natively.
if pcall(original, "ffi") then
    _G.require = function(name: string): any
        if name == "ffi" then
            error("FFI unavailable")
        end
        return original(name)
    end
    local ok, result = pcall(function(): nil
        assert2(codec:decode(text, '{"value":"portable"}').value == "portable")
        local accepted, problem = pcall(codec.decode, codec, wide, "invalid input")
        assert2(not accepted and tostring(problem):find("no exact 64-bit carrier", 1, true))
    end)
    _G.require = original
    assert2(ok, tostring(result))
end
assert2(codec:decode(text, '{"value":"portable"}').value == "portable")
assert2(not pcall(codec.decode, codec, wide, "invalid input"))

local record Owned is own.Closeable
    value: string
    function close(takes self): nil
    end
end
-- An explicit witness cast must not turn an owning construction into an
-- ordinary copyable result. The descriptor retains the semantic capability.
local erased = Owned as Type<unknown>
local owning = declarations.binding(erased)
assert2(not pcall(json.decode, owning, '{"value":"owned"}'))
