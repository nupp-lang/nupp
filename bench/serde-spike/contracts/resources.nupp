local resources = require("nupp.serde.resources")
local record Host
    calls: integer
    closes: integer
end
local record Resource is nupp.Closeable
    @readonly host: Host
    @readonly value: integer
    closed: boolean
    function close(takes self): nil
        assert(not self.closed, "resource closed twice")
        self.closed = true
        self.host.closes += 1
    end
end
local host = new Host(calls = 0, closes = 0)
local key = resources.key(function(host: Host): managed(Resource)
    host.calls += 1
    return nupp.manage(new Resource(host = host, value = 42, closed = false))
end)
local scope = resources.scope(host)
local first = scope:get(key)
local second = scope:get(key)
assert(first == second and host.calls == 1)
local result, problem = first:with(function(borrows value: Resource): integer
    return value.value
end)
assert(result == 42 and problem == nil)
scope:close()
assert(host.closes == 1)
local expired, reason = second:with(function(borrows value: Resource): integer
    return value.value
end)
assert(expired == nil and reason ~= nil)
print("resource extension scope passed")
