const core = require("contract.dispatch")
const render = require("contract.render")
const model = require("example.model")
const other = require("example.other")

local record Stored
    binding: core.Binding<string>
end

local schema = new model.Schema(name = "text", wireName = "wire_text")
local first = new Stored(binding = model.binding(schema))
local second = new Stored(binding = other.binding())
assert(render.render(first.binding, "hello") == "text=hello")
assert(render.render(second.binding, "hello") == "other=hello")
assert(render.render(first.binding, "again") == "text=again")

return true
