const assert2 = require("assert")

local files = require("io.files")
local serde = require("serde")
local json = require("serde.json")

-- Config file
local record Config
    volume: integer = 50
    muted: boolean = false
end
local configFile = assert2(files.tmpfile())
local configPath = configFile:path()
assert2(files.writeatomic(configPath, '{"volume":20}'))
local configBinding = serde.binding(Config)
local configInput = assert2(io.open(configPath, "rb"))
local configBytes = assert2(configInput:read("*a"))
local config = json.decode(configBinding, configBytes)
config.volume = 75
assert2(files.writeatomic(configPath, json.encode(configBinding, config)))
local savedInput = assert2(io.open(configPath, "rb"))
local savedConfig = assert2(savedInput:read("*a"))
assert2(json.decode(configBinding, savedConfig).volume == 75)

-- Nested HTTP response
local record User
    id: uint32
    name: string
end
local record Response
    user: User
    roles: {string}
end
local responseBinding = serde.binding(Response)
local response = json.decode(responseBinding, '{"user":{"id":17,"name":"Ada"},"roles":["editor"]}')
assert2(response.user.name == "Ada" and response.roles[1] == "editor")

-- Game save
local native = require("serde.native")
local record Save
    level: integer
    inventory: {string}
end
local saveFile = assert2(files.tmpfile())
local savePath = saveFile:path()
local saveBinding = serde.binding(Save)
local save = Save(level = 12, inventory = {"key", "map"})
assert2(files.writeatomic(savePath, native.encode(saveBinding, save)))
local saveInput = assert2(io.open(savePath, "rb"))
local saveBytes = assert2(saveInput:read("*a"))
local restored = native.decode(saveBinding, saveBytes)
assert2(restored.level == 12 and restored.inventory[2] == "map")
