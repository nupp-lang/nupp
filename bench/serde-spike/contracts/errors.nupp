local errors = require("nupp.serde.errors")
local syntax = require("nupp.serde.jsonsyntax")
local codec = require("nupp.serde.json")
local model = require("example.richmodel")
local schema = model.newModel()
local binding, profile = model.binding(schema), model.policy(true)
local input = '{"identifier":42,"created":0}'
local ok, problem = pcall(codec.decode, binding, input, profile)
assert(not ok and getmetatable(problem) == errors.Error)
local diagnostic = problem as errors.Error
assert(diagnostic.code == "syntax")
assert(diagnostic.path == '$["id"]')
assert(diagnostic.byte == input:find("42", 1, true))

local validSyntax = '{"identifier":"ok","created":"not an epoch"}'
local success, failure = pcall(codec.decode, binding, validSyntax, profile)
assert(not success and getmetatable(failure) == errors.Error)
local conversion = failure as errors.Error
assert(conversion.code == "model" and conversion.path == '$["created"]')
assert(conversion.cause ~= nil and conversion.byte ~= nil)

local function limited(input: string, limits: syntax.Limits): nil
    local reader = syntax.reader(input, nil, nil, limits)
    reader:skipValue()
    reader:finish()
end

for _, value in ipairs({
    {input = '"abcdef"', limits = new syntax.Limits(tokenBytes = 3)},
    {input = '[0,1]', limits = new syntax.Limits(aggregateEntries = 1)},
    {input = '[0]', limits = new syntax.Limits(inputBytes = 2)},
}) do
    local accepted, refused = pcall(limited, value.input, value.limits)
    assert(not accepted and getmetatable(refused) == errors.Error)
    assert((refused as errors.Error).code == "limit")
end
print("codec errors retain logical member paths, byte offsets, causes, and explicit limits")
