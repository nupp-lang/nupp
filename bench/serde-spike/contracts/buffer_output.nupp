local core = require("nupp.serde.value")
local documents = require("nupp.serde.document")
local codec = require("nupp.serde.json")
local model = require("example.richmodel")
local text = require("nupp.text")

local binding = documents.documentAdapter():contents()
local profile = model.policy(true)
local buffer = text.newBuffer()
buffer:put("prefix:")
codec.encodeInto(binding, documents.string("ok"), buffer, profile)
assert(buffer:tostring() == 'prefix:"ok"')
local record Unsupported is core.Atom
    @readonly family: table
    function snapshot(borrows self): core.Atom
        return new Unsupported(family = self.family)
    end
end
local value = documents.list({documents.string("already written"), documents.atom(new Unsupported(family = {}))})

local function write(): nil
    codec.encodeInto(binding, value, buffer, profile)
end

assert(not pcall(write))
assert(buffer:tostring() == 'prefix:"ok"')
codec.encodeInto(binding, documents.null(), buffer, profile)
assert(buffer:tostring() == 'prefix:"ok"null')
print("direct Buffer output rolls back partial writes and remains reusable")

local syntax = require("nupp.codec.json")
local embedded = text.newBuffer()
local sink = syntax.newWriter(embedded)
sink:startObject()
sink:key("items")
sink:startArray()
codec.writeValue(binding, documents.string("one"), sink)
codec.codec():writeValue(binding, documents.null(), sink)
sink:endArray()
sink:endObject()
sink:close()
assert(embedded:tostring() == '{"items":["one",null]}')
