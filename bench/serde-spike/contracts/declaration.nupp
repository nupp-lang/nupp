local __serdeJson = require("nupp.serde.json")
local declarations = require("nupp.serde")
local codecs = require("nupp.serde.json")

local record Address
    city: string
    postalCode: string = "unknown"
end
local record User
    id: uint32
    address: Address
    nickname: string?
end
local binding = declarations.binding(User)
assert(binding == declarations.binding(User))
local codec = codecs.codec(__serdeJson.defaultPolicy)
local restored = codec:decode(binding, '{"id":7,"address":{"city":"Chicago"},"nickname":null}')
assert(restored.id == 7 and restored.address.city == "Chicago" and restored.address.postalCode == "unknown")
assert(getmetatable(restored) == User and getmetatable(restored.address) == Address)
assert(
    codec:encode(binding, restored) == '{"id":7,"address":{"city":"Chicago","postalCode":"unknown"},"nickname":null}'
)

for _, input in ipairs({
    '{"id":-1,"address":{"city":"Chicago"}}',
    '{"id":7,"address":{}}',
    '{"id":7,"address":{"city":"Chicago"},"other":true}',
    '{"id":7,"address":{"city":"Chicago"}} trailing'
}) do
    assert(not pcall(codec.decode, codec, binding, input), input)
end

local record Link
    value: integer
    next: Link?
end
local links = declarations.binding(Link)
local chain = codec:decode(links, '{"value":1,"next":{"value":2,"next":null}}')
assert(chain.value == 1 and assert(chain.next).value == 2)
assert(codec:encode(links, chain) == '{"value":1,"next":{"value":2,"next":null}}')

local count = 0
local record Validated
    text: string
    constructor(self, text: string)
        assert(text ~= "bad", "constructor validation")
        count += 1
        self.text = text
    end
end
local validated = declarations.binding(Validated)
assert(codec:decode(validated, '{"text":"ok"}').text == "ok" and count == 1)
assert(not pcall(codec.decode, codec, validated, '{"text":"bad"}'))
assert(count == 1)

local record Containers
    names: {string}
    coordinates: {number, number}
    counts: {[string]: integer}
    signed: int64
    unsigned: uint64
end
local containers = declarations.binding(Containers)
local sample = codec:decode(
    containers,
    '{"names":["a","b"],"coordinates":[1.5,2.5],"counts":{"a":4},"signed":-9223372036854775808,"unsigned":18446744073709551615}'
)
assert(sample.names[2] == "b" and sample.coordinates[1] == 1.5 and sample.counts["a"] == 4)
assert(sample.signed == -9223372036854775808LL and sample.unsigned == 18446744073709551615ULL)
local encoded = codec:encode(containers, sample)
assert(encoded:find('"signed":-9223372036854775808', 1, true))
assert(encoded:find('"unsigned":18446744073709551615', 1, true))
assert(codec:decode(containers, encoded).unsigned == sample.unsigned)

local record Enumerated
    state: "ready" | "done"
    number: 1 | 2
    optional: "left" | "right" | nil
    entries: {"one" | "two"}
end
local enumerated = declarations.binding(Enumerated)
local enumValue = codec:decode(enumerated, '{"state":"ready","number":2,"optional":null,"entries":["two"]}')
assert(enumValue.state == "ready" and enumValue.number == 2 and enumValue.optional == nil)
assert(codec:decode(enumerated, codec:encode(enumerated, enumValue)).entries[1] == "two")
for _, input in ipairs({
    '{"state":"unknown","number":1,"entries":[]}',
    '{"state":"done","number":3,"entries":[]}',
    '{"state":"done","number":1,"optional":"up","entries":[]}',
    '{"state":"done","number":1,"entries":["three"]}'
}) do
    assert(not pcall(codec.decode, codec, enumerated, input), input)
end

local record Shaped
    point: {
        x: number,
        y: number,
        label: string?
    }
    nested: {{active: boolean}}
end
local shaped = declarations.binding(Shaped)
local point = codec:decode(shaped, '{"point":{"x":1.5,"y":2.5},"nested":[{"active":true}]}')
assert(point.point.x == 1.5 and point.point.label == nil and point.nested[1].active)
assert(codec:decode(shaped, codec:encode(shaped, point)).point.y == 2.5)
for _, input in ipairs({
    '{"point":{"x":1},"nested":[]}',
    '{"point":{"x":1,"y":2,"extra":true},"nested":[]}',
    '{"point":{"x":"wrong","y":2},"nested":[]}',
    '{"point":{"x":1,"y":2},"nested":[{}]}'
}) do
    assert(not pcall(codec.decode, codec, shaped, input), input)
end
