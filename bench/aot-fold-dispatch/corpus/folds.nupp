local function affine(value: number, scale: number, offset: number): number
    return value * scale + offset
end

@aot
local function scalar(value: number): number
    return affine(value, 2.5, 0.25) + (9.0 - 4.0)
end

@aot
local function fixed(left: int32, right: uint32): number
    local signed = nupp.math.i32.add(left, nupp.math.i32.wrap(7))
    local unsigned = nupp.math.u32.add(right, nupp.math.u32.wrap(3))
    return signed + unsigned
end

@aot
local function propagated(value: number): number
    local scale = 4.0
    local shifted = scale + 0.5
    return value * shifted
end

local function double(value: uint32): uint32
    return nupp.math.u32.add(value, value)
end

@aot
local function specialized(value: uint32): uint32
    return nupp.math.u32.add(double(nupp.math.u32.wrap(21)), value)
end

@aot
local function unrolled(value: number): number
    local total = value
    for i = 1, 3 do
        total = total + i
    end
    return total
end

return {
    scalar = scalar,
    fixed = fixed,
    propagated = propagated,
    specialized = specialized,
    unrolled = unrolled,
}
