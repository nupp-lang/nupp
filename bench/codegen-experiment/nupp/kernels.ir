  let species:simd_species_f64_fixed4 = simd_species.species:simd_species_f64_fixed4()
  var accumulator:simd_vector_f64_fixed4 = simd_splat.splat:simd_vector_f64_fixed4(constant:f64 0.0)
  var cursor:u32 = numeric_cast(constant:f64 0)
  while and(le(u64_add(numeric_cast(local:u32 cursor), numeric_cast(simd_lanes_generic.lanes:u32(local:simd_species_f64_fixed4 species))), count left), le(u64_add(numeric_cast(local:u32 cursor), numeric_cast(simd_lanes_generic.lanes:u32(local:simd_species_f64_fixed4 species))), count right)) carrying accumulator:simd_vector_f64_fixed4, cursor:u32
    set accumulator = simd_binary.add:simd_vector_f64_fixed4(local:simd_vector_f64_fixed4 accumulator, simd_binary.mul:simd_vector_f64_fixed4(simd_load.load:simd_vector_f64_fixed4(local:simd_species_f64_fixed4 species, int_to_f64(u32_add(local:u32 cursor, constant:u32 1)), span:left), simd_load.load:simd_vector_f64_fixed4(local:simd_species_f64_fixed4 species, int_to_f64(u32_add(local:u32 cursor, constant:u32 1)), span:right)))
    set cursor = u32_add(local:u32 cursor, simd_lanes_generic.lanes:u32(local:simd_species_f64_fixed4 species))
  end
  if lt(local:u32 cursor, count left)
    let active:simd_mask_f64_fixed4 = simd_tail.tail:simd_mask_f64_fixed4(numeric_cast(sub(count left, int_to_f64(local:u32 cursor))))
    set accumulator = simd_binary.add:simd_vector_f64_fixed4(local:simd_vector_f64_fixed4 accumulator, simd_binary.mul:simd_vector_f64_fixed4(simd_load.load:simd_vector_f64_fixed4(local:simd_species_f64_fixed4 species, int_to_f64(u32_add(local:u32 cursor, constant:u32 1)), local:simd_mask_f64_fixed4 active, span:left), simd_load.load:simd_vector_f64_fixed4(local:simd_species_f64_fixed4 species, int_to_f64(u32_add(local:u32 cursor, constant:u32 1)), local:simd_mask_f64_fixed4 active, span:right)))
  end
  return simd_horizontal.algebraic_sum:f64(local:simd_vector_f64_fixed4 accumulator)
