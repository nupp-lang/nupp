local span = require("nupp.mem.span")
local array = require("nupp.mem.array")
local simd = require("nupp.simd")

local scanner = {}

const scanner.QUOTE = 1
const scanner.BACKSLASH = 2
const scanner.STRUCTURAL = 4
const scanner.WHITESPACE = 8
const scanner.CONTROL = 16

--- UTF-8 byte classes occupy the high three bits of each flag. JSON syntax
--- occupies the low five, so one SIMD pass can classify both without growing
--- the scratch buffer.
const scanner.UTF8_CONTINUATION = 32

const scanner.UTF8_LEAD2 = 64
const scanner.UTF8_LEAD3 = 96
const scanner.UTF8_LEAD4 = 128
const scanner.UTF8_INVALID = 160

--- Classifies every input byte before the recursive parser sees it.
---
--- Explicit byte vectors classify full groups; the scalar loop handles the tail
--- and also runs when AOT is off.
@aot
local function classify(exclusive flags: span.WriteSpan<uint8>, borrows bytes: span.Span<uint8>): nil
    if #flags ~= #bytes then
        error("length mismatch", 2)
    end

    local cursor: uint32 = 0
    if species = simd.species(array.uint8) then
        while cursor + species.lanes <= #bytes do
            local byte = species:load(bytes, cursor + 1)
            local flag = (byte < 32):select(16, 0)
            flag = (byte == 34):select(1, flag)
            flag = (byte == 92):select(2, flag)
            flag = (byte == 123):select(4, flag)
            flag = (byte == 125):select(4, flag)
            flag = (byte == 91):select(4, flag)
            flag = (byte == 93):select(4, flag)
            flag = (byte == 58):select(4, flag)
            flag = (byte == 44):select(4, flag)
            flag = (byte == 32):select(8, flag)
            flag = (byte == 9):select(8, flag)
            flag = (byte == 10):select(8, flag)
            flag = (byte == 13):select(8, flag)
            flag = (byte >= 128):select(160, flag)
            flag = ((byte >= 128) & (byte <= 191)):select(32, flag)
            flag = ((byte >= 194) & (byte <= 223)):select(64, flag)
            flag = ((byte >= 224) & (byte <= 239)):select(96, flag)
            flag = ((byte >= 240) & (byte <= 244)):select(128, flag)
            species:store(flags, cursor + 1, flag)
            cursor = cursor + species.lanes
        end
    end

    while cursor < #bytes do
        local byte = bytes[cursor + 1]
        local flag: uint32 = switch byte do
            case 34 -> 1
            case 92 -> 2
            case 123, 125, 91, 93, 58, 44 -> 4
            case 32, 9, 10, 13 -> 8
            else -> 0
        end

        if flag == 0 and byte < 32 then
            flag = 16
        elseif byte >= 128 then
            if byte <= 191 then
                flag = 32
            elseif byte <= 193 then
                flag = 160
            elseif byte <= 223 then
                flag = 64
            elseif byte <= 239 then
                flag = 96
            elseif byte <= 244 then
                flag = 128
            else
                flag = 160
            end
        end
        if cursor < #flags then
            flags[cursor + 1] = flag
        end
        cursor = cursor + 1
    end
end

scanner.classify = classify

return scanner
