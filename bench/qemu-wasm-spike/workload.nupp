local struct Particle
    x: number
    velocity: number
end

local function integrate(steps: integer): number
    local particle = new Particle(0, 0.5)
    for _ = 1, steps do
        particle.x = particle.x + particle.velocity
    end

    return particle.x
end

local result = integrate(1000000)
assert(result == 500000)
print("NUPP_STRUCT_OK", result)
return integrate
