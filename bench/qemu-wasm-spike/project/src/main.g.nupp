require("nupp.qemu.setup")
local runtime: any = _G
local config: any = runtime.__qemuConfig
if config.worker then
    return (require("nupp.workers") as any).__runScheduler()
end
if config.mode == "workers" then
    return require("workerchecks").run()
end
local checks = require("nupp.qemu.checks")
if config.mode == "failure" then
    error("intentional guest failure", 0)
end
if config.mode == "busy" then
    return checks.busy()
end
if config.mode == "deadline" then
    return checks.deadline()
end
if config.mode == "persistence" then
    return checks.persistence()
end
if config.mode == "gpu" then
    return checks.gpu()
end
if config.mode == "game" then
    return checks.game()
end
local report: any = {platform = checks.platform(), transfers = checks.transfers(), http = checks.http(config.base)}
return report
