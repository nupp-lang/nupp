module nupp.qemu.setup

local services = require("nupp.services")
local contracts = require("nupp.runtime.services.contracts")
local runtime: any = _G

local function select(handle: any, loader: function(): any): nil
    handle:register("nupp.qemu", loader)
    handle:select("nupp.qemu")
end

select(contracts.cstorage, function(): any
    local storage: any = require("nupp.runtime.provider.nativestorage")
    storage.host = assert(runtime.__qemuMemory)
    return storage
end)
select(require("nupp.runtime.services.suspension").service, function(): any
    return require("nupp.qemu.browser.suspension")
end)
select(contracts.time, function(): any
    local provider: any = require("nupp.qemu.browser.time")
    provider.now = assert(runtime.__qemuNow)
    return provider
end)
select(contracts.crypto, function(): any
    return require("nupp.qemu.browser.crypto")
end)
select(contracts.uuid, function(): any
    return require("nupp.qemu.browser.crypto")
end)
select(contracts.storage, function(): any
    return require("nupp.qemu.browser.storage")
end)
select(require("nupp.runtime.services.http").service, function(): any
    return require("nupp.qemu.browser.http")
end)
select(require("nupp.runtime.services.gpu").service, function(): any
    return require("nupp.qemu.browser.webgpu.internal")
end)
select(require("nupp.runtime.services.workers").service, function(): any
    return require("nupp.qemu.browser.workers")
end)
select(require("nupp.runtime.services.system").service, function(): any
    local browser: any = require("nupp.qemu.browser.system")
    return {
        platform = "browser",
        architecture = "x64",
        pointerBits = 64,
        endianness = "little",
        availableParallelism = browser.availableParallelism
    }
end)
select(contracts.path, function(): any
    return require("nupp.qemu.browser.path")
end)
select(contracts.uri, function(): any
    return require("nupp.qemu.browser.uri")
end)
services.setupWorkers("nupp.qemu.setup")
export = {}
