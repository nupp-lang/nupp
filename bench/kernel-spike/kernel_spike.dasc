/*
 * Runtime-specialized native-kernel spike for Nupp.
 *
 * DynASM's ARM64 instruction table does not currently encode SIMD
 * instructions (dasm_arm64.lua says "TODO: SIMD instructions"). The NEON
 * instructions below therefore use .long while DynASM supplies labels,
 * relocation, assembly, and the runtime-specialized scalar emitter.
 */

#define _GNU_SOURCE
#define _DARWIN_C_SOURCE
#include <errno.h>
#include <math.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/mman.h>
#include <unistd.h>

#if !defined(__aarch64__) && !defined(__arm64__)
#error "the DynASM kernel spike currently supports ARM64 only"
#endif

#define DASM_CHECKS
#define DASM_FDEF static
#include "dasm_proto.h"
#include "dasm_arm64.h"

|.arch arm64
|.actionlist ks_actions
|.section code

typedef struct {
    float x;
    float y;
} KsPosition;

typedef struct {
    float x;
    float y;
} KsVelocity;

typedef struct {
    float x;
    float y;
    float z;
    int32_t layer;
    float rotation;
    float scale_x;
    float scale_y;
} KsTransform2D;

typedef void (*KsIntegrateFn)(
    KsPosition *positions,
    const KsVelocity *velocities,
    size_t count,
    float dt
);

typedef void (*KsAddFn)(void *base, size_t count, float delta);

typedef struct {
    void *memory;
    size_t mapped_size;
    size_t code_size;
} KsCode;

static KsCode ks_integrate_code;
static KsCode ks_add_code;
static KsIntegrateFn ks_integrate_entry;
static KsAddFn ks_add_entry;
static char ks_last_error[256];

static void ks_set_error(const char *operation, int status) {
    if (status != 0) {
        snprintf(
            ks_last_error,
            sizeof(ks_last_error),
            "%s failed with DynASM status 0x%x",
            operation,
            status
        );
    } else {
        snprintf(
            ks_last_error,
            sizeof(ks_last_error),
            "%s failed: %s",
            operation,
            strerror(errno)
        );
    }
}

static void ks_release_code(KsCode *code) {
    if (code->memory != NULL) {
        munmap(code->memory, code->mapped_size);
    }
    memset(code, 0, sizeof(*code));
}

static int ks_finish(dasm_State **state, KsCode *out) {
    size_t code_size = 0;
    int status = dasm_link(state, &code_size);
    if (status != 0) {
        ks_set_error("dasm_link", status);
        return 0;
    }

    long page_result = sysconf(_SC_PAGESIZE);
    if (page_result <= 0) {
        ks_set_error("sysconf", 0);
        return 0;
    }
    size_t page_size = (size_t)page_result;
    size_t mapped_size = (code_size + page_size - 1) & ~(page_size - 1);
    void *memory = mmap(
        NULL,
        mapped_size,
        PROT_READ | PROT_WRITE,
        MAP_PRIVATE | MAP_ANON,
        -1,
        0
    );
    if (memory == MAP_FAILED) {
        ks_set_error("mmap", 0);
        return 0;
    }

    status = dasm_encode(state, memory);
    if (status != 0) {
        munmap(memory, mapped_size);
        ks_set_error("dasm_encode", status);
        return 0;
    }

    __builtin___clear_cache((char *)memory, (char *)memory + code_size);
    if (mprotect(memory, mapped_size, PROT_READ | PROT_EXEC) != 0) {
        munmap(memory, mapped_size);
        ks_set_error("mprotect", 0);
        return 0;
    }

    out->memory = memory;
    out->mapped_size = mapped_size;
    out->code_size = code_size;
    return 1;
}

static void ks_emit_integrate(dasm_State **Dst) {
    /*
     * AAPCS64: positions=x0, velocities=x1, count=x2, dt=s0/v0.
     * Process four interleaved {x,y} records with ld2/st2, then use the
     * ordinary scalar DynASM vocabulary for the tail.
     */
    | cbz x2, >3
    | cmp x2, #4
    | blo >2
    /* dup v1.4s, v0.s[0] */
    |.long 0x4e040401
    |1:
    /* ld2 {v2.4s, v3.4s}, [x1], #32 */
    |.long 0x4cdf8822
    /* ld2 {v4.4s, v5.4s}, [x0] */
    |.long 0x4c408804
    /* fmla v4.4s, v2.4s, v1.4s */
    |.long 0x4e21cc44
    /* fmla v5.4s, v3.4s, v1.4s */
    |.long 0x4e21cc65
    /* st2 {v4.4s, v5.4s}, [x0], #32 */
    |.long 0x4c9f8804
    | sub x2, x2, #4
    | cmp x2, #4
    | bhs <1
    |2:
    | cbz x2, >3
    |1:
    | ldr s1, [x0]
    | ldr s2, [x1]
    | fmul s2, s2, s0
    | fadd s1, s1, s2
    | str s1, [x0]
    | ldr s1, [x0, #4]
    | ldr s2, [x1, #4]
    | fmul s2, s2, s0
    | fadd s1, s1, s2
    | str s1, [x0, #4]
    | add x0, x0, #8
    | add x1, x1, #8
    | subs x2, x2, #1
    | bne <1
    |3:
    | ret
}

static void ks_emit_add(dasm_State **Dst, uint32_t stride, uint32_t offset) {
    /* AAPCS64: base=x0, count=x1, delta=s0. Stride and field offset vanish. */
    | cbz x1, >2
    | add x0, x0, #offset
    |1:
    | ldr s1, [x0]
    | fadd s1, s1, s0
    | str s1, [x0]
    | add x0, x0, #stride
    | subs x1, x1, #1
    | bne <1
    |2:
    | ret
}

static int ks_compile_integrate(void) {
    dasm_State *state = NULL;
    void *globals[1] = {NULL};
    dasm_init(&state, DASM_MAXSECTION);
    dasm_setupglobal(&state, globals, 1);
    dasm_setup(&state, ks_actions);
    ks_emit_integrate(&state);
    int ok = ks_finish(&state, &ks_integrate_code);
    dasm_free(&state);
    if (ok) {
        ks_integrate_entry = (KsIntegrateFn)ks_integrate_code.memory;
    }
    return ok;
}

int ks_compile_add_f32(uint32_t stride, uint32_t offset) {
    if (
        stride < sizeof(float) ||
        stride > 4095 ||
        offset > stride - sizeof(float) ||
        stride % _Alignof(float) != 0 ||
        offset % _Alignof(float) != 0
    ) {
        snprintf(
            ks_last_error,
            sizeof(ks_last_error),
            "stride/offset must be aligned, fit a float, and use 12-bit immediates"
        );
        return 0;
    }

    KsCode replacement = {0};
    dasm_State *state = NULL;
    void *globals[1] = {NULL};
    dasm_init(&state, DASM_MAXSECTION);
    dasm_setupglobal(&state, globals, 1);
    dasm_setup(&state, ks_actions);
    ks_emit_add(&state, stride, offset);
    int ok = ks_finish(&state, &replacement);
    dasm_free(&state);
    if (!ok) {
        return 0;
    }

    ks_release_code(&ks_add_code);
    ks_add_code = replacement;
    ks_add_entry = (KsAddFn)ks_add_code.memory;
    return 1;
}

int ks_init(void) {
    if (ks_integrate_entry != NULL) {
        return 1;
    }
    return ks_compile_integrate();
}

void ks_shutdown(void) {
    ks_integrate_entry = NULL;
    ks_add_entry = NULL;
    ks_release_code(&ks_integrate_code);
    ks_release_code(&ks_add_code);
}

const char *ks_error(void) {
    return ks_last_error;
}

size_t ks_integrate_code_size(void) {
    return ks_integrate_code.code_size;
}

const void *ks_integrate_code_pointer(void) {
    return ks_integrate_code.memory;
}

size_t ks_add_code_size(void) {
    return ks_add_code.code_size;
}

__attribute__((noinline))
void ks_integrate_scalar(
    KsPosition *restrict positions,
    const KsVelocity *restrict velocities,
    size_t count,
    float dt
) {
    #pragma clang loop vectorize(disable) interleave(disable)
    for (size_t i = 0; i < count; ++i) {
        positions[i].x += velocities[i].x * dt;
        positions[i].y += velocities[i].y * dt;
    }
}

__attribute__((noinline))
void ks_integrate_auto(
    KsPosition *restrict positions,
    const KsVelocity *restrict velocities,
    size_t count,
    float dt
) {
    for (size_t i = 0; i < count; ++i) {
        positions[i].x += velocities[i].x * dt;
        positions[i].y += velocities[i].y * dt;
    }
}

void ks_integrate_dynasm(
    KsPosition *positions,
    const KsVelocity *velocities,
    size_t count,
    float dt
) {
    ks_integrate_entry(positions, velocities, count, dt);
}

__attribute__((noinline))
void ks_add_f32_scalar(
    void *base,
    size_t count,
    float delta,
    size_t stride,
    size_t offset
) {
    unsigned char *at = (unsigned char *)base + offset;
    #pragma clang loop vectorize(disable) interleave(disable)
    for (size_t i = 0; i < count; ++i) {
        float *field = (float *)at;
        *field += delta;
        at += stride;
    }
}

void ks_add_f32_dynasm(void *base, size_t count, float delta) {
    ks_add_entry(base, count, delta);
}

size_t ks_sizeof_position(void) {
    return sizeof(KsPosition);
}

size_t ks_sizeof_transform2d(void) {
    return sizeof(KsTransform2D);
}
