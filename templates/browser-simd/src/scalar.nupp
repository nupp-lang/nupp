local span = require("binary.span")
local array = require("nupp.array")
local json = require("serde.json")

local struct Sample
    value: number
    bias: number
    weight: number
end

@aot
local function scale(exclusive output: span.WriteSpan<Sample>, borrows input: span.Span<Sample>, factor: number): nil
    if #output ~= #input then
        error("length mismatch", 2)
    end
    for index = 1, #output do
        output[index].value = input[index].value * factor
        output[index].bias = input[index].bias + factor
        output[index].weight = input[index].weight + factor
    end
end

local input = array.newarray(Sample(), 4096)
local writable = input:write()
for index = 1, #writable do
    writable[index] = Sample(index, index * 2, index * 3)
end
own.drop(writable)

local output = array.newarray(Sample(), 4096)
scale(output:write(), input:read(), 2)
local rows = output:read()

local project = "${name}"
return json.encodevalue({project = project, tier = "scalar", first = rows[1].value, last = rows[#rows].weight,})
