const random = require("nupp.random")
const digests = require("binary.hash.digest")
const util = require("nupp.util")
const time = require("nupp.time")
const json = require("serde.json")

local started = time.now()
time.sleep(10)

local digest = digests.hexDigest("sha256", random.randomBytes(32))

return json.encodeValue({
    project = "${name}",
    elapsedMilliseconds = time.now() - started,
    digest = digest,
    identifier = util.uuid4(),
})
