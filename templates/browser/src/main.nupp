const digests = require("bytes").digest
const time = require("coroutine")
const json = require("serde.json")

local started = os.monotonic()
time.sleep(10)

local digest = digests("sha256"):computehex(os.randombytes(32))

return json.encodevalue({
    project = "${name}",
    elapsedMilliseconds = os.monotonic() - started,
    digest = digest,
    identifier = os.uuid(4),
})
