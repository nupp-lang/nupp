local random = require("nupp.random")
local digests = require("nupp.digest")
local uuid = require("nupp.util")
local time = require("nupp.time")
local json = require("nupp.codec.json")

local started = time.now()
time.sleep(10)

local digest = digests.hexDigest("sha256", random.randomBytes(32))

return json.encode({
    project = "${name}",
    elapsedMilliseconds = time.now() - started,
    digest = digest,
    identifier = uuid.uuid4(),
})
