.nupp/
/build/
/editors/playground/node_modules
/.rocks
/.nupp-cache/
# Local Claude Code state -- settings, locks -- but not the skills, which are
# repository procedure and belong with the workflows they describe. Spelled as
# contents-plus-exception rather than `.claude/`, because git cannot re-include
# anything under a directory it has already excluded.
.claude/*
!.claude/skills/
.DS_Store
scratch/
host/target/
vendor/
tests/build/
/src/**/*.lua
!/src/nupp/runtime/vendor/
!/src/nupp/runtime/vendor/lunajson/
!/src/nupp/runtime/vendor/lunajson/*.lua
_stage2/
_stage1/
/evals/results/
__pycache__/
