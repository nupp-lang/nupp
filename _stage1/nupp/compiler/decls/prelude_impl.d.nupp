end

-- Referencing each implementation as an affine terminal publishes its runtime
-- provider under the declaration identity sealed into prelude.d.nupp.
local type __NuppByteViewCleanup = affine(nupp.io.ByteView, __nuppDestroyByteView)
local type __NuppReaderCleanup = affine(nupp.io.Reader, __nuppDestroyReader)
local type __NuppWriterCleanup = affine(nupp.io.Writer, __nuppDestroyWriter)
local type __NuppBufferCleanup = affine(nupp.io.Buffer, __nuppDestroyBuffer)
local type __NuppFileCleanup = affine(nupp.io.Files.File, __nuppDestroyFile)
