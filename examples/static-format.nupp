-- string.format's prelude declaration computes its trailing parameter pack from a
-- literal format. Calls keep the ordinary Lua spelling and runtime behavior.

local name = 'Ada'
local count = string.format('%s has %d messages', name, 3)
local point = string.format('%s=(%.2f, %.2f)', 'point', 1.5, 2.5)
local escaped = string.format('100%% ready')

-- A runtime format cannot determine a static parameter list, so it deliberately
-- retains the gradual `...any` contract.
local dynamic: string = arg[1] or '%s'
local gradual = string.format(dynamic, name)

-- These each report at the ordinary call (left commented so the example checks):
-- string.format('%d', 'three') -- argument 2: string is not a number
-- string.format('%d') -- omitted argument 2 supplies nil, not number
-- string.format('%d', 1, 2) -- too many arguments (expected 2, got 3)
-- string.format('%z', 1) -- unsupported format directive %z

print(count, point, escaped, gradual)
