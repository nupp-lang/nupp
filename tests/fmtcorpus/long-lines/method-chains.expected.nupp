local m = {}

function m.render(report: any, endpoint: any): nil
    report:put("header"):putf("%s rows", 12):put("separator"):putf("%d columns", 4):put("footer"):put("done")
    local production = endpoint:withuserinfo(nil)
        :withhost("api.example.com")
        :withport(nil)
        :withquery(nil)
        :withfragment(nil)
    report:put(production)
end

return m
