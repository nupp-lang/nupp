@!internal
module nupp.tests.providers.suspension

--[[Behavioral vectors shared by scheduler and event-loop adapters.]]

local suite = {}

function suite.test(provider: any): (boolean, string?)
    local ok, problem = pcall(function()
        assert(not provider.handled(), "the isolated provider must begin without an installed handler")
        assert(provider.canSuspend(), "the unhandled blocking driver must permit suspension")

        local ready = provider.suspend("contract.ready", function(resume: function(string)): nil
            resume("ready")
        end)
        assert(ready == "ready", "a synchronous subscription must not park")

        local polled = 0
        local source = provider.source("contract.source", 1, function(): integer
            polled = polled + 1

            return 1
        end)
        assert(provider.poll() == 1 and polled == 1, "poll must drive registered readiness sources")
        source:release()
        assert(provider.poll() == 0 and polled == 1, "released sources must not run")

        local order = {}
        local first, skipped, added
        first = provider.source("contract.first", 10, function(): integer
            order[#order + 1] = "first"
            first:release()
            skipped:release()
            added = provider.source("contract.added", 5, function(): integer
                order[#order + 1] = "added"
                return 0
            end)

            return 0
        end)
        local middle = provider.source("contract.middle", 20, function(): integer
            order[#order + 1] = "middle"
            return 0
        end)
        skipped = provider.source("contract.skipped", 30, function(): integer
            order[#order + 1] = "skipped"
            return 0
        end)
        provider.poll()
        assert(
            table.concat(order, ",") == "first,middle",
            "a pass must exclude added sources and skip released sources"
        )
        order = {}
        provider.poll()
        assert(table.concat(order, ",") == "added,middle", "the next pass must restore stable poll order")
        added:release()
        middle:release()

        -- A coroutine created through the provider inherits the installed handler, so a
        -- park performed inside one -- a protected call's forwarder, a generated
        -- cleanup wrapper -- reaches the driver that owns the coroutine that made it,
        -- rather than the blocking fallback.
        local inheritedResume: any = nil
        local parkedInside: any = nil
        local inheriting = provider.install({
            park = function(_: any, waiting: any): nil
                parkedInside = coroutine.running()
                inheritedResume(7)
                assert(waiting:ready(), "the resumed subscription must report itself ready")
            end,
            canPark = function(): boolean
                return true
            end,
            shutdown = function(): nil
            end,
        })
        local child = provider.create(function(): any
            return provider.suspend("contract.inherited", function(resume: function(any)): function()
                inheritedResume = resume

                return function(): nil
                    inheritedResume = nil
                end
            end)
        end)
        local ranChild, produced = coroutine.resume(child)
        inheriting:close()
        assert(ranChild, tostring(produced))
        assert(produced == 7, "an inherited handler must answer a park made inside the coroutine")
        assert(parkedInside == child, "and must be reached from the coroutine that parked")

        -- `onResume` is settle-safe. A waker armed on a wait that has already settled
        -- runs before the call returns, which is what lets a handler arm once and then
        -- yield until ready rather than re-arm inside a recheck loop.
        local settledResume: any = nil
        local wokeImmediately = false
        local arming = provider.install({
            park = function(_: any, waiting: any): nil
                settledResume("settled")
                assert(waiting:ready(), "a resumed wait must report itself ready")
                waiting:onResume(function(): nil
                    wokeImmediately = true
                end)
            end,
            canPark = function(): boolean
                return true
            end,
            shutdown = function(): nil
            end,
        })
        local settled = provider.suspend("contract.settled", function(resume: function(string)): function()
            settledResume = resume

            return function(): nil
                settledResume = nil
            end
        end)
        arming:close()
        assert(settled == "settled", "the park must deliver the value it resumed")
        assert(wokeImmediately, "a waker armed on a settled wait must run before onResume returns")

        local resumed: any = nil
        local parkedOutward = false
        local outer = provider.install({
            park = function(_: any, _: any, _: any): nil
                parkedOutward = true
                resumed("delegated")
            end,
            canPark = function(): boolean
                return true
            end,
            shutdown = function(): nil
            end,
        })
        local parkOutward = provider.delegatedPark()
        local driver = provider.installDriver({
            park = function(_: any, waiting: any, cancel: any): nil
                parkOutward(waiting, cancel)
            end,
            canPark = provider.delegatedCanPark(),
            shutdown = function(): nil
            end,
        })
        local delegated = provider.suspend("contract.delegated", function(resume: function(string)): function()
            resumed = resume

            return function(): nil
                resumed = nil
            end
        end)
        assert(parkedOutward and delegated == "delegated", "a driver must park on the displaced handler")
        driver:close()
        outer:close()

        local standalone = provider.installDriver({
            park = function(): nil
            end,
            canPark = function(): boolean
                return true
            end,
            shutdown = function(): nil
            end,
        })
        for _ = 1, 65 do
            assert(provider.turnAvailable(), "a driver without a host must have an unbounded turn")
            provider.consumeTurn()
        end
        standalone:close()

        -- `derive` carries whatever routing state the original holds, and settles on
        -- either half. A driver parks outward on it, so a wait that only its own work
        -- can finish must still report itself ready.
        local driving = false
        local derived = provider.derive(
            {
                operation = "contract.derived",
                ready = function(): boolean
                    return false
                end,
                onResume = function(): nil
                end,
            },
            function(): boolean
                return driving
            end,
            function(_: any): nil
            end
        )
        assert(derived.operation == "contract.derived", "a derived wait keeps the operation it describes")
        assert(not derived:ready(), "a derived wait is pending while neither half is ready")
        driving = true
        assert(derived:ready(), "a derived wait settles on the driver's own readiness")

        local armed, woke = 0, 0
        local baseWake: any = nil
        local pair = provider.derive(
            {
                operation = "contract.derived.wake",
                ready = function(): boolean
                    return false
                end,
                onResume = function(_: any, wake: function(): nil): nil
                    baseWake = wake
                end,
            },
            function(): boolean
                return false
            end,
            function(wake: function(): nil): nil
                armed = armed + 1
                baseWake = wake
            end
        )
        pair:onResume(function(): nil
            woke = woke + 1
        end)
        assert(armed == 1, "deriving must arm the driver's own wakers")
        baseWake()
        baseWake()
        assert(woke == 1, "a derived waker runs at most once per registration")
    end)
    if not ok then
        return false, tostring(problem)
    end

    return true
end

export = suite
