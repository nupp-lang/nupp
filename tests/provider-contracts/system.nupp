@!internal
module nupp.tests.providers.system

local suite = {}
function suite.test(provider: any): (boolean, string?)
    if provider.pointerBits ~= 32 and provider.pointerBits ~= 64 then
        return false, "system pointerBits must be 32 or 64"
    end
    if provider.endianness ~= "little" and provider.endianness ~= "big" then
        return false, "system endianness must be little or big"
    end
    if provider.platform == "" or provider.architecture == "" then
        return false, "system platform and architecture must be named"
    end

    return true
end

export = suite
