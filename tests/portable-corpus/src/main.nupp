local struct Point
    x: uint8
    y: int16
end

local struct Scaled
    x: uint8
    y: int16 = 2

    constructor(self, x: integer)
        self.x = x * 2
    end
end

local simd = require("nupp.simd")

local function main(): string
    do
        local type Log = nosuspend function(number, number?): number
        local type Library = {log: Log}

        local function consume(library: Library): number
            return library.log(8, 2)
        end

        local function through(library: Library): Library
            return library
        end

        local function safe(library: Library?): Log?
            return library?.log
        end

        assert(math.abs(consume(math) - 3) < 1e-12)
        assert(math.abs(through(math).log(8, 2) - 3) < 1e-12)
        assert(through(math) == math and safe(math) == math.log and safe(nil) == nil)
        local library = math
        local logarithm = library.log
        local calls = ""

        local function argument(value: number): number
            calls = calls .. tostring(value)
            return value
        end

        local function invoke(callback: function(number, number?): number, value: number, base: number?): number
            return callback(value, base)
        end

        assert(logarithm == math.log)
        assert(math.abs(logarithm(argument(8), argument(2)) - 3) < 1e-12)
        assert(calls == "82", "log operands evaluate once in source order")
        assert(math.abs(invoke(math.log, 8, 2) - 3) < 1e-12)
        assert(logarithm(1) == 0 and logarithm(1, nil) == 0)
        local math = {
            log = function(_value: number, _base: number?): number
                return 42
            end
        }
        assert(math.log(8, 2) == 42, "application math tables retain their definition")
    end
    const settings = {const label = "portable"}
    local present: {value: integer}? = {value = 4}
    local absent: {value: integer}? = nil
    local selected = true ? present?.value : 0
    local defaulted = absent?.value ?? 5
    local twice = |value: integer| -> value * 2
    local count = |...values| -> values.n
    local maybeTwice: (function(integer): integer)? = twice
    local called = maybeTwice?.(3)
    local bracketSource: any = {value = 4}
    local bracketed = bracketSource?.["value"]
    local methodOwner = {}
    function methodOwner:add(value: integer): integer
        return value + 6
    end

    local methodValue = methodOwner?.:add?.(2)

    local total = 0
    for index = 1, 10 do
        if index % 2 == 0 then
            continue
        end
        if index == 7 then
            break
        end
        total += index
    end

    local calls: integer = 0
    local target: {value: integer}? = nil

    local function sideEffect(): integer
        calls += 1
        return calls
    end

    target?.value = sideEffect()
    local mutable: any = {value = 1}
    mutable?.value += 3

    @allow("customary-operator")
    local customary = !false && 1 != 2 || false
    local separated = 1_000
    local hexadecimal = 0x1p4
    local unpacked = unpack({11})
    local loaded = assert(loadstring("return 12"))()
    local presized = table.new(2, 1)
    presized.kept = 13
    table.clear(presized)
    local cleared = next(presized) == nil
    local cloned = table.clone({value = 14})
    local point = new Point(2, -2)
    local scaled = new Scaled(3)
    local shifted = (0x55 | 0xaa) << 1
    local digits = nupp.math.u64.popcount(3ULL)
    local wideValue: int64 = 9223372036854775807LL
    local wideWrapped = wideValue + 1LL

    -- Reducers must agree even when wide values are provider-owned objects,
    -- rather than LuaJIT cdata, and loading their math support must not recurse.
    local wrapping = simd.reducer.u64.wrappingSum(18446744073709551615ULL)
    wrapping:add(2ULL)
    assert(wrapping:value() == 1ULL)
    local minimum: simd.IntegerArgMin<uint64> = simd.reducer.integerArgMin()
    minimum:add(9007199254740993ULL)
    minimum:add(9007199254740992ULL)
    minimum:add(9007199254740992ULL)
    assert(minimum:value() == 2)
    local maximum = simd.reducer.integerMax(-1LL)
    maximum:add(1LL)
    assert(maximum:value() == 1LL)
    local countTrue = simd.reducer.count()
    countTrue:add(true)
    countTrue:add(false)
    assert(countTrue:value() == 1ULL)
    assert(nupp.math.u64.popcount(255ULL) == 8)
    assert(nupp.math.u64.trailingZeros(4294967296ULL) == 32)
    assert(nupp.math.u64.leadingZeros(4294967296ULL) == 31)

    return `${settings.label}:${selected}:${defaulted}:${twice(
        4
    )}:${count(
        nil,
        nil
    )}:${called}:${bracketed}:${methodValue}:${mutable?.value}:${total}:${customary}:${separated}:${hexadecimal}:${calls}:${unpacked}:${loaded}:${cleared}:${cloned.value}:${point.x == 2
        and point.y == -2}:${scaled.x == 6
        and scaled.y == 2}:${shifted}:${digits}:${wideWrapped < wideValue}`
end

print(main())
