local jobs = require("nupp.tests.channeljobs")

local result: {number} = {}
do
    local services = coroutine.scope()
    local commands, start = services:channel<boolean>(1, 64)
    local output, input = services:channel<integer>(4, 128)
    local producerReady, producerStarted = services:channel<boolean>(1, 64)
    local consumerReady, consumerStarted = services:channel<boolean>(1, 64)
    local producer = services:worker(start, output, producerReady, jobs.producer)
    local consumer = services:worker(input, consumerReady, jobs.consumer)
    assert(producerStarted:receive() == "value")
    assert(consumerStarted:receive() == "value")
    producerStarted:close()
    consumerStarted:close()
    commands:send(true)
    commands:close()
    assert(producer:await() == 256)
    result = consumer:await()
    assert(result[1] == 256 and result[2] == 32896)
end

-- Cancellation has a control path even when the event channel has no room.
do
    local cancelling = coroutine.scope()
    local events, receive = cancelling:channel<integer>(1, 64)
    local child = cancelling:worker(events, jobs.blocked)
    assert(receive:receive() == "value")
    assert(child:cancel())
    assert(
        not pcall(function(): nil
            child:await()
        end)
    )
    receive:close()
end
return ([[{"count":%d,"sum":%d,"cancelled":true}]]):format(result[1], result[2])
