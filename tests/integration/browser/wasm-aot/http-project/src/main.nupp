local byteapi = require("bytes")

const assert2 = require("assert")

local http = require("io.http")
local json = require("serde.json")
local uri = io
local io = require("io")

local client = http.Client.create()
local request = http.Request(
    url = assert2(uri.URI.of("http://127.0.0.1:8791/http-response.json")),
    headers = {accept = "application/json"} as {[string]: string},
    maxbytes = 4096
)
local response, sendProblem = client:send(request)
if response == nil then
    error(sendProblem or "browser HTTP request failed")
end
local received = byteapi.Buffer.create()
assert2(response.body:readinto(received, 0, 5) == 5)
local lease = received:reserve(5)
do
    local output = lease:span()
    assert2(response.body:readspan(output) == 5)
    own.drop(output)
end
lease:commit(5)
local remainder = byteapi.Buffer.create()
local writer = remainder:writer()
assert2(response.body:transferto(writer) ~= nil)
writer:close()
assert2(response.body:read(1) == "")
local body = received:tostring() .. remainder:tostring()
local result = json.encodevalue({status = response.status, contenttype = response:header("content-type"), body = body,})
response:close()
request:close()
client:close()

return result
