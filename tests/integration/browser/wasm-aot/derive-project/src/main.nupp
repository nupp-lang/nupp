-- Declaration bindings, document contexts, and Debug through browser providers.
const assert2 = require("assert")

const util = require("types")

local json = require("serde.json")
local serde = require("serde")
local typedJSON = require("serde.json")

@derive(types.debug)
local record Reading
    id: integer

    label: string = "unnamed"
    samples: {integer} = {}
end

local binding = serde.binding(
    Reading,
    new serde.Options(
        fields = {
            id = new serde.FieldOptions(name = "sensor_id"),
            label = new serde.FieldOptions(),
            samples = new serde.FieldOptions(),
        }
    )
)

local function encodedText(value: Reading): string
    local out = require("nupp.text").newbuffer()
    local writer = json.newwriter(out)
    typedJSON.writevalue(binding, value, writer)
    writer:close()

    return out:tostring()
end

local reading = new Reading(id = 7, label = "intake", samples = {3, 1, 4})
local encoded = encodedText(reading)
local decoded = typedJSON.decode(binding, encoded)
-- A field the document does not carry is the recipe's default rather than absent,
-- and a required one that is missing is a reported failure rather than a nil field.
local defaulted = typedJSON.decode(binding, [[{"sensor_id":9}]])
local accepted = pcall(typedJSON.decode, binding, [[{"label":"nameless"}]])

local documents = require("serde.document")
local codecs = require("serde.codec")
local native = require("serde.native")
local key = util.newkey<string>()
local context = codecs.contextbuilder({}, {})
context:set(key, "browser schema")
local document = typedJSON.decodedocument(
    documents.adapter(),
    '{"values":[null,18446744073709551615]}',
    context:freeze()
)
local values = assert2(document:get("values"))
assert2(values:at(1).kind == "null")
assert2(values:at(2):numberToken() == "18446744073709551615")
assert2(assert2(values:at(2):context()):get(key) == "browser schema")
assert2(typedJSON.encodedocument(documents.adapter(), document) == '{"values":[null,18446744073709551615]}')
assert2(not pcall(native.codec), "native persistence must refuse the browser")

local viewOwner = new Reading(id = 1, samples = {2})
local view = documents.view(binding, viewOwner)
local snapshot = view:snapshot()
viewOwner.samples[1] = 3
local viewAdapter = documents.viewadapter(binding)
assert2(typedJSON.encodedocument(viewAdapter, view):find('"samples":[3]', 1, true))
assert2(typedJSON.encodedocument(viewAdapter, snapshot):find('"samples":[2]', 1, true))

return json.encodevalue({
    documents = true,
    nativeRefused = true,
    encoded = encoded,
    debug = reading:debug(),
    roundTripped = (decoded as Reading):debug(),
    defaultedLabel = defaulted ~= nil and (defaulted as Reading).label or "<absent>",
    missingRefused = not accepted,
    -- The buffer has to survive being reused rather than only being allocated once.
    repeated = encodedText(reading) == encoded,
})
