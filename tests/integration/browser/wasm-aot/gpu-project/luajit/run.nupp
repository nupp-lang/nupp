const assert2 = require("assert")

local span = require("binary.span")
local array = require("nupp.mem.array")

@aot(target = "gpu")
local function addMask(exclusive output: span.WriteSpan<uint32>, borrows input: span.Span<uint32>, mask: uint32): nil
    assert2(#output == #input, "length mismatch")
    for index = 1, #output do
        output[index] = math.u32.add(input[index], mask)
    end
end

local input = array.scalar(array.uint32, 2)
do
    local rows = input:write()
    rows[1] = math.u32.wrap(4)
    rows[2] = math.u32.wrap(9)
    own.drop(rows)
end
local output = array.scalar(array.uint32, 2)
local gpu = require("io.gpu")
do
    local context = gpu.open();
    do
        local gpuInput = context:buffer(array.uint32, 2);
        local gpuOutput = context:buffer(array.uint32, 2);
        do
            local kernel = addMask:compile(context);
            do
                local binding = kernel:bind(gpuOutput, gpuInput);
                context:upload(gpuInput, input:read())
                binding:dispatch(math.u32.wrap(3))
            end
        end
        local rows = output:write()
        context:download(gpuOutput, rows)
        own.drop(rows)
    end
end
local rows = output:read()
assert2(rows[1] == 7 and rows[2] == 12)
return {ok = true}
