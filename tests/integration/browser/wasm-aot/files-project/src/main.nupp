os.setappid("nupp", "browser-files-test")
local root, rootReason = os.appdir("data")
assert(root, rootReason)
os.remove(root, true)
local created, createReason = os.mkdir(root)
assert(created, createReason)
assert(root is io.Path)
assert(root:parent() == nil)
local directory: io.Path = assert(root:absolute()):normalize()
local path: io.Path = assert(directory:resolve("save.tmp")):withextension("bin")
assert(path:parent() == root)
local unavailable, unavailableReason = path:canonicalize()
assert(unavailable == nil and unavailableReason ~= nil)
do
    local file = assert(io.open(path, "wb"))
    assert(file:write("abc\0def"))
end
do
    local file = assert(io.open(path, "ab"))
    assert(file:write(":tail"))
end
do
    local file = assert(io.open(path, "rb"))
    local initial, readReason = file:read("*a")
    assert(initial == "abc\0def:tail", readReason)
end

local modes = root:join("modes.bin")
local missing = root:join("missing.bin")
local absent = io.open(missing, "r")
assert(absent == nil)
do
    local file, reason = io.open(modes, "w")
    if file == nil then
        error(reason or "w failed", 0)
    end
    local denied = file:read(1)
    assert(denied == nil)
    assert(file:write("old"))
end
do
    local file, reason = io.open(modes, "r")
    if file == nil then
        error(reason or "r failed", 0)
    end
    assert(not file:write("denied"))
end
do
    local file, reason = io.open(modes, "w+")
    if file == nil then
        error(reason or "w+ failed", 0)
    end
    assert(file:seek("end") == 0)
    assert(file:write("xy"))
    assert(file:seek("set", 5) == 5)
    assert(file:write("q"))
    assert(file:seek("end") == 6)
    assert(file:seek("set", 0) == 0)
    assert(file:read(6) == "xy\0\0\0q")
end
do
    local file, reason = io.open(modes, "a+")
    if file == nil then
        error(reason or "a+ failed", 0)
    end
    assert(file:seek("set", 0) == 0)
    assert(file:write("z"))
    assert(file:seek("set", 0) == 0)
    assert(file:read(7) == "xy\0\0\0qz")
end

local locked: boolean
do
    local file, openReason = io.open(path, "r+")
    if file == nil then
        error(openReason or "could not open file", 0)
    end
    assert(file:seek("set", 4) == 4)
    assert(file:read(3) == "def")
    assert(file:seek("end", 0) == 12)
    local second, reason = io.open(path, "r")
    locked = second == nil and type(reason) == "string"
end

local reopened: boolean
do
    local file, openReason = io.open(path, "r")
    if file == nil then
        error(openReason or "could not reopen file", 0)
    end
    reopened = file:seek("end") == 12
end

local listed = false
for name, kind in os.list(root) do
    listed = listed or (name == "save.bin" and kind == "file")
end
local linkKind = os.stat(path, nofollow = true)
local present = os.exists(path)
local persistent = os.persiststorage()
local capabilities = os.info().fs
do
    local file = assert(io.open(path, "rb"))
    local final, finalReason = file:read("*a")
    assert(final == "abc\0def:tail", finalReason)
end
assert(listed)
assert(present == true)
assert(linkKind == "file" and not capabilities.symlinks)
assert(capabilities.available and not capabilities.arbitrarypaths and not capabilities.concurrentopenhandles)
assert(type(persistent) == "boolean")
local removed, removeReason = os.remove(root, true)
assert(removed, removeReason)
return [[{"bytes":"abc\u0000def:tail","entry":"save.bin","modes":true,"locked":true,"reopened":true,"symlinkUnsupported":true,"available":true,"arbitraryPaths":false,"concurrentOpenHandles":false,"persistenceAnswered":true}]]
