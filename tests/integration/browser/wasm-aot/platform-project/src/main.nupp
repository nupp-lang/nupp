local browserTime = require("coroutine")
local digest = require("bytes").digest
local mac = require("bytes").mac
local checksum = require("bytes").checksum
local uuid = os
local json = require("serde.json")
local system = os.info()
local byteapi = require("bytes")
assert(table.concat(byteapi.formats("digest"), ",") == "md5,sha1,sha256,sha512")
assert(#byteapi.formats("compression") == 0)

local started = os.monotonic()
browserTime.sleep(1)
local elapsed = os.monotonic() - started

return json.encodevalue({
    platform = system.platform,
    architecture = system.arch,
    pointerBits = system.pointerbits,
    endianness = system.endianness,
    parallelism = system.parallelism,
    elapsed = elapsed,
    randomBytes = #os.randombytes(32),
    md5 = digest("md5"):computehex("abc"),
    sha1 = digest("sha1"):computehex("abc"),
    sha256 = digest("sha256"):computehex("abc"),
    sha512 = digest("sha512"):computehex("abc"),
    crc32 = checksum("crc32"):compute("123456789") == 0xcbf43926ULL,
    crc64nvme = checksum("crc64nvme"):compute("123456789") == 0xae8b14860a799888ULL,
    crc32c = checksum("crc32c"):compute("123456789") == 0xe3069283ULL,
    crc64 = checksum("crc64-ecma"):compute("123456789") == 0x6c40df5f0b497347ULL,
    hmac = mac("hmac-sha256"):computehex("key", "abc"),
    uuid4 = uuid.uuid(4),
    uuid7 = uuid.uuid(7),
})
