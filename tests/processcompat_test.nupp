-- The tecs Process surface, with only its import changed.
--
-- This deliberately spells the caller-facing operations tecs publishes rather than
-- reaching the nonblocking `poll` and `offer` operations the implementation uses for
-- `communicate`.  If either public surface drifts, this module stops compiling before
-- its one runtime assertion can run.
const {type Buffer} = require("io")

local process = require("io")

local M = {}

local function tecsCallSites(options: process.Process.Options, exclusive buffer: Buffer): nil
    local child = assert(process.popen(options))

    local pid: integer = child.pid
    assert(pid >= 0)
    assert(child:isrunning())

    if child.stdin ~= nil then
        local written, writeReason = child.stdin:write("request\n")
        assert(written, writeReason)
        local bytes = buffer:readspan()
        local fromBuffer, bufferReason = child.stdin:writespan(bytes)
        assert(fromBuffer, bufferReason)
        child.stdin:close()
        -- Closing consumes the writer, so the field is refilled before the
        -- whole child is lent again.
        child.stdin = nil
    end

    if child.stdout ~= nil then
        local reply, readReason = child.stdout:read(64)
        if reply == nil then
            error(readReason)
        end
        local count, intoReason = child.stdout:readinto(buffer)
        assert(count, intoReason)
        assert(child.stdout:isreleased() or child.stdout:isended() or #reply >= 0)
    end

    local result, communicateReason = child:communicate({input = "complete input", maxoutputbytes = 1024 * 1024})
    if result == nil then
        error(communicateReason)
    end
    assert(result:succeeded() == (not result.exit.killed and not result.exit.timedout and result.exit.exitcode == 0))
    assert(type(result.output) == "string" and type(result.erroroutput) == "string")

    local killed, killReason = child:kill(true)
    assert(killed, killReason)
    local exit = child:wait()
    assert(type(exit.exitcode) == "number")
    child:close()
end

function M.theTecsSurfaceCompilesWithOnlyTheImportChanged(): nil
    -- The function above is the assertion: it is checked even though running every
    -- branch would require a child protocol contrived solely for this fixture.
    assert(tecsCallSites ~= nil)
end

return M
