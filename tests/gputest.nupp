local gpu = require("nupp.gpu")
local layout = require("nupp.gpu.layout")

local M = {}

local function rejects(body: function(): nil, message: string): nil
    local ok, problem = pcall(body)
    assert(not ok, "expected rejection containing " .. message)
    assert(tostring(problem):find(message, 1, true), tostring(problem))
end

function M.workgroupPhasesHaveDeterministicCpuMeaning(): nil
    local results: {float} = {}
    gpu.workgroups(nupp.math.u32.wrap(2), nupp.math.u32.wrap(4), function(groupIndex: uint32, phases: gpu.Phases)
        local values = phases:scratch(nupp.math.f32.narrow(0.0), 4)
        phases:run(function(localIndex: uint32)
            local base = nupp.math.u32.mul(groupIndex, nupp.math.u32.wrap(4))
            local value = nupp.math.u32.add(nupp.math.u32.add(base, localIndex), nupp.math.u32.wrap(1))
            values[localIndex as integer] = nupp.math.f32.narrow(value as number)
        end)
        phases:reduceSum(values)
        phases:run(function(localIndex: uint32)
            if localIndex == nupp.math.u32.wrap(0) then
                results[(groupIndex as integer) + 1] = nupp.math.f32.narrow(values[0])
            end
        end)
    end)

    assert(#results == 2)
    assert(results[1] == 10.0)
    assert(results[2] == 26.0)
end

function M.inclusiveScanHasDeterministicCpuMeaning(): nil
    local results: {uint32} = {}
    gpu.workgroups(nupp.math.u32.wrap(1), nupp.math.u32.wrap(8), function(groupIndex: uint32, phases: gpu.Phases)
        local values = phases:scratch(groupIndex, 8)
        local temporary = phases:scratch(groupIndex, 8)
        phases:run(function(localIndex: uint32)
            values[localIndex as integer] = nupp.math.u32.add(localIndex, nupp.math.u32.wrap(1))
        end)
        phases:inclusiveScan(values, temporary)
        phases:run(function(localIndex: uint32)
            results[(localIndex as integer) + 1] = nupp.math.u32.wrap(values[localIndex as integer] as integer)
        end)
    end)

    local expected = {1, 3, 6, 10, 15, 21, 28, 36}
    for index, value in ipairs(expected) do
        assert(results[index] == value)
    end
end

function M.sharedScratchChecksZeroBasedBounds(): nil
    gpu.workgroups(nupp.math.u32.wrap(1), nupp.math.u32.wrap(1), function(groupIndex: uint32, phases: gpu.Phases)
        local values = phases:scratch(groupIndex, 1)
        phases:run(function(localIndex: uint32)
            values[localIndex as integer] = nupp.math.u32.wrap(7)
            assert(values[0] == 7)
        end)
    end)
end

function M.cpuGpuMetadataRejectsFractionalIntegers(): nil
    gpu.workgroups(nupp.math.u32.wrap(1), nupp.math.u32.wrap(1), function(groupIndex: uint32, phases: gpu.Phases)
        local scratch = phases.scratch as any
        rejects(
            function(): nil
                scratch(phases, groupIndex, 1.5)
            end,
            "at least one element"
        )
        local values = phases:scratch(groupIndex, 1) as any
        assert(values[0] == groupIndex, "scratch must expose its initial value")
        rejects(
            function(): nil
                local _ = values[0.5]
            end,
            "index out of bounds"
        )
        rejects(
            function(): nil
                values[0.5] = groupIndex
            end,
            "index out of bounds"
        )
    end)

    local uncheckedNew = layout.new as any
    local uncheckedSubview = layout.subview as any
    local uncheckedTranspose = layout.transpose as any
    local uncheckedStrided = layout.asStrided as any
    rejects(
        function(): nil
            uncheckedNew({1}, {1}, 0.5)
        end,
        "offset exceeds uint32"
    )
    rejects(
        function(): nil
            uncheckedNew({1.5}, {1})
        end,
        "dimensions and strides must fit uint32"
    )
    rejects(
        function(): nil
            uncheckedNew({1}, {0.5})
        end,
        "dimensions and strides must fit uint32"
    )
    local stored = layout.new({2}, {1})
    rejects(
        function(): nil
            uncheckedSubview(stored, {0.5}, {1})
        end,
        "outside its layout"
    )
    rejects(
        function(): nil
            uncheckedTranspose(stored, {1.5})
        end,
        "every axis exactly once"
    )
    rejects(
        function(): nil
            uncheckedStrided(stored, {1}, {1}, 0.5)
        end,
        "offset exceeds uint32"
    )
end

function M.tensorLayoutsTransposeBroadcastAndProveInjectivity(): nil
    local stored = layout.new({1, 3, 2}, {6, 2, 1})
    local transposed = layout.transpose(stored, {1, 3, 2})
    local broadcast = layout.broadcast(transposed, {4, 2, 3})
    local shape = broadcast:dimensions()
    local strides = broadcast:strides()

    assert(broadcast.count == 24)
    assert(broadcast:extent() == 6)
    assert(shape[1] == 4 and shape[2] == 2 and shape[3] == 3)
    assert(strides[1] == 0 and strides[2] == 1 and strides[3] == 2)
    assert(not broadcast:isDense())
    assert(not broadcast:isInjective())

    local gapped = layout.asStrided(stored, {2, 2}, {3, 1}, 0)
    assert(gapped.count == 4)
    assert(gapped:extent() == 5)
    assert(not gapped:isDense())
    assert(gapped:isInjective())

    local singleton = layout.new({1, 6}, {0, 1})
    assert(singleton:offset() == 0, "the offset defaults to the first element")
    assert(singleton:isDense())
    assert(singleton:isInjective())
end

function M.tensorLayoutsCopyInputsAndValidateEveryTransformation(): nil
    local shape = {2, 3}
    local strides = {3, 1}
    local stored = layout.new(shape, strides, 7)
    shape[1] = 1
    strides[1] = 0
    local returnedShape = stored:dimensions()
    local returnedStrides = stored:strides()
    returnedShape[2] = 1
    returnedStrides[2] = 0
    assert(stored:dimensions()[1] == 2 and stored:dimensions()[2] == 3)
    assert(stored:strides()[1] == 3 and stored:strides()[2] == 1)

    local last = layout.subview(stored, {1, 2}, {1, 1})
    assert(last:offset() == 12 and last:extent() == 1)
    local shifted = layout.asStrided(stored, {1, 3}, {3, 1}, 3)
    assert(shifted:offset() == 10 and shifted:extent() == 3)

    rejects(
        function(): nil
            layout.new({}, {})
        end,
        "one through four"
    )
    rejects(
        function(): nil
            layout.new({1}, {1}, -1)
        end,
        "offset exceeds uint32"
    )
    rejects(
        function(): nil
            layout.new({65536, 65536}, {65536, 1})
        end,
        "dimensions and strides must fit uint32"
    )
    rejects(
        function(): nil
            layout.new({2}, {4294967295})
        end,
        "extent exceeds uint32"
    )
    rejects(
        function(): nil
            layout.subview(stored, {2, 0}, {1, 1})
        end,
        "outside its layout"
    )
    rejects(
        function(): nil
            layout.transpose(stored, {1, 1})
        end,
        "every axis exactly once"
    )
    rejects(
        function(): nil
            layout.broadcast(stored, {2, 4})
        end,
        "dimensions are incompatible"
    )
    rejects(
        function(): nil
            layout.asStrided(stored, {2, 2}, {3, 1}, 2)
        end,
        "exceeds its source"
    )
end

return M
