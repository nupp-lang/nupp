module main

-- The stamped host supplies nupp.workers; the ordinary Lua runner remains the
-- source of discovery, planning, reporting, and the serial fallback used by its
-- own tests. Keeping that policy in one place prevents the two entry points from
-- drifting.
rawset(_G, "__NUPP_TEST_WORKER_HOST", true)
arg[0] = "tests/run.lua"

-- The runner is loaded as a file, so its dependency is invisible to the module
-- graph unless the host names it. Keeping the public module loaded also means every
-- worker state and every suite observes the same assertion implementation.
package.loaded["assert"] = require("assert")
require("arg")
local _ = io.style

-- File-loaded suites share these host facilities in the parent and worker states.
require("nupp.random")
require("nupp.util")
const _ = os.info
require("utf8")
require("binary.hash")
require("binary.hash.digest")
require("binary.hash.checksum")
require("binary.hash.mac")
require("binary.compress")
require("serde.json")
require("io.path")
require("io.uri")
require("nupp.text")
require("nupp.time")
require("nupp.io.net")
require("nupp.io.process")
require("nupp.io.tls")
require("nupp.io.http")
require("nupp.gpu")
require("nupp.workers")

const run = assert(loadfile(arg[0]))
run()
