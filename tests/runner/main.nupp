module main

-- The stamped host supplies nupp.workers; the ordinary Lua runner remains the
-- source of discovery, planning, reporting, and the serial fallback used by its
-- own tests. Keeping that policy in one place prevents the two entry points from
-- drifting.
--
-- On the VM this program is the runner and the compiler both. Its image carries
-- the compiler's own graph, so a suite's `require` of a compiler module is the
-- carried one; Lua sources load through the VM's lowering; and a parallel lane
-- is this same program started again, since a VM worker shares no Lua state.
--
-- These are the compiler's own internal modules, which a typed module outside
-- `nupp.` may not import, so they are named here for the image and required by
-- a name the checker does not read. Carrying them is what makes a suite's
-- `require` of a compiler module the carried one rather than a compile from
-- source.
@allow("unused-binding")
const _DYNAMIC_REQUIRES = [[
@requires-dynamically nupp.compiler.syntax.triviaarena
@requires-dynamically nupp.compiler.syntax.triviaarena.table
@requires-dynamically nupp.compiler.vm.chunks
@requires-dynamically nupp.tools.vm.root
@requires-dynamically nupp.tools.vm.project
@requires-dynamically nupp.compiler.hostservices
@requires-dynamically nupp.compiler.project.preludecache
]]
if rawget(_G, "__nupp_load_image") then
    local load: function(string): any = require
    load("nupp.compiler.syntax.triviaarena").install(load("nupp.compiler.syntax.triviaarena.table"))
    load("nupp.compiler.vm.chunks").install()
else
    rawset(_G, "__NUPP_TEST_WORKER_HOST", true)
end
-- A process worker is this same program started again, on either host: its
-- modules are stamped into it, and a bare `luajit tests/run.lua` has none of
-- them beside a project's empty build directory.
-- The LuaJIT host names itself in __NUPP_EXECUTABLE; the VM in arg[0].
const program = tostring(rawget(_G, "__NUPP_EXECUTABLE") or arg[0])
rawset(_G, "__NUPP_TEST_RUNNER_COMMAND", "'" .. program:gsub("'", "'\\''") .. "'")
arg[0] = "tests/run.lua"

-- The runner is loaded as a file, so its dependency is invisible to the module
-- graph unless the host names it. Keeping the public module loaded also means every
-- worker state and every suite observes the same assertion implementation.
package.loaded["nupp.test"] = require("nupp.test")

-- File-loaded suites share these host facilities in the parent and worker states.
require("nupp.random")
require("nupp.util")
require("nupp.system")
require("nupp.digest")
require("nupp.checksum")
require("nupp.mac")
require("nupp.compression")
require("nupp.codec.json")
require("nupp.io.path")
require("nupp.io.uri")
require("nupp.text")
require("nupp.time")
require("nupp.io.net")
require("nupp.io.process")
require("nupp.workers")
-- These three reach providers only the LuaJIT host loads up front. A VM lane is a
-- process of its own with no worker states to share them with, so there a suite
-- requires them when it uses them, which keeps them out of the runner's image.
if not rawget(_G, "__nupp_load_image") then
    local load: function(string): any = require
    load("nupp.io.tls")
    load("nupp.io.http")
    load("nupp.gpu")
end

const run = assert(loadfile(arg[0]))
run()
