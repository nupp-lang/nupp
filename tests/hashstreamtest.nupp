local digest = require("nupp.digest")
local mac = require("nupp.mac")
local checksum = require("nupp.checksum")
local io = require("nupp.io")
local util = require("nupp.util")
local array = require("nupp.mem.array")
local span = require("nupp.mem.span")
local hex = require("nupp.codec.hex")
local test = require("nupp.test")
local M = {}

function M.publishedFnv1a64VectorsAndByteViews(): nil
    assert(util.fnv1a64("") == "cbf29ce484222325")
    assert(util.fnv1a64("a") == "af63dc4c8601ec8c")
    assert(util.fnv1a64("foobar") == "85944171f73967e8")
    assert(util.fnv1a64("a\0b\255c") == "3e5746fc83766ddc")

    local bytes = io.newBuffer("\0\1\127\128\255")
    local view = bytes:view()
    assert(util.fnv1a64(view) == "a5bcd1d1065f84b6")
    assert(util.fnv1a64(view) == "a5bcd1d1065f84b6")
end

function M.publishedDigestVectors(): nil
    assert(digest.hexDigest("md5", "") == "d41d8cd98f00b204e9800998ecf8427e")
    assert(digest.hexDigest("md5", "abc") == "900150983cd24fb0d6963f7d28e17f72")
    assert(digest.hexDigest("sha1", "") == "da39a3ee5e6b4b0d3255bfef95601890afd80709")
    assert(digest.hexDigest("sha1", "abc") == "a9993e364706816aba3e25717850c26c9cd0d89d")
    assert(digest.hexDigest("sha256", "") == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    assert(digest.hexDigest("sha256", "abc") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    assert(
        digest.hexDigest(
            "sha512",
            ""
        ) == "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e"
    )
    assert(
        digest.hexDigest(
            "sha512",
            "abc"
        ) == "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f"
    )
end

function M.wordDigestPaddingBoundariesMatchIndependentVectors(): nil
    local vectors: {
        {string}
    } = {
        {
            "md5",
            "55",
            "04364420e25c512fd958a70738aa8f72",
            "56",
            "668a72d5ba17f08e62dabcafad6db14b",
            "64",
            "c1bb4f81d892b2d57947682aeb252456"
        },
        {
            "sha1",
            "55",
            "cef734ba81a024479e09eb5a75b6ddae62e6abf1",
            "56",
            "901305367c259952f4e7af8323f480d59f81335b",
            "64",
            "bb2fa3ee7afb9f54c6dfb5d021f14b1ffe40c163"
        },
        {
            "sha512",
            "111",
            "9a2a120825c2319867758ec277924f6faa254968bf752046dacdd948d8ad299b10359fd04bfd7d3810b5fa1b16a294236138baff981cbb85248478053ac4d3dd",
            "112",
            "a3722b515ef40c910f2419f6e0da8ca51d410114ce6272faae64045f9e9f630e7fa8dd5a3243c9860b899d148c3da4bc0f9e07454542604d030bb55531fe0d5b",
            "128",
            "e2e22f8422b54b06e35c3ea30a383d1de7a8fbc27992923074103117020d8dd7024c3ecf7d6d1a15a6de5a75ff32fb486b9e8ced4c02ffe05822bf2cb734d0e0"
        }
    }
    for _, vector in ipairs(vectors) do
        for index = 2, #vector, 2 do
            local length = assert(tonumber(vector[index])) as integer
            assert(digest.hexDigest(vector[1], string.rep("x", length)) == vector[index + 1])
        end
    end
end

function M.metadataAndIndependentContexts(): nil
    assert(table.concat(digest.algorithms(), ",") == "md5,sha1,sha256,sha512")
    assert(digest.lookup("unknown") == nil)
    local algorithm = digest.algorithm("sha256")
    assert(algorithm.name == "sha256" and algorithm.digestSize == 32)
    local first = algorithm:newDigest()
    local second = algorithm:newDigest()
    assert(first:algorithm() == "sha256" and first:digestSize() == 32)
    first:write("a")
    second:write("abc")
    first:write("bc")
    assert(first:digest() == second:digest())

    assert(table.concat(mac.algorithms(), ",") == "hmac-sha256")
    assert(mac.lookup("unknown") == nil)
    local macAlgorithm = mac.algorithm("hmac-sha256")
    assert(macAlgorithm.name == "hmac-sha256" and macAlgorithm.digestSize == 32)
    local firstMac = macAlgorithm:newMac("key")
    local secondMac = macAlgorithm:newMac("key")
    firstMac:write("a")
    secondMac:write("abc")
    firstMac:write("bc")
    assert(firstMac:digest() == secondMac:digest())
end

function M.overloadedFinalizationWritesOnlyTheSuppliedSlice(): nil
    for _, name in ipairs(digest.algorithms()) do
        local algorithm = digest.algorithm(name)
        local bytes = array.bytes(algorithm.digestSize + 2)
        local output = bytes:write()
        output[1] = 0xa5
        output[#output] = 0x5a
        local region = output:slice(2, algorithm.digestSize + 1)
        local rolling = algorithm:newDigest()
        local source = "abc"
        local input = span.fromString(source)
        rolling:writeSpan(input)
        local written: integer = rolling:digest(region)
        assert(written == algorithm.digestSize)
        nupp.drop(region)
        assert(output[1] == 0xa5 and output[#output] == 0x5a)
        local expected = digest.digest(name, "abc")
        for index = 1, #expected do
            assert(output[index + 1] == expected:byte(index))
        end
    end
end

function M.shortDestinationIsRejected(): nil
    test.raises(
        function(): nil
            local bytes = array.bytes(31)
            local output = bytes:write()
            local rolling = digest.newDigest("sha256")
            rolling:write("abc")
            rolling:digest(output)
        end,
        "digest destination needs 32 bytes"
    )
end

function M.chunkingAndBinaryInput(): nil
    for _, name in ipairs(digest.algorithms()) do
        for length = 0, 260 do
            local input = string.rep("a\0b\255c", 53):sub(1, length)
            local rolling = digest.newDigest(name)
            for index = 1, #input, 7 do
                rolling:write(input:sub(index, index + 6))
            end
            assert(rolling:hexDigest() == digest.hexDigest(name, input), name .. " length " .. length)
        end
    end
end

function M.hmacRfc4231AndBinaryInput(): nil
    assert(
        mac.hexDigest(
            "hmac-sha256",
            string.rep("\11", 20),
            "Hi There"
        ) == "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7"
    )
    assert(
        mac.hexDigest(
            "hmac-sha256",
            "Jefe",
            "what do ya want for nothing?"
        ) == "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843"
    )
    assert(
        mac.hexDigest(
            "hmac-sha256",
            string.rep("\170", 131),
            "Test Using Larger Than Block-Size Key - Hash Key First"
        ) == "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54"
    )
    local rolling = mac.newMac("hmac-sha256", "k\0ey")
    rolling:write("one\0")
    rolling:write("two\255")
    assert(rolling:digest() == mac.digest("hmac-sha256", "k\0ey", "one\0two\255"))
end

function M.checksumVectorsAndNonConsumingReads(): nil
    assert(table.concat(checksum.algorithms(), ",") == "adler32,crc32-ieee,crc32c,crc64-ecma")
    local listed = checksum.algorithms()
    listed[1] = "changed"
    assert(checksum.algorithms()[1] == "adler32")
    assert(checksum.lookup("unknown") == nil)
    test.raises(
        function(): nil
            checksum.algorithm("unknown")
        end,
        "unknown checksum algorithm unknown"
    )
    assert(checksum.value("adler32", "") == 1ULL)
    assert(checksum.value("crc32-ieee", "") == 0ULL)
    assert(checksum.value("crc32c", "") == 0ULL)
    assert(checksum.value("crc64-ecma", "") == 0ULL)
    assert(checksum.value("adler32", "123456789") == 0x091e01deULL)
    assert(checksum.value("crc32-ieee", "123456789") == 0xcbf43926ULL)
    assert(checksum.value("crc32c", "123456789") == 0xe3069283ULL)
    assert(checksum.value("crc64-ecma", "123456789") == 0x6c40df5f0b497347ULL)
    assert(checksum.algorithm("crc64-ecma").width == 64)
    for _, name in ipairs(checksum.algorithms()) do
        assert(checksum.lookup(name) == checksum.algorithm(name))
        local rolling = checksum.newChecksum(name)
        assert(rolling:algorithm() == name)
        assert(rolling:width() == checksum.algorithm(name).width)
        rolling:write("1234")
        assert(rolling:value() == checksum.value(name, "1234"))
        local source = "56789"
        local tail = span.fromString(source)
        rolling:writeSpan(tail)
        assert(rolling:value() == checksum.value(name, "123456789"))

        local chunked = checksum.newChecksum(name)
        local message = string.rep("a\0b\255c", 53)
        for index = 1, #message, 7 do
            chunked:write(message:sub(index, index + 6))
        end
        assert(chunked:value() == checksum.value(name, message))
    end
end

function M.hexCodecIsStrictAndRoundTripsBytes(): nil
    local parts: {string} = {}
    for byte = 0, 255 do
        parts[#parts + 1] = string.char(byte)
    end
    local input = table.concat(parts)
    local encoded = hex.encode(input)
    assert(#encoded == 512 and not encoded:find("[^0-9a-f]"))
    assert(hex.decode(encoded) == input)
    assert(hex.decode(encoded:upper()) == input)
    assert(hex.decode("") == "")
    local decoded, reason = hex.decode("0")
    assert(decoded == nil and reason == "hex input must contain an even number of digits")
    decoded, reason = hex.decode("0x")
    assert(decoded == nil and reason == "hex input contains a non-hexadecimal digit")
    decoded, reason = hex.decode("00 1")
    assert(decoded == nil and reason == "hex input contains a non-hexadecimal digit")
end

-- A digest and a checksum are writers, so a reader can fill either, and the
-- answer is the one writing the same bytes by hand gives.
function M.aReaderTransfersIntoADigestAndAChecksum(): nil
    local message = string.rep("a\0b\255c", 20000)
    local byHand = digest.newDigest("sha256")
    byHand:write(message)
    local expected = byHand:hexDigest()

    local rolling = digest.newDigest("sha256")
    local source = io.newStringReader(message)
    assert(source:transferTo(rolling) == #message)
    assert(rolling:hexDigest() == expected)

    local sum = checksum.newChecksum("crc32c")
    local again = io.newStringReader(message)
    assert(again:transferTo(sum) == #message)
    assert(sum:value() == checksum.value("crc32c", message))
end

return M
