const {type Reader} = require("nupp.io")
const {type Buffer} = require("nupp.io")
const {type Writer} = require("nupp.io")
const {type ByteQueue} = require("nupp.io")
const io2 = require("nupp.io")

local text = require("nupp.text")
local span = require("nupp.mem.span")

local M = {}

local record ProbeReader is Reader
    state: any

    function read(exclusive self, count: integer): (string?, string?)
        if self.state.bytes ~= nil then
            self.state.maxRead = math.max(self.state.maxRead or 0, count)
            if self.state.overread then
                local all = self.state.bytes
                self.state.bytes = ""
                return all
            end
            local out = self.state.bytes:sub(1, count)
            self.state.bytes = self.state.bytes:sub(#out + 1)
            if #out > 0 then
                return out
            end
        end
        if self.state.failure ~= nil then
            local failure = self.state.failure
            self.state.failure = nil
            return nil, failure
        end

        return ""
    end

    function readSpan(exclusive self, exclusive destination: span.Writable<uint8>): (integer?, string?)
        return 0
    end

    function readInto(
        exclusive self,
        exclusive destination: Buffer,
        offset: integer?,
        count: integer?
    ): (integer?, string?)
        return 0
    end

    function transferTo(exclusive self, exclusive destination: Writer): (integer?, string?)
        return 0
    end

    function close(takes self): nil
        self.state.closes = self.state.closes + 1
    end
end

local record ProbeWriter is Writer
    state: any

    function write(exclusive self, bytes: string): (boolean, string?)
        if self.state.failure ~= nil then
            return false, self.state.failure
        end

        return true
    end

    function writeSpan(exclusive self, borrows source: span.ByteSpan): (integer?, string?)
        return #source
    end

    function flush(self): (boolean, string?)
        if self.state.flushFailure ~= nil then
            return false, self.state.flushFailure
        end

        return true
    end

    function close(takes self): nil
        self.state.closes = self.state.closes + 1
    end
end

local record BrokenQueue is ByteQueue
    reported: integer
    answer: string

    metamethod __len: function(self: BrokenQueue): integer
    get: function(self: BrokenQueue, ...: integer?): string
end

local record NamedQueue is ByteQueue
    bytes: string
    read: boolean

    metamethod __len: function(self: NamedQueue): integer
    get: function(self: NamedQueue, ...: integer?): string
end

function NamedQueue.__len(self: NamedQueue): integer
    return #self.bytes
end

function NamedQueue.get(self: NamedQueue, ...: integer?): string
    local count = (...) or #self.bytes
    local out = self.bytes:sub(1, count)
    self.bytes = self.bytes:sub(#out + 1)
    return out
end

function BrokenQueue.__len(self: BrokenQueue): integer
    return self.reported
end

function BrokenQueue.get(self: BrokenQueue, ...: integer?): string
    return self.answer
end

function M.roundTripsEveryCScalar(): nil
    local writer = io2.newScalarWriter()
    writer:writeUint8(255)
    writer:writeInt8(nupp.math.i32.wrap(-128))
    writer:writeUint16(65535)
    writer:writeInt16(nupp.math.i32.wrap(-32768))
    writer:writeUint32(4294967295)
    writer:writeInt32(nupp.math.i32.wrap(-2147483648))
    writer:writeUint64(1234567890123 as uint64)
    writer:writeInt64(-1234567890123 as int64)
    writer:writeFloat32(1.5)
    writer:writeFloat64(-1234.5)

    local stored = writer:buffer()
    assert(stored ~= nil)
    local reader = io2.newScalarReader(stored as Buffer)
    assert(reader:remaining() == 42)
    assert(reader:readUint8() == 255)
    assert(reader:readInt8() == -128)
    assert(reader:readUint16() == 65535)
    assert(reader:readInt16() == -32768)
    assert(reader:readUint32() == 4294967295)
    assert(reader:readInt32() == -2147483648)
    assert(reader:readUint64() == (1234567890123 as uint64))
    assert(reader:readInt64() == (-1234567890123 as int64))
    assert(reader:readFloat32() == 1.5)
    assert(reader:readFloat64() == -1234.5)
    assert(reader:remaining() == 0)
    assert(reader:atEnd())
end

function M.movesRawBytesAndTracksTheCursor(): nil
    local reader = io2.newScalarReader("abcdef")
    assert(reader:readBytes(2) == "ab")
    assert(reader:skip(2) == reader)
    assert(reader:remaining() == 2)
    assert(reader:readBytes(2) == "ef")
    assert(reader:atEnd())
end

function M.appendsToABufferItWasGiven(): nil
    local destination = io2.newBuffer("head")
    local writer = io2.newScalarWriter(destination)
    assert(writer:buffer() == destination)
    assert(writer:writeBytes(":"):writeUint8(33) == writer)
    assert(destination:getString() == "head:!")
end

function M.writesThroughSomebodyElsesWriter(): nil
    local destination = io2.newBuffer()
    local writer = io2.newScalarWriter(destination:newWriter())
    assert(writer:buffer() == nil)
    writer:writeUint16(513)
    assert(writer:flush())
    assert(destination:getString() == "\1\2")
end

function M.readsThroughAnyReader(): nil
    local reader = io2.newScalarReader(io2.newStringReader("\1\2\3\4rest"))
    assert(reader:remaining() == nil)
    assert(reader:readUint32() == 67305985)
    assert(reader:readBytes(4) == "rest")
    assert(reader:atEnd())
end

function M.readsAStringBufferInPlace(): nil
    local queue = text.newBuffer()
    queue:put("head:")
    queue:put("!")

    local reader = io2.newScalarReader(queue)
    assert(reader:remaining() == 6)
    assert(reader:readBytes(5) == "head:")
    assert(queue:tostring() == "!")
    assert(reader:readUint8() == 33)
    assert(reader:atEnd())
end

function M.bridgesAStringBufferIntoTheReaderContract(): nil
    local queue = text.newBuffer()
    queue:put("payload")

    local destination = io2.newBuffer()
    local reader = io2.newQueueReader(queue)
    assert(reader:transferTo(destination:newWriter()) == 7)
    assert(destination:getString() == "payload")
    assert(reader:read(8) == "")
end

function M.shortReadsRaiseBeforeConsuming(): nil
    local reader = io2.newScalarReader("x")
    local ok, reason = pcall(function(): nil
        reader:readUint16()
    end)
    assert(not ok)
    assert(tostring(reason):find("needs 2 bytes, has 1", 1, true) ~= nil)
    assert(reader:remaining() == 1)
end

function M.bufferWriteLeasesCommitAtomically(): nil
    local destination = io2.newBuffer("head")
    do
        local lease = destination:reserveWrite(4, 4)
        do
            local output = lease:span()
            output[1] = 65
            output[2] = 66
            output[3] = 67
            nupp.drop(output)
        end
        lease:commit(2)
    end
    assert(destination:getString() == "headAB")

    do
        local aborted = destination:reserveWrite(10, 2)
        local output = aborted:span()
        output[1] = 88
    end
    assert(destination:getString() == "headAB")
end

function M.readerCountsArePositiveAndEofDoesNotGrowBuffers(): nil
    local reader = io2.newStringReader("x")
    assert(
        not pcall(function(): nil
            reader:read(0)
        end)
    )
    local destination = io2.newBuffer("kept")
    assert(reader:readInto(destination, 4, 1) == 1)
    assert(destination:getString() == "keptx")
    assert(reader:readInto(destination, 20, 1) == 0)
    assert(destination:getString() == "keptx")
    assert(
        not pcall(function(): nil
            local other = io2.newBuffer()
            reader:readInto(other, 0, 0)
        end)
    )
end

function M.scalarReadersHonorTheByteQueueContract(): nil
    local named = new NamedQueue(bytes = "xy", read = true)
    local reader = io2.newScalarReader(named)
    assert(reader:readBytes(1) == "x")
    assert(named.bytes == "y")

    local broken = io2.newScalarReader(new BrokenQueue(reported = 2, answer = "xyz"))
    local ok, reason = pcall(function(): nil
        broken:readBytes(1)
    end)
    assert(not ok and tostring(reason):find("wrong byte count", 1, true) ~= nil)
end

function M.rejectsInvalidRangesAndMalformedByteQueues(): nil
    local buffer = io2.newBuffer("abc")
    assert(
        not pcall(function(): nil
            buffer:setString("x", false as any)
        end)
    )
    assert(
        not pcall(function(): nil
            local lease = buffer:reserveWrite(9007199254740991, 1)
            nupp.drop(lease)
        end)
    )
    assert(
        not pcall(function(): nil
            local invalid = io2.newStringReader("x")
            invalid:read(math.huge as integer)
        end)
    )
    assert(
        not pcall(function(): nil
            local invalid = io2.newStringReader("x")
            local destination = io2.newBuffer()
            invalid:readInto(destination, nil, false as any)
        end)
    )

    local reader = io2.newQueueReader(new BrokenQueue(reported = 2, answer = "x"))
    local ok, reason = pcall(function(): nil
        reader:read(2)
    end)
    assert(not ok and tostring(reason):find("wrong byte count", 1, true) ~= nil)

    local negative = io2.newQueueReader(new BrokenQueue(reported = -1, answer = ""))
    ok, reason = pcall(function(): nil
        negative:read(1)
    end)
    assert(not ok and tostring(reason):find("ByteQueue length", 1, true) ~= nil)

    local scalar = io2.newScalarReader("x")
    ok, reason = pcall(function(): nil
        scalar:readBytes(math.huge as integer)
    end)
    assert(not ok and tostring(reason):find("must be a non-negative integer", 1, true) ~= nil)
end

function M.scalarReadersRejectSourcesThatOverread(): nil
    local source = new ProbeReader(state = {bytes = "ab", closes = 0, overread = true})
    local reader = io2.newScalarReader(source)
    local ok, reason = pcall(function(): nil
        reader:readUint8()
    end)
    assert(not ok and tostring(reason):find("more bytes than requested", 1, true) ~= nil)
end

function M.scalarWritersPropagateDestinationFailures(): nil
    local writer = io2.newScalarWriter(new ProbeWriter(state = {closes = 0, failure = "cancelled"}))
    local ok, reason = pcall(function(): nil
        writer:writeUint16(1)
    end)
    assert(not ok and tostring(reason):find("destination failed: cancelled", 1, true) ~= nil)
end

function M.lineReadersBoundPullsAndOwnTheirSources(): nil
    local state = {bytes = "abc\r\nrest", closes = 0, maxRead = 0}
    local lines = io2.newLines(new ProbeReader(state = state), 3)
    assert(lines:read() == "abc")
    assert(state.maxRead <= 5)
    lines:close()
    assert(state.closes == 1)
end

function M.lineReadersPropagateFailuresAfterPartialInput(): nil
    local state = {bytes = "partial", closes = 0, failure = "cancelled"}
    local lines = io2.newLines(new ProbeReader(state = state), 64)
    local line, reason = lines:read()
    assert(line == nil and reason == "cancelled")
    lines:close()
    assert(state.closes == 1)
end

function M.lineReadersRejectInvalidLimitsAndSourcesThatOverread(): nil
    local ok, reason = pcall(function(): nil
        local lines = io2.newLines(new ProbeReader(state = {closes = 0}), math.huge as integer)
        lines:close()
    end)
    assert(not ok)

    local lines = io2.newLines(new ProbeReader(state = {bytes = "abcdef", closes = 0, overread = true}), 2)
    ok, reason = pcall(function(): nil
        lines:read()
    end)
    assert(not ok and tostring(reason):find("more bytes than requested", 1, true) ~= nil)
end

function M.scalarAdaptersFinishTakenEndpointsExactlyOnce(): nil
    local readerDrop = {drops = 0, closes = 0}
    do
        local scalar = io2.newScalarReader(new ProbeReader(state = readerDrop))
    end
    assert(readerDrop.closes == 1)

    local readerClose = {drops = 0, closes = 0}
    do
        local scalar = io2.newScalarReader(new ProbeReader(state = readerClose))
        scalar:close()
    end
    assert(readerClose.closes == 1)

    local writerDrop = {drops = 0, closes = 0}
    do
        local scalar = io2.newScalarWriter(new ProbeWriter(state = writerDrop))
    end
    assert(writerDrop.closes == 1)

    local writerClose = {drops = 0, closes = 0}
    do
        local scalar = io2.newScalarWriter(new ProbeWriter(state = writerClose))
        scalar:close()
    end
    assert(writerClose.closes == 1)
end

-- `close` answers nothing, so a destination that failed to take its bytes has to
-- say so earlier: `flush` is where it does, and closing afterwards still runs.
function M.flushReportsAFailedDestinationBeforeClose(): nil
    local state = {closes = 0, flushFailure = "disk full"}
    do
        local scalar = io2.newScalarWriter(new ProbeWriter(state = state))
        scalar:writeUint8(1)
        local flushed, reason = scalar:flush()
        assert(flushed == false)
        assert(reason == "disk full")
        scalar:close()
    end
    assert(state.closes == 1)
end

-- A reader drained whole answers one string; a limit is checked as bytes arrive,
-- and the reader it took is closed either way.
function M.readAllDrainsAReaderWithinItsLimit(): nil
    assert(io2.readAll(io2.newStringReader("")) == "")
    local big = string.rep("0123456789", 20000)
    assert(io2.readAll(io2.newStringReader(big)) == big)
    assert(io2.readAll(io2.newStringReader(big), #big) == big, "exactly the limit is within it")
    local refused, reason = io2.readAll(io2.newStringReader(big), #big - 1)
    assert(refused == nil and reason ~= nil, "one byte past the limit is refused")

    local state = {closes = 0, bytes = "abc", maxRead = 0}
    local answered = io2.readAll(new ProbeReader(state = state), 2)
    assert(answered == nil)
    assert(state.maxRead <= 3, "it never asks for more than one byte past the limit")
    assert(state.closes == 1, "the reader is closed when the limit refuses it")

    local failing = {closes = 0, bytes = "ab", failure = "broken pipe"}
    local text, why = io2.readAll(new ProbeReader(state = failing))
    assert(text == nil and why == "broken pipe")
    assert(failing.closes == 1, "the reader is closed when it fails")
end

return M
