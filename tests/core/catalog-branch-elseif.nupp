module nupp.core.catalogbranchelseif

local function choose(first: boolean, second: boolean): boolean
    local function identity(value: boolean): boolean
        return value
    end

    if identity(first) then
        return false
    elseif identity(second) then
        return true
    else
        return false
    end
end

-- Graph profiles before version 8 have no tables to export from, so the
-- module value is the result itself.
export = choose(false, true)
