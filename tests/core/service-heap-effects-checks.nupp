module nupp.core.serviceheapeffectschecks

-- Read-only classification from the actual checked service unit, before graph
-- lowering. Managed Header admission remains refused by the existing tests.
local service = require("nupp.compiler.vm.nativeservice")
local unit = require("nupp.compiler.vm.nativeunit")
local nativegraph = require("nupp.compiler.vm.nativegraph")

local function refuses(callback: function(): nil, text: string): nil
    local ok, message = pcall(callback)
    assert(not ok and tostring(message):find(text, 1, true), tostring(message))
end

export function check(build: any): nil
    local owners = {}
    for _, owner in ipairs(service.owners(build.catalog)) do
        owners[owner.scope.name .. "." .. owner.name] = owner
    end
    local allocate = assert(owners["nupp.runtime.vm.collector.allocate"])
    local raw = assert(owners["nupp.runtime.vm.heap.allocRaw"])
    local full = assert(owners["nupp.runtime.vm.collector.fullCycle"])
    local gray = assert(owners["nupp.runtime.vm.heap.grayPush"])
    local map = assert(owners["nupp.runtime.vm.heap.mapOrFail"])
    local destroy = assert(owners["nupp.runtime.vm.heap.destroy"])
    local invalidates, changesRoots = service.heapEffects(build.catalog, destroy)
    assert(invalidates and changesRoots, "heap destruction invalidates managed storage")
    local releaseLarge = assert(owners["nupp.runtime.vm.heap.releaseLarge"])
    invalidates, changesRoots = service.heapEffects(build.catalog, releaseLarge)
    assert(invalidates and changesRoots, "large-object release invalidates managed storage")
    invalidates, changesRoots = nativegraph.intrinsicHazards("futureUnknownPrimitive")
    assert(invalidates and changesRoots, "unknown primitive cannot default to harmless")
    invalidates, changesRoots = nativegraph.intrinsicHazards("helper")
    assert(invalidates and changesRoots, "guest helper cannot default to harmless")
    local collects, mutates = service.heapEffects(build.catalog, allocate)
    assert(collects and mutates, "allocate must carry transitive collector/root hazards")
    collects, mutates = service.heapEffects(build.catalog, full)
    assert(collects and mutates, "fullCycle must carry collector/root hazards")
    collects, mutates = service.heapEffects(build.catalog, raw)
    assert(not collects and mutates, "raw allocation is not collection or root-safe publication")
    collects, mutates = service.heapEffects(build.catalog, gray)
    assert(not collects and mutates, "gray growth is noncollecting but writes unknown storage")
    collects = service.heapEffects(build.catalog, map)
    assert(not collects, "mapping pages must not be classified as guest collection")
    refuses(
        function(): nil
            service.heapEffects({}, allocate)
        end,
        "unissued service catalogue"
    )
    local copy = {}
    for key, value in pairs(allocate) do
        copy[key] = value
    end
    refuses(
        function(): nil
            service.heapEffects(build.catalog, copy)
        end,
        "outside service catalogue"
    )
    local saved = allocate.body.effectSummary
    allocate.body.effectSummary = {}
    local ok, message = pcall(service.heapEffects, build.catalog, allocate)
    allocate.body.effectSummary = saved
    assert(not ok and tostring(message):find("checked summary changed", 1, true), tostring(message))

    local summary = allocate.body.effectSummary
    local top = summary.top
    summary.top = not top
    ok, message = pcall(service.heapEffects, build.catalog, allocate)
    summary.top = top
    assert(not ok and tostring(message):find("summary flag changed", 1, true), tostring(message))
    local writes, key = summary.writes, "$heapEffectsMutation"
    local previous = writes[key]
    writes[key] = previous == nil and true or not previous
    ok, message = pcall(service.heapEffects, build.catalog, allocate)
    writes[key] = previous
    assert(not ok and tostring(message):find("summary map changed", 1, true), tostring(message))
    local primitiveChanged = false
    for _, node in ipairs(unit.occurrences(raw)) do
        if node.kind == "call"
            and node.obj.kind == "dotIndex"
            and node.obj.obj.kind == "name"
            and node.obj.obj.token.definition.requiredModule == "nupp.runtime.vm.intrinsics"
        then
            local definition, name = node.obj.name.definition, node.obj.name.text
            node.obj.name.definition = {}
            ok = pcall(service.heapEffects, build.catalog, raw)
            node.obj.name.definition = definition
            assert(not ok, "substituted intrinsic identity reused effects")
            node.obj.name.text = "futureUnknownPrimitive"
            ok = pcall(service.heapEffects, build.catalog, raw)
            node.obj.name.text = name
            assert(not ok, "unknown intrinsic reused a recognized checked binding")
            primitiveChanged = true
            break
        end
    end
    assert(primitiveChanged, "allocRaw lacks its expected intrinsic occurrence")
    -- Same-signature substitution at a real imported occurrence cannot reuse
    -- the catalogue's earlier call graph. Restore before another query.
    local changed = false
    for _, node in ipairs(unit.occurrences(allocate)) do
        if node.kind == "call" and node.obj.kind == "dotIndex" and node.obj.name.text == "allocRaw" then
            local definition = node.obj.name.definition
            node.obj.name.definition = {}
            ok = pcall(service.heapEffects, build.catalog, allocate)
            node.obj.name.definition = definition
            assert(not ok, "changed checked callee reused cached heap effects")
            changed = true
        end
    end
    assert(changed, "allocate did not contain its real allocRaw edge")
    collects = service.heapEffects(build.catalog, allocate)
    assert(collects, "restored transitive collection fact changed")
    local signature = service.signature(raw, service.options(build.catalog, raw))
    refuses(
        function(): nil
            service.dependentReturn(signature, raw)
        end,
        "outside reviewed Arena/Pool storage"
    )
end
