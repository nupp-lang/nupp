module nupp.core.rawexecutablefixture

local parser = require("nupp.compiler.syntax.parser")
local checker = require("nupp.compiler.check")
local environment = require("nupp.compiler.project.env")
local program = require("nupp.compiler.vm.programgraph")
local tagged = require("nupp.compiler.vm.taggedprofile")
local contracts = require("nupp.compiler.vm.coregraphcontracts")
local codec = require("nupp.compiler.vm.coregraphcodec")
local front = require("nupp.core.source")
require("nupp.compiler.syntax.triviaarena.table")
require("nupp.compiler.project.projectconfig")
require("nupp.compiler.hash")

export function data(kind: string): string
    if kind == "require" then
        local env: any = environment.new(".", {memoryOnly = true, cache = false, nativeCompilerServices = false})
        local modules = {}
        for _, name in ipairs({"nupp.core.catalogmoduleprefix", "nupp.core.catalogmodulemain"}) do
            local path = "src/" .. name:gsub("%.", "/") .. ".nupp"
            local parsed = parser.parse(front.read(path), path)
            assert(#parsed.errors == 0)
            local diagnostics = checker.check(parsed, path, env, {
                moduleName = name,
                strict = false,
                lints = {["unused-binding"] = "off"}
            })
            for _, diagnostic in ipairs(diagnostics) do
                assert(diagnostic.severity ~= "error", diagnostic.msg)
            end
            modules[#modules + 1] = {name = name, path = path, parsed = parsed, diagnostics = diagnostics}
        end
        local catalog = program.describe(modules, "nupp.core.catalogmodulemain")

        return codec.encode(contracts.normalize(program.compile(catalog, tagged)))
    end
    local source = "return true"
    if kind == "false" then
        source = "return false"
    elseif kind == "nil" then
        source = "return nil"
    elseif kind == "missing" then
        source = "return"
    elseif kind == "call" then
        source = "local function identity(value: boolean): boolean return value end\nreturn identity(true)"
    else
        assert(kind == "true")
    end
    local path, name = "=raw_executable_fixture.nupp", "raw_executable_fixture"
    local parsed = parser.parse(source, path)
    assert(#parsed.errors == 0)
    local env: any = environment.new(".", {memoryOnly = true, cache = false, nativeCompilerServices = false})
    local diagnostics = checker.check(parsed, path, env, {
        moduleName = name,
        strict = false,
        lints = {["unused-binding"] = "off"}
    })
    for _, diagnostic in ipairs(diagnostics) do
        assert(diagnostic.severity ~= "error", diagnostic.msg)
    end
    local catalog = program.describe({{name = name, path = path, parsed = parsed, diagnostics = diagnostics}}, name)

    return codec.encode(contracts.normalize(program.compile(catalog, tagged)))
end
