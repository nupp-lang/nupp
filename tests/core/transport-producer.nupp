module nupp.core.transportproducer

local ROOT = assert(os.getenv("NUPP_COMPILER_ROOT"))
local front = require("nupp.core.source")
local nativegraph = require("nupp.compiler.vm.nativegraph")
local lower = require("nupp.compiler.vm.lower")
local sink = require("nupp.compiler.s0.nativegraph")
local allocate = require("nupp.compiler.s0.allocate")
local allocationcheck = require("nupp.compiler.s0.allocationcheck")
local selector = require("nupp.compiler.s0.select")
local shim = require("nupp.core.shim")
local graphimage = require("nupp.compiler.vm.graphimage")
local recipes = require("nupp.compiler.vm.machinerecipes")
local json = require("serde.json")
local MODULE = "nupp.runtime.core.transportprobe"

export function compile(mode: string): string
    assert(mode == "normal" or mode == "spill")
    local path = ROOT .. "/src/nupp/runtime/core/transportprobe.nupp"
    local functions, options = front.checked(front.read(ROOT .. "/tests/core/transport-probe.nupp"), path, MODULE)
    local contextPath = ROOT .. "/src/nupp/runtime/core/context.nupp"
    local _, contextOptions = front.checked(front.read(contextPath), contextPath, "nupp.runtime.core.context")
    local context = contextOptions.modules["nupp.runtime.core.context"]
    options.modules[context.name] = context
    local resolved, codes, metrics = {}, {}, {}
    local owners = {"pressure", "CoreWrong", "CoreCapture", "CoreTransport"}
    for _, name in ipairs(owners) do
        options.abi = name == "CoreTransport" and "handler" or "leaf"
        local owner = functions[name]
        local g = lower.functionGraph(owner, options, nativegraph)
        resolved[MODULE .. "." .. name] = {graph = g, owner = owner}
    end
    for _, name in ipairs(owners) do
        local item = resolved[MODULE .. "." .. name]
        local artifact = sink.compilerGraph(item.graph, name, item.owner, resolved, context)
        if name == "CoreTransport" then
            for index = 1, 6 do
                assert(artifact.machine.params[index] == index + 1)
            end
            assert(
                artifact.contextLayout.owner == context
                and artifact.contextLayout.bytes == 128
                and artifact.contextLayout.dispatchOffset == 40
            )
        end
        local target = selector.target()
        if mode == "spill" then
            target.integerRegisters, target.floatRegisters = {}, {}
        end
        local allocation = allocate.run(artifact.machine, target)
        assert(allocationcheck.run(artifact.machine, target, allocation))
        local code = selector.run(artifact.machine, allocation)
        codes[name] = code
        metrics[
            #metrics + 1
        ] = {
            name = name,
            calls = #code.fixupKind,
            frameBytes = code.frameBytes,
            spillSlots = allocation.spillSlots,
            integerRegisters = #target.integerRegisters,
            floatRegisters = #target.floatRegisters
        }
    end
    assert(#codes.CoreTransport.fixupKind == 2 and #codes.pressure.fixupKind == 0)
    local result = shim.build({codes.CoreTransport, codes.CoreWrong, codes.CoreCapture}, {
        [MODULE .. ".pressure"] = codes.pressure
    })
    result.metrics, result.mode = metrics, mode
    result.contextSource = {path = context.path, module = context.name, bytes = 128, dispatchOffset = 40}
    result.refusals = {}
    local item = resolved[MODULE .. ".CoreTransport"]

    local function refused(label: string, action: function(): any, message: string): nil
        local ok, problem = pcall(action)
        assert(not ok and tostring(problem):find(message, 1, true), tostring(problem))
        result.refusals[#result.refusals + 1] = label
    end

    refused(
        "missing context",
        function(): any
            return sink.compilerGraph(item.graph, item.owner.name, item.owner, resolved)
        end,
        "checked context layout required"
    )
    refused(
        "unresolved helper",
        function(): any
            return sink.compilerGraph(item.graph, item.owner.name, item.owner, {}, context)
        end,
        "unresolved leaf"
    )
    local original = context.exportedConstants.DISPATCH_TABLE
    context.exportedConstants.DISPATCH_TABLE = "128"
    refused(
        "changed exported constant",
        function(): any
            return sink.compilerGraph(item.graph, item.owner.name, item.owner, resolved, context)
        end,
        "context declaration identity"
    )
    context.exportedConstants.DISPATCH_TABLE = original
    local field
    for definition, node in pairs(context.constants) do
        if definition.name == "DISPATCH_TABLE" then
            field = node
        end
    end
    for _, value in ipairs({"41", "128"}) do
        local text = field.token.text
        field.token.text, context.exportedConstants.DISPATCH_TABLE = value, value
        refused(
            "dispatch bounds " .. value,
            function(): any
                return sink.compilerGraph(item.graph, item.owner.name, item.owner, resolved, context)
            end,
            "context dispatch bounds"
        )
        field.token.text, context.exportedConstants.DISPATCH_TABLE = text, original
    end
    -- The old CLIF adapter still emits the same five-argument plus table tail.
    local operations = {}

    local function record(
        op: string,
        dst: any,
        a: any,
        b: any,
        tail: {any}?,
        kind: string,
        bits: integer,
        text: string?
    ): any
        operations[#operations + 1] = {op = op, a = a, b = b, tail = tail, bits = bits, text = text}
        return #operations + 100
    end

    recipes.dispatch(record, {1, 2, 3, 4, 5}, 6)
    assert(
        #operations == 6
        and operations[1].op == "load"
        and operations[1].a == 1
        and operations[2].text == "3"
        and operations[3].op == "ishl"
        and operations[4].a == 6
        and operations[5].bits == 64
        and operations[6].op == "return_call_indirect"
        and operations[6].b == 6
        and #operations[6].tail == 5
    )

    return json.encodevalue(result)
end

export function data(offsets: string, codeBytesText: string): string
    local codeBytes = assert(tonumber(codeBytesText))
    local entries = {}
    for text in offsets:gmatch("[^,]+") do
        local offset = assert(tonumber(text))
        assert(offset >= 0 and offset < codeBytes and offset % 4 == 0)
        entries[#entries + 1] = graphimage.wideBytes(offset)
    end
    assert(#entries == 3)
    local zero = string.rep(string.char(0), 16)

    return graphimage.wideBytes(
        2
    ) .. graphimage.wideBytes(
        256
    ) .. graphimage.wideBytes(
        32
    ) .. graphimage.wideBytes(64) .. zero .. string.char(1) .. zero:sub(2) .. table.concat(entries)
end
