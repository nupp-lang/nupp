module nupp.core.voidproducer

local ROOT = assert(os.getenv("NUPP_COMPILER_ROOT"))
local front = require("nupp.core.source")
local graph = require("nupp.compiler.vm.graph")
local profile = require("nupp.compiler.vm.nativegraph")
local lower = require("nupp.compiler.vm.lower")
local sink = require("nupp.compiler.s0.nativegraph")
local ir = require("s0.ir")
local allocate = require("s0.allocate")
local allocationcheck = require("s0.allocationcheck")
local selector = require("s0.select")
local shim = require("nupp.core.shim")
local graphimage = require("nupp.compiler.vm.graphimage")
local json = require("serde.json")
local MODULE = "nupp.runtime.core.voidprobe"

export function compile(mode: string): string
    assert(mode == "normal" or mode == "spill")
    local path = ROOT .. "/src/nupp/runtime/core/voidprobe.nupp"
    local owners, options = front.checked(front.read(ROOT .. "/tests/core/void-probe.nupp"), path, MODULE)
    options.abi = "leaf"
    local resolved, names = {}, {}
    for name, owner in pairs(owners) do
        local g = lower.functionGraph(owner, options, profile)
        resolved[MODULE .. "." .. name] = {graph = g, owner = owner}
        names[#names + 1] = name
    end
    table.sort(names)
    assert(#names == 10, "exact void fixture function set")
    local codes, metrics = {}, {}
    for _, name in ipairs(names) do
        local symbol = MODULE .. "." .. name
        local item = resolved[symbol]
        local g, owner = item.graph, item.owner
        local artifact = sink.compilerGraph(g, name, owner, resolved)
        local f = artifact.machine
        assert(artifact.body == owner and artifact.source.path == path, "retained checked void owner")
        local void = g.native.result == "nil"
        assert(#f.signature.results == (void and 0 or 1), "exact machine result arity")
        local zeroCalls, scalarCalls, returns = 0, 0, 0
        for at, op in ipairs(f.op) do
            if op == ir.OP_CALL then
                local signature = f.signatures[f.importSignatures[f.aux[at]]]
                local block = g.blocks[artifact.instructionBlock[at]]
                local operation = artifact.instructionOperation[at]
                assert(block.op[operation] == "NativeLeafCall", "call must retain graph origin")
                local declaration = block.args[operation][1]
                if declaration.result == "nil" then
                    zeroCalls = zeroCalls + 1
                    assert(#signature.results == 0 and block.dst[operation] == 0, "void call has no SSA result")
                    assert(
                        f.result[at] == 0 and f.result2[at] == 0 and f.kind[at] == 0,
                        "void call has no machine result"
                    )
                else
                    scalarCalls = scalarCalls + 1
                    assert(#signature.results == 1 and f.result[at] ~= 0, "scalar call keeps its result")
                    assert(signature.results[1] == (declaration.result == "boolean" and ir.I8 or ir.I64))
                end
            elseif op == ir.OP_RETURN then
                returns = returns + 1
                assert(f.nargs[at] == (void and 0 or 1) and f.result[at] == 0, "void return has no dummy operand")
            end
        end
        assert(returns > 0)
        local target = selector.target()
        if mode == "spill" then
            target.integerRegisters, target.floatRegisters = {}, {}
        end
        local allocation = allocate.run(f, target)
        assert(allocationcheck.run(f, target, allocation))
        local code = selector.run(f, allocation)
        codes[symbol] = code
        metrics[
            #metrics + 1
        ] = {
            name = name,
            result = g.native.result,
            params = g.native.params,
            zeroCalls = zeroCalls,
            scalarCalls = scalarCalls,
            returns = returns,
            resultCount = #f.signature.results,
            frameBytes = code.frameBytes,
            spillSlots = allocation.spillSlots,
            words = #code.words,
            integerRegisters = #target.integerRegisters,
            floatRegisters = #target.floatRegisters,
            source = g.source
        }
    end
    local failures = {}

    local function rejects(name: string, action: function(): any, fragment: string): nil
        local ok, problem = pcall(action)
        assert(
            not ok and tostring(problem):find(fragment, 1, true),
            "void refusal " .. name .. ": " .. tostring(problem)
        )
        failures[#failures + 1] = name
    end

    local caller = resolved[MODULE .. ".chain"]
    local target = resolved[MODULE .. ".storeEmpty"]
    target.graph.native.result = "uint64"
    rejects(
        "changed-target-result",
        function(): any
            return sink.compilerGraph(caller.graph, "chain", caller.owner, resolved)
        end,
        "leaf signature mismatch"
    )
    target.graph.native.result = "nil"
    local body = target.owner.body
    target.owner.body = {}
    rejects(
        "changed-target-body",
        function(): any
            return sink.compilerGraph(caller.graph, "chain", caller.owner, resolved)
        end,
        "checked body identity"
    )
    target.owner.body = body
    local source = target.graph.source.path
    target.graph.source.path = source .. ".changed"
    rejects(
        "changed-target-source",
        function(): any
            return sink.compilerGraph(caller.graph, "chain", caller.owner, resolved)
        end,
        "leaf source mismatch"
    )
    target.graph.source.path = source
    local declaration = graph.nativeLeafDeclaration(target.owner)
    local probe = graph.newNative({"voidptr", "uint64"}, "nil", "leaf")
    local block: any = graph.block(probe)
    assert(graph.emitNative(probe, block, "NativeLeafCall", {declaration, 1, 2}, nil) == nil)
    block.term = {kind = "return", edges = {}}
    graph.verify(probe)
    block.term = {kind = "return", value = 1, edges = {}}
    rejects(
        "void-return-value",
        function(): any
            return graph.verify(probe)
        end,
        "native leaf return kind"
    )
    block.term = {kind = "return", edges = {}}
    local handler = codes[MODULE .. ".CoreVoidProbe"]
    codes[MODULE .. ".CoreVoidProbe"] = nil
    local result = shim.build({handler}, codes)
    result.metrics, result.refusals, result.mode = metrics, failures, mode

    return json.encodevalue(result)
end

export function data(offsetText: string, codeBytesText: string): string
    local offset, bytes = assert(tonumber(offsetText)), assert(tonumber(codeBytesText))
    assert(offset >= 0 and offset < bytes and offset % 4 == 0)
    return graphimage.wideBytes(
        1
    ) .. graphimage.wideBytes(
        256
    ) .. graphimage.wideBytes(
        32
    ) .. graphimage.wideBytes(48) .. string.rep(string.char(0), 16) .. graphimage.wideBytes(offset)
end
