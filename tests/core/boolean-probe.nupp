module nupp.runtime.core.arenaprobe

const native = require("nupp.runtime.vm.intrinsics")
const arena = require("nupp.runtime.core.arena")

export function CoreArenaProbe(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local yes = native.address(ints) ~= 0ULL
    local no = native.address(ints) == 0ULL
    local first = yes or native.load64(native.pointer(0ULL), 0) == 0ULL
    local second = no and native.load64(native.pointer(0ULL), 0) == 0ULL
    if first == false or second == true then
        return 1ULL
    end
    local offset = 0ULL
    while offset < 128ULL do
        native.store64(ints, native.index(offset), 0ULL)
        offset = offset + 8ULL
    end
    local base = native.address(ints) + 512ULL
    local mark = native.offset(ints, 64)
    local skippedOr = yes or arena.initialize(ints, base, 512ULL) == 1ULL
    local skippedAnd = no and arena.initialize(ints, base, 512ULL) == 1ULL
    if skippedOr == false or skippedAnd == true or native.load64(ints, 0) ~= 0ULL then
        return 2ULL
    end
    local takenOr = no or arena.initialize(ints, base, 512ULL) == 1ULL
    local takenAnd = yes and arena.reserve(ints, 8ULL, 8ULL, mark) == 1ULL
    if takenOr == false or takenAnd == false or native.load64(ints, 24) ~= 1ULL then
        return 3ULL
    end
    local other = native.offset(ints, 128)
    local skipAgainOr = yes or arena.reserve(ints, 8ULL, 8ULL, other) == 1ULL
    local skipAgainAnd = no and arena.reserve(ints, 8ULL, 8ULL, other) == 1ULL
    if skipAgainOr == false or skipAgainAnd == true or native.load64(ints, 24) ~= 1ULL then
        return 4ULL
    end
    if arena.release(ints, mark) ~= 1ULL then
        return 5ULL
    end

    return 0ULL
end
