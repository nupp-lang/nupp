module nupp.core.catalognested

local function outer(value: boolean): boolean
    local function middle(input: boolean): boolean
        local function inner(last: boolean): boolean
            return last
        end

        return inner(input)
    end

    return middle(value)
end

-- Graph profiles before version 8 have no tables to export from, so the
-- module value is the result itself.
export = outer(true)
