module nupp.core.catalogcallsleadingnils

-- Results led by nils keep their positions: a fourth result after three nils
-- is still the fourth, called directly, through a tail call and through a
-- checked function value. Each kept position is a bit.
local record Failure
    code: string
end

local function envelope(made: boolean): (string?, integer?, Failure?, any)
    if made then
        return nil, nil, nil, {kind = "envelope"}
    end

    return "quoted", 1, nil, nil
end

local function forward(made: boolean): (string?, integer?, Failure?, any)
    return envelope(made)
end

local score = 0
local quoted, kind, failure, carried = envelope(true)
if quoted == nil and kind == nil and failure == nil and type(carried) == "table" and carried.kind == "envelope" then
    score = score | 1
end
quoted, kind, failure, carried = forward(true)
if quoted == nil and kind == nil and failure == nil and type(carried) == "table" and carried.kind == "envelope" then
    score = score | 2
end
local through: any = forward
quoted, kind, failure, carried = through(true)
if quoted == nil and kind == nil and failure == nil and type(carried) == "table" and carried.kind == "envelope" then
    score = score | 4
end
quoted, kind, failure, carried = forward(false)
if quoted == "quoted" and kind == 1 and failure == nil and carried == nil then
    score = score | 8
end
export const result = score
