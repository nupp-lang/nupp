export function RejectReturnUnknownCall(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    ctx: voidptr,
    frame: voidptr
): uint64
    local extent = native.word(native.load32(pc, 4))
