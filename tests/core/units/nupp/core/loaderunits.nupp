module nupp.core.loaderunits

-- These are kernel cdefs: selection resolves them before their native calls,
-- without going through the guest FOREIGN_CALL handler.
cdef function nuppbridgefixture(left: uint64, right: uint64): uint64 from"@lib/libnuppbridgefixture.dylib"
cdef function nuppbridgeslash(left: uint64, right: uint64): uint64 from"@/lib/libnuppbridgefixture.dylib"

export function plain(left: uint64, right: uint64): uint64
    return nuppbridgefixture(left, right) + nuppbridgefixture(0ULL, 1ULL)
end

export function slashed(left: uint64, right: uint64): uint64
    return nuppbridgeslash(left, right) + nuppbridgeslash(0ULL, 1ULL)
end
