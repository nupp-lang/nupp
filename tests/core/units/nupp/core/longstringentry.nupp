module nupp.core.longstringentry

const native = require("nupp.runtime.vm.intrinsics")
const os = require("nupp.runtime.vm.os")
const heap = require("nupp.runtime.vm.heap")
const collector = require("nupp.runtime.vm.collector")
const pages = require("nupp.runtime.core.pagemappings")
const servicescope = require("nupp.runtime.core.servicescope")
const tables = require("nupp.runtime.core.coretables")
const entry = require("nupp.core.releasequeueentry")

export function prepare(base: voidptr, bytes: uint64): uint64
    return entry.prepare(base, bytes)
end

local function bit(ok: boolean, flag: uint64): uint64
    if ok then
        return flag
    end
    return 0ULL
end

-- Inspect the exact failure state before this test-only observer clears the
-- sticky error for explicit teardown. Production never resumes a failed call.
export function finish(scope: voidptr): uint64
    @unsafe do
        local failure = native.load64(scope, native.fieldOffset<servicescope.ServiceScope>("error"))
        native.store64(scope, native.fieldOffset<servicescope.ServiceScope>("error"), 0ULL)
        local extra = native.sizeOf<servicescope.ServiceScope>()
        local h = native.pointer(native.load64(scope, native.index(extra))) as heap.Heap*
        local mode = native.load64(scope, native.index(extra + 24ULL))
        local answer = bit(failure == 1ULL, 1ULL)
        if mode == 0ULL then
            answer = answer | bit(h.liveCount == 0ULL and h.liveBytes == 0ULL and h.debt == 0ULL, 2ULL)
            answer = answer | bit(h.released.count == 0ULL and h.released.capacity == 0ULL, 4ULL)
        elseif mode == 1ULL or mode == 2ULL then
            answer = answer | bit(h.liveCount == 1ULL and h.liveBytes == heap.corestringextent(), 2ULL)
            answer = answer | bit(h.released.count == 0ULL, 4ULL)
            if mode == 1ULL then
                answer = answer | bit(h.debt == 0xffffffffffffffffULL, 8ULL)
            else
                answer = answer | bit(h.debt == heap.corestringextent(), 8ULL)
            end
            h.debt = 0ULL
            collector.fullCycle(h)
            answer = answer | bit(h.liveCount == 0ULL and h.liveBytes == 0ULL and h.released.count == 0ULL, 16ULL)
        else
            local block = native.pointer(native.load64(scope, native.index(extra + 32ULL)))
            local target = native.pointer(native.load64(scope, native.index(extra + 40ULL))) as heap.Header*
            local other = native.load64(scope, native.index(extra + 48ULL))
            answer = answer | bit(h.liveCount == 0ULL and h.liveBytes == 0ULL, 2ULL)
            answer = answer | bit(native.load64(scope, native.index(extra + 56ULL)) == 2ULL, 4ULL)
            if mode == 3ULL then
                answer = answer | bit(h.released.count == 1ULL and heap.wordAt(h.released, 0ULL) == other, 8ULL)
                answer = answer | bit(heap.corestringtail(target).block == 0ULL and target.auxLen == 0ULL, 16ULL)
                answer = answer
                    | bit(
                        pages.sharedreferences(block) == 0ULL
                        and native.load64(
                            block,
                            native.fieldOffset<pages.SharedBacking>("phase")
                        ) == pages.SHARED_FAILED,
                        32ULL
                    )
            else
                answer = answer
                    | bit(
                        h.released.count == 2ULL and heap.wordAt(h.released, 1ULL) == native.address(target as voidptr),
                        8ULL
                    )
                answer = answer
                    | bit(heap.corestringtail(target).block == native.address(block) and target.auxLen == 130ULL, 16ULL)
                answer = answer | bit(pages.sharedcompare(block, 0ULL, 1ULL) == 0ULL, 32ULL)
            end
            tables.drain(h)
            answer = answer | bit(h.released.count == 0ULL, 64ULL)
        end
        heap.destroy(h)
        os.unmapPages(
            native.pointer(native.load64(scope, native.index(extra + 8ULL))),
            native.load64(scope, native.index(extra + 16ULL))
        )
        answer = answer | bit(servicescope.close(scope) == 1ULL, 128ULL)
        return answer
    end
end
