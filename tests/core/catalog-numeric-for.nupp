module nupp.core.catalognumericfor

local squares = 0
for i = 1, 10 do
    squares = squares + i * i
end
local down = 0
for i = 10, 1, -3 do
    down = down + i
end
local none = 0
for i = 5, 1 do
    none = none + 1
end
local mixed = 0
for i = 1, 20 do
    mixed = (mixed + i * i * 7) % 1003
end
local i: integer = 3
local shadow = 0
for i = i, i + 2 do
    shadow = shadow + i
end
local negative = -7 % 3 + 7 % -3 * 10
-- Graph profiles before version 8 have no tables to export from, so the
-- module value is the result itself.
export = (((squares * 100 + down) * 100 + none * 10 + mixed) * 1000 + shadow * 10 + i) * 100 + negative
