module nupp.core.physicalproducer

local ROOT = assert(os.getenv("NUPP_COMPILER_ROOT"))
local front = require("nupp.core.source")
local graph = require("nupp.compiler.vm.graph")
local profile = require("nupp.compiler.vm.nativegraph")
local lower = require("nupp.compiler.vm.lower")
local physical = require("nupp.compiler.vm.nativephysical")
local sink = require("nupp.compiler.s0.nativegraph")
local allocate = require("nupp.compiler.s0.allocate")
local allocationcheck = require("nupp.compiler.s0.allocationcheck")
local selector = require("nupp.compiler.s0.select")
local shim = require("nupp.core.shim")
local graphimage = require("nupp.compiler.vm.graphimage")
local json = require("serde.json")
local MODULE = "nupp.runtime.core.physicalprobe"

export function compile(mode: string): string
    assert(mode == "normal" or mode == "spill")
    local path = ROOT .. "/src/nupp/runtime/core/physicalprobe.nupp"
    local owners, options = front.checked(front.read(ROOT .. "/tests/core/physical-probe.nupp"), path, MODULE)
    options.abi, options.physicalTarget = "leaf", "aarch64-apple-darwin"
    local resolved, names = {}, {}
    for name, owner in pairs(owners) do
        local g = lower.functionGraph(owner, options, profile)
        graph.verify(g)
        graph.prune(g)
        graph.verify(g)
        resolved[MODULE .. "." .. name] = {graph = g, owner = owner}
        names[#names + 1] = name
    end
    table.sort(names)
    assert(#names == 5, "exact physical fixture function set")
    local codes, metrics = {}, {}
    for _, name in ipairs(names) do
        local symbol = MODULE .. "." .. name
        local item = resolved[symbol]
        local g, owner = item.graph, item.owner
        local views, fields, calls = 0, 0, 0
        for _, block in ipairs(g.blocks) do
            for at, op in ipairs(block.op) do
                if op == "NativePointerView" then
                    local contract = block.args[at][2]
                    assert(physical.validateCast(contract))
                    assert(contract.source.pointee == nil and contract.target.pointee.name == "Words")
                    assert(block.args[at][1] ~= block.dst[at], "pointer view needs distinct SSA identity")
                    views = views + 1
                elseif op == "NativeFieldLoad" then
                    local args = block.args[at]
                    assert(#args == 2 and physical.validateField(args[2]))
                    local access = args[2]
                    assert(
                        (access.name == "base" or access.name == "count")
                        and access.width == 8
                        and not access.signed
                        and not access.write
                    )
                    assert(
                        access.offset == access.layout.offsets[access.name]
                        and access.receiver == g.nativePhysical.values[args[1]]
                    )
                    fields = fields + 1
                elseif op == "NativeLeafCall" then
                    calls = calls + 1
                end
            end
        end
        local artifact = sink.compilerGraph(g, name, owner, resolved)
        assert(artifact.body == owner and artifact.source.path == path, "retained checked physical owner")
        local f = artifact.machine
        local target = selector.target()
        if mode == "spill" then
            target.integerRegisters, target.floatRegisters = {}, {}
        end
        local allocation = allocate.run(f, target)
        assert(allocationcheck.run(f, target, allocation))
        local code = selector.run(f, allocation)
        codes[symbol] = code
        metrics[
            #metrics + 1
        ] = {
            name = name,
            fields = fields,
            views = views,
            calls = calls,
            params = g.native.params,
            frameBytes = code.frameBytes,
            spillSlots = allocation.spillSlots,
            words = #code.words,
            integerRegisters = #target.integerRegisters,
            floatRegisters = #target.floatRegisters,
            source = g.source
        }
    end
    local other = lower.functionGraph(
        owners.read,
        {abi = "leaf", physicalTarget = "wasm32-unknown-emscripten"},
        profile
    )
    graph.verify(other)
    local ok, problem = pcall(function(): any
        return sink.compilerGraph(other, "read", owners.read, resolved)
    end)
    assert(
        not ok and tostring(problem):find("physical graph requires explicit owned ARM64 target", 1, true),
        "supported utility target must not authorize ARM64 emission"
    )
    local handler = codes[MODULE .. ".CorePhysicalProbe"]
    codes[MODULE .. ".CorePhysicalProbe"] = nil
    local result = shim.build({handler}, codes)
    result.metrics, result.mode, result.physicalTarget = metrics, mode, options.physicalTarget
    result.refusals = {"wrong-supported-target"}

    return json.encodevalue(result)
end

export function data(offsetText: string, codeBytesText: string): string
    local offset, bytes = assert(tonumber(offsetText)), assert(tonumber(codeBytesText))
    assert(offset >= 0 and offset < bytes and offset % 4 == 0)
    return graphimage.wideBytes(
        1
    ) .. graphimage.wideBytes(
        256
    ) .. graphimage.wideBytes(
        32
    ) .. graphimage.wideBytes(48) .. string.rep(string.char(0), 16) .. graphimage.wideBytes(offset)
end
