module nupp.core.catalogerrorstexts

-- Runtime error messages as Lua words them, each caught by pcall: the text
-- after the position, without the variable Lua names after it.
local function says(ok: boolean, message: string, text: string): boolean
    return not ok and string.find(message, text, 1, true) ~= nil
end

local t: {[integer]: integer} = {}
local none: integer? = nil
local missing: {[string]: integer}? = nil
local absent: (function(): integer)? = nil
local key: integer? = nil
local zero: integer = 0
local score: integer = 0
local ok1, e1 = pcall(function(): integer
    return (t[1] as integer) + 1
end)
if says(ok1, tostring(e1), "attempt to perform arithmetic on a nil value") then
    score = score + 1
end
local ok2, e2 = pcall(function(): boolean
    return (none as integer) < 1
end)
if says(ok2, tostring(e2), "attempt to compare nil with number") then
    score = score + 2
end
local ok3, e3 = pcall(function(): integer
    return #(missing as {[string]: integer})
end)
if says(ok3, tostring(e3), "attempt to get length of a nil value") then
    score = score + 4
end
local ok4, e4 = pcall(function(): integer
    return (missing as {[string]: integer}).x or 0
end)
if says(ok4, tostring(e4), "attempt to index a nil value") then
    score = score + 8
end
local ok5, e5 = pcall(function(): integer
    return (absent as function(): integer)()
end)
if says(ok5, tostring(e5), "attempt to call a nil value") then
    score = score + 16
end
local ok6, e6 = pcall(function(): integer
    t[key as integer] = 1
    return 0
end)
if says(ok6, tostring(e6), "table index is nil") then
    score = score + 32
end
local ok7, e7 = pcall(function(): integer
    return 5 % zero
end)
if says(ok7, tostring(e7), "attempt to perform 'n%0'") then
    score = score + 64
end
export const result = score
