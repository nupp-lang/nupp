module nupp.core.cataloglibraryresults

-- Library calls given a call with several results last, or `...` as comptime's
-- bounded adapters spread it: Lua passes every value, so each call goes through
-- the library function's value. Each check is a bit of the score.
local score = 0
local bit = 1

-- Whether `text` is a message that ends with `suffix`, as one positioned at
-- the line that raised it does.
local function ends(text: any, suffix: string): boolean
    return type(text) == "string" and string.sub(text as string, -#suffix) == suffix
end

local function check(ok: boolean): nil
    if ok then
        score = score | bit
    end
    bit = bit << 1
end

local function bounds(): (integer, integer)
    return 2, 3
end

local function failing(): (any, string)
    return nil, "why"
end

-- One nil, as a call that answers its arguments gives it.
local function only(...: any): ...any
    return ...
end

local function pair(): (string, integer)
    return "one", 2
end

local function digits(): (string, integer)
    return "ff", 16
end

local function count(): (integer, string)
    return 2, "-"
end

-- Every result of assert, through an open return.
local function both(): ...any
    return assert(pair())
end

local closed: integer = 0

local record Token is own.Closeable
    function close(takes self): nil
        closed = closed + 1
    end
end

local function open(ok: boolean): (Token?, string?)
    if ok then
        return Token(), nil
    end

    return nil, "no token"
end

-- An owner assert answers from the results it was given, closed once.
local function held(): integer
    local token = assert(open(true))
    token:close()

    return closed
end

local function missing(): nil
    local token = assert(open(false))
    token:close()
end

do
    check(string.sub("hello", bounds()) == "el")
    local ok, message = pcall(function()
        assert(failing())
    end)
    check(not ok and message == "why")
    local bare, said = pcall(function()
        assert(only(nil))
    end)
    check(not bare and said == "assertion failed!")
    local first, second = assert(pair())
    check(first == "one" and second == 2)
    check(tonumber(digits()) == 255)
    check(tonumber(("n=42"):match("(%d+)")) == 42)
    check(string.char(table.unpack({104, 105, 33})) == "hi!")
    local caught, reason = pcall(function()
        assert(pcall(error, "bad", 0))
    end)
    check(not caught and reason == "bad")
    check(string.rep("ab", count()) == "ab-ab")
    check(select("#", both()) == 2)
    check(held() == 1)
    local opened, refusal = pcall(missing)
    check(not opened and refusal == "no token" and closed == 1)
    -- error's level counts from the function that called it.
    local positioned, where = pcall(function()
        error(only("boom"))
    end)
    check(not positioned and string.find(tostring(where), ":107: boom", 1, true) ~= nil)
end

local function chars(...: integer): string
    return string.char(...)
end

local function cut(...: any): string
    return string.sub(...)
end

local function biggest(...: number): number
    return math.max(...)
end

local function repeated(...: any): string
    return "<" .. string.rep(...) .. ">"
end

-- Every result of the call, through an open return.
local function bytes(...: any): ...integer
    return string.byte(...)
end

-- Two of its results, kept as locals.
local function bytepair(...: any): boolean
    local first, second = string.byte(...)

    return first == 104 and second == 105
end

local function show(...: any): string
    return tostring(...)
end

local function fail(...: any): nil
    error(...)
end

do
    check(chars(104, 105) == "hi")
    check(cut("hello", 2, 3) == "el")
    check(chars() == "")
    check(biggest(3, 9, 4) == 9)
    check(repeated("ab", 3) == "<ababab>")
    local first, second, third = bytes("hi!", 1, 3)
    check(first == 104 and second == 105 and third == 33)
    check(bytepair("hi", 1, 2))
    check(show(42) == "42")
    local ok, message = pcall(fail, "boom", 0)
    check(not ok and message == "boom")
    local raised = pcall(chars, 256)
    check(not raised)
end

export const result = score
