module nupp.core.catalogcbridge

-- Both spellings resolve against the artifact, independent of the process cwd.
cdef function nuppbridgefixture(left: uint64, right: uint64): uint64 from"@lib/libnuppbridgefixture.dylib"
cdef function nuppbridgemissing(): int32 from"@lib/libnuppbridgeabsent.dylib"
cdef function nuppbridgemissingsymbol(): int32 from"@lib/libnuppbridgefixture.dylib"
local score = 0
-- A failed first lookup rolls back its fresh owner. A later successful call
-- opens the library again, without inheriting the failed dlsym's error.
local missing, detail = pcall(function(): any
    return nuppbridgemissingsymbol()
end)
if not missing and tostring(detail):find("symbol", 1, true) ~= nil then
    score = score + 8
end
if nuppbridgefixture(0x55ULL, 0xaaULL) == 0xffULL then
    score = score + 1
end
if nuppbridgefixture(0xffffffffffffffffULL, 0x1234ULL) == 0xffffffffffffedcbULL then
    score = score + 2
end
local ok, problem = pcall(function(): any
    return nuppbridgemissing()
end)
if not ok and tostring(problem):find("library", 1, true) ~= nil then
    score = score + 4
end
-- A failed lookup in an already owned library must not unload cached code.
missing, detail = pcall(function(): any
    return nuppbridgemissingsymbol()
end)
if not missing and tostring(detail):find("symbol", 1, true) ~= nil then
    score = score + 16
end
if nuppbridgefixture(0x55ULL, 0xaaULL) == 0xffULL then
    score = score + 32
end
export const result = score
