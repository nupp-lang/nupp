module nupp.core.ownerviewchecks

-- Source/descriptor checks called with the existing fixed service.build()
-- result. No allocator execution or arbitrary service registration occurs.
local graph = require("nupp.compiler.vm.graph")
local profile = require("nupp.compiler.vm.nativegraph")
local physical = require("nupp.compiler.vm.nativephysical")
local service = require("nupp.compiler.vm.nativeservice")
local unit = require("nupp.compiler.vm.nativeunit")

local function refuses(action: function(): nil): nil
    local ok = pcall(action)
    assert(not ok, "mutated owner view accepted")
end

export function check(build: any): boolean
    local arena: any = nil
    for _, owner in ipairs(service.owners(build.catalog)) do
        if owner.scope.name == "nupp.runtime.vm.arena" then
            arena = owner.scope
        end
    end
    assert(arena)
    local close = arena.exports.close
    local context = unit.ownerContext(close)
    local capability = service.signature(close, service.options(build.catalog, close))
    local declaration = graph.nativeLeafDeclaration(close, context, nil, nil, capability)
    local signature = declaration.physical
    local source = signature.params[1]
    local field = close.body.body.stats[1].exprs[1]
    assert(field.kind == "dotIndex" and field.obj.token.definition == close.parameterDefinitions[1])
    assert(field.obj.inferredType == source.checkedType and source.checkedType.tag == "affine")
    local view = physical.ownerView(close, source, field.obj, signature)
    assert(view.source == source and view.target ~= source and view.target.checkedType.tag == "borrowed")
    assert(view.target.checkedType.inner == source.checkedType.inner)
    assert(source.checkedType == close.parameterTypes[1] and not physical.dependent(source))
    physical.validateCast(view)
    physical.validateField(physical.field(view.target, field, false, signature, close))

    -- The actual profile emits a new SSA view; its original takes/cleanup
    -- operand remains affine and the field load uses only the new result.
    local values, ops = {[1] = source}, {}
    local ctx: any = {fn = close, g = {nativePhysical = {values = values, signature = signature}}}
    ctx.expression = function(node: any, kind: string): integer
        assert(node == field.obj and kind == "voidptr")
        return 1
    end
    ctx.emit = function(node: any, op: string, args: any, kind: string): integer
        ops[#ops + 1] = {op = op, args = args}
        return #ops + 1
    end
    assert(profile.fieldRead(ctx, field, "voidptr") == 3)
    assert(ops[1].op == "NativePointerView" and ops[1].args[1] == 1)
    assert(ops[2].op == "NativeFieldLoad" and ops[2].args[1] == 2)
    assert(values[1] == source and values[2].checkedType.tag == "borrowed")
    assert(source.checkedType.tag == "affine")

    refuses(function(): nil
        physical.ownerView(close, physical.describe(context, source.checkedType), field.obj, signature)
    end)
    local other = graph.nativeLeafDeclaration(close, context, nil, nil, capability).physical
    assert(not physical.sameValue(source, other.params[1]))
    local copied = physical.copyValue({}, source)
    assert(physical.sameValue(source, copied))
    physical.validateCast(physical.ownerView(close, copied, field.obj, signature))
    refuses(function(): nil
        physical.ownerView(close, other.params[1], field.obj, signature)
    end)
    local saved = view.source
    view.source = other.params[1]
    refuses(function(): nil
        physical.validateCast(view)
    end)
    view.source = saved
    local definition = field.obj.token.definition
    field.obj.token.definition = close.definition
    refuses(function(): nil
        physical.validateCast(view)
    end)
    field.obj.token.definition = definition
    local facts = field.obj.capabilityFacts
    field.obj.capabilityFacts = {roots = {{definition = close.definition}}}
    refuses(function(): nil
        physical.field(view.target, field, false, signature, close)
    end)
    field.obj.capabilityFacts = facts
    local checked = view.target.checkedType
    view.target.checkedType = source.checkedType
    refuses(function(): nil
        physical.validateCast(view)
    end)
    view.target.checkedType = checked
    physical.validateCast(view)

    -- Actual checked constructor call identity remains part of the source
    -- origin. Replacing its callee token cannot reuse a same-layout result.
    local open, target = arena.exports.open, arena.functions.openWith
    local call = open.body.body.stats[1].exprs[1]
    local targetCapability = service.signature(target, service.options(build.catalog, target))
    local called = graph.nativeLeafDeclaration(target, context, call, open, targetCapability).physical
    physical.validateSignature(called)
    local callee = call.obj.token.definition
    call.obj.token.definition = arena.exports.openGrowable.definition
    refuses(function(): nil
        physical.validateSignature(called)
    end)
    call.obj.token.definition = callee
    physical.validateSignature(called)
    local opening = graph.nativeLeafDeclaration(
        open,
        context,
        nil,
        nil,
        service.signature(open, service.options(build.catalog, open))
    ).physical
    assert(not physical.returnValue(opening, view.target))
    refuses(function(): nil
        physical.argument(source, view.target)
    end)

    return true
end
