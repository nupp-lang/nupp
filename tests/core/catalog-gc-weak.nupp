module nupp.core.cataloggcweak

-- Weak tables (`__mode`) as Lua 5.5 clears them. Each case builds its
-- objects in a function of its own, so no register of the function that
-- collects holds one, and drops what it holds through a table's field, and
-- each checks only what holds whenever collections run: an entry naming an
-- object only weak entries reach is gone after a full collection, and one
-- naming a held object, a string, a number or a boolean never goes. A
-- storage view is a collectable object here, not a string (the core numbers
-- it as the VM numbers a string slice).
local calls = require("nupp.runtime.storagecalls")

local function count(t: any): integer
    local n: integer = 0
    for _ in pairs(t) do
        n = n + 1
    end

    return n
end

-- Weak values: in the array and hash parts, an object nothing else holds
-- goes; a held one, a string, a number and a boolean stay.
local function weakValues(held: any): any
    local t: any = setmetatable({}, {__mode = "v"})
    t[1] = {}
    t[2] = held
    t[3] = {}
    t.text = string.rep("t", 3)
    t.number = 42
    t.flag = true
    t.gone = {}

    return t
end

-- Weak keys: an entry whose key nothing else holds goes, value and all; a
-- held key's, a string key's and a number key's stay.
local function weakKeys(held: any): any
    local t: any = setmetatable({}, {__mode = "k"})
    t[held] = {}
    t[{}] = {}
    t.name = {}
    t[7] = {}

    return t
end

-- An ephemeron chain: each value holds the next entry's key, and the first
-- key is held through `holder`.
local function chain(holder: any, length: integer): any
    local t: any = setmetatable({}, {__mode = "k"})
    local key: any = {}
    holder.first = key
    for _ = 1, length do
        local after: any = {}
        t[key] = {next = after}
        key = after
    end
    t[key] = {}

    return t
end

-- Values that reach only their own keys.
local function selfish(): any
    local t: any = setmetatable({}, {__mode = "k"})
    for _ = 1, 5 do
        local key: any = {}
        t[key] = {key}
    end

    return t
end

-- Both sides weak: either side dead takes the entry.
local function both(held: any): any
    local t: any = setmetatable({}, {__mode = "kv"})
    t[{}] = held
    t[held] = {}
    t.name = held
    t[held] = "text" .. tostring(2)
    t[{}] = "kept only by a dead key"

    return t
end

-- A view of storage (`cast` makes one) as a weak value: collectable, so
-- cleared.
local function views(block: any): any
    local t: any = setmetatable({}, {__mode = "v"})
    -- The view is stored for the collector to clear, not used after.
    @unsafe do
        t[1] = calls.cast(block, 1)
    end
    t[2] = block

    return t
end

-- Any letters around "k": weak keys still.
local function lettered(): any
    local t: any = setmetatable({}, {__mode = "xk?"})
    t[{}] = 1
    return t
end

-- setmetatable(t, nil) makes a weak table strong again.
local function strengthened(): any
    local t: any = setmetatable({}, {__mode = "v"})
    t[1] = {}
    setmetatable(t, nil)
    return t
end

local score = 0
local held: any = {}
local values = weakValues(held)
local keys = weakKeys(held)
local holder: any = {}
local links = chain(holder, 20)
local own = selfish()
local sides = both(held)
local block: any = calls.allocbytes(8)
local viewed = views(block)
local marked = lettered()
local strong = strengthened()
collectgarbage()
collectgarbage()
if values[1] == nil
    and values[2] == held
    and values[3] == nil
    and values.gone == nil
    and values.text == "ttt"
    and values.number == 42
    and values.flag == true
then
    score = score + 1
end
if count(keys) == 3 and keys[held] ~= nil and type(keys.name) == "table" and type(keys[7]) == "table" then
    score = score + 2
end
if count(links) == 21 then
    score = score + 4
end
holder.first = nil
collectgarbage()
collectgarbage()
if count(links) == 0 then
    score = score + 8
end
if count(own) == 0 then
    score = score + 16
end
if count(sides) == 2 and sides.name == held and sides[held] == "text2" then
    score = score + 32
end
if viewed[1] == nil and viewed[2] == block then
    score = score + 64
end
if count(marked) == 0 then
    score = score + 128
end
if type(strong[1]) == "table" then
    score = score + 256
end
export const result = score
