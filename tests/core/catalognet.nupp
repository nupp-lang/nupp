module nupp.core.catalognet

const net = require("nupp.vm.net")
const public = require("io.net")
const bytes = require("bytes")
const system = require("nupp.runtime.provider.coresystem")

local function exchange(listener: integer, request: integer): nil
    local client: integer? = nil
    local server: integer? = nil
    for _ = 1, 500 do
        if client == nil then
            local connected, problem = net.connectPoll(request)
            assert(problem == nil, problem)
            client = connected
        end
        if server == nil then
            local accepted, problem = net.accept(listener)
            assert(problem == nil, problem)
            server = accepted
        end
        if client ~= nil and server ~= nil then
            break
        end
        net.sleep(2)
    end
    const connected = assert(client)
    const accepted = assert(server)
    net.closeConnect(request)
    assert(net.write(connected, "socket") == 6)
    assert(net.shutdownWrite(connected))
    local message = ""
    for _ = 1, 500 do
        message = message .. assert(net.read(accepted, 6))
        if net.ended(accepted) then
            break
        end
        net.sleep(2)
    end
    assert(message == "socket" and net.ended(accepted))
    net.closeStream(connected)
    net.closeStream(accepted)
end

local function localSocket(): nil
    if system.platform == "windows" then
        local handle, reason = net.listenPath("a-local-socket", 4)
        assert(handle == nil and reason ~= nil)

        return
    end
    const path = os.tmpname()
    assert(os.remove(path))
    const listener = assert(net.listenPath(path, 4))
    const request = assert(net.connectPath(path, 2000))
    exchange(listener, request)
    net.closeListener(listener)
    assert(os.remove(path))
end

local function datagram(): nil
    const left = assert(public.bind({host = "127.0.0.1", port = 0}))
    const right = assert(public.bind({host = "127.0.0.1", port = 0}))
    const buffer = bytes.Buffer.create(16)
    const peer = {host = "127.0.0.1", port = right:port()}
    assert(left:sendto(peer, ""))
    const empty = assert(right:receivefrom(buffer, 3))
    assert(empty.len == 0 and not empty.truncated and empty.address.port == left:port())
    assert(left:sendto(peer, "ab\0cdef"))
    const prefix = assert(right:receivefrom(buffer, 4))
    assert(prefix.len == 4 and prefix.truncated and buffer:readstring(0, 4) == "ab\0c")
    buffer:close()
    right:close()
    left:close()
end

local function halfClose(): nil
    const listener = assert(public.listen({host = "127.0.0.1", port = 0}))
    const client = assert(public.connect({host = "127.0.0.1", port = listener:port()}))
    const server = assert(listener:accept())
    assert(client:write("x"))
    assert(client:shutdownwrite())
    assert(server:read(1) == "x")
    assert(server:read(1) == "" and server:isended())
    assert(server:write("y"))
    assert(client:read(1) == "y")
end

local function run(): integer
    const listener = assert(net.listen("127.0.0.1", 0, 4, false))
    const port = net.listenerPort(listener)
    assert(port > 0)
    const request = assert(net.connect("localhost", port, 2000))
    exchange(listener, request)
    localSocket()
    datagram()
    halfClose()
    -- The entry retires the remaining listener before releasing backing.

    return 7
end

export const result = run()
