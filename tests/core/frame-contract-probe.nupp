export function RejectJoinFailure(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    ctx: voidptr,
    frame: voidptr
): uint64
    local extent = native.word(native.load32(pc, 4))
    local offset = native.load64(pc, 8)
    local helper = native.offset(ctx, native.index(offset))
    local child = setup(ints, pc, floats, helper, extent)
    if child == 0ULL then
        return native.fail()
    end
    local caller = native.pointer(access.active(ints))
    local published = frames.publish(ints, caller, native.pointer(child), 0ULL)
    if published == 1ULL then
        local observed = published
    end
    local current = native.pointer(access.active(ints))
    local currentPC = native.pointer(access.pc(ints, current))
    local currentValues = native.pointer(access.values(ints, current))
    local currentIntegers = native.pointer(access.integers(ints, current))
    local currentFloats = native.pointer(access.floats(ints, current))
    access.refresh(ints, current, ctx)

    return native.dispatch(currentPC, currentValues, currentIntegers, currentFloats, ctx, current)
end

export function RejectRefreshBeforePublish(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    ctx: voidptr,
    frame: voidptr
): uint64
    local extent = native.word(native.load32(pc, 4))
    local offset = native.load64(pc, 8)
    local helper = native.offset(ctx, native.index(offset))
    local child = setup(ints, pc, floats, helper, extent)
    if child == 0ULL then
        return native.fail()
    end
    local caller = native.pointer(access.active(ints))
    access.refresh(ints, caller, ctx)
    local published = frames.publish(ints, caller, native.pointer(child), 0ULL)
    if published ~= 1ULL then
        return native.fail()
    end
    local current = native.pointer(access.active(ints))
    local currentPC = native.pointer(access.pc(ints, current))
    local currentValues = native.pointer(access.values(ints, current))
    local currentIntegers = native.pointer(access.integers(ints, current))
    local currentFloats = native.pointer(access.floats(ints, current))

    return native.dispatch(currentPC, currentValues, currentIntegers, currentFloats, ctx, current)
end

export function RejectUnknownCall(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    ctx: voidptr,
    frame: voidptr
): uint64
    local extent = native.word(native.load32(pc, 4))
    local offset = native.load64(pc, 8)
    local helper = native.offset(ctx, native.index(offset))
    local child = setup(ints, pc, floats, helper, extent)
    if child == 0ULL then
        return native.fail()
    end
    local caller = native.pointer(access.active(ints))
    local published = frames.publish(ints, caller, native.pointer(child), 0ULL)
    touch(ints)
    if published ~= 1ULL then
        return native.fail()
    end
    local current = native.pointer(access.active(ints))
    local currentPC = native.pointer(access.pc(ints, current))
    local currentValues = native.pointer(access.values(ints, current))
    local currentIntegers = native.pointer(access.integers(ints, current))
    local currentFloats = native.pointer(access.floats(ints, current))
    access.refresh(ints, current, ctx)

    return native.dispatch(currentPC, currentValues, currentIntegers, currentFloats, ctx, current)
end

export function CoreFrameTrue(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    ctx: voidptr,
    frame: voidptr
): uint64
    local extent = native.word(native.load32(pc, 4))
    local offset = native.load64(pc, 8)
    local helper = native.offset(ctx, native.index(offset))
    local child = setup(ints, pc, floats, helper, extent)
    if child == 0ULL then
        return native.fail()
    end
    local caller = native.pointer(access.active(ints))
    local published = frames.publish(ints, caller, native.pointer(child), 0ULL)
    if published == 1ULL then
        local current = native.pointer(access.active(ints))
        local currentPC = native.pointer(access.pc(ints, current))
        local currentValues = native.pointer(access.values(ints, current))
        local currentIntegers = native.pointer(access.integers(ints, current))
        local currentFloats = native.pointer(access.floats(ints, current))
        access.refresh(ints, current, ctx)
        return native.dispatch(currentPC, currentValues, currentIntegers, currentFloats, ctx, current)
    end

    return native.fail()
end

export function RejectPreparedOffset(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    ctx: voidptr,
    frame: voidptr
): uint64
    local extent = native.word(native.load32(pc, 4))
    local offset = native.load64(pc, 8)
    local helper = native.offset(ctx, native.index(offset))
    local child = setup(ints, pc, floats, helper, extent)
    if child == 0ULL then
        return native.fail()
    end
    local caller = native.pointer(access.active(ints))
    local address = native.offset(native.pointer(child), 8)
    native.store64(ctx, 64, 0ULL)
    local read = native.load64(address, 0)

    return native.fail()
end

export function RejectJoinedFrame(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    ctx: voidptr,
    frame: voidptr
): uint64
    local extent = native.word(native.load32(pc, 4))
    local offset = native.load64(pc, 8)
    local helper = native.offset(ctx, native.index(offset))
    local child = setup(ints, pc, floats, helper, extent)
    if child == 0ULL then
        return native.fail()
    end
    local caller = native.pointer(access.active(ints))
    local published = frames.publish(ints, caller, native.pointer(child), 0ULL)
    local selected = caller
    if published == 1ULL then
        selected = native.pointer(access.active(ints))
    end
    local read = native.load64(selected, 0)

    return native.fail()
end

export function RejectLoadedBeforePublish(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    ctx: voidptr,
    frame: voidptr
): uint64
    local extent = native.word(native.load32(pc, 4))
    local offset = native.load64(pc, 8)
    local helper = native.offset(ctx, native.index(offset))
    local child = setup(ints, pc, floats, helper, extent)
    if child == 0ULL then
        return native.fail()
    end
    local caller = native.pointer(access.active(ints))
    local cached = native.load64(caller, 0)
    local published = frames.publish(ints, caller, native.pointer(child), 0ULL)
    if published ~= 1ULL then
        return native.fail()
    end
    local read = native.load64(native.pointer(cached), 0)

    return native.fail()
end
