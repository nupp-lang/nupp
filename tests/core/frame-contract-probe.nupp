export function RejectStaleFrame(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    ctx: voidptr,
    frame: voidptr
): uint64
    local extent = native.word(native.load32(pc, 4))
    local offset = native.load64(pc, 8)
    local helper = native.offset(ctx, native.index(offset))
    local child = setup(ints, pc, floats, helper, extent)
    if child == 0ULL then
        return native.fail()
    end
    local caller = native.pointer(access.active(ints))
    local published = frames.publish(ints, caller, native.pointer(child), 0ULL)
    if published ~= 1ULL then
        return native.fail()
    end
    local old = access.pc(ints, caller)

    return native.fail()
end

export function RejectStalePC(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    ctx: voidptr,
    frame: voidptr
): uint64
    local extent = native.word(native.load32(pc, 4))
    local offset = native.load64(pc, 8)
    local helper = native.offset(ctx, native.index(offset))
    local child = setup(ints, pc, floats, helper, extent)
    if child == 0ULL then
        return native.fail()
    end
    local caller = native.pointer(access.active(ints))
    local old = native.pointer(access.pc(ints, caller))
    local published = frames.publish(ints, caller, native.pointer(child), 0ULL)
    if published ~= 1ULL then
        return native.fail()
    end
    local current = native.pointer(access.active(ints))
    local currentPC = native.pointer(access.pc(ints, current))
    local currentValues = native.pointer(access.values(ints, current))
    local currentIntegers = native.pointer(access.integers(ints, current))
    local currentFloats = native.pointer(access.floats(ints, current))
    access.refresh(ints, current, ctx)

    return native.dispatch(old, currentValues, currentIntegers, currentFloats, ctx, current)
end

export function RejectStaleWindow(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    ctx: voidptr,
    frame: voidptr
): uint64
    local extent = native.word(native.load32(pc, 4))
    local offset = native.load64(pc, 8)
    local helper = native.offset(ctx, native.index(offset))
    local child = setup(ints, pc, floats, helper, extent)
    if child == 0ULL then
        return native.fail()
    end
    local caller = native.pointer(access.active(ints))
    local old = native.pointer(access.values(ints, caller))
    local published = frames.publish(ints, caller, native.pointer(child), 0ULL)
    if published ~= 1ULL then
        return native.fail()
    end
    local current = native.pointer(access.active(ints))
    local currentPC = native.pointer(access.pc(ints, current))
    local currentValues = native.pointer(access.values(ints, current))
    local currentIntegers = native.pointer(access.integers(ints, current))
    local currentFloats = native.pointer(access.floats(ints, current))
    access.refresh(ints, current, ctx)

    return native.dispatch(currentPC, old, currentIntegers, currentFloats, ctx, current)
end

export function RejectStaleAlias(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    ctx: voidptr,
    frame: voidptr
): uint64
    local extent = native.word(native.load32(pc, 4))
    local offset = native.load64(pc, 8)
    local helper = native.offset(ctx, native.index(offset))
    local child = setup(ints, pc, floats, helper, extent)
    if child == 0ULL then
        return native.fail()
    end
    local caller = native.pointer(access.active(ints))
    local old = native.offset(caller, 8)
    local published = frames.publish(ints, caller, native.pointer(child), 0ULL)
    if published ~= 1ULL then
        return native.fail()
    end
    local read = native.load64(old, 0)

    return native.fail()
end

export function RejectPreparedAfterStore(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    ctx: voidptr,
    frame: voidptr
): uint64
    local extent = native.word(native.load32(pc, 4))
    local offset = native.load64(pc, 8)
    local helper = native.offset(ctx, native.index(offset))
    local child = setup(ints, pc, floats, helper, extent)
    if child == 0ULL then
        return native.fail()
    end
    local caller = native.pointer(access.active(ints))
    native.store64(ctx, 64, 0ULL)
    local stale = native.pointer(child)
    local read = native.load64(native.offset(stale, 8), 0)

    return native.fail()
end

