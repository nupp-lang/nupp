module nupp.runtime.core.framecontractprobe

const native = require("nupp.runtime.vm.intrinsics")
const values = require("nupp.runtime.vm.values")
const arena = require("nupp.runtime.core.arena")
const frames = require("nupp.runtime.core.frames")
const access = require("nupp.runtime.core.frameaccess")
const context = require("nupp.runtime.core.context")

local function info(target: voidptr, code: uint64, identity: uint64): uint64
    native.store64(target, native.fieldOffset<frames.FunctionInfo>("version"), 1ULL)
    native.store64(target, native.fieldOffset<frames.FunctionInfo>("id"), identity)
    native.store64(target, native.fieldOffset<frames.FunctionInfo>("bodyOwner"), code)
    native.store64(target, native.fieldOffset<frames.FunctionInfo>("code"), code)
    native.store64(target, native.fieldOffset<frames.FunctionInfo>("instructionCount"), 1ULL)
    native.store64(target, native.fieldOffset<frames.FunctionInfo>("valueCount"), 8ULL)
    native.store64(target, native.fieldOffset<frames.FunctionInfo>("integerCount"), 8ULL)
    native.store64(target, native.fieldOffset<frames.FunctionInfo>("floatCount"), 8ULL)

    return 1ULL
end

-- The fixed test entry lends two disjoint 2048-byte scratch windows, retained
-- 32-byte code and the actual whole-chain x23 helper extent. These are mapped
-- entry-owned bytes, not arbitrary supplied addresses. State/metadata occupy
-- the first window; the second is the logical frame arena. Neither is a root
-- solely because it was passed through the diagnostic shim's six arguments.
export function setup(state: voidptr, pc: voidptr, pool: voidptr, helper: voidptr, helperBytes: uint64): uint64
    local first, second, spill = native.address(state), native.address(pool), native.address(helper)
    if first == 0ULL
        or second == 0ULL
        or spill == 0ULL
        or helperBytes == 0ULL
        or first > 0xfffffffffffff7ffULL
        or second > 0xfffffffffffff7ffULL
        or helperBytes > 0xffffffffffffffffULL - spill
        or (first < second + 2048ULL and second < first + 2048ULL)
        or (first < spill + helperBytes and spill < first + 2048ULL)
        or (second < spill + helperBytes and spill < second + 2048ULL)
        or native.sizeOf<frames.State>() > 64ULL
        or native.sizeOf<arena.Segment>() > 64ULL
        or native.sizeOf<frames.RootControl>() > 128ULL
        or native.sizeOf<frames.FunctionInfo>() > 128ULL
        or native.sizeOf<frames.WindowPlan>() > 128ULL
    then
        return 0ULL
    end
    local at: uint64 = 0ULL
    while at < 1024ULL do
        native.store64(state, native.index(at), 0ULL)
        at = at + 8ULL
    end
    local segment = native.offset(state, 64)
    local control = native.offset(state, 128)
    local rootInfo, rootPlan = native.offset(state, 256), native.offset(state, 384)
    local childInfo, childPlan = native.offset(state, 512), native.offset(state, 640)
    if arena.initialize(segment, second, 2048ULL) ~= 1ULL then
        return 0ULL
    end
    native.store64(state, native.fieldOffset<frames.State>("limit"), 4ULL)
    native.store64(state, native.fieldOffset<frames.State>("segment"), native.address(segment))
    native.store64(state, native.fieldOffset<frames.State>("helperBase"), spill)
    native.store64(state, native.fieldOffset<frames.State>("helperBytes"), helperBytes)
    local rootFields = info(rootInfo, native.address(pc), 1ULL)
    local childFields = info(childInfo, native.address(pc) + 16ULL, 2ULL)
    if frames.planFixed(rootInfo, rootPlan) ~= 1ULL or frames.planFixed(childInfo, childPlan) ~= 1ULL then
        return 0ULL
    end
    local root = frames.beginRoot(state, control, rootInfo, rootPlan)
    -- beginRoot returns an address, not publish's one-valued success status.
    if root == 0ULL then
        return 0ULL
    end
    local child = frames.prepareFixed(state, native.pointer(root), childInfo, values.NIL, 0ULL, 0ULL, 0ULL, childPlan)

    return child
end

local function touch(state: voidptr): nil
    native.store64(state, native.fieldOffset<frames.State>("lastResultCount"), 0ULL)
end

export function CoreFrameContract(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    ctx: voidptr,
    frame: voidptr
): uint64
    local extent = native.word(native.load32(pc, 4))
    local offset = native.load64(pc, 8)
    local helper = native.offset(ctx, native.index(offset))
    local child = setup(ints, pc, floats, helper, extent)
    if child == 0ULL then
        return native.fail()
    end
    local caller = native.pointer(access.active(ints))
    -- These prepublication reads deliberately exist in the graph. Neither is
    -- forwarded after the transition; negative graph fixtures reuse them.
    local oldCode = access.code(ints, caller)
    local oldPC = access.pc(ints, caller)
    local published = frames.publish(ints, caller, native.pointer(child), 0ULL)
    if published ~= 1ULL then
        return native.fail()
    end
    local current = native.pointer(access.active(ints))
    local currentPC = native.pointer(access.pc(ints, current))
    local currentValues = native.pointer(access.values(ints, current))
    local currentIntegers = native.pointer(access.integers(ints, current))
    local currentFloats = native.pointer(access.floats(ints, current))
    access.refresh(ints, current, ctx)

    return native.dispatch(currentPC, currentValues, currentIntegers, currentFloats, ctx, current)
end

-- Terminal diagnostic only. It observes the actual six tail arguments and
-- derives the State through the real root reservation. It does not implement
-- guest Ret, publish a tagged result, retire frames or admit an image format.
export function CoreFrameCapture(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    ctx: voidptr,
    frame: voidptr
): uint64
    local parent = native.loadPointer(frame, native.fieldOffset<frames.Frame>("previous"))
    local control = native.loadPointer(parent, native.fieldOffset<frames.Frame>("resultOwner"))
    local state = native.loadPointer(control, native.fieldOffset<frames.RootControl>("state"))
    local code = native.load64(frame, native.fieldOffset<frames.Frame>("code"))
    local original = native.pointer(code - 16ULL)
    local helperOffset = native.load64(original, 8)
    if native.load64(state, native.fieldOffset<frames.State>("active")) ~= native.address(frame)
        or native.load64(state, native.fieldOffset<frames.State>("depth")) ~= 2ULL
        or native.load64(parent, native.fieldOffset<frames.Frame>("phase")) ~= frames.WAITING
        or native.load64(frame, native.fieldOffset<frames.Frame>("phase")) ~= frames.ACTIVE
        or native.address(pc) ~= code + native.load64(frame, native.fieldOffset<frames.Frame>("resumePC")) * 16ULL
        or native.address(regs) ~= native.load64(frame, native.fieldOffset<frames.Frame>("values"))
        or native.address(ints) ~= native.load64(frame, native.fieldOffset<frames.Frame>("integers"))
        or native.address(floats) ~= native.load64(frame, native.fieldOffset<frames.Frame>("floats"))
        or native.address(ctx) + helperOffset ~= native.load64(state, native.fieldOffset<frames.State>("helperBase"))
        or native.load64(ctx, context.CODE_START) ~= code
        or native.address(frame) == native.address(regs) - 32ULL
        or native.address(frame) == native.load64(ctx, context.DISPATCH_TABLE)
    then
        return 91ULL
    end

    return 42ULL
end

-- Fixed, source-reviewed negative bodies are compiled but never executed.

export function RejectNoState(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    ctx: voidptr,
    frame: voidptr
): uint64
    local current = access.active(ints)
    return native.fail()
end

export function RejectSetupFailure(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    ctx: voidptr,
    frame: voidptr
): uint64
    local extent = native.word(native.load32(pc, 4))
    local offset = native.load64(pc, 8)
    local helper = native.offset(ctx, native.index(offset))
    local child = setup(ints, pc, floats, helper, extent)
    if child ~= 0ULL then
        return native.fail()
    end
    local current = access.active(ints)

    return native.fail()
end

export function RejectNoSuccess(
