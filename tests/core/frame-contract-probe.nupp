    local offset = native.load64(pc, 8)
    local helper = native.offset(ctx, native.index(offset))
    local child = setup(ints, pc, floats, helper, extent)
    if child == 0ULL then
        return native.fail()
    end
    local caller = native.pointer(access.active(ints))
    local published = frames.publish(ints, caller, native.pointer(child), 0ULL)
    local current = native.pointer(access.active(ints))
    local currentPC = native.pointer(access.pc(ints, current))
    local currentValues = native.pointer(access.values(ints, current))
    local currentIntegers = native.pointer(access.integers(ints, current))
    local currentFloats = native.pointer(access.floats(ints, current))
    access.refresh(ints, current, ctx)

    return native.dispatch(currentPC, currentValues, currentIntegers, currentFloats, ctx, current)
end

