module nupp.core.catalogcompilerfront

-- The compiler's lexer and parser running on the core, as Lua's `load` runs
-- them: tokens of a small chunk, then its tree. Each stage runs protected,
-- so a failure in it reports its own error.
const lexer = require("nupp.compiler.syntax.lexer")
const parser = require("nupp.compiler.syntax.parser")
const triviaarena = require("nupp.compiler.syntax.triviaarena")

-- The core has no FFI: the lexer keeps its trivia in tables, as the test
-- runner installs them.
triviaarena.installDefault(require("nupp.compiler.syntax.triviaarena.table"))

const source = "local total = 0\nfor i = 1, 3 do total = total + i end\nreturn total, \"done\"\n"

local score: integer = 0
local lexed, tokens, errors = pcall(lexer.lex, source, "=front")
if not lexed then
    error(tokens, 0)
end
if #errors == 0 and #tokens > 10 then
    score = score + 1
end
local names = 0
for _, token in ipairs(tokens) do
    if token.kind == "name" then
        names = names + 1
    end
end
if names == 6 then
    score = score + 2
end
local ok, parsed = pcall(parser.parse, source, "=front")
if not ok then
    error(parsed, 0)
end
if #parsed.errors == 0 and parsed.root ~= nil then
    score = score + 4
end
local stats = parsed.root and parsed.root.blocks[1] and parsed.root.blocks[1].stats or {}
if #stats == 3 and stats[2].kind == "fornumStmt" and stats[3].kind == "returnStmt" then
    score = score + 8
end

export const result = score
