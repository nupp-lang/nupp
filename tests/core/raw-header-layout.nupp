module nupp.runtime.core.rawheaderlayout

const native = require("nupp.runtime.vm.intrinsics")
const raw = require("nupp.runtime.core.rawheader")

export function headerBytes(): uint64
    return native.sizeOf<raw.Descriptor>()
end

export function sectionBytes(): uint64
    return native.sizeOf<raw.Section>()
end

export function Descriptor_phase(): int64
    return native.fieldOffset<raw.Descriptor>("phase")
end

export function Descriptor_data(): int64
    return native.fieldOffset<raw.Descriptor>("data")
end

export function Descriptor_dataBytes(): int64
    return native.fieldOffset<raw.Descriptor>("dataBytes")
end

export function Descriptor_entry(): int64
    return native.fieldOffset<raw.Descriptor>("entry")
end

export function Descriptor_sectionCount(): int64
    return native.fieldOffset<raw.Descriptor>("sectionCount")
end

export function Descriptor_reserved(): int64
    return native.fieldOffset<raw.Descriptor>("reserved")
end

export function Section_data(): int64
    return native.fieldOffset<raw.Section>("data")
end

export function Section_count(): int64
    return native.fieldOffset<raw.Section>("count")
end

export function Section_bytes(): int64
    return native.fieldOffset<raw.Section>("bytes")
end
