module nupp.core.catalogpluckedarguments

-- `{x, y} = value` fills those parameters from the fields of value that they
-- name, as main emits `value.x, value.y`; it mixes with named arguments.
local record Vec
    x: integer
    y: integer
    z: integer
end

local record Sprite
    x: integer
    y: integer
    frame: integer
end

local function draw(x: integer, y: integer, color: string?, scale: integer?): integer
    return x * 1000 + y * 100 + (color == nil and 0 or 10) + (scale or 0)
end

local position = Vec(x = 1, y = 2, z = 3)
local sprite = Sprite(x = 4, y = 5, frame = 6)

export const result = draw({x, y} = position)
    + draw({x, y} = sprite, color = "blue") * 10000
    + draw({x, y} = position, scale = 7) * 100000000
