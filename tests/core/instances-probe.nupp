module nupp.runtime.core.instancesprobe

const native = require("nupp.runtime.vm.intrinsics")
const instances = require("nupp.runtime.core.instances")
const values = require("nupp.runtime.vm.values")

-- Test-only mapped storage: World[0,8), Registry[32,104), [160,232),
-- [288,360), World[416,424), Registry[448,520)/[544,616), entries[640,768),
-- [800,928), target tables[1024,1056)/[1088,1120). The float window
-- holds an exact 1152-byte refusal snapshot. All are below helper storage.
local function copy(source: voidptr, destination: voidptr): uint64
    local at: uint64 = 0ULL
    while at < 1152ULL do
        native.store64(destination, native.index(at), native.load64(source, native.index(at)))
        at = at + 8ULL
    end

    return 1ULL
end

local function same(source: voidptr, destination: voidptr): uint64
    local at: uint64 = 0ULL
    while at < 1152ULL do
        if native.load64(destination, native.index(at)) ~= native.load64(source, native.index(at)) then
            return 0ULL
        end
        at = at + 8ULL
    end

    return 1ULL
end

local function refusals(base: voidptr, snapshot: voidptr): uint64
    local registry = native.offset(base, 32)
    local entries = native.offset(base, 640)
    local catalog = native.offset(base, 1024)
    local _ = copy(base, snapshot)
    if instances.initialize(base, registry, entries, 0ULL, catalog, 32ULL, 4ULL) ~= 0ULL
        or instances.initialize(base, registry, entries, 1048577ULL, catalog, 32ULL, 4ULL) ~= 0ULL
        or instances.initialize(base, registry, entries, 4ULL, catalog, 31ULL, 4ULL) ~= 0ULL
        or instances.initialize(base, registry, entries, 4ULL, catalog, 32ULL, 0ULL) ~= 0ULL
        or instances.initialize(base, registry, entries, 4ULL, catalog, 32ULL, 1048577ULL) ~= 0ULL
        or instances.initialize(base, native.offset(registry, 1), entries, 4ULL, catalog, 32ULL, 4ULL) ~= 0ULL
        or instances.initialize(base, registry, native.pointer(0ULL), 4ULL, catalog, 32ULL, 4ULL) ~= 0ULL
        or instances.initialize(
            base,
            registry,
            native.pointer(0xfffffffffffffff8ULL),
            4ULL,
            catalog,
            32ULL,
            4ULL
        ) ~= 0ULL
        or instances.initialize(base, registry, entries, 4ULL, catalog, 0xffffffffffffffffULL, 4ULL) ~= 0ULL
    then
        return 2ULL
    end
    -- Every pair among World, Registry, entries and catalog must be disjoint.
    if instances.initialize(base, base, entries, 4ULL, catalog, 32ULL, 4ULL) ~= 0ULL
        or instances.initialize(base, registry, base, 4ULL, catalog, 32ULL, 4ULL) ~= 0ULL
        or instances.initialize(base, registry, entries, 4ULL, base, 32ULL, 4ULL) ~= 0ULL
        or instances.initialize(base, registry, registry, 4ULL, catalog, 32ULL, 4ULL) ~= 0ULL
        or instances.initialize(base, registry, entries, 4ULL, registry, 32ULL, 4ULL) ~= 0ULL
        or instances.initialize(base, registry, entries, 4ULL, entries, 32ULL, 4ULL) ~= 0ULL
        or instances.initializeWorld(base) ~= 0ULL
        or instances.initializeWorld(native.pointer(0ULL)) ~= 0ULL
        or instances.initializeWorld(native.pointer(0xfffffffffffffff8ULL)) ~= 0ULL
    then
        return 3ULL
    end
    if same(base, snapshot) == 0ULL then
        return 4ULL
    end

    return 0ULL
end

local function identity(base: voidptr, snapshot: voidptr): uint64
    local registry = native.offset(base, 32)
    local entries = native.offset(base, 640)
    local catalog = native.offset(base, 1024)
    if instances.initialize(base, registry, entries, 4ULL, catalog, 32ULL, 4ULL) ~= 1ULL then
        return 5ULL
    end
    if native.load64(base, 0) ~= 5ULL then
        return 6ULL
    end
    local _ = copy(base, snapshot)
    if instances.resolve(registry, catalog, values.TAG_FUNC | 1ULL) ~= 0ULL
        or instances.create(registry, catalog, 4ULL) ~= 0ULL
        or instances.create(registry, catalog, 3ULL) ~= 0ULL
        or instances.initialize(base, registry, entries, 4ULL, catalog, 32ULL, 4ULL) ~= 0ULL
        or same(base, snapshot) == 0ULL
    then
        return 7ULL
    end
    local a = instances.create(registry, catalog, 1ULL)
    local b = instances.create(registry, catalog, 1ULL)
    local copied = a
    if a ~= (values.TAG_FUNC | 1ULL)
        or b ~= (values.TAG_FUNC | 2ULL)
        or a == b
        or copied ~= a
        or instances.resolve(registry, catalog, a) ~= 8ULL
        or instances.resolve(registry, catalog, copied) ~= 8ULL
        or instances.resolve(registry, catalog, b) ~= 8ULL
    then
        return 8ULL
    end
    local zero = instances.create(registry, catalog, 0ULL)
    local maximum = instances.create(registry, catalog, 2ULL)
    if zero ~= (values.TAG_FUNC | 3ULL)
        or maximum ~= (values.TAG_FUNC | 4ULL)
        or instances.resolve(registry, catalog, zero) ~= 1ULL
        or instances.resolve(registry, catalog, maximum) ~= 0x100000000ULL
    then
        return 9ULL
    end
    local _ = copy(base, snapshot)
    if instances.create(registry, catalog, 0ULL) ~= 0ULL
        or instances.resolve(registry, native.offset(base, 1088), a) ~= 0ULL
        or instances.resolve(registry, catalog, values.NIL) ~= 0ULL
        or instances.resolve(registry, catalog, values.TRUE) ~= 0ULL
        or instances.resolve(registry, catalog, values.FALSE) ~= 0ULL
        or instances.resolve(registry, catalog, a | 0x8000000000000000ULL) ~= 0ULL
        or instances.resolve(registry, catalog, values.TAG_FUNC) ~= 0ULL
        or instances.resolve(registry, catalog, values.TAG_FUNC | 5ULL) ~= 0ULL
        or same(base, snapshot) == 0ULL
    then
        return 10ULL
    end

    return 0ULL
end

local function corrupt(base: voidptr, snapshot: voidptr): uint64
    local registry = native.offset(base, 32)
    local entries = native.offset(base, 640)
    local catalog = native.offset(base, 1024)
    local handle = values.TAG_FUNC | 1ULL
    -- Fault injection is test-only: each edit is restored before the next case.
    native.store64(entries, native.fieldOffset<instances.Instance>("handle"), handle + 1ULL)
    local _ = copy(base, snapshot)
    if instances.resolve(registry, catalog, handle) ~= 0ULL or same(base, snapshot) == 0ULL then
        return 11ULL
    end
    native.store64(entries, native.fieldOffset<instances.Instance>("handle"), handle)
    native.store64(entries, native.fieldOffset<instances.Instance>("owner"), native.address(catalog) + 64ULL)
    if instances.resolve(registry, catalog, handle) ~= 0ULL then
        return 12ULL
    end
    native.store64(entries, native.fieldOffset<instances.Instance>("owner"), native.address(catalog))
    native.store64(entries, native.fieldOffset<instances.Instance>("index"), 4ULL)
    if instances.resolve(registry, catalog, handle) ~= 0ULL then
        return 13ULL
    end
    native.store64(entries, native.fieldOffset<instances.Instance>("index"), 1ULL)
    native.store64(entries, native.fieldOffset<instances.Instance>("target"), 8ULL)
    if instances.resolve(registry, catalog, handle) ~= 0ULL then
        return 14ULL
    end
    native.store64(entries, native.fieldOffset<instances.Instance>("target"), 7ULL)
    native.store64(catalog, 8, 9ULL)
    if instances.resolve(registry, catalog, handle) ~= 0ULL then
        return 15ULL
    end
    native.store64(catalog, 8, 7ULL)
    native.store64(registry, native.fieldOffset<instances.Registry>("used"), 5ULL)
    local _ = copy(base, snapshot)
    if instances.create(registry, catalog, 0ULL) ~= 0ULL
        or instances.retire(registry, catalog) ~= 0ULL
        or instances.resolve(registry, catalog, handle) ~= 0ULL
        or same(base, snapshot) == 0ULL
    then
        return 16ULL
    end
    native.store64(registry, native.fieldOffset<instances.Registry>("used"), 4ULL)

    return 0ULL
end

local function lifecycle(base: voidptr, snapshot: voidptr): uint64
    local registry = native.offset(base, 32)
    local second = native.offset(base, 160)
    local entries = native.offset(base, 800)
    local catalog = native.offset(base, 1024)
    local old = values.TAG_FUNC | 1ULL
    if instances.retire(registry, catalog) ~= 1ULL then
        return 17ULL
    end
    local _ = copy(base, snapshot)
    if instances.retire(registry, catalog) ~= 0ULL
        or instances.create(registry, catalog, 0ULL) ~= 0ULL
        or instances.resolve(registry, catalog, old) ~= 0ULL
        or instances.initialize(base, registry, entries, 4ULL, catalog, 32ULL, 4ULL) ~= 0ULL
        or same(base, snapshot) == 0ULL
    then
        return 18ULL
    end
    if instances.initialize(base, second, entries, 4ULL, catalog, 32ULL, 4ULL) ~= 1ULL then
        return 19ULL
    end
    local fresh = instances.create(second, catalog, 1ULL)
    if fresh ~= (values.TAG_FUNC | 5ULL)
        or fresh == old
        or instances.resolve(second, catalog, old) ~= 0ULL
        or instances.resolve(second, catalog, fresh) ~= 8ULL
        or native.load64(base, 0) ~= 9ULL
    then
        return 20ULL
    end
    -- Three unissued IDs in this reservation remain burned after retirement.
    if instances.retire(second, catalog) ~= 1ULL then
        return 21ULL
    end
    local third = native.offset(base, 288)
    if instances.initialize(base, third, entries, 1ULL, catalog, 32ULL, 4ULL) ~= 1ULL
        or instances.create(third, catalog, 0ULL) ~= (values.TAG_FUNC | 9ULL)
        or instances.retire(third, catalog) ~= 1ULL
        or native.load64(base, 0) ~= 10ULL
    then
        return 22ULL
    end

    return 0ULL
end

local function exhaustion(base: voidptr, snapshot: voidptr): uint64
    local world = native.offset(base, 416)
    local registry = native.offset(base, 448)
    local entries = native.offset(base, 640)
    local catalog = native.offset(base, 1024)
    -- A separate fixture world starts at its last two IDs to cover the boundary
    -- without allocating 2^48 entries. Production exposes no counter setter.
    if instances.initializeWorld(world) ~= 1ULL then
        return 23ULL
    end
    native.store64(world, native.fieldOffset<instances.World>("next"), values.PAYLOAD - 1ULL)
    local _ = copy(base, snapshot)
    if instances.initialize(world, registry, entries, 3ULL, catalog, 32ULL, 4ULL) ~= 0ULL
        or same(base, snapshot) == 0ULL
    then
        return 24ULL
    end
    if instances.initialize(world, registry, entries, 2ULL, catalog, 32ULL, 4ULL) ~= 1ULL then
        return 25ULL
    end
    local a = instances.create(registry, catalog, 0ULL)
    local b = instances.create(registry, catalog, 1ULL)
    if a ~= (values.TAG_FUNC | (values.PAYLOAD - 1ULL))
        or b ~= (values.TAG_FUNC | values.PAYLOAD)
        or instances.resolve(registry, catalog, a) ~= 1ULL
        or instances.resolve(registry, catalog, b) ~= 8ULL
        or native.load64(world, 0) ~= values.PAYLOAD + 1ULL
    then
        return 26ULL
    end
    local _ = copy(base, snapshot)
    if instances.create(registry, catalog, 0ULL) ~= 0ULL
        or instances.initializeWorld(world) ~= 0ULL
        or instances.initialize(
            world,
            native.offset(base, 544),
            native.offset(base, 800),
            1ULL,
            catalog,
            32ULL,
            4ULL
        ) ~= 0ULL
        or same(base, snapshot) == 0ULL
    then
        return 27ULL
    end
    if instances.retire(registry, catalog) ~= 1ULL then
        return 28ULL
    end

    return 0ULL
end

-- Outputs are diagnostic status only. No function handle crosses the bridge;
-- this is registry service execution, not guest Closure/Call/Ret execution.
export function CoreInstancesProbe(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    if native.sizeOf<instances.World>() ~= 8ULL
        or native.sizeOf<instances.Registry>() ~= 72ULL
        or native.sizeOf<instances.Instance>() ~= 32ULL
    then
        return 1ULL
    end
    local at: uint64 = 0ULL
    while at < 1152ULL do
        native.store64(ints, native.index(at), 0ULL)
        at = at + 8ULL
    end
    local catalog = native.offset(ints, 1024)
    native.store64(catalog, 0, 0ULL)
    native.store64(catalog, 8, 7ULL)
    native.store64(catalog, 16, 0xffffffffULL)
    native.store64(catalog, 24, 0x100000000ULL)
    if instances.initializeWorld(ints) ~= 1ULL then
        return 1ULL
    end
    local status = refusals(ints, floats)
    if status ~= 0ULL then
        return status
    end
    status = identity(ints, floats)
    if status ~= 0ULL then
        return status
    end
    status = corrupt(ints, floats)
    if status ~= 0ULL then
        return status
    end
    status = lifecycle(ints, floats)
    if status ~= 0ULL then
        return status
    end

    return exhaustion(ints, floats)
end
