module nupp.core.catalogscalarmath

local plain = tonumber("2147483647") as integer
local a = math.i32.wrap(plain)
local one = math.i32.wrap(tonumber("1") as integer)
local u = math.u32.wrap(tonumber("4294967295") as integer)
local signed = math.i32.wrap(-1)
assert(math.i32.add(a, one) == -2147483648)
assert(math.i32.sub(math.i32.wrap(-2147483648), one) == 2147483647)
assert(math.i32.mul(a, a) == 1)
assert(math.i32.andbits(signed, math.i32.wrap(-2147483648)) == -2147483648)
assert(math.i32.orbits(math.i32.wrap(-2147483648), one) == -2147483647)
assert(math.i32.xorbits(signed, math.i32.wrap(-2147483648)) == 2147483647)
assert(math.i32.notbits(one) == -2)
assert(math.i32.shiftleft(one, -1) == -2147483648)
assert(math.i32.shiftrightarithmetic(math.i32.wrap(-8), 1) == -4)
assert(math.i32.shiftrightarithmetic(math.i32.wrap(-8), 32) == -8)
assert(math.i32.rotateleft(one, -1) == -2147483648)
assert(math.i32.rotateright(math.i32.wrap(-2147483648), 31) == 1)
assert(math.i32.lessthan(signed, one) and math.i32.lessorequal(one, one))
assert(math.i32.fromu32(u) == -1 and math.i32.tou32(signed) == 4294967295)
assert(math.u32.add(u, 1) == 0 and math.u32.sub(0, 1) == 4294967295)
assert(math.u32.mul(u, u) == 1)
assert(math.u32.div(u, 65536) == 65535 and math.u32.mod(u, 65536) == 65535)
assert(math.u32.div(u, 0) == 0 and math.u32.mod(u, 0) == 0)
assert(math.u32.andbits(u, 0x80000000) == 2147483648)
assert(math.u32.orbits(0x80000000, 1) == 2147483649)
assert(math.u32.xorbits(u, 0x80000000) == 2147483647)
assert(math.u32.notbits(0) == 4294967295)
assert(math.u32.shiftleft(1, 32) == 1)
assert(math.u32.shiftrightlogical(u, 31) == 1)
assert(math.u32.rotateleft(0x80000000, 1) == 1 and math.u32.rotateright(1, 32) == 1)
assert(not math.u32.lessthan(u, 1) and math.u32.lessorequal(u, u))
assert(math.u32.fromi32(signed) == 4294967295 and math.u32.toi32(u) == -1)
assert(math.u32.popcount(u) == 32 and math.u32.trailingzeros(0) == 32 and math.u32.leadingzeros(1) == 31)

-- The checker-marked operators use the same32-bit kernels; ordinary Lua
-- integers keep their64-bit arithmetic and negative-count shift behavior.
assert(a + one == -2147483648 and a * a == 1)
assert(u + 1 == 0 and u * u == 1)
assert((signed >> 1) == 2147483647 and (signed >> 0) == -1)
assert((one << -1) == -2147483648 and (u >> 32) == 4294967295)
assert((~one) == -2 and (~u) == 0)
local plainone = tonumber("1") as integer
assert(plain + 1 == 2147483648 and (plainone << -1) == 0)

-- Literal and binding folds must agree with execution, including the first
-- value outside signed32 and a full unsigned32 word.
const decimal = 2147483648
assert(math.i32.wrap(decimal) == -2147483648)
assert(math.u32.wrap(-1) == 4294967295)
assert(math.i32.mul(math.i32.wrap(2147483647), math.i32.wrap(2147483647)) == 1)

local whole = math
local widths = whole.u32
local add = whole.i32.add
assert(add(a, one) == -2147483648 and widths.mul(u, u) == 1)
assert(rawequal(whole.i32, (rawget(_G, "math") as any).i32))
assert(math.f32.narrow(16777217) == 16777216)

local high = math.u64.andbits(0xffffffffffffffffULL, 0x8000000000000000ULL)
local max = math.u64.sub(0ULL, 1ULL)
collectgarbage("collect")
assert(high == 0x8000000000000000ULL and max == 0xffffffffffffffffULL)
assert(math.u64.trailingzeros(0ULL) == 64 and math.u64.trailingzeros(max) == 0)
local trailingzeros = math.u64.trailingzeros
local bit: uint64 = 1ULL
for position = 0, 63 do
    assert(trailingzeros(bit) == position)
    bit = bit << 1ULL
end
assert(trailingzeros(0x8000000080000100ULL) == 8)
local count: any = trailingzeros
local countOK, counted = pcall(count, 0x8000000000000000ULL)
assert(countOK and counted == 63)
assert(not pcall(count, false) and not pcall(count, nil))
local dynamic: any = widths.div
local ok, quotient = pcall(dynamic, 17, 0)
assert(ok and quotient == 0)
assert(not pcall(dynamic, nil, 1))
export const result = 1
