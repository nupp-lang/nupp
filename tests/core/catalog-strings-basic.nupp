module nupp.core.catalogstringsbasic

local s = "hello"
local t = tostring(42)
local f = ("%d-%s"):format(7, "x")
local parts: {string} = {}
parts[1] = s
parts[2] = t
parts[3] = f
local joined = table.concat(parts, ",")
local found = 0
for _ in joined:gmatch("l+") do
    found = found + 1
end
export const result = #joined * 100 + found
