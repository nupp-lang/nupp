module nupp.core.rawsemanticshim

local arm = require("s0.arm64")
local selector = require("s0.select")
local linker = require("nupp.core.link")

-- Test-only packet boundary for raw bytes. It never reads diagnostic program.data.
-- All absolute pointer checks happen while the bridge mappings are still live;
-- output carries only status, relative offsets, lengths and counts.
export function build(functions: {[string]: any}, symbol: string, descriptorBytes: integer): any
    assert(descriptorBytes == 480, "raw admission test descriptor layout")
    local scratchBytes: integer = 33554432
    local storageOffset: integer = 128
    local poolOffset: integer = 608
    local poolBytes: integer = 18874368
    local spillOffset: integer = 18874976
    local boundary: any = {
        words = {arm.bl(0)},
        frameBytes = 0,
        fixupWord = {1},
        fixupKind = {selector.BL26},
        fixupName = {symbol},
        fixupAddend = {0}
    }
    local extent: integer = linker.assemble({}, {boundary}, functions, scratchBytes - spillOffset).callBytes
    assert(extent >= 16 and extent % 16 == 0, "raw admission helper extent")
    local words: {integer} = {}
    local refused: {{
        at: integer,
        condition: integer
    }} = {}

    local function emit(word: integer): nil
        words[#words + 1] = word
    end

    local function imm(reg: integer, value: integer): nil
        emit(arm.movz(64, reg, value & 65535, 0))
        if value >> 16 ~= 0 then
            emit(arm.movk(64, reg, value >> 16, 1))
        end
    end

    local function offset(reg: integer, base: integer, value: integer): nil
        assert(reg ~= base, "raw catalog boundary offset destination")
        imm(reg, value)
        emit(arm.add_reg(64, reg, base, reg, 0))
    end

    local function refuse(condition: integer): nil
        refused[#refused + 1] = {at = #words + 1, condition = condition}
        emit(arm.b_cond(condition, 0))
    end

    emit(arm.sub_imm(64, 31, 31, 192, 0))
    for reg = 19, 29, 2 do
        emit(arm.stp(64, reg, reg + 1, 31, (reg - 19) * 8, 0))
    end
    for reg = 8, 14, 2 do
        emit(arm.stp_fp(64, reg, reg + 1, 31, 96 + (reg - 8) * 8, 0))
    end
    emit(arm.str(8, 1, 31, 160))
    emit(arm.str(8, 0, 31, 168))
    for _, check in ipairs({{0, 1, 1}, {48, scratchBytes, 3}, {88, 61, 3}, {32, 624, 3}}) do
        emit(arm.ldr(8, 16, 0, check[1]))
        imm(17, check[2])
        emit(arm.cmp_reg(64, 16, 17))
        refuse(check[3])
    end
    emit(arm.ldr(8, 19, 0, 40))
    emit(arm.ldr(8, 22, 0, 56))
    offset(23, 19, spillOffset)
    emit(arm.movz(64, 20, 0, 0))
    emit(arm.movz(64, 21, 0, 0))
    emit(arm.ldr(8, 1, 0, 32))
    emit(arm.ldr(8, 0, 0, 24))
    offset(2, 19, storageOffset)
    imm(3, descriptorBytes)
    offset(4, 19, poolOffset)
    imm(5, poolBytes)
    emit(arm.mov_reg(64, 6, 23))
    imm(7, extent)
    local call = #words + 1
    emit(arm.bl(0))
    emit(arm.ldr(8, 16, 31, 160))
    emit(arm.str(8, 0, 16, 0))
    offset(13, 19, storageOffset)
    emit(arm.ldr(8, 14, 31, 168))
    emit(arm.ldr(8, 14, 14, 24))
    emit(arm.ldr(8, 17, 13, 0))
    local empty = #words + 1
    emit(arm.cbz(64, 17, 0))
    emit(arm.cmp_imm(64, 17, 4, 0))
    refuse(1)
    emit(arm.ldr(8, 17, 13, 8))
    emit(arm.cmp_reg(64, 17, 14))
    refuse(1)
    for section = 0, 17 do
        emit(arm.ldr(8, 17, 14, 48 + section * 32 + 16))
        emit(arm.add_reg(64, 17, 14, 17, 0))
        emit(arm.ldr(8, 15, 13, 48 + section * 24))
        emit(arm.cmp_reg(64, 17, 15))
        refuse(1)
    end
    words[empty] = arm.cbz(64, 17, (#words + 1 - empty) * 4)
    for word = 0, 59 do
        if word == 1 then
            -- Retained data identity was checked in-call, never exported.
            emit(arm.str(8, 31, 16, (word + 1) * 8))
        else
            emit(arm.ldr(8, 17, 13, word * 8))
            if word >= 6 and (word - 6) % 3 == 0 then
                -- Empty/refused descriptors remain all-zero diagnostics.
                local zero = #words + 1
                emit(arm.cbz(64, 17, 0))
                emit(arm.sub_reg(64, 17, 17, 14, 0))
                words[zero] = arm.cbz(64, 17, (#words + 1 - zero) * 4)
            end
            emit(arm.str(8, 17, 16, (word + 1) * 8))
        end
    end
    emit(arm.movz(64, 0, 0, 0))
    local success = #words + 1
    emit(arm.b(0))
    local failure = #words + 1
    emit(arm.movz(64, 0, 1, 0))
    local restore = #words + 1
    words[success] = arm.b((restore - success) * 4)
    for _, branch in ipairs(refused) do
        words[branch.at] = arm.b_cond(branch.condition, (failure - branch.at) * 4)
    end
    for reg = 8, 14, 2 do
        emit(arm.ldp_fp(64, reg, reg + 1, 31, 96 + (reg - 8) * 8, 0))
    end
    for reg = 19, 29, 2 do
        emit(arm.ldp(64, reg, reg + 1, 31, (reg - 19) * 8, 0))
    end
    emit(arm.add_imm(64, 31, 31, 192, 0))
    emit(arm.ret(30))
    boundary.words, boundary.fixupWord = words, {call}
    local linked = linker.assemble({}, {boundary}, functions, scratchBytes - spillOffset)
    assert(linked.callBytes == extent and linked.offsets[1] == 0)

    return {
        words = linked.words,
        entry = 0,
        scratchBytes = scratchBytes,
        spillOffset = spillOffset,
        callBytes = extent,
        outputWords = 61,
        storageOffset = storageOffset,
        poolOffset = poolOffset,
        poolBytes = poolBytes
    }
end
