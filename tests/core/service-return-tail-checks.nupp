module nupp.core.servicereturntailchecks

-- Compiler-only mutations of graphs from the fixed service source catalog.
-- Run before final-frame sealing; this does not execute the heap services.
local graph = require("nupp.compiler.vm.graph")
local lower = require("nupp.compiler.vm.lower")
local nativegraph = require("nupp.compiler.vm.nativegraph")
local cleanup = require("nupp.compiler.vm.nativecleanup")
local service = require("nupp.compiler.vm.nativeservice")

local function refuses(callback: function(): nil, fragment: string): nil
    local ok, message = pcall(callback)
    assert(not ok, "invalid service return tail accepted")
    assert(tostring(message):find(fragment, 1, true), tostring(message))
end

local function checked(build: any, name: string): any
    local selected = nil
    for _, owner in ipairs(service.owners(build.catalog)) do
        if owner.scope.name .. "." .. owner.name == name then
            assert(selected == nil)
            selected = owner
        end
    end
    assert(selected, "fixed service owner missing: " .. name)
    local options = service.options(build.catalog, selected)
    assert(service.needsCleanup(service.signature(selected, options)))
    local g = lower.functionGraph(selected, options, cleanup.profile(nativegraph))
    graph.verify(g)
    service.verifyScope(g)

    return {graph = g, owner = selected}
end

local function aliases(build: any): nil
    local item = checked(build, "nupp.runtime.vm.arena.roundUp")
    local g, changed = item.graph, false
    for _, block in ipairs(g.blocks) do
        if not changed and block.term.kind == "return" then
            for index, value in ipairs(block.params) do
                if value == block.term.value then
                    -- Model the common walker's legitimate lexical binding
                    -- plus held-result alias, without a new source owner.
                    local alias = graph.nativeValue(g, g.exactTypes[value])
                    block.params[#block.params + 1] = alias
                    local incoming = 0
                    for _, predecessor in ipairs(g.blocks) do
                        for _, edge in ipairs(predecessor.term.edges) do
                            if edge.target == block.id then
                                edge.args[#edge.args + 1] = edge.args[index]
                                incoming = incoming + 1
                            end
                        end
                    end
                    assert(incoming > 0)
                    changed = true
                    break
                end
            end
        end
    end
    assert(changed, "actual scalar return did not use continuation transport")
    graph.verify(g)
    service.verifyScope(g)
    graph.prune(g)
    graph.verify(g)
    service.verifyScope(g)
end

local function failedCallRejoin(build: any): nil
    local g = checked(build, "nupp.runtime.vm.heap.pageRound").graph
    for _, block in ipairs(g.blocks) do
        for index, op in ipairs(block.op) do
            if op == "NativeLeafCall"
                and block.dst[index] ~= 0
                and g.exactTypes[block.dst[index]] == "uint64"
                and block.term.kind == "branch"
                and #block.op == index + 4
            then
                local yes, no = block.term.edges[1], block.term.edges[2]
                local failed, target = g.blocks[no.target], g.blocks[yes.target]
                local original = failed.term
                local mapped, arguments = {}, {}
                for at, value in ipairs(no.args) do
                    mapped[value] = failed.params[at]
                end
                for at, value in ipairs(yes.args) do
                    if mapped[value] then
                        arguments[at] = mapped[value]
                    elseif value <= g.nparams then
                        arguments[at] = value
                    else
                        assert(
                            value == block.dst[index] and g.exactTypes[target.params[at]] == "uint64",
                            "unexpected live value in exact pageSize continuation"
                        )
                        arguments[at] = graph.emitNative(g, failed, "NativeConstant", {"0"}, "uint64", original.pos)
                    end
                end
                failed.term = {kind = "jump", edges = {{target = target.id, args = arguments}}, pos = original.pos}
                -- The fabricated success value is deliberately not the call
                -- result: failure cannot rejoin publication even after dropping it.
                refuses(
                    function(): nil
                        service.verifyScope(g)
                    end,
                    "failed service continuation rejoins normal return"
                )
                failed.term = original
                service.verifyScope(g)
                graph.prune(g)
                graph.verify(g)
                service.verifyScope(g)
                return
            end
        end
    end
    error("actual pageRound did not contain a guarded scalar service call")
end

local function statusChecks(build: any): nil
    local item = checked(build, "nupp.runtime.vm.arena.roundUp")
    local g = item.graph
    local layout = service.layout({g = g})
    local errorOffset, retainOffset = tostring(layout.offsets.error), tostring(layout.offsets.retainBacking)
    assert(errorOffset ~= retainOffset)
    local changed, seen = {}, {}
    for _, block in ipairs(g.blocks) do
        local constants = {}
        for index, op in ipairs(block.op) do
            local args = block.args[index]
            if op == "NativeConstant" then
                constants[block.dst[index]] = args
            elseif op == "NativeLoad" then
                local offset = constants[args[2]]
                if offset and offset[1] == errorOffset and not seen[offset] then
                    assert(args[3].kind == "uint64" and args[3].width == 8 and not args[3].write)
                    changed[#changed + 1], seen[offset] = offset, true
                end
            end
        end
    end
    assert(#changed > 0, "actual roundUp did not contain error-status loads")
    for _, args in ipairs(changed) do
        args[1] = retainOffset
    end
    -- End-to-end status-proof rejection: the earlier failure-path proof can
    -- reject before the return-tail zero-error proof. This does not claim
    -- isolated coverage of the latter guard.
    local ok, message = pcall(service.verifyScope, g)
    for _, args in ipairs(changed) do
        args[1] = errorOffset
    end
    assert(not ok, "retained-backing checks replaced all error-status checks")
    local diagnostic = tostring(message)
    assert(
        diagnostic:find("service failure lacks a dominating nonzero error edge", 1, true)
        or diagnostic:find("return-tail lacks a dominating zero-error edge", 1, true),
        diagnostic
    )
    graph.verify(g)
    service.verifyScope(g)
    graph.prune(g)
    graph.verify(g)
    service.verifyScope(g)
end

export function check(build: any): nil
    statusChecks(build)
    aliases(build)
    failedCallRejoin(build)
    for _, name in ipairs({"nupp.runtime.vm.arena.roundUp", "nupp.runtime.vm.heap.mapOrFail"}) do
        local item = checked(build, name)
        local g = item.graph
        refuses(
            function(): nil
                service.returnTail({g = g, fn = item.owner}, {})
            end,
            "unissued return-tail"
        )
        graph.prune(g)
        graph.verify(g)
        service.verifyScope(g)
    end
end
