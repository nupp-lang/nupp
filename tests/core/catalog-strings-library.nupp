module nupp.core.catalogstringslibrary

-- The string library beyond format and gmatch: sub, byte, char, rep, upper,
-- lower, len, find and match, with negative and out-of-range positions,
-- plain and pattern searches, an anchored match and a position capture.
local s = "Hello, World"
local parts = s:sub(1, 5) .. "|" .. s:sub(-5) .. "|" .. s:sub(8, -1) .. "|" .. string.sub(s, 0) .. "|" .. s:sub(5, 2)
local up = s:upper() .. s:lower()
local codes = (s:byte() or 0) + (s:byte(-1) or 0) * 1000 + (s:byte(100) or 7) * 1000000
local ch = string.char(72) .. string.char(105)
local r = string.rep("ab", 3) .. string.rep("x", 0)
local f = (s:find("World") or 0) + (s:find("o", 6) or 0) * 100 + (s:find("%a+", 8) or 0) * 10000
f = f + (s:find("xyz") or 0) * 1000000 + (s:find(",", 1, true) or 0) * 10000000
local m1 = s:match("%a+") or "?"
local m2 = s:match("(%a+)$") or "?"
local m3 = s:match("^(%w)") or "?"
local m4 = s:match("()o")
local text = parts .. up .. ch .. r .. m1 .. m2 .. m3 .. tostring(m4) .. tostring(#s) .. tostring(s:len())
local hash = 0
for i = 1, #text do
    hash = (hash * 31 + (text:byte(i) or 0)) % 1000000007
end
export const result = hash + codes * 3 + f * 7
