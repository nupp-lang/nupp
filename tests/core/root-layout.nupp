module nupp.runtime.core.rootlayout

const native = require("nupp.runtime.vm.intrinsics")
const arena = require("nupp.runtime.core.arena")
const frames = require("nupp.runtime.core.frames")
const rootentry = require("nupp.runtime.core.rootentry")

-- The producer reads checked intrinsic expressions, never a parallel layout map.
export function storageBytes(): uint64
    return native.sizeOf<rootentry.Storage>()
end

export function descriptorBytes(): uint64
    return native.sizeOf<rootentry.Descriptor>()
end

export function stateOffset(): int64
    return native.fieldOffset<rootentry.Storage>("state")
end

export function rootOffset(): int64
    return native.fieldOffset<rootentry.Storage>("root")
end

export function valueOffset(): int64
    return native.fieldOffset<frames.RootControl>("value")
end

export function frameCode(): int64
    return native.fieldOffset<frames.Frame>("code")
end

export function frameValues(): int64
    return native.fieldOffset<frames.Frame>("values")
end

export function frameIntegers(): int64
    return native.fieldOffset<frames.Frame>("integers")
end

export function frameFloats(): int64
    return native.fieldOffset<frames.Frame>("floats")
end

export function descriptorBody(): int64
    return native.fieldOffset<rootentry.Descriptor>("bodyOffset")
end

export function descriptorTable(): int64
    return native.fieldOffset<rootentry.Descriptor>("tableOffset")
end

export function descriptorHandlers(): int64
    return native.fieldOffset<rootentry.Descriptor>("handlerCount")
end

export function descriptorVersion(): int64
    return native.fieldOffset<rootentry.Descriptor>("version")
end

export function descriptorId(): int64
    return native.fieldOffset<rootentry.Descriptor>("functionId")
end

export function descriptorCount(): int64
    return native.fieldOffset<rootentry.Descriptor>("instructionCount")
end

export function descriptorValues(): int64
    return native.fieldOffset<rootentry.Descriptor>("valueCount")
end

export function descriptorIntegers(): int64
    return native.fieldOffset<rootentry.Descriptor>("integerCount")
end

export function descriptorFloats(): int64
    return native.fieldOffset<rootentry.Descriptor>("floatCount")
end

export function descriptorVectors(): int64
    return native.fieldOffset<rootentry.Descriptor>("vectorCount")
end

export function rootMark(): int64
    return native.fieldOffset<frames.RootControl>("mark")
end

export function markSerial(): int64
    return native.fieldOffset<arena.Mark>("serial")
end
