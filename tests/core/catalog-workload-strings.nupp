module nupp.core.catalogworkloadstrings

-- The `strings` workload of bench/vm/workloads.bench.nupp, whose checksum
-- at scale 1 is 5281858. The scale is read from BENCH_SCALE at run time, as the
-- original reads it, so no compiler can fold it away.
local scale: number = tonumber(os.getenv("BENCH_SCALE") or "1") or 1

local function strings(): number
    local parts: {string} = {}
    for i = 1, 300000 do
        parts[#parts + 1] = ("item%d:%s"):format(i, tostring(i * 3 * scale))
    end
    local joined = table.concat(parts, ",")
    local found = 0
    for _ in joined:gmatch("item%d+5:") do
        found = found + 1
    end

    return #joined + found
end

export const result = strings()
