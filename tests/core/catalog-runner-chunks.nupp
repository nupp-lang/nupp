module nupp.core.catalogrunnerchunks

-- A plain Lua chunk compiled on the host, as the test runner's suites are,
-- and loaded from where NUPP_CORE_CHUNKS keeps it: what it scores.
const helper = require("nupp.core.catalogrunnerhelper")
const CHUNK = "tests/core/runner-chunk-calls.lua"

local _ = helper.double
local chunk = assert(loadfile(CHUNK))

export const result: integer = chunk()
