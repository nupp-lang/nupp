module nupp.core.cataloghashdigests

-- The compiler's content digest and SHA-256 on the core, which computes both
-- over a string's bytes (guesthash): the hex digits the host's answer for
-- every length the algorithms treat apart (each tail XXH64 reads, SHA-256's
-- padding in one block and in two), and for a long input; and
-- nupp.compiler.hash.digest, which the build and the test runner take their
-- content digests through, answering the core's. With NUPP_HASH_BENCH set to
-- megabyte counts ("1,4,64"), each digest's throughput over each is written
-- to standard error, and with NUPP_HASH_FILES set to paths, the time each
-- file takes to read whole and each digest's throughput over its bytes.
-- Each check is a bit of the score.
local corehash = require("nupp.compiler.corehash")
local hash = require("nupp.compiler.hash")
local sha256 = require("nupp.digest.internal.sha256")

local score = 0
local bit = 1

local function check(ok: boolean): nil
    if ok then
        score = score | bit
    end
    bit = bit << 1
end

local BASE = string.rep("The quick brown fox jumps over the lazy dog. ", 30)
local SIZES: {integer} = {0, 1, 3, 4, 7, 8, 9, 31, 32, 33, 55, 56, 63, 64, 65, 119, 120, 127, 128, 1000}

local digests: {string} = {}
local hashes: {string} = {}
for _, size in ipairs(SIZES) do
    local text = string.sub(BASE, 1, size)
    digests[#digests + 1] = corehash.digest(text)
    hashes[#hashes + 1] = sha256.sha256(text)
end

-- The empty input and the longest, then every length at once.
check(digests[1] == "ef46db3751d8e999c4349fc93c010000")
check(hashes[1] == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
check(digests[#digests] == "8c4b40412fe058e6a22be6dd675d6ddf")
check(hashes[#hashes] == "ea5685e94f1438edcce8c1861e0cfb3e307c89d61a9492992aa675899e19d1a7")
check(corehash.digest(table.concat(digests)) == "77750a501835c1cf101aa1b4fbdbff46")
check(sha256.sha256(table.concat(hashes)) == "1ac3d821cf8c635560318448a874c2162d77bc9b008df8700f353463e8bcf65d")

-- Every byte value four times over, then three bytes with the high bit
-- set and clear: no byte is read as signed.
local everyByte: {string} = {}
for value = 0, 255 do
    everyByte[#everyByte + 1] = string.char(value)
end
local bytes = string.rep(table.concat(everyByte), 4) .. "\255\128\0"
check(corehash.digest(bytes) == "4c5f8e577936737b31bd208d303d37c4")
check(sha256.sha256(bytes) == "fb9332b9b5708b1850d0ab747139e851161c3f4bb5df519143c9131de9d0cd7b")

-- The compiler's digest resolves to the core's.
check(hash.digest(BASE) == corehash.digest(BASE))

-- A string argument is required.
local ok, message = pcall(corehash.digest, 7 as any)
check(not ok and tostring(message):find("string", 1, true) ~= nil)

const MEGABYTE = 1024 * 1024

-- Writes each digest's time and throughput over `text`, named `label`.
local function measure(label: string, text: string): nil
    local megabytes = #text / MEGABYTE
    for _, entry in ipairs({{"hash.digest", hash.digest}, {"sha256", sha256.sha256}}) do
        local name, digest = entry[1] as string, entry[2] as function(string): string
        local started = os.clock()
        local answer = digest(text)
        local seconds = os.clock() - started
        io.stderr:write(
            string.format(
                "%s %s %.1f MB %.4f s %.1f MB/s %s\n",
                name,
                label,
                megabytes,
                seconds,
                megabytes / seconds,
                answer
            )
        )
    end
end

for setting in string.gmatch(os.getenv("NUPP_HASH_BENCH") or "", "%d+") do
    local megabytes = math.tointeger(tonumber(setting)) as integer
    measure("repeated", string.rep("abcdefgh", megabytes * MEGABYTE // 8))
end

for path in string.gmatch(os.getenv("NUPP_HASH_FILES") or "", "%S+") do
    local started = os.clock()
    local file = assert(io.open(path, "rb"))
    local text = file:read("a") as string
    file:close()
    io.stderr:write(string.format("read %s %.1f MB %.4f s\n", path, #text / MEGABYTE, os.clock() - started))
    measure(path, text)
end

export const result = score
