    local v46: integer = 46
    local v47: integer = 47
    local v48: integer = 48
    local v49: integer = 49
    local v50: integer = 50
    local v51: integer = 51
    local v52: integer = 52
    local v53: integer = 53
    local v54: integer = 54
    local v55: integer = 55
    local v56: integer = 56
    local v57: integer = 57
    local v58: integer = 58
    local v59: integer = 59
    local v60: integer = 60
    local v61: integer = 61
    local v62: integer = 62
    local v63: integer = 63
    local v64: integer = 64
    local v65: integer = 65
    local v66: integer = 66
    local v67: integer = 67
    local v68: integer = 68
    local v69: integer = 69
    local v70: integer = 70

    return function(): integer
