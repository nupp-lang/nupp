module nupp.runtime.core.voidprobe

const native = require("nupp.runtime.vm.intrinsics")

export function clear(destination: voidptr): nil
    native.store64(destination, 32, 0ULL)
end

export function storeEmpty(destination: voidptr, word: uint64): nil
    native.store64(destination, 0, word)
    return
end

export function storeExplicit(destination: voidptr, word: uint64): nil
    native.store64(destination, 0, word)
    return nil
end

export function storeImplicit(destination: voidptr, word: uint64): nil
    native.store64(destination, 0, word)
end

export function chain(destination: voidptr, word: uint64): nil
    storeEmpty(destination, word)
    storeExplicit(native.offset(destination, 8), word + 1ULL)
    storeImplicit(native.offset(destination, 16), word + 2ULL)
end

export function choose(destination: voidptr, flag: uint64): nil
    if flag == 0ULL then
        storeEmpty(destination, 41ULL)
        return
    end
    storeExplicit(destination, 42ULL)
end

export function pressure(
    a: uint64,
    b: uint64,
    c: uint64,
    d: uint64,
    e: uint64,
    f: uint64,
    g: uint64,
    destination: voidptr
): nil
    native.store64(destination, 24, a + b + c + d + e + f + g)
    clear(destination)
end

export function read(destination: voidptr): uint64
    return native.load64(destination, 0)
end

export function same(a: uint64, b: uint64): boolean
    return a == b
end

-- This entry exercises real zero-result calls through the owned INTERNAL ABI.
-- The borrowed integer window is data, never a fabricated managed frame/root.
export function CoreVoidProbe(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local word: uint64 = 0xfffffffffffffff0ULL
    chain(ints, word)
    local saved = native.load64(ints, 16)
    pressure(word, 1ULL, 2ULL, 3ULL, 4ULL, 5ULL, 6ULL, ints)
    if read(ints) ~= word
        or native.load64(ints, 8) ~= word + 1ULL
        or native.load64(ints, 16) ~= saved
        or saved ~= word + 2ULL
        or native.load64(ints, 24) ~= 5ULL
        or native.load64(ints, 32) ~= 0ULL
    then
        return 1ULL
    end
    storeEmpty(ints, read(ints) + 1ULL)
    if same(read(ints), word + 1ULL) then
        choose(ints, 0ULL)
    else
        return 2ULL
    end
    if read(ints) ~= 41ULL then
        return 3ULL
    end
    choose(ints, 1ULL)
    if read(ints) ~= 42ULL then
        return 4ULL
    end

    return 0ULL
end
