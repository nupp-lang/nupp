module nupp.core.rootproducer

local ROOT = assert(os.getenv("NUPP_COMPILER_ROOT"))
local front = require("nupp.core.source")
local nativegraph = require("nupp.compiler.vm.nativegraph")
local lower = require("nupp.compiler.vm.lower")
local nativelayout = require("nupp.compiler.vm.nativelayout")
local sink = require("nupp.compiler.s0.nativegraph")
local allocate = require("s0.allocate")
local allocationcheck = require("s0.allocationcheck")
local selector = require("s0.select")
local shim = require("nupp.core.rootshim")
local json = require("serde.json")
local graphimage = require("nupp.compiler.vm.graphimage")

-- The outer assembly boundary has no graph call site to check these arguments.
-- Bind it to the actual checked declaration and graph before machine selection.
local function boundary(item: any, expected: {string}): nil
    local owner, g = item.owner, item.graph
    assert(owner.node.body == owner.body and owner.scope.functions[owner.name] == owner, "root boundary checked owner")
    assert(
        owner.nativeABI == "leaf"
        and g.native.abi == "leaf"
        and owner.resultKind == "uint64"
        and g.native.result == "uint64"
        and #owner.paramKinds == #expected
        and #g.native.params == #expected,
        "root boundary signature"
    )
    for index, kind in ipairs(expected) do
        assert(owner.paramKinds[index] == kind and g.native.params[index] == kind, "root boundary signature")
    end
end

export function compile(mode: string): string
    assert(mode == "normal" or mode == "spill")
    local groups, modules = {}, {}
    for _, item in ipairs({
        {"arena", "src/nupp/runtime/core/arena.nupp"},
        {"frames", "src/nupp/runtime/core/frames.nupp"},
        {"rootentry", "src/nupp/runtime/core/rootentry.nupp"},
        {"rootprobe", "tests/root-probe.nupp"},
        {"context", "src/nupp/runtime/core/context.nupp"},
        {"rootlayout", "tests/root-layout.nupp"}
    }) do
        local name = "nupp.runtime.core." .. item[1]
        local functions, options = front.checked(
            front.read(ROOT .. "/native/core/" .. item[2]),
            ROOT .. "/native/core/src/nupp/runtime/core/" .. item[1] .. ".nupp",
            name
        )
        groups[#groups + 1] = {name = name, functions = functions}
        for key, value in pairs(options.modules) do
            modules[key] = value
        end
    end
    local layout = {}
    for name, owner in pairs(groups[#groups].functions) do
        local stats = owner.body.body.stats
        assert(#stats == 1 and stats[1].kind == "returnStmt" and #stats[1].exprs == 1, "layout query body")
        local call = stats[1].exprs[1]
        local text = #call.args.exprs == 0 and nativelayout.constant(call, "size") or nativelayout.fieldOffset(call)
        layout[name] = assert(tonumber(text))
    end
    local resolved, names = {}, {}
    for index = 1, #groups - 1 do
        local group = groups[index]
        for name, owner in pairs(group.functions) do
            local symbol = group.name .. "." .. name
            local g = lower.functionGraph(owner, {modules = modules, abi = "leaf"}, nativegraph)
            resolved[symbol] = {graph = g, owner = owner}
            names[#names + 1] = symbol
        end
    end
    local boundaries: {
        any
    } = {
        {
            name = "nupp.runtime.core.rootentry.start",
            params = {"voidptr", "uint64", "voidptr", "voidptr", "uint64", "voidptr", "uint64"}
        },
        {name = "nupp.runtime.core.rootentry.complete", params = {"voidptr", "voidptr", "uint64"}},
        {
            name = "nupp.runtime.core.rootprobe.CoreRootComplete",
            params = {"voidptr", "voidptr", "voidptr", "voidptr", "voidptr", "voidptr"}
        }
    }
    local refusals = {}
    for _, contract in ipairs(boundaries) do
        local item = assert(resolved[contract.name], "root boundary missing")
        boundary(item, contract.params)
        -- Change graph metadata only, restore it before selection, and require
        -- the exact boundary diagnostic for argument, result and profile drift.
        local native = item.graph.native
        local argument, result, abi = native.params[1], native.result, native.abi
        for _, kind in ipairs({"argument", "result", "profile"}) do
            if kind == "argument" then
                native.params[1] = "int64"
            elseif kind == "result" then
                native.result = "boolean"
            else
                native.abi = "handler"
            end
            local ok, problem = pcall(boundary, item, contract.params)
            native.params[1], native.result, native.abi = argument, result, abi
            assert(
                not ok and tostring(problem):find("root boundary signature", 1, true),
                "missing root signature refusal: " .. kind
            )
            refusals[#refusals + 1] = contract.name .. ":" .. kind
        end
        boundary(item, contract.params)
        contract.source, contract.abi, contract.result = item.graph.source, "leaf", "uint64"
    end
    table.sort(names)
    local codes, metrics = {}, {}
    for _, name in ipairs(names) do
        local item = resolved[name]
        local artifact = sink.compilerGraph(item.graph, item.owner.name, item.owner, resolved)
        local target = selector.target()
        if mode == "spill" then
            target.integerRegisters, target.floatRegisters = {}, {}
        end
        local allocation = allocate.run(artifact.machine, target)
        assert(allocationcheck.run(artifact.machine, target, allocation))
        codes[name] = selector.run(artifact.machine, allocation)
        metrics[
            #metrics + 1
        ] = {
            name = name,
            source = item.graph.source,
            params = item.graph.native.params,
            result = item.graph.native.result,
            frameBytes = codes[name].frameBytes,
            words = #codes[name].words,
            spillSlots = allocation.spillSlots,
            machineOps = #artifact.machine.op
        }
    end
    local prefix = "nupp.runtime.core."
    local handler = codes[prefix .. "rootprobe.CoreRootComplete"]
    codes[prefix .. "rootprobe.CoreRootComplete"] = nil
    local result = shim.build(handler, codes, layout)
    result.handlers, result.functions, result.mode = {{name = "CoreRootComplete"}}, metrics, mode
    result.boundaries, result.refusals = boundaries, refusals

    return json.encodevalue(result)
end

export function data(selection: string, choice: string): string
    local result = json.decodevalue(front.read(selection))
    local layout = result.layout
    local selected = assert(tonumber(choice))
    assert(selected >= 0 and selected <= 5 and selected % 1 == 0, "root probe choice")
    assert(#result.offsets == 1 and result.offsets[1] % 4 == 0 and result.offsets[1] < #result.words * 4)
    local words = {}
    for at = 1, layout.descriptorBytes // 8 do
        words[at] = 0
    end

    local function put(field: string, value: integer): nil
        local offset = layout[field]
        assert(offset >= 0 and offset % 8 == 0 and offset < layout.descriptorBytes, "checked descriptor field")
        words[offset // 8 + 1] = value
    end

    put("descriptorVersion", 1)
    put("descriptorId", 1)
    put("descriptorBody", layout.descriptorBytes)
    put("descriptorCount", 1)
    put("descriptorValues", 8)
    put("descriptorIntegers", 128)
    put("descriptorFloats", 2)
    put("descriptorVectors", 0)
    put("descriptorTable", (layout.descriptorBytes + 16) as integer)
    put("descriptorHandlers", 1)
    local output = {}
    for _, word in ipairs(words) do
        output[#output + 1] = graphimage.wideBytes(word)
    end
    -- One checked test-handler record; no raw-to-tag conversion or guest Ret.
    output[#output + 1] = string.char(0, selected) .. string.rep(string.char(0), 14)
    output[#output + 1] = graphimage.wideBytes(result.offsets[1])

    return table.concat(output)
end
