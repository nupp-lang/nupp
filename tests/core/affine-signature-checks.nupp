module nupp.core.affinesignaturechecks

-- Consumed by the fixed service preparation driver with service.build().
-- Signature/descriptor checks only; no executable Arena ownership claim.
local graph = require("nupp.compiler.vm.graph")
local physical = require("nupp.compiler.vm.nativephysical")
local service = require("nupp.compiler.vm.nativeservice")
local unit = require("nupp.compiler.vm.nativeunit")

local function refuses(callback: function(): nil, text: string): nil
    local ok, message = pcall(callback)
    assert(not ok, "unsupported affine boundary accepted")
    assert(tostring(message):find(text, 1, true), tostring(message))
end

export function check(build: any): boolean
    local owners = service.owners(build.catalog)
    local arena: any = nil
    for _, owner in ipairs(owners) do
        if owner.scope.name == "nupp.runtime.vm.arena" then
            arena = owner.scope
        end
    end
    assert(arena)
    local constructors = {arena.exports.open, arena.exports.openGrowable, arena.functions.openWith}
    local issued: any = {}
    for _, owner in ipairs({constructors[1], constructors[2], constructors[3], arena.exports.close}) do
        local options = service.options(build.catalog, owner)
        local capability = service.signature(owner, options)
        local context = unit.ownerContext(owner)
        local declaration = graph.nativeLeafDeclaration(owner, context, nil, nil, capability)
        assert(declaration.service == capability and declaration.physical)
        physical.validateSignature(declaration.physical)
        issued[owner] = {capability = capability, context = context, declaration = declaration}
    end
    for _, owner in ipairs(constructors) do
        local item = issued[owner]
        local descriptor = item.declaration.physical.result
        assert(descriptor.checkedType == owner.resultType)
        assert(#descriptor.ownership == 1 and descriptor.ownership[1] == owner.resultType)
        assert(descriptor.machineKind == "voidptr" and not descriptor.nullable)
        refuses(
            function(): nil
                graph.nativeLeafDeclaration(owner, item.context)
            end,
            "private service signature"
        )
        -- A plain pointer does not become an affine owner merely by returning it.
        assert(
            not physical.returnValue(item.declaration.physical, physical.describe(item.context, owner.resultType.inner))
        )
    end
    local close, open = arena.exports.close, arena.exports.open
    local closing, opening = issued[close], issued[open]
    local parameter = closing.declaration.physical.params[1]
    assert(parameter.checkedType == close.parameterTypes[1])
    assert(parameter.ownership[1] == close.parameterTypes[1] and not physical.dependent(parameter))
    assert(
        not physical.returnValue(opening.declaration.physical, parameter),
        "terminal-less takes binding cannot satisfy returned Arena cleanup obligation"
    )
    refuses(
        function(): nil
            graph.nativeLeafDeclaration(close, closing.context)
        end,
        "private service signature"
    )
    refuses(
        function(): nil
            service.arenaOwnership({}, open)
        end,
        "unissued service signature"
    )
    refuses(
        function(): nil
            service.arenaOwnership(closing.capability, open)
        end,
        "foreign arena ownership"
    )
    refuses(
        function(): nil
            service.arenaOwnership(opening.capability, open, 1)
        end,
        "terminal takes boundary"
    )
    -- Execution still needs a call-scoped ownership transfer proof; do not
    -- widen the ordinary borrowed-pointer argument relation here.
    refuses(
        function(): nil
            physical.argument(parameter, opening.declaration.physical.result)
        end,
        "unsupported pointer parameter capability"
    )
    local signature = opening.declaration.physical
    local copy = {}
    for key, value in pairs(signature) do
        copy[key] = value
    end
    refuses(
        function(): nil
            physical.validateSignature(copy)
        end,
        "unknown checked pointer signature"
    )
    local descriptor = signature.result
    local ownership = descriptor.ownership
    descriptor.ownership = {}
    refuses(
        function(): nil
            physical.validateSignature(signature)
        end,
        "ownership changed"
    )
    descriptor.ownership = ownership
    physical.validateSignature(signature)

    return true
end
