module nupp.core.catalogtablesmixedconstructor

-- A table constructor mixing named fields and positional items, as the
-- compiler's construction wrapper is built: the positional item is the first
-- array element whatever the fields around it read. Each check is a bit.
local function wrap(node: any): any
    return {kind = "newExpr", call = node, inferredType = node.inferredType, node}
end

local function wrapFirst(node: any): any
    return {node, kind = "newExpr", call = node, inferredType = node.inferredType}
end

local function wrapTwo(node: any, other: any): any
    return {kind = "pair", node, first = node.inferredType, other, last = other.kind}
end

local score = 0
local inner: any = {kind = "call", inferredType = {tag = "nominal", fields = {a = 1}}}
local other: any = {kind = "other"}
local wrapped = wrap(inner)
if #wrapped == 1 and wrapped[1] == inner and wrapped[2] == nil and wrapped.call == inner then
    score = score | 1
end
if wrapped.inferredType == inner.inferredType and wrapped.kind == "newExpr" then
    score = score | 2
end
local first = wrapFirst(inner)
if #first == 1 and first[1] == inner and first.inferredType == inner.inferredType then
    score = score | 4
end
local two = wrapTwo(inner, other)
if #two == 2 and two[1] == inner and two[2] == other and two.first == inner.inferredType and two.last == "other" then
    score = score | 8
end
export const result = score
