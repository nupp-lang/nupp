module nupp.core.catalognumberbranch

local function choose(): boolean
    if 1.5 < 2.0 then
        if -0.0 < 0.0 then
            return false
        else
            return true
        end
    else
        return false
    end
end

-- Graph profiles before version 8 have no tables to export from, so the
-- module value is the result itself.
export = choose()
