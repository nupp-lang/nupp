module nupp.core.rawexecutableproducer

local ROOT = assert(os.getenv("NUPP_COMPILER_ROOT"))
local front = require("nupp.core.source")
local lower = require("nupp.compiler.vm.lower")
local profile = require("nupp.compiler.vm.nativegraph")
local layout = require("nupp.compiler.vm.nativelayout")
local sink = require("nupp.compiler.s0.nativegraph")
local allocate = require("s0.allocate")
local allocationcheck = require("s0.allocationcheck")
local selector = require("s0.select")
local shim = require("nupp.core.rawexecutableshim")
local generator = require("nupp.core.rawsemanticgen")
local budgetgen = require("nupp.core.rawbudgetgen")
local executablegen = require("nupp.core.rawexecutablegen")
local wiregen = require("nupp.core.rawwiregen")
local shapegen = require("nupp.core.rawshapegen")
local cataloggen = require("nupp.core.rawcataloggen")
local json = require("serde.json")

export function generated(): string
    return generator.source()
end

export function budgetGenerated(): string
    return budgetgen.source()
end

export function executableGenerated(): string
    return executablegen.source()
end

export function wireGenerated(): string
    return wiregen.source()
end

export function shapeGenerated(): string
    return shapegen.source()
end

export function catalogGenerated(): string
    return cataloggen.source()
end

export function compile(mode: string): string
    assert(mode == "normal" or mode == "spill")
    assert(
        front.read(ROOT .. "/native/core/src/nupp/runtime/core/rawsemanticpolicy.nupp") == generator.source(),
        "generated wire source differs"
    )
    assert(
        front.read(ROOT .. "/native/core/src/nupp/runtime/core/rawbudgetpolicy.nupp") == budgetgen.source(),
        "generated budget source differs"
    )
    assert(
        front.read(ROOT .. "/native/core/src/nupp/runtime/core/rawexecutablepolicy.nupp") == executablegen.source(),
        "generated executable policy differs"
    )
    assert(
        front.read(ROOT .. "/native/core/src/nupp/runtime/core/rawwire.nupp") == wiregen.source(),
        "generated wire differs"
    )
    assert(
        front.read(ROOT .. "/native/core/src/nupp/runtime/core/rawroles.nupp") == shapegen.source(),
        "generated shape differs"
    )
    assert(
        front.read(ROOT .. "/native/core/src/nupp/runtime/core/rawcatalogpolicy.nupp") == cataloggen.source(),
        "generated catalog differs"
    )
    local groups, modules = {}, {}
    for _, item in ipairs({
        {"rawwire", "src/nupp/runtime/core/rawwire.nupp"},
        {"rawheader", "src/nupp/runtime/core/rawheader.nupp"},
        {"rawroles", "src/nupp/runtime/core/rawroles.nupp"},
        {"rawshape", "src/nupp/runtime/core/rawshape.nupp"},
        {"rawcatalogpolicy", "src/nupp/runtime/core/rawcatalogpolicy.nupp"},
        {"rawcatalog", "src/nupp/runtime/core/rawcatalog.nupp"},
        {"rawbudgetpolicy", "src/nupp/runtime/core/rawbudgetpolicy.nupp"},
        {"rawbudget", "src/nupp/runtime/core/rawbudget.nupp"},
        {"rawsemanticpolicy", "src/nupp/runtime/core/rawsemanticpolicy.nupp"},
        {"rawsemantics", "src/nupp/runtime/core/rawsemantics.nupp"},
        {"guestcatalog", "src/nupp/runtime/core/guestcatalog.nupp"},
        {"rawexecutablepolicy", "src/nupp/runtime/core/rawexecutablepolicy.nupp"},
        {"rawexecutable", "src/nupp/runtime/core/rawexecutable.nupp"},
        {"rawheaderlayout", "tests/raw-header-layout.nupp"}
    }) do
        local name = "nupp.runtime.core." .. item[1]
        local owners, options = front.checked(
            front.read(ROOT .. "/native/core/" .. item[2]),
            ROOT .. "/native/core/src/nupp/runtime/core/" .. item[1] .. ".nupp",
            name
        )
        groups[#groups + 1] = {name = name, owners = owners}
        for key, value in pairs(options.modules) do
            modules[key] = value
        end
    end
    local sizes = {}
    for name, owner in pairs(groups[#groups].owners) do
        local stats = owner.body.body.stats
        assert(#stats == 1 and stats[1].kind == "returnStmt" and #stats[1].exprs == 1, "raw header layout query")
        local call = stats[1].exprs[1]
        sizes[
            name
        ] = assert(tonumber(#call.args.exprs == 0 and layout.constant(call, "size") or layout.fieldOffset(call)))
    end
    assert(sizes.headerBytes == 48 and sizes.sectionBytes == 24, "raw header descriptor sizes")
    for index, field in ipairs({"phase", "data", "dataBytes", "entry", "sectionCount", "reserved"}) do
        assert(sizes["Descriptor_" .. field] == (index - 1) * 8, "raw header descriptor field")
    end
    for index, field in ipairs({"data", "count", "bytes"}) do
        assert(sizes["Section_" .. field] == (index - 1) * 8, "raw header section field")
    end
    local resolved, names = {}, {}
    for index = 1, #groups - 1 do
        local group = groups[index]
        for name, owner in pairs(group.owners) do
            if group.name ~= "nupp.runtime.core.guestcatalog"
                or name == "range"
                or name == "contains"
                or name == "valid"
                or name == "validate"
            then
                local symbol = group.name .. "." .. name
                local ok, g = pcall(lower.functionGraph, owner, {abi = "leaf", modules = modules}, profile)
                assert(ok, symbol .. ": " .. tostring(g))
                resolved[symbol] = {graph = g, owner = owner}
                names[#names + 1] = symbol
            end
        end
    end
    local symbol = "nupp.runtime.core.rawexecutable.admit"
    local boundary = assert(resolved[symbol])
    local expected = {"voidptr"}
    assert(
        boundary.owner.node.body == boundary.owner.body
        and boundary.owner.scope.functions[boundary.owner.name] == boundary.owner,
        "raw boundary checked owner"
    )
    assert(
        boundary.graph.native.abi == "leaf"
        and boundary.owner.nativeABI == "leaf"
        and boundary.graph.native.result == "uint64"
        and boundary.owner.resultKind == "uint64",
        "raw boundary result"
    )
    assert(#boundary.graph.native.params == #expected and #boundary.owner.paramKinds == #expected, "raw boundary arity")
    for at, kind in ipairs(expected) do
        assert(
            boundary.graph.native.params[at] == kind and boundary.owner.paramKinds[at] == kind,
            "raw boundary parameter"
        )
    end
    table.sort(names)
    local codes, metrics = {}, {}
    for _, name in ipairs(names) do
        local item = resolved[name]
        local ok, artifact = pcall(sink.compilerGraph, item.graph, item.owner.name, item.owner, resolved)
        assert(ok, name .. ": " .. tostring(artifact))
        local target = selector.target()
        if mode == "spill" then
            target.integerRegisters, target.floatRegisters = {}, {}
        end
        local allocation = allocate.run(artifact.machine, target)
        assert(allocationcheck.run(artifact.machine, target, allocation))
        local code = selector.run(artifact.machine, allocation)
        codes[name] = code
        metrics[
            #metrics + 1
        ] = {
            name = name,
            params = item.graph.native.params,
            result = item.graph.native.result,
            frameBytes = code.frameBytes,
            spillSlots = allocation.spillSlots,
            words = #code.words,
            calls = #code.fixupKind
        }
    end
    local result = shim.build(codes, symbol)
    result.metrics, result.mode, result.boundary, result.layout = metrics, mode, symbol, sizes

    return json.encodevalue(result)
end
