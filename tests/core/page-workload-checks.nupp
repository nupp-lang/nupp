module nupp.runtime.core.pageworkloadchecks

const native = require("nupp.runtime.vm.intrinsics")
const pages = require("nupp.runtime.core.pagemappings")
const service = require("nupp.runtime.core.servicescope")

-- Called by the combined collecting workload, not a separate executable probe.
-- The owner supplies the actual retained Scope and expected scenario outcome.
export function completed(scope: voidptr, expectedPhase: uint64, expectedLive: uint64, expectedFailure: uint64): uint64
    if native.load64(scope, native.fieldOffset<pages.Scope>("phase")) ~= expectedPhase
        or native.load64(scope, native.fieldOffset<pages.Scope>("live")) ~= expectedLive
        or native.load64(scope, native.fieldOffset<pages.Scope>("cleanupFailed")) ~= expectedFailure
    then
        return 1ULL
    end
    local records = native.loadPointer(scope, native.fieldOffset<pages.Scope>("records"))
    local capacity = native.load64(scope, native.fieldOffset<pages.Scope>("capacity"))
    if capacity == 0ULL or capacity > 4096ULL then
        return 2ULL
    end
    local live: uint64 = 0ULL
    local index: uint64 = 0ULL
    while index < capacity do
        local record = native.offset(records, native.index(index * native.sizeOf<pages.Mapping>()))
        local state = native.load64(record, native.fieldOffset<pages.Mapping>("state"))
        if state ~= 0ULL and state ~= 2ULL then
            return 3ULL
        end
        if state == 2ULL then
            if native.load64(record, native.fieldOffset<pages.Mapping>("base")) == 0ULL
                or native.load64(record, native.fieldOffset<pages.Mapping>("bytes")) == 0ULL
                or native.load64(record, native.fieldOffset<pages.Mapping>("serial")) == 0ULL
            then
                return 4ULL
            end
            live = live + 1ULL
        end
        index = index + 1ULL
    end
    if live ~= expectedLive then
        return 5ULL
    end

    return 0ULL
end

-- Stale identity refusal must not change live count or cleanup status. The
-- workload passes a previously retired token after an actual slot reuse.
export function stale(scope: voidptr, token: uint64): uint64
    local live = native.load64(scope, native.fieldOffset<pages.Scope>("live"))
    local issued = native.load64(scope, native.fieldOffset<pages.Scope>("issued"))
    local failure = native.load64(scope, native.fieldOffset<pages.Scope>("cleanupFailed"))
    if pages.unmapOwned(scope, token) ~= 0ULL then
        return 1ULL
    end
    if native.load64(scope, native.fieldOffset<pages.Scope>("live")) ~= live
        or native.load64(scope, native.fieldOffset<pages.Scope>("issued")) ~= issued
        or native.load64(scope, native.fieldOffset<pages.Scope>("cleanupFailed")) ~= failure
    then
        return 2ULL
    end

    return 0ULL
end

-- A valid-scope invalid release cannot be erased by a later successful drain.
-- The combined workload supplies an unowned mapped address or wrong extent.
export function refusedRelease(scope: voidptr, base: voidptr, bytes: uint64): uint64
    local live = native.load64(scope, native.fieldOffset<pages.Scope>("live"))
    local issued = native.load64(scope, native.fieldOffset<pages.Scope>("issued"))
    if pages.unmap(scope, base, bytes) ~= 0ULL then
        return 1ULL
    end
    if native.load64(scope, native.fieldOffset<pages.Scope>("live")) ~= live
        or native.load64(scope, native.fieldOffset<pages.Scope>("issued")) ~= issued
        or native.load64(scope, native.fieldOffset<pages.Scope>("cleanupFailed")) ~= 1ULL
    then
        return 2ULL
    end
    if pages.close(scope) ~= 0ULL or native.load64(scope, native.fieldOffset<pages.Scope>("phase")) ~= 3ULL then
        return 3ULL
    end

    return 0ULL
end

-- Combined workload supplies a live ledger mapping and disjoint snapshot
-- storage. Retention must survive both lexical unmap and outer close without
-- changing any ledger byte. Snapshot storage is not owned by that ledger.
export function retainedBacking(
    scope: voidptr,
    base: voidptr,
    bytes: uint64,
    snapshot: voidptr,
    snapshotBytes: uint64
): uint64
    local ledger = native.loadPointer(scope, native.fieldOffset<service.ServiceScope>("pages"))
    local records = native.loadPointer(ledger, native.fieldOffset<pages.Scope>("records"))
    local capacity = native.load64(ledger, native.fieldOffset<pages.Scope>("capacity"))
    if capacity == 0ULL or capacity > 4096ULL then
        return 1ULL
    end
    local header = native.sizeOf<pages.Scope>()
    local extent = capacity * native.sizeOf<pages.Mapping>()
    if snapshotBytes < header + extent then
        return 2ULL
    end
    local offset: uint64 = 0ULL
    while offset < header do
        native.store64(snapshot, native.index(offset), native.load64(ledger, native.index(offset)))
        offset = offset + 8ULL
    end
    offset = 0ULL
    while offset < extent do
        native.store64(snapshot, native.index(header + offset), native.load64(records, native.index(offset)))
        offset = offset + 8ULL
    end
    service.retain(scope)
    local first = native.load64(scope, native.fieldOffset<service.ServiceScope>("error"))
    service.unmapPages(scope, base, bytes)
    if service.close(scope) ~= 0ULL
        or first == 0ULL
        or native.load64(scope, native.fieldOffset<service.ServiceScope>("error")) ~= first
    then
        return 3ULL
    end
    offset = 0ULL
    while offset < header do
        if native.load64(snapshot, native.index(offset)) ~= native.load64(ledger, native.index(offset)) then
            return 4ULL
        end
        offset = offset + 8ULL
    end
    offset = 0ULL
    while offset < extent do
        if native.load64(snapshot, native.index(header + offset)) ~= native.load64(records, native.index(offset)) then
            return 5ULL
        end
        offset = offset + 8ULL
    end

    return 0ULL
end
