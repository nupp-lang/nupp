module nupp.core.catalogcoreoperators

local record Settings
    width: number = 2.5
    label: string? = nil
    tags: {string} = {"a", "b"}
end

local function pick(flag: boolean): integer
    return flag ? 1 : 2
end

local score = 0
if (12 & 10) == 8 and (12 | 3) == 15 and (5 ~ 1) == 4 and (1 << 4) == 16 and (256 >> 4) == 16 and ~0 == -1 then
    score = score + 1
end
local wide: any = 3.0
if (1 << 64) == 0 and (1 << -1) == 0 and (-1 >> 63) == 1 and (wide & 1) == 1 then
    score = score + 2
end
if tonumber("ff", 16) == 255
    and tonumber("  -z ", 36) == -35
    and tonumber("8", 8) == nil
    and tonumber("10", nil) == 10
then
    score = score + 4
end
local n = 1
n += 4
n *= 3
local t = {count = 2}
t.count += 5
if n == 15 and t.count == 7 then
    score = score + 8
end
if pick(true) == 1 and pick(false) == 2 then
    score = score + 16
end
local a = Settings()
local b = Settings()
if a.width == 2.5 and a.label == nil and #a.tags == 2 and a.tags ~= b.tags then
    score = score + 32
end
local limit: any = "3"
local total = 0
for i = 1, limit do
    total = total + i
end
if total == 6 then
    score = score + 64
end
local half: any = 1.5
local ok, problem = pcall(function(): any
    return half & 1
end)
if not ok and tostring(problem):find("number has no integer representation", 1, true) then
    score = score + 128
end
local text: any = "1"
local ok2, problem2 = pcall(function(): any
    return text | 1
end)
if not ok2 and tostring(problem2):find("bitwise operation on a string value", 1, true) then
    score = score + 256
end
local absent: any = nil
local ok3, problem3 = pcall(function(): number
    local sum = 0
    for i = 1, absent do
        sum = sum + i
    end

    return sum
end)
if not ok3 and tostring(problem3):find("bad 'for' limit (number expected, got nil)", 1, true) then
    score = score + 512
end
export const result = score
