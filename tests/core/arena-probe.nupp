module nupp.runtime.core.arenaprobe

const native = require("nupp.runtime.vm.intrinsics")
const arena = require("nupp.runtime.core.arena")

const BAD_LAYOUT = 1ULL
const BAD_INITIAL_REFUSAL = 2ULL
const INITIAL_MUTATION = 3ULL
const BAD_INITIALIZE = 4ULL
const BAD_PARENT = 5ULL
const BAD_RESIDENT_CHILD = 6ULL
const BAD_PADDING = 7ULL
const BAD_LIFO = 8ULL
const BAD_RELEASE = 9ULL
const BAD_STABILITY = 10ULL
const BAD_ABA = 11ULL
const BAD_RESET = 12ULL
const BAD_REFUSAL = 13ULL
const REFUSAL_MUTATION = 14ULL
const BAD_EXACT_FIT = 15ULL
const BAD_EXHAUSTION = 16ULL
const BAD_RELEASE_VALIDATION = 17ULL

-- Test-only storage: the entry lends its 2048-byte integer window. Descriptor
-- [0,40), marks [64,120)/[128,184)/[192,248)/[256,312), snapshots [320,360)
-- and [384,440), spare descriptor [448,488), payload [512,1536) are disjoint.
-- A child's resident mark occupies its still-live parent's [576,632) header.
-- Offsets below are independent layout assertions, not production mirrors.
export function CoreArenaProbe(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    if native.sizeOf<arena.Segment>() ~= 40ULL
        or native.alignmentOf<arena.Segment>() ~= 8ULL
        or native.sizeOf<arena.Mark>() ~= 56ULL
        or native.alignmentOf<arena.Mark>() ~= 8ULL
        or native.fieldOffset<arena.Segment>("top") ~= 32ULL
        or native.fieldOffset<arena.Mark>("bytes") ~= 48ULL
    then
        return BAD_LAYOUT
    end
    local offset: uint64 = 0ULL
    while offset < 1536ULL do
        native.store64(ints, native.index(offset), 0ULL)
        offset = offset + 8ULL
    end
    local descriptor = ints
    local markA = native.offset(ints, 64)
    local markB = native.offset(ints, 128)
    local oldMark = native.offset(ints, 192)
    local outputMark = native.offset(ints, 256)
    local resident = native.offset(ints, 576)
    local base = native.address(ints) + 512ULL
    local limit = base + 1024ULL
    if (base & 15ULL) ~= 0ULL then
        return BAD_LAYOUT
    end
    if arena.initialize(descriptor, 0ULL, 1024ULL) ~= 0ULL
        or arena.initialize(descriptor, base, 0ULL) ~= 0ULL
        or arena.initialize(descriptor, 0xfffffffffffffff0ULL, 16ULL) ~= 0ULL
        or arena.initialize(descriptor, native.address(descriptor) + 8ULL, 64ULL) ~= 0ULL
        or arena.initialize(native.pointer(0ULL), base, 1024ULL) ~= 0ULL
        or arena.initialize(native.pointer(0xfffffffffffffff8ULL), base, 1024ULL) ~= 0ULL
        or arena.initialize(native.offset(descriptor, 1), base, 1024ULL) ~= 0ULL
        or arena.reset(descriptor) ~= 0ULL
    then
        return BAD_INITIAL_REFUSAL
    end
    offset = 0ULL
    while offset < 40ULL do
        if native.load64(descriptor, native.index(offset)) ~= 0ULL then
            return INITIAL_MUTATION
        end
        offset = offset + 8ULL
    end
    if arena.initialize(descriptor, base, 1024ULL) ~= 1ULL
        or arena.initialize(descriptor, base, 1024ULL) ~= 0ULL
        or native.load64(descriptor, 0) ~= base
        or native.load64(descriptor, 8) ~= limit
    then
        return BAD_INITIALIZE
    end
    if arena.reserve(descriptor, 256ULL, 16ULL, markA) ~= 1ULL
        or native.load64(markA, 0) ~= native.address(descriptor)
        or native.load64(markA, 8) ~= 1ULL
        or native.load64(markA, 16) ~= 0ULL
        or native.load64(markA, 24) ~= base
        or native.load64(markA, 32) ~= base + 256ULL
        or native.load64(markA, 40) ~= base
        or native.load64(markA, 48) ~= 256ULL
    then
        return BAD_PARENT
    end
    if arena.reserve(descriptor, 1ULL, 16ULL, native.pointer(base + 240ULL)) ~= 0ULL
        or native.load64(descriptor, 16) ~= base + 256ULL
        or native.load64(descriptor, 24) ~= 1ULL
        or native.load64(descriptor, 32) ~= 1ULL
    then
        return BAD_RESIDENT_CHILD
    end
    native.store64(native.pointer(base), 8, 0xfedcba9876543210ULL)
    if arena.reserve(descriptor, 17ULL, 16ULL, resident) ~= 1ULL
        or native.load64(resident, 8) ~= 2ULL
        or native.load64(resident, 16) ~= 1ULL
        or native.load64(resident, 24) ~= base + 256ULL
        or native.load64(resident, 32) ~= base + 273ULL
        or native.load64(resident, 40) ~= base + 256ULL
        or native.load64(resident, 48) ~= 17ULL
    then
        return BAD_RESIDENT_CHILD
    end
    if arena.reserve(descriptor, 16ULL, 16ULL, markB) ~= 1ULL
        or native.load64(markB, 24) ~= base + 273ULL
        or native.load64(markB, 40) ~= base + 288ULL
        or native.load64(descriptor, 16) ~= base + 304ULL
    then
        return BAD_PADDING
    end
    offset = 0ULL
    while offset < 56ULL do
        native.store64(oldMark, native.index(offset), native.load64(markB, native.index(offset)))
        offset = offset + 8ULL
    end
    offset = 0ULL
    while offset < 40ULL do
        native.store64(ints, native.index(320ULL + offset), native.load64(descriptor, native.index(offset)))
        offset = offset + 8ULL
    end
    if arena.canRelease(descriptor, markB) ~= 1ULL
        or arena.canRelease(descriptor, resident) ~= 0ULL
        or arena.canRelease(descriptor, markA) ~= 0ULL
        or arena.canRelease(descriptor, native.pointer(0ULL)) ~= 0ULL
    then
        return BAD_RELEASE_VALIDATION
    end
    offset = 0ULL
    while offset < 40ULL do
        if native.load64(descriptor, native.index(offset)) ~= native.load64(ints, native.index(320ULL + offset)) then
            return BAD_RELEASE_VALIDATION
        end
        offset = offset + 8ULL
    end
    offset = 0ULL
    while offset < 56ULL do
        if native.load64(markB, native.index(offset)) ~= native.load64(oldMark, native.index(offset)) then
            return BAD_RELEASE_VALIDATION
        end
        offset = offset + 8ULL
    end
    native.store64(oldMark, 0, native.address(descriptor) + 448ULL)
    if arena.canRelease(descriptor, oldMark) ~= 0ULL or arena.release(descriptor, oldMark) ~= 0ULL then
        return BAD_LIFO
    end
    if arena.release(descriptor, resident) ~= 0ULL
        or arena.release(descriptor, markA) ~= 0ULL
        or arena.reset(descriptor) ~= 0ULL
        or native.load64(descriptor, 16) ~= base + 304ULL
        or native.load64(descriptor, 24) ~= 3ULL
        or native.load64(descriptor, 32) ~= 3ULL
    then
        return BAD_LIFO
    end
    if arena.release(descriptor, markB) ~= 1ULL
        or native.load64(descriptor, 16) ~= base + 273ULL
        or arena.release(descriptor, resident) ~= 1ULL
        or native.load64(descriptor, 16) ~= base + 256ULL
        or native.load64(descriptor, 32) ~= 1ULL
    then
        return BAD_RELEASE
    end
    if native.load64(native.pointer(base), 8) ~= 0xfedcba9876543210ULL or native.load64(resident, 8) ~= 2ULL then
        return BAD_STABILITY
    end
    offset = 0ULL
    while offset < 56ULL do
        native.store64(oldMark, native.index(offset), native.load64(markA, native.index(offset)))
        offset = offset + 8ULL
    end
    if arena.release(descriptor, markA) ~= 1ULL
        or arena.reserve(descriptor, 256ULL, 16ULL, markA) ~= 1ULL
        or arena.canRelease(descriptor, oldMark) ~= 0ULL
        or arena.release(descriptor, oldMark) ~= 0ULL
        or native.load64(descriptor, 16) ~= base + 256ULL
        or native.load64(descriptor, 24) ~= 4ULL
        or native.load64(descriptor, 32) ~= 4ULL
    then
        return BAD_ABA
    end
    if arena.reset(descriptor) ~= 0ULL
        or arena.release(descriptor, markA) ~= 1ULL
        or arena.release(descriptor, markA) ~= 0ULL
        or arena.reset(descriptor) ~= 1ULL
        or native.load64(descriptor, 16) ~= base
        or native.load64(descriptor, 24) ~= 4ULL
        or native.load64(descriptor, 32) ~= 0ULL
    then
        return BAD_RESET
    end
    offset = 0ULL
    while offset < 40ULL do
        native.store64(ints, native.index(320ULL + offset), native.load64(descriptor, native.index(offset)))
        offset = offset + 8ULL
    end
    offset = 0ULL
    while offset < 56ULL do
        native.store64(outputMark, native.index(offset), 0xa5a5a5a5a5a5a5a5ULL)
        offset = offset + 8ULL
    end
    offset = 0ULL
    while offset < 1024ULL do
        native.store64(native.pointer(base), native.index(offset), 0x5a5a5a5a5a5a5a5aULL)
        offset = offset + 8ULL
    end
    if arena.reserve(descriptor, 0ULL, 16ULL, outputMark) ~= 0ULL
        or arena.reserve(descriptor, 1ULL, 0ULL, outputMark) ~= 0ULL
        or arena.reserve(descriptor, 1ULL, 3ULL, outputMark) ~= 0ULL
        or arena.reserve(descriptor, 1025ULL, 16ULL, outputMark) ~= 0ULL
        or arena.reserve(descriptor, 0xffffffffffffffffULL, 16ULL, outputMark) ~= 0ULL
        or arena.reserve(descriptor, 1ULL, 0x8000000000000000ULL, outputMark) ~= 0ULL
        or arena.reserve(descriptor, 1ULL, 16ULL, descriptor) ~= 0ULL
        or arena.reserve(descriptor, 1ULL, 16ULL, native.pointer(base + 16ULL)) ~= 0ULL
        or arena.reserve(descriptor, 1ULL, 16ULL, native.pointer(base - 8ULL)) ~= 0ULL
        or arena.reserve(descriptor, 1ULL, 16ULL, native.pointer(0ULL)) ~= 0ULL
        or arena.reserve(descriptor, 1ULL, 16ULL, native.pointer(0xfffffffffffffff8ULL)) ~= 0ULL
        or arena.reserve(descriptor, 1ULL, 16ULL, native.offset(outputMark, 1)) ~= 0ULL
        or arena.release(descriptor, outputMark) ~= 0ULL
    then
        return BAD_REFUSAL
    end
    offset = 0ULL
    while offset < 40ULL do
        if native.load64(descriptor, native.index(offset)) ~= native.load64(ints, native.index(320ULL + offset)) then
            return REFUSAL_MUTATION
        end
        offset = offset + 8ULL
    end
    offset = 0ULL
    while offset < 56ULL do
        if native.load64(outputMark, native.index(offset)) ~= 0xa5a5a5a5a5a5a5a5ULL then
            return REFUSAL_MUTATION
        end
        offset = offset + 8ULL
    end
    offset = 0ULL
    while offset < 1024ULL do
        if native.load64(native.pointer(base), native.index(offset)) ~= 0x5a5a5a5a5a5a5a5aULL then
            return REFUSAL_MUTATION
        end
        offset = offset + 8ULL
    end
    if arena.reserve(descriptor, 1024ULL, 16ULL, markA) ~= 1ULL
        or native.load64(descriptor, 16) ~= limit
        or arena.reserve(descriptor, 1ULL, 1ULL, outputMark) ~= 0ULL
        or native.load64(descriptor, 16) ~= limit
        or native.load64(descriptor, 24) ~= 5ULL
        or arena.release(descriptor, markA) ~= 1ULL
    then
        return BAD_EXACT_FIT
    end
    native.store64(descriptor, 24, 0xffffffffffffffffULL)
    if arena.reserve(descriptor, 1ULL, 16ULL, outputMark) ~= 0ULL
        or arena.reset(descriptor) ~= 1ULL
        or native.load64(descriptor, 16) ~= base
        or native.load64(descriptor, 24) ~= 0xffffffffffffffffULL
        or native.load64(descriptor, 32) ~= 0ULL
        or arena.initialize(descriptor, base, 1024ULL) ~= 0ULL
    then
        return BAD_EXHAUSTION
    end

    return 0ULL
end
