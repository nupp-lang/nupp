module nupp.core.servicedependentreturnchecks

-- Construction/identity checks only, using the actual closed service catalog.
local graph = require("nupp.compiler.vm.graph")
local lower = require("nupp.compiler.vm.lower")
local nativegraph = require("nupp.compiler.vm.nativegraph")
local cleanup = require("nupp.compiler.vm.nativecleanup")
local physical = require("nupp.compiler.vm.nativephysical")
local service = require("nupp.compiler.vm.nativeservice")
local unit = require("nupp.compiler.vm.nativeunit")

local function refuses(callback: function(): nil, expected: string): nil
    local ok, message = pcall(callback)
    assert(not ok and tostring(message):find(expected, 1, true), tostring(message))
end

local function views(g: any): nil
    local count: integer = 0
    for _, block in ipairs(g.blocks) do
        for at, op in ipairs(block.op) do
            if op == "NativePointerView" and physical.viewKind(block.args[at][2]) == "dependentReturn" then
                count = count + 1
                local view = block.args[at][2]
                physical.validateCast(view)
                assert(view.source ~= view.target and physical.sameValue(view.source, view.target))
                assert(
                    view.source.checkedType == view.target.checkedType and view.source.nullable == view.target.nullable
                )
                assert(physical.dependent(view.target))
                local signature = g.nativePhysical.signature
                assert(physical.returnValue(signature, view.target))
                -- Same type and nullable bit do not supply the backing owner.
                local fresh = physical.describe(view.source.context, view.source.checkedType)
                refuses(
                    function(): nil
                        physical.dependentReturnView(signature.owner, fresh, view.node, signature)
                    end,
                    "lacks its exact backing dependency"
                )
                local copied = {}
                for key, value in pairs(view) do
                    copied[key] = value
                end
                refuses(
                    function(): nil
                        physical.validateCast(copied)
                    end,
                    "unknown checked pointer cast"
                )
                local saved = view.target
                view.target = fresh
                local ok, message = pcall(physical.validateCast, view)
                view.target = saved
                assert(
                    not ok and tostring(message):find("issued physical record field changed", 1, true),
                    tostring(message)
                )
                physical.validateCast(view)
                -- A phi descriptor cannot also become the new result's
                -- destination. Replacing the issued target must refuse.
                saved = g.nativePhysical.values[block.dst[at]]
                g.nativePhysical.values[block.dst[at]] = view.source
                ok, message = pcall(graph.verify, g)
                g.nativePhysical.values[block.dst[at]] = saved
                assert(not ok, "dependent view reused its source descriptor as a result")
                graph.verify(g)
            end
        end
    end
    assert(count > 0, "actual dependent return view missing")
end

local function metadata(g: any, owner: any): nil
    local signature = g.nativePhysical.signature
    local checked = owner.checkedSignature
    assert(checked.borrowsParam == 1 and checked.borrowsResult == 1)
    assert(checked.paramModes[1] == "borrows" and owner.parameterModeTokens[1].text == "borrows")
    assert(owner.parameterTypes[1].tag == "borrowed")
    assert(owner.resultType.tag == "borrowed" and signature.dependent == 1)
    local borrowed: integer = 0
    local returns: integer = 0
    for _, block in ipairs(g.blocks) do
        for at, op in ipairs(block.op) do
            if op == "NativeBorrowPointer" and physical.viewKind(block.args[at][3]) == "borrow" then
                borrowed = borrowed + 1
                local view = block.args[at][3]
                assert(view.node.ownershipIntrinsic == "borrowFrom")
                assert(view.node.args.exprs[2].token.definition == owner.parameterDefinitions[1])
                physical.validateCast(view)
                assert(physical.returnValue(signature, view.target))
                local erased = physical.describe(view.target.context, view.target.checkedType)
                assert(not physical.returnValue(signature, erased), "metadata return lost its backing dependency")
                local value = block.dst[at]
                local saved = g.nativePhysical.values[value]
                g.nativePhysical.values[value] = erased
                local ok = pcall(graph.verify, g)
                g.nativePhysical.values[value] = saved
                assert(not ok, "metadata result accepted an erased dependency")
                graph.verify(g)
                local savedSource = view.source
                view.source = g.nativePhysical.values[1]
                local accepted = pcall(graph.verify, g)
                view.source = savedSource
                assert(not accepted, "metadata view accepted a different pointer source")
                graph.verify(g)
            end
        end
        if block.term and block.term.kind == "return" then
            returns = returns + 1
            assert(physical.returnValue(signature, g.nativePhysical.values[block.term.value]))
        end
    end
    assert(borrowed == 1 and returns == 1, "actual classAt borrow/return shape differs")
end

local function callFields(g: any): nil
    local found: integer = 0
    for _, block in ipairs(g.blocks) do
        for at, op in ipairs(block.op) do
            local args = block.args[at]
            local access = op == "NativeStore" and args[4].field or nil
            if access and access.node.obj.kind == "call" then
                found = found + 1
                local call = access.node.obj
                local owner = g.nativePhysical.signature.owner
                assert(call.obj.kind == "name" and call.obj.token.text == "classAt")
                assert(access.name == "slotBytes" and access.write)
                physical.validateField(access)
                assert(physical.dependent(access.receiver))
                -- A different same-shaped AST node does not identify this call.
                local copied = {}
                for key, value in pairs(call) do
                    copied[key] = value
                end
                access.node.obj = copied
                local ok = pcall(graph.verify, g)
                access.node.obj = call
                assert(not ok, "field accepted a copied call occurrence")
                graph.verify(g)
                local definition = call.obj.token.definition
                call.obj.token.definition = owner.parameterDefinitions[1]
                ok = pcall(graph.verify, g)
                call.obj.token.definition = definition
                assert(not ok, "field accepted a different checked callee")
                graph.verify(g)
                local facts = call.resultCapabilityFacts and call.resultCapabilityFacts[1] or call.capabilityFacts
                local roots = facts.roots
                facts.roots = {}
                for index, root in ipairs(roots) do
                    facts.roots[index] = root
                end
                ok = pcall(graph.verify, g)
                facts.roots = roots
                assert(not ok, "field accepted replaced checked call-root evidence")
                graph.verify(g)
                local erased = physical.describe(access.receiver.context, access.receiver.checkedType)
                refuses(
                    function(): nil
                        physical.field(erased, access.node, true, g.nativePhysical.signature, owner)
                    end,
                    "borrowed field requires checked rooted receiver"
                )
                local receiver = args[1]
                args[1] = 1
                ok = pcall(graph.verify, g)
                args[1] = receiver
                assert(not ok, "field store accepted a different receiver SSA")
                graph.verify(g)
            end
        end
    end
    assert(found == 1, "actual Heap creation call-result field store missing")
end

-- Actual take has a reused-slot borrow and a nullable alloc result. The
-- post-if read of fresh retains the checker-distributed nullable borrow.
local function optionalTake(g: any, owner: any, foreignOwner: any): nil
    local count: integer = 0
    for _, block in ipairs(g.blocks) do
        for at, op in ipairs(block.op) do
            if op == "NativePointerView" and physical.viewKind(block.args[at][2]) == "optionalBorrow" then
                count = count + 1
                local view = block.args[at][2]
                assert(view.node.token.text == "fresh" and view.node.token.definition.type == view.source.checkedType)
                assert(view.source.checkedType.tag == "borrowed" and view.target.checkedType.tag == "union")
                assert(view.source.nullable and view.target.nullable and physical.dependent(view.target))
                assert(physical.returnValue(g.nativePhysical.signature, view.target))
                physical.validateCast(view)
                assert(unit.checkedOccurrenceType(owner, view.node) == view.target.checkedType)
                local checked = view.node.inferredType
                view.node.inferredType = view.source.checkedType
                local typeOK, typeMessage = pcall(unit.checkedOccurrenceType, owner, view.node)
                view.node.inferredType = checked
                assert(
                    not typeOK and tostring(typeMessage):find("checked occurrence type changed", 1, true),
                    tostring(typeMessage)
                )
                physical.validateCast(view)
                local copied = {}
                for key, value in pairs(view) do
                    copied[key] = value
                end
                refuses(
                    function(): nil
                        physical.validateCast(copied)
                    end,
                    "unknown checked pointer cast"
                )
                local lost = physical.describe(view.source.context, view.source.checkedType)
                refuses(
                    function(): nil
                        physical.occurrence(owner, lost, view.node)
                    end,
                    "optional borrowed occurrence lost source dependency"
                )
                refuses(
                    function(): nil
                        physical.occurrence(foreignOwner, view.source, view.node)
                    end,
                    "occurrence is outside checked owner"
                )
                local plain = physical.describe(view.source.context, view.source.checkedType.inner)
                refuses(
                    function(): nil
                        physical.occurrence(owner, plain, view.node)
                    end,
                    "checked nonnull pointer occurrence required"
                )
                local facts = view.node.resultCapabilityFacts and view.node.resultCapabilityFacts[1]
                    or view.node.capabilityFacts
                assert(facts and facts.roots and #facts.roots > 0)
                local root = facts.roots[1]
                local definition = root.definition
                root.definition = foreignOwner.parameterDefinitions[1]
                local rootsOK, rootsMessage = pcall(physical.validateCast, view)
                root.definition = definition
                assert(
                    not rootsOK and tostring(rootsMessage):find("borrow root declaration changed", 1, true),
                    tostring(rootsMessage)
                )
                physical.validateCast(view)
                local saved = view.target
                view.target = physical.describe(view.source.context, view.target.checkedType)
                local ok, message = pcall(physical.validateCast, view)
                view.target = saved
                assert(
                    not ok and tostring(message):find("issued physical record field changed", 1, true),
                    tostring(message)
                )
                graph.verify(g)
            end
        end
    end
    assert(count > 0, "actual take nullable borrow occurrence missing")
end

export function check(build: any): nil
    local wanted = {
        ["nupp.runtime.vm.arena"] = {alloc = true, pool = true, take = true},
        ["nupp.runtime.vm.heap"] = {zeroWords = true, zeroSet = true, zeroIndex = true, create = true}
    }
    local count: integer = 0
    local foreignOwner
    for _, candidate in ipairs(service.owners(build.catalog)) do
        if candidate.scope.name == "nupp.runtime.vm.arena" and candidate.name == "alloc" then
            foreignOwner = candidate
        end
    end
    assert(foreignOwner, "actual alloc owner missing")
    local managed = false
    local metadataCount: integer = 0
    for _, owner in ipairs(service.owners(build.catalog)) do
        if wanted[owner.scope.name] and wanted[owner.scope.name][owner.name] then
            count = count + 1
            local options = service.options(build.catalog, owner)
            local capability = service.signature(owner, options)
            assert(service.dependentReturn(capability, owner) == owner.resultType)
            refuses(
                function(): nil
                    service.dependentReturn({}, owner)
                end,
                "unissued service signature"
            )
            local g = lower.functionGraph(owner, options, cleanup.profile(nativegraph))
            graph.verify(g);
            service.verifyScope(g);
            views(g)
            if owner.name == "create" then
                callFields(g)
            end
            if owner.scope.name == "nupp.runtime.vm.arena" and owner.name == "take" then
                optionalTake(g, owner, foreignOwner)
            end
            graph.prune(g)
            graph.verify(g);
            service.verifyScope(g);
            views(g)
            if owner.name == "create" then
                callFields(g)
            end
            if owner.scope.name == "nupp.runtime.vm.arena" and owner.name == "take" then
                optionalTake(g, owner, foreignOwner)
            end
        elseif owner.scope.name == "nupp.runtime.vm.heap" and owner.name == "classAt" then
            metadataCount = metadataCount + 1
            local options = service.options(build.catalog, owner)
            local capability = service.signature(owner, options)
            assert(service.dependentReturn(capability, owner) == owner.resultType)
            assert(not service.needsCleanup(capability), "classAt unexpectedly gained cleanup scope")
            local saved = owner.checkedSignature.borrowsParam
            owner.checkedSignature.borrowsParam = nil
            local ok, message = pcall(service.dependentReturn, capability, owner)
            owner.checkedSignature.borrowsParam = saved
            assert(not ok and tostring(message):find("backing declaration differs", 1, true), tostring(message))
            local g = lower.functionGraph(owner, options, nativegraph)
            graph.verify(g)
            metadata(g, owner)
            graph.prune(g)
            graph.verify(g)
            metadata(g, owner)
        elseif owner.scope.name == "nupp.runtime.vm.heap" and owner.name == "allocRaw" then
            managed = true
            local capability = service.signature(owner, service.options(build.catalog, owner))
            refuses(
                function(): nil
                    service.dependentReturn(capability, owner)
                end,
                "outside reviewed Arena/Pool storage"
            )
        end
    end
    assert(count == 7 and metadataCount == 1 and managed, "closed dependent/metadata/managed source inventory differs")
end
