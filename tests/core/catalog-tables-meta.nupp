module nupp.core.catalogtablesmeta

-- Metatables: a read the table misses follows __index tables, a chain of
-- them included; a write of a key the table lacks goes to the __newindex
-- table, and one it holds stays; rawget and rawset pass by both, and
-- getmetatable answers __metatable when the metatable sets one.
local Base: {[string]: integer} = {bonus = 5, scale = 3}
local Middle: {[string]: integer} = setmetatable({scale = 7}, {__index = Base})
local obj: {[string]: integer} = setmetatable({}, {__index = Middle})
local score: integer = 0
score = score + (obj.bonus or 0) + (obj.scale or 0) * 10
if rawget(obj, "bonus") == nil then
    score = score + 100
end
local log: {[string]: integer} = {}
local guarded: {[string]: integer} = setmetatable({}, {__newindex = log})
guarded.hits = 4
score = score + (log.hits or 0) * 1000
if rawget(guarded, "hits") == nil then
    score = score + 10000
end
rawset(guarded, "hits", 9)
guarded.hits = 11
score = score + (guarded.hits or 0) * 100000 + (log.hits or 0) * 10000000
if getmetatable(obj) ~= nil and getmetatable(score) == nil then
    score = score + 1
end
local locked: {[string]: integer} = setmetatable({}, {__metatable = "locked"})
if getmetatable(locked) == "locked" then
    score = score + 2
end
local calls: integer = 0
local computed: {[string]: integer} = setmetatable({}, {
    __index = function(t: {[string]: integer}, k: string): integer
        calls = calls + 1
        return #k * 10
    end
})
local behind: {[string]: integer} = setmetatable({}, {__index = computed})
score = score * 1000 + (computed.abc or 0) + (behind.abcd or 0) * 2 + calls
local sink: {[string]: integer} = {}
local proxy: {[string]: integer} = setmetatable({}, {
    __newindex = function(t: {[string]: integer}, k: string, v: integer): nil
        sink[k] = v * 2
    end
})
proxy.q = 21
if rawget(proxy, "q") == nil then
    score = score * 100 + (sink.q or 0)
end
local vmeta = {
    __add = function(a: {[string]: integer}, b: {[string]: integer}): integer
        return (a.x or 0) * 10 + (b.x or 0)
    end,
    __mod = function(a: {[string]: integer}, b: integer): integer
        return (a.x or 0) + b
    end,
    __len = function(a: {[string]: integer}): integer
        return (a.x or 0) * 2
    end,
    __lt = function(a: {[string]: integer}, b: {[string]: integer}): boolean
        return (a.x or 0) < (b.x or 0)
    end,
    __le = function(a: {[string]: integer}, b: {[string]: integer}): boolean
        return (a.x or 0) <= (b.x or 0)
    end,
    __eq = function(a: {[string]: integer}, b: {[string]: integer}): boolean
        return (a.x or 0) == (b.x or 0)
    end
}
local p: {[string]: integer} = setmetatable({x = 3}, vmeta)
local q: {[string]: integer} = setmetatable({x = 4}, vmeta)
local sum = (p as any) + (q as any)
local rest = (p as any) % 5
score = (score % 1000003) * 10000 + (sum as integer) * 100 + (rest as integer) * 10 + #q
local r: {[string]: integer} = setmetatable({x = 3}, vmeta)
local cmp: integer = 0
if (p as any) < (q as any) then
    cmp = cmp + 1
end
if (q as any) <= (p as any) then
    cmp = cmp + 2
end
if p == r then
    cmp = cmp + 4
end
if p ~= q then
    cmp = cmp + 8
end
score = score * 100 + cmp
export const result = score
