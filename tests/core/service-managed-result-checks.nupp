module nupp.core.servicemanagedresultchecks

-- Actual allocator graphs remain provisional until a rooted caller closes the
-- publication proof. These tests never execute an allocator in the frozen VM.
local graph = require("nupp.compiler.vm.graph")
local lower = require("nupp.compiler.vm.lower")
local nativegraph = require("nupp.compiler.vm.nativegraph")
local cleanup = require("nupp.compiler.vm.nativecleanup")
local physical = require("nupp.compiler.vm.nativephysical")
local service = require("nupp.compiler.vm.nativeservice")
local nativeos = require("nupp.compiler.vm.nativeos")

local function refuses(callback: function(): nil, expected: string): nil
    local ok, problem = pcall(callback)
    assert(not ok and tostring(problem):find(expected, 1, true), tostring(problem))
end

local function copy(value: any): any
    local result = {}
    for key, item in pairs(value) do
        result[key] = item
    end

    return result
end

local function verify(g: any): nil
    graph.verify(g)
    service.verifyScope(g)
end

local function views(g: any, owner: any): nil
    local count: integer = 0
    for _, block in ipairs(g.blocks) do
        for index, op in ipairs(block.op) do
            if op == "NativePointerView" and physical.viewKind(block.args[index][2]) == "managedReturn" then
                count = count + 1
                local view = block.args[index][2]
                physical.validateCast(view)
                assert(view.source ~= view.target and view.target.checkedType == owner.resultType)
                local origin = physical.managedOrigin(view.target)
                assert(origin and origin.owner == owner and origin.node == view.node)
                assert(physical.returnValue(g.nativePhysical.signature, view.target))
                local raw = physical.describe(view.source.context, view.target.checkedType)
                assert(
                    not physical.returnValue(g.nativePhysical.signature, raw),
                    "raw Header acquired managed return authority"
                )
                refuses(
                    function(): nil
                        physical.managedReturnView(owner, view.source, view.node, {})
                    end,
                    "unissued managed return plan"
                )
                refuses(
                    function(): nil
                        physical.validateCast(copy(view))
                    end,
                    "unknown checked pointer cast"
                )
                local saved = g.nativePhysical.values[block.dst[index]]
                g.nativePhysical.values[block.dst[index]] = raw
                local ok = pcall(graph.verify, g)
                g.nativePhysical.values[block.dst[index]] = saved
                assert(not ok, "managed result descriptor erased its pending origin")
                verify(g)
            end
        end
    end
    assert(count == 1, "actual allocator must have one managed return view")
    refuses(
        function(): nil
            service.requireUnmanagedEntry(g)
        end,
        "standalone entry refused"
    )
end

local function mutation(g: any): nil
    local changed = false
    for _, block in ipairs(g.blocks) do
        for index, op in ipairs(block.op) do
            local args = block.args[index]
            if op == "NativeLeafCall" then
                local operation = service.operation(g, args[1])
                if operation.target.name == "classFor" or operation.target.name == "allocRaw" then
                    local position = operation.target.name == "classFor" and 3 or 4
                    local saved = args[position]
                    args[position] = 2
                    local ok, problem = pcall(service.verifyScope, g)
                    args[position] = saved
                    assert(
                        not ok and tostring(problem):find("managed operand provenance changed", 1, true),
                        tostring(problem)
                    )
                    verify(g)
                    changed = true
                end
                local managed = service.managedCall(g, args[1])
                if managed then
                    assert(managed.heap == 1 and managed.kind == 2 and managed.extent == 3)
                    local descriptor = g.nativePhysical.values[block.dst[index]]
                    local origin = physical.managedOrigin(descriptor)
                    assert(origin and origin.call == managed.node and origin.owner == managed.target)
                    refuses(
                        function(): nil
                            service.managedCall(g, copy(args[1]))
                        end,
                        "unissued service operation"
                    )
                end
            end
        end
    end
    assert(changed, "actual allocation extent call is absent")
end

-- The real allocRaw graph carries size through branch parameters. Every
-- allocation/store use must retain that original extent, including each edge.
local function extentTransport(g: any): nil
    if g.source.name ~= "allocRaw" then
        return
    end
    local large, size
    for _, block in ipairs(g.blocks) do
        for index, op in ipairs(block.op) do
            local args = block.args[index]
            if op == "NativeLeafCall" and service.operation(g, args[1]).target.name == "allocLarge" then
                assert(not large, "large allocation repeated")
                large = args
            elseif op == "NativeStore" and args[4].field and args[4].field.name == "size" then
                assert(not size, "Header size store repeated")
                size = args
            end
        end
    end
    assert(large and size, "actual extent uses are absent")
    for _, args in ipairs({large, size}) do
        local saved = args[3]
        args[3] = 3
        local ok, problem = pcall(service.verifyScope, g)
        args[3] = saved
        assert(not ok and tostring(problem):find("managed operand provenance changed", 1, true), tostring(problem))
        verify(g)
    end
    local changed = false
    for _, block in ipairs(g.blocks) do
        for index, parameter in ipairs(block.params) do
            if parameter == large[3] then
                for _, prior in ipairs(g.blocks) do
                    for _, edge in ipairs(prior.term and prior.term.edges or {}) do
                        if edge.target == block.id and not changed then
                            local saved = edge.args[index]
                            edge.args[index] = 3
                            local ok, problem = pcall(service.verifyScope, g)
                            edge.args[index] = saved
                            assert(
                                not ok and tostring(problem):find("managed operand provenance changed", 1, true),
                                tostring(problem)
                            )
                            verify(g)
                            changed = true
                        end
                    end
                end
            end
        end
    end
    assert(changed, "actual allocation extent phi is absent")
    local width = size[4].width
    assert(width == 4 and g.exactTypes[size[3]] == "uint64", "Header size narrowing differs")
    size[4].width = 8
    local ok, problem = pcall(graph.verify, g)
    size[4].width = width
    assert(not ok and tostring(problem):find("physical store layout differs", 1, true), tostring(problem))
    verify(g)
end

-- Insert a real collecting operation in each existing success continuation,
-- before the address phi and NativePointer conversion. Preserve CFG topology
-- and old rows so the interval guard, rather than an earlier seal, refuses it.
-- The declaration is authenticated only in the forwarding graph.
local function collectingGap(g: any, declaration: any): nil
    local count: integer = 0
    local originalCount = #g.blocks
    for index = 1, originalCount do
        local block = g.blocks[index]
        for row, op in ipairs(block.op) do
            if op == "NativeLeafCall" then
                local operation = service.operation(g, block.args[row][1])
                if operation.target.name == "takeSlot" or operation.target.name == "allocLarge" then
                    assert(block.term.kind == "branch", "allocation lacks success edge")
                    local edge = block.term.edges[1]
                    local continuation = g.blocks[edge.target]
                    assert(
                        continuation.term.kind == "jump"
                        and #continuation.term.edges == 1
                        and g.blocks[continuation.term.edges[1].target].op[1] == "NativePointer",
                        "allocation success continuation no longer precedes Header conversion"
                    )
                    local incoming: integer = 0
                    for _, prior in ipairs(g.blocks) do
                        for _, candidate in ipairs(prior.term.edges) do
                            if candidate.target == continuation.id then
                                assert(prior == block and candidate == edge, "allocation continuation is shared")
                                incoming += 1
                            end
                        end
                    end
                    assert(incoming == 1, "allocation continuation lacks its exact success predecessor")
                    for _, column in ipairs({"op", "dst", "args", "pos", "cert"}) do
                        assert(next(continuation[column]) == nil, "allocation continuation is no longer empty")
                    end
                    continuation.op[1], continuation.dst[1] = "NativeLeafCall", 0
                    continuation.args[1], continuation.pos[1], continuation.cert[1] = {declaration, 1, g.nparams}, 0, 0
                    local ok, problem = pcall(service.verifyScope, g)
                    for _, column in ipairs({"op", "dst", "args", "pos", "cert"}) do
                        continuation[column][1] = nil
                    end
                    assert(
                        not ok and tostring(problem):find("managed interval contains an unissued operation", 1, true),
                        tostring(problem)
                    )
                    verify(g)
                    count = count + 1
                end
            end
        end
    end
    assert(count == 2, "managed allocation alternatives differ")
end

local function bootstrap(build: any): nil
    local count: integer = 0
    for _, owner in ipairs(service.owners(build.catalog)) do
        if owner.scope.name == "nupp.runtime.core.pagemappings"
            and (owner.name == "acquireEntry" or owner.name == "releaseEntry")
        then
            local options = service.options(build.catalog, owner)
            local signature = service.signature(owner, options)
            assert(not service.needsCleanup(signature), "entry bootstrap unexpectedly requires a scope")
            refuses(
                function(): nil
                    lower.functionGraph(owner, options, cleanup.profile(nativegraph))
                end,
                "cleanup profile requires an issued scoped owner"
            )
            local g = lower.functionGraph(owner, options, nativegraph)
            local expected = owner.name == "acquireEntry" and 0 or 1
            local found: integer = 0
            for _, block in ipairs(g.blocks) do
                for index, op in ipairs(block.op) do
                    if op == "NativeHelperCall" and nativeos.isIssued(block.args[index][1]) then
                        local declaration = block.args[index][1]
                        assert(nativeos.ownedSlot(declaration, owner) == expected)
                        refuses(
                            function(): nil
                                nativeos.ownedSlot(copy(declaration), owner)
                            end,
                            "unissued import contract"
                        )
                        refuses(
                            function(): nil
                                nativeos.slot(declaration, copy(owner))
                            end,
                            "OS source owner differs"
                        )
                        if expected == 1 then
                            assert(declaration.result == "uint64")
                            local status = nativeos.status(declaration)
                            assert(status and status.parameter == 1 and block.op[index + 2] == "NativeStore")
                            local stored = block.args[index + 2]
                            local saved = stored[1]
                            stored[1] = 2
                            local ok, problem = pcall(nativeos.verifyStores, g)
                            stored[1] = saved
                            assert(
                                not ok and tostring(problem):find("unmap status output differs", 1, true),
                                tostring(problem)
                            )
                        else
                            assert(nativeos.result(declaration).nullable)
                        end
                        found = found + 1
                    end
                end
            end
            assert(found == 1, "entry bootstrap must have one exact OS operation")
            verify(g)
            graph.prune(g)
            verify(g)
            assert(service.entryRoles(g) == nil, "bootstrap helper acquired heap entry roles")
            count = count + 1
        end
    end
    assert(count == 2, "entry bootstrap helper inventory differs")
end

-- The retained address keeps its qualified descriptor, including after
-- prune. Source identity and actual SSA transport are independent checks.
local function publicationChecks(g: any): nil
    local count: integer = 0
    for _, block in ipairs(g.blocks) do
        for row, op in ipairs(block.op) do
            local args = block.args[row]
            if op == "NativeLeafCall" and service.hasPublication(g, args[1]) then
                count = count + 1
                local declaration, value = args[1], args[3]
                local operation = service.operation(g, declaration)
                local expression = operation.node.args.exprs[2]
                local actual = g.nativePhysical.values[value]
                assert(declaration.physical == nil and actual.checkedType.tag == "borrowed")
                assert(service.publicationArgument(g, declaration, 2, value))
                assert(not service.publicationArgument(g, declaration, 1, value))
                refuses(
                    function(): nil
                        service.publicationArgument(g, copy(declaration), 2, value)
                    end,
                    "unissued publication declaration"
                )
                refuses(
                    function(): nil
                        service.publicationArgument(copy(g), declaration, 2, value)
                    end,
                    "publication graph owner differs"
                )
                operation.node.args.exprs[2] = copy(expression)
                local ok = pcall(service.publicationArgument, g, declaration, 2, value)
                operation.node.args.exprs[2] = expression
                assert(not ok, "copied publication occurrence accepted")
                local annotation = expression.type
                expression.type = copy(annotation)
                ok = pcall(service.publicationArgument, g, declaration, 2, value)
                expression.type = annotation
                assert(not ok, "publication cast annotation substitution accepted")
                local definition = expression.expr.token.definition
                expression.expr.token.definition = copy(definition)
                ok = pcall(service.publicationArgument, g, declaration, 2, value)
                expression.expr.token.definition = definition
                assert(not ok, "publication Heap binding substitution accepted")
                local targetName = declaration.name
                declaration.name = "storeResult"
                ok = pcall(graph.verify, g)
                declaration.name = targetName
                assert(not ok, "publication target substitution accepted")
                local ownerName = g.source.name
                g.source.name = ownerName .. "Changed"
                ok = pcall(graph.verify, g)
                g.source.name = ownerName
                assert(not ok, "publication graph source substitution accepted")
                args[3] = args[2]
                ok = pcall(graph.verify, g)
                args[3] = value
                assert(not ok, "publication different SSA accepted")
                g.nativePhysical.values[value] = nil
                ok = pcall(graph.verify, g)
                g.nativePhysical.values[value] = actual
                assert(not ok, "publication descriptor erasure accepted")
                local raw = physical.describe(actual.context, actual.checkedType)
                g.nativePhysical.values[value] = raw
                ok = pcall(graph.verify, g)
                g.nativePhysical.values[value] = actual
                assert(not ok, "publication unrooted lookalike accepted")
                -- Give a different existing SSA the exact descriptor. The
                -- direct query must still reject it by its operation ancestry.
                local alternate = args[2]
                local saved = g.nativePhysical.values[alternate]
                g.nativePhysical.values[alternate] = actual
                local problem
                ok, problem = pcall(service.publicationArgument, g, declaration, 2, alternate)
                g.nativePhysical.values[alternate] = saved
                assert(not ok and tostring(problem):find("SSA lineage changed", 1, true), tostring(problem))
                verify(g)
                refuses(
                    function(): nil
                        service.requireUnmanagedEntry(g)
                    end,
                    "rooted executable publication"
                )
            end
        end
    end
    assert(count == 1, "actual entry must retain one original root publication")
end

local function entryCleanup(build: any): nil
    local entry
    for _, owner in ipairs(service.owners(build.catalog)) do
        if owner.scope.name == "nupp.runtime.core.heapentry" and owner.name == "run" then
            entry = owner
        end
    end
    assert(entry, "actual heap entry is absent")
    local g = lower.functionGraph(entry, service.options(build.catalog, entry), cleanup.profile(nativegraph))
    local roles = service.entryRoles(g)
    assert(roles and roles.owner == entry)
    assert(
        g.nativePhysical.signature == nil and physical.graphOwner(g) == entry,
        "raw ABI entry must retain its original checked owner without a pointer signature"
    )
    local other, acquisition
    local acquired: integer = 0
    for _, block in ipairs(g.blocks) do
        for index, op in ipairs(block.op) do
            if op == "NativeLeafCall" then
                local declaration = block.args[index][1]
                local operation = service.operation(g, declaration)
                if operation.target == roles.open then
                    local value = block.dst[index]
                    local result = declaration.physical.result
                    assert(
                        declaration.result == "voidptr"
                        and g.exactTypes[value] == "voidptr"
                        and g.nativePhysical.values[value] == result
                        and result.checkedType == roles.open.resultType
                        and result.checkedType.tag == "affine"
                        and physical.affineValue(entry, result),
                        "entry Arena acquisition lost its physical kind or checked ownership"
                    )
                    acquisition = operation.node
                    acquired = acquired + 1
                end
                if operation.node.kind == "call"
                    and operation.target ~= roles.open
                    and not service.arenaCleanup(g, block.args[index][1])
                then
                    other = operation.node
                end
            end
        end
    end
    assert(acquired == 1, "entry must acquire one original Arena")
    assert(other, "entry alternate source call is absent")
    local found, bindings, temporaries = 0, 0, 0
    for _, block in ipairs(g.blocks) do
        for index, op in ipairs(block.op) do
            if op == "NativeLeafCall" then
                local args = block.args[index]
                if service.arenaCleanup(g, args[1]) then
                    local operation = service.operation(g, args[1])
                    local actual = g.nativePhysical.values[args[2]]
                    assert(operation.target == roles.close and service.arenaCleanup(g, args[1], actual))
                    if operation.node.kind == "localStmt" then
                        local owner = operation.node.automaticOwners[1]
                        assert(owner.expr == acquisition, "local cleanup lost the original acquisition")
                        bindings = bindings + 1
                        local saved = operation.node.exprs[1]
                        operation.node.exprs[1] = copy(saved)
                        refuses(
                            function(): nil
                                service.arenaCleanup(g, args[1], actual)
                            end,
                            "local cleanup acquisition changed"
                        )
                        operation.node.exprs[1] = other
                        refuses(
                            function(): nil
                                service.arenaCleanup(g, args[1], actual)
                            end,
                            "local cleanup acquisition changed"
                        )
                        operation.node.exprs[1] = saved
                        assert(service.arenaCleanup(g, args[1], actual))
                    else
                        assert(operation.node == acquisition, "temporary cleanup lost the original acquisition")
                        temporaries = temporaries + 1
                    end
                    refuses(
                        function(): nil
                            physical.arenaCleanupOperand(copy(entry), actual, acquisition, args[1].physical)
                        end,
                        "affine acquisition source differs"
                    )
                    refuses(
                        function(): nil
                            physical.arenaCleanupOperand(entry, actual, other, args[1].physical)
                        end,
                        "affine acquisition source differs"
                    )
                    found = found + 1
                end
            end
        end
    end
    assert(found > 0 and bindings > 0 and temporaries > 0, "entry temporary/local Arena cleanup is absent")
    publicationChecks(g)
    verify(g)
    graph.prune(g)
    verify(g)
    publicationChecks(g)
    assert(g.nativePhysical.signature == nil and physical.graphOwner(g) == entry)
end

export function check(build: any): nil
    bootstrap(build)
    print("managed result checks: bootstrap passed")
    entryCleanup(build)
    print("managed result checks: entry cleanup and publication passed")
    local owners = {}
    for _, owner in ipairs(service.owners(build.catalog)) do
        if owner.scope.name == "nupp.runtime.vm.heap" and owner.name == "allocRaw"
            or owner.scope.name == "nupp.runtime.vm.collector" and owner.name == "allocate"
        then
            owners[#owners + 1] = owner
        end
    end
    assert(#owners == 2, "actual managed allocator inventory differs")
    local compiled = {}
    for _, owner in ipairs(owners) do
        local options = service.options(build.catalog, owner)
        local signature = service.signature(owner, options)
        local obligation = service.managedResult(signature, owner)
        assert(obligation and service.validateManagedResult(obligation, owner) == owner.resultType)
        local checked, parameter = owner.checkedSignature, owner.body.params[1]
        local mode, bound = checked.paramModes[1], parameter.name.definition.type
        assert(mode == "plain" or mode == "borrows")
        assert(
            mode == "plain" and bound == checked.params[1]
            or mode == "borrows" and bound.tag == "borrowed" and bound.inner == checked.params[1]
        )
        print("managed result checks: checked allocator", owner.scope.name, owner.name, mode)
        local wrongMode = mode == "plain" and "borrows" or "plain"
        checked.paramPack.modes[1] = wrongMode
        local disagrees = pcall(service.managedResult, signature, owner)
        checked.paramPack.modes[1] = mode
        assert(not disagrees, "allocator accepted conflicting checked mode arrays")
        checked.paramModes[1], checked.paramPack.modes[1] = wrongMode, wrongMode
        local ok = pcall(service.managedResult, signature, owner)
        checked.paramModes[1], checked.paramPack.modes[1] = mode, mode
        assert(not ok, "allocator mode changed without its original checked binding")
        parameter.name.definition.type = copy(bound)
        ok = pcall(service.managedResult, signature, owner)
        parameter.name.definition.type = bound
        assert(not ok, "allocator accepted a replaced checked parameter type")
        local annotation = parameter.type.resolvedType
        parameter.type.resolvedType = copy(annotation)
        ok = pcall(service.managedResult, signature, owner)
        parameter.type.resolvedType = annotation
        assert(not ok, "allocator accepted a replaced checked annotation")
        assert(service.managedResult(signature, owner) == obligation)
        refuses(
            function(): nil
                service.managedResult({}, owner)
            end,
            "unissued service signature"
        )
        refuses(
            function(): nil
                service.managedResult(signature, copy(owner))
            end,
            "managed result owner differs"
        )
        refuses(
            function(): nil
                service.validateManagedResult({}, owner)
            end,
            "unissued managed result obligation"
        )
        refuses(
            function(): nil
                service.dependentReturn(signature, owner)
            end,
            "outside reviewed Arena/Pool storage"
        )
        local g = lower.functionGraph(owner, options, cleanup.profile(nativegraph))
        compiled[owner.name] = g
        assert(g.nativePhysical.signature.managed == obligation)
        verify(g)
        views(g, owner)
        mutation(g)
        extentTransport(g)
        graph.prune(g)
        verify(g)
        views(g, owner)
        mutation(g)
        extentTransport(g)
    end
    local collecting
    for _, block in ipairs(compiled.allocate.blocks) do
        for index, op in ipairs(block.op) do
            if op == "NativeLeafCall" then
                local declaration = block.args[index][1]
                local operation = service.operation(compiled.allocate, declaration)
                if operation.target.name == "safepoint" then
                    assert(service.heapEffects(build.catalog, operation.target), "injected operation must collect")
                    collecting = declaration
                end
            end
        end
    end
    assert(collecting, "actual collecting call is absent")
    collectingGap(compiled.allocRaw, collecting)
end
