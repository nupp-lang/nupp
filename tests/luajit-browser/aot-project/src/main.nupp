local span = require("nupp.mem.span")
local array = require("nupp.mem.array")
local struct Sample
    value: float
    bias: number
    weight: float
end

@aot
local function scale(
    exclusive output: span.WriteSpan<Sample>,
    borrows input: span.Span<Sample>,
    factor: number,
    enabled: boolean
): nil
    if #output ~= #input then
        error("length mismatch", 2)
    end
    for index = 1, #output do
        if enabled then
            output[index].value = input[index].value * factor
            output[index].bias = input[index].bias + factor
            output[index].weight = input[index].weight + factor
        end
    end
end

local input = array.new(new Sample(), 3)
local inputRows = input:write()
inputRows[1] = new Sample(2, 10, 1)
inputRows[2] = new Sample(3, 20, 4)
inputRows[3] = new Sample(5, 30, 7)
drop inputRows

local output = array.new(new Sample(), 3)
do
    local writable = output:write()
    scale(writable, input:read(), 2, true)
    drop writable
end

local rows = output:read()
assert(#rows == 3)
assert(rows[1].value == 4 and rows[1].bias == 12 and rows[1].weight == 3)
assert(rows[2].value == 6 and rows[2].bias == 22 and rows[2].weight == 6)
assert(rows[3].value == 10 and rows[3].bias == 32 and rows[3].weight == 9)

@aot
local function incrementWide(
    exclusive output: span.WriteSpan<uint64>,
    borrows input: span.Span<uint64>,
    delta: uint64
): nil
    if #output ~= #input then
        error("length mismatch", 2)
    end
    for index = 1, #output do
        output[index] = input[index] + delta
    end
end

@aot
local function addWide(left: uint64, right: uint64): uint64
    return left + right
end

local wideInput = array.scalar(array.uint64, 2)
do
    local writable = wideInput:write()
    writable[1] = (-1 as int64) as uint64
    writable[2] = 9007199254740992 as uint64
    drop writable
end
local wideOutput = array.scalar(array.uint64, 2)
do
    local writable = wideOutput:write()
    incrementWide(writable, wideInput:read(), 1 as uint64)
    drop writable
end
local exact = addWide(wideInput:read()[2], 1 as uint64)
assert(exact == 9007199254740993ULL)
assert(wideOutput:read()[1] == (0 as uint64))
assert(wideOutput:read()[2] == 9007199254740993ULL)

@aot
local function both(left: number, right: boolean): (number, boolean)
    return left, right
end

local negativeZero, falseValue = both(-0.0, false)
assert(1 / negativeZero == -math.huge and falseValue == false)
local nan, trueValue = both(0 / 0, true)
assert(nan ~= nan and trueValue == true)

@aot
local function sumBytes(borrows first: span.Span<uint8>, borrows second: span.Span<uint8>): (number, uint32, uint32)
    local total = 0.0
    for i = 1, #first do
        total = total + first[i]
    end
    for i = 1, #second do
        total = total + second[i]
    end

    return total, nupp.math.u32.wrap(#first), nupp.math.u32.wrap(#second)
end

local first = array.scalar(array.uint8, 2)
local second = array.scalar(array.uint8, 3)
do
    local a, b = first:write(), second:write()
    a[1] = 4
    a[2] = 5
    b[1] = 6
    b[2] = 7
    b[3] = 8
    drop a
    drop b
end
local sum, n1, n2 = sumBytes(first:read(), second:read())
assert(sum == 30 and n1 == 2 and n2 == 3)

-- The guest uses single-number LuaJIT, so FORI preserves the first value.
-- Stock Lua 5.1 instead initializes it through (first - 1) + 1, losing these
-- zeros and tiny bounds. Every loop below exits on its first body entry.
@aot
local function firstLoopValue(first: number, last: number): (boolean, number)
    for cursor = first, last do
        return true, cursor
    end
    return false, 0
end

@aot
local function firstLoopValues(
    exclusive visits: span.WriteSpan<number>,
    exclusive initial: span.WriteSpan<number>,
    borrows starts: span.Span<number>,
    borrows stops: span.Span<number>
): nil
    if #visits ~= #starts or #initial ~= #starts or #stops ~= #starts then
        error("length mismatch", 2)
    end
    @simd
    for index = 1, #starts do
        local visited, value = 0, 0
        for cursor = starts[index], stops[index] do
            visited = 1
            value = cursor
            break
        end
        visits[index] = visited
        initial[index] = value
    end
end

local function loopOracle(first: number, last: number): (boolean, number)
    for cursor = first, last do
        return true, cursor
    end
    return false, 0
end

jit.off(loopOracle)

local function sameLoopValue(actual: number, expected: number): boolean
    return actual == expected and (actual ~= 0 or 1 / actual == 1 / expected)
end

local ranges: {
    {number}
} = {
    {-0.0, 0},
    {-0.0, 0.5},
    {-0.0, 2147483648},
    {1e-20, 0},
    {1e-20, 0.5},
    {1e-20, 2147483648},
    {-1e-20, 0},
    {-1e-20, 0.5},
    {-1e-20, 2147483648},
}
local scalarLoopChecks = 0
local starts = array.scalar(array.number, #ranges)
local stops = array.scalar(array.number, #ranges)
do
    local firsts, lasts = starts:write(), stops:write()
    for index = 1, #ranges do
        local range = ranges[index]
        local expectedRan, expectedValue = loopOracle(range[1], range[2])
        -- Check the independent oracle against the actual guest probe too.
        assert(expectedRan == (index ~= 4), "guest numeric loop admission")
        if expectedRan then
            assert(sameLoopValue(expectedValue, range[1]), "guest numeric loop first value")
        end
        local actualRan, actualValue = firstLoopValue(range[1], range[2])
        assert(actualRan == expectedRan, "scalar numeric loop admission " .. index)
        assert(sameLoopValue(actualValue, expectedValue), "scalar numeric loop first value " .. index)
        scalarLoopChecks = scalarLoopChecks + 1
        firsts[index], lasts[index] = range[1], range[2]
    end
    drop firsts
    drop lasts
end

-- Nine cases exercise full f64 SIMD lanes and a final scalar tail.
local visits = array.scalar(array.number, #ranges)
local initial = array.scalar(array.number, #ranges)
do
    local visited, values = visits:write(), initial:write()
    firstLoopValues(visited, values, starts:read(), stops:read())
    drop visited
    drop values
end
local simdLoopChecks = 0
local actualVisits, actualInitial = visits:read(), initial:read()
for index = 1, #ranges do
    local range = ranges[index]
    local expectedRan, expectedValue = loopOracle(range[1], range[2])
    assert(actualVisits[index] == (expectedRan and 1 or 0), "SIMD numeric loop admission " .. index)
    assert(sameLoopValue(actualInitial[index], expectedValue), "SIMD numeric loop first value " .. index)
    simdLoopChecks = simdLoopChecks + 1
end

-- A const family must call its independent Wasm entries, even though leaving
-- the ordinary Lua body in place would produce the same numeric answers.
local familyHost: any = assert(rawget(_G, "__nuppBrowser"))
local registerFamilyKernel: any = familyHost.kernel
local familyBindings, familyCalls = 0, 0
local familySymbols: {[string]: boolean} = {}
familyHost.kernel = function(unit: string, symbol: string, descriptor: any): any
    assert(symbol:find("_const_family_scale_", 1, true) ~= nil, "unexpected const-family binding")
    assert(not familySymbols[symbol], "each const-family body is bound once")
    familySymbols[symbol] = true
    familyBindings = familyBindings + 1
    local invoke: any = registerFamilyKernel(unit, symbol, descriptor)

    return function(value: number): number
        familyCalls = familyCalls + 1
        return invoke(value) as number
    end
end

@aot
local function constFamilyScale<const Factor: integer>(value: number, factor: Factor): number
    return value * (factor as integer)
end

-- The generated wrappers have captured the counted callables by this point.
familyHost.kernel = registerFamilyKernel
assert(constFamilyScale(5, 2) == 10)
assert(constFamilyScale(5, 3) == 15)
assert(familyBindings == 2, "both const-family Wasm bodies must be bound")
assert(familyCalls == 2, "both const-family calls must enter independent Wasm")

-- Erase the signature at this unchecked call so it does not demand another
-- compiled tuple. The public family must fail instead of falling back to Lua.
local unmatched, why = pcall(constFamilyScale as any, 5, 7)
assert(not unmatched and tostring(why):find("no compiled const application exists", 1, true) ~= nil)
assert(familyCalls == 2, "an unmatched tuple must not invoke a compiled body")

return {
    ok = true,
    numericLoops = {cases = #ranges, scalar = scalarLoopChecks, simd = simdLoopChecks},
    constFamily = {bindings = familyBindings, calls = familyCalls, unmatchedRejected = not unmatched}
}
