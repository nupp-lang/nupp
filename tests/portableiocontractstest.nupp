const assert2 = require("assert")

local standard = require("nupp.io")
local http = require("nupp.io.http")
local tests = {}

local record Upload is http.Reader
    bytes: string
    closed: {boolean}

    function read(exclusive self, count: integer): (string?, string?)
        local out = self.bytes:sub(1, count)
        self.bytes = self.bytes:sub(#out + 1)
        return out
    end

    function close(takes self): nil
        self.closed[1] = true
    end
end

local function consume(takes source: http.Reader): string
    local first = assert2(source:read(3))
    local second = assert2(source:read(3))
    source:close()
    return first .. second
end

function tests.lightweightUploadsKeepTheirNarrowContract(): nil
    local closed = {false}
    assert2(consume(new Upload(bytes = "abcdef", closed = closed)) == "abcdef")
    assert2(closed[1])
end

function tests.ordinaryReadersSatisfyTheUploadSubset(): nil
    assert2(consume(standard.newStringReader("abcdef")) == "abcdef")
end

local record Queue is standard.ByteQueue
    bytes: string

    metamethod __len: function(self: Queue): integer
    get: function(self: Queue, ...: integer?): string
end

function Queue.__len(self: Queue): integer
    return #self.bytes
end

function Queue.get(self: Queue, ...: integer?): string
    local count = (...) or #self.bytes
    local out = self.bytes:sub(1, count)
    self.bytes = self.bytes:sub(#out + 1)
    return out
end

function tests.byteQueuesAreStructuralSources(): nil
    local queue = new Queue(bytes = "abcdef")
    local reader = standard.newQueueReader(queue)
    assert2(reader:read(3) == "abc")
    assert2(#queue.bytes == 3)
    assert2(reader:read(3) == "def")
    assert2(#queue.bytes == 0)
end

function tests.scalarReadersAcceptStructuralQueues(): nil
    local queue = new Queue(bytes = "\1\2\3\4")
    local reader = standard.newScalarReader(queue)
    assert2(reader:remaining() == 4)
    assert2(reader:readUint32() == 67305985)
    assert2(reader:remaining() == 0)
    assert2(#queue.bytes == 0)
end

function tests.structuralQueuesReadIntoBuffersAndWritableSpans(): nil
    local queue = new Queue(bytes = "abcdef")
    local reader = standard.newQueueReader(queue)
    local destination = standard.newBuffer(8)
    assert2(reader:readInto(destination, 0, 3) == 3)
    local lease = destination:reserveWrite(3, 3)
    do
        local output = lease:span()
        assert2(reader:readSpan(output) == 3)
        own.drop(output)
    end
    lease:commit(3)
    assert2(destination:getString() == "abcdef")
    assert2(reader:read(1) == "")
end

function tests.stringReadersFillWritableSpans(): nil
    local reader = standard.newStringReader("abc")
    local destination = standard.newBuffer(3)
    local lease = destination:reserveWrite(0, 3)
    do
        local output = lease:span()
        assert2(reader:readSpan(output) == 3)
        own.drop(output)
    end
    lease:commit(3)
    assert2(destination:getString() == "abc")
end

function tests.linesKeepTerminatorsAndFinalFragments(): nil
    local lines = standard.newLines(standard.newStringReader("one\r\ntwo\nlast"))
    assert2(lines:read() == "one")
    assert2(lines:read() == "two")
    assert2(lines:read() == "last")
    assert2(lines:read() == nil)
    lines:close()
end

return tests
