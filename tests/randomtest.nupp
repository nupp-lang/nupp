local random = require("nupp.random")

local M = {}

local function assertSame(left: const{number}, right: const{number}): nil
    assert(#left == #right)
    for index = 1, #left do
        assert(left[index] == right[index], "values differ at " .. tostring(index))
    end
end

function M.reproducesTheTecsSequenceAndState(): nil
    local generator = new random.Xoshiro128(12345)
    local expected: {
        number
    } = {
        0.25454781646840274,
        0.047265402274206281,
        0.87110176053829491,
        0.88562377681955695,
        0.97293841186910868,
        0.18865043367259204,
        0.31380670145153999,
        0.94012095988728106,
    }
    for index = 1, #expected do
        assert(generator:next() == expected[index], "draw differs at " .. tostring(index))
    end
    assertSame(generator:state(), {522211826, 1785743282, 676026232, -1112538433})
end

function M.reproducesTheTecsIntegerSequence(): nil
    local generator = new random.Xoshiro128(12345)
    local expected = {26, 5, 88, 89, 98, 19, 32, 95, 87, 90, 75, 51}
    for index = 1, #expected do
        assert(generator:integer(1, 100) == expected[index], "integer differs at " .. tostring(index))
    end
end

function M.restoresStateAndReseedsInPlace(): nil
    local generator = new random.Xoshiro128(9)
    for _ = 1, 12 do
        generator:next()
    end
    local checkpoint = generator:state()
    local expected = {generator:next(), generator:next(), generator:next()}
    generator:setState(checkpoint)
    assertSame({generator:next(), generator:next(), generator:next()}, expected)

    generator:reseed(9)
    local fresh = new random.Xoshiro128(9)
    assert(generator:next() == fresh:next())
end

function M.readsSeedsAndStateAsSigned32BitWords(): nil
    local positive = new random.Xoshiro128(2147483648)
    local negative = new random.Xoshiro128(-2147483648)
    for _ = 1, 20 do
        assert(positive:next() == negative:next())
    end

    local generator = new random.Xoshiro128(1)
    assert(
        not pcall(function(): nil
            generator:setState({0, 0, 0, 0})
        end)
    )
    assert(
        not pcall(function(): nil
            generator:setState({1, 2, 3})
        end)
    )
end

function M.drawsRangesAndDeterministicPermutations(): nil
    local generator = new random.Xoshiro128(11)
    local seen: {[integer]: boolean} = {}
    for _ = 1, 2000 do
        local value = generator:integer(-3, 3)
        assert(value >= -3 and value <= 3)
        seen[value] = true
        local fraction = generator:range(-2.5, 7.5)
        assert(fraction >= -2.5 and fraction < 7.5)
        local reversed = generator:range(7.5, -2.5)
        assert(reversed > -2.5 and reversed <= 7.5)
    end
    assert(generator:range(4.25, 4.25) == 4.25)
    for value = -3, 3 do
        assert(seen[value] == true)
    end
    assert(
        not pcall(function(): nil
            generator:integer(5, 3)
        end)
    )

    local first = {1, 2, 3, 4, 5, 6, 7, 8}
    local second = {1, 2, 3, 4, 5, 6, 7, 8}
    local shuffler = new random.Xoshiro128(99)
    local returned = shuffler:shuffle(first)
    local again = new random.Xoshiro128(99)
    again:shuffle(second)
    assert(returned == first)
    assertSame(first, second)
end

-- One draw carries 32 bits, so scaling it over more than 2^32 values reached at
-- most 2^32 of them, evenly spaced: over [1, 2^53] every draw was odd.
function M.drawsOverWideRangesReachEveryResidue(): nil
    local generator = new random.Xoshiro128(42)
    local even = 0
    local offGrid = 0
    for _ = 1, 2000 do
        local value = generator:integer(1, 9007199254740992)
        assert(value >= 1 and value <= 9007199254740992 and value % 1 == 0)
        if value % 2 == 0 then
            even = even + 1
        end
        if value % 2097152 ~= 1 then
            offGrid = offGrid + 1
        end
    end
    assert(even > 800 and even < 1200, "even draws: " .. tostring(even))
    assert(offGrid > 1900, "draws off the 2^21 grid: " .. tostring(offGrid))

    local seen: {[integer]: boolean} = {}
    for _ = 1, 400 do
        local value = generator:integer(-4294967296, 4294967296)
        assert(value >= -4294967296 and value <= 4294967296)
        seen[value % 4] = true
    end
    assert(seen[0] and seen[1] and seen[2] and seen[3], "every residue modulo 4 is reached")
end

-- A bound that is not a finite integer, or a range wider than doubles count
-- exactly, has no uniform answer.
function M.refusesBoundsWithoutAnExactRange(): nil
    local generator = new random.Xoshiro128(7)
    const refused: {{number}} = {
        {0 / 0, 1}, {1, 0 / 0}, {1, math.huge}, {-math.huge, 1}, {1, 2.5}, {0.5, 3},
        {-9007199254740992, 9007199254740992}, {1, 18014398509481984},
    }
    for _, bounds in ipairs(refused) do
        assert(
            not pcall(function(): nil
                generator:integer(bounds[1] as integer, bounds[2] as integer)
            end),
            "integer(" .. tostring(bounds[1]) .. ", " .. tostring(bounds[2]) .. ") raises"
        )
    end
    assert(
        not pcall(function(): nil
            generator:integer((0 / 0) as integer)
        end)
    )
end

return M
