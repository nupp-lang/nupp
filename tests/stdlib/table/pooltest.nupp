-- table.Pool: retained record instances, cleared on release.
local {type Pool} = require("table")
const Pool = table.Pool
local test = require("assert")

local M = {}

local record Event
    x: integer
    name: string?
end

-- Bytes allocated while `body` ran, with the collector stopped: the count
-- reports the current heap, so with the collector running a delta would
-- measure what survived a collection rather than what was allocated.
local function allocated(body: function(): nil): number
    collectgarbage("collect")
    collectgarbage("stop")
    -- A full collection shrinks the Lua stack, and the first call afterwards
    -- regrows it by a few kilobytes that the count reports as allocation. One
    -- unmeasured run of the body inside the stopped region pays that first.
    local primed, priming = pcall(body)
    if not primed then
        collectgarbage("restart")
        error(priming, 0)
    end
    -- The smallest of several runs is the answer, because LuaJIT may record
    -- or re-record a trace during any one of them, and the trace it keeps is
    -- an allocation the path itself never makes. A path that allocates does
    -- so on every run, so the minimum still reports it.
    local least = math.huge
    for _ = 1, 3 do
        local before = collectgarbage("count")
        local ok, problem = pcall(body)
        local after = collectgarbage("count")
        if not ok then
            collectgarbage("restart")
            error(problem, 0)
        end
        local bytes = (after - before) * 1024
        if bytes < least then
            least = bytes
        end
    end
    collectgarbage("restart")
    collectgarbage("collect")

    return least
end

local function hasNoFields(value: Event): boolean
    return next(value as any) == nil
end

function M.publicPoolPreservesTheHostTableAndRecordIdentity(): nil
    local tables = require("table")
    local events: Pool<Event> = tables.Pool(Event, 1)
    test.eq(tables, table)
    test.eq(getmetatable(events), tables.Pool)
    local event = events:acquire()
    test.eq(getmetatable(event), Event)
    event.x = 17
    events:release(event)
    local reused = events:acquire()
    test.eq(reused, event)
    test(hasNoFields(reused))
    events:release(reused)
end

function M.newReservesTheCapacityUpFront(): nil
    local events = Pool(Event, 4)
    test.eq(events.capacity, 4)
    test.eq(events:free(), 4)
    test.eq(events:live(), 0)
    test.eq(Pool(Event).capacity, 32)
    test.raises(
        function()
            Pool(Event, -1)
        end,
        "negative"
    )
end

function M.invalidSizesAndWitnessesAreRefused(): nil
    for _, size in ipairs({-1, 0.5, math.huge, 0 / 0}) do
        test.raises(
            function()
                (Pool as any)(Event, size)
            end,
            "nonnegative integer"
        )
    end
    test.raises(
        function()
            (Pool as any)(Event, false)
        end,
        "nonnegative integer"
    )
    test.raises(
        function()
            (Pool as any)({}, 1)
        end,
        "record or struct declaration"
    )
end

function M.acquireStampsTheDeclarationWithNoFieldsSet(): nil
    local events = Pool(Event, 2)
    local event = events:acquire()
    test(event is Event, "the instance carries the record's metatable")
    test(hasNoFields(event), "a fresh instance has no fields")
    test.eq(events:live(), 1)
    test.eq(events:free(), 1)
    events:release(event)
end

function M.reserveThenAcquireWithinCapacityAllocatesNothing(): nil
    local events = Pool(Event, 64)

    local function churn(rounds: integer): nil
        for _ = 1, rounds do
            local event = events:acquire()
            event.x = 1
            event.name = "warm"
            events:release(event)
        end
    end

    -- The first rounds are where the trace is recorded, which is its own
    -- allocation; the measured rounds run on the warmed path.
    churn(500)
    local bytes = allocated(function()
        churn(10000)
    end)
    test(bytes < 1024, "acquire and release within capacity allocated " .. tostring(bytes) .. " bytes")

    -- A burst of the whole capacity out at once and back, also warm.
    local held: {Event} = {}

    local function burst(rounds: integer): nil
        for _ = 1, rounds do
            for index = 1, 64 do
                local event = events:acquire()
                event.x = index
                held[index] = event
            end
            for index = 1, 64 do
                events:release(held[index])
            end
        end
    end

    burst(200)
    bytes = allocated(function()
        burst(100)
    end)
    test(bytes < 1024, "a warm burst to capacity allocated " .. tostring(bytes) .. " bytes")
end

function M.releaseClearsEveryField(): nil
    local events = Pool(Event, 1)
    local event = events:acquire()
    event.x = 7
    event.name = "seven"
    events:release(event)
    test.eq(events:live(), 0)
    test.eq(events:free(), 1)
    local again = events:acquire()
    test(again == event, "within capacity the same instance comes back")
    test(hasNoFields(again), "a released instance comes back with no fields")
    events:release(again)
end

function M.instancesAreDistinctWhileLive(): nil
    local events = Pool(Event, 3)
    local seen: {[Event]: boolean} = {}
    local held: {Event} = {}
    for index = 1, 8 do
        local event = events:acquire()
        test(not seen[event], "a live instance was handed out twice")
        seen[event] = true
        event.x = index
        held[index] = event
    end
    test.eq(events:live(), 8)
    test.eq(events:free(), 1)
    test.eq(events.capacity, 9)
    for index = 1, 8 do
        test.eq(held[index].x, index)
    end
    for index = 1, 8 do
        events:release(held[index])
    end
end

function M.growthAndReleaseRetainAllInstances(): nil
    local events = Pool(Event, 2)
    local held: {Event} = {}
    for index = 1, 5 do
        held[index] = events:acquire()
    end
    for index = 1, 5 do
        events:release(held[index])
    end
    test.eq(events:free(), 6)
    test.eq(events.capacity, 6)
    test.eq(events:pages(), 3)
    test.eq(events:live(), 0)
end

function M.reserveTopsTheFreeListUp(): nil
    local events = Pool(Event, 4)
    local held: {Event} = {}
    for index = 1, 4 do
        held[index] = events:acquire()
    end
    test.eq(events:free(), 0)
    events:reserve(2)
    test.eq(events:free(), 4, "reserve grows in allocation batches")
    events:reserve(1)
    test.eq(events:free(), 4, "reserve never shrinks the free list")
    events:reserve(6)
    test.eq(events:free(), 8)
    test.eq(events.capacity, 12, "capacity includes the four live instances")
    test.raises(
        function()
            events:reserve(-1)
        end,
        "negative"
    )
    for index = 1, 4 do
        events:release(held[index])
    end
    test.eq(events:free(), 12, "every retained instance becomes reusable")
end

function M.resetWithLiveInstancesRaisesAndChangesNothing(): nil
    local events = Pool(Event, 3)
    local event = events:acquire()
    test.raises(
        function()
            events:reset()
        end,
        "live"
    )
    test.eq(events:live(), 1)
    test.eq(events:free(), 2)
    test.eq(events.capacity, 3)
    events:release(event)
    events:reset()
    test.eq(events:free(), 3)
    test.eq(events:live(), 0)
    test.eq(events.capacity, 3)
    events:reserve(3)
    test.eq(events:free(), 3)
end

function M.resetKeepsInstancesAndRestartsAcquisitionCount(): nil
    local events = Pool(Event, 2)
    local first = events:acquire()
    local second = events:acquire()
    local third = events:acquire()
    first.name = "retained"
    events:release(first)
    events:release(second)
    events:release(third)
    test.eq(events.capacity, 4)
    test.eq(events:used(), 3)
    events:reset()
    test.eq(events.capacity, 4)
    test.eq(events:free(), 4)
    test.eq(events:used(), 0)
    local reused = events:acquire()
    test(reused == first, "reset restarts at the first retained instance")
    test(hasNoFields(reused), "released record fields remain cleared")
    events:release(reused)
end

function M.zeroSizeStartsEmptyAndStillReusesInstances(): nil
    local events = Pool(Event, 0)
    test.eq(events.capacity, 0)
    test.eq(events:pages(), 0)
    local event = events:acquire()
    test.eq(events.capacity, 1)
    test.eq(events:pages(), 1)
    events:release(event)
    events:reset()
    test.eq(events:free(), 1)
    local reused = events:acquire()
    test(reused == event)
    events:release(reused)
end

function M.releaseRefusesWhatThePoolDidNotStamp(): nil
    local events = Pool(Event, 1)
    test.raises(
        function()
            events:release(Event(x = 1))
        end,
        "without a live lease"
    )
    local event = events:acquire()
    test.raises(
        function()
            (events as any):release({})
        end,
        "did not stamp"
    )
    events:release(event)
end

function M.releaseRefusesValuesNotLiveInThatPool(): nil
    local events = Pool(Event, 2)
    local first = events:acquire()
    local second = events:acquire()
    events:release(first)
    test.raises(
        function()
            events:release(first)
        end,
        "not live in this pool"
    )
    test.eq(events:live(), 1)
    test.eq(events:free(), 1)

    local other = Pool(Event, 1)
    local foreign = other:acquire()
    test.raises(
        function()
            events:release(foreign)
        end,
        "not live in this pool"
    )
    events:release(second)
    other:release(foreign)
end

return M
