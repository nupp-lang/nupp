-- table.Pool: zero-filled struct rows leased from pages that never move.
local ffi = require("ffi")
local tables = require("table")
local test = require("assert")

local M = {}

local struct Row
    x: float
    y: float
end

-- Where a row sits. A page's first row is at its start, so this also says
-- where a page is.
local function addressOf(row: Row): number
    -- A struct reference converts to a pointer to its bytes, and a pointer to
    -- an integer; a struct does not convert to an integer directly.
    return tonumber(ffi.cast("uintptr_t", ffi.cast("void *", row)) as any) as number
end

-- Bytes allocated while `body` ran, with the collector stopped: the count
-- reports the current heap, so with the collector running a delta would
-- measure what survived a collection rather than what was allocated.
local function allocated(body: function(): nil): number
    collectgarbage("collect")
    collectgarbage("stop")
    -- A full collection shrinks the Lua stack, and the first call afterwards
    -- regrows it by a few kilobytes that the count reports as allocation. One
    -- unmeasured run of the body inside the stopped region pays that first.
    local primed, priming = pcall(body)
    if not primed then
        collectgarbage("restart")
        error(priming, 0)
    end
    -- The smallest of several runs is the answer, because LuaJIT may record
    -- or re-record a trace during any one of them, and the trace it keeps is
    -- an allocation the path itself never makes. A path that allocates does
    -- so on every run, so the minimum still reports it.
    local least = math.huge
    for _ = 1, 3 do
        local before = collectgarbage("count")
        local ok, problem = pcall(body)
        local after = collectgarbage("count")
        if not ok then
            collectgarbage("restart")
            error(problem, 0)
        end
        local bytes = (after - before) * 1024
        if bytes < least then
            least = bytes
        end
    end
    collectgarbage("restart")
    collectgarbage("collect")

    return least
end

function M.newWarmsOneBatchAndGrowsWithoutMovingRows(): nil
    local rows = tables.newpool(Row, 4)
    test.eq(rows.capacity, 4)
    test.eq(rows:pages(), 1)
    test.eq(rows:used(), 0)
    test.eq(rows:live(), 0)
    for _ = 1, 4 do
        rows:acquire()
    end
    test.eq(rows:pages(), 1, "the batch holds exactly its initial size")
    rows:acquire()
    test.eq(rows:pages(), 2, "the fifth row needs a second page")
    test.eq(rows:used(), 5)
    test.eq(rows:live(), 5)
    test.eq(tables.newpool(Row).capacity, 32)
    test.raises(
        function()
            tables.newpool(Row, -1)
        end,
        "nonnegative"
    )
end

function M.rowsAreStructReferencesIntoThePage(): nil
    local rows = tables.newpool(Row, 4)
    local first = rows:acquire()
    assert(ffi.istype(Row, first), "a row is a reference of the struct type")
    first.x = 1.5
    local second = rows:acquire()
    second.x = 2.5
    test.eq(first.x, 1.5, "rows do not alias")
    test.eq(second.x, 2.5)
    test.eq(addressOf(second) - addressOf(first), ffi.sizeof(Row), "rows are contiguous within a page")
end

function M.nestedAcquiresGiveDistinctRows(): nil
    local rows = tables.newpool(Row, 8)
    local outer = rows:acquire()
    outer.x = 1
    local inner = rows:acquire()
    inner.x = 2
    local innermost = rows:acquire()
    innermost.x = 3
    assert(addressOf(outer) ~= addressOf(inner) and addressOf(inner) ~= addressOf(innermost))
    test.eq(outer.x, 1)
    test.eq(inner.x, 2)
    test.eq(innermost.x, 3)
    rows:release(innermost)
    rows:release(inner)
    rows:release(outer)
    test.eq(rows:live(), 0)
    test.eq(rows:used(), 3, "release preserves the acquisition count")
    local reused = rows:acquire()
    test.eq(addressOf(reused), addressOf(outer), "a released row is reusable immediately")
    test.eq(reused.x, 0, "a reused row is zero-filled")
    rows:release(reused)
end

function M.acquireAllocatesNothingOnceItsPageExists(): nil
    local rows = tables.newpool(Row, 64)

    local function epoch(count: integer): nil
        for _ = 1, count do
            for _ = 1, 64 do
                local row = rows:acquire()
                row.x = 1
                rows:release(row)
            end
            rows:reset()
        end
    end

    -- The first epochs are where the trace is recorded, which is its own
    -- allocation; the measured epochs run on the warmed path.
    epoch(50)
    local bytes = allocated(function()
        epoch(200)
    end)
    assert(bytes < 1024, "acquire and release on an existing page allocated " .. tostring(bytes) .. " bytes")
end

function M.resetWithLiveLeasesRaisesAndChangesNothing(): nil
    local rows = tables.newpool(Row, 4)
    local first = rows:acquire()
    local second = rows:acquire()
    second.x = 9
    test.raises(
        function()
            rows:reset()
        end,
        "live"
    )
    test.eq(rows:used(), 2)
    test.eq(rows:live(), 2)
    test.eq(rows:pages(), 1)
    local third = rows:acquire()
    assert(addressOf(third) ~= addressOf(first) and addressOf(third) ~= addressOf(second), "the cursor did not rewind")
    test.eq(second.x, 9)
    rows:release(first)
    rows:release(second)
    rows:release(third)
end

function M.resetRewindsToPageOneAndRowsReadAsZero(): nil
    local rows = tables.newpool(Row, 2)
    local first = rows:acquire()
    first.x = 7
    first.y = 8
    local second = rows:acquire()
    second.x = 9
    local third = rows:acquire()
    third.y = 10
    test.eq(rows:pages(), 2)
    rows:release(first)
    rows:release(second)
    rows:release(third)
    rows:reset()
    test.eq(rows:used(), 0)
    test.eq(rows:live(), 0)
    test.eq(rows:pages(), 2, "a reset keeps the pages")

    local again = rows:acquire()
    test.eq(addressOf(again), addressOf(first), "the first lease after a reset is the first row of page one")
    test.eq(again.x, 0)
    test.eq(again.y, 0)
    test.eq(addressOf(rows:acquire()), addressOf(second))
    local reused = rows:acquire()
    test.eq(addressOf(reused), addressOf(third), "page two is reused rather than allocated")
    test.eq(reused.y, 0)
    test.eq(rows:pages(), 2)
end

function M.pagesNeverMoveWhenThePoolGrows(): nil
    local rows = tables.newpool(Row, 2)
    local first = rows:acquire()
    first.x = 3
    local pageOne = addressOf(first)
    local kept: {Row} = {first}
    -- Where each row was when it was leased, before any later page existed.
    local leasedAt: {number} = {pageOne}
    local pageStarts: {number} = {pageOne}
    for index = 2, 8 do
        local row = rows:acquire()
        row.x = index + 2
        kept[index] = row
        leasedAt[index] = addressOf(row)
        if index % 2 == 1 then
            pageStarts[#pageStarts + 1] = addressOf(row)
        end
    end
    test.eq(rows:pages(), 4)
    test.eq(addressOf(first), pageOne, "the first page stayed where it was")
    test.eq(first.x, 3, "a write through the old reference still lands in its page")
    for index = 1, 8 do
        test.eq(addressOf(kept[index]), leasedAt[index], "row " .. tostring(index) .. " did not move")
        test.eq(kept[index].x, index + 2)
    end
    for index = 1, 8 do
        rows:release(kept[index])
    end
    rows:reset()
    for page = 1, 4 do
        local row = rows:acquire()
        test.eq(addressOf(row), pageStarts[page], "page " .. tostring(page) .. " is where it was")
        rows:acquire()
    end
end

function M.releaseWithoutALeaseRaises(): nil
    local rows = tables.newpool(Row, 2)
    local row = rows:acquire()
    rows:release(row)
    test.raises(
        function()
            rows:release(row)
        end,
        "without a live lease"
    )
end

function M.releaseTracksTheExactLeasedRow(): nil
    local rows = tables.newpool(Row, 2)
    local first = rows:acquire()
    local second = rows:acquire()
    rows:release(first)
    test.raises(
        function()
            rows:release(first)
        end,
        "not live in this pool"
    )
    test.eq(rows:live(), 1, "a duplicate release does not spend another row's lease")
    test.raises(
        function()
            rows:reset()
        end,
        "1 live lease"
    )

    local other = tables.newpool(Row, 1)
    local foreign = other:acquire()
    test.raises(
        function()
            rows:release(foreign)
        end,
        "not live in this pool"
    )
    test.eq(rows:live(), 1, "a foreign row does not spend this pool's lease")

    rows:release(second)
    rows:reset()
    other:release(foreign)
end

return M
