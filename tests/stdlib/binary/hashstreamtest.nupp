local binary = require("binary")
local digest = binary.digest
local mac = binary.mac
local checksum = binary.checksum
local io = require("io")
local array = table.Array
local span = require("binary.span")
local test = require("assert")
local M = {}

function M.hashFamiliesKeepSeparateAlgorithmCatalogs(): nil
    test(not pcall(checksum, "sha256"))
    test(not pcall(digest, "crc32"))
    test(not pcall(mac, "sha256"))
    test(checksum == require("binary").checksum)
    test(digest == require("binary").digest)
    test(mac == require("binary").mac)
    test(binary == require("binary"))
end

function M.descriptorsAreReusableAndDoNotRetainMacKeys(): nil
    local sha = digest("sha256")
    test(sha == digest("sha256"))
    local running = sha:create()
    running:write("abc")
    test(sha:computehex("other") ~= sha:computehex("abc"))
    test(running:hexdigest() == sha:computehex("abc"))
    local keyed = mac("hmac-sha256")
    test(keyed == mac("hmac-sha256"))
    local first = keyed:computehex("first key", "message")
    test(keyed:computehex("second key", "message") ~= first)
    test(keyed:computehex("first key", "message") == first)
end

function M.publishedFnv1a64VectorsAndByteSpans(): nil
    test(binary.fnv1a64("") == "cbf29ce484222325")
    test(binary.fnv1a64("a") == "af63dc4c8601ec8c")
    test(binary.fnv1a64("foobar") == "85944171f73967e8")
    test(binary.fnv1a64("a\0b\255c") == "3e5746fc83766ddc")

    local bytes = io.Buffer.create("\0\1\127\128\255")
    local view = bytes:span()
    test(binary.fnv1a64(view) == "a5bcd1d1065f84b6")
    test(digest("sha256"):computehex(view) == digest("sha256"):computehex("\0\1\127\128\255"))
    test(checksum("crc32"):compute(view) == checksum("crc32"):compute("\0\1\127\128\255"))
    test(mac("hmac-sha256"):computehex("key", view) == mac("hmac-sha256"):computehex("key", "\0\1\127\128\255"))
end

function M.publishedDigestVectors(): nil
    test(digest("md5"):computehex("") == "d41d8cd98f00b204e9800998ecf8427e")
    test(digest("md5"):computehex("abc") == "900150983cd24fb0d6963f7d28e17f72")
    test(digest("sha1"):computehex("") == "da39a3ee5e6b4b0d3255bfef95601890afd80709")
    test(digest("sha1"):computehex("abc") == "a9993e364706816aba3e25717850c26c9cd0d89d")
    test(digest("sha256"):computehex("") == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    test(digest("sha256"):computehex("abc") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    test(
        digest("sha512")
            :computehex(
                ""
            ) == "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e"
    )
    test(
        digest("sha512")
            :computehex(
                "abc"
            ) == "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f"
    )
end

function M.wordDigestPaddingBoundariesMatchIndependentVectors(): nil
    local vectors: {
        {string}
    } = {
        {
            "md5",
            "55",
            "04364420e25c512fd958a70738aa8f72",
            "56",
            "668a72d5ba17f08e62dabcafad6db14b",
            "64",
            "c1bb4f81d892b2d57947682aeb252456"
        },
        {
            "sha1",
            "55",
            "cef734ba81a024479e09eb5a75b6ddae62e6abf1",
            "56",
            "901305367c259952f4e7af8323f480d59f81335b",
            "64",
            "bb2fa3ee7afb9f54c6dfb5d021f14b1ffe40c163"
        },
        {
            "sha512",
            "111",
            "9a2a120825c2319867758ec277924f6faa254968bf752046dacdd948d8ad299b10359fd04bfd7d3810b5fa1b16a294236138baff981cbb85248478053ac4d3dd",
            "112",
            "a3722b515ef40c910f2419f6e0da8ca51d410114ce6272faae64045f9e9f630e7fa8dd5a3243c9860b899d148c3da4bc0f9e07454542604d030bb55531fe0d5b",
            "128",
            "e2e22f8422b54b06e35c3ea30a383d1de7a8fbc27992923074103117020d8dd7024c3ecf7d6d1a15a6de5a75ff32fb486b9e8ced4c02ffe05822bf2cb734d0e0"
        }
    }
    for _, vector in ipairs(vectors) do
        for index = 2, #vector, 2 do
            local length = test(tonumber(vector[index])) as integer
            test(digest(vector[1]):computehex(string.rep("x", length)) == vector[index + 1])
        end
    end
end

function M.metadataAndIndependentContexts(): nil
    test(table.concat(binary.formats("digest"), ",") == "md5,sha1,sha256,sha512")
    test(not pcall(digest, "unknown"))
    local algorithm = digest("sha256")
    test(algorithm.name == "sha256" and algorithm.digestsize == 32)
    local first = algorithm:create()
    local second = algorithm:create()
    test(first:algorithm() == "sha256" and first:digestsize() == 32)
    first:write("a")
    second:write("abc")
    first:write("bc")
    test(first:digest() == second:digest())

    test(table.concat(binary.formats("mac"), ",") == "hmac-sha256")
    test(not pcall(mac, "unknown"))
    local macAlgorithm = mac("hmac-sha256")
    test(macAlgorithm.name == "hmac-sha256" and macAlgorithm.digestsize == 32)
    local firstMac = macAlgorithm:create("key")
    local secondMac = macAlgorithm:create("key")
    firstMac:write("a")
    secondMac:write("abc")
    firstMac:write("bc")
    test(firstMac:digest() == secondMac:digest())
end

function M.overloadedFinalizationWritesOnlyTheSuppliedSlice(): nil
    for _, name in ipairs(binary.formats("digest")) do
        local algorithm = digest(name)
        local bytes = array.bytes(algorithm.digestsize + 2)
        local output = bytes:write()
        output[1] = 0xa5
        output[#output] = 0x5a
        local region = output:slice(2, algorithm.digestsize + 1)
        local rolling = algorithm:create()
        local source = "abc"
        local input = span.fromstring(source)
        rolling:writespan(input)
        local written: integer = rolling:digest(region)
        test(written == algorithm.digestsize)
        own.drop(region)
        test(output[1] == 0xa5 and output[#output] == 0x5a)
        local expected = digest(name):compute("abc")
        for index = 1, #expected do
            test(output[index + 1] == expected:byte(index))
        end
    end
end

function M.shortDestinationIsRejected(): nil
    test.raises(
        function(): nil
            local bytes = array.bytes(31)
            local output = bytes:write()
            local rolling = digest("sha256"):create()
            rolling:write("abc")
            rolling:digest(output)
        end,
        "digest destination needs 32 bytes"
    )
end

function M.chunkingAndBinaryInput(): nil
    for _, name in ipairs(binary.formats("digest")) do
        for length = 0, 260 do
            local input = string.rep("a\0b\255c", 53):sub(1, length)
            local rolling = digest(name):create()
            for index = 1, #input, 7 do
                rolling:write(input:sub(index, index + 6))
            end
            test(rolling:hexdigest() == digest(name):computehex(input), name .. " length " .. length)
        end
    end
end

function M.hmacRfc4231AndBinaryInput(): nil
    test(
        mac("hmac-sha256")
            :computehex(
                string.rep("\11", 20),
                "Hi There"
            ) == "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7"
    )
    test(
        mac("hmac-sha256")
            :computehex(
                "Jefe",
                "what do ya want for nothing?"
            ) == "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843"
    )
    test(
        mac("hmac-sha256")
            :computehex(
                string.rep("\170", 131),
                "Test Using Larger Than Block-Size Key - Hash Key First"
            ) == "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54"
    )
    local rolling = mac("hmac-sha256"):create("k\0ey")
    rolling:write("one\0")
    rolling:write("two\255")
    test(rolling:digest() == mac("hmac-sha256"):compute("k\0ey", "one\0two\255"))
end

function M.checksumVectorsAndNonConsumingReads(): nil
    test(table.concat(binary.formats("checksum"), ",") == "adler32,crc32,crc32c,crc64-ecma,crc64nvme")
    local listed = binary.formats("checksum")
    listed[1] = "changed"
    test(binary.formats("checksum")[1] == "adler32")
    test(not pcall(checksum, "unknown"))
    test.raises(
        function(): nil
            checksum("unknown")
        end,
        "unknown checksum algorithm unknown"
    )
    test(checksum("adler32"):compute("") == 1ULL)
    test(checksum("crc32"):compute("") == 0ULL)
    test(checksum("crc32c"):compute("") == 0ULL)
    test(checksum("crc64-ecma"):compute("") == 0ULL)
    test(checksum("crc64nvme"):compute("") == 0ULL)
    test(checksum("adler32"):compute("123456789") == 0x091e01deULL)
    test(checksum("crc32"):compute("123456789") == 0xcbf43926ULL)
    test(checksum("crc32c"):compute("123456789") == 0xe3069283ULL)
    test(checksum("crc64-ecma"):compute("123456789") == 0x6c40df5f0b497347ULL)
    test(checksum("crc64-ecma").width == 64)
    test(checksum("crc64nvme"):compute("123456789") == 0xae8b14860a799888ULL)
    test(checksum("crc64nvme").width == 64)
    for _, name in ipairs(binary.formats("checksum")) do
        test(checksum(name) == checksum(name))
        local rolling = checksum(name):create()
        test(rolling:algorithm() == name)
        test(rolling:width() == checksum(name).width)
        rolling:write("1234")
        test(rolling:value() == checksum(name):compute("1234"))
        local source = "56789"
        local tail = span.fromstring(source)
        rolling:writespan(tail)
        test(rolling:value() == checksum(name):compute("123456789"))

        local chunked = checksum(name):create()
        local message = string.rep("a\0b\255c", 53)
        for index = 1, #message, 7 do
            chunked:write(message:sub(index, index + 6))
        end
        test(chunked:value() == checksum(name):compute(message))
    end
end

function M.hexCodecIsStrictAndRoundTripsBytes(): nil
    local parts: {string} = {}
    for byte = 0, 255 do
        parts[#parts + 1] = string.char(byte)
    end
    local input = table.concat(parts)
    local encoded = binary.hexencode(input)
    test(#encoded == 512 and not encoded:find("[^0-9a-f]"))
    test(binary.hexdecode(encoded) == input)
    test(binary.hexdecode(encoded:upper()) == input)
    test(binary.hexdecode("") == "")
    local decoded, reason = binary.hexdecode("0")
    test(decoded == nil and reason == "hex input must contain an even number of digits")
    decoded, reason = binary.hexdecode("0x")
    test(decoded == nil and reason == "hex input contains a non-hexadecimal digit")
    decoded, reason = binary.hexdecode("00 1")
    test(decoded == nil and reason == "hex input contains a non-hexadecimal digit")
end

function M.crcViewsRespectOffsetsAndContextsAreIndependent(): nil
    local storage = "prefix" .. string.rep("a\0b\255c", 4097) .. "suffix"
    local bytes = span.fromstring(storage)
    local view = bytes:slice(7, #storage - 6)
    local payload = storage:sub(7, -7)
    for _, name in ipairs({"crc32", "crc32c", "crc64-ecma", "crc64nvme"}) do
        local first = checksum(name):create()
        local second = checksum(name):create()
        first:writespan(view)
        second:write("1234")
        test(first:value() == checksum(name):compute(payload))
        local before = first:value()
        second:write("56789")
        first:write("")
        test(first:value() == before)
        test(second:value() == checksum(name):compute("123456789"))
    end
end

-- A digest and a checksum are writers, so a reader can fill either, and the
-- answer is the one writing the same bytes by hand gives.
function M.aReaderTransfersIntoADigestAndAChecksum(): nil
    local message = string.rep("a\0b\255c", 20000)
    local byHand = digest("sha256"):create()
    byHand:write(message)
    local expected = byHand:hexdigest()

    local rolling = digest("sha256"):create()
    local source = io.Reader.of(message)
    test(source:transferto(rolling) == #message)
    test(rolling:hexdigest() == expected)

    local sum = checksum("crc32c"):create()
    local again = io.Reader.of(message)
    test(again:transferto(sum) == #message)
    test(sum:value() == checksum("crc32c"):compute(message))
end

return M
