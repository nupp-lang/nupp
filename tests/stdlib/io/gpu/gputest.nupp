const assert2 = require("assert")

local gpu = require("io.gpu")
local layout = require("io.gpu")

local M = {}

local function rejects(body: function(): nil, message: string): nil
    local ok, problem = pcall(body)
    assert2(not ok, "expected rejection containing " .. message)
    assert2(tostring(problem):find(message, 1, true), tostring(problem))
end

function M.portableLimitsHaveCanonicalPublicKeys(): nil
    assert2(gpu.portableworkgroupthreads == 256 and gpu.portablescratchbytes == 16384)
    assert2((gpu as any).PORTABLE_WORKGROUP_THREADS == nil)
    assert2((gpu as any).PORTABLE_SCRATCH_BYTES == nil)
end

function M.workgroupPhasesHaveDeterministicCpuMeaning(): nil
    local results: {float} = {}
    gpu.workgroups(math.u32.wrap(2), math.u32.wrap(4), function(groupIndex: uint32, phases: gpu.Phases)
        local values = phases:scratch(math.f32.narrow(0.0), 4)
        phases:run(function(localIndex: uint32)
            local base = groupIndex * math.u32.wrap(4)
            local value = base + localIndex + math.u32.wrap(1)
            values[localIndex as integer] = math.f32.narrow(value as number)
        end)
        phases:reducesum(values)
        phases:run(function(localIndex: uint32)
            if localIndex == math.u32.wrap(0) then
                results[(groupIndex as integer) + 1] = math.f32.narrow(values[0])
            end
        end)
    end)

    assert2(#results == 2)
    assert2(results[1] == 10.0)
    assert2(results[2] == 26.0)
end

function M.inclusiveScanHasDeterministicCpuMeaning(): nil
    local results: {uint32} = {}
    gpu.workgroups(math.u32.wrap(1), math.u32.wrap(8), function(groupIndex: uint32, phases: gpu.Phases)
        local values = phases:scratch(groupIndex, 8)
        local temporary = phases:scratch(groupIndex, 8)
        phases:run(function(localIndex: uint32)
            values[localIndex as integer] = localIndex + math.u32.wrap(1)
        end)
        phases:inclusivescan(values, temporary)
        phases:run(function(localIndex: uint32)
            results[(localIndex as integer) + 1] = math.u32.wrap(values[localIndex as integer] as integer)
        end)
    end)

    local expected = {1, 3, 6, 10, 15, 21, 28, 36}
    for index, value in ipairs(expected) do
        assert2(results[index] == value)
    end
end

function M.sharedScratchChecksZeroBasedBounds(): nil
    gpu.workgroups(math.u32.wrap(1), math.u32.wrap(1), function(groupIndex: uint32, phases: gpu.Phases)
        local values = phases:scratch(groupIndex, 1)
        phases:run(function(localIndex: uint32)
            values[localIndex as integer] = math.u32.wrap(7)
            assert2(values[0] == 7)
        end)
    end)
end

function M.cpuGpuMetadataRejectsFractionalIntegers(): nil
    gpu.workgroups(math.u32.wrap(1), math.u32.wrap(1), function(groupIndex: uint32, phases: gpu.Phases)
        local scratch = phases.scratch as any
        rejects(
            function(): nil
                scratch(phases, groupIndex, 1.5)
            end,
            "at least one element"
        )
        local values = phases:scratch(groupIndex, 1) as any
        assert2(values[0] == groupIndex, "scratch must expose its initial value")
        rejects(
            function(): nil
                local _ = values[0.5]
            end,
            "index out of bounds"
        )
        rejects(
            function(): nil
                values[0.5] = groupIndex
            end,
            "index out of bounds"
        )
        assert2(values[0] == groupIndex, "refused fractional writes must not change scratch")
    end)

    local uncheckedNew = layout.Layout as any
    local uncheckedSubview = layout.Layout.subview as any
    local uncheckedTranspose = layout.Layout.transpose as any
    local uncheckedStrided = layout.Layout.asstrided as any
    rejects(
        function(): nil
            uncheckedNew({1}, {1}, 0.5)
        end,
        "offset exceeds uint32"
    )
    rejects(
        function(): nil
            uncheckedNew({1.5}, {1})
        end,
        "dimensions and strides must fit uint32"
    )
    rejects(
        function(): nil
            uncheckedNew({1}, {0.5})
        end,
        "dimensions and strides must fit uint32"
    )
    local stored = layout.Layout({2}, {1})
    rejects(
        function(): nil
            uncheckedSubview(stored, {0.5}, {1})
        end,
        "outside its layout"
    )
    rejects(
        function(): nil
            uncheckedTranspose(stored, {1.5})
        end,
        "every axis exactly once"
    )
    rejects(
        function(): nil
            uncheckedStrided(stored, {1}, {1}, 0.5)
        end,
        "offset exceeds uint32"
    )
end

function M.tensorLayoutsTransposeBroadcastAndProveInjectivity(): nil
    local stored = layout.Layout({1, 3, 2}, {6, 2, 1})
    local transposed = stored:transpose({1, 3, 2})
    local broadcast = transposed:broadcast({4, 2, 3})
    local shape = broadcast:dimensions()
    local strides = broadcast:strides()

    assert2(broadcast.count == 24)
    assert2(broadcast:extent() == 6)
    assert2(shape[1] == 4 and shape[2] == 2 and shape[3] == 3)
    assert2(strides[1] == 0 and strides[2] == 1 and strides[3] == 2)
    assert2(not broadcast:isdense())
    assert2(not broadcast:isinjective())

    local gapped = stored:asstrided({2, 2}, {3, 1}, 0)
    assert2(gapped.count == 4)
    assert2(gapped:extent() == 5)
    assert2(not gapped:isdense())
    assert2(gapped:isinjective())

    local singleton = layout.Layout({1, 6}, {0, 1})
    assert2(singleton:offset() == 0, "the offset defaults to the first element")
    assert2(singleton:isdense())
    assert2(singleton:isinjective())
end

function M.tensorLayoutsCopyInputsAndValidateEveryTransformation(): nil
    local shape = {2, 3}
    local strides = {3, 1}
    local stored = layout.Layout(shape, strides, 7)
    shape[1] = 1
    strides[1] = 0
    local returnedShape = stored:dimensions()
    local returnedStrides = stored:strides()
    returnedShape[2] = 1
    returnedStrides[2] = 0
    assert2(stored:dimensions()[1] == 2 and stored:dimensions()[2] == 3)
    assert2(stored:strides()[1] == 3 and stored:strides()[2] == 1)

    local last = stored:subview({1, 2}, {1, 1})
    assert2(last:offset() == 12 and last:extent() == 1)
    local shifted = stored:asstrided({1, 3}, {3, 1}, 3)
    assert2(shifted:offset() == 10 and shifted:extent() == 3)

    rejects(
        function(): nil
            layout.Layout({}, {})
        end,
        "one through four"
    )
    rejects(
        function(): nil
            layout.Layout({1}, {1}, -1)
        end,
        "offset exceeds uint32"
    )
    rejects(
        function(): nil
            layout.Layout({65536, 65536}, {65536, 1})
        end,
        "dimensions and strides must fit uint32"
    )
    rejects(
        function(): nil
            layout.Layout({2}, {4294967295})
        end,
        "extent exceeds uint32"
    )
    rejects(
        function(): nil
            stored:subview({2, 0}, {1, 1})
        end,
        "outside its layout"
    )
    rejects(
        function(): nil
            stored:transpose({1, 1})
        end,
        "every axis exactly once"
    )
    rejects(
        function(): nil
            stored:broadcast({2, 4})
        end,
        "dimensions are incompatible"
    )
    rejects(
        function(): nil
            stored:asstrided({2, 2}, {3, 1}, 2)
        end,
        "exceeds its source"
    )
end

return M
