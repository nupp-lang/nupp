const assert2 = require("assert")

const {type Reader} = require("io")
const {type Buffer} = require("io")
const {type Writer} = require("io")
const io2 = require("io")

local text = require("io")
local span = require("binary.span")

local M = {}

local record ProbeReader is Reader
    state: any

    function read(exclusive self, count: integer): (string?, string?)
        if self.state.bytes ~= nil then
            self.state.maxRead = math.max(self.state.maxRead or 0, count)
            if self.state.overread then
                local all = self.state.bytes
                self.state.bytes = ""
                return all
            end
            local out = self.state.bytes:sub(1, count)
            self.state.bytes = self.state.bytes:sub(#out + 1)
            if #out > 0 then
                return out
            end
        end
        if self.state.failure ~= nil then
            local failure = self.state.failure
            self.state.failure = nil
            return nil, failure
        end

        return ""
    end

    function readspan(exclusive self, exclusive destination: span.ByteWriteSpan): (integer?, string?)
        return 0
    end

    function readinto(
        exclusive self,
        exclusive destination: Buffer,
        offset: integer?,
        count: integer?
    ): (integer?, string?)
        return 0
    end

    function transferto(exclusive self, exclusive destination: Writer): (integer?, string?)
        return 0
    end

    function close(takes self): nil
        self.state.closes = self.state.closes + 1
    end
end

-- A reader that supplies only what the contract cannot default, and counts how
-- many bytes anyone took from it.
local record PlainReader is Reader
    state: any

    function read(exclusive self, count: integer): (string?, string?)
        if self.state.failure ~= nil then
            return nil, self.state.failure
        end
        local out = self.state.bytes:sub(1, count)
        self.state.bytes = self.state.bytes:sub(#out + 1)
        self.state.taken = self.state.taken + #out

        return out
    end

    function readspan(exclusive self, exclusive destination: span.ByteWriteSpan): (integer?, string?)
        local chunk, why = self:read(#destination)
        if chunk == nil then
            return nil, why
        end
        const bytes = span.fromstring(chunk)
        for index = 1, #bytes do
            destination[index] = bytes[index]
        end

        return #chunk
    end

    function close(takes self): nil
        self.state.closes = self.state.closes + 1
    end
end

local record ProbeWriter is Writer
    state: any

    function write(exclusive self, bytes: string): (boolean, string?)
        if self.state.failure ~= nil then
            return false, self.state.failure
        end

        return true
    end

    function writespan(exclusive self, borrows source: span.Span<uint8>): (integer?, string?)
        return #source
    end

    function flush(self): (boolean, string?)
        if self.state.flushFailure ~= nil then
            return false, self.state.flushFailure
        end

        return true
    end

    function close(takes self): nil
        self.state.closes = self.state.closes + 1
    end
end

function M.roundTripsEveryCScalar(): nil
    local stored = io2.Buffer.create()
    do
        local writer = stored:writer():scalar()
        writer:writeuint8(255)
        writer:writeint8(math.i32.wrap(-128))
        writer:writeuint16(65535)
        writer:writeint16(math.i32.wrap(-32768))
        writer:writeuint32(4294967295)
        writer:writeint32(math.i32.wrap(-2147483648))
        writer:writeuint64(1234567890123 as uint64)
        writer:writeint64(-1234567890123 as int64)
        writer:writefloat32(1.5)
        writer:writefloat64(-1234.5)

    end
    local reader = io2.Reader.of(stored as Buffer):scalar()
    assert2(reader:remaining() == 42)
    assert2(reader:readuint8() == 255)
    assert2(reader:readint8() == -128)
    assert2(reader:readuint16() == 65535)
    assert2(reader:readint16() == -32768)
    assert2(reader:readuint32() == 4294967295)
    assert2(reader:readint32() == -2147483648)
    assert2(reader:readuint64() == (1234567890123 as uint64))
    assert2(reader:readint64() == (-1234567890123 as int64))
    assert2(reader:readfloat32() == 1.5)
    assert2(reader:readfloat64() == -1234.5)
    assert2(reader:remaining() == 0)
    assert2(reader:atend())
end

function M.movesRawBytesAndTracksTheCursor(): nil
    local reader = io2.Reader.of("abcdef"):scalar()
    assert2(reader:readbytes(2) == "ab")
    assert2(reader:skip(2) == reader)
    assert2(reader:remaining() == 2)
    assert2(reader:readbytes(2) == "ef")
    assert2(reader:atend())
end

function M.continuesAtTheByteWritersCurrentPosition(): nil
    local destination = io2.Buffer.create()
    do
        local bytes = destination:writer()
        assert2(bytes:write("head"))
        local writer = bytes:scalar()
        assert2(writer:writebytes(":"):writeuint8(33) == writer)
    end
    assert2(destination:tostring() == "head:!")
end

function M.writesThroughSomebodyElsesWriter(): nil
    local destination = io2.Buffer.create()
    local writer = (destination:writer()):scalar()
    writer:writeuint16(513)
    assert2(writer:flush())
    assert2(destination:tostring() == "\1\2")
end

function M.readsThroughAnyReader(): nil
    local reader = (io2.Reader.of("\1\2\3\4rest")):scalar()
    assert2(reader:remaining() == 8)
    assert2(reader:readuint32() == 67305985)
    assert2(reader:readbytes(4) == "rest")
    assert2(reader:atend())
end

function M.bufferReadersConsumeInPlace(): nil
    local queue = text.Buffer.create()
    queue:put("head:")
    queue:put("!")

    local reader = queue:reader():scalar()
    assert2(reader:remaining() == 6)
    assert2(reader:readbytes(5) == "head:")
    assert2(reader:remaining() == 1)
    assert2(reader:readuint8() == 33)
    assert2(reader:atend())
    reader:close()
    assert2(queue:tostring() == "")
end

function M.bridgesAStringBufferIntoTheReaderContract(): nil
    local queue = text.Buffer.create()
    queue:put("payload")

    local destination = io2.Buffer.create()
    local reader = queue:reader()
    assert2(reader:transferto(destination:writer()) == 7)
    assert2(destination:tostring() == "payload")
    assert2(reader:read(8) == "")
end

function M.shortReadsRaiseBeforeConsuming(): nil
    local reader = io2.Reader.of("x"):scalar()
    local ok, reason = pcall(function(): nil
        reader:readuint16()
    end)
    assert2(not ok)
    assert2(tostring(reason):find("needs 2 bytes, has 1", 1, true) ~= nil)
    assert2(reader:remaining() == 1)
end

function M.bufferWriteLeasesCommitAtomically(): nil
    local destination = io2.Buffer.create("head")
    do
        local lease = destination:reserve(4)
        do
            local output = lease:span()
            output[1] = 65
            output[2] = 66
            output[3] = 67
            own.drop(output)
        end
        lease:commit(2)
    end
    assert2(destination:tostring() == "headAB")

    do
        local aborted = destination:reserve(2)
        local output = aborted:span()
        output[1] = 88
    end
    assert2(destination:tostring() == "headAB")
end

function M.readerCountsArePositiveAndEofDoesNotGrowBuffers(): nil
    local reader = io2.Reader.of("x")
    assert2(
        not pcall(function(): nil
            reader:read(0)
        end)
    )
    local destination = io2.Buffer.create("kept")
    assert2(reader:readinto(destination, 4, 1) == 1)
    assert2(destination:tostring() == "keptx")
    assert2(reader:readinto(destination, 20, 1) == 0)
    assert2(destination:tostring() == "keptx")
    assert2(
        not pcall(function(): nil
            local other = io2.Buffer.create()
            reader:readinto(other, 0, 0)
        end)
    )
end

function M.defaultAdaptersValidateBeforeConsumingAndMoveEverything(): nil
    local state = {bytes = "abcdef", taken = 0, closes = 0}
    local reader = PlainReader(state = state)
    local destination = io2.Buffer.create("xy")
    for _, bad in ipairs({-1, 1.5}) do
        local ok, problem = pcall(function(): nil
            local scratch = io2.Buffer.create()
            reader:readinto(scratch, bad as integer, 2)
        end)
        assert2(not ok and tostring(problem):find("offset", 1, true) ~= nil, tostring(problem))
    end
    local ok = pcall(function(): nil
        local scratch = io2.Buffer.create()
        reader:readinto(scratch, 0, 0)
    end)
    assert2(not ok, "a zero count is refused")
    assert2(state.taken == 0, "a malformed call consumed input")

    assert2(reader:readinto(destination, 2, 3) == 3)
    assert2(destination:tostring() == "xyabc")
    assert2(destination:len() == 5, "only what arrived is reserved")

    local sink = io2.Buffer.create()
    do
        local writer = sink:writer()
        assert2(reader:transferto(writer) == 3)
        writer:close()
    end
    assert2(sink:tostring() == "def")
    assert2(reader:readinto(destination, 0, 4) == 0, "the end reads as zero")

    state.failure = "gone"
    local spare = io2.Buffer.create()
    do
        local writer = spare:writer()
        local moved, why = reader:transferto(writer)
        assert2(moved == nil and why == "gone")
        writer:close()
    end
    local read, reason = reader:readinto(destination)
    assert2(read == nil and reason == "gone")
    reader:close()
    assert2(state.closes == 1)
end

function M.scalarReadersConsumeBuffersWithoutClosingThem(): nil
    local buffer = io2.Buffer.create("xy")
    do
        local reader = buffer:reader():scalar()
        assert2(reader:remaining() == 2)
        assert2(reader:readbytes(1) == "x")
        assert2(reader:remaining() == 1)
    end
    assert2(buffer:tostring() == "y")
end

function M.rejectsInvalidRangesAndQueueAdapters(): nil
    local buffer = io2.Buffer.create("abc")
    assert2(
        not pcall(function(): nil
            buffer:writestring(false as any, "x")
        end)
    )
    assert2(
        not pcall(function(): nil
            local lease = buffer:reserve(9007199254740991)
            own.drop(lease)
        end)
    )
    assert2(
        not pcall(function(): nil
            local invalid = io2.Reader.of("x")
            invalid:read(math.huge as integer)
        end)
    )
    assert2(
        not pcall(function(): nil
            local invalid = io2.Reader.of("x")
            local destination = io2.Buffer.create()
            invalid:readinto(destination, nil, false as any)
        end)
    )

    local queue = {
        get = function(): string
            return "x"
        end
    }
    local open: any = rawget(io2.Reader as table, "of")
    local ok, reason = pcall(function(): nil
        local reader = open(queue)
        reader:close()
    end)
    assert2(not ok and tostring(reason):find("io.Reader.of needs", 1, true) ~= nil)

    local scalar = io2.Reader.of("x"):scalar()
    ok, reason = pcall(function(): nil
        scalar:readbytes(math.huge as integer)
    end)
    assert2(not ok and tostring(reason):find("must be a non-negative integer", 1, true) ~= nil)
end

function M.scalarReadersRejectSourcesThatOverread(): nil
    local source = ProbeReader(state = {bytes = "ab", closes = 0, overread = true})
    local reader = (source):scalar()
    local ok, reason = pcall(function(): nil
        reader:readuint8()
    end)
    assert2(not ok and tostring(reason):find("more bytes than requested", 1, true) ~= nil)
end

function M.scalarWritersPropagateDestinationFailures(): nil
    local writer = (ProbeWriter(state = {closes = 0, failure = "cancelled"})):scalar()
    local ok, reason = pcall(function(): nil
        writer:writeuint16(1)
    end)
    assert2(not ok and tostring(reason):find("destination failed: cancelled", 1, true) ~= nil)
end

function M.lineReadersBoundPullsAndOwnTheirSources(): nil
    local state = {bytes = "abc\r\nrest", closes = 0, maxRead = 0}
    local lines = (ProbeReader(state = state)):lines(3)
    assert2(lines:read() == "abc")
    assert2(state.maxRead <= 5)
    lines:close()
    assert2(state.closes == 1)
end

function M.lineReadersPropagateFailuresAfterPartialInput(): nil
    local state = {bytes = "partial", closes = 0, failure = "cancelled"}
    local lines = (ProbeReader(state = state)):lines(64)
    local line, reason = lines:read()
    assert2(line == nil and reason == "cancelled")
    lines:close()
    assert2(state.closes == 1)
end

function M.lineReadersRejectInvalidLimitsAndSourcesThatOverread(): nil
    local ok, reason = pcall(function(): nil
        local lines = (ProbeReader(state = {closes = 0})):lines(math.huge as integer)
        lines:close()
    end)
    assert2(not ok)

    local lines = (ProbeReader(state = {bytes = "abcdef", closes = 0, overread = true})):lines(2)
    ok, reason = pcall(function(): nil
        lines:read()
    end)
    assert2(not ok and tostring(reason):find("more bytes than requested", 1, true) ~= nil)
end

function M.scalarAdaptersFinishTakenEndpointsExactlyOnce(): nil
    local readerDrop = {drops = 0, closes = 0}
    do
        local scalar = (ProbeReader(state = readerDrop)):scalar()
    end
    assert2(readerDrop.closes == 1)

    local readerClose = {drops = 0, closes = 0}
    do
        local scalar = (ProbeReader(state = readerClose)):scalar()
        scalar:close()
    end
    assert2(readerClose.closes == 1)

    local writerDrop = {drops = 0, closes = 0}
    do
        local scalar = (ProbeWriter(state = writerDrop)):scalar()
    end
    assert2(writerDrop.closes == 1)

    local writerClose = {drops = 0, closes = 0}
    do
        local scalar = (ProbeWriter(state = writerClose)):scalar()
        scalar:close()
    end
    assert2(writerClose.closes == 1)
end

-- `close` answers nothing, so a destination that failed to take its bytes has to
-- say so earlier: `flush` is where it does, and closing afterwards still runs.
function M.flushReportsAFailedDestinationBeforeClose(): nil
    local state = {closes = 0, flushFailure = "disk full"}
    do
        local scalar = (ProbeWriter(state = state)):scalar()
        scalar:writeuint8(1)
        local flushed, reason = scalar:flush()
        assert2(flushed == false)
        assert2(reason == "disk full")
        scalar:close()
    end
    assert2(state.closes == 1)
end

-- A reader drained whole answers one string; a limit is checked as bytes arrive,
-- and the reader it took is closed either way.
function M.readAllDrainsAReaderWithinItsLimit(): nil
    assert2(io2.Reader.of(""):readall() == "")
    local big = string.rep("0123456789", 20000)
    assert2(io2.Reader.of(big):readall() == big)
    assert2(io2.Reader.of(big):readall(#big) == big, "exactly the limit is within it")
    local refused, reason = io2.Reader.of(big):readall(#big - 1)
    assert2(refused == nil and reason ~= nil, "one byte past the limit is refused")

    local state = {closes = 0, bytes = "abc", maxRead = 0}
    local answered = ProbeReader(state = state):readall(2)
    assert2(answered == nil)
    assert2(state.maxRead <= 3, "it never asks for more than one byte past the limit")
    assert2(state.closes == 1, "the reader is closed when the limit refuses it")

    local failing = {closes = 0, bytes = "ab", failure = "broken pipe"}
    local text, why = ProbeReader(state = failing):readall()
    assert2(text == nil and why == "broken pipe")
    assert2(failing.closes == 1, "the reader is closed when it fails")
end

return M
