--[=[
Stable-address FFI storage with chunked allocation.
Chunks are never moved while the array is alive, so element addresses stay
stable even when ids are recycled.

Ported from tecs `src/tecs/internal/ffi/StableChunkedArray.tl`.
]=]

const ffi = require("ffi")
const floor = math.floor

local M = {}

--- A chunked array of stable-address FFI slots.
record M.ChunkedArray
    chunks: {cdata}
    chunkSize: integer
    ffiType: string
    nextId: integer
    freeIds: {integer}
    alive: {[integer]: boolean}

    --- Allocate a new slot and return its 1-based id.
    function alloc(self): integer
        local id: integer
        const freeIds = self.freeIds
        const n = #freeIds
        if n > 0 then
            id = freeIds[n]
            freeIds[n] = nil
        else
            id = self.nextId
            self.nextId = id + 1
            const zero = id - 1
            const chunkIndex = floor(zero / self.chunkSize) + 1
            if not self.chunks[chunkIndex] then
                self.chunks[chunkIndex] = ffi.new(self.ffiType, self.chunkSize)
            end
        end
        self.alive[id] = true
        return id
    end

    --- Free a slot for reuse. No-op if id is invalid or already freed.
    function free(self, id: integer): nil
        if id < 1 or id >= self.nextId or not self.alive[id] then
            return
        end
        self.alive[id] = nil
        self.freeIds[#self.freeIds + 1] = id
    end

    --- Get the live element stored at an id.
    --- Returns nil for dead or never-allocated ids.
    function get(self, id: integer): any
        if not self.alive[id] then
            return nil
        end
        const zero = id - 1
        const chunkIndex = floor(zero / self.chunkSize) + 1
        const chunk = self.chunks[chunkIndex]
        -- `%` on two integers widens to number, and a `{[integer]: _}` key is
        -- checked, so the cast says what the arithmetic already guarantees.
        const slot = (zero % self.chunkSize) as integer
        return (chunk as {[integer]: any})[slot]
    end
end

--- Create a new chunked array for the given base FFI type name.
---
--- @param ffiType the element's C type name
--- @param chunkSize how many elements each chunk holds
--- @raises when chunkSize is not positive
function M.new(ffiType: string, chunkSize: integer?): M.ChunkedArray
    const size = chunkSize or 256
    if size <= 0 then
        error("StableChunkedArray.new: chunkSize must be a positive integer, got "
            .. tostring(size))
    end
    return new M.ChunkedArray(
        chunks = {},
        chunkSize = size,
        ffiType = ffiType .. "[?]",
        nextId = 1,
        freeIds = {},
        alive = {}
    )
end

return M
