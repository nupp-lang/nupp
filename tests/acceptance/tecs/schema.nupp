--[=[
FFI schema utilities for components and events.

Ported from tecs `src/tecs/internal/ffi/schema.tl`. See `PORT.md` beside this
file for what the translation cost.
]=]

local schema = {}

--- Field definition tuple: {name, type}
type schema.FieldDef = {string, string}

local function isValidCIdent(name: string): boolean
    return name:match("^[A-Za-z_][A-Za-z0-9_]*$") ~= nil
end

--- Validate field definitions for FFI schema.
---
--- @param fields The field definitions to validate.
--- @param reservedFields Field names that are reserved and must not be specified.
--- @raises when a field name is empty, reserved, not a C identifier, or repeated
--- @raises when a field type is empty
function schema.validateFields(fields: {schema.FieldDef},
    reservedFields: {[string]: boolean}?): nil
    local seen: {[string]: boolean} = {}
    local reserved = reservedFields or {}

    for i = 1, #fields do
        const field = fields[i]
        const fieldName, fieldType = field[1], field[2]

        if not fieldName or fieldName == "" then
            error("Field #" .. i .. ": field name cannot be empty")
        end

        if reserved[fieldName] then
            error("Field #" .. i .. ": '" .. fieldName
                .. "' is reserved and must not be specified manually")
        end

        if not isValidCIdent(fieldName) then
            error("Field #" .. i .. ": invalid C identifier: " .. fieldName)
        end

        if seen[fieldName] then
            error("Field #" .. i .. ": duplicate field name: " .. fieldName)
        end
        seen[fieldName] = true

        if not fieldType or fieldType == "" then
            error("Field #" .. i
                .. ": field type cannot be empty for field: " .. fieldName)
        end
    end
end

return schema
