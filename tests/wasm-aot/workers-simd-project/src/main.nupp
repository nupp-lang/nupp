local kernels = require("kernels")
local tasks = require("coroutine")

-- The same kernel, run once here and once on every lane, has to agree everywhere.
local expected = kernels.scaled(64, 2)
local agreed = true
local lanes: integer = 0

-- One child per job: each forks the kernel and waits for it, and the children wait
-- together, so the kernels run on their lanes at the same time.
local function compare(): nil
    do
        local lane = tasks.scope();
        local produced = lane:work(64, 2, kernels.scaled):await()
        lanes = lanes + 1
        agreed = agreed and #produced == #expected
        for index = 1, #expected do
            agreed = agreed and produced[index] == expected[index]
        end
    end
end

do
    local scope = tasks.scope();
    for _ = 1, 8 do
        scope:spawn(compare)
    end
end

return ("{%q:%s,%q:%d,%q:%d}"):format("kernelAgreed", agreed and "true" or "false", "tasks", lanes, "values", #expected)
