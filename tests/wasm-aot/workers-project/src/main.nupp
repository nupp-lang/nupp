local jobs = require("jobs")
local tasks = require("nupp.tasks")
local time = require("nupp.time")

local counter = require("counter")
for index = 1, 100 do
    assert(counter.next() == index)
end
with scope = tasks.open() do
    local independent = scope:fork(jobs.nextCounter)
    assert(independent:await() == 1, "each lane loads its own implementation from the shared SPI index")
    assert(counter.next() == 101, "worker state is independent of the caller")
end

-- The smoke page reads one JSON document, and `nupp.codec.json` is not part of the
-- portable browser surface, so this writes the few scalars it reports itself.
local report: {string} = {}

local function record(name: string, value: string): nil
    report[#report + 1] = ("%q:%s"):format(name, value)
end

local function boolean(name: string, value: boolean): nil
    record(name, value and "true" or "false")
end

local function number(name: string, value: number): nil
    record(name, ("%.14g"):format(value))
end

local function text(name: string, value: string): nil
    record(name, ("%q"):format(value))
end

local function raised(borrows body: function(): nil): string?
    local ok, problem = pcall(body)
    if ok then
        return nil
    end

    return tostring(problem)
end

----------------------------------------------------------------------------
-- Copies crossing in both directions, on lanes that run at the same time
----------------------------------------------------------------------------

local expected = jobs.checksum("browser-worker", 64)
local fanned: {integer} = {}

-- One child per job: each forks its job and waits for it, and the children wait
-- together, so the jobs run on their lanes at the same time.
local function checksumInto(index: integer): nil
    with lane = tasks.open() do
        fanned[index] = lane:fork("browser-worker", 64, jobs.checksum):await()
    end
end

with scope = tasks.open() do
    for index = 1, 8 do
        scope:spawn(index, checksumInto)
    end
end
local matched = #fanned == 8
for _, value in ipairs(fanned) do
    matched = matched and value == expected
end
boolean("fannedOut", matched)

with scope = tasks.open() do
    local reading = new jobs.Reading(label = "left", value = 41)
    local answer = scope:fork(reading, jobs.louder):await()
    boolean("recordCrossed", answer.label == "LEFT" and answer.value == 42)

    scope:fork("done", jobs.acknowledge):await()
    boolean("emptyResultCrossed", true)
end

----------------------------------------------------------------------------
-- Leaving the scope waits for a child the body never awaited
----------------------------------------------------------------------------

local cleanupStarted = time.now()
with scope = tasks.open() do
    scope:fork(150, jobs.patient)
end
local cleanupElapsed = time.now() - cleanupStarted
boolean("scopeWaitedForUnawaited", cleanupElapsed >= 100)
number("scopeCleanupMs", cleanupElapsed)

----------------------------------------------------------------------------
-- A failure is raised by await, and the scope owns it whether or not anything did
----------------------------------------------------------------------------

local failedStatus = "unknown"
local scopeProblem = raised(function(): nil
    with scope = tasks.open() do
        local bad = scope:fork("beta", jobs.refuse)
        local problem = raised(function(): nil
            bad:await()
        end)
        boolean("failureObserved", problem ~= nil and problem:find("cannot hash beta", 1, true) ~= nil)
        failedStatus = bad:status()
    end
end)
boolean("failureOwnedByTheScope", scopeProblem ~= nil and scopeProblem:find("cannot hash beta", 1, true) ~= nil)
text("failedStatus", failedStatus)

boolean(
    "unobservedFailureRaised",
    raised(function(): nil
        with scope = tasks.open() do
            scope:fork("gamma", jobs.refuse)
        end
    end) ~= nil
)

----------------------------------------------------------------------------
-- A lane refuses a result no copy could reproduce
----------------------------------------------------------------------------

local resultProblem = raised(function(): nil
    with scope = tasks.open() do
        scope:fork("alpha", jobs.unsendableResult):await()
    end
end)
boolean("unsendableResultRefused", resultProblem ~= nil and resultProblem:find("cannot be copied", 1, true) ~= nil)

-- And the caller is refused before anything is submitted at all.
with scope = tasks.open() do
    local shared = {name = "a"}

    local function submitAnAlias(): nil
        scope:fork({shared, shared}, jobs.count)
    end

    local problem = raised(submitAnAlias)
    boolean(
        "unsendableArgumentRefusedAtTheCallSite",
        problem ~= nil and problem:find("repeats a table already present", 1, true) ~= nil
    )
end

----------------------------------------------------------------------------
-- A worker task cannot fork onto another lane
----------------------------------------------------------------------------

local nestedProblem = raised(function(): nil
    with scope = tasks.open() do
        scope:fork(4, jobs.nested):await()
    end
end)
boolean("nestedScopeRefused", nestedProblem ~= nil and nestedProblem:find("another worker scope", 1, true) ~= nil)

----------------------------------------------------------------------------
-- Cancellation, and the running task a cancellation does not interrupt
----------------------------------------------------------------------------

local function occupyALane(): nil
    with lane = tasks.open() do
        lane:fork(60, jobs.patient):await()
    end
end

with scope = tasks.open() do
    -- More waiting tasks than any browser pool has lanes: the sleep lets every
    -- child run far enough to submit its job, so the next one is still queued, and
    -- cancelling it is a cancellation that never loads or invokes its function.
    for _ = 1, 31 do
        scope:spawn(occupyALane)
    end
    time.sleep(10)
    local queued = scope:fork(60, jobs.patient)
    boolean("cancelRequested", queued:cancel("the test asked"))
    boolean("cancelIsIdempotent", not queued:cancel("again"))
    local problem = raised(function(): nil
        queued:await()
    end)
    boolean("queuedCancelled", problem ~= nil and problem:find("was cancelled", 1, true) ~= nil)
    text("cancelledStatus", queued:status())
end

with scope = tasks.open() do
    -- A settled task leaves a lane booted and idle, so the next submission is
    -- running by the time anything else happens.
    scope:fork("warm", 1, jobs.checksum):await()
    local running = scope:fork(200, jobs.patient)
    time.sleep(50)
    running:cancel("too late")

    -- It has no checkpoint, so it is not interrupted and keeps its result.
    boolean("runningTaskNotInterrupted", running:await() == 200)
end

----------------------------------------------------------------------------
-- Hard limits: the queue is bounded, and submission raises rather than waiting
----------------------------------------------------------------------------

with scope = tasks.open() do
    local submitted: integer = 0
    local refused: string? = nil

    local function submit(): nil
        scope:fork("x", 1, jobs.checksum)
    end

    for _ = 1, 1100 do
        refused = raised(submit)
        if refused ~= nil then
            break
        end
        submitted = submitted + 1
    end
    number("queueBound", submitted)
    boolean("queueRefusedAtBound", refused ~= nil and refused:find("closed or full", 1, true) ~= nil)
end

----------------------------------------------------------------------------
-- A running lane observes the cancellation its checkpoint asks about
----------------------------------------------------------------------------

with scope = tasks.open() do
    -- A settled task leaves a lane booted and idle, so the next submission is
    -- running by the time anything else happens.
    scope:fork("warm", 1, jobs.checksum):await()
    local cooperating = scope:fork(400, 25, jobs.cooperative)
    time.sleep(50)
    cooperating:cancel("the test asked")
    local problem = raised(function(): nil
        cooperating:await()
    end)
    boolean("checkpointObservedCancellation", problem ~= nil and problem:find("was cancelled", 1, true) ~= nil)
end

----------------------------------------------------------------------------
-- An application task scope owns worker children and their deadline
----------------------------------------------------------------------------

local coroutineChildren: integer = 0
with scope = tasks.open() do
    local first = scope:spawn(function(): integer
        tasks.checkpoint()

        return 1
    end)
    local second = scope:spawn(function(): integer
        time.sleep(5)

        return 2
    end)
    coroutineChildren = first:await() + second:await()
end
boolean("coroutineChildrenRan", coroutineChildren == 3)

local owned: integer = 0
with scope = tasks.open() do
    owned = scope:fork("browser-worker", 1, jobs.checksum):await()
end
boolean("taskScopeOwnsWorkers", owned == jobs.checksum("browser-worker", 1))

-- The scope's deadline reaches the lane, and the checkpoint is where it lands.
local deadlineStarted = time.now()

local function bounded(): nil
    with inner = tasks.open(timeoutMs = 250) do
        inner:fork(400, 25, jobs.cooperative):await()
    end
end

local deadlineProblem = raised(bounded)
text("deadlineProblem", deadlineProblem or "none")
text(
    "deadlineOutcome",
    deadlineProblem == nil and "completed"
    or (deadlineProblem:find("was cancelled", 1, true) ~= nil and "cancelled" or "failed")
)
number("deadlineMs", time.now() - deadlineStarted)

return "{" .. table.concat(report, ",") .. "}"
