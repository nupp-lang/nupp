-- Derives on a page. Both bundled recipes render by appending into a buffer, which
-- is LuaJIT's module and not this target's, so what this exercises is the
-- `text.buffer` provider the browser backend selects underneath them.

local json = require("nupp.codec.json")

@derive(nupp.derive.Debug, nupp.derive.JSON)
local record Reading
    @json(name = "sensor_id")
    id: integer

    label: string = "unnamed"
    samples: {integer} = {}
end

local function encodedText(value: Reading): string
    local out = require("nupp.text").newBuffer()
    local writer = json.newWriter(out)
    value:writeJSON(writer)
    writer:close()

    return out:tostring()
end

local reading = new Reading(id = 7, label = "intake", samples = {3, 1, 4})
local encoded = encodedText(reading)
local decoded, problem = Reading.fromJSON(encoded)
assert(decoded ~= nil, tostring(problem))
-- A field the document does not carry is the recipe's default rather than absent,
-- and a required one that is missing is a reported failure rather than a nil field.
local defaulted = Reading.fromJSON([[{"sensor_id":9}]])
local missing, why = Reading.fromJSON([[{"label":"nameless"}]])

return json.encode({
    encoded = encoded,
    debug = reading:debug(),
    roundTripped = (decoded as Reading):debug(),
    defaultedLabel = defaulted ~= nil and (defaulted as Reading).label or "<absent>",
    missingRefused = missing == nil and why ~= nil,
    -- The buffer has to survive being reused rather than only being allocated once.
    repeated = encodedText(reading) == encoded,
})
