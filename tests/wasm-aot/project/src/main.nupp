const assert2 = require("assert")

const io2 = require("io")

local span = require("binary.span")
local array = require("nupp.mem.array")
local base64 = require("binary.base64")
local valuebuilder = require("serde.valuebuilder")

local function u32(value: integer): uint32
    return math.u32.wrap(value)
end

@aot
local function copyString(source: string, nullValue: any): any
    local length = valuebuilder.len(source)
    local builder = valuebuilder.new(nullValue)
    local scratch = valuebuilder.newbytescratch(length)
    local index: uint32 = u32(0)
    while index < length do
        valuebuilder.setscratchbyte(scratch, index, valuebuilder.byte(source, index))
        index = math.u32.add(index, u32(1))
    end
    valuebuilder.stringscratch(builder, scratch, u32(0), length)

    return valuebuilder.finish(builder)
end

@aot
local function describe(name: string, count: integer): {[string]: any}
    return {name = name, count = count, values = {1, 2, 3}}
end

assert2(copyString("Lua-builder in Wasm", nil) == "Lua-builder in Wasm")
assert2(copyString("", nil) == "")
assert2(base64.encode("browser bytes\0\255") == "YnJvd3NlciBieXRlcwD/")
assert2(base64.decode("YnJvd3NlciBieXRlcwD/") == "browser bytes\0\255")
local description = describe("wasm", 3)
assert2(description.name == "wasm" and description.count == 3 and description.values[3] == 3)

local struct Sample
    value: float
    bias: number
    weight: float
end

@aot
local function scale(
    exclusive output: span.WriteSpan<Sample>,
    borrows input: span.Span<Sample>,
    factor: number,
    enabled: boolean
): nil
    if #output ~= #input then
        error("length mismatch", 2)
    end
    for index = 1, #output do
        if enabled then
            output[index].value = input[index].value * factor
            output[index].bias = input[index].bias + factor
            output[index].weight = input[index].weight + factor
        end
    end
end

local input = array.newarray(new Sample(), 3)
local inputRows = input:write()
inputRows[1] = new Sample(2, 10, 1)
inputRows[2] = new Sample(3, 20, 4)
inputRows[3] = new Sample(5, 30, 7)
own.drop(inputRows)

local output = array.newarray(new Sample(), 3)
do
    local writable = output:write()
    scale(writable, input:read(), 2, true)
    own.drop(writable)
end

local rows = output:read()
assert2(#rows == 3)
assert2(rows[1].value == 4 and rows[1].bias == 12 and rows[1].weight == 3)
assert2(rows[2].value == 6 and rows[2].bias == 22 and rows[2].weight == 6)
assert2(rows[3].value == 10 and rows[3].bias == 32 and rows[3].weight == 9)

@aot
local function incrementWide(
    exclusive output: span.WriteSpan<uint64>,
    borrows input: span.Span<uint64>,
    delta: uint64
): nil
    if #output ~= #input then
        error("length mismatch", 2)
    end
    for index = 1, #output do
        output[index] = input[index] + delta
    end
end

@aot
local function addWide(left: uint64, right: uint64): uint64
    return left + right
end

@aot
local function unsignedBits(left: uint64, right: uint64, count: uint64): (uint64, uint64, uint64, uint64, uint64)
    return left & right, left | right, left ~ right, left << count, left >> count
end

@aot
local function signedBits(value: int64, count: int64): (int64, int64, int64)
    return ~value, value >> count, value ~>> count
end

@aot
local function rotateWide(value: uint64, count: integer): (uint64, uint64)
    return math.u64.rotateleft(value, count), math.u64.rotateright(value, count)
end

local wideInput = array.scalar(array.uint64, 2)
do
    local writable = wideInput:write()
    writable[1] = (-1 as int64) as uint64
    writable[2] = 9007199254740992 as uint64
    own.drop(writable)
end
local wideOutput = array.scalar(array.uint64, 2)
do
    local writable = wideOutput:write()
    incrementWide(writable, wideInput:read(), 1 as uint64)
    own.drop(writable)
end
local exact = addWide(wideInput:read()[2], 1 as uint64)
assert2(tostring(exact) == "9007199254740993")
assert2(wideOutput:read()[1] == (0 as uint64))
assert2(tostring(wideOutput:read()[2]) == "9007199254740993")
local banded, joined, toggled, shiftedLeft, shiftedRight = unsignedBits(0xf0 as uint64, 0x0f as uint64, 4 as uint64)
assert2(banded == (0 as uint64) and joined == (0xff as uint64) and toggled == (0xff as uint64))
assert2(shiftedLeft == (0xf00 as uint64) and shiftedRight == (0x0f as uint64))
local inverted, logical, arithmetic = signedBits(-2 as int64, 1 as int64)
assert2(inverted == (1 as int64) and tostring(logical) == "9223372036854775807" and arithmetic == (-1 as int64))
local rotatedLeft, rotatedRight = rotateWide(1 as uint64, 1)
assert2(rotatedLeft == (2 as uint64) and tostring(rotatedRight) == "9223372036854775808")

@aot
local function copyBytes(exclusive destination: span.WriteSpan<uint8>, borrows source: span.ByteSpan): nil
    if #destination ~= #source then
        error("length mismatch", 2)
    end
    for index = 1, #destination do
        destination[index] = source[index]
    end
end

local byteBuffer = io2.newbuffer(4)
local byteLease = byteBuffer:reservewrite(0, 4)
do
    local bytes = byteLease:span()
    const original = "a\0b\255"
    const source = span.fromstring(original)
    copyBytes(bytes, source)
    own.drop(bytes)
end
byteLease:commit(4)
assert2(byteBuffer:getstring() == "a\0b\255")
