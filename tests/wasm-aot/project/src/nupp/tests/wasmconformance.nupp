module nupp.tests.wasmconformance

-- The implementation conformance fixture belongs to Nupp's namespace, so the
-- application entrypoint need not import private providers or suites.
local provider = require("nupp.runtime.storage")
local storageSuite = require("nupp.tests.providers.cstorage")
local int64Suite = require("nupp.tests.providers.int64")
local int64 = require("nupp.runtime.int64")

export function run(): (boolean, string?)
    local storageOk, storageWhy = storageSuite.test(provider, require("nupp.runtime.structvalue"))
    if not storageOk then
        return false, storageWhy
    end

    return int64Suite.test(int64)
end
