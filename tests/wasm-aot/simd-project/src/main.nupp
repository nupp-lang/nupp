local span = require("nupp.mem.span")
local array = require("nupp.mem.array")
local conformance = require("nupp.tests.wasmconformance")
local simd = require("nupp.simd")

local seamOk, seamWhy = conformance.run()
assert(seamOk, seamWhy)

local struct Sample
    value: float
    bias: number
    weight: float
end

@aot
local function scale(
    exclusive output: span.WriteSpan<Sample>,
    borrows input: span.Span<Sample>,
    factor: number,
    enabled: boolean
): nil
    if #output ~= #input then
        error("length mismatch", 2)
    end
    for index = 1, #output do
        if enabled then
            output[index].value = input[index].value * factor
            output[index].bias = input[index].bias + factor
            output[index].weight = input[index].weight + factor
        end
    end
end

local input = array.new(new Sample(), 3)
local inputRows = input:write()
inputRows[1] = new Sample(2, 10, 1)
inputRows[2] = new Sample(3, 20, 4)
inputRows[3] = new Sample(5, 30, 7)
nupp.drop(inputRows)

local output = array.new(new Sample(), 3)
do
    local writable = output:write()
    scale(writable, input:read(), 2, true)
    nupp.drop(writable)
end

local rows = output:read()
assert(#rows == 3)
assert(rows[1].value == 4 and rows[1].bias == 12 and rows[1].weight == 3)
assert(rows[2].value == 6 and rows[2].bias == 22 and rows[2].weight == 6)
assert(rows[3].value == 10 and rows[3].bias == 32 and rows[3].weight == 9)

@aot
local function rearrange(exclusive output: span.WriteSpan<uint32>, borrows input: span.Span<uint32>): nil
    local bits = assert(simd.species(array.uint32, 3))
    local floats = assert(simd.species(array.float, 3))
    local a, b = floats:reinterpret(bits:load(input, 1)):interleave(floats:reinterpret(bits:load(input, 4)))
    local first, second = a:deinterleave(b)
    local x, y, z = simd.transpose(first, second, floats:reinterpret(bits:load(input, 7)))
    bits:store(output, 1, bits:reinterpret(x))
    bits:store(output, 4, bits:reinterpret(y))
    bits:store(output, 7, bits:reinterpret(z))
end

local tile = array.scalar(array.uint32, 9)
do
    local writable = tile:write()
    for i = 1, 9 do
        writable[i] = nupp.math.u32.wrap(i)
    end
    writable[1] = 0x80000000
    writable[2] = 0x7fc12345
    writable[3] = 0x7f812345
    nupp.drop(writable)
end
local transposed = array.scalar(array.uint32, 9)
do
    local writable = transposed:write()
    rearrange(writable, tile:read())
    nupp.drop(writable)
end
local original = tile:read()
local columns = transposed:read()
for row = 1, 3 do
    for column = 1, 3 do
        assert(columns[(column - 1) * 3 + row] == original[(row - 1) * 3 + column])
    end
end

-- The exact reducer contracts, at simd128.
--
-- An ordered reducer is the erased Lua loop's own chain and a pairwise one is
-- the logical-index tree; neither is allowed to depend on how many lanes the
-- target chose. The native differential in `aotbuildtest` holds them to the
-- ordinary Lua reducers on NEON, and this holds the same reducers to the same
-- Lua on the one other tier that can execute them -- which is what makes the
-- claim cross-tier rather than a property of one backend. Both are compared
-- against the library's own Lua bodies, running here in the same program.
@aot
local function orderedSum(borrows input: span.Span<number>, seed: number): number
    local fold = simd.reducer.orderedSum(seed)
    for i = 1, #input do
        fold:add(input[i])
    end

    return fold:value()
end

@aot
local function pairwiseSum(borrows input: span.Span<number>, seed: number): number
    local fold = simd.reducer.pairwiseSum(seed)
    for i = 1, #input do
        fold:add(input[i])
    end

    return fold:value()
end

@aot
local function orderedDot(borrows input: span.Span<number>, seed: number): number
    local fold = simd.reducer.orderedDot(seed)
    for i = 1, #input do
        fold:add(input[i], input[i])
    end

    return fold:value()
end

@aot
local function wrappingSum(borrows input: span.Span<int32>, seed: int32): int32
    local fold = simd.reducer.i32.wrappingSum(seed)
    for i = 1, #input do
        fold:add(input[i])
    end

    return fold:value()
end

-- Magnitudes that cancel, so a reassociated sum would answer different low
-- bits, and the exceptional values a lane-parallel tree can reorder without
-- noticing: both zeros, both infinities and a NaN.
local reducerSamples = {1.0, 1e16, -1e16, 0.5, -2.25, 1e-3, 3.0, -0.0, 7.0, -7.0, 1.5, 0.125, -4.0, 2.0,}
local reducerWords = {5, -7, 2147483647, -2147483648, 3, 12, -1, 0, 99, -99, 41, 7, 2, -3}

--- Two binary64 values, including their NaN and their signed zero.
local function same(actual: number, expected: number): boolean
    if actual ~= actual or expected ~= expected then
        return actual ~= actual and expected ~= expected
    end
    if actual == 0 and expected == 0 then
        return 1 / actual == 1 / expected
    end

    return actual == expected
end

-- Every tail from empty through two whole vectors and a remainder, at every
-- rotation of the corpus, so each value passes through every lane.
for offset = 0, #reducerSamples - 1 do
    local seed = reducerSamples[offset + 1]
    local word = nupp.math.i32.wrap(reducerWords[offset + 1])
    for count = 0, 21 do
        local values = array.scalar(array.number, count)
        local words = array.scalar(array.int32, count)
        local ordered = simd.reducer.orderedSum(seed)
        local pairwise = simd.reducer.pairwiseSum(seed)
        local dot = simd.reducer.orderedDot(seed)
        local wrapping = simd.reducer.i32.wrappingSum(word)
        do
            local writableValues = values:write()
            local writableWords = words:write()
            for i = 1, count do
                local value = reducerSamples[(i + offset - 1) % #reducerSamples + 1]
                writableValues[i] = value
                ordered:add(value)
                pairwise:add(value)
                dot:add(value, value)
                local digit = reducerWords[(i + offset - 1) % #reducerWords + 1]
                writableWords[i] = nupp.math.i32.wrap(digit)
                wrapping:add(nupp.math.i32.wrap(digit))
            end
            nupp.drop(writableWords)
            nupp.drop(writableValues)
        end
        local where = " at offset " .. tostring(offset) .. " count " .. tostring(count)
        assert(same(orderedSum(values:read(), seed), ordered:value()), "orderedSum" .. where)
        assert(same(pairwiseSum(values:read(), seed), pairwise:value()), "pairwiseSum" .. where)
        assert(same(orderedDot(values:read(), seed), dot:value()), "orderedDot" .. where)
        assert(wrappingSum(words:read(), word) == wrapping:value(), "i32 wrappingSum" .. where)
    end
end
