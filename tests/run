#!/bin/sh
# The project's rock tree, the same one bin/nupp puts on the path, so a test
# runs against what a build runs against.
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
ROCKS="$ROOT/.rocks"
LUA_PATH="$ROCKS/share/lua/5.1/?.lua;$ROCKS/share/lua/5.1/?/init.lua;${LUA_PATH:-;}"
# Both suffixes, because the tree is the project's own and its extension is
# the host's: a rock built here is .so on unix and .dll on Windows, and
# naming only one leaves the other invisible.
LUA_CPATH="$ROCKS/lib/lua/5.1/?.so;$ROCKS/lib/lua/5.1/?.dll;${LUA_CPATH:-;}"
export LUA_PATH LUA_CPATH

# The compiler lists directories through a native provider, and this runner is
# also an entry point in its own right rather than only the child `nupp test`
# starts. Naming the library here is what makes the two agree; building it stays
# `bin/nupp`'s job, so a tree that was never built fails saying so.
export NUPP_NATIVE_LIBRARY="$ROOT/build/lib/nupp_native"
if [ ! -f "$NUPP_NATIVE_LIBRARY" ]; then
    echo "tests/run: $NUPP_NATIVE_LIBRARY is missing; run ./bin/nupp build" >&2
    exit 1
fi

exec luajit "$ROOT/tests/run.lua" "$@"
