module s0.arm64tests

local arm64 = require("s0.arm64")
local target = require("s0.arm64target")

export function golden(): string
    assert(arm64.add_reg(32, 0, 1, 2, 0) == 0x0b020020, "add w0, w1, w2, lsl #0")
    assert(arm64.add_reg(32, 0, 1, 2, 31) == 0x0b027c20, "add w0, w1, w2, lsl #31")
    assert(arm64.sub_reg(32, 0, 1, 2, 0) == 0x4b020020, "sub w0, w1, w2, lsl #0")
    assert(arm64.sub_reg(32, 0, 1, 2, 31) == 0x4b027c20, "sub w0, w1, w2, lsl #31")
    assert(arm64.and_reg(32, 0, 1, 2) == 0x0a020020, "and w0, w1, w2")
    assert(arm64.orr_reg(32, 0, 1, 2) == 0x2a020020, "orr w0, w1, w2")
    assert(arm64.eor_reg(32, 0, 1, 2) == 0x4a020020, "eor w0, w1, w2")
    assert(arm64.lslv(32, 0, 1, 2) == 0x1ac22020, "lslv w0, w1, w2")
    assert(arm64.lsrv(32, 0, 1, 2) == 0x1ac22420, "lsrv w0, w1, w2")
    assert(arm64.asrv(32, 0, 1, 2) == 0x1ac22820, "asrv w0, w1, w2")
    assert(arm64.udiv(32, 0, 1, 2) == 0x1ac20820, "udiv w0, w1, w2")
    assert(arm64.sdiv(32, 0, 1, 2) == 0x1ac20c20, "sdiv w0, w1, w2")
    assert(arm64.mov_reg(32, 0, 2) == 0x2a0203e0, "mov w0, w2")
    assert(arm64.mvn(32, 0, 2) == 0x2a2203e0, "mvn w0, w2")
    assert(arm64.madd(32, 0, 1, 2, 15) == 0x1b023c20, "madd w0, w1, w2, w15")
    assert(arm64.msub(32, 0, 1, 2, 15) == 0x1b02bc20, "msub w0, w1, w2, w15")
    assert(arm64.ubfm(32, 0, 1, 0, 31) == 0x53007c20, "ubfm w0, w1, #0, #31")
    assert(arm64.ubfm(32, 0, 1, 31, 0) == 0x531f0020, "ubfm w0, w1, #31, #0")
    assert(arm64.ubfm(32, 0, 1, 7, 15) == 0x53073c20, "ubfm w0, w1, #7, #15")
    assert(arm64.sbfm(32, 0, 1, 0, 31) == 0x13007c20, "sbfm w0, w1, #0, #31")
    assert(arm64.sbfm(32, 0, 1, 31, 0) == 0x131f0020, "sbfm w0, w1, #31, #0")
    assert(arm64.sbfm(32, 0, 1, 7, 15) == 0x13073c20, "sbfm w0, w1, #7, #15")
    assert(arm64.add_reg(32, 30, 15, 31, 0) == 0x0b1f01fe, "add w30, w15, wzr, lsl #0")
    assert(arm64.add_reg(32, 30, 15, 31, 31) == 0x0b1f7dfe, "add w30, w15, wzr, lsl #31")
    assert(arm64.sub_reg(32, 30, 15, 31, 0) == 0x4b1f01fe, "sub w30, w15, wzr, lsl #0")
    assert(arm64.sub_reg(32, 30, 15, 31, 31) == 0x4b1f7dfe, "sub w30, w15, wzr, lsl #31")
    assert(arm64.and_reg(32, 30, 15, 31) == 0x0a1f01fe, "and w30, w15, wzr")
    assert(arm64.orr_reg(32, 30, 15, 31) == 0x2a1f01fe, "orr w30, w15, wzr")
    assert(arm64.eor_reg(32, 30, 15, 31) == 0x4a1f01fe, "eor w30, w15, wzr")
    assert(arm64.lslv(32, 30, 15, 31) == 0x1adf21fe, "lslv w30, w15, wzr")
    assert(arm64.lsrv(32, 30, 15, 31) == 0x1adf25fe, "lsrv w30, w15, wzr")
    assert(arm64.asrv(32, 30, 15, 31) == 0x1adf29fe, "asrv w30, w15, wzr")
    assert(arm64.udiv(32, 30, 15, 31) == 0x1adf09fe, "udiv w30, w15, wzr")
    assert(arm64.sdiv(32, 30, 15, 31) == 0x1adf0dfe, "sdiv w30, w15, wzr")
    assert(arm64.mov_reg(32, 30, 31) == 0x2a1f03fe, "mov w30, wzr")
    assert(arm64.mvn(32, 30, 31) == 0x2a3f03fe, "mvn w30, wzr")
    assert(arm64.madd(32, 30, 15, 31, 15) == 0x1b1f3dfe, "madd w30, w15, wzr, w15")
    assert(arm64.msub(32, 30, 15, 31, 15) == 0x1b1fbdfe, "msub w30, w15, wzr, w15")
    assert(arm64.ubfm(32, 30, 15, 0, 31) == 0x53007dfe, "ubfm w30, w15, #0, #31")
    assert(arm64.ubfm(32, 30, 15, 31, 0) == 0x531f01fe, "ubfm w30, w15, #31, #0")
    assert(arm64.ubfm(32, 30, 15, 7, 15) == 0x53073dfe, "ubfm w30, w15, #7, #15")
    assert(arm64.sbfm(32, 30, 15, 0, 31) == 0x13007dfe, "sbfm w30, w15, #0, #31")
    assert(arm64.sbfm(32, 30, 15, 31, 0) == 0x131f01fe, "sbfm w30, w15, #31, #0")
    assert(arm64.sbfm(32, 30, 15, 7, 15) == 0x13073dfe, "sbfm w30, w15, #7, #15")
    assert(arm64.add_reg(32, 31, 31, 0, 0) == 0x0b0003ff, "add wzr, wzr, w0, lsl #0")
    assert(arm64.add_reg(32, 31, 31, 0, 31) == 0x0b007fff, "add wzr, wzr, w0, lsl #31")
    assert(arm64.sub_reg(32, 31, 31, 0, 0) == 0x4b0003ff, "sub wzr, wzr, w0, lsl #0")
    assert(arm64.sub_reg(32, 31, 31, 0, 31) == 0x4b007fff, "sub wzr, wzr, w0, lsl #31")
    assert(arm64.and_reg(32, 31, 31, 0) == 0x0a0003ff, "and wzr, wzr, w0")
    assert(arm64.orr_reg(32, 31, 31, 0) == 0x2a0003ff, "orr wzr, wzr, w0")
    assert(arm64.eor_reg(32, 31, 31, 0) == 0x4a0003ff, "eor wzr, wzr, w0")
    assert(arm64.lslv(32, 31, 31, 0) == 0x1ac023ff, "lslv wzr, wzr, w0")
    assert(arm64.lsrv(32, 31, 31, 0) == 0x1ac027ff, "lsrv wzr, wzr, w0")
    assert(arm64.asrv(32, 31, 31, 0) == 0x1ac02bff, "asrv wzr, wzr, w0")
    assert(arm64.udiv(32, 31, 31, 0) == 0x1ac00bff, "udiv wzr, wzr, w0")
    assert(arm64.sdiv(32, 31, 31, 0) == 0x1ac00fff, "sdiv wzr, wzr, w0")
    assert(arm64.mov_reg(32, 31, 0) == 0x2a0003ff, "mov wzr, w0")
    assert(arm64.mvn(32, 31, 0) == 0x2a2003ff, "mvn wzr, w0")
    assert(arm64.madd(32, 31, 31, 0, 15) == 0x1b003fff, "madd wzr, wzr, w0, w15")
    assert(arm64.msub(32, 31, 31, 0, 15) == 0x1b00bfff, "msub wzr, wzr, w0, w15")
    assert(arm64.ubfm(32, 31, 31, 0, 31) == 0x53007fff, "ubfm wzr, wzr, #0, #31")
    assert(arm64.ubfm(32, 31, 31, 31, 0) == 0x531f03ff, "ubfm wzr, wzr, #31, #0")
    assert(arm64.ubfm(32, 31, 31, 7, 15) == 0x53073fff, "ubfm wzr, wzr, #7, #15")
    assert(arm64.sbfm(32, 31, 31, 0, 31) == 0x13007fff, "sbfm wzr, wzr, #0, #31")
    assert(arm64.sbfm(32, 31, 31, 31, 0) == 0x131f03ff, "sbfm wzr, wzr, #31, #0")
    assert(arm64.sbfm(32, 31, 31, 7, 15) == 0x13073fff, "sbfm wzr, wzr, #7, #15")
    assert(arm64.cmp_reg(32, 0, 31) == 0x6b1f001f, "cmp w0, wzr")
    assert(arm64.cmp_reg(32, 30, 15) == 0x6b0f03df, "cmp w30, w15")
    assert(arm64.cmp_reg(32, 31, 0) == 0x6b0003ff, "cmp wzr, w0")
    assert(arm64.add_imm(32, 0, 31, 0, 0) == 0x110003e0, "add w0, wsp, #0, lsl #0")
    assert(arm64.sub_imm(32, 0, 31, 0, 0) == 0x510003e0, "sub w0, wsp, #0, lsl #0")
    assert(arm64.cmp_imm(32, 31, 0, 0) == 0x710003ff, "cmp wsp, #0, lsl #0")
    assert(arm64.add_imm(32, 0, 31, 4095, 0) == 0x113fffe0, "add w0, wsp, #4095, lsl #0")
    assert(arm64.sub_imm(32, 0, 31, 4095, 0) == 0x513fffe0, "sub w0, wsp, #4095, lsl #0")
    assert(arm64.cmp_imm(32, 31, 4095, 0) == 0x713fffff, "cmp wsp, #4095, lsl #0")
    assert(arm64.add_imm(32, 0, 31, 1, 1) == 0x114007e0, "add w0, wsp, #1, lsl #12")
    assert(arm64.sub_imm(32, 0, 31, 1, 1) == 0x514007e0, "sub w0, wsp, #1, lsl #12")
    assert(arm64.cmp_imm(32, 31, 1, 1) == 0x714007ff, "cmp wsp, #1, lsl #12")
    assert(arm64.add_imm(32, 0, 31, 4095, 1) == 0x117fffe0, "add w0, wsp, #4095, lsl #12")
    assert(arm64.sub_imm(32, 0, 31, 4095, 1) == 0x517fffe0, "sub w0, wsp, #4095, lsl #12")
    assert(arm64.cmp_imm(32, 31, 4095, 1) == 0x717fffff, "cmp wsp, #4095, lsl #12")
    assert(arm64.add_imm(32, 31, 15, 0, 0) == 0x110001ff, "add wsp, w15, #0, lsl #0")
    assert(arm64.sub_imm(32, 31, 15, 0, 0) == 0x510001ff, "sub wsp, w15, #0, lsl #0")
    assert(arm64.cmp_imm(32, 15, 0, 0) == 0x710001ff, "cmp w15, #0, lsl #0")
    assert(arm64.add_imm(32, 31, 15, 4095, 0) == 0x113ffdff, "add wsp, w15, #4095, lsl #0")
    assert(arm64.sub_imm(32, 31, 15, 4095, 0) == 0x513ffdff, "sub wsp, w15, #4095, lsl #0")
    assert(arm64.cmp_imm(32, 15, 4095, 0) == 0x713ffdff, "cmp w15, #4095, lsl #0")
    assert(arm64.add_imm(32, 31, 15, 1, 1) == 0x114005ff, "add wsp, w15, #1, lsl #12")
    assert(arm64.sub_imm(32, 31, 15, 1, 1) == 0x514005ff, "sub wsp, w15, #1, lsl #12")
    assert(arm64.cmp_imm(32, 15, 1, 1) == 0x714005ff, "cmp w15, #1, lsl #12")
    assert(arm64.add_imm(32, 31, 15, 4095, 1) == 0x117ffdff, "add wsp, w15, #4095, lsl #12")
    assert(arm64.sub_imm(32, 31, 15, 4095, 1) == 0x517ffdff, "sub wsp, w15, #4095, lsl #12")
    assert(arm64.cmp_imm(32, 15, 4095, 1) == 0x717ffdff, "cmp w15, #4095, lsl #12")
    assert(arm64.add_imm(32, 30, 0, 0, 0) == 0x1100001e, "add w30, w0, #0, lsl #0")
    assert(arm64.sub_imm(32, 30, 0, 0, 0) == 0x5100001e, "sub w30, w0, #0, lsl #0")
    assert(arm64.cmp_imm(32, 0, 0, 0) == 0x7100001f, "cmp w0, #0, lsl #0")
    assert(arm64.add_imm(32, 30, 0, 4095, 0) == 0x113ffc1e, "add w30, w0, #4095, lsl #0")
    assert(arm64.sub_imm(32, 30, 0, 4095, 0) == 0x513ffc1e, "sub w30, w0, #4095, lsl #0")
    assert(arm64.cmp_imm(32, 0, 4095, 0) == 0x713ffc1f, "cmp w0, #4095, lsl #0")
    assert(arm64.add_imm(32, 30, 0, 1, 1) == 0x1140041e, "add w30, w0, #1, lsl #12")
    assert(arm64.sub_imm(32, 30, 0, 1, 1) == 0x5140041e, "sub w30, w0, #1, lsl #12")
    assert(arm64.cmp_imm(32, 0, 1, 1) == 0x7140041f, "cmp w0, #1, lsl #12")
    assert(arm64.add_imm(32, 30, 0, 4095, 1) == 0x117ffc1e, "add w30, w0, #4095, lsl #12")
    assert(arm64.sub_imm(32, 30, 0, 4095, 1) == 0x517ffc1e, "sub w30, w0, #4095, lsl #12")
    assert(arm64.cmp_imm(32, 0, 4095, 1) == 0x717ffc1f, "cmp w0, #4095, lsl #12")
    assert(arm64.movz(32, 0, 0, 0) == 0x52800000, "movz w0, #0, lsl #0")
    assert(arm64.movz(32, 30, 65535, 1) == 0x52bffffe, "movz w30, #65535, lsl #16")
    assert(arm64.movz(32, 31, 32768, 1) == 0x52b0001f, "movz wzr, #32768, lsl #16")
    assert(arm64.movn(32, 0, 0, 0) == 0x12800000, "movn w0, #0, lsl #0")
    assert(arm64.movn(32, 30, 65535, 1) == 0x12bffffe, "movn w30, #65535, lsl #16")
    assert(arm64.movn(32, 31, 32768, 1) == 0x12b0001f, "movn wzr, #32768, lsl #16")
    assert(arm64.movk(32, 0, 0, 0) == 0x72800000, "movk w0, #0, lsl #0")
    assert(arm64.movk(32, 30, 65535, 1) == 0x72bffffe, "movk w30, #65535, lsl #16")
    assert(arm64.movk(32, 31, 32768, 1) == 0x72b0001f, "movk wzr, #32768, lsl #16")
    assert(arm64.csel(32, 0, 30, 31, 0) == 0x1a9f03c0, "csel w0, w30, wzr, eq")
    assert(arm64.ccmp_reg(32, 30, 31, 15, 0) == 0x7a5f03cf, "ccmp w30, wzr, #15, eq")
    assert(arm64.cset(32, 30, 0) == 0x1a9f17fe, "cset w30, eq")
    assert(arm64.csel(32, 0, 30, 31, 1) == 0x1a9f13c0, "csel w0, w30, wzr, ne")
    assert(arm64.ccmp_reg(32, 30, 31, 15, 1) == 0x7a5f13cf, "ccmp w30, wzr, #15, ne")
    assert(arm64.cset(32, 30, 1) == 0x1a9f07fe, "cset w30, ne")
    assert(arm64.csel(32, 0, 30, 31, 2) == 0x1a9f23c0, "csel w0, w30, wzr, hs")
    assert(arm64.ccmp_reg(32, 30, 31, 15, 2) == 0x7a5f23cf, "ccmp w30, wzr, #15, hs")
    assert(arm64.cset(32, 30, 2) == 0x1a9f37fe, "cset w30, hs")
    assert(arm64.csel(32, 0, 30, 31, 3) == 0x1a9f33c0, "csel w0, w30, wzr, lo")
    assert(arm64.ccmp_reg(32, 30, 31, 15, 3) == 0x7a5f33cf, "ccmp w30, wzr, #15, lo")
    assert(arm64.cset(32, 30, 3) == 0x1a9f27fe, "cset w30, lo")
    assert(arm64.csel(32, 0, 30, 31, 4) == 0x1a9f43c0, "csel w0, w30, wzr, mi")
    assert(arm64.ccmp_reg(32, 30, 31, 15, 4) == 0x7a5f43cf, "ccmp w30, wzr, #15, mi")
    assert(arm64.cset(32, 30, 4) == 0x1a9f57fe, "cset w30, mi")
    assert(arm64.csel(32, 0, 30, 31, 5) == 0x1a9f53c0, "csel w0, w30, wzr, pl")
    assert(arm64.ccmp_reg(32, 30, 31, 15, 5) == 0x7a5f53cf, "ccmp w30, wzr, #15, pl")
    assert(arm64.cset(32, 30, 5) == 0x1a9f47fe, "cset w30, pl")
    assert(arm64.csel(32, 0, 30, 31, 6) == 0x1a9f63c0, "csel w0, w30, wzr, vs")
    assert(arm64.ccmp_reg(32, 30, 31, 15, 6) == 0x7a5f63cf, "ccmp w30, wzr, #15, vs")
    assert(arm64.cset(32, 30, 6) == 0x1a9f77fe, "cset w30, vs")
    assert(arm64.csel(32, 0, 30, 31, 7) == 0x1a9f73c0, "csel w0, w30, wzr, vc")
    assert(arm64.ccmp_reg(32, 30, 31, 15, 7) == 0x7a5f73cf, "ccmp w30, wzr, #15, vc")
    assert(arm64.cset(32, 30, 7) == 0x1a9f67fe, "cset w30, vc")
    assert(arm64.csel(32, 0, 30, 31, 8) == 0x1a9f83c0, "csel w0, w30, wzr, hi")
    assert(arm64.ccmp_reg(32, 30, 31, 15, 8) == 0x7a5f83cf, "ccmp w30, wzr, #15, hi")
    assert(arm64.cset(32, 30, 8) == 0x1a9f97fe, "cset w30, hi")
    assert(arm64.csel(32, 0, 30, 31, 9) == 0x1a9f93c0, "csel w0, w30, wzr, ls")
    assert(arm64.ccmp_reg(32, 30, 31, 15, 9) == 0x7a5f93cf, "ccmp w30, wzr, #15, ls")
    assert(arm64.cset(32, 30, 9) == 0x1a9f87fe, "cset w30, ls")
    assert(arm64.csel(32, 0, 30, 31, 10) == 0x1a9fa3c0, "csel w0, w30, wzr, ge")
    assert(arm64.ccmp_reg(32, 30, 31, 15, 10) == 0x7a5fa3cf, "ccmp w30, wzr, #15, ge")
    assert(arm64.cset(32, 30, 10) == 0x1a9fb7fe, "cset w30, ge")
    assert(arm64.csel(32, 0, 30, 31, 11) == 0x1a9fb3c0, "csel w0, w30, wzr, lt")
    assert(arm64.ccmp_reg(32, 30, 31, 15, 11) == 0x7a5fb3cf, "ccmp w30, wzr, #15, lt")
    assert(arm64.cset(32, 30, 11) == 0x1a9fa7fe, "cset w30, lt")
    assert(arm64.csel(32, 0, 30, 31, 12) == 0x1a9fc3c0, "csel w0, w30, wzr, gt")
    assert(arm64.ccmp_reg(32, 30, 31, 15, 12) == 0x7a5fc3cf, "ccmp w30, wzr, #15, gt")
    assert(arm64.cset(32, 30, 12) == 0x1a9fd7fe, "cset w30, gt")
    assert(arm64.csel(32, 0, 30, 31, 13) == 0x1a9fd3c0, "csel w0, w30, wzr, le")
    assert(arm64.ccmp_reg(32, 30, 31, 15, 13) == 0x7a5fd3cf, "ccmp w30, wzr, #15, le")
    assert(arm64.cset(32, 30, 13) == 0x1a9fc7fe, "cset w30, le")
    assert(arm64.csel(32, 0, 30, 31, 14) == 0x1a9fe3c0, "csel w0, w30, wzr, al")
    assert(arm64.ccmp_reg(32, 30, 31, 15, 14) == 0x7a5fe3cf, "ccmp w30, wzr, #15, al")
    assert(arm64.csel(32, 0, 30, 31, 15) == 0x1a9ff3c0, "csel w0, w30, wzr, nv")
    assert(arm64.ccmp_reg(32, 30, 31, 15, 15) == 0x7a5ff3cf, "ccmp w30, wzr, #15, nv")
    assert(arm64.cbz(32, 0, 0) == 0x34000000, "cbz w0, #0")
    assert(arm64.cbz(32, 30, -1048576) == 0x3480001e, "cbz w30, #-1048576")
    assert(arm64.cbz(32, 31, 1048572) == 0x347fffff, "cbz wzr, #1048572")
    assert(arm64.cbnz(32, 0, 0) == 0x35000000, "cbnz w0, #0")
    assert(arm64.cbnz(32, 30, -1048576) == 0x3580001e, "cbnz w30, #-1048576")
    assert(arm64.cbnz(32, 31, 1048572) == 0x357fffff, "cbnz wzr, #1048572")
    assert(arm64.add_reg(64, 0, 1, 2, 0) == 0x8b020020, "add x0, x1, x2, lsl #0")
    assert(arm64.add_reg(64, 0, 1, 2, 63) == 0x8b02fc20, "add x0, x1, x2, lsl #63")
    assert(arm64.sub_reg(64, 0, 1, 2, 0) == 0xcb020020, "sub x0, x1, x2, lsl #0")
    assert(arm64.sub_reg(64, 0, 1, 2, 63) == 0xcb02fc20, "sub x0, x1, x2, lsl #63")
    assert(arm64.and_reg(64, 0, 1, 2) == 0x8a020020, "and x0, x1, x2")
    assert(arm64.orr_reg(64, 0, 1, 2) == 0xaa020020, "orr x0, x1, x2")
    assert(arm64.eor_reg(64, 0, 1, 2) == 0xca020020, "eor x0, x1, x2")
    assert(arm64.lslv(64, 0, 1, 2) == 0x9ac22020, "lslv x0, x1, x2")
    assert(arm64.lsrv(64, 0, 1, 2) == 0x9ac22420, "lsrv x0, x1, x2")
    assert(arm64.asrv(64, 0, 1, 2) == 0x9ac22820, "asrv x0, x1, x2")
    assert(arm64.udiv(64, 0, 1, 2) == 0x9ac20820, "udiv x0, x1, x2")
    assert(arm64.sdiv(64, 0, 1, 2) == 0x9ac20c20, "sdiv x0, x1, x2")
    assert(arm64.mov_reg(64, 0, 2) == 0xaa0203e0, "mov x0, x2")
    assert(arm64.mvn(64, 0, 2) == 0xaa2203e0, "mvn x0, x2")
    assert(arm64.madd(64, 0, 1, 2, 15) == 0x9b023c20, "madd x0, x1, x2, x15")
    assert(arm64.msub(64, 0, 1, 2, 15) == 0x9b02bc20, "msub x0, x1, x2, x15")
    assert(arm64.ubfm(64, 0, 1, 0, 63) == 0xd340fc20, "ubfm x0, x1, #0, #63")
    assert(arm64.ubfm(64, 0, 1, 63, 0) == 0xd37f0020, "ubfm x0, x1, #63, #0")
    assert(arm64.ubfm(64, 0, 1, 7, 15) == 0xd3473c20, "ubfm x0, x1, #7, #15")
    assert(arm64.sbfm(64, 0, 1, 0, 63) == 0x9340fc20, "sbfm x0, x1, #0, #63")
    assert(arm64.sbfm(64, 0, 1, 63, 0) == 0x937f0020, "sbfm x0, x1, #63, #0")
    assert(arm64.sbfm(64, 0, 1, 7, 15) == 0x93473c20, "sbfm x0, x1, #7, #15")
