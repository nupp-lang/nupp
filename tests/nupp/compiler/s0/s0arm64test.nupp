    assert(arm64.orr_imm(32, 0, 30, 0, 1, 1) == 0x320107c0, "orr w0, w30, #0x80000001")
    assert(arm64.orr_imm(32, 30, 31, 0, 1, 1) == 0x320107fe, "orr w30, wzr, #0x80000001")
    assert(arm64.orr_imm(32, 31, 0, 0, 1, 1) == 0x3201041f, "orr wsp, w0, #0x80000001")
