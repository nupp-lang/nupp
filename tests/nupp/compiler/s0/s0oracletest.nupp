-- The owned backend's reference interpreter (nupp.compiler.s0.oracle).
module nupp.compiler.s0.s0oracletest

local ir = require("nupp.compiler.s0.ir")
local reader = require("nupp.compiler.s0.reader")
local oracle = require("nupp.compiler.s0.oracle")

local function memory(): oracle.Memory
    local bytes: {integer} = {}
    for i = 1, 128 do
        bytes[i] = 0
    end

    return oracle.Memory(bytes = bytes, stackBase = 64)
end

local function hooks(): oracle.Hooks
    return oracle.Hooks(call = nil, fma64 = nil)
end

local function operation(row: {integer}): ir.Function
    local op, kind, operand, aux, imm, argc = row[1], row[2], row[3], row[4], row[5], row[8]
    local params: {integer} = {}
    for i = 1, argc do
        params[i] = operand
    end
    local f = ir.new("vector", ir.Signature(params = params, results = {kind}, convention = ir.INTERNAL))
    f.blockStart[1], f.firstParam[1], f.nparams[1] = 1, 1, argc
    for i = 1, argc do
        ir.value(f, i, operand, -1);
        f.params[i] = i
    end
    local args: {integer} = {}
    for i = 1, argc do
        args[i] = i
    end
    ir.instruction(f, op, argc + 1, kind, args, imm, aux)
    ir.instruction(f, ir.opcode("return"), 0, 0, {argc + 1}, 0, 0)
    f.blockEnd[1] = #f.op

    return f
end

export function cases(): string
    local function run(text: string, args: {integer}, mem: oracle.Memory, h: oracle.Hooks, fuel: integer): oracle.Result
        return oracle.run(reader.read(text)[1], args, mem, h, fuel)
    end

    local mem, h = memory(), hooks()
    local memoryCode = [[
function %memory(i64) -> i64 tail {
    ss0 = explicit_slot 16, align = 16
block0(v0: i64):
    v1 = stack_addr.i64 ss0
    store v0, v1
    v2 = load.i64 v1
    return v2
}
]]
    local one: int64 = 1
    local x: int64 = one << 63
    assert(run(memoryCode, {x}, mem, h, 10).word == x and mem.bytes[72] == 128)
    mem.stackBase = 127
    assert(run(memoryCode, {x}, mem, h, 10).status == oracle.BOUNDS)
    mem = memory()
    local signedLoad = [[
function %signed() -> i64 tail {
block0:
    v0 = iconst.i64 0
    v1 = sload8.i64 v0
    return v1
}
]]
    mem.bytes[1] = 255
    assert(run(signedLoad, {}, mem, h, 10).word == -1)
    mem.bytes[1] = 256
    assert(run(signedLoad, {}, mem, h, 10).status == oracle.INVALID)
    local overflow = operation({ir.opcode("load"), ir.I64, ir.I64, 0, x, 0, 0, 1, 0})
    assert(oracle.run(overflow, {x}, memory(), hooks(), 10).status == oracle.BOUNDS)
    local invalidAlign = reader.read(memoryCode)[1]
    invalidAlign.stackAlign[1] = 3
    assert(oracle.run(invalidAlign, {x}, memory(), hooks(), 10).status == oracle.INVALID)
    local select = [[
function %select(i64, i64, i64) -> i64 tail {
block0(v0: i64, v1: i64, v2: i64):
    v3 = select v0, v1, v2
    return v3
}
]]
    assert(run(select, {1, 42, 99}, memory(), h, 10).word == 42)
    assert(run(select, {0, 42, 99}, memory(), h, 10).word == 99)
    local loop = [[
function %loop(i64, i64, i64) -> i64 tail {
block0(v0: i64, v1: i64, v2: i64):
    jump block1(v0, v1, v2)
block1(v3: i64, v4: i64, v5: i64):
    v6 = iconst.i64 1
    v7 = isub v5, v6
    brif v7, block1(v4, v3, v7), block2(v3)
block2(v8: i64):
    return v8
}
]]
    assert(run(loop, {11, 22, 4}, memory(), h, 30).word == 22)
    assert(run(loop, {11, 22, 100}, memory(), h, 5).status == oracle.FUEL)
    local trap = [[
function %trap() tail {
block0:
    trap user7
}
]]
    local result = run(trap, {}, memory(), h, 1)
    assert(result.status == oracle.TRAP and result.word == 7)
    for _, op in ipairs({"call", "call_indirect", "return_call", "return_call_indirect"}) do
        local indirect = op:find("indirect") ~= nil
        local expression = op .. (indirect and " sig0, v0(v1)" or " fn0(v1)")
        local code = (
            "function %%caller(i64, i64) -> i64 tail {\n sig0 = (i64) -> i64 tail\n fn0 = %%test sig0\nblock0(v0: i64, v1: i64):\n %s\n}\n"
        ):format(op:sub(1, 6) == "return" and expression or "v2 = " .. expression .. "\n return v2")
        assert(run(code, {123, 42}, memory(), hooks(), 10).status == oracle.UNSUPPORTED)
        h.call = function(id: integer, address: integer, passed: {integer}): (integer, integer, integer)
            assert(id == (indirect and 0 or 1) and address == (indirect and 123 or 0) and passed[1] == 42)
            return oracle.OK, passed[1] + 1, 0
        end
        assert(run(code, {123, 42}, memory(), h, 10).word == 43)
    end
    local fma = operation({ir.opcode("fma"), ir.F64, ir.F64, 0, 0, 0, 0, 3, 0})
    assert(oracle.run(fma, {0, 0, 0}, memory(), hooks(), 10).status == oracle.UNSUPPORTED)
    local pair = [[
function %pair(i64, i64, i64) -> (i64, i64) tail {
    sig0 = (i64, i64) -> (i64, i64) tail
block0(v0: i64, v1: i64, v2: i64):
    v3, v4 = call_indirect sig0, v0(v1, v2)
    return v4, v3
}
]]
    h.call = function(id: integer, address: integer, passed: {integer}): (integer, integer, integer)
        assert(id == 0 and address == 123)
        return oracle.OK, passed[1] + 10, passed[2] + 20
    end
    result = run(pair, {123, 1, 2}, memory(), h, 10)
    assert(result.status == oracle.OK and result.word == 22 and result.word2 == 11)
    assert(not oracle.equivalent(0, x, ir.F64))

    return "memory, stack alignment, select, branches, fuel, traps and injected call cases passed"
end
