-- The owned backend's textual IR reader (nupp.compiler.s0.reader).
module nupp.compiler.s0.s0readertest

local reader = require("nupp.compiler.s0.reader")
local ir = require("nupp.compiler.s0.ir")

local function constant(kind: string, text: string): integer
    local functions = reader.read(
        ([[
function %%constant() -> %s tail {
block0:
    v0 = %sconst %s
    return v0
}
]]):format(kind, kind, text)
    )
    return functions[1].imm[1]
end

export function readerCases(): string
    assert(reader.integer("0xffffffffffffffff") == -1)
    assert(reader.integer("0x8000000000000000") == -9223372036854775808)
    assert(reader.integer("18446744073709551615") == -1)
    assert(reader.integer("9007199254740993") == 9007199254740993)
    assert(not pcall(reader.integer, "18446744073709551616"))
    assert(not pcall(reader.integer, "0x10000000000000000"))
    assert(not pcall(reader.integer, "12z"))
    assert(constant("f64", "0.0") == 0)
    assert(constant("f64", "-0.0") == reader.integer("0x8000000000000000"))
    assert(constant("f64", "1.5") == reader.integer("0x3ff8000000000000"))
    assert(constant("f64", "0x1.0000000000000p64") == reader.integer("0x43f0000000000000"))
    assert(constant("f64", "0x0.0000000000001p-1022") == 1)
    assert(constant("f64", "0x1.fffffffffffffp1023") == reader.integer("0x7fefffffffffffff"))
    assert(constant("f64", "+Inf") == reader.integer("0x7ff0000000000000"))
    assert(constant("f64", "-Inf") == reader.integer("0xfff0000000000000"))
    assert(constant("f64", "+NaN") == reader.integer("0x7ff8000000000000"))
    assert(constant("f32", "0x1p-149") == 1)
    assert(constant("f32", "0x1.fffffep127") == 0x7f7fffff)
    assert(constant("f32", "0x1.000001p0") == 0x3f800000)
    assert(constant("f32", "0x1.000003p0") == 0x3f800002)
    local functions = reader.read(
        [[
function %loop(i64) -> i64 tail {
block0(v0: i64):
    v1 = iconst.i64 1
    jump block1(v0)
block1(v2: i64):
    v3 = iadd v2, v1
    v4 = icmp ult v3, v0
    brif v4, block1(v3), block2(v3)
block2(v5: i64):
    return v5
}
]]
    )
    local f = functions[1]
    assert(#functions == 1 and #f.op == 6 and #f.blockStart == 3)
    assert(f.op[3] == ir.opcode("iadd") and f.kind[3] == ir.I64)
    assert(#f.edgeTarget == 3 and f.edgeTarget[2] == 2)
    assert(f.valueKinds[5] == ir.I8)

    local pair = reader.read(
        [[
function %caller(i64) -> i64, i64 {
    sig0 = (i64) -> i64, i64
    fn0 = %callee sig0
block0(v0: i64):
    v1, v2 = call fn0(v0)
    return v1, v2
}
function %callee(i64) -> i64, i64 {
block0(v0: i64):
    return v0, v0
}
]]
    )
    assert(pair[1].result[1] == 2 and pair[1].result2[1] == 3)
    assert(pair[1].kind2[1] == ir.I64 and pair[1].definitions[3] == 1)
    assert(pair[1].signatures[pair[1].importSignatures[1]].convention == ir.INTERNAL)

    return "S0 reader cases passed"
end
