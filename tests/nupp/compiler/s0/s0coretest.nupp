module nupp.compiler.s0.s0coretest

local reader = require("nupp.compiler.s0.reader")
local bound = require("nupp.compiler.s0.corebound")
local allocate = require("nupp.compiler.s0.allocate")
local check = require("nupp.compiler.s0.allocationcheck")
local selector = require("nupp.compiler.s0.select")
local core = require("nupp.compiler.s0.core")

export function bundle(corpus: string, metadata: string, directory: string, digest: string): string
    return core.bundle(corpus, metadata, directory, digest)
end

export function cases(): string
    local tails = [[
function %a() -> i64 tail {
    sig0 = () -> i64 tail
    fn0 = %b sig0
block0:
    return_call fn0()
}
function %b() -> i64 tail {
    sig0 = () -> i64 tail
    fn0 = %a sig0
block0:
    return_call fn0()
}
]]
    assert(bound.extent(reader.read(tails), {256, 512}, {}, {}) == 4096)
    local recursive = tails:gsub("return_call fn0%(%)", "v0 = call fn0()\n    return v0", 1)
    local ok, reason = pcall(bound.extent, reader.read(recursive), {256, 512}, {}, {})
    assert(not ok and tostring(reason):find("positive%-growth cycle a %-> b"))
    local dispatch = [[
function %dispatch(i64, i64, i64, i64, i64, i64) -> i64 tail {
    sig0 = (i64, i64, i64, i64, i64, i64) -> i64 tail
block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i64):
    jump block1(v5)
block1(v6: i64):
    v7 = uload8.i64 v0
    v8 = iconst.i64 3
    v9 = ishl v7, v8
    v10 = iadd v6, v9
    v11 = load.i64 v10
    return_call_indirect sig0, v11(v0, v1, v2, v3, v4, v6)
}
]]
    assert(bound.extent(reader.read(dispatch), {512}, {1}, {}) == 4096)
    assert(not pcall(bound.extent, reader.read(dispatch), {512}, {1}, {1}))
    for _, mutation in ipairs({
        dispatch:gsub("uload8.i64", "load.i64"),
        dispatch:gsub("iconst.i64 3", "iconst.i64 4"),
        dispatch:gsub("iadd v6, v9", "iadd v4, v9"),
        dispatch:gsub("v4, v6%)", "v4, v4)"),
        dispatch:gsub("jump block1%(v5%)", "jump block1(v4)"),
        dispatch:gsub("load.i64 v10", "load.i64 v10+8"),
        (dispatch:gsub("return_call_indirect", "v12 = call_indirect"):gsub("\n}%s*$", "\n    return v12\n}\n"))
    }) do
        assert(not pcall(bound.extent, reader.read(mutation), {512}, {1}, {}), "S0 core: unsafe dispatch accepted")
    end
    local mixed = dispatch:gsub("jump block1%(v5%)", "v20 = icmp eq v0, v1\n    brif v20, block1(v5), block1(v4)")
    assert(not pcall(bound.extent, reader.read(mixed), {512}, {1}, {}))
    local forwarded = dispatch
        .. [[
function %forward(i64, i64) -> i64 tail {
    sig0 = (i64, i64, i64, i64, i64, i64) -> i64 tail
    fn0 = %dispatch sig0
block0(v0: i64, v1: i64):
    return_call fn0(v0, v0, v0, v0, v0, v1)
}
]]
    assert(bound.extent(reader.read(forwarded), {512, 256}, {1}, {}) == 4096)
    assert(not pcall(bound.extent, reader.read((forwarded:gsub("v0, v1%)", "v0, v0)"))), {512, 256}, {1}, {}))

    return "core extent: tail cycles, trusted dispatch, and 11 refusals passed"
end

export function allocations(path: string): string
    local file = assert(io.open(path, "rb"))
    local functions = reader.read(assert(file:read("*a")));
    file:close()
    for _, f in ipairs(functions) do
        local target = selector.target()
        assert(check.run(f, target, allocate.run(f, target)), f.name)
    end

    return ("%d core allocations checked"):format(#functions)
end
