module s0.framepairtests

local reader = require("s0.reader")
local allocate = require("s0.allocate")
local selector = require("s0.select")
local check = require("s0.allocationcheck")

export function audit(path: string): string
    local file = assert(io.open(path, "rb"))
    local functions = reader.read(assert(file:read("*a")))
    file:close()
    for _, mode in ipairs({"normal", "spill"}) do
        local pairs, edges, moves, scratchEdges = 0, 0, 0, 0
        for _, f in ipairs(functions) do
            local target = selector.target()
            if mode == "spill" then
                target.integerRegisters, target.floatRegisters = {}, {}
            end
            local a = allocate.run(f, target)
            assert(check.run(f, target, a))
            for e, first in ipairs(a.firstMove) do
                local last = first + a.nmoves[e] - 1
                local scratch = false
                for p = first, last do
                    scratch = scratch or a.moveSource[p] == 17 or a.moveTarget[p] == 17
                end
                moves = moves + a.nmoves[e]
                if scratch then
                    scratchEdges = scratchEdges + 1
                else
                    local p, count = first, 0
                    while p < last do
                        local source, destination = a.moveSource[p], a.moveTarget[p]
                        if source < 0
                            and destination < 0
                            and a.moveSource[p + 1] == source - 1
                            and a.moveTarget[p + 1] == destination - 1
                            and destination ~= source - 1
                            and source >= -62
                            and destination >= -62
                        then
                            count, p = count + 1, p + 2
                        else
                            p = p + 1
                        end
                    end
                    if count > 0 then
                        if pairs == 0 then
                            print(("sample\t%s\t%s\tedge%d\t%d pairs"):format(mode, f.name, e, count))
                        end
                        pairs, edges = pairs + count, edges + 1
                    end
                end
            end
        end
        print(
            (
                "%s\t%d functions\t%d pairs\t%d edges\t%d moves\t%d scratch edges"
            ):format(mode, #functions, pairs, edges, moves, scratchEdges)
        )
    end

    return "frame-copy consumer audit complete"
end

export function cases(): string
    local ir = require("s0.ir")
    local text = [[function %copies(i64) -> i64 tail {
block0(v0: i64):
    jump block1(v0)
block1(v1: i64):
    return v1
}
]]
    local count = 0

    local function prove(sources: {integer}, destinations: {integer}, kind: integer, expectedPairs: integer): nil
        local f = reader.read(text)[1]
        local a = allocate.run(f, selector.target())
        a.spillSlots, a.firstMove[1], a.nmoves[1] = 128, 1, #sources
        a.moveSource, a.moveTarget, a.moveKind = sources, destinations, {}
        for p = 1, #sources do
            a.moveKind[p] = kind
        end
        local memory: {integer} = {}
        local expected: {integer} = {}
        local regs: {[integer]: integer} = {}
        local expectedRegs: {[integer]: integer} = {}
        for slot = 1, 128 do
            memory[slot], expected[slot] = -slot * 0x102030405, -slot * 0x102030405
        end
        for reg = 0, 31 do
            regs[reg], expectedRegs[reg] = reg, reg
        end
        for p, source in ipairs(sources) do
            local value = source < 0 and expected[-source] or assert(expectedRegs[source - 1])
            local destination = destinations[p]
            if destination < 0 then
                expected[-destination] = value
            else
                expectedRegs[destination - 1] = value
            end
        end
        local code = selector.run(f, a)
        local pairs = 0
        for p = code.blockWord[1], code.blockWord[2] - 1 do
            local word = code.words[p]
            local op, rt, rn = word & 0xffc00000, word & 31, (word >> 5) & 31
            if op == 0xf9400000 or op == 0xf9000000 then
                assert(rn == 23)
                local slot = ((word >> 10) & 4095) - 1
                if op == 0xf9400000 then
                    regs[rt] = memory[slot]
                else
                    memory[slot] = assert(regs[rt])
                end
            elseif op == 0xa9400000 or op == 0xa9000000 then
                assert(rn == 23 and rt == 16 and ((word >> 10) & 31) == 17)
                local slot = ((word >> 15) & 127) - 1
                if op == 0xa9400000 then
                    regs[16], regs[17], pairs = memory[slot], memory[slot + 1], pairs + 1
                else
                    memory[slot], memory[slot + 1] = assert(regs[16]), assert(regs[17])
                end
            else
                error("unexpected frame-copy instruction " .. tostring(word))
            end
        end
        assert(pairs == expectedPairs, "pair count")
        for slot = 1, 128 do
            assert(memory[slot] == expected[slot], "frame-copy slot " .. tostring(slot))
        end
        count = count + 1
    end

    for _, kind in ipairs({ir.I8, ir.I16, ir.I32, ir.I64, ir.F32, ir.F64}) do
        prove({-1, -2}, {-4, -5}, kind, 1)
        prove({-2, -3}, {-1, -2}, kind, 1)
        prove({-1, -2}, {-2, -3}, kind, 0)
        prove({-2, -1}, {-5, -4}, kind, 0)
        prove({-1, -3}, {-4, -5}, kind, 0)
        prove({-1, -2}, {-4, -6}, kind, 0)
        prove({-62, -63}, {-60, -61}, kind, 1)
        prove({-63, -64}, {-60, -61}, kind, 0)
        prove({-60, -61}, {-63, -64}, kind, 0)
        prove({-1, -2, -3}, {-5, -6, -7}, kind, 1)
    end
    prove({-3, -1, -2, 17}, {17, -4, -5, -6}, ir.I64, 0)
    prove({-1, -2, 17}, {17, -1, -2}, ir.I64, 0)
    prove({-1, -2, -3}, {-4, -5, 17}, ir.I64, 0)

    return ("%d independent frame-copy sequence checks passed"):format(count)
end

export function prepare(directory: string, digest: string): string
    local link = require("s0.link")
    for _, name in ipairs({"copyi8", "copyi16", "copyi32", "copyi64", "copyf32", "copyf64"}) do
        local path = directory .. "/" .. name .. ".clif"
        local file = assert(io.open(path, "rb"))
        local f = reader.read(assert(file:read("*a")))[1]
        file:close()
        for _, mode in ipairs({"normal", "spill"}) do
            local target = selector.target()
            if mode == "spill" then
                target.integerRegisters, target.floatRegisters = {}, {}
            end
            local a = allocate.run(f, target)
            assert(check.run(f, target, a))
            local code = selector.run(f, a)
            local pairs = 0
            for _, word in ipairs(code.words) do
                if (word & 0xffc07fff) == 0xa94046f0 then
                    pairs = pairs + 1
                end
            end
            assert(mode == "normal" or pairs > 0, name .. ": forced-spill pair consumer")
            link.bundle(path, name, directory .. "/" .. mode .. "/" .. name, digest, mode)
        end
    end

    return "12 native frame-copy bundles prepared; six forced-spill consumers verified"
end
