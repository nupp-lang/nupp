module tests.fixtures.ecsderiveprovider

const derive = require("types.derive")
const types2 = require("types")

export sealed interface Value
end

@annotation(targets = {"record", "struct"})
export record ecsname
    name: string?
end

@comptime
export function Component(info: types.derive.Info): types.derive.Result<Value>
    return derive.implement{data = {ecs = {name = info.qualifiedName}}, initializer = true}
end

@comptime
export function StorageColumn(T: type): type
    if types2.describe(T).declarationKind == "struct" then
        return types2.carray(T)
    end
    return types2.array(T)
end

@comptime
export function Column(T: type): type
    return StorageColumn(T)
end

export function accepts<T is Value>(witness: Type<T>): Type<Value>
    return witness
end
