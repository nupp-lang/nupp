const derive2 = require("types.derive")

local M = {}

interface M.Contract
    value: function(self): string
end

@comptime
function M.bad(info: string): types.derive.Result<M.Contract>
    return derive2.implement{methods = {}}
end

function M.runtime(): string
    return "runtime"
end

@derive(M.runtime)
record M.Value
end

return M
