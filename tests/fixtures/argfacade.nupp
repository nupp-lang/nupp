const assert2 = require("assert")

local cli = require("io.cli")
const {type TokenKind, type DecodeError} = require("io.cli")

@derive(cli.arguments)
local record Options
    @cli(value = "NAME")
    name: string
end

local options: Options?, problem: DecodeError? = cli.parse(Options, {"--name", "Ada"})
assert2(problem == nil, problem and problem.message)
assert2(options ~= nil)
assert2(options.name == "Ada")
assert2(cli.args == rawget(_G, "arg"))
assert2(cli ~= cli.args)

local alias = require("io.cli")
local parser = alias.optparser({"--flag"})
local kind: TokenKind? = parser:next()
assert2(kind == alias.longoption)
assert2(parser:key() == "flag")

local localArg = {
    parse = function(): integer
        return 42
    end
}

local function ordinary(arg: {parse: function(): integer}): integer
    return arg.parse()
end

assert2(ordinary(localArg) == 42)
print("arg facade ok")
