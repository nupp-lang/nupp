const derive = require("types.derive")
const types2 = require("types")

local M = {}

interface M.Inspect
    inspect: function(self): string
    prefixed: function(self, prefix: string): string
    decorated: function(self): string
    firstField: function(self): string
    documentation: function(self): string

    function inspectKind(self): string
        return "record"
    end
end

function M.prefixRecord(prefix: string, names: {string}, values: {string}): string
    return prefix .. M.renderRecord(names, values)
end

function M.decorate(value: M.Inspect): string
    return "[" .. value:inspect() .. "]"
end

function M.consumeNames(names: {string}): string
    local first = names[1]
    names[1] = "changed"
    return first
end

function M.returnDocumentation(owner: string?, fields: {string}): string
    return (owner or "<none>") .. "\n-- fields --\n" .. table.concat(fields, "\n")
end

function M.renderRecord(names: {string}, values: {string}): string
    local parts = {}
    for index, name in ipairs(names) do
        parts[#parts + 1] = name .. "=" .. values[index]
    end

    return "{" .. table.concat(parts, ", ") .. "}"
end

@comptime
function M.derive(info: types.derive.Info): types.derive.Result<M.Inspect>
    if info.schema ~= 2 then
        return derive.error("Inspect needs derive input schema 2", info.reference)
    end
    if info.kind ~= "record" then
        return derive.error("Inspect can be derived only for records", info.reference)
    end
    local names = {}
    local values = {}
    local documentation = {}
    for _, field in ipairs(info.fields) do
        if field.readType == nil then
            return derive.error("Inspect requires readable fields", field.reference)
        end
        local redact = false
        for _, applied in ipairs(field.annotations) do
            if applied.name == "debug" then
                for _, argument in ipairs(applied.arguments) do
                    if argument.name == "redact" and argument.value == true then
                        redact = true
                    end
                end
            end
        end
        local kind = types2.kind(field.readType)
        local value
        if redact then
            value = derive.constant("<redacted>")
        elseif kind == "primitive" then
            value = derive.field(field)
        else
            if not derive.claims(field.readType, info.interfaceType) then
                return derive.error(
                    "Inspect requires primitive or recursively Inspect fields, got " .. tostring(kind),
                    field.reference
                )
            end
            value = derive.constant("<nested>")
        end
        names[#names + 1] = field.name
        values[#values + 1] = value
        documentation[#documentation + 1] = field.documentation or "<none>"
    end

    return derive.implement{
        methods = {
            inspect = derive.forward{
                helper = derive.helper(M, "renderRecord"),
                arguments = {derive.constant(names), derive.array(values),},
            },
            prefixed = derive.forward{
                helper = derive.helper(M, "prefixRecord"),
                arguments = {derive.argument("prefix"), derive.constant(names), derive.array(values),},
            },
            decorated = derive.forward{helper = derive.helper(M, "decorate"), arguments = {derive.receiver()},},
            firstField = derive.forward{
                helper = derive.helper(M, "consumeNames"),
                arguments = {derive.constant(names)},
            },
            documentation = derive.forward{
                helper = derive.helper(M, "returnDocumentation"),
                arguments = {derive.constant(info.documentation), derive.constant(documentation),},
            },
        },
    }
end

return M
