const assert2 = require("assert")

const derive2 = require("types.derive")

local M = {}

interface M.Named
    named: function(self): string
end

interface M.Labelled
    label: function(self): string
end

function M.nameValue(value: string): string
    return "name=" .. value
end

function M.genericLabel(): string
    return "generic"
end

@comptime
function M.deriveNamed(info: types.derive.Info): types.derive.Result<M.Named>
    local field = info.fields[1]
    if not field or field.name ~= "name" then
        return derive2.error("Named requires a first field named name", info.reference)
    end

    return derive2.implement{
        methods = {
            named = derive2.forward{helper = derive2.helper(M, "nameValue"), arguments = {derive2.field(field)},},
        },
    }
end

@comptime
function M.deriveLabelled(info: types.derive.Info): types.derive.Result<M.Labelled>
    return derive2.implement{
        methods = {label = derive2.forward{helper = derive2.helper(M, "genericLabel"), arguments = {},},},
    }
end

@derive(M.deriveNamed)
record M.Value
    name: string
end

local value = M.Value(name = "local")
assert2(value:named() == "name=local")

@derive(M.deriveLabelled)
record M.Box<T>
    value: T
end

local box = M.Box(value = "anything")
assert2(box:label() == "generic")

return M
