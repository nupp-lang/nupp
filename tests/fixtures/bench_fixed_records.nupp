-- A benchmark-protocol fixture with authored measurements: no workload is timed.
local json = require("serde.json")

local function option(name)
    for index = 1, #io.cli.args do
        if io.cli.args[index] == name then
            return io.cli.args[index + 1]
        end
    end
end

local listing = option("--cases-out")
local file = assert(io.open(listing or option("--out"), "wb"))
if listing then
    file:write(json.encodevalue({name = "fixed"}), "\n", json.encodevalue({name = "trend"}), "\n")
else
    local name = option("--case")
    file:write(
        json.encodevalue({
            cases = {
                {
                    name = name,
                    kind = "case",
                    n = 1,
                    rounds = 3,
                    medianMs = 0.25,
                    samplesMs = {0.25, 0.25, 0.25},
                    trend = name == "trend" and "trend" or "no-trend-detected",
                    trendDrift = name == "trend" and 0.5 or 0,
                    abortSites = {},
                }
            },
        })
    )
end
file:close()
