local inspect = require("tests.fixtures.deriveinspect")

--- Credentials used to authenticate.
---
--- Kept as a typed record.
@derive(inspect.derive, nupp.derive.Debug)
local record Credentials
    --- The public account name.
    username: string

    --- A secret value.
    @debug(redact = true)
    password: string
end

local credentials = new Credentials(username = "michael", password = "secret")
assert(credentials:inspect() == "{username=michael, password=<redacted>}")
assert(credentials:inspectKind() == "record")
assert(credentials:prefixed("credentials=") == "credentials={username=michael, password=<redacted>}")
assert(credentials:decorated() == "[{username=michael, password=<redacted>}]")
assert(credentials:firstField() == "username")
assert(
    credentials:documentation() == "Credentials used to authenticate.\n\nKept as a typed record.\n-- fields --\nThe public account name.\nA secret value."
)

@derive(inspect.derive)
local record Child
    name: string
end

@derive(inspect.derive)
local record Parent
    child: Child
end

local parent = new Parent(child = new Child(name = "nested"))
assert(parent:inspect() == "{child=<nested>}")
assert(credentials:firstField() == "username")
assert(parent:documentation() == "<none>\n-- fields --\n<none>")

-- Both providers have to observe the other's declaration-time claim before
-- either provider body has completed. The fields are intentionally not
-- instantiated: only the mutually recursive planning boundary is under test.
@derive(inspect.derive)
local record Left
    right: Right
end

@derive(inspect.derive)
local record Right
    left: Left
end

local leftInspect: inspect.Inspect = nil as any as Left
local rightInspect: inspect.Inspect = nil as any as Right
assert(leftInspect ~= nil or rightInspect == nil)

@derive(inspect.derive)
local record WrittenClaim is inspect.Inspect
    value: string
end

local written = new WrittenClaim(value = "coalesced")
assert(written:inspect() == "{value=coalesced}")
assert(written:inspectKind() == "record")

local inspectAlias = inspect

@derive(inspectAlias.derive)
local record AliasedProvider
    value: string
end

local aliased = new AliasedProvider(value = "alias")
assert(aliased:inspect() == "{value=alias}")

return true
