const assert2 = require("assert")

local inspect = require("tests.fixtures.deriveinspect")
const prefix = "caller prefix"
const self = "caller receiver"

--- Credentials used to authenticate.
---
--- Kept as a typed record.
@derive(inspect.derive, types.debug)
local record Credentials
    --- The public account name.
    username: string

    --- A secret value.
    @debug(redact = true)
    password: string
end

local credentials = Credentials(username = "michael", password = "secret")
assert2(credentials:inspect() == "{username=michael, password=<redacted>}")
assert2(credentials:inspectKind() == "record")
assert2(credentials:prefixed("credentials=") == "credentials={username=michael, password=<redacted>}")
assert2(prefix == "caller prefix" and self == "caller receiver")
assert2(credentials:decorated() == "[{username=michael, password=<redacted>}]")
assert2(credentials:firstField() == "username")
assert2(
    credentials:documentation() == "Credentials used to authenticate.\n\nKept as a typed record.\n-- fields --\nThe public account name.\nA secret value."
)

@derive(inspect.derive)
local record Child
    name: string
end

@derive(inspect.derive)
local record Parent
    child: Child
end

local parent = Parent(child = Child(name = "nested"))
assert2(parent:inspect() == "{child=<nested>}")
assert2(credentials:firstField() == "username")
assert2(parent:documentation() == "<none>\n-- fields --\n<none>")

-- Both providers have to observe the other's declaration-time claim before
-- either provider body has completed. The fields are intentionally not
-- instantiated: only the mutually recursive planning boundary is under test.
@derive(inspect.derive)
local record Left
    right: Right
end

@derive(inspect.derive)
local record Right
    left: Left
end

local leftInspect: inspect.Inspect = nil as any as Left
local rightInspect: inspect.Inspect = nil as any as Right
assert2(leftInspect ~= nil or rightInspect == nil)

@derive(inspect.derive)
local record WrittenClaim is inspect.Inspect
    value: string
end

local written = WrittenClaim(value = "coalesced")
assert2(written:inspect() == "{value=coalesced}")
assert2(written:inspectKind() == "record")

local inspectAlias = inspect

@derive(inspectAlias.derive)
local record AliasedProvider
    value: string
end

local aliased = AliasedProvider(value = "alias")
assert2(aliased:inspect() == "{value=alias}")

return true
