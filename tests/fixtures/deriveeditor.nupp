const types2 = require("types")
const derive = require("types.derive")

local provider = {}

interface provider.Inspect
    inspect: function(self): string
end

function provider.text(value: string): string
    return value
end

@comptime
function provider.derive(info: types.derive.Info): types.derive.Result<provider.Inspect>
    local signature = types2.functiontype(types2.pack({}), types2.pack({types2.string}))

    return derive.implement{
        methods = {
            inspect = derive.forward{helper = derive.helper(provider, "text"), arguments = {derive.constant(info.name)}}
        },
        statics = {
            kind = derive.member{
                signature = signature,
                forward = derive.forward{
                    helper = derive.helper(provider, "text"),
                    arguments = {derive.constant(info.kind)}
                }
            },
            fields = derive.member{
                signature = signature,
                forward = derive.forward{
                    helper = derive.helper(provider, "text"),
                    arguments = {derive.constant(tostring(#info.fields))}
                }
            },
        },
    }
end

return provider
