module tests.fixtures.derivewitness

const derivewitness = require("tests.fixtures.derivewitness")

@annotation(targets = {"field", "record"})
export record inspectWitness
    @annotationValue
    @ref
    subject: any
end

export interface HasWitness
    witness: function(self): any
end

export record CompletionProvider
end

export function returnWitness(witness: any): any
    return witness
end

export comptime function derive(info: nupp.derive.Info): nupp.derive.Result<HasWitness>
    local annotations = info.annotations
    for _, field in ipairs(info.fields) do
        if #field.annotations > 0 then
            annotations = field.annotations
            break
        end
    end
    for _, applied in ipairs(annotations) do
        if applied.name == "inspectWitness" then
            return nupp.derive.implement{
                methods = {
                    witness = nupp.derive.forward{
                        helper = nupp.derive.helper(derivewitness, "returnWitness"),
                        arguments = {nupp.derive.witness(nupp.derive.annotationType(applied.arguments[1]))},
                    },
                },
            }
        end
    end

    return nupp.derive.error("derive needs @inspectWitness", info.reference)
end
