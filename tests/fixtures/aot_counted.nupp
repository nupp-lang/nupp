local span = require("nupp.mem.span")

@aot
local function signed(first: int32, last: int32): (number, number)
    local low = first
    local stop = last
    local evaluated: int32 = 0
    local visits = 0
    local total = 0
    for cursor = do
        evaluated = nupp.math.i32.add(evaluated, 1)
        yield low
    end, do
        low = 1000
        evaluated = nupp.math.i32.add(evaluated, 10)
        yield stop
    end do
        visits = visits + 1
        total = total + cursor
        stop = 0
        cursor = 99
    end

    return visits + evaluated * 100 + low, total
end

@aot
local function general(first: number, last: number): (number, number)
    local stop = last
    local visits = 0
    local final = 0
    for cursor = first, stop do
        visits = visits + 1
        final = cursor
        stop = -100
        cursor = 99
        if visits == 4 then
            break
        end
    end

    return visits, final
end

@aot
local function unsigned(first: uint32, last: uint32): (number, number)
    local visits = 0
    local total = 0
    for cursor = first, last do
        visits = visits + 1
        total = total + cursor
        cursor = 0
    end

    return visits, total
end

@aot
local function indexed(borrows input: span.Span<uint32>): number
    local total = 0
    for outer = 1, 2 do
        for cursor = 1, 1 do
            cursor = 99
            total = total + cursor - 99
        end
        for cursor = 1, #input do
            total = total + input[cursor]
        end
    end

    return total
end

@aot
local function vector(
    exclusive output: span.WriteSpan<number>,
    borrows starts: span.Span<int32>,
    borrows stops: span.Span<int32>
): nil
    assert(#output == #starts and #starts == #stops)
    @simd
    for index = 1, #output do
        local low = starts[index]
        local stop = stops[index]
        local visits = 0
        local total = 0
        local scratch = 0
        for cursor = low, stop do
            visits = visits + 1
            total = total + cursor + scratch
            stop = 0
            cursor = 99
            if visits == 1 then
                continue
            end
            local inner: int32 = 0
            while do
                inner = nupp.math.i32.add(inner, 1)
                yield inner < 3
            end do
                if inner == 2 then
                    break
                end
                total = total + 10
            end
            for nested = 1, 3 do
                if nested == 2 then
                    break
                end
                total = total + 100
                scratch = scratch + 100
            end
            if visits == 3 then
                break
            end
        end
        output[index] = total + visits * 1000
    end
end

@aot
local function scalarVector(
    exclusive output: span.WriteSpan<number>,
    borrows starts: span.Span<int32>,
    borrows stops: span.Span<int32>
): nil
    assert(#output == #starts and #starts == #stops)
    for index = 1, #output do
        local low = starts[index]
        local stop = stops[index]
        local visits = 0
        local total = 0
        local scratch = 0
        for cursor = low, stop do
            visits = visits + 1
            total = total + cursor + scratch
            stop = 0
            cursor = 99
            if visits == 1 then
                continue
            end
            local inner: int32 = 0
            while do
                inner = nupp.math.i32.add(inner, 1)
                yield inner < 3
            end do
                if inner == 2 then
                    break
                end
                total = total + 10
            end
            for nested = 1, 3 do
                if nested == 2 then
                    break
                end
                total = total + 100
                scratch = scratch + 100
            end
            if visits == 3 then
                break
            end
        end
        output[index] = total + visits * 1000
    end
end

@aot
local function vectorWide(
    exclusive output: span.WriteSpan<number>,
    borrows starts: span.Span<number>,
    borrows stops: span.Span<number>
): nil
    assert(#output == #starts and #starts == #stops)
    @simd
    for index = 1, #output do
        local visits = 0
        local final = 0
        for cursor = starts[index], stops[index] do
            visits = visits + 1
            final = cursor
            cursor = 99
            if visits == 4 then
                break
            end
        end
        output[index] = final == 0 and 1 / final or visits + final
    end
end

@aot
local function literal(): number
    local total = 0
    for cursor = 2147483647, 2147483648 do
        total = total + cursor
    end
    for cursor = 4294967293, 4294967295 do
        total = total + cursor
    end
    for cursor = 1, 2 do
        cursor = 4294967296
        total = total + cursor
    end

    return total
end

@aot
local function negativeZero(): number
    for cursor = -0.0, 0 do
        return 1 / cursor
    end
    return 0
end

@aot
local function uniformAssigned(
    exclusive output: span.WriteSpan<number>,
    borrows input: span.Span<int32>,
    first: int32,
    last: int32
): nil
    assert(#output == #input)
    @simd
    for index = 1, #output do
        local total = 0
        local value = input[index]
        for cursor = first, last do
            if value > 0 then
                cursor = 4294967296
            end
            total = total + cursor
        end
        output[index] = total
    end
end

@aot
local function unsignedVector(
    exclusive output: span.WriteSpan<uint32>,
    borrows starts: span.Span<uint32>,
    borrows stops: span.Span<uint32>
): nil
    assert(#output == #starts and #starts == #stops)
    @simd
    for index = 1, #output do
        local visits: uint32 = 0
        for cursor = starts[index], stops[index] do
            visits = nupp.math.u32.add(visits, 1)
        end
        output[index] = visits
    end
end

@aot
local function signedVector(
    exclusive output: span.WriteSpan<uint32>,
    borrows starts: span.Span<int32>,
    borrows stops: span.Span<int32>
): nil
    assert(#output == #starts and #starts == #stops)
    @simd
    for index = 1, #output do
        local visits: uint32 = 0
        for cursor = starts[index], stops[index] do
            visits = nupp.math.u32.add(visits, 1)
            if visits == 5 then
                break
            end
        end
        output[index] = visits
    end
end

@aot
local function signedReadonly(first: int32, last: int32): number
    local visits = 0
    for cursor = first, last do
        visits = visits + 1
        if visits == 5 then
            break
        end
    end

    return visits
end

@aot
local function regions(exclusive output: span.WriteSpan<uint32>, repeats: int32): nil
    @simd
    for index = 1, #output do
        local count: uint32 = 0
        for cursor = output[index], 3 do
            count = nupp.math.u32.add(count, 1)
            if count == 2 then
                break
            end
        end
        output[index] = count
    end
    for outer = 1, repeats do
        @simd
        for index = 1, #output do
            local count = output[index]
            for cursor = output[index], 3 do
                count = nupp.math.u32.add(count, 1)
                if cursor == 2 then
                    break
                end
            end
            output[index] = count
        end
    end
end

@aot
local function liveness(exclusive output: span.WriteSpan<number>, trips: int32, mode: int32): nil
    @simd
    for index = 1, #output do
        local control = output[index]
        local visits = 0
        local checks = 0
        local result = 0
        if mode == 0 then
            local scratch = 0
            for outer = 1, trips do
                result = result + scratch
                for nested = 1, 3 do
                    if nested == 2 then
                        break
                    end
                    scratch = scratch + 100
                end
            end
        elseif mode == 1 then
            while control < 2 and visits < 3 do
                visits = visits + 1
                for nested = 1, 3 do
                    if nested == 2 then
                        break
                    end
                    control = nested
                end
            end
            result = visits
        elseif mode == 2 then
            while do
                checks = checks + 1
                yield control < 2 and visits < 3
            end do
                visits = visits + 1
                for nested = 1, 3 do
                    if nested == 2 then
                        break
                    end
                    control = nested
                end
            end
            result = visits + checks
        elseif mode == 3 then
            repeat
                visits = visits + 1
                for nested = 1, 3 do
                    if nested == 2 then
                        break
                    end
                    control = nested
                end
            until control >= 2 or visits == 3
            result = visits
        else
            repeat
                visits = visits + 1
                for nested = 1, 3 do
                    if nested == 2 then
                        break
                    end
                    control = nested
                end
            until do
                checks = checks + 1
                yield control >= 2 or visits == 3
            end
            result = visits + checks
        end
        output[index] = result
    end
end

return {
    liveness = liveness,
    regions = regions,
    signedVector = signedVector,
    signedReadonly = signedReadonly,
    literal = literal,
    negativeZero = negativeZero,
    uniformAssigned = uniformAssigned,
    unsignedVector = unsignedVector,
    signed = signed,
    general = general,
    unsigned = unsigned,
    indexed = indexed,
    vector = vector,
    scalarVector = scalarVector,
    vectorWide = vectorWide
}
