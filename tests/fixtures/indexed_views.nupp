const assert2 = require("assert")

local span = require("bytes.span")
local indexed = require("bytes.span")

local struct Point
    x: float
    y: float
end

const storage = carray(Point, 4)
const writable = span.writecarray(storage, 4)
const rows = indexed.range(1, #writable, writable)
for index = rows.first, rows.last do
    writable[index].x = index
    writable[index].y = index * 2
end
const middle = writable:slice(2, 3)
for index = 1, #middle do
    middle[index].y += 1
end
own.drop(middle)
own.drop(writable)

const readable = span.fromcarray(storage, 4)
assert2(#readable == 4)
assert2(readable[3].x == 3)
assert2(readable[3].y == 7)
const outer = readable:slice(2, 4)
const inner = outer:slice(1, 2)
local total = 0
for index = 1, #inner do
    total += inner[index].x
end
assert2(total == 5)
