-- Test fixture: a module with nested immutable data.
local M = {}

const ... M.bar = {
    BAZ = 123,
    COUNT = 0,
    nested = {name = "nupp"},
}

M.replaceable = {
    const BAZ = 456,
}

local function ping(value: integer): integer
    return value + 1
end

const ... M.api = {
    ping = ping,
}

return M
