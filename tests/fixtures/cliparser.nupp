module tests.fixtures.cliparser

const terminal = require("io.cli")

local cliModule = require("io.cli")

-- Runtime-facing aliases are retired, while the real token values stay canonical.
assert((cliModule as any).shortOption == nil)
assert((cliModule as any).longOption == nil)
assert((cliModule as any).optionalAttached == nil)
assert((cliModule as any).attachedOnly == nil)
assert(cliModule.shortoption == "shortoption" and cliModule.longoption == "longoption")

local function assertRaises(body: function(): nil): nil
    local ok = pcall(body)
    assert(not ok)
end

local parser = cliModule.optparser({"-v", "--output=result.txt", "main.nupp", "--", "--literal"}, {
    arity = {v = cliModule.none, output = cliModule.required},
})
assertRaises(function(): nil
    parser:kind()
end)
local first = assert(parser:next())
assert(first == cliModule.shortoption and parser:kind() == first)
assert(parser:key() == "v" and parser:index() == 1)
local second = assert(parser:next())
assert(second == cliModule.longoption and parser:key() == "output")
assert(parser:value() == "result.txt" and parser:attached())
local third = assert(parser:next())
assert(third == cliModule.argument and parser:raw() == "main.nupp")
assertRaises(function(): nil
    parser:key()
end)
assertRaises(function(): nil
    parser:value()
end)
assertRaises(function(): nil
    parser:attached()
end)
assertRaises(function(): nil
    parser:pattern()
end)
local fourth = assert(parser:next())
assert(fourth == cliModule.terminator and parser:raw() == "--")
local fifth = assert(parser:next())
assert(fifth == cliModule.argument and parser:raw() == "--literal")
local finished = parser:next()
assert(finished == nil)
assertRaises(function(): nil
    parser:raw()
end)
assert(parser:original()[1] == "-v")
assert(#parser:remaining() == 0)

local hiddenTerminator = cliModule.optparser({"first", "--", "--second"}, {exposeterminator = false})
assert(hiddenTerminator:next() == cliModule.argument and hiddenTerminator:raw() == "first")
assert(hiddenTerminator:next() == cliModule.argument and hiddenTerminator:raw() == "--second")

local iterated = {}
for kind, current in cliModule.getopt({"--flag", "value"}) do
    assert(kind == assert(current):kind())
    iterated[#iterated + 1] = assert(current):raw()
end
assert(#iterated == 2 and iterated[2] == "value")

local values = cliModule.optparser({"--unknown", "file", "--output", "next"}, {arity = {output = cliModule.required},})
local unknown = assert(values:next())
assert(unknown == cliModule.longoption and values:key() == "unknown" and values:value() == nil)
assert(values:next() == cliModule.argument and values:raw() == "file")
local output = assert(values:next())
assert(output == cliModule.longoption and values:key() == "output")
assert(values:value() == "next" and not values:attached())

local missing = cliModule.optparser({"--output"}, {arity = {output = cliModule.required}})
local missingToken, problem = missing:next()
assert(missingToken == nil)
assert(problem ~= nil and problem.kind == "missingvalue")
assert(problem.index == 1 and problem.key == "output")
assertRaises(function(): nil
    missing:raw()
end)

local iterMissing = cliModule.getopt({"--output"}, {arity = {output = cliModule.required}})
assertRaises(function(): nil
    iterMissing()
end)

local attached = cliModule.optparser({"-Zno-opt"}, {arity = {['Zno-opt'] = cliModule.attachedonly}})
local attachedToken, attachedProblem = attached:next()
assert(attachedToken == nil)
assert(attachedProblem ~= nil and attachedProblem.kind == "needsattachedvalue")

local stopped = cliModule.optparser({"-O2", "program.nupp", "--flag"}, {
    patterns = {{pattern = "^%-O(%d)$", key = "O"}},
    stopatfirstargument = true,
})
local level = assert(stopped:next())
assert(level == cliModule.shortoption and stopped:key() == "O" and stopped:value() == "2")
assert(stopped:pattern())
assert(stopped:next() == cliModule.argument and stopped:raw() == "program.nupp")
local literal = assert(stopped:next())
assert(literal == cliModule.argument and stopped:raw() == "--flag")

--- Options accepted by a checked command.
@derive(cliModule.arguments)
local record CheckArgs
    --- Show each file as it is checked.
    @cli(short = "v")
    verbose: boolean = false

    --- Select the report representation.
    @cli(value = "FORMAT", constantaliases = {json = "json", text = "text"})
    format: "text" | "json" = "text"

    --- Disable the default policy.
    @cli(name = "disable", constant = false)
    enabled: boolean = true

    --- Number of workers to use.
    @cli(short = "j", value = "COUNT")
    jobs: integer?

    --- Sampling ratio.
    ratio: number?

    --- Source file to check.
    @cli(positional = "FILE")
    files: {string} = {}
end

assert((CheckArgs as any).fromCLI == nil)
local checked, checkProblem = CheckArgs.fromcli({"-v", "--format", "json", "-j", "3", "a.nupp", "b.nupp"})
assert(checked ~= nil, checkProblem and checkProblem.message)
assert(checked.verbose and checked.format == "json" and checked.jobs == 3 and checked.enabled)
assert(#checked.files == 2 and checked.files[2] == "b.nupp")

local same, sameProblem = cliModule.parse(CheckArgs, {"--format=text", "main.nupp"})
assert(same ~= nil, sameProblem and sameProblem.message)
assert(not same.verbose and same.format == "text" and same.jobs == nil)
assert(#same.files == 1 and same.files[1] == "main.nupp")
local aliased = assert(CheckArgs.fromcli({"--json", "--disable"}))
assert(aliased.format == "json" and not aliased.enabled)
local numeric = assert(CheckArgs.fromcli({"--ratio", "1.25"}))
assert(numeric.ratio == 1.25)
local cachedSchema = assert(cliModule.schema(CheckArgs))
assert(cachedSchema.byName == nil)
assert(CheckArgs.fromcli({}) ~= nil)
assert(cachedSchema.byName == nil)

--- Print greeting commands.
@cli(name = "greet", group = true)
@derive(cliModule.command)
local record Greet
end

local record Names is cliModule.Completer
    function complete(self, request: cliModule.CompletionRequest): {cliModule.CompletionCandidate}
        assert(request.field == "name" and request.commandpath[1] == "hello")
        assert(rawget(request as any, "wordIndex") == nil)
        assert(rawget(request as any, "commandPath") == nil)
        assert(request.cwd == "." and request.environment.mode == "test")

        return {new cliModule.CompletionCandidate(value = request.prefix .. "Ada")}
    end
end

--- Print one greeting.
---
--- The command has no separately configured help text.
@cli(name = "hello", aliases = {"hi"})
@derive(cliModule.command)
local record Hello
    --- Greeting representation.
    mode: "text" | "json" = "text"

    --- Person to greet.
    @cli(positional = "NAME", complete = Names)
    name: string

    function run(self): integer
        return self.name == "Ada" and 7 or 1
    end
end

assert(Hello.cliname() == "hello")
assert((Hello as any).cliName == nil)
assert((Hello as any).cliAliases == nil)
assert((Hello as any).cliSummary == nil)
assert(Hello.clialiases()[1] == "hi")
assert(Hello.clisummary() == "Print one greeting.")
assert(assert(cliModule.descriptor(Hello)).completers[2] == Names)
local greeting, greetingProblem = Hello.fromcli({"Ada"})
assert(greeting ~= nil, greetingProblem and greetingProblem.message)
assert(greeting:run() == 7)

function Greet.subcommands(): {cliModule.CommandType}
    return {Hello}
end

local app = cliModule.application(Greet, {name = "greeter", version = "1.0.0"})
local invocation, invocationProblem = app:resolve({"hi", "Ada"})
assert(invocation ~= nil, invocationProblem and invocationProblem.message)
assert(invocation.commandtype == Hello and invocation.options.name == "Ada")
assert(rawget(invocation as any, "commandType") == nil)
assert(rawget(invocation as any, "commandPath") == nil)
assert((app as any).commandHelp == nil)
assert(type(app.commandhelp) == "function")
local help = assert(app:commandhelp({"hello"}))
assert(help:match("Print one greeting%."))
assert(help:match("NAME"))
assert(help:match("Person to greet%."))
local rootHelp = app:help()
assert(rootHelp:match("hello%s+Print one greeting%."))
local candidates = app:complete({
    argv = {"hello", "A"},
    wordindex = 2,
    prefix = "A",
    cwd = ".",
    environment = {mode = "test"},
})
assert(#candidates == 1 and candidates[1].value == "AAda")
local attachedChoices = app:complete({
    argv = {"hello", "--mode=j"},
    wordindex = 2,
    prefix = "--mode=j",
    environment = {mode = "test"},
})
assert(#attachedChoices == 1 and attachedChoices[1].value == "--mode=json")
local followingChoices = app:complete({
    argv = {"hello", "--mode", "j"},
    wordindex = 3,
    prefix = "j",
    environment = {mode = "test"},
})
assert(#followingChoices == 1 and followingChoices[1].value == "json")
local afterFramework = app:complete({
    argv = {"--color=never", "hello", "A"},
    wordindex = 3,
    prefix = "A",
    environment = {mode = "test"},
})
assert(#afterFramework == 1 and afterFramework[1].value == "AAda")
assert(app:completion("bash"):match("__complete bash"))
assert(app:completion("zsh"):match("#compdef greeter"))
assert(app:completion("fish"):match("complete %-c greeter"))

local hello = cliModule.application(Hello, {name = "hello"})
local afterTerminator = app:complete({
    argv = {"hello", "--", "--m"},
    wordindex = 3,
    prefix = "--m",
    environment = {mode = "test"},
})
assert(#afterTerminator == 1 and afterTerminator[1].value == "--mAda")
local direct, directProblem = hello:resolve({"Ada"})
assert(direct ~= nil, directProblem and directProblem.message)
assert(direct.commandtype == Hello and #direct.commandpath == 0)
assert(hello:help():match("NAME"))
assert(hello:main({"Ada"}) == 7)

local _, invalidInteger = CheckArgs.fromcli({"--jobs", "many"})
assert(invalidInteger ~= nil and invalidInteger.kind == "invalidValue")
assert(invalidInteger.index == 1 and invalidInteger.raw == "--jobs")
local _, missingName = Hello.fromcli({})
assert(missingName ~= nil and missingName.kind == "missingRequired" and missingName.field == "name")
local _, duplicate = CheckArgs.fromcli({"--jobs", "1", "--jobs", "2"})
assert(duplicate ~= nil and duplicate.kind == "duplicateOption")
local _, unknownOption = CheckArgs.fromcli({"--unknown"})
assert(unknownOption ~= nil and unknownOption.kind == "unknownOption")

@derive(cliModule.arguments)
local record PatternArgs
    --- Optimization level.
    @cli(name = "O", long = false, pattern = "^%-O([0-2])$", display = "-O0, -O1, -O2", choices = {"0", "1", "2"})
    level: string?
end

assert(assert(PatternArgs.fromcli({"-O2"})).level == "2")
local _, syntheticPatternName = PatternArgs.fromcli({"--O", "2"})
assert(syntheticPatternName ~= nil and syntheticPatternName.kind == "unknownOption")

@cli(preserveunknown = true)
@derive(cliModule.arguments)
local record Forwarded
    --- Optional attached profiling interval.
    @cli(arity = "optionalattached", constant = "")
    profile: string?

    --- Arguments owned by the downstream program.
    @cli(remainder = true, value = "ARG")
    arguments: {string} = {}
end

local forwarded = assert(Forwarded.fromcli({"--other", "value", "--profile=5", "suite"}))
assert(forwarded.profile == "5")
assert(#forwarded.arguments == 3)
assert(forwarded.arguments[1] == "--other" and forwarded.arguments[3] == "suite")
local bareProfile = assert(Forwarded.fromcli({"--profile"}))
assert(bareProfile.profile == "")

@derive(cliModule.arguments)
local record Sets
    --- Tags to enable.
    tags: {[string]: boolean} = {}
end

local tags = assert(Sets.fromcli({"--tags", "fast", "--tags", "portable", "--tags", "fast"}))
assert(tags.tags.fast and tags.tags.portable)

@derive(cliModule.arguments)
local record OptionalChoices
    --- Optional execution mode.
    @cli(positional = "MODE", choices = {"fast", "thorough"})
    mode: string?

    --- Optional report format.
    @cli(positional = "FORMAT", choices = {"text", "json"})
    format: string?

    --- Input file.
    @cli(positional = "FILE")
    file: string
end

local choicesSkipped = assert(OptionalChoices.fromcli({"main.nupp"}))
assert(choicesSkipped.mode == nil and choicesSkipped.format == nil and choicesSkipped.file == "main.nupp")
local secondChoice = assert(OptionalChoices.fromcli({"json", "main.nupp"}))
assert(secondChoice.mode == nil and secondChoice.format == "json" and secondChoice.file == "main.nupp")

terminal.withcolormode("always", function()
    local style = terminal.style(io.stdout)
    assert(terminal.colorenabled(io.stdout))
    assert(style.red("problem") == "\27[1;31mproblem\27[0m")
end)
terminal.withcolormode("never", function()
    local style = terminal.style(io.stdout)
    assert(not terminal.colorenabled(io.stdout))
    assert(style.red("problem") == "problem" and style.strong("heading") == "heading")
end)

print("cli parser ok")
