module structs

-- Structs reached through raw pointers, with the compiler's own layout model
-- deciding field offsets, and the private memory intrinsics beside them.
const native = require("nupp.runtime.vm.intrinsics")

local struct Node
    value: int64
    weight: number
    count: uint32
    flag: boolean
    next: Node*?
end

local function at(base: voidptr, index: int64): Node*
    return native.offset(base, index * 32) as Node*
end

local function build(base: voidptr, count: int64): Node*
    local i: int64 = 0
    while i < count do
        local node = at(base, i)
        @unsafe node.value = i * 10
        @unsafe node.weight = 0.5
        @unsafe node.count = 7
        @unsafe node.flag = i % 2 == 0
        if i + 1 < count then
            @unsafe node.next = at(base, i + 1)
        else
            @unsafe node.next = nil
        end
        i = i + 1
    end

    return at(base, 0)
end

local function sumList(head: Node*?): int64
    local total: int64 = 0
    local node = head
    while node ~= nil do
        total = total + node.value
        node = node.next
    end

    return total
end

local function weigh(head: Node*?): number
    local total = 0
    local node = head
    while node ~= nil do
        if node.flag then
            total = total + node.weight
        end
        node = node.next
    end

    return total
end

local function countAll(head: Node*?): int64
    local total: int64 = 0
    local node = head
    while node ~= nil do
        total = total + (node.count as int64)
        node = node.next
    end

    return total
end

local function total(base: voidptr, count: int64): int64
    return sumList(build(base, count))
end

local function weight(base: voidptr, count: int64): number
    return weigh(build(base, count))
end

local function counts(base: voidptr, count: int64): int64
    return countAll(build(base, count))
end

local function words(base: voidptr, count: int64): uint64
    local i: int64 = 0
    while i < count do
        native.store64(base, i * 8, native.load64(base, i * 8) + 3ULL)
        i = i + 1
    end
    local sum: uint64 = 0
    i = 0
    while i < count do
        sum = sum + native.load64(base, i * 8)
        i = i + 1
    end

    return sum
end
