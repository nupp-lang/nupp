module numericfloor

local function integerIdentity(value: int64): int64
    return math.floor(value) as int64
end

local function integerLiteral(): int64
    return math.floor(9007199254740993) as int64
end

local function floating(value: float): float
    return math.floor(value) as float
end

local function minimumFloat(): float64
    local value: float64 = -9223372036854775808
    return value
end

local function negativeZero(): float64
    return -0.0
end
