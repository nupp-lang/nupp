-- Concatenation through the native core's `Concat`: strings, slices, numbers
-- that spell as digits, boxed integers, interning of short results, and what
-- the step keeps (`%.14g` numbers, negative zero, `__concat`). Every line is
-- checked against a literal here and printed for the differential run.
local out: {string} = {}

local function show(name: string, v: any, expected: any): nil
    assert(v == expected, name .. ": got " .. tostring(v) .. ", expected " .. tostring(expected))
    out[#out + 1] = name .. "=" .. tostring(v)
end

local a: any = "abc"
local b: any = "def"
local n: any = 42
local neg: any = -17
local zero: any = 0
local big: any = 99999999999999
local huge: any = 1e14
local frac: any = 1.5
local negzero: any = -0.0
local long = string.rep("xy", 30)
show("ss", a .. b, "abcdef")
show("sn", a .. n, "abc42")
show("ns", n .. a, "42abc")
show("nn", n .. neg, "42-17")
show("zero", zero .. a, "0abc")
show("big", a .. big, "abc99999999999999")
show("huge", a .. huge, "abc1e+14")
show("frac", a .. frac, "abc1.5")
show("negzero", a .. negzero, "abc-0")
show("longShort", (long .. a):len(), 63)
show("longLong", (long .. long) == string.rep("xy", 60), true)
show("chain", a .. b .. n .. neg .. "!", "abcdef42-17!")
show("empty", "" .. "" == "", true)
show("emptyLeft", "" .. a, "abc")
show("slice", long:sub(3, 6) .. a, "xyxyabc")
show("boundary40", (string.rep("k", 37) .. a) == string.rep("k", 37) .. "abc", true)
show("boundary41", (string.rep("k", 38) .. a) == string.rep("k", 38) .. "abc", true)
local t: {[string]: number} = {}
t["abcdef"] = 7
t[string.rep("q", 50) .. "z"] = 8
show("internedKey", t[a .. b], 7)
show("longKey", t[string.rep("q", 49) .. "qz"], 8)
local u64: any = 18446744073709551615ULL
show("u64", "v" .. u64, "v18446744073709551615")
show("negDigits", neg .. "", "-17")
local count = 0
for k = 1, 20000 do
    local s = "item" .. k .. ":" .. (k * 3)
    count = count + #s
end
show("loop", count, 285192)
show(
    "meta",
    (pcall(function(): string
        local x: any = {}

        return "a" .. x
    end)),
    false
)
local mt = {
    __concat = function(l: any, r: any): string
        return "joined"
    end
}
local withMeta: any = setmetatable({}, mt)
show("concatMeta", a .. withMeta, "joined")
print(table.concat(out, "\n"))
