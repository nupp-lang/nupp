module scalars

-- Ordinary typed Nupp compiled to CLIF: mutable locals, loops, branches,
-- direct calls, and the scalar operators, with nothing managed underneath.

local function fib(n: int64): int64
    if n < 2 then
        return n
    end
    return fib(n - 1) + fib(n - 2)
end

local function sum(n: int64): int64
    local total: int64 = 0
    local i: int64 = 1
    while i <= n do
        total = total + i
        i = i + 1
    end

    return total
end

local function gcd(a: uint64, b: uint64): uint64
    while b ~= 0 do
        local t = b
        b = a % b
        a = t
    end

    return a
end

local function clamp(x: float64, low: float64, high: float64): float64
    if x < low then
        return low
    elseif x > high then
        return high
    else
        return x
    end
end

local function triangle(n: int64): int64
    local total: int64 = 0
    for i = 1, n do
        total = total + i
    end

    return total
end

local function countdown(n: int64): int64
    local steps: int64 = 0
    for i = n, 1, -1 do
        steps = steps + 1
    end

    return steps
end

local function collatz(n: uint64): uint64
    local steps: uint64 = 0
    while n ~= 1 do
        if n % 2 == 0 then
            n = n // 2
        else
            n = 3 * n + 1
        end
        steps = steps + 1
    end

    return steps
end

local function firstSquareAbove(limit: int64): int64
    local i: int64 = 0
    repeat
        i = i + 1
    until i * i > limit

    return i
end

local function findBreak(limit: int64): int64
    local found: int64 = -1
    for i = 1, 1000 do
        if i * i * i > limit then
            found = i
            break
        end
    end

    return found
end

local function both(a: boolean, b: boolean): boolean
    return a and b
end

local function either(a: boolean, b: boolean): boolean
    return a or b
end

local function neither(a: boolean, b: boolean): boolean
    return not (a or b)
end

local function floorMod(a: int64, b: int64): int64
    return a % b
end

local function floorDiv(a: int64, b: int64): int64
    return a // b
end

local function bits(a: uint64, b: uint64): uint64
    return ((a & b) | (a ~ b)) << 1 >> 1
end

local function mean(a: float64, b: float64): float64
    return (a + b) / 2
end

local function scaled(x: float64): float64
    return x * 1.5 - 0.25
end

local function negate(x: int64): int64
    return -x
end

local function compound(n: int64): int64
    local x: int64 = n
    x += 10
    x *= 2
    x -= 4

    return x
end

local function nestedLoops(n: int64): int64
    local count: int64 = 0
    for i = 1, n do
        local j: int64 = 0
        while j < i do
            if (i + j) % 3 == 0 then
                count = count + 1
            end
            j = j + 1
        end
    end

    return count
end
