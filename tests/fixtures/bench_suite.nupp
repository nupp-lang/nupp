local bench = require("debug.bench")
const {type Invocation} = require("debug.bench")

local function setup(_: Invocation): any
    return {calls = 0}
end

local function run(state: any, invocation: Invocation): any
    state.calls = state.calls + 1
    local value = invocation.parameters.size as integer
    for _ = 1, value do
        state.calls = state.calls + 1
    end

    return state.calls
end

local function teardown(state: any, invocation: Invocation): nil
    local size = invocation.parameters.size as integer
    assert(state.calls == 2 * (size + 1), "setup, sample iterations and teardown disagree")
end

bench.suite(
    {
        name = "protocol",
        baselinevariant = "base",
        variants = {
            {name = "base", setup = setup, run = run, teardown = teardown,},
            {name = "other", setup = setup, run = run, teardown = teardown,},
        },
        cases = {{name = "work", parameters = {size = {1, 2}}, operations = 2,},},
        warmupiterations = 1,
        sampleiterations = 2,
        minsamples = 3,
        mindurationms = 0.000001,
        maxsamples = 5,
        maxdurationms = 100,
    } as bench.SuiteOptions
)
bench.report()
