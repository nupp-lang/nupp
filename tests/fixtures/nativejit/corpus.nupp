module corpus

-- Guest functions the JIT emitter compiles: boxed arithmetic, comparisons,
-- branches and loops over floats, plus canonical integer transport. The
-- native JIT suite runs each through the glue's JIT runner against a fake
-- frame and compares the answer with the Nupp interpreter's.

export function sum(n: number): number
    local total = 0.0
    local i = 1.0
    while i <= n do
        total = total + i
        i = i + 1.0
    end

    return total
end

export function collatz(n: number): number
    local steps = 0.0
    while n ~= 1.0 do
        if n % 2.0 == 0.0 then
            n = n / 2.0
        else
            n = 3.0 * n + 1.0
        end
        steps = steps + 1.0
    end

    return steps
end

export function nested(n: number): number
    local count = 0.0
    for i = 1.0, n do
        for j = 0.0, i - 1.0 do
            if (i + j) % 3.0 == 0.0 then
                count = count + 1.0
            end
        end
    end

    return count
end

-- The fake-frame harness has no managed numeric-for normalizer. Keep its
-- nested-loop arithmetic leaf explicit, while nested exercises real for loops.
export function nestedWhile(n: number): number
    local count = 0.0
    local i = 1.0
    while i <= n do
        local j = 0.0
        while j < i do
            if (i + j) % 3.0 == 0.0 then
                count = count + 1.0
            end
            j = j + 1.0
        end
        i = i + 1.0
    end

    return count
end

export function clamp(x: number, low: number, high: number): number
    if x < low then
        return low
    elseif x > high then
        return high
    end

    return x
end

export function between(x: number, low: number, high: number): boolean
    return low <= x and x <= high
end

export function neither(a: boolean, b: boolean): boolean
    return not (a or b)
end

export function mean(a: number, b: number): number
    return (a + b) / 2.0
end

export function floorMod(a: number, b: number): number
    return a % b
end

export function scaled(x: number): number
    local y = -x
    return y * 1.5 - 0.25
end

export function same(a: number, b: number): boolean
    return a == b
end

export function differ(a: number, b: number): boolean
    return a ~= b
end

export function countdown(n: number): number
    local count = 0.0
    repeat
        n = n - 1.0
        count = count + 1.0
    until n <= 0.0

    return count
end

export function firstSquareAbove(limit: number): number
    local i = 1.0
    while true do
        if i * i > limit then
            return i
        end
        i = i + 1.0
    end

    return -1.0
end

-- Integer transport and cross-representation equality also run through the
-- real core, where non-float arithmetic uses shared Nupp handlers.
export function floatingIdentity(n: float64): float64
    return n
end

export function integerIdentity(n: integer): integer
    return n
end

export function inlineNegative(): number
    return 0xffffffffffffffef
end

export function integerSubtype(n: integer): boolean
    local erased: any = n
    return math.type(erased) == "integer"
end

export function integerEqualsFloat(n: integer): boolean
    local floating: float64 = n * 1.0
    local erased: any = n
    return erased == floating
end

-- Calls: the frame protocol through the entry table, returns of several
-- values, callees the compiled call leaves to the interpreter (builtins,
-- varargs), and shared Nupp handlers for tables and strings.

local function fib(n: number): number
    if n < 2 then
        return n
    end

    return fib(n - 1) + fib(n - 2)
end

export function fibonacci(n: number): number
    return fib(n)
end

local function scale(a: number, b: number): number
    return a * b + 1
end

export function viaHelper(n: number): number
    local total = 0
    for i = 1, n do
        total = total + scale(i, 2)
    end

    return total
end

export function viaClosure(n: number): number
    local step = function(x: number): number
        return x + 1
    end
    local total = 0
    for _ = 1, n do
        total = step(total)
    end

    return total
end

export function viaBuiltin(n: number): number
    local total = 0
    for i = 1, n do
        total = total + math.floor(i / 2)
    end

    return total
end

export function concatLoop(n: number): number
    local text = ""
    for _ = 1, n do
        text = text .. "x"
    end

    return #text
end

export function tableSum(n: integer): number
    local values: {number} = {}
    for i = 1, n do
        values[i] = i
    end
    local total = 0
    for i = 1, n do
        total = total + values[i]
    end

    return total
end

local function two(n: number): (number, number)
    return n, n * 2
end

export function multi(n: number): number
    local a, b = two(n)

    return b - a
end

local function spread(...: number): number
    local total = 0
    for _, v in ipairs({...}) do
        total = total + v
    end

    return total
end

export function varargs(n: number): number
    return spread(n, n, n)
end

local function deep(n: number): number
    if n == 0 then
        return 0
    end

    return 1 + deep(n - 1)
end

export function depth(n: number): number
    return deep(n)
end

-- Field reads and stores by name, through the sites' inline caches: a table
-- and a record of two shapes behind `any`, so one site sees both.
local record Pair
    x: number
    y: number
end

local record Triple
    x: number
    y: number
    z: number
end

export function fields(n: number): number
    local t: any = {x = 0, y = 1}
    local p: any = new Pair(x = 1, y = 2)
    local q: any = new Triple(x = 3, y = 4, z = 5)
    for i = 1, n do
        t.x = t.x + i
        p.x = p.x + t.y
        local r: any = p
        if i % 2 == 0 then
            r = q
        end
        t.y = r.y
    end

    return t.x + p.x + t.y + q.z
end

export function slots(n: number): number
    local p = new Pair(x = 1, y = 2)
    local total = 0
    for i = 1, n do
        total = total + p.x + p.y
        p.x = p.x + i
    end

    return total
end

export function mixedSlots(n: number): number
    local p: any = new Pair(x = 1, y = 2)
    local q: any = new Triple(x = 3, y = 4, z = 5)
    local total = 0
    for i = 1, n do
        local r = p as Pair
        if i % 2 == 0 then
            r = q as Pair
        end
        total = total + r.x + r.y
    end

    return total
end

export function arrayMiss(n: integer): number
    local values: {number} = {1, 2}
    setmetatable(values, {
        __index = function(t: any, key: number): number
            return key * 3
        end,
    })
    local total = 0
    for i = 1, n do
        total = total + values[i] + values[1]
    end

    return total
end

local function deoptimizedRepeat(n: number): number
    local object: any = new Triple(x = 3, y = 4, z = 5)
    local p = object as Pair
    local total = 0
    repeat
        total = total + p.x
        n = n - 1
        if n < -1 then
            error("a conditional OSR entry skipped the repeat condition")
        end
    until n <= 0

    return total
end

export function repeatAfterDeopt(n: number): number
    return deoptimizedRepeat(n)
end
