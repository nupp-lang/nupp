local span = require("bytes.span")
local indexed = require("bytes.span")
local system = {}
local TENTH = math.f32.narrow(0.1)

local struct State
    x: float
    flags: uint32
end

local function advance(value: float, scale: float): (float, uint32)
    local position: float = value
    local flags: uint32 = 0
    @noalloc do
        @noraise do
            position = math.f32.fma(value, scale, TENTH)
            flags = math.u32.rotateleft(math.u32.add(flags, 1), 3)
        end
    end

    return position, flags
end

function system.run(): (float, uint32)
    const storage = carray(State, 8)
    const writable = span.writecarray(storage, 8)
    do
        const active = writable:slice(2, 7)
        const rows = indexed.range(1, #active, active)
        for index = rows.first, rows.last do
            @noalloc do
                @noraise do
                    local state = active[index]
                    state.x, state.flags = advance(state.x, 2.0)
                end
            end
        end
    end
    own.drop(writable)

    const readable = span.fromcarray(storage, 8)

    return readable[2].x, readable[7].flags
end

return system
